local integer h=GetHandleId(hero)
local integer talante=LoadInteger(udg_hash,ht,1)
call SetUnitVertexColorBJ(hero,100.00,100,100.00,0.00)
call SaveReal(udg_hash,h,'w',0)
call UnitRemoveAbility(hero,'A0S4')
if LoadBoolean(udg_hash,ht,2)then
call SaveReal(udg_hash,h,StringHash("Modificator"),LoadReal(udg_hash,h,StringHash("Modificator"))-0.3)
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set hero=null
set t=null
endfunction
function Trig_MurkySkills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer h=GetHandleId(caster)
local integer ihh=LoadInteger(udg_hash,h,5)
local integer iuh=LoadInteger(Hash,h,0)
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local integer talante=udg_Talante[ID]
local unit u
local unit summon
local real x
local real y
local real dmg
local real hp
local group g
local group g2
local real x1
local real y1
local timer t
local integer a
local integer i
local integer ht
if GetSpellAbilityId()=='A0RX' then
set dmg=240*GetUnitAbilityLevel(caster,'A0RX')+2.*GetHeroAgi(caster,true)
if GetHeroLevel(caster)>=50 then
set dmg=dmg+2.*GetHeroAgi(caster,true)
endif
set g=CreateGroup()
set u=GetSpellTargetUnit()
call UnitAddAbility(u,'A0RY')
call GroupAddUnit(g,u)
if talante==1 then
set dmg=1.25*dmg
endif
if talante==2 then
set g2=CreateGroup()
set dmg=dmg+80.*udg_DeathAmount[ID]
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g2,x,y,300.,Bool_Filter_ID)
call GroupRemoveUnit(g2,u)
call RandomUnitFromGroup(3,g2)
loop
set u=FirstOfGroup(g2)
exitwhen u==null
call GroupAddUnit(g,u)
call UnitAddAbility(u,'A0RY')
call GroupRemoveUnit(g2,u)
endloop
call DestroyGroup(g2)
endif
set a=40
set dmg=dmg/a
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveInteger(udg_hash,ht,1,a)
call SaveGroupHandle(udg_hash,ht,2,g)
call SaveReal(udg_hash,ht,3,dmg)
call TimerStart(t,0.5,true,function Trig_MurkySkills_Q)
if talante==3 then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>4
set x1=x+275*Cos((GetUnitFacing(caster)+10*(bj_forLoopAIndex-3))*bj_DEGTORAD)
set y1=y+275*Sin((GetUnitFacing(caster)+10*(bj_forLoopAIndex-3))*bj_DEGTORAD)
set summon=CreateUnit(GetOwningPlayer(caster),udg_MurkyRUnitType[GetRandomInt(1,3)],x1,y1,GetRandomInt(1,360))
set dmg=0.55*GetHeroInt(caster,true)
set hp=4.5*(GetHeroStr(caster,true)+GetHeroInt(caster,true))
if GetHeroLevel(caster)>=50 then
set hp=2.*hp
endif
set a=SeekFreeUnit(GetHandleId(summon))
set s__Units_Arm[sUnit[a]]=s__Units_Arm[sUnit[a]]+30
call F_Armore(summon,s__Units_Arm[sUnit[a]])
if GetUnitAbilityLevel(summon,'A0S7')==0 and GetUnitAbilityLevel(summon,'A15Z')==0 and GetUnitAbilityLevel(summon,'A18R')==0 and GetUnitAbilityLevel(summon,'A0M3')==0 and GetUnitAbilityLevel(summon,'A18Q')==0 then
call UnitAddAbility(summon,'A0S7')
if GetUnitAbilityLevel(summon,'A0S8')==1 then
call UnitRemoveAbility(summon,'A0S8')
endif
endif
call UnitAddAbility(summon,'A17N')
call SetUnitAbilityLevel(summon,'A17N',GetUnitAbilityLevel(summon,'A17N')+5)
if GetHeroLevel(caster)>=50 then
if GetUnitAbilityLevel(summon,'A1BF')==0 then
call UnitAddAbility(summon,'A1BF')
endif
call SetUnitAbilityLevel(summon,'A1BF',GetUnitAbilityLevel(summon,'A1BF')+12)
endif
call UnitAddAbility(summon,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),summon,caster)
call UnitRemoveAbility(summon,'A007')
call UnitApplyTimedLife(summon,'BTLF',30.)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
elseif GetSpellAbilityId()=='A0S3' then
call SetUnitVertexColorBJ(udg_Murky,20.00,100,20.00,50.00)
call UnitAddAbilityBJ('A0S4',udg_Murky)
if talante==3 then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>4
set x1=x+175*Cos((60*bj_forLoopAIndex)*bj_DEGTORAD)
set y1=y+175*Sin((60*bj_forLoopAIndex)*bj_DEGTORAD)
set summon=CreateUnit(GetOwningPlayer(caster),udg_MurkyRUnitType[GetRandomInt(1,3)],x1,y1,GetRandomInt(1,360))
set dmg=0.55*GetHeroInt(caster,true)
set hp=4.5*(GetHeroStr(caster,true)+GetHeroInt(caster,true))
if GetHeroLevel(caster)>=50 then
set hp=2.*hp
endif
set a=SeekFreeUnit(GetHandleId(summon))
set s__Units_Arm[sUnit[a]]=s__Units_Arm[sUnit[a]]+30
call F_Armore(summon,s__Units_Arm[sUnit[a]])
if GetUnitAbilityLevel(summon,'A0S7')==0 and GetUnitAbilityLevel(summon,'A15Z')==0 and GetUnitAbilityLevel(summon,'A18R')==0 and GetUnitAbilityLevel(summon,'A0M3')==0 and GetUnitAbilityLevel(summon,'A18Q')==0 then
call UnitAddAbility(summon,'A0S7')
if GetUnitAbilityLevel(summon,'A0S8')==1 then
call UnitRemoveAbility(summon,'A0S8')
endif
endif
call UnitAddAbility(summon,'A17N')
call SetUnitAbilityLevel(summon,'A17N',GetUnitAbilityLevel(summon,'A17N')+5)
if GetHeroLevel(caster)>=50 then
if GetUnitAbilityLevel(summon,'A1BF')==0 then
call UnitAddAbility(summon,'A1BF')
endif
call SetUnitAbilityLevel(summon,'A1BF',GetUnitAbilityLevel(summon,'A1BF')+12)
endif
call UnitAddAbility(summon,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),summon,caster)
call UnitRemoveAbility(summon,'A007')
call UnitApplyTimedLife(summon,'BTLF',30.)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
set dmg=20.*GetUnitAbilityLevel(caster,'A0S3')+10.*udg_DeathAmount[ID]
if talante==1 then
set i=GetUnitAbilityLevel(caster,'A0S3')*20+GetHeroAgi(caster,false)/4
call TempStats(caster,0,i,0,0,0,0,PositiveDuration(caster,11))
endif
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveInteger(udg_hash,ht,1,talante)
call SaveReal(udg_hash,GetHandleId(caster),'w',dmg)
if talante==1 and GetHeroLevel(caster)>=50 then
call SaveReal(udg_hash,h,StringHash("Modificator"),LoadReal(udg_hash,h,StringHash("Modificator"))+0.3)
call SaveBoolean(udg_hash,ht,2,true)
else
call SaveBoolean(udg_hash,ht,2,false)
endif
call TimerStart(t,11,false,function Trig_MurkySkills_W)
elseif GetSpellAbilityId()=='A0S2' then
call StartTimerBJ(udg_MurkyRTimer,true,0.25)
call EnableTrigger(gg_trg_MurkyRStop)
elseif GetSpellAbilityId()=='A1ES' then
set x=GetUnitX(caster)+175*Cos(GetUnitFacing(caster)*bj_DEGTORAD)
set y=GetUnitY(caster)+175*Sin(GetUnitFacing(caster)*bj_DEGTORAD)
set summon=CreateUnit(GetOwningPlayer(caster),'n07I',x,y,GetUnitFacing(caster))
set a=SeekFreeUnit(GetHandleId(summon))
set s__Units_Arm[sUnit[a]]=s__Units_Arm[sUnit[iuh]]+GetHeroAgi(caster,true)/5
set s__Units_HP[sUnit[a]]=R2I(GetUnitState(caster,UNIT_STATE_MAX_LIFE))-500
set s__Units_GAttack[sUnit[a]]=Summ_Attack(caster)
call F_hp(summon,s__Units_HP[sUnit[a]])
call F_Armore(summon,s__Units_Arm[sUnit[a]])
call F_Attack(summon,s__Units_GAttack[sUnit[a]])
call UnitAddAbility(summon,'A17N')
call SetUnitAbilityLevel(summon,'A17N',GetHeroAgi(caster,true)/5)
if talante==1 then
call UnitAddAbility(summon,'A0RZ')
call UnitApplyTimedLife(summon,'BTLF',25.)
else
call UnitApplyTimedLife(summon,'BTLF',20.)
endif
endif
set t=null
set caster=null
set summon=null
set u=null
set g=null
set g2=null
endfunction
