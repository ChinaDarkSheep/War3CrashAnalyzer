function Trig_Income_Elf takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer id=LoadInteger(Hash,ht,0)
local group g=CreateGroup()
local unit u
local integer a=15+10*GetPlayerTechCount(Player(id),'R00M',true)
set bj_groupEnumTypeId='n00H'
call GroupEnumUnitsOfPlayer(g,Player(id),filterGetUnitsOfPlayerAndTypeId)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitInGroup(u,udg_IncomeGroup)then
call SetPlayerStateBJ(Player(id),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)+a)
set GoldNT[id+1]=GoldNT[id+1]+a
call CreateTextTagUnitBJ("|cFFE3E300+"+I2S(a),u,0,9.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,90.00)
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
endif
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
set u=null
set g=null
set t=null
endfunction
