call TriggerAddAction(gg_trg_SamopozertvovanieHeal,function Trig_SamopozertvovanieHeal_Actions)
endfunction
function Trig_HuntressSkills_Q2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(hero)
local unit dummy=LoadUnitHandle(udg_hash,ht,1)
local real sec=LoadReal(udg_hash,ht,0)
local real x1
local real y1
local real x
local real y
if sec>0 then
set sec=sec-0.1
call SaveReal(udg_hash,ht,0,sec)
call SetUnitX(dummy,GetUnitX(hero))
call SetUnitY(dummy,GetUnitY(hero))
else
call F_RemoveUnit(dummy)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
set hero=null
set dummy=null
endfunction
function Trig_HuntressSkills_Q1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(hero)
local integer i=LoadInteger(Hash,h,0)
set s__Units_AllBlock[sUnit[i]]=s__Units_AllBlock[sUnit[i]]-2500
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set t=null
set hero=null
endfunction
function Trig_HuntressSkills_W takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(hero)
local unit target=LoadUnitHandle(udg_hash,ht,1)
local real sec=LoadReal(udg_hash,ht,10)
local real heal=LoadReal(udg_hash,ht,3)
local integer talante=LoadInteger(udg_hash,ht,6)
local effect e=LoadEffectHandle(udg_hash,ht,5)
local real x1
local real y1
local real x
local real y
local integer i
if sec>0 and UnitAlive(hero)then
set sec=sec-0.5
call SaveReal(udg_hash,ht,10,sec)
if talante==1 and GetUnitAbilityLevel(hero,'A0O2')==1 then
set heal=heal*(1.5-0.5*GetUnitState(target,UNIT_STATE_LIFE)/GetUnitState(target,UNIT_STATE_MAX_LIFE))
endif
call SetUnitState(target,UNIT_STATE_LIFE,GetUnitState(target,UNIT_STATE_LIFE)+heal)
else
if LoadBoolean(udg_hash,ht,4)then
set i=LoadInteger(Hash,h,0)
set s__Units_AllBlock[sUnit[i]]=s__Units_AllBlock[sUnit[i]]-2000
endif
call DestroyEffect(e)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
set hero=null
set target=null
set e=null
endfunction
function Trig_HuntressSkills_E takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit chack=LoadUnitHandle(udg_hash,ht,0)
local unit hero=LoadUnitHandle(udg_hash,ht,1)
local real dist=LoadReal(udg_hash,ht,0)
local real ugol=LoadReal(udg_hash,ht,1)
local real xb=LoadReal(udg_hash,ht,2)
local real yb=LoadReal(udg_hash,ht,3)
local real x
local real y
local unit u
if UnitAlive(chack)then
if dist>=400. then
set dist=400.
else
set dist=dist+3.
endif
set ugol=ugol+10.
if ugol>360. then
set ugol=ugol-360.
endif
set x=xb+dist*Cos(ugol*bj_DEGTORAD)
set y=yb+dist*Sin(ugol*bj_DEGTORAD)
call SetUnitX(chack,x)
call SetUnitY(chack,y)
call SaveReal(udg_hash,ht,0,dist)
call SaveReal(udg_hash,ht,1,ugol)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set hero=null
set chack=null
set u=null
set t=null
endfunction
function Trig_HuntressSkills_E_DMG takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit chack=LoadUnitHandle(udg_hash,ht,0)
local unit hero=LoadUnitHandle(udg_hash,ht,1)
local real dmg=LoadReal(udg_hash,ht,0)
local real dmg_2
local real x=GetUnitX(chack)
local real y=GetUnitY(chack)
local group g=CreateGroup()
local unit u
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local integer talante=udg_Talante[ID]
if UnitAlive(chack)then
if talante==2 and GetUnitAbilityLevel(hero,'A0O2')==1 and(GetFloatGameState(GAME_STATE_TIME_OF_DAY)<6.00 or GetFloatGameState(GAME_STATE_TIME_OF_DAY)>18.00)then
set dmg=1.2*dmg
endif
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,175.,Bool_Filter_ID)
if talante==1 and GetUnitAbilityLevel(hero,'A0O2')==1 then
set dmg_2=0.4*dmg
set dmg=0.6*dmg
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(hero,u,dmg_2,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",u,"chest")
call DestroyEffect(bj_lastCreatedEffect)
call GroupRemoveUnit(g,u)
endloop
else
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",u,"chest")
call DestroyEffect(bj_lastCreatedEffect)
call GroupRemoveUnit(g,u)
endloop
endif
else
call RemoveUnit(chack)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set hero=null
set chack=null
call DestroyGroup(g)
set g=null
set u=null
set t=null
endfunction
