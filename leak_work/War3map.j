function Quest_New_Bandit takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit bandit=LoadUnitHandle(udg_hash,ht,0)
local integer hb=GetHandleId(bandit)
local integer lvl=LoadInteger(udg_hash,hb,'l')
local integer id=LoadInteger(udg_hash,ht,4)
local integer sec=LoadInteger(udg_hash,ht,1)
local integer gold=LoadInteger(udg_hash,ht,2)
local boolean cd=LoadBoolean(udg_hash,ht,99)
local boolean cd_start=false
local boolean spell_coin=LoadBoolean(udg_hash,hb,1)
local boolean spell_summon=LoadBoolean(udg_hash,hb,2)
local real x
local real y
local real x1
local real y1
local real hp
local real dmg
local integer a=0
local integer b=6
local integer c
local unit u
local integer num=0
local boolean end=LoadBoolean(udg_hash,ht,0)
local timer t2
local integer ht2
local group g=CreateGroup()
local timerdialog td=LoadTimerDialogHandle(udg_hash,ht,10)
if sec>0 and udg_Time[2]<30. then
set sec=sec-1
call SaveInteger(udg_hash,ht,1,sec)
if UnitAlive(bandit)==false then
set end=true
call SaveBoolean(udg_hash,ht,0,true)
call Quest_New_Reward(id,ht)
else
set x=GetUnitX(bandit)
set y=GetUnitY(bandit)
call GroupEnumUnitsInRange(g,x,y,800.,null)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)and IsUnitEnemy(u,Player(PLAYER_NEUTRAL_AGGRESSIVE))and GetUnitAbilityLevel(u,'Avul')==0 then
set num=num+1
endif
call GroupRemoveUnit(g,u)
endloop
if num !=0 and cd==false then
if spell_summon==false then
set cd_start=true
if lvl==1 then
set c='nbrg'
set hp=100
set dmg=15
elseif lvl==2 then
set c='nass'
set hp=600
set dmg=75
elseif lvl==3 then
set c='n012'
set hp=4000
set dmg=350
set c='nbrg'
endif
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>2
set x1=GetUnitX(bandit)+175*Cos((GetUnitFacing(bandit)+180*bj_forLoopAIndex)*bj_DEGTORAD)
set y1=GetUnitY(bandit)+175*Sin((GetUnitFacing(bandit)+180*bj_forLoopAIndex)*bj_DEGTORAD)
set u=CreateUnit(Player(11),c,x1,y1,GetRandomInt(1,360))
call UnitApplyTimedLife(u,'BTLF',18.)
call UnitAddAbility(u,'A1DX')
call UnitAddAbility(u,'A007')
call SummonStats(false,R2I(hp),R2I(dmg),u,u)
call SetUnitOwner(u,Player(PLAYER_NEUTRAL_AGGRESSIVE),true)
call UnitRemoveAbility(u,'A007')
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call SaveBoolean(udg_hash,hb,2,true)
set t2=CreateTimer()
set ht2=GetHandleId(t2)
call SaveUnitHandle(udg_hash,ht2,0,bandit)
call TimerStart(t2,18.,false,function Quest_New_Bandit_Summon)
elseif spell_coin==false then
set cd_start=true
call SaveBoolean(udg_hash,hb,1,true)
set t2=CreateTimer()
set ht2=GetHandleId(t2)
call SaveUnitHandle(udg_hash,ht2,0,bandit)
call SaveInteger(udg_hash,ht2,0,8)
set a=0
loop
set a=a+1
exitwhen a==b
set x1=GetUnitX(bandit)+GetRandomInt(-800,800)
set y1=GetUnitY(bandit)+GetRandomInt(-800,800)
set u=CreateUnit(GetOwningPlayer(bandit),'h05L',x1,y1,GetRandomInt(1,360))
call SetUnitX(u,x1)
call SetUnitY(u,y1)
call SaveUnitHandle(udg_hash,ht2,a,u)
endloop
call SaveInteger(udg_hash,ht2,1,a)
call TimerStart(t2,1.,true,function Quest_New_Bandit_Coin)
endif
if cd_start then
call SaveBoolean(udg_hash,ht,99,true)
set t2=CreateTimer()
set ht2=GetHandleId(t2)
call SaveTimerHandle(udg_hash,ht2,0,t)
call TimerStart(t2,5.,false,function Quest_New_Bandit_CD)
endif
endif
endif
else
call RemoveUnit(bandit)
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Задание гильдии провалено!")
set bj_lastStartedTimer=CreateTimer()
call SaveInteger(udg_hash,GetHandleId(bj_lastStartedTimer),0,id)
set bj_lastCreatedTimerDialog=CreateTimerDialogBJ(bj_lastStartedTimer,"Новое задание гильдии")
call SaveTimerDialogHandle(udg_hash,GetHandleId(bj_lastStartedTimer),10,bj_lastCreatedTimerDialog)
call TimerDialogDisplay(bj_lastCreatedTimerDialog,false)
call TimerDialogDisplayForPlayerBJ(true,bj_lastCreatedTimerDialog,Player(id))
call TimerStart(bj_lastStartedTimer,75.,false,function QuestNew_ResetTimerQuest)
set end=true
call SaveBoolean(udg_hash,ht,0,true)
endif
if end or UnitAlive(bandit)==false then
call DestroyTimerDialog(td)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set s__Quests_Guild_unlock[sQuest[0]]=s__Quests_Guild_unlock[sQuest[0]]+1
endif
call DestroyGroup(g)
set td=null
set t=null
set bandit=null
set u=null
set g=null
endfunction
function Quest_New_FlowerMain takes nothing returns nothing
