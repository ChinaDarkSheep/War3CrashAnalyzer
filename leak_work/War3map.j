if GetUnitAbilityLevel(u,'A0S7')==0 and GetUnitAbilityLevel(u,'A15Z')==0 and GetUnitAbilityLevel(u,'A18R')==0 and GetUnitAbilityLevel(u,'A0M3')==0 and GetUnitAbilityLevel(u,'A18Q')==0 then
call UnitAddAbility(u,'A0S7')
if GetUnitAbilityLevel(u,'A0S8')==1 then
call UnitRemoveAbility(u,'A0S8')
endif
endif
set s__Units_Arm[sUnit[i]]=s__Units_Arm[sUnit[i]]+40
call F_Armore(u,s__Units_Arm[sUnit[i]])
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+6)
endif
if GetUnitTypeId(u)=='nbdr' then
set dmg=0.5*dmg
endif
call UnitAddAbility(u,'A007')
call SummonStats(false,R2I(x),R2I(y),u,caster)
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'A007')
endif
endif
if GetSpellAbilityId()=='A0EA' then
set g2=CreateGroup()
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,260.,Condition(function Trig_Filter_ID))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitAddAbility(u,'A0UW')
call SetUnitAbilityLevel(u,'A0UW',GetUnitAbilityLevel(u,'A0EA'))
call GroupAddUnit(g2,u)
call GroupRemoveUnit(g,u)
endloop
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveGroupHandle(udg_hash,ht,0,g2)
call TimerStart(t,15.,false,function Thief_W)
elseif GetSpellAbilityId()=='A1A6' then
set drop=GetUnitAbilityLevel(caster,'A1A6')*25+highstat/4
set u=GetSpellTargetUnit()
if GetHeroLevel(caster)>=50 then
set drop=drop+GoldNT[GetPlayerId(GetOwningPlayer(u))+1]/500
endif
call HighStat(u,drop,PositiveDuration(caster,14))
endif
if udg_Talante[ID]==2 then
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"ID призыва:"+I2S(TfsID)+" живых вечных: "+I2S(G_int))
endif
call SaveInteger(udg_hash,h,StringHash("IdforSummon"),TfsID)
call DestroyGroup(g)
set g=null
set g2=null
set G_max=null
set caster=null
set u=null
set t=null
endfunction
function InitTrig_Thief takes nothing returns nothing
set gg_trg_Thief=CreateTrigger()
call TriggerAddAction(gg_trg_Thief,function Trig_Thief_Actions)
endfunction
function Trig_ThiefW_Conditions takes nothing returns boolean
if not(GetUnitAbilityLevel(GetDyingUnit(),'A0UW')>0)then
return false
endif
return true
endfunction
function Trig_ThiefW_Func001C takes nothing returns boolean
if(not(IsUnitEnemy(GetDyingUnit(),GetOwningPlayer(GetKillingUnitBJ()))==true))then
return false
endif
if(not(GetOwningPlayer(GetKillingUnitBJ())!=Player(9)))then
return false
endif
if(not(GetOwningPlayer(GetKillingUnitBJ())!=Player(8)))then
return false
endif
if(not(GetOwningPlayer(GetKillingUnitBJ())!=Player(10)))then
return false
endif
if(not(GetOwningPlayer(GetKillingUnitBJ())!=Player(11)))then
return false
endif
if(not(GetPlayerController(GetOwningPlayer(GetDyingUnit()))!=MAP_CONTROL_USER))then
return false
endif
if(not(GetUnitAbilityLevelSwapped('Avul',GetDyingUnit())!=1))then
return false
endif
return true
endfunction
function Trig_ThiefW_Actions takes nothing returns nothing
local integer ID=GetPlayerId(GetOwningPlayer(udg_Thief))+1
local real gold
local integer a=GetPlayerId(GetOwningPlayer(GetKillingUnit()))+1
local integer b
local integer lvl=GetUnitLevel(GetDyingUnit())
if udg_Talante[ID]==3 and ID !=a then
set ID=a
endif
if(Trig_ThiefW_Func001C())then
if udg_HeroGold[ID]>0.00 then
set gold=lvl+3+lvl*(lvl+1)
if GetInventoryIndexOfItemTypeBJ(udg_Hero[ID],'I069')>0 then
set gold=gold+1
endif
if GetPlayerTechCount(Player(ID-1),'R02B',true)>12 then
set gold=gold+1
endif
if IsUnitInGroup(GetDyingUnit(),udg_behelit)then
if lvl<11 then
set gold=gold*1.4
else
set gold=gold*1.2
endif
call GroupRemoveUnit(udg_behelit,GetDyingUnit())
endif
if udg_HeroGold[ID]>udg_HeroGoldMax[ID]then
set gold=gold*udg_HeroGoldMax[ID]
else
set gold=gold*udg_HeroGold[ID]
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='mcou' then
if IsUnitType(GetDyingUnit(),UNIT_TYPE_HERO)or(lvl>=15 and ModuloInteger(lvl,5)==0)then
set gold=2*gold
endif
endif
if GetUnitAbilityLevel(GetDyingUnit(),'A0G6')==1 and(udg_Time[2]>=30 or udg_Time[3]>=1)then
set gold=10+1.5*gold
endif
if GetUnitAbilityLevel(GetKillingUnit(),'A0G6')==1 then
if GetRandomInt(1,10)>=2 then
set gold=2*gold
endif
endif
if udg_Setstart==true then
set gold=0.5*gold
endif
if IsUnitInGroup(GetDyingUnit(),udg_CrowW)==true then
set gold=1.75*gold
call GroupRemoveUnitSimple(GetDyingUnit(),udg_CrowW)
endif
set udg_point2=GetUnitLoc(udg_Hero[ID])
if GetUnitTypeId(GetKillingUnit())=='n04B' then
set udg_p=GetUnitLoc(GetKillingUnit())
if DistanceBetweenPoints(udg_p,udg_point2)>=2000. then
set gold=0.5*gold
endif
call RemoveLocation(udg_p)
endif
set udg_p=GetUnitLoc(GetDyingUnit())
if DistanceBetweenPoints(udg_p,udg_point2)>=4000. then
set gold=0.86*gold
endif
call RemoveLocation(udg_point2)
call RemoveLocation(udg_p)
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='mcou' then
set gold=gold+4+GetUnitLevel(GetDyingUnit())
endif
if GetUnitAbilityLevel(GetDyingUnit(),'A1DX')==1 then
set gold=gold/2
endif
set gold=gold*AllGold[ID]
set a=R2I(gold)/2
if udg_Talante[ID]==1 then
set b=a/5
if b>50 then
set b=50
endif
if GetRandomInt(1,100)<=b then
call ModifyHeroStat(bj_HEROSTAT_AGI,udg_Thief,bj_MODIFYMETHOD_ADD,2)
endif
endif
call AdjustPlayerStateBJ(a,ConvertedPlayer(ID),PLAYER_STATE_RESOURCE_GOLD)
set GoldNT[GetPlayerId(GetOwningPlayer(GetKillingUnit()))+1]=GoldNT[GetPlayerId(GetOwningPlayer(GetKillingUnit()))+1]+a
call CreateTextTagUnitBJ(("|cFFFFDC00+"+I2S(a)),GetDyingUnit(),0,10.00,100,100,100,0)
call ShowTextTagForceBJ(false,GetLastCreatedTextTag(),GetPlayersAll())
call ShowTextTagForceBJ(true,GetLastCreatedTextTag(),bj_FORCE_PLAYER[ID-1])
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
endif
endif
endfunction
function InitTrig_ThiefW takes nothing returns nothing
set gg_trg_ThiefW=CreateTrigger()
call DisableTrigger(gg_trg_ThiefW)
call TriggerRegisterAnyUnitEventBJ(gg_trg_ThiefW,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(gg_trg_ThiefW,Condition(function Trig_ThiefW_Conditions))
call TriggerAddAction(gg_trg_ThiefW,function Trig_ThiefW_Actions)
endfunction
function Trig_CrabSkills_R_1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(caster)
local integer iuh=LoadInteger(Hash,h,0)
set s__Units_AllDmg[sUnit[iuh]]=s__Units_AllDmg[sUnit[iuh]]-3000
set s__Units_AllBlock[sUnit[iuh]]=s__Units_AllBlock[sUnit[iuh]]-3000
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set caster=null
set t=null
endfunction
function Trig_CrabSkills_R_2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local real sec=LoadReal(udg_hash,ht,1)
local effect e=LoadEffectHandle(udg_hash,ht,2)
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real dmg=GetHeroStr(caster,true)
local integer i=LoadInteger(Hash,GetHandleId(caster),0)
if sec>0 and udg_KrabUlt then
call GroupDamage(x,y,300.,caster,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
set sec=sec-1
call SaveReal(udg_hash,ht,1,sec)
else
call DestroyEffect(e)
set s__Units_AllBlock[sUnit[i]]=s__Units_AllBlock[sUnit[i]]-3000
set s__Units_Arm[sUnit[i]]=s__Units_Arm[sUnit[i]]-70
call F_Armore(caster,s__Units_Arm[sUnit[i]])
set udg_KrabUlt=false
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
set caster=null
set e=null
set t=null
endfunction
function Trig_CrabSkills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local integer h=GetHandleId(caster)
local integer iuh=LoadInteger(Hash,h,0)
local integer talante=udg_Talante[ID]
local real x
local real y
local real dmg
local real max_hp=GetUnitState(caster,UNIT_STATE_MAX_LIFE)
local timer t
local integer ht
local integer a
if GetSpellAbilityId()=='AUfa' then
if talante==2 then
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+0.25*max_hp)
if GetUnitAbilityLevel(caster,'A0F3')>0 then
call TempStats(caster,0,0,0,0,GetHeroStr(caster,true)/10,0,PositiveDuration(caster,15))
endif
endif
endif
if GetSpellAbilityId()=='A0ET' then
set dmg=3.*GetHeroStr(caster,true)
if talante==1 then
if GetHeroLevel(caster)>=50 then
set a=1
loop
exitwhen a>5
call HeroAttack(caster,caster,GetSpellTargetUnit())
call Modificator(caster,caster,GetSpellTargetUnit())
set a=a+1
endloop
endif
set dmg=dmg+Summ_Attack(caster)
endif
call CreateTextTagUnitBJ("КЛАЦ-КЛАЦ",GetSpellTargetUnit(),0,10.00,100.00,50.00,50.00,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
call UnitDamageTarget(caster,GetSpellTargetUnit(),dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set x=GetUnitX(GetSpellTargetUnit())
set y=GetUnitY(GetSpellTargetUnit())
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodKnight.mdl",x,y))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodMortarTeam.mdl",x,y))
if UnitAlive(GetSpellTargetUnit())==false then
call InfStats(caster,1,0,0,0,0,0)
if talante==2 then
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]+20
endif
endif
else
endif
if GetSpellAbilityId()=='A1D9' then
set y=PositiveDuration(caster,8)
call TempStats(caster,0,0,0,GetHeroStr(caster,true),0,0,y)
set s__Units_AllDmg[sUnit[iuh]]=s__Units_AllDmg[sUnit[iuh]]+3000
set s__Units_AllBlock[sUnit[iuh]]=s__Units_AllBlock[sUnit[iuh]]+3000
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,y,false,function Trig_CrabSkills_R_1)
endif
if GetSpellAbilityId()=='A0ER' then
set udg_KrabUlt=true
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set dmg=GetHeroStr(caster,true)
set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\BlackFrost Glacial Storm.mdx",x,y)
set s__Units_AllBlock[sUnit[iuh]]=s__Units_AllBlock[sUnit[iuh]]+3000
set s__Units_Arm[sUnit[iuh]]=s__Units_Arm[sUnit[iuh]]+70
call F_Armore(caster,s__Units_Arm[sUnit[iuh]])
set udg_Effect[38]=GetLastCreatedEffectBJ()
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveReal(udg_hash,ht,1,20)
call SaveEffectHandle(udg_hash,ht,2,bj_lastCreatedEffect)
call TimerStart(t,1.,true,function Trig_CrabSkills_R_2)
call GroupDamage(x,y,300.,caster,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
else
endif
set caster=null
set t=null
endfunction
function InitTrig_CrabSkills takes nothing returns nothing
set gg_trg_CrabSkills=CreateTrigger()
call TriggerAddAction(gg_trg_CrabSkills,function Trig_CrabSkills_Actions)
endfunction
function Potroshitel_DFilter takes nothing returns boolean
return(not(ModuloInteger(GetUnitLevel(GetFilterUnit()),5)==0 and GetUnitLevel(GetFilterUnit())>=15)and GetUnitX(GetFilterUnit())>-14000. and GetUnitAbilityLevel(GetFilterUnit(),'Arsk')==0 and GetUnitAbilityLevel(GetFilterUnit(),'Avul')==0 and UnitAlive(GetFilterUnit())and GetUnitTypeId(GetFilterUnit())!='n00R' and GetUnitTypeId(GetFilterUnit())!='nsw3' and GetUnitTypeId(GetFilterUnit())!='nsw2' and GetUnitTypeId(GetFilterUnit())!='nsw1' and GetOwningPlayer(GetFilterUnit())==Player(PLAYER_NEUTRAL_AGGRESSIVE))
endfunction
function Trig_Potroshitel_Q takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer hit=LoadInteger(Hash,ht,0)
local unit caster=LoadUnitHandle(Hash,ht,0)
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real xt
local real yt
local group g=CreateGroup()
local unit u
local real dmg
local real r
if hit>0 then
call SaveInteger(Hash,ht,0,hit-1)
if GetHeroLevel(caster)>49 then
set dmg=Summ_Attack(caster)+6*GetPlayerTechCount(GetOwningPlayer(caster),'R01W',true)
else
set dmg=GetHeroAgi(caster,true)+6*GetPlayerTechCount(GetOwningPlayer(caster),'R01W',true)
endif
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,500.00,Bool_Filter_ID)
call RandomUnitFromGroup(1,g)
set u=FirstOfGroup(g)
set xt=GetUnitX(u)
set yt=GetUnitY(u)
if UnitAlive(u)then
call SetUnitAnimation(caster,"attack")
set x=xt+40.*Cos((180.+GetUnitFacing(u))*bj_DEGTORAD)
set y=yt+40.*Sin((180.+GetUnitFacing(u))*bj_DEGTORAD)
call SetUnitPosition(caster,x,y)
call SetUnitFacing(caster,GetUnitFacing(u))
set x=GetUnitX(caster)
set y=GetUnitY(caster)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl",x,y))
endif
set r=Psych_crit(caster,1.,1.)
if r>1. then
set dmg=dmg*r
set udg_TEXT=CreateTextTag()
call SetTextTagTextBJ(udg_TEXT,"|cFFFF0000+"+I2S(R2I(dmg))+"!",9.)
call SetTextTagPos(udg_TEXT,x,y,0)
call SetTextTagColorBJ(udg_TEXT,100.,100.,100.,0.)
call SetTextTagVisibility(udg_TEXT,false)
if GetLocalPlayer()==GetOwningPlayer(caster)then
call SetTextTagVisibility(udg_TEXT,true)
endif
call SetTextTagVelocityBJ(udg_TEXT,75.,90.)
call SetTextTagSuspended(udg_TEXT,false)
call SetTextTagPermanent(udg_TEXT,false)
call SetTextTagLifespan(udg_TEXT,3.00)
call SetTextTagFadepoint(udg_TEXT,2.00)
endif
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,xt,yt,300.,Bool_Filter_ID)
call UnitDamageTarget(caster,u,dmg,false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
set dmg=.5*dmg
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(Hash,ht)
call UnitRemoveAbility(caster,'A0FF')
call PauseUnitBJ(false,caster)
call SetUnitInvulnerable(caster,false)
call SelectUnitForPlayerSingle(caster,GetOwningPlayer(caster))
call SetUnitTimeScalePercent(caster,100.00)
endif
call DestroyGroup(g)
set g=null
set t=null
set caster=null
set u=null
endfunction
function Trig_Potroshitel_F takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local real sec=LoadReal(udg_hash,ht,0)
if sec>0 then
call SaveReal(udg_hash,ht,0,sec-.25)
call GroupDamage(GetUnitX(hero),GetUnitY(hero),260.,hero,true,.3*GetHeroAgi(hero,true),ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set hero=null
set t=null
endfunction
function Trig_Potroshitel_Actions takes nothing returns nothing
local unit hero=GetTriggerUnit()
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local timer t
local integer ht
local group g=CreateGroup()
local real x
local real y
local integer a
if GetSpellAbilityId()=='A0FA' then
call SetUnitVertexColorBJ(udg_KillerTarget,100,100,100,0)
call GroupEnumUnitsInRect(g,GetWorldBounds(),Condition(function Potroshitel_DFilter))
call RandomUnitFromGroup(1,g)
set udg_KillerTarget=FirstOfGroup(g)
call PingMinimapForForceEx(bj_FORCE_PLAYER[ID-1],GetUnitX(udg_KillerTarget),GetUnitY(udg_KillerTarget),35.,bj_MINIMAPPINGSTYLE_SIMPLE,75.,0.,100.)
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],30,("|cFFFF5800Установлена цель - "+GetUnitName(udg_KillerTarget)))
call SetUnitVertexColorBJ(udg_KillerTarget,75.00,0.00,100,0)
endif
if GetSpellAbilityId()=='AOww' then
call TempStats(hero,0,0,0,0,100+GetHeroAgi(hero,true)/5,0,9)
call TempStats(hero,0,0,0,200+GetHeroAgi(hero,true),0,0,18)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveReal(udg_hash,ht,0,9.)
call SaveUnitHandle(udg_hash,ht,0,hero)
call TimerStart(t,.25,true,function Trig_Potroshitel_F)
endif
if GetSpellAbilityId()=='A0FE' then
set a=3+3*GetUnitAbilityLevel(hero,'A0FE')
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveInteger(Hash,ht,0,a)
call SaveUnitHandle(Hash,ht,0,hero)
call TimerStart(t,.08,true,function Trig_Potroshitel_Q)
call UnitAddAbility(hero,'A0FF')
call SelectUnitRemoveForPlayer(hero,GetOwningPlayer(hero))
call PauseUnitBJ(true,hero)
call SetUnitInvulnerable(hero,true)
call SetUnitTimeScalePercent(hero,500.00)
endif
call DestroyGroup(g)
set g=null
set hero=null
set t=null
endfunction
function InitTrig_Potroshitel takes nothing returns nothing
set gg_trg_Potroshitel=CreateTrigger()
call TriggerAddAction(gg_trg_Potroshitel,function Trig_Potroshitel_Actions)
endfunction
function Trig_PotroshitelD_Conditions takes nothing returns boolean
if(not(GetDyingUnit()==udg_KillerTarget))then
return false
endif
return true
endfunction
function Trig_PotroshitelD_Actions takes nothing returns nothing
if GetOwningPlayer(GetKillingUnitBJ())==GetOwningPlayer(udg_Potroshitel)then
call SetPlayerTechResearchedSwap('R01W',(GetPlayerTechCountSimple('R01W',GetOwningPlayer(udg_Potroshitel))+1),GetOwningPlayer(udg_Potroshitel))
call DisplayTimedTextToForce(GetForceOfPlayer(GetOwningPlayer(udg_Potroshitel)),30,("|cFFFF5800Цель уничтожена, ваш текущий уровень мастерства - "+I2S(GetPlayerTechCountSimple('R01W',GetOwningPlayer(udg_Potroshitel)))))
else
call DisplayTimedTextToForce(GetForceOfPlayer(GetOwningPlayer(udg_Potroshitel)),30,("|cFFFF5800Ваша цель была уничтожена другим игроком - "+GetPlayerName(GetOwningPlayer(GetKillingUnitBJ()))))
endif
if GetPlayerTechCountSimple('R01W',GetOwningPlayer(udg_Potroshitel))==25 then
call UnitRemoveAbility(udg_Potroshitel,'A0FA')
call DisplayTextToForce(GetForceOfPlayer(GetOwningPlayer(udg_Potroshitel)),"|cFF52EDF1Ваш герой достиг максимального уровня мастерства! Вы получаете предмет \\\"Кусабимару\\\"!")
call UnitAddItemByIdSwapped('I06X',udg_Potroshitel)
endif
endfunction
function InitTrig_PotroshitelD takes nothing returns nothing
set gg_trg_PotroshitelD=CreateTrigger()
call DisableTrigger(gg_trg_PotroshitelD)
call TriggerRegisterAnyUnitEventBJ(gg_trg_PotroshitelD,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(gg_trg_PotroshitelD,Condition(function Trig_PotroshitelD_Conditions))
call TriggerAddAction(gg_trg_PotroshitelD,function Trig_PotroshitelD_Actions)
endfunction
function SuccubusW takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local real x=LoadReal(udg_hash,ht,0)
local real y=LoadReal(udg_hash,ht,1)
local real angle=LoadReal(udg_hash,ht,2)
local real dmg
local integer sec=LoadInteger(udg_hash,ht,4)
local real x1
local real y1
local unit u
local group g=CreateGroup()
call SaveInteger(udg_hash,ht,4,sec-1)
if sec==1 then
if udg_Talante[GetPlayerId(GetOwningPlayer(caster))+1]==2 then
call GroupEnumUnitsInRange(g,x,y,250.,null)
set dmg=GetHeroAgi(caster,true)*2
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)and IsUnitEnemy(u,GetOwningPlayer(caster))then
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
call GroupRemoveUnit(g,u)
endloop
endif
set dmg=GetHeroAgi(caster,true)*2+45*GetUnitAbilityLevel(caster,'A0FW')
set bj_forLoopAIndex=0
loop
exitwhen bj_forLoopAIndex>3
set x1=x+250.*Cos((angle-90.+bj_forLoopAIndex*45.)*bj_DEGTORAD)
set y1=y+250.*Sin((angle-90.+bj_forLoopAIndex*45.)*bj_DEGTORAD)
call GroupDamage(x1,y1,250,caster,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl",x1,y1))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call SaveInteger(udg_hash,ht,0,0)
else
set dmg=GetHeroAgi(caster,true)*2+45*GetUnitAbilityLevel(caster,'A0FW')
set bj_forLoopAIndex=0
loop
exitwhen bj_forLoopAIndex>5
set x1=x+500.*Cos((angle-120.+bj_forLoopAIndex*40.)*bj_DEGTORAD)
set y1=y+500.*Sin((angle-120.+bj_forLoopAIndex*40.)*bj_DEGTORAD)
call GroupDamage(x1,y1,250,caster,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl",x1,y1))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
call DestroyGroup(g)
set t=null
set caster=null
endfunction
