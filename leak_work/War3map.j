else
set udg_MoargD=(udg_MoargD+0.07)
call SetUnitLifePercentBJ(udg_Moarg,(GetUnitLifePercent(udg_Moarg)+0.60))
endif
if udg_MoargD>udg_MoargDLimit then
set udg_MoargD=udg_MoargDLimit
else
endif
call CreateTextTagUnitBJ((I2S(R2I((udg_MoargD*100.00)))+"%"),udg_Moarg,0,14.00,100.00,35.00,0.00,0)
set udg_MoargText=GetLastCreatedTextTag()
if udg_MoargR then
call GroupDamage(GetUnitX(udg_Moarg),GetUnitY(udg_Moarg),250,udg_Moarg,false,GetHeroStr(udg_Moarg,true)/10,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
else
endif
endfunction
