function BossDamaged_Mefisto_StealLife_CD takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit boss=LoadUnitHandle(udg_hash,ht,0)
call SaveBoolean(udg_hash,GetHandleId(boss),StringHash("LifeBurn"),true)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set t=null
set boss=null
endfunction
function BossDamaged_Mefisto_StealLife takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit boss=LoadUnitHandle(udg_hash,ht,0)
local integer i=LoadInteger(udg_hash,ht,1)
local integer a=0
local real x=GetUnitX(boss)
local real y=GetUnitY(boss)
local group g=CreateGroup()
local unit u
local real dmg
local real hp
if i !=0 then
call SetUnitAnimation(boss,"channel")
call GroupEnumUnitsInRange(g,x,y,1000.,null)
if udg_HardestLogic then
if udg_Mode==2 then
set dmg=300
else
set dmg=200
endif
else
set dmg=100
endif
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)and IsUnitEnemy(u,GetOwningPlayer(boss))and IsUnitType(u,UNIT_TYPE_STRUCTURE)==false then
set a=1
set hp=GetUnitState(u,UNIT_STATE_LIFE)*0.02
if IsUnitType(u,UNIT_TYPE_HERO)==true then
call SetUnitState(boss,UNIT_STATE_LIFE,GetUnitState(boss,UNIT_STATE_LIFE)+dmg+hp)
call UnitDamageTarget(boss,u,dmg+hp,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(boss,u,hp,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
else
call SetUnitState(boss,UNIT_STATE_LIFE,GetUnitState(boss,UNIT_STATE_LIFE)+(dmg+hp)/10)
call UnitDamageTarget(boss,u,dmg+2*hp,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(boss,u,2*hp,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl",u,"chest")
call DestroyEffect(bj_lastCreatedEffect)
endif
call GroupRemoveUnit(g,u)
endloop
set i=i-1
if a==0 then
set i=0
endif
call SaveInteger(udg_hash,ht,1,i)
else
call PauseUnit(boss,false)
call SetUnitAnimation(boss,"stand")
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set t=CreateTimer()
call SaveUnitHandle(udg_hash,GetHandleId(t),0,boss)
call TimerStart(t,50.,false,function BossDamaged_Mefisto_StealLife_CD)
endif
call DestroyGroup(g)
set boss=null
set g=null
set u=null
set t=null
endfunction
function BossDamaged_LordOfCold_Q takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit boss=LoadUnitHandle(udg_hash,ht,1)
