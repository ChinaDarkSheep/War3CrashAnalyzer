function InitTrig_QuestNew_ResetOrder takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer i=0
local real x=GetUnitX(BaseGuild)
local real y=GetUnitY(BaseGuild)
if udg_Time[2]<30. and udg_Time[3]==0 then
set i=0
loop
exitwhen i>5
set bj_lastCreatedItem=QuestNew_ResetOrderId(i)
set i=i+1
endloop
else
call PauseTimer(t)
call DestroyTimer(t)
endif
set t=null
endfunction
function InitTrig_QuestNew_Phase takes nothing returns nothing
local string text=GetEventPlayerChatString()
local string command=SubString(text,7,8)
set CommandPhase=S2I(command)
if CommandPhase>0 then
call BJDebugMsg("Установлена "+I2S(CommandPhase)+"Фаза")
else
call BJDebugMsg("Установлены классические фазы")
endif
set text=""
set command=""
endfunction
