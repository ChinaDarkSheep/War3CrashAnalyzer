set s__Units_MP[sUnit[i]]=0
set s__Units_GAttack[sUnit[i]]=0
set s__Units_Arm[sUnit[i]]=0
set s__Units_BarE[sUnit[i]]=null
set s__Units_Bar[sUnit[i]]=0.
set s__Units_BarLich[sUnit[i]]=0.
set i=i+1
exitwhen i>T_Unit
endloop
endfunction
function SeekFreeUnit takes integer id returns integer
local integer i=1
loop
if i>T_Unit then
set sUnit[i]=s__Units__allocate()
set T_Unit=i
endif
if s__Units_id[sUnit[i]]==0 then
call SaveInteger(Hash,id,0,i)
set s__Units_id[sUnit[i]]=id
set s__Units_AllDmg[sUnit[i]]=10000
set s__Units_AllDmgM[sUnit[i]]=10000
set s__Units_AllTake[sUnit[i]]=10000
set s__Units_AllBlock[sUnit[i]]=10000
set s__Units_MageBlock[sUnit[i]]=10000
set s__Units_MageTake[sUnit[i]]=10000
set s__Units_MageDamage[sUnit[i]]=10000
set s__Units_NoMageDmg[sUnit[i]]=10000
set s__Units_Immortal[sUnit[i]]=0
set s__Units_HP[sUnit[i]]=0
set s__Units_MP[sUnit[i]]=0
set s__Units_GAttack[sUnit[i]]=0
set s__Units_Arm[sUnit[i]]=0
set s__Units_BarE[sUnit[i]]=null
set s__Units_Bar[sUnit[i]]=0.
set s__Units_BarLich[sUnit[i]]=0.
return i
endif
set i=i+1
endloop
return 0
endfunction
function SeekFreeUnitMin takes integer id returns integer
local integer i=0+T_UnitMin
loop
if i>T_Unit then
set sUnit[i]=s__Units__allocate()
set T_Unit=i+0
endif
if s__Units_id[sUnit[i]]==0 then
call SaveInteger(Hash,id,0,i)
set s__Units_id[sUnit[i]]=id
set s__Units_AllDmg[sUnit[i]]=10000
set s__Units_AllDmgM[sUnit[i]]=10000
set s__Units_AllTake[sUnit[i]]=10000
