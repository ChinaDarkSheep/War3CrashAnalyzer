function Set9_Wave1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer sec=LoadInteger(udg_hash,ht,0)+1
local integer i
local integer a
local integer ht2
local timer t2
if sec<420 then
call SaveInteger(udg_hash,ht,0,sec)
if sec==10 then
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,80.00,"|cFFFF5800Мефисто уже прибыл и скоро он начнёт атаку, будьте готовы ко всем его уловкам.")
call EnableTrigger(gg_trg_MoveAttackers)
call EnableTrigger(gg_trg_AntiBugAttackers)
call EnableTrigger(gg_trg_MefistoExplosions)
call EnableTrigger(gg_trg_MefistoSkills)
call EnableTrigger(gg_trg_MefistoSummons)
call EnableTrigger(gg_trg_MefistoDeath)
call EnableTrigger(gg_trg_Mefisto3sec)
if HardcoreUP30==3 then
set bj_forLoopAIndexEnd=2
else
set bj_forLoopAIndexEnd=1
endif
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set a=GetRandomInt(1,6)
set bj_lastCreatedUnit=CreateUnit(ForcePickRandomPlayer(udg_CreepsPlayers),'nhfp',RandomSpawnX[a],RandomSpawnY[a],bj_UNIT_FACING)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set bj_lastCreatedUnit=CreateUnit(ForcePickRandomPlayer(udg_CreepsPlayers),'U01A',GetRectCenterX(gg_rct_Priziv),GetRectCenterY(gg_rct_Priziv),bj_UNIT_FACING)
set udg_Mefisto=bj_lastCreatedUnit
call SeekFreeHero(GetHandleId(bj_lastCreatedUnit))
set a=SeekFreeUnit(GetHandleId(udg_Mefisto))
set s__Units_AllBlock[sUnit[a]]=s__Units_AllBlock[sUnit[a]]+25000
set t2=CreateTimer()
set ht2=GetHandleId(t2)
call SaveUnitHandle(udg_hash,ht2,0,udg_Mefisto)
call SaveInteger(udg_hash,ht2,0,0)
call TimerStart(t2,12,true,function MefistoImmortal)
call GroupAddUnit(BossG,udg_Mefisto)
call GroupAddUnit(udg_ug_Regen,udg_Mefisto)
call GroupAddUnit(G_HeroesIncBoss,udg_Mefisto)
call SaveBoolean(udg_hash,GetHandleId(udg_Mefisto),'b',true)
call SaveBoolean(udg_hash,GetHandleId(udg_Mefisto),StringHash("LifeBurn"),true)
call TriggerRegisterUnitEvent(gg_trg_BossDamaged,udg_Mefisto,EVENT_UNIT_DAMAGED)
call UnitAddItemByIdSwapped('I07E',udg_Mefisto)
call UnitAddItemByIdSwapped('I063',udg_Mefisto)
call UnitAddItemByIdSwapped('I038',udg_Mefisto)
call UnitAddItemByIdSwapped('I07B',udg_Mefisto)
call UnitAddItemByIdSwapped('I07M',udg_Mefisto)
call UnitAddItemByIdSwapped('I059',udg_Mefisto)
call SetHeroLevelBJ(udg_Mefisto,50,false)
if udg_HardestLogic then
if udg_Mode==2 then
call ModifyHeroStat(bj_HEROSTAT_STR,udg_Mefisto,bj_MODIFYMETHOD_ADD,500)
call ModifyHeroStat(bj_HEROSTAT_AGI,udg_Mefisto,bj_MODIFYMETHOD_ADD,250)
else
call ModifyHeroStat(bj_HEROSTAT_STR,udg_Mefisto,bj_MODIFYMETHOD_ADD,400)
call ModifyHeroStat(bj_HEROSTAT_AGI,udg_Mefisto,bj_MODIFYMETHOD_ADD,150)
endif
endif
set udg_SetEnd=true
elseif sec==310 then
call GroupAddUnit(udg_A2,udg_Mefisto)
elseif ModuloInteger(sec,30)==0 then
call ConditionalTriggerExecute(gg_trg_MefistoSummons)
endif
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t2=null
set t=null
endfunction
