set u=null
set t=null
set g=null
set g2=null
endfunction
function Trig_ButcherSkills_Actions takes nothing returns nothing
local unit hero=GetTriggerUnit()
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local integer h=GetHandleId(hero)
local real x
local real y
local real dmg
local unit u
local timer t
local integer ht
local integer a=0
local integer b=0
local integer c=0
local group g=CreateGroup()
local boolean Bool=false
if GetSpellAbilityId()=='A070' and not LoadBoolean(udg_hash,h,StringHash("PassiveE"))then
call F_ButcherE2(hero)
endif
if GetSpellAbilityId()=='A00X' then
if udg_Talante[ID]==1 then
set dmg=Summ_Attack(hero)
elseif udg_Talante[ID]==2 then
set dmg=.4*GetUnitState(hero,UNIT_STATE_MAX_LIFE)
if GetHeroLevel(hero)>=50 then
set dmg=.6*GetUnitState(hero,UNIT_STATE_MAX_LIFE)
endif
endif
set u=GetSpellTargetUnit()
set a=5
set b=4
if GetUnitAbilityLevel(hero,'A0C0')==1 then
if udg_Talante[ID]==1 then
set a=0
set b=26
endif
if udg_Talante[ID]==2 then
call FoTDeath(hero,GetUnitX(hero),GetUnitY(hero),false)
endif
endif
call UnitDamageTarget(hero,u,dmg,false,true,ConvertAttackType(a),ConvertDamageType(b),WEAPON_TYPE_AXE_MEDIUM_CHOP)
if not UnitAlive(u)then
set Bool=true
else
if GetUnitAbilityLevel(hero,'A0C0')==1 and udg_Talante[ID]==1 then
call UnitAddAbility(u,'A0OH')
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call TimerStart(t,20,false,function Butcher_Q_R)
endif
endif
if udg_Talante[ID]==2 then
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),300.,Bool_Filter_ID)
call GroupRemoveUnit(g,u)
set dmg=.75*dmg
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,true,ConvertAttackType(a),ConvertDamageType(b),WEAPON_TYPE_AXE_MEDIUM_CHOP)
if not UnitAlive(u)then
set Bool=true
endif
call GroupRemoveUnit(g,u)
endloop
endif
if Bool then
if udg_Setstart then
set b=1
set c=5
else
set b=3
set c=25
endif
if udg_Talante[ID]==1 then
call TakeHeroAttack(b,hero)
elseif udg_Talante[ID]==2 then
set a=LoadInteger(Hash,h,0)
set s__Units_HP[sUnit[a]]=s__Units_HP[sUnit[a]]+c
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIlm\\AIlmTarget.mdl",hero,"origin"))
endif
elseif GetSpellAbilityId()=='A0OA' then
if udg_Talante[ID]==1 then
call UnitAddAbility(hero,'A0OB')
call SetUnitAbilityLevel(hero,'A0OB',GetUnitAbilityLevel(hero,'A0OA'))
elseif udg_Talante[ID]==2 then
set a=400*GetUnitAbilityLevel(hero,'A0OA')+2*GetHeroStr(hero,true)
if GetUnitAbilityLevel(hero,'A0C0')==1 then
set a=a*2
endif
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.01*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
call TempStats(hero,0,0,0,0,0,a,13.)
endif
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveReal(udg_hash,ht,0,13.)
call TimerStart(t,1.,true,function Butcher_W)
elseif GetSpellAbilityId()=='A0OF' then
call UnitAddAbility(hero,'A0OG')
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveInteger(udg_hash,ht,1,23)
call SaveGroupHandle(udg_hash,ht,2,CreateGroup())
call TimerStart(t,1,true,function Butcher_R)
else
endif
call DestroyGroup(g)
set g=null
set hero=null
set u=null
set t=null
endfunction
