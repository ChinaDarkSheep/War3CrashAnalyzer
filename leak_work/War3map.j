call UnitDamageTarget(attack,u,damage,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
call GroupRemoveUnit(g,u)
endloop
call Func_CD(attack,"Balmung",2.25/CD)
endif
set a=0
set i2=0
loop
exitwhen a==6
if GetItemTypeId(UnitItemInSlot(hero,a))=='gopr' then
set i2=1
endif
set a=a+1
endloop
if i2>0 and LoadBoolean(udg_hash,ha,StringHash("Ammeraks"))==false then
set damage=(0.6*Attacks)*bonus*Psych_crit(hero,1.,1.)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",xt,yt)
call DestroyEffect(bj_lastCreatedEffect)
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,xt,yt,275,Bool_Filter_ID)
set x=GetUnitState(attack,UNIT_STATE_LIFE)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if x>GetUnitState(u,UNIT_STATE_LIFE)then
call UnitDamageTarget(attack,u,1.5*damage,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
else
call UnitDamageTarget(attack,u,damage,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
endif
call GroupRemoveUnit(g,u)
endloop
call Func_CD(attack,"Ammeraks",2./CD)
endif
set a=0
set i2=0
loop
exitwhen a==6
if GetItemTypeId(UnitItemInSlot(hero,a))=='I0BW' then
set i2=1
endif
set a=a+1
endloop
if i2>0 and LoadBoolean(udg_hash,ha,StringHash("GiantHammer"))==false then
set a=175+3*highstat/20
call TempStats(attack,0,0,0,0,a,0,4.)
call Func_CD(attack,"GiantHammer",10.)
endif
set a=0
set i2=0
loop
exitwhen a==6
if GetItemTypeId(UnitItemInSlot(hero,a))=='I07L' then
set i2=1
endif
set a=a+1
endloop
if i2>0 then
set i=GetPlayerId(GetOwningPlayer(attack))+1
set udg_ReflectDmg[i]=(udg_ReflectDmg[i]+6.00)
set bj_lastStartedTimer=CreateTimer()
call SaveInteger(udg_hash,GetHandleId(bj_lastStartedTimer),0,i)
call TimerStart(bj_lastStartedTimer,5.,false,function Trig_AtkSkill_Ghost_Sword)
else
endif
set a=0
set i2=0
loop
exitwhen a==6
if GetItemTypeId(UnitItemInSlot(hero,a))=='I0C2' then
set i2=1
endif
set a=a+1
endloop
if i2==1 and LoadBoolean(udg_hash,ha,StringHash("DeathSpear"))==false then
set damage=(GetHeroAgi(hero,true)*1.4)*bonus
set damage=damage+50
set damage=damage/2
call UnitDamageTarget(attack,target,damage,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Items\\OrbVenom\\OrbVenomSpecialArt.mdl",target,"origin")
call DestroyEffect(bj_lastCreatedEffect)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,attack)
call SaveUnitHandle(udg_hash,ht,1,target)
call SaveReal(udg_hash,ht,2,1.5)
call SaveReal(udg_hash,ht,3,damage)
call Func_CD(attack,"DeathSpear",3.5/CD)
call TimerStart(t,0.5,true,function Trig_AtkSkill_DeathPear)
endif
endif
set u=null
call DestroyGroup(g)
set g=null
call DestroyGroup(g2)
set g2=null
set t=null
set str=""
endfunction
function InitTrig_AtkSkillJass takes nothing returns nothing
local integer index
set gg_trg_AtkSkillJass=CreateTrigger()
endfunction
function Trig_ReflectDmg_Gnom_Shield takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit target=LoadUnitHandle(udg_hash,ht,0)
local integer i=LoadInteger(udg_hash,ht,1)
local integer armore=LoadInteger(udg_hash,ht,0)
if i !=0 or target==null then
set i=i-1
call SaveInteger(udg_hash,ht,1,i)
if i==11 then
set i=LoadInteger(Hash,GetHandleId(target),0)
set s__Units_MageBlock[sUnit[i]]=s__Units_MageBlock[sUnit[i]]-3000
set s__Units_Arm[sUnit[i]]=s__Units_Arm[sUnit[i]]-armore
call F_Armore(target,s__Units_Arm[sUnit[i]])
endif
else
call SaveBoolean(udg_hash,GetHandleId(target),StringHash("Gnom Shield"),false)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
set t=null
set target=null
endfunction
function Trig_ReflectDmg_Actions takes nothing returns nothing
local unit target=GetTriggerUnit()
local unit attack=GetAttacker()
local integer h=GetHandleId(target)
local integer id=GetPlayerId(GetOwningPlayer(target))
local integer ID=id+1
local integer a=0
local integer drop=0
local real r
local real z
local timer t
local integer ht
local integer mainstat
local string str
local real xt=GetUnitX(target)
local real yt=GetUnitY(target)
local integer LA
local boolean array LB
if IsUnitType(target,UNIT_TYPE_HERO)then
if LoadStr(udg_hash,h,2)=="Str" then
set mainstat=GetHeroStr(target,true)
else
if LoadStr(udg_hash,h,2)=="Agi" then
set mainstat=GetHeroAgi(target,true)
else
set mainstat=GetHeroInt(target,true)
endif
endif
if ID<=8 then
if GetUnitAbilityLevel(target,'A0T5')==1 then
if GetRandomInt(1,10)==1 and LoadBoolean(udg_hash,h,StringHash("R"))==false then
call GroupDamage(xt,yt,450,target,false,GetHeroStr(target,true)*2,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
call DestroyEffect(AddSpecialEffect("war3mapImported\\LightNova.mdx",xt,yt))
if GetUnitAbilityLevel(target,'A0T6')==1 then
call SetUnitState(target,UNIT_STATE_LIFE,GetUnitState(target,UNIT_STATE_LIFE)+.02*GetUnitState(target,UNIT_STATE_MAX_LIFE))
endif
call Func_CD(target,"R",2)
endif
endif
if udg_Talante[ID]==1 then
if GetUnitAbilityLevel(target,'A015')>0 then
if GetFloatGameState(GAME_STATE_TIME_OF_DAY)<6 or GetFloatGameState(GAME_STATE_TIME_OF_DAY)>18 then
set z=.28
set a=40
else
set z=.35
set a=25
endif
if GetRandomInt(1,100)<=a then
set r=GetUnitAbilityLevel(target,'A015')*50+1.25*GetHeroAgi(target,true)
call UnitDamageTarget(target,attack,0.75*r,false,true,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
call UnitDamageTarget(target,attack,0.25*r,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
if LoadBoolean(udg_hash,h,StringHash("W2"))==false then
call SetUnitState(target,UNIT_STATE_LIFE,GetUnitState(target,UNIT_STATE_LIFE)+.1*r)
call Func_CD(target,"W2",z)
endif
endif
endif
elseif udg_Talante[ID]==2 then
if GetUnitAbilityLevel(target,'A0EQ')==1 and GetPlayerTechCount(Player(id),'R01T',true)<25 then
set udg_CrabD=udg_CrabD+1
if udg_CrabD==250 then
set udg_CrabD=0
call SetPlayerTechResearchedSwap('R01T',GetPlayerTechCount(Player(id),'R01T',true)+1,Player(id))
set udg_ReflectDmg[ID]=udg_ReflectDmg[ID]+10
endif
endif
if GetUnitAbilityLevel(target,'A0ES')>0 then
set udg_CrabSkillNum=udg_CrabSkillNum+1
if GetUnitAbilityLevel(target,'A0F3')==1 then
set a=40
else
set a=50
endif
if udg_CrabSkillNum>=a then
set udg_CrabSkillNum=0
set r=GetUnitAbilityLevel(target,'A0ES')*75.+GetHeroStr(target,true)
call GroupDamage(xt,yt,300.,target,false,r,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
call DestroyEffect(AddSpecialEffect("war3mapImported\\Ground_SlamCrab.mdx",xt,yt))
call SetUnitState(target,UNIT_STATE_LIFE,GetUnitState(target,UNIT_STATE_LIFE)+85.00*GetUnitAbilityLevel(target,'A0ES'))
endif
endif
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='gcel' and LoadBoolean(udg_hash,h,StringHash("Gnom Shield"))==false then
set drop=50+mainstat/10
set a=LoadInteger(Hash,GetHandleId(target),0)
set s__Units_MageBlock[sUnit[a]]=s__Units_MageBlock[sUnit[a]]+3000
set s__Units_Arm[sUnit[a]]=s__Units_Arm[sUnit[a]]+drop
call F_Armore(target,s__Units_Arm[sUnit[a]])
call SaveBoolean(udg_hash,h,StringHash("Gnom Shield"),true)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,target)
call SaveInteger(udg_hash,ht,1,16)
call SaveInteger(udg_hash,ht,0,drop)
call TimerStart(t,1,true,function Trig_ReflectDmg_Gnom_Shield)
endif
if GetUnitAbilityLevel(target,'A0FQ')>0 then
if GetUnitState(target,UNIT_STATE_LIFE)/GetUnitState(target,UNIT_STATE_MAX_LIFE)<=0.5 then
set a=3
else
set a=2
endif
if GetRandomInt(1,10)<=a then
set bj_lastCreatedUnit=CreateUnit(Player(ID-1),'o002',xt,yt,0)
call UnitAddAbility(bj_lastCreatedUnit,'A007')
set r=GetUnitAbilityLevel(target,'A0FQ')*60+GetUnitState(target,UNIT_STATE_MAX_LIFE)*0.15
if udg_Talante[ID]==2 then
call SummonStats(true,0,R2I(r),bj_lastCreatedUnit,target)
else
if udg_Talante[ID]==1 and GetUnitAbilityLevel(target,'A0C8')==1 then
set r=r+2*F_Reflect(target)
endif
call SummonStats(true,0,R2I(r),bj_lastCreatedUnit,target)
endif
call UnitRemoveAbility(bj_lastCreatedUnit,'A007')
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',0.75)
call IssueImmediateOrder(bj_lastCreatedUnit,"stop")
call IssueTargetOrder(bj_lastCreatedUnit,"attackonce",attack)
endif
endif
endif
if udg_ReflectDmg[ID]>0.00 then
set r=0.
if target==udg_Scorpion and udg_ScorpionMutation[5]==3 then
set a=LoadInteger(udg_hash,h,'d')
if a==1 then
set r=GetHeroStr(udg_Scorpion,true)
else
if a==2 then
set r=GetHeroAgi(udg_Scorpion,true)
else
set r=GetHeroInt(udg_Scorpion,true)
endif
endif
set r=0.80*r
endif
if ID<9 then
set r=F_Reflect(target)+r
else
set r=udg_ReflectDmg[ID]+r
endif
if GetUnitAbilityLevel(attack,'A0IQ')>=1 then
set r=0.3*r
elseif GetPlayerId(GetOwningPlayer(attack))==PLAYER_NEUTRAL_AGGRESSIVE then
set r=0.8*r
endif
call UnitDamageTarget(target,attack,0.92*r,false,true,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
call UnitDamageTarget(target,attack,0.08*r,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
endif
set LA=0
set LB[0]=false
set LB[1]=false
set LB[2]=false
set LB[3]=false
set LB[4]=false
set LB[5]=false
loop
if not LB[0]and GetItemTypeId(UnitItemInSlot(target,LA))=='k3m3' then
set LB[0]=true
set r=0.2*GetUnitState(target,UNIT_STATE_MANA)
call UnitDamageTarget(target,attack,0.8*r,false,true,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
call UnitDamageTarget(target,attack,0.2*r,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
call SetUnitState(target,UNIT_STATE_MANA,GetUnitState(target,UNIT_STATE_MANA)-GetUnitState(target,UNIT_STATE_MANA)/1000.)
endif
if not LB[1]and GetItemTypeId(UnitItemInSlot(target,LA))=='I08K' then
set LB[1]=true
set r=2000.+1.5*GetHeroStr(target,true)
if GetUnitAbilityLevel(attack,'A0IQ')>=1 then
set r=0.3*r
endif
set udg_SunArmor=udg_SunArmor+1
if udg_SunArmor==15 then
set udg_SunArmor=0
call UnitDamageTarget(target,attack,0.9*r,false,true,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
call UnitDamageTarget(target,attack,0.1*r,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
set a=GetPlayerId(GetLocalPlayer())+1
set str="Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl"
if OptEffect[a]then
set str=""
endif
set bj_lastCreatedEffect=AddSpecialEffectTarget(str,attack,"origin")
call DestroyEffect(bj_lastCreatedEffect)
endif
endif
if not LB[2]and GetItemTypeId(UnitItemInSlot(target,LA))=='I0EE' then
set LB[2]=true
set drop=LoadInteger(udg_hash,h,StringHash("Ra"))+1
if drop>=10 then
call SaveInteger(udg_hash,h,StringHash("Ra"),0)
set r=2000.+1.5*GetHeroStr(target,true)
if GetFloatGameState(GAME_STATE_TIME_OF_DAY)<18.00 and GetFloatGameState(GAME_STATE_TIME_OF_DAY)>6.00 then
set r=2.*r
endif
call UnitDamageTarget(target,attack,0.9*r,false,true,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
call UnitDamageTarget(target,attack,0.1*r,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",attack,"origin"))
else
call SaveInteger(udg_hash,h,StringHash("Ra"),drop)
endif
endif
if not LB[3]and GetItemTypeId(UnitItemInSlot(target,LA))=='I03W' then
set LB[3]=true
if GetRandomInt(1,10)==1 then
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(target),'h009',GetUnitX(target),GetUnitY(target),bj_UNIT_FACING)
call UnitAddAbility(bj_lastCreatedUnit,'A0EU')
call IssueTargetOrder(bj_lastCreatedUnit,"creepthunderbolt",attack)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',0.75)
else
endif
endif
if not LB[4]and GetItemTypeId(UnitItemInSlot(target,LA))=='I066' then
set LB[4]=true
call UnitDamageTarget(target,attack,GetUnitState(target,UNIT_STATE_MANA)*0.05,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call SetUnitState(target,UNIT_STATE_MANA,GetUnitState(target,UNIT_STATE_MANA)-GetUnitState(target,UNIT_STATE_MANA)/1000.)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Undead\\ReplenishMana\\ReplenishManaCaster.mdl",GetUnitX(target),GetUnitY(target))
call DestroyEffect(bj_lastCreatedEffect)
endif
if not LB[5]and GetItemTypeId(UnitItemInSlot(target,LA))=='I07V' then
set LB[5]=true
if GetRandomInt(1,2)==1 then
call SetUnitState(target,UNIT_STATE_LIFE,GetUnitState(target,UNIT_STATE_LIFE)+30+.01*GetHeroStr(target,true))
endif
endif
set LA=LA+1
exitwhen LA>5
endloop
if UnitHasItemOfTypeBJ(target,'I0BX')==true then
if GetRandomInt(1,2)==1 then
call SetUnitState(target,UNIT_STATE_LIFE,GetUnitState(target,UNIT_STATE_LIFE)+25)
call SetUnitState(target,UNIT_STATE_MANA,GetUnitState(target,UNIT_STATE_MANA)+10)
else
endif
else
if UnitHasItemOfTypeBJ(target,'I07P')or UnitHasItemOfTypeBJ(target,'I01S')or UnitHasItemOfTypeBJ(target,'I0A1')then
if GetRandomInt(1,2)==1 then
call SetUnitState(target,UNIT_STATE_LIFE,(GetUnitState(target,UNIT_STATE_LIFE)+15.00))
endif
endif
endif
set a=0
set drop=0
loop
exitwhen a>5
if GetItemTypeId(UnitItemInSlot(target,a))=='I054' or GetItemTypeId(UnitItemInSlot(target,a))=='I0DZ' or GetItemTypeId(UnitItemInSlot(target,a))=='I0DY' then
set drop=1
set a=6
endif
set a=a+1
endloop
if drop==1 then
if GetRandomInt(1,2)==1 then
call SetUnitState(target,UNIT_STATE_MANA,(GetUnitState(target,UNIT_STATE_MANA)+10.00))
endif
endif
if GetUnitAbilityLevel(target,'A0S4')>=1 then
set r=LoadReal(udg_hash,h,'w')
call UnitDamageTarget(target,attack,r,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
elseif GetUnitAbilityLevel(target,'A1E9')==1 then
set r=0.005*GetUnitState(target,UNIT_STATE_MAX_LIFE)
if IsUnitType(attack,UNIT_TYPE_HERO)then
set r=r/2
elseif IsUnitType(attack,UNIT_TYPE_STRUCTURE)then
set r=r/2
endif
if GetUnitAbilityLevel(attack,'A0IQ')==1 then
set r=0.3*r
endif
call UnitDamageTarget(target,attack,0.9*r,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
call UnitDamageTarget(target,attack,0.1*r,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
endif
set target=null
set attack=null
set t=null
endfunction
function InitTrig_ReflectDmg takes nothing returns nothing
set gg_trg_ReflectDmg=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_ReflectDmg,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddAction(gg_trg_ReflectDmg,function Trig_ReflectDmg_Actions)
endfunction
function Trig_Repair_Actions takes nothing returns nothing
local integer ID=GetPlayerId(GetOwningPlayer(GetBuyingUnit()))+1
local integer ids=ReturnTypeHeroId(GetHandleId(GetBuyingUnit()))
set udg_BuyItem=true
if GetItemTypeId(GetSoldItem())=='I09C' then
if UnitAlive(gg_unit_htow_0002)then
if GetUnitLifePercent(gg_unit_htow_0002)<100.00 then
call SetUnitLifePercentBJ(gg_unit_htow_0002,(GetUnitLifePercent(gg_unit_htow_0002)+25.00))
set SpendGold[ID]=SpendGold[ID]+1500
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"|cFF00C850Ремонт прошёл успешно!")
else
call AdjustPlayerStateBJ(1500,GetOwningPlayer(GetBuyingUnit()),PLAYER_STATE_RESOURCE_GOLD)
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"|cFF00C850Апотроп имеет полный запас здоровья!")
endif
else
call AdjustPlayerStateBJ(1500,GetOwningPlayer(GetBuyingUnit()),PLAYER_STATE_RESOURCE_GOLD)
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"|cFF00C850Апотроп уничтожен/не существует")
endif
else
endif
if GetItemTypeId(GetSoldItem())=='I0E1' then
if UnitAlive(gg_unit_htow_0002)then
if GetUnitLifePercent(gg_unit_htow_0002)<100.00 then
call SetUnitLifePercentBJ(gg_unit_htow_0002,(GetUnitLifePercent(gg_unit_htow_0002)+25.00))
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"|cFF00C850Ремонт прошёл успешно!")
else
call AdjustPlayerStateBJ(4500,GetOwningPlayer(GetBuyingUnit()),PLAYER_STATE_RESOURCE_GOLD)
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"|cFF00C850Апотроп имеет полный запас здоровья!")
endif
else
call AdjustPlayerStateBJ(4500,GetOwningPlayer(GetBuyingUnit()),PLAYER_STATE_RESOURCE_GOLD)
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"|cFF00C850Апотроп уничтожен/не существует")
endif
else
endif
if IsUnitType(GetBuyingUnit(),UNIT_TYPE_HERO)then
if GetItemTypeId(GetSoldItem())=='tdex' then
set s__Heroes_buyAgi[sHero[ids]]=s__Heroes_buyAgi[sHero[ids]]+1
set SpendGold[ID]=SpendGold[ID]+750
if GetUnitAbilityLevel(GetBuyingUnit(),'A0OX')==1 then
call AdjustPlayerStateBJ(106,GetOwningPlayer(GetBuyingUnit()),PLAYER_STATE_RESOURCE_GOLD)
endif
elseif GetItemTypeId(GetSoldItem())=='tint' then
set s__Heroes_buyInt[sHero[ids]]=s__Heroes_buyInt[sHero[ids]]+1
set SpendGold[ID]=SpendGold[ID]+750
if GetUnitAbilityLevel(GetBuyingUnit(),'A0OX')==1 then
call AdjustPlayerStateBJ(106,GetOwningPlayer(GetBuyingUnit()),PLAYER_STATE_RESOURCE_GOLD)
endif
elseif GetItemTypeId(GetSoldItem())=='tstr' then
set s__Heroes_buyStr[sHero[ids]]=s__Heroes_buyStr[sHero[ids]]+1
set SpendGold[ID]=SpendGold[ID]+750
if GetUnitAbilityLevel(GetBuyingUnit(),'A0OX')==1 then
call AdjustPlayerStateBJ(106,GetOwningPlayer(GetBuyingUnit()),PLAYER_STATE_RESOURCE_GOLD)
endif
elseif GetItemTypeId(GetSoldItem())=='I0CA' then
set s__Heroes_buyAgi[sHero[ids]]=s__Heroes_buyAgi[sHero[ids]]+20
set SpendGold[ID]=SpendGold[ID]+15000
if GetUnitAbilityLevel(GetBuyingUnit(),'A0OX')==1 then
call AdjustPlayerStateBJ(2125,GetOwningPlayer(GetBuyingUnit()),PLAYER_STATE_RESOURCE_GOLD)
endif
elseif GetItemTypeId(GetSoldItem())=='I0CC' then
set s__Heroes_buyInt[sHero[ids]]=s__Heroes_buyInt[sHero[ids]]+20
set SpendGold[ID]=SpendGold[ID]+15000
if GetUnitAbilityLevel(GetBuyingUnit(),'A0OX')==1 then
call AdjustPlayerStateBJ(2125,GetOwningPlayer(GetBuyingUnit()),PLAYER_STATE_RESOURCE_GOLD)
endif
elseif GetItemTypeId(GetSoldItem())=='I0CB' then
set s__Heroes_buyStr[sHero[ids]]=s__Heroes_buyStr[sHero[ids]]+20
set SpendGold[ID]=SpendGold[ID]+15000
if GetUnitAbilityLevel(GetBuyingUnit(),'A0OX')==1 then
call AdjustPlayerStateBJ(2125,GetOwningPlayer(GetBuyingUnit()),PLAYER_STATE_RESOURCE_GOLD)
endif
endif
endif
set udg_BuyItem=false
endfunction
function InitTrig_Repair takes nothing returns nothing
set gg_trg_Repair=CreateTrigger()
