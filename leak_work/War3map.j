set gg_trg_TikondrusD=CreateTrigger()
call DisableTrigger(gg_trg_TikondrusD)
call TriggerRegisterAnyUnitEventBJ(gg_trg_TikondrusD,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(gg_trg_TikondrusD,Condition(function Trig_TikondrusD_Conditions))
call TriggerAddAction(gg_trg_TikondrusD,function Trig_TikondrusD_Actions)
endfunction
function g_Sfinks_E1 takes nothing returns nothing
call UnitDamageTarget(udg_u,GetEnumUnit(),G_Real,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Orc\\Orcblood\\HeroShadowHunterBlood.mdl",GetEnumUnit(),"origin"))
endfunction
function g_Sfinks_E1_F takes nothing returns nothing
local unit u=GetEnumUnit()
local integer h=GetHandleId(u)
local integer iuh=LoadInteger(Hash,h,0)
if iuh>0 then
set iuh=SeekFreeUnitMin(h)
endif
if iuh>0 then
set s__Units_MageTake[sUnit[iuh]]=s__Units_MageTake[sUnit[iuh]]+udg_Drop*2000
endif
set u=null
endfunction
function Sfinks_E1_F takes group g,integer op returns nothing
call SeekMinUnit()
set udg_Drop=op
call ForGroup(g,function g_Sfinks_E1_F)
endfunction
function Sfinks_E1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local group g=LoadGroupHandle(udg_hash,ht,1)
local real sec=LoadReal(udg_hash,ht,0)
if sec>0 then
set sec=sec-1.
call SaveReal(udg_hash,ht,0,sec)
set udg_u=hero
set G_Real=LoadReal(udg_hash,ht,2)
call ForGroup(g,function g_Sfinks_E1)
else
if LoadBoolean(udg_hash,ht,3)then
call Sfinks_E1_F(g,-1)
endif
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set hero=null
set t=null
set g=null
endfunction
function Sfinks_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local unit dummy=LoadUnitHandle(udg_hash,ht,1)
local real sec=LoadReal(udg_hash,ht,0)
local unit u
local real xd=GetUnitX(dummy)
local real yd=GetUnitY(dummy)
local real x
local real y
local real angle
local real dmg=12*GetHeroInt(hero,true)
local group g=CreateGroup()
if sec>0 then
set sec=sec-0.1
call SaveReal(udg_hash,ht,0,sec)
call GroupEnumUnitsInRange(g,xd,yd,700,null)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)and IsUnitEnemy(u,GetOwningPlayer(hero))then
set x=GetUnitX(u)
set y=GetUnitY(u)
set angle=bj_RADTODEG*Atan2(yd-y,xd-x)
call KnockBackUnit(u,4,0.1,angle,0.1)
endif
call GroupRemoveUnit(g,u)
endloop
else
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,xd,yd,400,Bool_Filter_ID)
if udg_Talante[ID]==1 then
set dmg=dmg+GetUnitState(hero,UNIT_STATE_MAX_MANA)
endif
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>6
set x=xd+170*Cos(60*bj_forLoopAIndex*bj_DEGTORAD)
set y=yd+170*Sin(60*bj_forLoopAIndex*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UDeathMedium\\UDeath.mdl",x,y))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>10
set x=xd+350*Cos(36*bj_forLoopAIndex*bj_DEGTORAD)
set y=yd+350*Sin(36*bj_forLoopAIndex*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UDeathMedium\\UDeath.mdl",x,y))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call RemoveUnit(dummy)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
call DestroyGroup(g)
set hero=null
set dummy=null
set u=null
set t=null
set g=null
endfunction
function F_MagicDragons takes unit hero,real x,real y,real mana,real applylife returns nothing
local unit u
local real dmg=0.15*GetHeroInt(hero,true)
local real hp=3.*GetHeroInt(hero,true)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualTarget.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
if mana<=870.50 then
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=R2I(mana/87.50)+1
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set u=CreateUnit(GetOwningPlayer(hero),'n03C',x,y,0.)
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),u,hero)
call UnitRemoveAbility(u,'A007')
call UnitAddAbility(u,'A1BF')
call SetUnitAbilityLevel(u,'A1BF',11)
call UnitApplyTimedLife(u,'BTLF',applylife)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
elseif mana<=2625.00 then
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=R2I(mana/262.5)
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
if GetRandomInt(1,2)==2 then
set u=CreateUnit(GetOwningPlayer(hero),'n03C',x,y,0.)
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),u,hero)
call UnitRemoveAbility(u,'A007')
call UnitAddAbility(u,'A1BF')
call SetUnitAbilityLevel(u,'A1BF',11)
call UnitApplyTimedLife(u,'BTLF',applylife)
else
set u=CreateUnit(GetOwningPlayer(hero),'n03D',x,y,0.)
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),u,hero)
call UnitRemoveAbility(u,'A007')
call UnitAddAbility(u,'A1BF')
call SetUnitAbilityLevel(u,'A1BF',11)
call UnitApplyTimedLife(u,'BTLF',applylife)
endif
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
else
set bj_forLoopAIndex=1
if mana>5250 then
set bj_forLoopAIndexEnd=10
set hp=hp+4000.+4.*(mana-5250)
set dmg=dmg+60.+.06*(mana-5250)
else
set bj_forLoopAIndexEnd=R2I(mana/525.00)
endif
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
if GetRandomInt(1,2)==2 then
set u=CreateUnit(GetOwningPlayer(hero),'n03D',x,y,0.)
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),u,hero)
call UnitRemoveAbility(u,'A007')
call UnitAddAbility(u,'A1BF')
call SetUnitAbilityLevel(u,'A1BF',11)
call UnitApplyTimedLife(u,'BTLF',applylife)
else
set u=CreateUnit(GetOwningPlayer(hero),'n03E',x,y,0.)
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),u,hero)
call UnitRemoveAbility(u,'A007')
call UnitAddAbility(u,'A1BF')
call SetUnitAbilityLevel(u,'A1BF',11)
call UnitApplyTimedLife(u,'BTLF',applylife)
endif
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
set u=null
endfunction
function Trig_SfinksSkills_Actions takes nothing returns nothing
local unit hero=GetTriggerUnit()
local integer h=GetHandleId(hero)
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local real x
local real y
local real x1
local real y1
local real hp
local real dmg
local real z
local real r
local unit u
local group g=CreateGroup()
local timer t
local real mana
local integer ht
local integer a
if GetSpellAbilityId()=='A0S6' then
set x=GetUnitLifePercent(hero)
set y=GetUnitManaPercent(hero)
call SetUnitLifePercentBJ(hero,y)
call SetUnitManaPercentBJ(hero,x)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AItb\\AItbTarget.mdl",hero,"origin"))
else
endif
if GetSpellAbilityId()=='A0CI' then
call SetPlayerTechResearched(GetOwningPlayer(hero),'R012',GetUnitAbilityLevel(hero,'A0CI'))
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set mana=.25*GetUnitState(hero,UNIT_STATE_MANA)
call F_MagicDragons(hero,x,y,mana,40.)
call SetUnitState(hero,UNIT_STATE_MANA,GetUnitState(hero,UNIT_STATE_MANA)-mana)
endif
if GetSpellAbilityId()=='A0CH' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set u=CreateUnit(Player(ID-1),'h004',x,y,bj_UNIT_FACING)
call UnitApplyTimedLife(u,'BTLF',7)
if udg_Talante[ID]==2 then
call UnitAddAbility(u,'A1F3')
if GetHeroLevel(hero)>=50 then
call SetUnitAbilityLevel(u,'A1F3',2)
endif
endif
call SetUnitAnimation(u,"Stand Work")
set u=CreateUnit(Player(ID-1),'h02C',x,y,bj_UNIT_FACING)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveUnitHandle(udg_hash,ht,1,u)
call SaveReal(udg_hash,ht,0,5.)
call TimerStart(t,0.1,true,function Sfinks_R)
endif
if GetSpellAbilityId()=='A01Z' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set dmg=0.6*(GetUnitState(hero,UNIT_STATE_MAX_MANA)-GetUnitState(hero,UNIT_STATE_MANA))
if udg_Talante[ID]==1 then
set dmg=dmg+0.2*GetUnitState(hero,UNIT_STATE_MAX_MANA)
if GetHeroLevel(hero)>=50 then
set dmg=dmg+0.2*GetUnitState(hero,UNIT_STATE_MAX_MANA)
endif
endif
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\AItb\\AItbTarget.mdl",x,y))
set udg_Drop2=GetPlayerId(GetOwningPlayer(hero))
call GroupEnumUnitsInRange(g,x,y,500.,Bool_Filter_ID)
set a=0
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set a=a+1
call GroupRemoveUnit(g,u)
endloop
call SetUnitState(hero,UNIT_STATE_MANA,GetUnitState(hero,UNIT_STATE_MANA)+a*0.02*GetUnitState(hero,UNIT_STATE_MAX_MANA))
endif
if GetSpellAbilityId()=='A0CF' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
if udg_Talante[ID]==1 then
set mana=GetUnitState(hero,UNIT_STATE_MANA)*0.5
else
set mana=GetUnitState(hero,UNIT_STATE_MANA)*0.33
if udg_Talante[ID]==2 then
call F_MagicDragons(hero,x,y,.5*mana,20.)
endif
endif
set dmg=GetUnitAbilityLevel(hero,'A0CF')*25+.2*GetHeroInt(hero,true)
if mana>2000 then
set bj_forLoopAIndexEnd=20
set dmg=dmg+.5*(mana-2000)
set mana=4000
else
set bj_forLoopAIndexEnd=R2I(mana/100.)
endif
set r=mana/4.50
if r>500. then
set r=500.
endif
if udg_Talante[ID]==1 then
set dmg=dmg*1.3
endif
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Demon\\DarkPortal\\DarkPortalTarget.mdl",x,y))
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set hp=GetRandomReal(20.00,r)
set z=GetRandomReal(0,360)
set x1=x+hp*Cos(z*bj_DEGTORAD)
set y1=y+hp*Sin(z*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(hero),'h003',x,y,bj_UNIT_FACING)
set a=SeekFreeDummys(u,GetHandleId(u))
set s__Dummys_dmg[sDummy[a]]=dmg
call IssuePointOrder(u,"attackground",x1,y1)
call UnitApplyTimedLife(u,'BTLF',0.75)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call SetUnitState(hero,UNIT_STATE_MANA,GetUnitState(hero,UNIT_STATE_MANA)*0.66)
elseif GetSpellAbilityId()=='A17G' then
set mana=GetUnitState(hero,UNIT_STATE_MANA)*0.3
call SetUnitState(hero,UNIT_STATE_MANA,GetUnitState(hero,UNIT_STATE_MANA)-mana)
set dmg=GetUnitAbilityLevel(hero,'A17G')*30.+0.3*mana
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set udg_Drop2=GetPlayerId(GetOwningPlayer(hero))
call GroupEnumUnitsInRange(g,x,y,325.,Bool_Filter_ID)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveGroupHandle(udg_hash,ht,1,g)
call SaveReal(udg_hash,ht,0,5.)
call SaveReal(udg_hash,ht,2,dmg)
if GetUnitLevel(hero)>=50 then
call Sfinks_E1_F(g,1)
call SaveBoolean(udg_hash,ht,3,true)
endif
call TimerStart(t,1.,true,function Sfinks_E1)
set g=CreateGroup()
endif
if GetSpellAbilityId()=='A0CG' and udg_SfinksZapret[1]==false and udg_SfinksZapret[2]==false and udg_SfinksZapret[3]==false then
if GetHeroStr(hero,false)<=19 or GetHeroAgi(hero,false)<=19 then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],20.00,"Нельзя снижать характеристики ниже 10!")
else
call ModifyHeroStat(bj_HEROSTAT_STR,hero,bj_MODIFYMETHOD_SUB,10)
call ModifyHeroStat(bj_HEROSTAT_AGI,hero,bj_MODIFYMETHOD_SUB,10)
call ModifyHeroStat(bj_HEROSTAT_INT,hero,bj_MODIFYMETHOD_ADD,20)
endif
else
endif
set t=null
set hero=null
set u=null
call DestroyGroup(g)
set g=null
endfunction
function InitTrig_SfinksSkills takes nothing returns nothing
set gg_trg_SfinksSkills=CreateTrigger()
call TriggerAddAction(gg_trg_SfinksSkills,function Trig_SfinksSkills_Actions)
endfunction
function ForestDrak_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local real sec=LoadReal(udg_hash,ht,4)
local real x=LoadReal(udg_hash,ht,1)
local real y=LoadReal(udg_hash,ht,2)
local real dist=LoadReal(udg_hash,ht,3)
local real x1
local real y1
local group g=CreateGroup()
local unit u
local real dmg=.15*GetHeroInt(hero,true)
if sec>0 then
set sec=sec-0.05
call SaveReal(udg_hash,ht,4,sec)
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>6
set x1=x+dist*Cos((bj_forLoopAIndex*60+dist/20)*bj_DEGTORAD)
set y1=y+dist*Sin((bj_forLoopAIndex*60+dist/20)*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",x1,y1))
call GroupEnumUnitsInRange(g,x1,y1,225.,null)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)and IsUnitEnemy(u,GetOwningPlayer(hero))then
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
call GroupRemoveUnit(g,u)
endloop
set dist=dist-3
call SaveReal(udg_hash,ht,3,dist)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
call DestroyGroup(g)
set t=null
set g=null
set hero=null
set u=null
endfunction
function Trig_ForestDrak_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer h=GetHandleId(caster)
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local real x
local real y
local real dmg
local real r
local unit u
local group g=CreateGroup()
local timer t
local integer ht
if GetSpellAbilityId()=='A0GD' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set bj_lastCreatedUnit=CreateUnit(Player(ID-1),'h02X',x,y,bj_UNIT_FACING)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',2.)
endif
if GetSpellAbilityId()=='A0CJ' then
set dmg=0
if udg_Talante[ID]==2 then
set dmg=4*GetHeroInt(caster,true)
if GetHeroLevel(caster)>=50 then
set dmg=dmg+4*GetHeroInt(caster,true)
endif
endif
set r=100.+50.*GetUnitAbilityLevel(caster,'A0CJ')
set x=GetSpellTargetX()
set y=GetSpellTargetY()
call GroupEnumUnitsInRange(g,x,y,r,null)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)and IsUnitEnemy(u,Player(ID-1))then
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
if UnitAlive(u)then
set bj_lastCreatedUnit=CreateUnit(Player(ID-1),'h009',GetUnitX(u),GetUnitY(u),0.)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',2.)
call UnitAddAbility(bj_lastCreatedUnit,'A0CL')
call IssueTargetOrder(bj_lastCreatedUnit,"banish",u)
endif
endif
call GroupRemoveUnit(g,u)
endloop
endif
if GetSpellAbilityId()=='A0CP' then
if udg_Talante[ID]==1 then
set dmg=.5*GetHeroInt(caster,false)
call TempStats(caster,0,0,R2I(dmg),0,0,0,PositiveDuration(caster,20))
endif
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveReal(udg_hash,ht,4,6.6)
call SaveReal(udg_hash,ht,1,x)
call SaveReal(udg_hash,ht,2,y)
call SaveReal(udg_hash,ht,3,1500)
call TimerStart(t,0.05,true,function ForestDrak_R)
else
endif
call DestroyGroup(g)
set caster=null
set u=null
set g=null
set t=null
endfunction
function InitTrig_ForestDrak takes nothing returns nothing
set gg_trg_ForestDrak=CreateTrigger()
call TriggerAddAction(gg_trg_ForestDrak,function Trig_ForestDrak_Actions)
endfunction
function Trig_WaterElement_E takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(caster)
local integer a=LoadInteger(udg_hash,ht,1)
local integer talante=LoadInteger(udg_hash,ht,3)
local integer level=LoadInteger(udg_hash,ht,4)
local integer ihh=LoadInteger(udg_hash,h,5)
local integer iuh=LoadInteger(Hash,h,0)
if talante !=2 then
set s__Heroes_TempAgi[sHero[ihh]]=s__Heroes_TempAgi[sHero[ihh]]-a
if talante==1 and level>=50 then
set s__Units_NoMageDmg[sUnit[iuh]]=s__Units_NoMageDmg[sUnit[iuh]]-2000
endif
else
set s__Heroes_TempInt[sHero[ihh]]=s__Heroes_TempInt[sHero[ihh]]-a
endif
call SetUnitVertexColor(caster,0,200,200,255)
call F_Stats(caster)
call SaveBoolean(udg_hash,GetHandleId(caster),'d',false)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set caster=null
set t=null
endfunction
function WaterElement_R12 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit clone=LoadUnitHandle(udg_hash,ht,0)
local integer ID=GetPlayerId(GetOwningPlayer(clone))+1
local integer h=GetHandleId(clone)
local integer a=LoadInteger(Hash,h,0)
local unit hero=udg_Hero[ID]
local integer iuh=LoadInteger(Hash,GetHandleId(hero),0)
local integer b
if UnitAlive(clone)then
set b=Summ_Attack(hero)
if udg_Talante[ID]==1 then
set b=2*b
endif
set s__Units_GAttack[sUnit[a]]=s__Units_GAttack[sUnit[a]]+b-LoadInteger(udg_hash,ht,1)
call SaveInteger(udg_hash,ht,1,b)
set b=R2I(GetUnitState(hero,UNIT_STATE_MAX_LIFE))
set s__Units_HP[sUnit[a]]=s__Units_HP[sUnit[a]]+b-LoadInteger(udg_hash,ht,2)
call SaveInteger(udg_hash,ht,2,b)
set b=s__Units_Arm[sUnit[iuh]]+GetHeroAgi(hero,true)/5
set s__Units_Arm[sUnit[a]]=s__Units_Arm[sUnit[a]]+b-LoadInteger(udg_hash,ht,3)
call SaveInteger(udg_hash,ht,3,b)
set b=GetHeroAgi(hero,true)/5-LoadInteger(udg_hash,ht,4)
if b>31 then
set b=31
endif
if b !=GetUnitAbilityLevel(clone,'A17N')then
call SetUnitAbilityLevel(clone,'A17N',b)
endif
call SaveInteger(udg_hash,ht,4,b)
call F_hp(clone,s__Units_HP[sUnit[a]])
call F_Armore(clone,s__Units_Arm[sUnit[a]])
call F_Attack(clone,s__Units_GAttack[sUnit[a]])
else
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
set clone=null
set hero=null
set t=null
endfunction
function Trig_WaterElement_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer h=GetHandleId(caster)
local integer ihh=LoadInteger(udg_hash,h,5)
local integer iuh=LoadInteger(Hash,h,0)
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local timer t
local integer ht
local integer a
local integer b
local integer c
local real x
local real y
local unit u
local real hp
local real dmg
local integer agi=GetHeroAgi(caster,false)-LoadInteger(udg_hash,h,StringHash("BTAgi"))
local integer int=GetHeroInt(caster,false)-LoadInteger(udg_hash,h,StringHash("BTInt"))
if not LoadBoolean(udg_hash,h,'d')and udg_MagichkaInt[ID]==0 then
if GetSpellAbilityId()=='A0DO' then
if int<=1 then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],20.,"Нельзя снижать хар-ки ниже 2!")
else
call SetHeroInt(caster,GetHeroInt(caster,false)-1,true)
call SetHeroAgi(caster,GetHeroAgi(caster,false)+1,true)
endif
endif
if GetSpellAbilityId()=='A0O5' then
if int<=10 then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],20.,"Нельзя снижать хар-ки ниже 2!")
else
call SetHeroInt(caster,GetHeroInt(caster,false)-10,true)
call SetHeroAgi(caster,GetHeroAgi(caster,false)+10,true)
endif
endif
if GetSpellAbilityId()=='A0DN' then
if agi<=1 then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],20.,"Нельзя снижать хар-ки ниже 2!")
else
call SetHeroInt(caster,GetHeroInt(caster,false)+1,true)
call SetHeroAgi(caster,GetHeroAgi(caster,false)-1,true)
endif
endif
if GetSpellAbilityId()=='A0O6' then
if agi<=10 then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],20.,"Нельзя снижать хар-ки ниже 2!")
else
call SetHeroInt(caster,GetHeroInt(caster,false)+10,true)
call SetHeroAgi(caster,GetHeroAgi(caster,false)-10,true)
endif
endif
if GetSpellAbilityId()=='A0O7' then
call SetHeroAgi(caster,int+LoadInteger(udg_hash,h,StringHash("BTAgi")),true)
call SetHeroInt(caster,agi+LoadInteger(udg_hash,h,StringHash("BTInt")),true)
endif
endif
if GetSpellAbilityId()=='A0DR' then
set dmg=40*GetUnitAbilityLevel(caster,'A0DR')
if udg_Talante[ID]==1 then
set x=.15*Summ_Attack(caster)
set dmg=dmg+x
if GetHeroLevel(caster)>=50 then
set dmg=dmg+x
endif
elseif udg_Talante[ID]==2 then
set dmg=(dmg+0.5*GetHeroAgi(caster,true))*(1+LoadReal(udg_hash,h,StringHash("Modificator")))
if GetHeroLevel(caster)>=50 then
set dmg=dmg+0.5*GetHeroAgi(caster,true)*(1+LoadReal(udg_hash,h,StringHash("Modificator")))
endif
elseif udg_Talante[ID]==3 then
set dmg=dmg+0.5*GetHeroInt(caster,true)
if GetHeroLevel(caster)>=50 then
set dmg=dmg+GetHeroInt(caster,true)
endif
endif
set c=2+GetUnitAbilityLevel(caster,'A0DR')
set x=GetUnitX(caster)
set y=GetUnitY(caster)
call SeekMinDummys()
loop
exitwhen c<1
set u=CreateUnit(GetOwningPlayer(caster),'h05G',x,y,GetUnitFacing(caster))
set a=SeekFreeDummysMin(u,GetHandleId(u))
set s__Dummys_dmg[sDummy[a]]=dmg
call UnitApplyTimedLife(u,'BTLF',2.0)
call UnitAddAbility(u,'A0DS')
call IssuePointOrder(u,"carrionswarm",GetSpellTargetX()+GetRandomInt(-30,30),GetSpellTargetY()+GetRandomInt(-30,30))
set c=c-1
endloop
elseif GetSpellAbilityId()=='AHwe' then
set a=GetHeroInt(caster,true)-s__Heroes_TempInt[sHero[ihh]]/2
set b=GetHeroStr(caster,true)-s__Heroes_TempStr[sHero[ihh]]/2
set x=GetUnitX(caster)+225*Cos(GetUnitFacing(caster)*bj_DEGTORAD)
set y=GetUnitY(caster)+225*Sin(GetUnitFacing(caster)*bj_DEGTORAD)
set hp=400*(GetUnitAbilityLevel(caster,'A1AN')-1)+5*(b+a)
set dmg=15*(GetUnitAbilityLevel(caster,'A1AN')-1)+0.5*a
if GetHeroLevel(caster)>=50 then
set hp=hp+5*(b+a)
endif
set c=1
loop
exitwhen c>3
set u=CreateUnit(GetOwningPlayer(caster),'hwat',x,y,GetUnitFacing(caster))
if GetHeroLevel(caster)>=50 then
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+10)
endif
call UnitApplyTimedLife(u,'BTLF',30.)
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'A007')
set c=c+1
endloop
elseif GetSpellAbilityId()=='A0DT' then
call SaveBoolean(udg_hash,h,'d',true)
set x=(GetUnitAbilityLevel(caster,'A0DT')*0.1+0.3)
if udg_Talante[ID]==1 and GetHeroLevel(caster)>=50 then
set s__Units_NoMageDmg[sUnit[iuh]]=s__Units_NoMageDmg[sUnit[iuh]]+2000
set a=R2I(GetHeroAgi(caster,false)*x)
set s__Heroes_TempAgi[sHero[ihh]]=s__Heroes_TempAgi[sHero[ihh]]+a
call UnitAddAbility(udg_Warden,'Apiv')
call SetUnitVertexColor(udg_Warden,50,180,50,130)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveInteger(udg_hash,ht,1,a)
call SaveInteger(udg_hash,ht,3,1)
call SaveInteger(udg_hash,ht,4,GetHeroLevel(caster))
call TimerStart(t,PositiveDuration(caster,12),false,function Trig_WaterElement_E)
else
if udg_Talante[ID]==3 then
set a=R2I(GetHeroInt(caster,false)*x)
set s__Heroes_TempInt[sHero[ihh]]=s__Heroes_TempInt[sHero[ihh]]+a
call UnitAddAbility(udg_Warden,'Apiv')
call SetUnitVertexColor(udg_Warden,50,50,180,130)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveInteger(udg_hash,ht,1,a)
call SaveInteger(udg_hash,ht,3,2)
call SaveInteger(udg_hash,ht,4,GetHeroLevel(caster))
call TimerStart(t,PositiveDuration(caster,12),false,function Trig_WaterElement_E)
else
set a=R2I(GetHeroAgi(caster,false)*x)
set s__Heroes_TempAgi[sHero[ihh]]=s__Heroes_TempAgi[sHero[ihh]]+a
call UnitAddAbility(udg_Warden,'Apiv')
call SetUnitVertexColor(udg_Warden,50,180,50,130)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveInteger(udg_hash,ht,1,a)
call SaveInteger(udg_hash,ht,3,3)
call SaveInteger(udg_hash,ht,4,GetHeroLevel(caster))
call TimerStart(t,PositiveDuration(caster,12),false,function Trig_WaterElement_E)
endif
endif
call F_Stats(caster)
elseif GetSpellAbilityId()=='A1AK' then
set x=GetUnitX(caster)+175*Cos(GetUnitFacing(caster)*bj_DEGTORAD)
set y=GetUnitY(caster)+175*Sin(GetUnitFacing(caster)*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(caster),'nskf',x,y,GetUnitFacing(caster))
call UnitApplyTimedLife(u,'BTLF',20.)
set a=SeekFreeUnit(GetHandleId(u))
if udg_Talante[ID]==1 or udg_Talante[ID]==2 then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
set b=Summ_Attack(caster)
if udg_Talante[ID]==1 then
set b=2*b
endif
set s__Units_GAttack[sUnit[a]]=s__Units_GAttack[sUnit[a]]+b
call SaveInteger(udg_hash,ht,1,b)
set b=R2I(GetUnitState(caster,UNIT_STATE_MAX_LIFE))
set s__Units_HP[sUnit[a]]=s__Units_HP[sUnit[a]]+b
call SaveInteger(udg_hash,ht,2,b)
set b=GetHeroAgi(caster,true)/5
set s__Units_Arm[sUnit[a]]=s__Units_Arm[sUnit[iuh]]+b
call SaveInteger(udg_hash,ht,3,b)
call UnitAddAbility(u,'A17N')
set b=GetHeroAgi(caster,true)/5
if b>31 then
set b=31
endif
call SetUnitAbilityLevel(u,'A17N',b)
call SaveInteger(udg_hash,ht,4,b)
call TimerStart(t,1.,true,function WaterElement_R12)
call F_hp(u,s__Units_HP[sUnit[a]])
call F_Armore(u,s__Units_Arm[sUnit[a]])
call F_Attack(u,s__Units_GAttack[sUnit[a]])
elseif udg_Talante[ID]==3 then
set s__Units_Arm[sUnit[a]]=s__Units_Arm[sUnit[iuh]]+40
call F_Armore(u,s__Units_Arm[sUnit[a]])
set a=GetHeroInt(caster,true)-s__Heroes_TempInt[sHero[ihh]]/2
set b=GetHeroStr(caster,true)-s__Heroes_TempStr[sHero[ihh]]/2
set hp=400*(GetUnitAbilityLevel(caster,'A1AN')-1)+30*(b+a)
set dmg=15*(GetUnitAbilityLevel(caster,'A1AN')-1)+1.5*a
call UnitAddAbility(u,'A1BF')
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+10)
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'A007')
call UnitAddAbility(u,'A17N')
call SetUnitAbilityLevel(u,'A17N',21)
endif
endif
set caster=null
set u=null
set t=null
endfunction
function InitTrig_WaterElement takes nothing returns nothing
set gg_trg_WaterElement=CreateTrigger()
call TriggerAddAction(gg_trg_WaterElement,function Trig_WaterElement_Actions)
endfunction
function Helicoter_E takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer sec=LoadInteger(udg_hash,ht,0)
local real hp
if sec>0 then
set sec=sec-1
call SaveInteger(udg_hash,ht,0,sec)
set hp=GetHeroLevel(hero)*10+60*GetPlayerTechCount(GetOwningPlayer(hero),'R034',true)
if GetPlayerTechCount(GetOwningPlayer(hero),'R01G',true)==2 then
set hp=hp+0.02*GetUnitState(hero,UNIT_STATE_MAX_LIFE)
endif
