elseif udg_StartQuests==4 then
if udg_QuestNumber==1 and udg_Quest4Kills[ID]>=3 then
set BHelpGoblinText=true
set udg_StartQuests=5
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Разобрался говоришь? Ладно, я тебе верю, теперь я могу спать спокойно. Возьми этот мешочек с золотом в знак моей благодарности.")
