function RemoveSpecialChars takes string name returns string
local integer i=0
local integer a=1
local string result=""
local string c
loop
exitwhen i>=StringLength(name)
set c=SubString(name,i,i+1)
set a=1
loop
exitwhen a>26
if c==SubString(alpbB,a-1,a)then
set result=result+SubString(alpbS,a-1,a)
set a=100
elseif c==SubString(alpbS,a-1,a)then
set result=result+SubString(alpbS,a-1,a)
set a=100
endif
set a=a+1
endloop
set i=i+1
endloop
return result
endfunction
function ReactorTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
if GetHeroLevel(hero)<70 then
call SuspendHeroXPBJ(true,hero)
if UnitAlive(hero)then
call SetHeroLevelBJ(hero,(GetHeroLevel(hero)+1),true)
if UnitHasItemOfTypeBJ(hero,'I06Y')then
call ModifyHeroStat(bj_HEROSTAT_STR,GetLevelingUnit(),bj_MODIFYMETHOD_ADD,1)
call ModifyHeroStat(bj_HEROSTAT_AGI,GetLevelingUnit(),bj_MODIFYMETHOD_ADD,1)
call ModifyHeroStat(bj_HEROSTAT_INT,GetLevelingUnit(),bj_MODIFYMETHOD_ADD,1)
else
endif
endif
else
call SuspendHeroXPBJ(false,hero)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set hero=null
set t=null
endfunction
function Reactor takes unit hero returns nothing
local timer t=CreateTimer()
call SuspendHeroXPBJ(true,hero)
call SaveUnitHandle(udg_hash,GetHandleId(t),0,hero)
call TimerStart(t,.3,true,function ReactorTimer)
endfunction
