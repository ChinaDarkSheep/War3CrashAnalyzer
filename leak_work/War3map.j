function Trig_SkillFase3_Timer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local real sec=LoadReal(Hash,ht,0)-.2
if sec>0 then
call SaveReal(Hash,ht,0,sec)
set udg_KenariusNum=(udg_KenariusNum+20.00)
set udg_point=GetUnitLoc(udg_Mefisto)
set udg_p=PolarProjectionBJ(udg_point,udg_KenariusNum,GetRandomDirectionDeg())
call CreateNUnitsAtLoc(1,'h03K',Player(PLAYER_NEUTRAL_AGGRESSIVE),udg_p,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(3.50,'BTLF',GetLastCreatedUnit())
call RemoveLocation(udg_point)
call RemoveLocation(udg_p)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(Hash,ht)
endif
set t=null
endfunction
function Trig_SkillFase3_Actions takes nothing returns nothing
set udg_KenariusNum=0.00
call UnitUseItem(udg_Mefisto,GetItemOfTypeFromUnitBJ(udg_Mefisto,'I08R'))
set bj_lastStartedTimer=CreateTimer()
call SaveReal(Hash,GetHandleId(bj_lastStartedTimer),0,5.)
call TimerStart(bj_lastStartedTimer,.2,true,function Trig_SkillFase3_Timer)
endfunction
