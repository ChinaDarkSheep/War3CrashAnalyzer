function InitTrig_TableInic takes nothing returns nothing
set gg_trg_TableInic=CreateTrigger()
call TriggerAddAction(gg_trg_TableInic,function Trig_TableInic_Actions)
endfunction
function Trig_BookNT_Actions takes nothing returns nothing
local item it=GetManipulatedItem()
local unit u=GetManipulatingUnit()
local player p=GetOwningPlayer(u)
local integer i=GetItemTypeId(it)
local integer in=GetPlayerId(p)+1
if i=='tpow' or i=='tdex' or i=='tdx2' or i=='tin2' or i=='tint' or i=='texp' or i=='tstr' or i=='tst2' or i=='manh' then
set BookNT[in]=BookNT[in]+1
endif
if i=='gold' then
set GoldNT[GetPlayerId(p)+1]=GoldNT[GetPlayerId(p)+1]+10
endif
if i=='I04W' then
set GoldNT[GetPlayerId(p)+1]=GoldNT[GetPlayerId(p)+1]+40
endif
if i=='I06D' then
set GoldNT[GetPlayerId(p)+1]=GoldNT[GetPlayerId(p)+1]+150
endif
set it=null
set u=null
set p=null
endfunction
function InitTrig_BookNT takes nothing returns nothing
local trigger t=CreateTrigger()
local integer index=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(index),EVENT_PLAYER_UNIT_PICKUP_ITEM,null)
set index=index+1
exitwhen index==16
endloop
call TriggerAddAction(t,function Trig_BookNT_Actions)
endfunction
function Trig_WizardNT_Actions takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local player p=GetOwningPlayer(u)
local integer i=GetPlayerId(p)+1
if IsUnitType(u,UNIT_TYPE_HERO)==true then
set WizardNT[i]=WizardNT[i]+1
endif
set u=null
set p=null
endfunction
function InitTrig_WizardNT takes nothing returns nothing
local trigger t=CreateTrigger()
local integer index=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(index),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set index=index+1
exitwhen index==16
endloop
call TriggerAddAction(t,function Trig_WizardNT_Actions)
endfunction
function Trig_KillNT_Actions takes nothing returns nothing
local unit u=GetKillingUnit()
local unit u2=GetDyingUnit()
local player p=GetOwningPlayer(u)
local player p1=GetOwningPlayer(u2)
local integer i=GetPlayerId(p)+1
if GetUnitLevel(u2)==15 or GetUnitLevel(u2)==20 or GetUnitLevel(u2)==25 or GetUnitLevel(u2)==30 or GetUnitLevel(u2)==35 or GetUnitLevel(u2)==50 then
if p !=p1 and GetPlayerController(p)==MAP_CONTROL_USER and GetPlayerSlotState(p)==PLAYER_SLOT_STATE_PLAYING then
set BossNT[i]=BossNT[i]+1
endif
else
if p !=p1 and GetPlayerController(p)==MAP_CONTROL_USER and GetPlayerSlotState(p)==PLAYER_SLOT_STATE_PLAYING then
set KillNT[i]=KillNT[i]+1
endif
endif
if GetPlayerController(p1)==MAP_CONTROL_USER and GetPlayerSlotState(p1)==PLAYER_SLOT_STATE_PLAYING then
if IsUnitType(u2,UNIT_TYPE_HERO)==true then
set i=GetPlayerId(p1)+1
set DeathNT[i]=DeathNT[i]+1
endif
endif
set p=null
set u=null
set p1=null
set u2=null
endfunction
function InitTrig_KillNT takes nothing returns nothing
local trigger t=CreateTrigger()
local integer index=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(index),EVENT_PLAYER_UNIT_DEATH,null)
set index=index+1
exitwhen index==16
endloop
call TriggerAddAction(t,function Trig_KillNT_Actions)
endfunction
function Trig_RefreshNT_Actions takes nothing returns nothing
local integer i=1
local integer ID
local multiboarditem mbitem=null
local real topdmg=0
local real topblock=0
local string s=""
loop
exitwhen i>check
set mbitem=MultiboardGetItem(TableNT[10],i,2)
call MultiboardSetItemValue(mbitem,"|cff957700"+I2S(KillNT[PlayerNumberNT[i]]))
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(TableNT[10],i,4)
call MultiboardSetItemValue(mbitem,"|cff957700"+I2S(DeathNT[PlayerNumberNT[i]]))
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(TableNT[10],i,3)
call MultiboardSetItemValue(mbitem,"|cff957700"+I2S(BossNT[PlayerNumberNT[i]]))
call MultiboardReleaseItem(mbitem)
set i=i+1
endloop
set i=1
loop
exitwhen i>8
if TakeDamage[i]>topblock then
set topblock=TakeDamage[i]
endif
if GiveDamage[i]>topdmg then
set topdmg=GiveDamage[i]
endif
set i=i+1
endloop
set i=0
loop
exitwhen i>7
set ID=i+1
set mbitem=MultiboardGetItem(TableNT[11],4,i)
call MultiboardSetItemValue(mbitem,"|cffffcc00Kills: |r"+I2S(KillNT[ID]))
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(TableNT[11],5,i)
call MultiboardSetItemValue(mbitem,"|cffffcc00Boss: |r"+I2S(BossNT[ID]))
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(TableNT[11],6,i)
call MultiboardSetItemValue(mbitem,"|cffffcc00Death: |r"+I2S(DeathNT[ID]))
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(TableNT[11],10,i)
call MultiboardSetItemValue(mbitem,"|cffffcc00Spells: |r"+I2S(WizardNT[ID]))
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(TableNT[11],8,i)
call MultiboardSetItemValue(mbitem,"|cffffcc00Gold: |r"+I2S(GoldNT[ID]))
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(TableNT[11],9,i)
call MultiboardSetItemValue(mbitem,"|cffffcc00Books: |r"+I2S(BookNT[ID]))
call MultiboardReleaseItem(mbitem)
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(TableNT[11],11,i)
call MultiboardSetItemValue(mbitem,"|cffffcc00Quests: |r"+I2S(QuestsNT[ID]))
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(TableNT[11],12,i)
if R2I(TakeDamage[ID]/1000000)>0 then
set s=I2S(R2I(TakeDamage[ID]/1000000))+"M"
else
if R2I(TakeDamage[ID]/1000)>0 then
set s=I2S(R2I(TakeDamage[ID]/1000))+"K"
else
set s=I2S(R2I(TakeDamage[ID]))
endif
endif
if TakeDamage[ID]>=topblock then
set s="|cFF00C850"+s+"|r"
endif
call MultiboardSetItemValue(mbitem,"|cffffcc00Block: |r"+s)
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(TableNT[11],13,i)
if R2I(GiveDamage[ID]/1000000)>0 then
set s=I2S(R2I(GiveDamage[ID]/1000000))+"M"
else
if R2I(GiveDamage[ID]/1000)>0 then
set s=I2S(R2I(GiveDamage[ID]/1000))+"K"
else
set s=I2S(R2I(GiveDamage[ID]))
endif
endif
if GiveDamage[ID]>=topdmg then
set s="|cFF00C850"+s+"|r"
endif
call MultiboardSetItemValue(mbitem,"|cffffcc00Damage: |r"+s)
call MultiboardReleaseItem(mbitem)
set i=i+1
endloop
set mbitem=MultiboardGetItem(TableNT[10],PlayerOnlineNT+1,3)
call MultiboardSetItemValue(mbitem,"|cFF8C8C8C"+I2S(udg_CreepsAmount))
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(TableNT[10],PlayerOnlineNT+1,4)
call MultiboardSetItemValue(mbitem," TU:"+I2S(T_Unit)+"TD:"+I2S(T_Dummy))
call MultiboardReleaseItem(mbitem)
set mbitem=null
set s=""
endfunction
