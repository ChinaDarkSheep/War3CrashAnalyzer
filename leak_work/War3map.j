function Tyrael_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(Hash,ht,0)
local boolean blitz=LoadBoolean(Hash,ht,12)
local unit target=LoadUnitHandle(Hash,ht,1)
local real sec=LoadReal(Hash,ht,1)
local real x=GetUnitX(target)-GetUnitX(hero)
local real y=GetUnitY(target)-GetUnitY(hero)
local real x1
local real y1
local real r=SquareRoot(x*x+y*y)
local group g
local group g2
local real dmg
local unit u
if blitz then
if r>90. then
set r=bj_RADTODEG*Atan2(y,x)
set x=GetUnitX(hero)+90.*Cos(r*bj_DEGTORAD)
set y=GetUnitY(hero)+90.*Sin(r*bj_DEGTORAD)
call SetUnitPosition(hero,x,y)
call SetUnitFacing(hero,r)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",x,y))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\ReplenishHealth\\ReplenishHealthCasterOverhead.mdl",x,y))
else
call SaveBoolean(Hash,ht,12,false)
call SetUnitPathing(hero,true)
call SaveReal(Hash,ht,10,GetUnitX(target))
call SaveReal(Hash,ht,11,GetUnitY(target))
set g=CreateGroup()
set g2=CreateGroup()
set dmg=18*GetHeroAgi(hero,true)
call UnitDamageTarget(hero,target,.8*dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(hero,target,.2*dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set x=GetUnitX(target)
set y=GetUnitY(target)
call DestroyEffect(AddSpecialEffect("war3mapImported\\LightNova.mdx",x,y))
set u=CreateUnit(GetOwningPlayer(hero),'h009',x,y,bj_UNIT_FACING)
call UnitAddAbility(u,'A00H')
call UnitApplyTimedLife(u,'BTLF',.75)
call IssueTargetOrder(u,"thunderbolt",target)
set udg_Drop2=GetPlayerId(GetOwningPlayer(hero))
call GroupEnumUnitsInRange(g,x,y,300.,Bool_Filter_ID)
call GroupAddUnit(g2,target)
call GroupRemoveUnit(g,target)
set dmg=.5*dmg
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,.8*dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(hero,u,.2*dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupAddUnit(g2,u)
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
call SaveGroupHandle(Hash,ht,2,g2)
endif
else
if sec>0 then
call SaveReal(Hash,ht,1,sec-0.05)
set g=LoadGroupHandle(Hash,ht,2)
set x1=LoadReal(Hash,ht,10)
set y1=LoadReal(Hash,ht,11)
loop
set u=FirstOfGroup(g)
exitwhen u==null
set r=bj_RADTODEG*Atan2(GetUnitY(u)-y1,GetUnitX(u)-x1)
set x=GetUnitX(u)+20.*Cos(r*bj_DEGTORAD)
set y=GetUnitY(u)+20.*Sin(r*bj_DEGTORAD)
call SetUnitX(u,x)
call SetUnitY(u,y)
call GroupAddUnit(g2,u)
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
call SaveGroupHandle(Hash,ht,2,g2)
else
call DestroyGroup(LoadGroupHandle(Hash,ht,2))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(Hash,ht)
endif
endif
set g=null
set g2=null
set hero=null
set target=null
set u=null
set t=null
endfunction
function Trig_TyraelSkills_Actions takes nothing returns nothing
local unit hero=GetTriggerUnit()
local integer h=GetHandleId(hero)
local integer ihh=LoadInteger(udg_hash,h,5)
local timer t
local integer ht
local unit u
local group g=CreateGroup()
local real x
local real y
local real r
local real dmg
local integer a
if GetSpellAbilityId()=='A0OJ' then
set r=0
set x=GetUnitX(hero)
set y=GetUnitY(hero)
set udg_Drop2=GetPlayerId(GetOwningPlayer(hero))
call GroupEnumUnitsInRange(g,x,y,400.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
set r=r+0.04
call GroupRemoveUnit(g,u)
endloop
if r>=1. then
set r=1.
endif
if GetUnitAbilityLevel(hero,'A0OQ')==1 then
set r=r+0.4
endif
if r>0 then
set a=25+R2I(r*GetHeroAgi(hero,false))
set s__Heroes_TempAgi[sHero[ihh]]=s__Heroes_TempAgi[sHero[ihh]]+a
call SaveInteger(udg_hash,h,'d',LoadInteger(udg_hash,h,'d')+a)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveInteger(udg_hash,ht,1,a)
call TimerStart(t,PositiveDuration(hero,20),false,function TrigTyraelSkills_D)
call F_Stats(hero)
call UnitAddAbility(hero,'A0OK')
endif
endif
if GetSpellAbilityId()=='A0OL' then
set a=R2I(200*GetUnitAbilityLevel(hero,'A0OL')+4*GetHeroAgi(hero,true)-LoadInteger(udg_hash,h,'d'))
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+a)
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set udg_Drop2=GetPlayerId(GetOwningPlayer(hero))
call GroupEnumUnitsInRange(g,x,y,325.,Bool_Filter_ID)
call EnableTrigger(gg_trg_Set_damage_Timer)
if GetUnitAbilityLevel(hero,'A0OQ')==1 then
call RandomUnitFromGroup(12,g)
else
call RandomUnitFromGroup(8,g)
endif
loop
set u=FirstOfGroup(g)
exitwhen u==null
call GroupAddUnit(udg_TyraelGroup,u)
call UnitAddAbility(u,'A0OM')
call GroupRemoveUnit(g,u)
endloop
set t=CreateTimer()
set ht=GetHandleId(t)
call TimerStart(t,20.,false,function Tyrael_W)
endif
if GetSpellAbilityId()=='A0ON' then
call SetUnitPathing(hero,false)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(Hash,ht,0,hero)
call SaveBoolean(Hash,ht,12,true)
call SaveUnitHandle(Hash,ht,1,GetSpellTargetUnit())
call SaveReal(Hash,ht,1,.6)
call TimerStart(t,.05,true,function Tyrael_R)
endif
if GetSpellAbilityId()=='A0OP' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set a=GetUnitAbilityLevel(hero,'A0OP')*10+GetHeroAgi(hero,true)/5
set dmg=GetUnitAbilityLevel(hero,'A0OP')*80+2*GetHeroAgi(hero,true)
call GroupDamage(x,y,325,hero,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
call TempStats(hero,0,0,0,0,a,0,8)
else
endif
call DestroyGroup(g)
set hero=null
set u=null
set t=null
set g=null
endfunction
