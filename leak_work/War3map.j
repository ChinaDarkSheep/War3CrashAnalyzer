function SpellBreaker_Q_Move takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local timer t2
local integer ht2
local unit boomerang=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(boomerang)
local real angle=LoadReal(udg_hash,ht,1)
local real x=LoadReal(udg_hash,ht,2)
local real y=LoadReal(udg_hash,ht,3)
local real MS=LoadReal(udg_hash,ht,4)
local real speed=LoadReal(udg_hash,ht,5)
local boolean logic=LoadBoolean(udg_hash,ht,6)
local real x1
local real y1
local integer ID=GetPlayerId(GetOwningPlayer(boomerang))+1
if logic then
set x1=GetUnitX(udg_Hero[ID])
set y1=GetUnitY(udg_Hero[ID])
set x1=x-x1
set y1=y-y1
if SquareRoot(x1*x1+y1*y1)<=40. then
set t2=LoadTimerHandle(udg_hash,h,0)
set ht2=GetHandleId(t2)
call FlushChildHashtable(udg_hash,ht2)
call PauseTimer(t2)
call DestroyTimer(t2)
set t2=LoadTimerHandle(udg_hash,h,1)
set ht2=GetHandleId(t2)
call FlushChildHashtable(udg_hash,ht2)
call PauseTimer(t2)
call DestroyTimer(t2)
call RemoveUnit(boomerang)
call FlushChildHashtable(udg_hash,h)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
if udg_Talante[ID]==3 and GetUnitAbilityLevel(udg_Hero[ID],'A18J')==1 then
call SetUnitState(udg_Hero[ID],UNIT_STATE_LIFE,GetUnitState(udg_Hero[ID],UNIT_STATE_LIFE)+.1*GetUnitState(udg_Hero[ID],UNIT_STATE_MAX_LIFE))
call SetUnitState(udg_Hero[ID],UNIT_STATE_MANA,GetUnitState(udg_Hero[ID],UNIT_STATE_MANA)+.1*GetUnitState(udg_Hero[ID],UNIT_STATE_MAX_MANA))
endif
else
set x1=GetUnitX(udg_Hero[ID])
set y1=GetUnitY(udg_Hero[ID])
set angle=bj_RADTODEG*Atan2(y1-y,x1-x)
set x=x+MS*Cos(angle*bj_DEGTORAD)
set y=y+MS*Sin(angle*bj_DEGTORAD)
call SetUnitPosition(boomerang,x,y)
set speed=speed+0.03
set MS=MS+speed
if MS>55.00 then
set MS=55.00
endif
call SaveReal(udg_hash,ht,1,angle)
call SaveReal(udg_hash,ht,2,x)
call SaveReal(udg_hash,ht,3,y)
call SaveReal(udg_hash,ht,4,MS)
call SaveReal(udg_hash,ht,5,speed)
call SaveReal(udg_hash,h,'S',MS)
endif
else
set x1=GetUnitX(udg_Hero[ID])
set y1=GetUnitY(udg_Hero[ID])
set x=x+MS*Cos(angle*bj_DEGTORAD)
set y=y+MS*Sin(angle*bj_DEGTORAD)
call SetUnitPosition(boomerang,x,y)
set speed=speed+0.03
set MS=MS-speed
call SaveReal(udg_hash,ht,2,x)
call SaveReal(udg_hash,ht,3,y)
call SaveReal(udg_hash,ht,4,MS)
call SaveReal(udg_hash,ht,5,speed)
call SaveReal(udg_hash,h,'S',MS)
if MS<=0.00 then
set MS=0.30
set logic=true
call SaveBoolean(udg_hash,ht,6,logic)
else
endif
endif
set boomerang=null
set t=null
set t2=null
endfunction
function SpellBreaker_Q_DMG takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit boomerang=LoadUnitHandle(udg_hash,ht,0)
local integer h2=GetHandleId(boomerang)
local real speed=LoadReal(udg_hash,h2,'S')
local unit hero=LoadUnitHandle(udg_hash,ht,1)
local integer tic=LoadInteger(udg_hash,ht,0)
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local integer talante=udg_Talante[ID]
local real x
local real y
local real dmg=LoadReal(udg_hash,ht,1)
local real DMG
local real dmgPer
local group g=CreateGroup()
local unit u
if boomerang !=null then
set tic=tic+1
call SaveInteger(udg_hash,ht,0,tic)
set x=GetUnitX(boomerang)
set y=GetUnitY(boomerang)
if speed<=10.00 then
set dmg=dmg*0.50
endif
if talante==2 then
set dmgPer=2.25
else
set dmgPer=1.8
endif
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,175.,Condition(function Trig_Filter_ID))
loop
set u=FirstOfGroup(g)
exitwhen u==null
set DMG=1+dmg
if udg_SpellBreaker50 then
if GetUnitManaPercent(hero)>=50.00 then
set DMG=dmgPer*dmg
endif
call SetUnitState(hero,UNIT_STATE_MANA,(GetUnitState(hero,UNIT_STATE_MANA)-(DMG*0.01)))
endif
call UnitDamageTarget(hero,u,DMG,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodRifleman.mdl",u,"chest")
call DestroyEffect(bj_lastCreatedEffect)
call GroupRemoveUnit(g,u)
endloop
if tic==8 then
call SaveInteger(udg_hash,ht,0,0)
if udg_Talante[ID]==1 then
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,175.,Condition(function Trig_Filter_ID))
call RandomUnitFromGroup(1,g)
set u=FirstOfGroup(g)
call HeroAttack(hero,hero,u)
call Modificator(hero,hero,u)
endif
endif
else
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
call DestroyGroup(g)
set boomerang=null
set hero=null
set g=null
set u=null
set t=null
endfunction
function SpellBreaker_Q_Finish takes nothing returns nothing
local timer t=GetExpiredTimer()
local timer t2
local integer ht=GetHandleId(t)
local integer ht2
local unit boomerang=LoadUnitHandle(udg_hash,ht,0)
local integer h
if boomerang !=null then
set h=GetHandleId(boomerang)
set t2=LoadTimerHandle(udg_hash,h,0)
set ht2=GetHandleId(t2)
call FlushChildHashtable(udg_hash,ht2)
call PauseTimer(t2)
call DestroyTimer(t2)
set t2=LoadTimerHandle(udg_hash,h,1)
set ht2=GetHandleId(t2)
call FlushChildHashtable(udg_hash,ht2)
call PauseTimer(t2)
call DestroyTimer(t2)
call RemoveUnit(boomerang)
call FlushChildHashtable(udg_hash,h)
call PauseTimer(t)
call DestroyTimer(t)
endif
set boomerang=null
set t2=null
set t=null
endfunction
function SpellBreaker_W takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(caster)
local real sec=LoadReal(udg_hash,h,'w')-.03
local integer ihh=LoadInteger(udg_hash,h,5)
local integer iuh=LoadInteger(Hash,h,0)
local texttag tt=LoadTextTagHandle(udg_hash,ht,1)
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
call DestroyTextTag(tt)
if sec>0. and s__Heroes_BarSkill[sHero[ihh]]>0. then
call SaveReal(udg_hash,h,'w',sec)
call CreateTextTagUnitBJ(I2S(R2I(s__Heroes_BarSkill[sHero[ihh]])),caster,0,12.,50.,50.,100,0)
if not(GetLocalPlayer()==Player(ID-1))then
call SetTextTagVisibility(bj_lastCreatedTextTag,false)
endif
call SaveTextTagHandle(udg_hash,ht,1,bj_lastCreatedTextTag)
else
call SaveReal(udg_hash,h,'w',0.)
set s__Units_Bar[sUnit[iuh]]=s__Units_Bar[sUnit[iuh]]-s__Heroes_BarSkill[sHero[ihh]]
set s__Heroes_BarSkill[sHero[ihh]]=0.
if s__Units_Bar[sUnit[iuh]]<1. and s__Units_BarE[sUnit[iuh]]!=null then
call DestroyEffect(s__Units_BarE[sUnit[iuh]])
set s__Units_BarE[sUnit[iuh]]=null
endif
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
set tt=null
set caster=null
set t=null
endfunction
function Trig_SpellBreaker_Skills_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit Circle=LoadUnitHandle(udg_hash,ht,0)
local unit caster=LoadUnitHandle(udg_hash,ht,2)
local real sec=LoadReal(udg_hash,ht,1)
local integer h2=GetHandleId(Circle)
local real speed=LoadReal(udg_hash,h2,'S')
local integer ID=GetPlayerId(GetOwningPlayer(Circle))+1
local integer talante=LoadInteger(udg_hash,ht,2)
local real x
local real y
local real x1
local real y1
local real dmg
local real DMG
local group g=CreateGroup()
local unit u
local real dmgPer
local integer a
if Circle !=null then
set x=GetUnitX(Circle)
set y=GetUnitY(Circle)
set x1=GetUnitX(caster)-x
set y1=GetUnitY(caster)-y
if talante==2 then
set dmgPer=2.25
else
set dmgPer=1.8
endif
if talante==1 then
set dmg=0.1*(10.+0.1*GetHeroInt(caster,true))
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+dmg)
endif
if SquareRoot(x1*x1+y1*y1)>=600. or sec>=50. then
set dmg=udg_SpellBreakerRdmg
if talante==3 then
set dmg=.5*udg_SpellBreakerRdmg
endif
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,600.,Condition(function Trig_Filter_ID))
loop
set u=FirstOfGroup(g)
exitwhen u==null
set DMG=dmg
if udg_SpellBreaker50 then
if GetUnitManaPercent(caster)>=50.00 then
set DMG=dmgPer*dmg
endif
call SetUnitState(caster,UNIT_STATE_MANA,GetUnitState(caster,UNIT_STATE_MANA)-DMG*0.01)
endif
call UnitDamageTarget(caster,u,DMG,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodRifleman.mdl",u,"chest")
call DestroyEffect(bj_lastCreatedEffect)
call GroupRemoveUnit(g,u)
endloop
call DestroyTextTagBJ(udg_SBTextR)
call CreateTextTagLocBJ(I2S(R2I(dmg)),udg_SBPoint,0,14.,50.,75.,95.,0)
set udg_SBTextR=GetLastCreatedTextTag()
call ShowTextTagForceBJ(false,udg_SBTextR,GetPlayersAll())
call ShowTextTagForceBJ(true,udg_SBTextR,bj_FORCE_PLAYER[ID-1])
set udg_SpellBreakerR=false
call DestroyTextTagBJ(udg_SBTextR)
set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\FrostNova.mdx",x,y)
call DestroyEffect(bj_lastCreatedEffect)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
call RemoveUnit(Circle)
call RemoveLocation(udg_SBPoint)
if talante==3 then
set a=LoadInteger(Hash,GetHandleId(caster),0)
set s__Units_AllBlock[sUnit[a]]=s__Units_AllBlock[sUnit[a]]-2500
endif
else
if talante==3 then
set dmg=.01*udg_SpellBreakerRdmg
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,600.,Condition(function Trig_Filter_ID))
loop
set u=FirstOfGroup(g)
exitwhen u==null
set DMG=dmg
if udg_SpellBreaker50 then
if GetUnitManaPercent(caster)>=50.00 then
set DMG=dmgPer*dmg
endif
call SetUnitState(caster,UNIT_STATE_MANA,GetUnitState(caster,UNIT_STATE_MANA)-DMG*0.01)
endif
call UnitDamageTarget(caster,u,DMG,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
endif
set sec=sec+0.1
call SaveReal(udg_hash,ht,1,sec)
call DestroyTextTagBJ(udg_SBTextR)
call CreateTextTagLocBJ(I2S(R2I(udg_SpellBreakerRdmg)),udg_SBPoint,0,14.,50.,75.,95.,0)
set udg_SBTextR=GetLastCreatedTextTag()
call ShowTextTagForceBJ(false,udg_SBTextR,GetPlayersAll())
call ShowTextTagForceBJ(true,udg_SBTextR,bj_FORCE_PLAYER[ID-1])
endif
else
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set udg_SpellBreakerR=false
call RemoveLocation(udg_SBPoint)
endif
call DestroyGroup(g)
set caster=null
set Circle=null
set g=null
set u=null
set t=null
endfunction
function Trig_SpellBreaker_Skills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer h=GetHandleId(caster)
local integer ihh=LoadInteger(udg_hash,h,5)
local integer iuh=LoadInteger(Hash,h,0)
local real x
local real y
local real x1
local real y1
local real r
local real dmg
local integer i
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local integer h2
local integer ht
local integer talante=udg_Talante[ID]
local timer t
local unit u
if GetSpellAbilityId()=='A18K' then
set u=LoadUnitHandle(udg_hash,h,'Q')
if u !=null then
set ht=GetHandleId(u)
set t=LoadTimerHandle(udg_hash,ht,0)
call FlushChildHashtable(udg_hash,GetHandleId(t))
call PauseTimer(t)
call DestroyTimer(t)
set t=LoadTimerHandle(udg_hash,ht,1)
call FlushChildHashtable(udg_hash,GetHandleId(t))
call PauseTimer(t)
call DestroyTimer(t)
call RemoveUnit(u)
endif
set dmg=15.*GetUnitAbilityLevel(caster,'A18K')+GetHeroInt(caster,true)
if talante==2 then
set dmg=1.75*dmg
elseif talante==3 then
set dmg=dmg+0.1*GetUnitState(caster,UNIT_STATE_MANA)-GetHeroInt(caster,true)
call SetUnitState(caster,UNIT_STATE_MANA,GetUnitState(caster,UNIT_STATE_MANA)*.95)
endif
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set x1=GetSpellTargetX()
set y1=GetSpellTargetY()
set r=bj_RADTODEG*Atan2(y1-y,x1-x)
set u=CreateUnit(GetOwningPlayer(caster),'h05C',x+30.*Cos(r*bj_DEGTORAD),y+30.*Sin(r*bj_DEGTORAD),0)
call SaveUnitHandle(udg_hash,h,'Q',u)
set h2=GetHandleId(u)
call SaveReal(udg_hash,h2,'S',0.5)
call SetUnitPathing(u,true)
set t=CreateTimer()
call SaveTimerHandle(udg_hash,h2,0,t)
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call SaveReal(udg_hash,ht,1,r)
call SaveReal(udg_hash,ht,2,x+30.*Cos(r*bj_DEGTORAD))
call SaveReal(udg_hash,ht,3,y+30.*Sin(r*bj_DEGTORAD))
call SaveReal(udg_hash,ht,4,55.)
call SaveReal(udg_hash,ht,5,0.5)
call SaveBoolean(udg_hash,ht,6,false)
call TimerStart(t,0.04,true,function SpellBreaker_Q_Move)
set t=CreateTimer()
call SaveTimerHandle(udg_hash,h2,1,t)
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call SaveUnitHandle(udg_hash,ht,1,caster)
call SaveReal(udg_hash,ht,1,dmg)
call TimerStart(t,0.12,true,function SpellBreaker_Q_DMG)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call TimerStart(t,11.,false,function SpellBreaker_Q_Finish)
endif
if GetSpellAbilityId()=='A18L' then
set x=(GetUnitState(caster,UNIT_STATE_MANA)*(0.11+(0.01*I2R(GetUnitAbilityLevel(caster,'A18L')))))
call SetUnitManaBJ(caster,(GetUnitState(caster,UNIT_STATE_MANA)-x))
set x=x*(1.35+(0.15*GetUnitAbilityLevel(caster,'A18L')))
if talante==3 then
set x=2.*x
set r=5000.
else
set r=PositiveDuration(caster,20)
endif
set x=F_Barrier(caster,x)
set s__Units_Bar[sUnit[iuh]]=s__Units_Bar[sUnit[iuh]]+x-s__Heroes_BarSkill[sHero[ihh]]
set s__Heroes_BarSkill[sHero[ihh]]=x
if s__Units_BarE[sUnit[iuh]]==null then
set s__Units_BarE[sUnit[iuh]]=AddSpecialEffectTarget("war3mapImported\\Ubershield Blueberry.mdx",caster,"origin")
endif
set y=LoadReal(udg_hash,h,'w')
call SaveReal(udg_hash,h,'w',r)
if y<=0.02 then
call CreateTextTagUnitBJ(I2S(R2I(s__Heroes_BarSkill[sHero[ihh]])),caster,0,12.,50.,50.,100,0)
if not(GetLocalPlayer()==Player(ID-1))then
call SetTextTagVisibility(bj_lastCreatedTextTag,false)
endif
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveTextTagHandle(udg_hash,ht,1,bj_lastCreatedTextTag)
call TimerStart(t,.03,true,function SpellBreaker_W)
endif
if talante==1 then
set i=10*GetUnitAbilityLevel(caster,'A18L')+R2I(0.25*GetHeroInt(caster,true))
call TempStats(caster,0,0,i,0,0,0,PositiveDuration(caster,20))
endif
endif
if GetSpellAbilityId()=='A18N' then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set udg_SBPoint=GetUnitLoc(caster)
set u=CreateUnit(GetOwningPlayer(caster),'h05D',x,y,0)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call SaveReal(udg_hash,ht,1,0.)
call SaveUnitHandle(udg_hash,ht,2,caster)
call SaveInteger(udg_hash,ht,2,talante)
call TimerStart(t,0.1,true,function Trig_SpellBreaker_Skills_R)
set udg_SpellBreakerR=true
set udg_SpellBreakerRdmg=250.00+3.*GetHeroInt(caster,true)
if talante==2 then
set udg_SpellBreakerRdmg=2.*udg_SpellBreakerRdmg
elseif talante==3 then
set s__Units_AllBlock[sUnit[iuh]]=s__Units_AllBlock[sUnit[iuh]]+2500
endif
call CreateTextTagLocBJ(I2S(R2I(udg_SpellBreakerRdmg)),udg_SBPoint,0,12.00,50.00,75.00,95.00,0)
set udg_SBTextR=GetLastCreatedTextTag()
call ShowTextTagForceBJ(false,udg_SBTextR,GetPlayersAll())
call ShowTextTagForceBJ(true,udg_SBTextR,bj_FORCE_PLAYER[ID-1])
endif
set caster=null
set t=null
set u=null
endfunction
function InitTrig_SpellBreaker_Skills takes nothing returns nothing
set gg_trg_SpellBreaker_Skills=CreateTrigger()
call TriggerAddAction(gg_trg_SpellBreaker_Skills,function Trig_SpellBreaker_Skills_Actions)
endfunction
function Trig_SpellBreaker_E_Conditions takes nothing returns boolean
if(not(GetUnitTypeId(GetDyingUnit())=='h05E'))then
return false
endif
return true
endfunction
function Trig_SpellBreaker_E_Actions takes nothing returns nothing
local integer ID=GetPlayerId(GetOwningPlayer(GetDyingUnit()))+1
local integer h=GetHandleId(udg_Hero[ID])
local integer talante=udg_Talante[ID]
local real bonus=1+LoadReal(udg_hash,GetHandleId(udg_Hero[ID]),StringHash("Modificator"))
local real x=GetUnitX(GetDyingUnit())
local real y=GetUnitY(GetDyingUnit())
local real x1=GetLocationX(udg_SBPoint)
local real y1=GetLocationY(udg_SBPoint)
local real dmg
local real DMG
local real dmgPer
local group g=CreateGroup()
local unit u
if talante==2 then
set dmgPer=2.25
else
set dmgPer=1.8
endif
set x1=x-x1
set y1=y-y1
set dmg=(GetUnitAbilityLevel(udg_Hero[ID],'A18M')*60.+20.+2.*GetHeroInt(udg_Hero[ID],true))*bonus
if talante==3 then
set dmg=dmg+.1*GetUnitState(udg_Hero[ID],UNIT_STATE_MANA)*bonus
endif
if udg_SpellBreakerR and SquareRoot(x1*x1+y1*y1)<=600. then
set dmg=1.25*dmg
endif
if talante==2 then
set dmg=1.25*dmg
endif
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,165.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
set DMG=1+dmg
if udg_SpellBreaker50 then
if GetUnitManaPercent(udg_Hero[ID])>=50.00 then
set DMG=dmgPer*dmg
endif
call SetUnitState(udg_Hero[ID],UNIT_STATE_MANA,(GetUnitState(udg_Hero[ID],UNIT_STATE_MANA)-(DMG*0.01)))
endif
call UnitDamageTarget(udg_Hero[ID],u,DMG,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\Flamestrike Starfire I.mdx",x,y)
call DestroyEffect(bj_lastCreatedEffect)
call DestroyGroup(g)
set g=null
set u=null
endfunction
function InitTrig_SpellBreaker_E takes nothing returns nothing
set gg_trg_SpellBreaker_E=CreateTrigger()
call DisableTrigger(gg_trg_SpellBreaker_E)
call TriggerRegisterAnyUnitEventBJ(gg_trg_SpellBreaker_E,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(gg_trg_SpellBreaker_E,Condition(function Trig_SpellBreaker_E_Conditions))
call TriggerAddAction(gg_trg_SpellBreaker_E,function Trig_SpellBreaker_E_Actions)
endfunction
function LichQ_DMG_Formula takes unit caster,integer ID returns real
local integer h=GetHandleId(caster)
local real dmg=100.*GetUnitAbilityLevel(caster,'AUfn')+2.*GetHeroInt(caster,true)
if udg_Talante[ID]==2 then
set dmg=dmg*2.
if GetUnitAbilityLevel(caster,'A19G')==1 then
set dmg=dmg*2.
endif
elseif udg_Talante[ID]==3 and LoadBoolean(udg_hash,h,StringHash("HaveBar"))and GetHeroLevel(caster)>=50 then
set dmg=dmg*2.
endif
return dmg
endfunction
function Trig_Lich_Skills_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local group g=CreateGroup()
local group g2=CreateGroup()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer i=LoadInteger(udg_hash,ht,1)
local unit u
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local integer id=GetPlayerId(GetOwningPlayer(caster))
local real dmg=LichQ_DMG_Formula(caster,id+1)*0.5
set udg_Drop2=id
call GroupEnumUnitsInRange(g,x,y,800.,Bool_Filter_ID)
set bj_randomSubGroupGroup=g2
set bj_randomSubGroupWant=1
set bj_randomSubGroupTotal=CountUnitsInGroup(g)
if bj_randomSubGroupTotal>0 then
set bj_randomSubGroupChance=I2R(bj_randomSubGroupWant)/I2R(bj_randomSubGroupTotal)
call ForGroup(g,function GetRandomSubGroupEnum)
set u=FirstOfGroup(g2)
set bj_lastCreatedUnit=CreateUnit(Player(id),'h009',x,y,270.)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',3.)
call UnitAddAbility(bj_lastCreatedUnit,'A19F')
call IssueTargetOrder(bj_lastCreatedUnit,"frostnova",u)
set x=GetUnitX(u)
set y=GetUnitY(u)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl",x,y))
call GroupClear(g)
set udg_Drop2=id
call GroupEnumUnitsInRange(g,x,y,325.,Bool_Filter_ID)
call GroupRemoveUnit(g,u)
call UnitDamageTarget(caster,u,dmg,true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
set dmg=dmg*0.8
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
call GroupRemoveUnit(g,u)
endloop
endif
if i !=0 then
set i=i-1
call SaveInteger(udg_hash,ht,1,i)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
call DestroyGroup(g)
call DestroyGroup(g2)
set caster=null
set t=null
set g=null
set g2=null
set u=null
endfunction
function Trig_Lich_Skills_F takes nothing returns nothing
local timer t=GetExpiredTimer()
local group g=CreateGroup()
local integer h=GetHandleId(t)
local integer i=LoadInteger(udg_hash,h,1)
local unit u
local unit u2=LoadUnitHandle(udg_hash,h,2)
local real x=GetUnitX(u2)
local real y=GetUnitY(u2)
set udg_Drop2=GetPlayerId(GetOwningPlayer(udg_Lich))
call GroupEnumUnitsInRange(g,x,y,300.,Bool_Filter_ID)
set x=(0.3*udg_Miasm+1.4*GetHeroInt(udg_Lich,true))/2
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(udg_Lich,u,x,true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
call GroupRemoveUnit(g,u)
endloop
if i !=0 then
set i=i-1
call SaveInteger(udg_hash,h,1,i)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,h)
endif
set t=null
set u=null
set u2=null
call DestroyGroup(g)
endfunction
function Trig_Lich_Skills_D takes nothing returns nothing
local timer t=GetExpiredTimer()
local group g=CreateGroup()
local integer h=GetHandleId(t)
local integer i=LoadInteger(udg_hash,h,1)
local unit u
local unit u2=LoadUnitHandle(udg_hash,h,2)
local real x=GetUnitX(u2)
local real y=GetUnitY(u2)
local real dmg=(100.+udg_Miasm*2.+GetHeroInt(udg_Lich,true)*10)/16
if LoadInteger(udg_hash,h,3)==1 then
set dmg=2.*dmg
endif
call UnitDamageTarget(udg_Lich,u2,dmg,true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
if i>0 then
set i=i-1
if UnitAlive(u2)==false then
set i=0
endif
call SaveInteger(udg_hash,h,1,i)
else
if GetUnitAbilityLevel(udg_Lich,'A19G')==1 then
set udg_Drop2=GetPlayerId(GetOwningPlayer(udg_Lich))
call GroupEnumUnitsInRange(g,x,y,400.,Condition(function Trig_Filter_ID))
set dmg=GetHeroInt(udg_Lich,true)*4.
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(udg_Lich,u,dmg,true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
call GroupRemoveUnit(g,u)
endloop
endif
call PauseUnit(u2,false)
call UnitRemoveAbility(u2,'A19P')
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,h)
endif
set t=null
set u=null
set u2=null
call DestroyGroup(g)
endfunction
function Lich_Shield takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit target=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(target)
local real sec=LoadReal(udg_hash,h,StringHash("LichSec"))-.25
local integer ihh=LoadInteger(udg_hash,h,5)
local integer iuh=LoadInteger(Hash,h,0)
local integer ID=GetPlayerId(GetOwningPlayer(target))+1
if sec>0. and s__Units_BarLich[sUnit[iuh]]>0. then
call SaveReal(udg_hash,h,StringHash("LichSec"),sec)
else
call SaveReal(udg_hash,h,StringHash("LichSec"),0.)
set s__Units_Bar[sUnit[iuh]]=s__Units_Bar[sUnit[iuh]]-s__Units_BarLich[sUnit[iuh]]
set s__Units_BarLich[sUnit[iuh]]=0.
if s__Units_Bar[sUnit[iuh]]<1. and s__Units_BarE[sUnit[iuh]]!=null then
call DestroyEffect(s__Units_BarE[sUnit[iuh]])
set s__Units_BarE[sUnit[iuh]]=null
endif
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
set target=null
set t=null
endfunction
function LichR2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local unit summon=LoadUnitHandle(udg_hash,ht,1)
local integer ius=LoadInteger(Hash,GetHandleId(summon),0)
local integer iuh=LoadInteger(Hash,GetHandleId(hero),0)
local integer a
local integer tic=LoadInteger(udg_hash,ht,1)+1
if UnitAlive(summon)then
call SetUnitPosition(hero,GetUnitX(summon),GetUnitY(summon))
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.01*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
if GetHeroLevel(hero)>=50 then
set a=(s__Units_Arm[sUnit[iuh]]+GetHeroAgi(hero,true)/5)/2
set s__Units_Arm[sUnit[ius]]=s__Units_Arm[sUnit[ius]]+a-LoadInteger(udg_hash,ht,0)
call F_Armore(summon,s__Units_Arm[sUnit[ius]])
call SaveInteger(udg_hash,ht,0,a)
if tic==4 then
set tic=0
call GroupDamage(GetUnitX(summon),GetUnitY(summon),500.,summon,false,0.1*GetUnitState(summon,UNIT_STATE_MAX_LIFE),ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL)
endif
call SaveInteger(udg_hash,ht,1,tic)
endif
else
set HeroInUnits[GetPlayerId(GetOwningPlayer(hero))]=false
call ShowUnit(hero,true)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
set summon=null
set hero=null
set t=null
endfunction
function Trig_Lich_Skills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer h=GetHandleId(caster)
local integer iuh=LoadInteger(Hash,h,0)
local integer ihh=LoadInteger(udg_hash,h,5)
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local group g=CreateGroup()
local timer t
local unit u
local integer a
local real x
local real y
local real dmg
local real hp
local integer array r
local integer ht
local integer int=GetHeroInt(caster,true)
local integer str=GetHeroStr(caster,true)
if GetSpellAbilityId()=='AUfn' then
set u=GetSpellTargetUnit()
set x=GetUnitX(u)
set y=GetUnitY(u)
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,325.,Bool_Filter_ID)
set dmg=LichQ_DMG_Formula(caster,ID)
call UnitDamageTarget(caster,u,dmg,true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
set dmg=dmg*0.8
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
call GroupRemoveUnit(g,u)
endloop
endif
if GetSpellAbilityId()=='A19H' then
set u=GetSpellTargetUnit()
set r[0]=GetHandleId(u)
set a=LoadInteger(Hash,r[0],0)
if a==0 then
set a=SeekFreeUnit(r[0])
endif
if GetHeroLevel(caster)>=50 then
set dmg=300*GetUnitAbilityLevel(caster,'A19H')+4*GetHeroInt(caster,true)
else
set dmg=300*GetUnitAbilityLevel(caster,'A19H')+2*GetHeroInt(caster,true)
endif
set x=PositiveDuration(caster,20)
if GetSpellTargetUnit()==caster then
set dmg=dmg*1.3
if udg_Talante[ID]==3 then
set dmg=dmg*1.5
set x=10000.
endif
endif
set dmg=F_Barrier(caster,dmg)
set s__Units_Bar[sUnit[a]]=s__Units_Bar[sUnit[a]]-s__Units_BarLich[sUnit[a]]+dmg
set s__Units_BarLich[sUnit[a]]=dmg
if s__Units_BarE[sUnit[a]]==null then
set s__Units_BarE[sUnit[a]]=AddSpecialEffectTarget("war3mapImported\\MagicShield.mdx",u,"origin")
endif
set y=LoadReal(udg_hash,r[0],StringHash("LichSec"))
call SaveReal(udg_hash,r[0],StringHash("LichSec"),x)
if y<0.25 then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call TimerStart(t,.25,true,function Lich_Shield)
endif
endif
if GetSpellAbilityId()=='A199' then
set x=udg_Miasm+GetUnitState(caster,UNIT_STATE_MAX_MANA)*0.8
set a=R2I(x)/7000
loop
exitwhen a<=0
set a=a-1
set dmg=GetRandomInt(1,3)
if dmg==1 then
set r[1]=r[1]+1
set x=x-7000
endif
endloop
set a=R2I(x)/3500
loop
exitwhen a<=0
set dmg=GetRandomInt(2,5)
if dmg<=2 then
set r[2]=r[2]+1
set x=x-3500
endif
set a=a-1
endloop
set a=R2I(x)/2000
loop
exitwhen a<=0
set dmg=GetRandomInt(1,7)
if dmg<=3 then
set r[3]=r[3]+1
set x=x-2000
endif
set a=a-1
endloop
set a=R2I(x)/500
loop
exitwhen a<=0
set dmg=GetRandomInt(1,4)
if dmg==1 then
set r[4]=r[4]+1
set x=x-500
endif
set a=a-1
endloop
set a=R2I(x)/375
loop
exitwhen a<=0
set dmg=GetRandomInt(1,2)
if dmg==1 then
set r[5]=r[5]+1
set x=x-375
endif
set a=a-1
endloop
set r[6]=R2I(x)/375
set x=GetSpellTargetX()
set y=GetSpellTargetY()
if r[1]!=0 then
set hp=44.*str+26.*int
if GetUnitAbilityLevel(caster,'A19G')==1 then
set hp=1.5*hp
endif
set dmg=2.*int
loop
exitwhen r[1]<=0
set r[1]=r[1]-1
set u=CreateUnit(GetOwningPlayer(caster),'u02E',x,y,GetRandomInt(1,270))
call UnitApplyTimedLife(u,'BTLF',50.)
call UnitAddAbility(u,'AInv')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'AInv')
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+10)
endloop
endif
if r[2]!=0 then
set hp=18.*str+9.*int
if GetUnitAbilityLevel(caster,'A19G')==1 then
set hp=1.5*hp
endif
set dmg=1.1*int
loop
exitwhen r[2]<=0
set r[2]=r[2]-1
set u=CreateUnit(GetOwningPlayer(caster),'u02D',x,y,GetRandomInt(1,270))
call UnitApplyTimedLife(u,'BTLF',50.)
call UnitAddAbility(u,'AInv')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'AInv')
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+10)
endloop
endif
if r[3]!=0 then
set hp=14.*str+9.5*int
if GetUnitAbilityLevel(caster,'A19G')==1 then
set hp=1.5*hp
endif
set dmg=.5*int
loop
exitwhen r[3]<=0
set r[3]=r[3]-1
set u=CreateUnit(GetOwningPlayer(caster),'u02H',x,y,GetRandomInt(1,270))
call UnitApplyTimedLife(u,'BTLF',50.)
call UnitAddAbility(u,'AInv')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'AInv')
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+10)
endloop
endif
if r[4]!=0 then
set hp=2.5*str+1.85*int
if GetUnitAbilityLevel(caster,'A19G')==1 then
set hp=1.5*hp
endif
set dmg=0.17*int
loop
exitwhen r[4]<=0
set r[4]=r[4]-1
set u=CreateUnit(GetOwningPlayer(caster),'u02F',x,y,GetRandomInt(1,270))
call UnitApplyTimedLife(u,'BTLF',50.)
call UnitAddAbility(u,'AInv')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'AInv')
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+10)
endloop
endif
if r[5]!=0 then
set hp=4.*str+3.25*int
if GetUnitAbilityLevel(caster,'A19G')==1 then
set hp=1.5*hp
endif
set dmg=0.12*int
loop
exitwhen r[5]<=0
set r[5]=r[5]-1
set u=CreateUnit(GetOwningPlayer(caster),'u02G',x,y,GetRandomInt(1,270))
call UnitApplyTimedLife(u,'BTLF',50.)
call UnitAddAbility(u,'AInv')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'AInv')
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+10)
endloop
endif
if r[6]!=0 then
set hp=3.75*str+3.25*int
if GetUnitAbilityLevel(caster,'A19G')==1 then
set hp=hp*1.45
endif
set dmg=0.12*int
loop
exitwhen r[6]<=0
set r[6]=r[6]-1
set u=CreateUnit(GetOwningPlayer(caster),'u02C',x,y,GetRandomInt(1,270))
call UnitApplyTimedLife(u,'BTLF',50.)
call UnitAddAbility(u,'AInv')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'AInv')
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+10)
endloop
endif
endif
if GetSpellAbilityId()=='A19C' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set hp=40.*(str+int)
set dmg=2.5*int
set u=CreateUnit(GetOwningPlayer(caster),'u02I',x,y,GetRandomInt(1,270))
set a=SeekFreeUnit(GetHandleId(u))
call UnitApplyTimedLife(u,'BTLF',50.)
call UnitAddAbility(u,'AInv')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'AInv')
if GetUnitAbilityLevel(caster,'A19G')==1 then
call UnitAddAbility(u,'A18E')
set s__Units_Arm[sUnit[a]]=s__Units_Arm[sUnit[a]]+20
call F_Armore(u,s__Units_Arm[sUnit[a]])
endif
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+10)
endif
if GetSpellAbilityId()=='A19E' then
set t=CreateTimer()
set a=GetHandleId(t)
call SaveInteger(udg_hash,a,1,25)
call SaveUnitHandle(udg_hash,a,0,caster)
call TimerStart(t,0.25,true,function Trig_Lich_Skills_R)
endif
if GetSpellAbilityId()=='A19N' then
set t=CreateTimer()
set a=GetHandleId(t)
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set u=CreateUnit(GetOwningPlayer(caster),'h05H',x,y,GetRandomInt(1,270))
call UnitApplyTimedLife(u,'BTLF',8.)
call SaveInteger(udg_hash,a,1,16)
call SaveUnitHandle(udg_hash,a,2,u)
call TimerStart(t,0.5,true,function Trig_Lich_Skills_F)
elseif GetSpellAbilityId()=='A19O' then
set t=CreateTimer()
set a=GetHandleId(t)
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set u=GetSpellTargetUnit()
call UnitAddAbility(u,'A19P')
call PauseUnit(u,true)
if IsUnitType(u,UNIT_TYPE_HERO)==true or GetUnitAbilityLevel(u,'Arsk')==1 then
call SaveInteger(udg_hash,a,1,8)
call SaveInteger(udg_hash,a,3,1)
else
call SaveInteger(udg_hash,a,1,16)
call SaveInteger(udg_hash,a,3,2)
endif
call SaveUnitHandle(udg_hash,a,2,u)
call TimerStart(t,0.25,true,function Trig_Lich_Skills_D)
elseif GetSpellAbilityId()=='A19L' then
call ShowUnit(caster,false)
set HeroInUnits[ID-1]=true
set a=R2I(F_Barrier(caster,.4*GetUnitState(caster,UNIT_STATE_MAX_LIFE)+20*GetHeroInt(caster,true)))
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set u=CreateUnit(GetOwningPlayer(caster),'nfgl',x,y,GetRandomInt(1,270))
set r[0]=SeekFreeUnitMin(GetHandleId(u))
call UnitAddAbility(u,'A1BF')
call SetUnitAbilityLevel(u,'A1BF',11)
call UnitAddAbility(u,'A17N')
call SetUnitAbilityLevel(u,'A17N',16)
call UnitAddAbility(u,'A13N')
call SetUnitAbilityLevel(u,'A13N',3)
call UnitApplyTimedLife(u,'BTLF',15.)
call UnitAddAbility(u,'AInv')
call SummonStats(false,a,2*GetHeroInt(caster,true),u,caster)
call UnitRemoveAbility(u,'AInv')
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveUnitHandle(udg_hash,ht,1,u)
call TimerStart(t,0.25,true,function LichR2)
endif
call DestroyGroup(g)
set caster=null
set u=null
set t=null
endfunction
function InitTrig_Lich_Skills takes nothing returns nothing
set gg_trg_Lich_Skills=CreateTrigger()
call DisableTrigger(gg_trg_Lich_Skills)
call TriggerAddAction(gg_trg_Lich_Skills,function Trig_Lich_Skills_Actions)
endfunction
function Trig_SwordMaster_Skills_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(caster)
local integer iuh=LoadInteger(Hash,h,0)
call SaveBoolean(udg_hash,h,'r',false)
call UnitRemoveAbility(caster,'A1AV')
set s__Units_Arm[sUnit[iuh]]=s__Units_Arm[sUnit[iuh]]-50
call F_Armore(caster,s__Units_Arm[sUnit[iuh]])
if UnitAlive(caster)then
call UnitRemoveAbility(caster,'B02Z')
endif
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set caster=null
set t=null
endfunction
function Trig_SwordMaster_Skills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local integer h=GetHandleId(caster)
local integer ihh=LoadInteger(udg_hash,h,5)
local integer iuh=LoadInteger(Hash,h,0)
local unit u
local group g=CreateGroup()
local real x
local real y
local real dmg
local real r
local timer t
local integer ht
local integer dmgtype
local integer a
local integer b
local integer c
local integer d
local real crit
if GetSpellAbilityId()=='A1AR' then
set x=GetUnitX(caster)+150*Cos(GetUnitFacing(caster)*bj_DEGTORAD)
set y=GetUnitY(caster)+150*Sin(GetUnitFacing(caster)*bj_DEGTORAD)
if GetUnitAbilityLevel(caster,'A1AQ')==1 then
set r=300
set dmg=100*GetUnitAbilityLevel(caster,'A1AR')+2.5*GetHeroStr(caster,true)+3.*Summ_Attack(caster)
else
set r=375
set dmg=100*GetUnitAbilityLevel(caster,'A1AR')+2.5*GetHeroStr(caster,true)
endif
set crit=Psych_crit(caster,1.,1.)
if crit>1. then
set dmg=crit*dmg
set bj_lastCreatedTextTag=CreateTextTag()
call SetTextTagTextBJ(bj_lastCreatedTextTag,"|cFFFF0000+"+I2S(R2I(dmg))+"!",9.)
call SetTextTagPos(bj_lastCreatedTextTag,x,y,0)
call SetTextTagColorBJ(bj_lastCreatedTextTag,100.,100.,100.,0.)
if GetLocalPlayer()==Player(ID-1)then
call SetTextTagVisibility(bj_lastCreatedTextTag,true)
else
call SetTextTagVisibility(bj_lastCreatedTextTag,false)
endif
call SetTextTagVelocityBJ(bj_lastCreatedTextTag,75.,90.)
call SetTextTagSuspended(bj_lastCreatedTextTag,false)
call SetTextTagPermanent(bj_lastCreatedTextTag,false)
call SetTextTagLifespan(bj_lastCreatedTextTag,3.00)
call SetTextTagFadepoint(bj_lastCreatedTextTag,2.00)
endif
if LoadBoolean(udg_hash,GetHandleId(caster),'r')then
set dmgtype=26
else
set dmgtype=14
endif
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,r,Condition(function Trig_Filter_ID))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,ConvertDamageType(dmgtype),WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
endif
if GetSpellAbilityId()=='A1AT' then
if GetUnitAbilityLevel(caster,'A1AQ')==1 then
set d=R2I(1.5*GetHeroStr(caster,true))
else
set d=0
endif
set a=30*GetUnitAbilityLevel(caster,'A1AT')+R2I(0.2*GetHeroStr(caster,true))
set b=30*GetUnitAbilityLevel(caster,'A1AT')+R2I(0.2*GetHeroAgi(caster,true))
set c=30*GetUnitAbilityLevel(caster,'A1AT')+R2I(0.2*GetHeroInt(caster,true))
if UnitHasItemOfTypeBJ(caster,'I09Z')then
set a=a-(3*s__Heroes_TempStr[sHero[ihh]])/10
set b=b-(3*s__Heroes_TempAgi[sHero[ihh]])/10
set c=c-(3*s__Heroes_TempInt[sHero[ihh]])/10
endif
call TempStats(caster,a,b,c,d,0,0,PositiveDuration(caster,10))
endif
if GetSpellAbilityId()=='A1AU' then
call SaveBoolean(udg_hash,GetHandleId(caster),'r',true)
call UnitAddAbility(caster,'A1AV')
call SetUnitAbilityLevel(caster,'A14O',3)
set s__Units_Arm[sUnit[iuh]]=s__Units_Arm[sUnit[iuh]]+50
call F_Armore(caster,s__Units_Arm[sUnit[iuh]])
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,GetTriggerUnit())
call TimerStart(t,PositiveDuration(caster,25),false,function Trig_SwordMaster_Skills_R)
endif
call DestroyGroup(g)
set caster=null
set u=null
set g=null
set t=null
endfunction
function InitTrig_SwordMaster_Skills takes nothing returns nothing
set gg_trg_SwordMaster_Skills=CreateTrigger()
call TriggerAddAction(gg_trg_SwordMaster_Skills,function Trig_SwordMaster_Skills_Actions)
endfunction
