call UnitAddItemByIdSwapped('I0AP',GetSpellAbilityUnit())
set udg_PandoraBox=true
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],15.00,"|cFF00C850Предмет создан!|r")
else
endif
endfunction
