set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveInteger(udg_hash,ht,1,R2I(y)*4)
call SaveReal(udg_hash,ht,2,x)
call TimerStart(t,0.25,true,function Trig_GonecSkills_Q)
endif
endif
