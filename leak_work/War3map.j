function Trig_TikondrusSkills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer h=GetHandleId(caster)
local integer ihh=LoadInteger(udg_hash,h,5)
local real x
local real y
local unit u
local real dmg
local real hp
local group g=CreateGroup()
local integer h2=GetHandleId(caster)
local integer talante=udg_Talante[GetPlayerId(GetOwningPlayer(caster))+1]
local integer ht
local integer i
local timer t
local integer str=GetHeroStr(caster,true)-s__Heroes_TempStr[sHero[ihh]]/2
local integer int=GetHeroInt(caster,true)-s__Heroes_TempInt[sHero[ihh]]/2
if GetSpellAbilityId()=='A0B7' then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveInteger(udg_hash,ht,0,30)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,0.3,true,function Trig_TikondrusSkills_Q)
endif
if GetSpellAbilityId()=='A0B6' then
if GetUnitAbilityLevel(caster,'A0XV')==1 then
set hp=12.*str+4.*int
set dmg=0.4*int
else
set hp=4.*str+2.*int
set dmg=0.15*str
endif
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>3
set x=GetUnitX(caster)+100*Cos((GetUnitFacing(caster))*bj_DEGTORAD)
set y=GetUnitY(caster)+100*Sin((GetUnitFacing(caster))*bj_DEGTORAD)
set bj_lastCreatedEffect=AddSpecialEffect("Objects\\Spawnmodels\\Orc\\OrcSmallDeathExplode\\OrcSmallDeathExplode.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
set u=CreateUnit(GetOwningPlayer(caster),'u000',x,y,GetUnitFacing(caster))
call UnitAddAbility(u,'A181')
call UnitAddAbility(u,'A13N')
call SetUnitAbilityLevel(u,'A13N',3)
if GetUnitAbilityLevel(caster,'A0XV')>=1 then
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+10)
endif
call UnitAddAbility(u,'A12I')
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'A007')
call UnitApplyTimedLife(u,'BTLF',50.)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
if udg_NatrezimR then
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>2
set x=GetUnitX(caster)+100*Cos((GetUnitFacing(caster))*bj_DEGTORAD)
set y=GetUnitY(caster)+100*Sin((GetUnitFacing(caster))*bj_DEGTORAD)
set bj_lastCreatedEffect=AddSpecialEffect("Objects\\Spawnmodels\\Orc\\OrcSmallDeathExplode\\OrcSmallDeathExplode.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
set u=CreateUnit(GetOwningPlayer(caster),'u000',x,y,GetUnitFacing(caster))
if talante==2 then
call UnitAddAbility(u,'A181')
call UnitAddAbility(u,'A13N')
call SetUnitAbilityLevel(u,'A13N',3)
call UnitAddAbility(u,'A17O')
call SetUnitAbilityLevel(u,'A17O',GetUnitAbilityLevel(caster,'A0B6')*2+1)
endif
call UnitAddAbility(u,'A12I')
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'A007')
call UnitApplyTimedLife(u,'BTLF',50.)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
endif
if GetSpellAbilityId()=='A0B8' then
call UnitAddAbility(caster,'A0IC')
set i=50*GetUnitAbilityLevel(caster,'A0B8')
if udg_NatrezimR then
call UnitAddAbility(caster,'A0NN')
endif
if GetUnitAbilityLevel(caster,'A0XV')>=1 and talante==1 then
set i=i+(3*(GetHeroStr(caster,true)-s__Heroes_TempStr[sHero[ihh]]))/10
endif
call TempStats(caster,i,0,0,0,0,0,PositiveDuration(caster,14))
if talante==2 then
call SaveReal(udg_hash,h2,StringHash("SummonAT"),LoadReal(udg_hash,h2,StringHash("SummonAT"))+0.15)
call SaveReal(udg_hash,h2,StringHash("SummonHP"),LoadReal(udg_hash,h2,StringHash("SummonHP"))+0.15)
if GetUnitAbilityLevel(caster,'A0XV')==1 then
set hp=12.*str+4.*int
set dmg=0.4*int
else
set hp=4.*str+2.*int
set dmg=0.15*str
endif
set x=GetUnitX(caster)+100*Cos((GetUnitFacing(caster))*bj_DEGTORAD)
set y=GetUnitY(caster)+100*Sin((GetUnitFacing(caster))*bj_DEGTORAD)
set bj_lastCreatedEffect=AddSpecialEffect("Objects\\Spawnmodels\\Orc\\OrcSmallDeathExplode\\OrcSmallDeathExplode.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
set u=CreateUnit(GetOwningPlayer(caster),'u000',x,y,GetUnitFacing(caster))
call UnitAddAbility(u,'A181')
call UnitAddAbility(u,'A13N')
call SetUnitAbilityLevel(u,'A13N',3)
if GetUnitAbilityLevel(caster,'A0XV')>=1 then
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+10)
endif
call UnitAddAbility(u,'A12I')
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'A007')
call UnitApplyTimedLife(u,'BTLF',40.)
endif
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveInteger(udg_hash,ht,2,talante)
call TimerStart(t,16,false,function Trig_TikondrusSkills_E)
endif
if GetSpellAbilityId()=='A0B5' then
set udg_NatrezimR=true
call UnitAddAbilityBJ('A0NO',caster)
call SetUnitManaPercentBJ(caster,(GetUnitManaPercent(caster)+50.00))
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,20,false,function Tikondrus_R)
endif
if GetSpellAbilityId()=='SNin' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
call TriggerSleepAction(1.)
set dmg=1000+4.*str
call GroupEnumUnitsInRange(g,x,y,250.,null)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)and IsUnitEnemy(u,GetOwningPlayer(caster))then
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
call GroupRemoveUnit(g,u)
endloop
set i=GetHeroStr(caster,true)-s__Heroes_TempStr[sHero[ihh]]/2
set dmg=5.*i
set hp=50.*i
set u=CreateUnit(GetOwningPlayer(caster),'n02X',x,y,0)
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+7)
call UnitApplyTimedLife(u,'BTLF',50.)
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'A007')
set t=CreateTimer()
call SaveUnitHandle(udg_hash,GetHandleId(t),1,u)
call TimerStart(t,2,true,function Trig_TikondrusSkills_GolemTimer)
endif
call DestroyGroup(g)
set g=null
set t=null
set caster=null
set u=null
endfunction
