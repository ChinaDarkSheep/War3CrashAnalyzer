function Trig_StrajDied_Actions takes nothing returns nothing
if GetUnitTypeId(GetDyingUnit())=='n03J' or GetUnitTypeId(GetDyingUnit())=='n079' then
set udg_NagaBoss=udg_NagaBoss+1
if udg_NagaBoss==9 then
call DisplayTimedTextToForce(GetPlayersAll(),17.00,"|cFFFF5800Все стражи убиты! Теперь аватар уязвим!")
set bj_lastCreatedGroup=CreateGroup()
