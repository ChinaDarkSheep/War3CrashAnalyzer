function Trig_OrcSpell_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local unit u
local group g=CreateGroup()
local real x
local real y
local real dmg
if GetSpellAbilityId()=='A13G' then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set dmg=udg_BilderQuestOrc[1]*100.+200
if udg_BilderQuestOrc[1]>15 then
set dmg=dmg+0.4*GetUnitState(caster,UNIT_STATE_MAX_LIFE)
endif
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,500.,Bool_Filter_ID)
set udg_WarboosSpellLogic=true
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
set udg_WarboosSpellLogic=false
endif
set caster=null
set u=null
call DestroyGroup(g)
set g=null
endfunction
