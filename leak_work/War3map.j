local group g=CreateGroup()
call GroupEnumUnitsInRange(g,800.,GetUnitX(gg_unit_htow_0002),GetUnitY(gg_unit_htow_0002),Condition(function Trig_help_Func009Func001001003))
if GetEventPlayerChatString()=="-help top" then
call ForGroup(g,function Trig_help_Func009Func001A)
elseif GetEventPlayerChatString()=="-help right" then
call ForGroup(g,function Trig_help_Func010Func001A)
elseif GetEventPlayerChatString()=="-help left" then
call ForGroup(g,function Trig_help_Func011Func001A)
elseif GetEventPlayerChatString()=="-help Apotrope" then
call ForGroup(g,function Trig_help_Func012Func001A)
endif
call DestroyGroup(g)
set g=null
endfunction
