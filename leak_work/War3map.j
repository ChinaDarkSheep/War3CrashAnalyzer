function Trig_Timer01s_TreauseMap takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local real sec=LoadReal(udg_hash,ht,1)
local real xt=LoadReal(udg_hash,ht,2)
local real yt=LoadReal(udg_hash,ht,3)
local real x=GetUnitX(hero)
local real y=GetUnitY(hero)
local real r=0.
local texttag tt=LoadTextTagHandle(udg_hash,ht,4)
local integer a
if sec>0 then
set sec=sec-0.1
call SaveReal(udg_hash,ht,1,sec)
set x=xt-x
set y=yt-y
set r=SquareRoot(x*x+y*y)
if r<500. then
set a=R2I((750+10*GetRandomInt(0,65))*(1+0.05*udg_Time[2]))
set x=0.5*a
set y=0.5*a
set y=y*GoldAvg[ID]
set a=R2I(x+y)
call Func_CD(hero,"TreauseMap",40+0.25*sec)
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"|cFFC9AD00Вы нашли сокровище! Получено "+I2S(a)+" ед золота|r")
call SetPlayerStateBJ(Player(ID-1),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(ID-1),PLAYER_STATE_RESOURCE_GOLD)+a)
call DestroyTextTag(tt)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
else
call SetTextTagTextBJ(tt,"|cFFFFDC00+"+I2S(R2I(r))+"|r",15.)
call SetTextTagPosUnit(tt,hero,0)
call SetTextTagColorBJ(tt,100,250,250,0)
call SetTextTagVelocityBJ(tt,0.00,0.00)
call SetTextTagPermanent(tt,true)
endif
else
call Func_CD(hero,"TreauseMap",40)
call DestroyTextTag(tt)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
set hero=null
set t=null
set tt=null
endfunction
function Trig_Timer01s_Trap takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local unit trap=LoadUnitHandle(udg_hash,ht,2)
local integer i=LoadInteger(udg_hash,ht,1)
local integer a
local real x=GetUnitX(trap)
local real y=GetUnitY(trap)
local boolean activated=false
local unit u
local group g
local real dmg=LoadReal(udg_hash,ht,3)
if i>=0 and UnitAlive(trap)then
set i=i-1
call SaveInteger(udg_hash,ht,1,i)
if i==58 then
call UnitAddAbility(trap,'Apiv')
endif
if i<54 then
set g=CreateGroup()
set udg_Drop2=GetPlayerId(GetOwningPlayer(hero))
call GroupEnumUnitsInRange(g,x,y,250.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null or activated
set activated=true
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
if activated then
call SetUnitAnimation(trap,"attack")
call UnitAddAbility(trap,'A1C4')
call IssueImmediateOrder(trap,"stomp")
set g=CreateGroup()
set udg_Drop2=GetPlayerId(GetOwningPlayer(hero))
call GroupEnumUnitsInRange(g,x,y,450.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
call SleepRemove(trap,0.3)
endif
endif
else
call RemoveUnit(trap)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
set hero=null
set trap=null
set u=null
set g=null
set t=null
endfunction
function Trig_Timer01s_Hell_Helmet_CD takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local real r=LoadReal(udg_hash,ht,1)
local real max_mana=GetUnitState(hero,UNIT_STATE_MAX_MANA)
local real mana=GetUnitState(hero,UNIT_STATE_MANA)
local real manaper
if r>0. then
set manaper=mana/max_mana
if manaper>=0.8 then
set r=r-3.75
call SetUnitState(hero,UNIT_STATE_MANA,mana-0.25*(0.5*GetHeroInt(hero,true)))
else
set r=r-2.5
endif
call SaveReal(udg_hash,ht,1,r)
else
call SaveBoolean(udg_hash,GetHandleId(hero),StringHash("Hell Helmet"),false)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
set t=null
set hero=null
endfunction
