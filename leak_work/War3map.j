function RandomUnitFromGroup takes integer count,group g returns nothing
local unit array u
local integer array irand
local unit first=null
local unit random=null
local integer howunits=0
local integer howunits2
local integer intran
local integer schetchik=0
loop
set first=FirstOfGroup(g)
exitwhen first==null
if first !=null and UnitAlive(first)then
set howunits=howunits+1
set u[howunits]=first
endif
call GroupRemoveUnit(g,first)
endloop
set howunits2=howunits
loop
exitwhen howunits<=0 or count<=schetchik
set intran=GetRandomInt(1,howunits)
set random=u[intran]
call GroupAddUnit(g,random)
set u[intran]=u[howunits]
set howunits=howunits-1
set schetchik=schetchik+1
set random=null
endloop
loop
exitwhen howunits2<=0
set u[howunits2]=null
set howunits2=howunits2-1
endloop
set first=null
endfunction
function Neitral_Filter takes nothing returns boolean
return(GetOwningPlayer(GetFilterUnit())==Player(PLAYER_NEUTRAL_AGGRESSIVE)and UnitAlive(GetFilterUnit()))
endfunction
function Func_MageFruit takes unit u,boolean text returns nothing
local integer ID=GetPlayerId(GetOwningPlayer(u))+1
local integer a=40
local integer b=a
local integer c=a
local integer ids=LoadInteger(udg_hash,GetHandleId(u),5)
set MageFruit[ID]=MageFruit[ID]+1
set s__Heroes_buyI0B5[sHero[ids]]=s__Heroes_buyI0B5[sHero[ids]]+1
if GetHeroStr(u,false)>=GetHeroAgi(u,false)then
if GetHeroStr(u,false)>=GetHeroInt(u,false)then
set a=75
else
set c=75
endif
else
if GetHeroAgi(u,false)>=GetHeroInt(u,false)then
set b=75
else
set c=75
endif
endif
if text then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],20.00,"|cFFFFDC00Вы получили "+I2S(a)+" ед. силы, "+I2S(b)+" ед. ловкости и "+I2S(c)+" разума!")
endif
call SetHeroStr(u,GetHeroStr(u,false)+a,true)
call SetHeroAgi(u,GetHeroAgi(u,false)+b,true)
call SetHeroInt(u,GetHeroInt(u,false)+c,true)
endfunction
function TakeItem takes unit u,integer idi,integer i returns nothing
local integer h=GetHandleId(u)
local integer id=GetPlayerId(GetOwningPlayer(u))
local integer ID=id+1
local integer ihh=LoadInteger(udg_hash,h,5)
local integer iuh=LoadInteger(Hash,h,0)
local integer a
local integer b
local integer c
if s__SItem_mstat[sItem[idi]]!=0 then
if LoadStr(udg_hash,h,2)=="Str" then
set s__Heroes_Str[sHero[ihh]]=s__Heroes_Str[sHero[ihh]]+i*s__SItem_mstat[sItem[idi]]
else
if LoadStr(udg_hash,h,2)=="Agi" then
set s__Heroes_Agi[sHero[ihh]]=s__Heroes_Agi[sHero[ihh]]+i*s__SItem_mstat[sItem[idi]]
else
set s__Heroes_Int[sHero[ihh]]=s__Heroes_Int[sHero[ihh]]+i*s__SItem_mstat[sItem[idi]]
endif
endif
endif
set a=i*s__SItem_BaseDmg[sItem[idi]]
if a>0 then
call TakeHeroAttack(a,u)
elseif a<0 then
call RemoveAttack(-a,u)
endif
set a=s__SItem_SpecStatID[sItem[idi]]-(s__SItem_SpecStatID[sItem[idi]]/100)*100
if a==1 then
set s__Units_AllDmg[sUnit[iuh]]=s__Units_AllDmg[sUnit[iuh]]+i*s__SItem_SpecStatNum[sItem[idi]]
elseif a==2 then
set s__Units_AllBlock[sUnit[iuh]]=s__Units_AllBlock[sUnit[iuh]]+i*s__SItem_SpecStatNum[sItem[idi]]
elseif a==3 then
set s__Units_AllDmg[sUnit[iuh]]=s__Units_AllDmg[sUnit[iuh]]+i*s__SItem_SpecStatNum[sItem[idi]]
set s__Units_AllBlock[sUnit[iuh]]=s__Units_AllBlock[sUnit[iuh]]+i*s__SItem_SpecStatNum[sItem[idi]]
elseif a==4 then
set s__Units_MageDamage[sUnit[iuh]]=s__Units_MageDamage[sUnit[iuh]]+i*s__SItem_SpecStatNum[sItem[idi]]
elseif a==5 then
set s__Units_MageBlock[sUnit[iuh]]=s__Units_MageBlock[sUnit[iuh]]+i*s__SItem_SpecStatNum[sItem[idi]]
elseif a==33 then
set No_HeroDMG[ID]=No_HeroDMG[ID]+0.01*I2R(i*s__SItem_SpecStatNum[sItem[idi]])
set No_HeroBlock[ID]=No_HeroBlock[ID]+0.01*I2R(i*s__SItem_SpecStatNum[sItem[idi]])
endif
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]+i*s__SItem_HP[sItem[idi]]
set s__Units_MP[sUnit[iuh]]=s__Units_MP[sUnit[iuh]]+i*s__SItem_MP[sItem[idi]]
set s__Units_GAttack[sUnit[iuh]]=s__Units_GAttack[sUnit[iuh]]+i*s__SItem_green_atk[sItem[idi]]
set s__Units_Arm[sUnit[iuh]]=s__Units_Arm[sUnit[iuh]]+i*s__SItem_armore[sItem[idi]]
set s__Heroes_Str[sHero[ihh]]=s__Heroes_Str[sHero[ihh]]+i*s__SItem_str[sItem[idi]]
set s__Heroes_Agi[sHero[ihh]]=s__Heroes_Agi[sHero[ihh]]+i*s__SItem_agi[sItem[idi]]
set s__Heroes_Int[sHero[ihh]]=s__Heroes_Int[sHero[ihh]]+i*s__SItem_int[sItem[idi]]
call SaveInteger(udg_hash,h,H_HighStat,LoadInteger(udg_hash,h,H_HighStat)+i*s__SItem_hst[sItem[idi]])
call SaveReal(udg_hash,h,StringHash("HPRegen"),LoadReal(udg_hash,h,StringHash("HPRegen"))+i*s__SItem_hp_reg[sItem[idi]])
call SaveReal(udg_hash,h,StringHash("HPRegenBonus"),LoadReal(udg_hash,h,StringHash("HPRegenBonus"))+i*s__SItem_hp_regPer[sItem[idi]])
call SaveReal(udg_hash,h,StringHash("MPRegen"),LoadReal(udg_hash,h,StringHash("MPRegen"))+i*s__SItem_mp_reg[sItem[idi]])
call SaveReal(udg_hash,h,StringHash("MPRegenBonus"),LoadReal(udg_hash,h,StringHash("MPRegenBonus"))+i*s__SItem_mp_regPer[sItem[idi]])
set s__Heroes_MS[sHero[ihh]]=s__Heroes_MS[sHero[ihh]]+i*s__SItem_MS[sItem[idi]]
set udg_Looting[ID]=udg_Looting[ID]+i*s__SItem_Looting[sItem[idi]]
set udg_ReflectDmg[ID]=udg_ReflectDmg[ID]+i*s__SItem_ReflectAttack[sItem[idi]]
set udg_HeroResTime[ID]=udg_HeroResTime[ID]-i*s__SItem_HeroResTime[sItem[idi]]
set udg_HeroGold[ID]=udg_HeroGold[ID]+i*s__SItem_Gold[sItem[idi]]
set udg_HeroGoldMax[ID]=udg_HeroGoldMax[ID]+i*s__SItem_GoldMax[sItem[idi]]
set udg_HeroExp[ID]=udg_HeroExp[ID]+i*s__SItem_Exp[sItem[idi]]
endfunction
