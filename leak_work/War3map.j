endfunction
function SeekMinUnit takes nothing returns integer
local integer i=1
loop
if s__Units_id[sUnit[i]]==0 then
set T_UnitMin=i+0
return i
endif
set i=i+1
endloop
return 0
endfunction
function ReturnUnitId takes integer id returns integer
local integer i=1
loop
if id==s__Units_id[sUnit[i]]then
return i
endif
set i=i+1
exitwhen i>=T_Unit
endloop
return 0
endfunction
