function Trig_TakeEnergy_Actions takes nothing returns nothing
local unit caster=GetSpellAbilityUnit()
local unit target=GetSpellTargetUnit()
local integer energy
local unit u3
local location p1=GetUnitLoc(caster)
local location p2=GetUnitLoc(target)
local texttag txt
local string s
local integer max_mana=R2I(GetUnitState(caster,UNIT_STATE_MAX_MANA))
set u3=CreateUnit(Player(11),'h01N',GetUnitX(target),GetUnitY(target),0.0)
call UnitApplyTimedLife(u3,'BTLF',2.0)
call IssueTargetOrder(u3,"thunderbolt",caster)
set energy=R2I(10*GetUnitLevel(caster)+0.4*GetUnitState(caster,UNIT_STATE_MANA))
if target !=caster then
set energy=energy+50*GetUnitLevel(target)
endif
set udg_EnergyWR=udg_EnergyWR+energy
if udg_EnergyWR>=max_mana then
set udg_EnergyWR=max_mana
endif
call SetUnitState(caster,UNIT_STATE_MANA,GetUnitState(caster,UNIT_STATE_MANA)-0.1*GetUnitState(caster,UNIT_STATE_MANA))
set s=("|cFFd10700+"+I2S(R2I(energy))+" ("+I2S(udg_EnergyWR)+")")
set txt=CreateTextTagUnitBJ(s,caster,0,10.00,100,100,100,0)
call SetTextTagVelocityBJ(txt,75.0,90.0)
call SetTextTagSuspendedBJ(txt,false)
call SetTextTagPermanentBJ(txt,false)
call SetTextTagLifespanBJ(txt,3.00)
call SetTextTagFadepointBJ(txt,2.00)
set caster=null
set target=null
set u3=null
call RemoveLocation(p1)
call RemoveLocation(p2)
set p1=null
set p2=null
endfunction
