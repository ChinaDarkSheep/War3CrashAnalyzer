function Trig_Engineer_Skills_W takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local unit tower=LoadUnitHandle(udg_hash,ht,1)
local real dmg=LoadReal(udg_hash,ht,2)
local integer i=LoadInteger(udg_hash,ht,3)
local real x=GetUnitX(tower)
local real y=GetUnitY(tower)
local group g=CreateGroup()
local unit u
local integer a=LoadInteger(Hash,GetHandleId(tower),0)
if UnitAlive(tower)then
set bj_lastCreatedEffect=LoadEffectHandle(udg_hash,ht,2)
call DestroyEffect(bj_lastCreatedEffect)
if i>0 then
call UnitRemoveAbility(tower,'A0UI')
set s__Units_AllDmg[sUnit[a]]=s__Units_AllDmg[sUnit[a]]-25000
call SetUnitState(tower,UNIT_STATE_LIFE,GetUnitState(tower,UNIT_STATE_LIFE)-0.3*GetUnitState(tower,UNIT_STATE_MAX_LIFE))
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\FragmentationShards\\FragBoomSpawn.mdl",tower,"origin")
call DestroyEffect(bj_lastCreatedEffect)
call GroupEnumUnitsInRange(g,x,y,300.,null)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)and IsUnitEnemy(u,GetOwningPlayer(caster))then
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
call GroupRemoveUnit(g,u)
endloop
else
call GroupEnumUnitsInRange(g,x,y,300.,null)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)and IsUnitEnemy(u,GetOwningPlayer(caster))then
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
call GroupRemoveUnit(g,u)
endloop
call KillUnit(tower)
endif
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
call DestroyGroup(g)
set t=null
set caster=null
set tower=null
set u=null
set g=null
endfunction
function Trig_Engineer_Skills_E takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit u=LoadUnitHandle(udg_hash,ht,0)
local integer i=LoadInteger(udg_hash,ht,1)
if UnitAlive(u)and i>0 then
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+0.01*GetUnitState(u,UNIT_STATE_MAX_LIFE))
set i=i-1
call SaveInteger(udg_hash,ht,1,i)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
set u=null
endfunction
function Trig_Engineer_Skills_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit zavod=LoadUnitHandle(udg_hash,ht,0)
local unit u
local integer i=LoadInteger(udg_hash,ht,1)
local unit caster=LoadUnitHandle(udg_hash,ht,2)
local real x
local real y
local real dmg
local real hp
if i>0 and UnitAlive(zavod)then
set i=i-1
call SaveInteger(udg_hash,ht,1,i)
set x=GetUnitX(zavod)
set y=GetUnitY(zavod)+50
set hp=10*(GetHeroStr(caster,true)+GetHeroInt(caster,true))+200*GetPlayerTechCount(GetOwningPlayer(caster),'R05M',true)
set dmg=GetHeroInt(caster,true)+20*GetPlayerTechCount(GetOwningPlayer(caster),'R05L',true)
set u=CreateUnit(GetOwningPlayer(caster),'ncg3',x,y,0)
call UnitAddAbility(u,'A17O')
call SetUnitAbilityLevel(u,'A17O',4)
call UnitAddAbility(u,'AInv')
call SummonStats(false,300,40,u,caster)
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitApplyTimedLife(u,'BTLF',10.)
call UnitRemoveAbility(u,'AInv')
set u=CreateUnit(GetOwningPlayer(caster),'ncg3',x,y,0)
call UnitAddAbility(u,'AInv')
call SummonStats(false,300,40,u,caster)
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'AInv')
call UnitApplyTimedLife(u,'BTLF',10.)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set caster=null
set zavod=null
set u=null
set t=null
endfunction
function F_Engineer_Tower takes unit caster,unit u returns nothing
local timer t
local real dmg=1.*GetHeroInt(caster,true)+20*GetPlayerTechCount(GetOwningPlayer(caster),'R05L',true)
local real hp=3*(GetHeroStr(caster,true)+GetHeroInt(caster,true))+200*GetPlayerTechCount(GetOwningPlayer(caster),'R05M',true)
local integer basehp=400*(GetUnitAbilityLevel(caster,'A1AZ')-1)
local integer basedmg=20*(GetUnitAbilityLevel(caster,'A1AZ')-1)
local integer i=SeekFreeUnitMin(GetHandleId(u))
local integer a
if GetUnitTypeId(u)=='nefm' then
set hp=1.2*hp
endif
if GetHeroLevel(caster)>=50 then
set dmg=dmg+GetHeroInt(caster,true)
set hp=hp+3*(GetHeroStr(caster,true)+GetHeroInt(caster,true))
endif
if GetUnitAbilityLevel(caster,'A1B0')>0 then
set a=GetRandomInt(1,5)
if a==1 then
call UnitAddAbility(caster,'A03E')
set t=CreateTimer()
call SaveUnitHandle(udg_hash,GetHandleId(t),0,u)
call TimerStart(t,1.,true,function Trig_Engineer_Skills_Q_Regen)
call SetUnitVertexColor(caster,255,175,175,255)
elseif a==2 then
set dmg=1.3*dmg
call SaveInteger(udg_hash,GetHandleId(u),StringHash("bonusF"),2)
call SetUnitVertexColor(caster,175,255,175,255)
elseif a==3 then
call SaveInteger(udg_hash,GetHandleId(u),StringHash("bonusF"),3)
call SetUnitVertexColor(caster,175,175,255,255)
elseif a==4 then
set s__Units_AllDmg[sUnit[i]]=s__Units_AllDmg[sUnit[i]]+2000
set s__Units_MageBlock[sUnit[i]]=s__Units_MageBlock[sUnit[i]]+2000
else
set hp=1.4*hp
call SaveInteger(udg_hash,GetHandleId(u),StringHash("bonusF"),5)
call SetUnitVertexColor(caster,255,255,175,255)
endif
endif
call UnitAddAbility(u,'AInv')
call SummonStats(false,basehp,basedmg,u,caster)
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'AInv')
set t=null
endfunction
function Trig_Engineer_Skills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer h=GetHandleId(caster)
local unit u
local unit u1
local unit u2
local unit u3
local real x
local real y
local real dmg
local real hp
local real r
local timer t
local integer ht
local integer i
local integer a
local integer hu
local integer unitype
if GetSpellAbilityId()=='A1AX' then
set u=LoadUnitHandle(udg_hash,GetHandleId(caster),'d')
if UnitAlive(u)then
call KillUnit(u)
endif
set hp=10*(GetHeroStr(caster,true)+GetHeroInt(caster,true))+200*GetPlayerTechCount(GetOwningPlayer(caster),'R05M',true)
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set u=CreateUnit(GetOwningPlayer(caster),'nef2',x,y,bj_UNIT_FACING)
call SetUnitPosition(u,x,y)
call SaveUnitHandle(udg_hash,GetHandleId(caster),'d',u)
call UnitAddAbility(u,'A0SF')
call UnitAddAbility(u,'A0SE')
call SetUnitAbilityLevel(u,'A0SF',2)
call SetUnitAbilityLevel(u,'A0SE',2)
call UnitAddAbility(u,'AInv')
call SummonStats(true,R2I(hp),0,u,caster)
call UnitRemoveAbility(u,'AInv')
endif
if GetSpellAbilityId()=='A1B6' then
set x=GetUnitX(caster)+175*Cos(GetUnitFacing(caster)*bj_DEGTORAD)
set y=GetUnitY(caster)+175*Sin(GetUnitFacing(caster)*bj_DEGTORAD)
set hp=10*(GetHeroStr(caster,true)+GetHeroInt(caster,true))+200*GetPlayerTechCount(GetOwningPlayer(caster),'R05M',true)
set dmg=GetHeroInt(caster,true)+20*GetPlayerTechCount(GetOwningPlayer(caster),'R05L',true)
set u=CreateUnit(GetOwningPlayer(caster),'ncg3',x,y,0)
call UnitAddAbility(u,'AInv')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'AInv')
call UnitApplyTimedLife(u,'BTLF',20.)
set u=CreateUnit(GetOwningPlayer(caster),'ncg3',x,y,0)
call UnitAddAbility(u,'AInv')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'AInv')
call UnitApplyTimedLife(u,'BTLF',20.)
endif
if GetSpellAbilityId()=='A1B4' then
set u=GetSpellTargetUnit()
set dmg=3.*GetHeroInt(caster,true)+0.2*GetUnitState(u,UNIT_STATE_MAX_LIFE)
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+dmg)
endif
if GetSpellAbilityId()=='A1B5' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set u=CreateUnit(GetOwningPlayer(caster),'nefm',x,y,bj_UNIT_FACING)
call SeekMinUnit()
call F_Engineer_Tower(caster,u)
call UnitApplyTimedLife(u,'Bhwd',20.)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call TimerStart(t,20.,false,function Trig_Engineer_TowerD)
endif
if GetSpellAbilityId()=='A1AZ' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set i=GetRandomInt(1,4)
if i==1 then
set unitype='nefm'
else
if i==2 then
set unitype='nef0'
else
if i==3 then
set unitype='nef1'
else
set unitype='nef4'
endif
endif
endif
set u=CreateUnit(GetOwningPlayer(caster),unitype,x,y,bj_UNIT_FACING)
set hu=GetHandleId(u)
if i==3 then
call UnitAddAbility(u,'A095')
elseif i==4 then
call UnitAddAbility(u,'A0UJ')
call UnitAddAbility(u,'A02U')
endif
call F_Engineer_Tower(caster,u)
set u1=LoadUnitHandle(udg_hash,h,StringHash("Tower1"))
set u2=LoadUnitHandle(udg_hash,h,StringHash("Tower2"))
set u3=LoadUnitHandle(udg_hash,h,StringHash("Tower3"))
if u1==u2 then
set u2=null
endif
if u1==u3 then
set u3=null
endif
if u2==u3 then
set u3=null
endif
if UnitAlive(u1)then
if UnitAlive(u2)then
if UnitAlive(u3)then
call KillUnit(u1)
call SaveUnitHandle(udg_hash,h,StringHash("Tower1"),u2)
call SaveUnitHandle(udg_hash,h,StringHash("Tower2"),u3)
call SaveUnitHandle(udg_hash,h,StringHash("Tower3"),u)
else
call SaveUnitHandle(udg_hash,h,StringHash("Tower3"),u)
endif
else
call SaveUnitHandle(udg_hash,h,StringHash("Tower2"),u)
endif
else
call SaveUnitHandle(udg_hash,h,StringHash("Tower1"),u)
if UnitAlive(u3)and not(UnitAlive(u2))then
call SaveUnitHandle(udg_hash,h,StringHash("Tower2"),u3)
call SaveUnitHandle(udg_hash,h,StringHash("Tower3"),null)
endif
endif
call UnitAddAbility(u,'A140')
endif
if GetSpellAbilityId()=='A1B2' then
set u=GetSpellTargetUnit()
set hu=GetHandleId(u)
set a=LoadInteger(Hash,hu,0)
if a==0 then
set a=SeekFreeUnit(hu)
endif
if GetUnitAbilityLevel(caster,'A1B0')>0 then
set s__Units_AllDmg[sUnit[a]]=s__Units_AllDmg[sUnit[a]]+25000
else
set s__Units_AllDmg[sUnit[a]]=s__Units_AllDmg[sUnit[a]]+20000
endif
call UnitAddAbility(u,'A0UI')
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Items\\VampiricPotion\\VampPotionCaster.mdl",u,"origin")
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveUnitHandle(udg_hash,ht,1,u)
call SaveEffectHandle(udg_hash,ht,2,bj_lastCreatedEffect)
call SaveReal(udg_hash,ht,2,150*GetUnitAbilityLevel(caster,'A1B2')+2.*GetHeroInt(caster,true))
call SaveInteger(udg_hash,ht,3,GetUnitAbilityLevel(caster,'A1B0'))
call TimerStart(t,12.,false,function Trig_Engineer_Skills_W)
endif
if GetSpellAbilityId()=='A1B3' then
set u=GetSpellTargetUnit()
set dmg=150*GetUnitAbilityLevel(caster,'A1B3')+4.*GetHeroInt(caster,true)
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+dmg)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call SaveInteger(udg_hash,ht,1,10)
call TimerStart(t,1.,true,function Trig_Engineer_Skills_E)
endif
if GetSpellAbilityId()=='A1AY' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set hp=20*(GetHeroStr(caster,true)+GetHeroInt(caster,true))+200*GetPlayerTechCount(GetOwningPlayer(caster),'R05M',true)
set u=CreateUnit(GetOwningPlayer(caster),'nef3',x,y,bj_UNIT_FACING)
call UnitAddAbility(u,'AInv')
call SummonStats(true,R2I(hp),0,u,caster)
call UnitRemoveAbility(u,'AInv')
call UnitApplyTimedLife(u,'Bhwd',20.)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call SaveInteger(udg_hash,ht,1,6)
call SaveUnitHandle(udg_hash,ht,2,caster)
call TimerStart(t,3.,true,function Trig_Engineer_Skills_R)
endif
set caster=null
set u=null
set u1=null
set u2=null
set u3=null
set t=null
endfunction
function InitTrig_Engineer_Skills takes nothing returns nothing
set gg_trg_Engineer_Skills=CreateTrigger()
call TriggerAddAction(gg_trg_Engineer_Skills,function Trig_Engineer_Skills_Actions)
endfunction
function Mammoth_W takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(hero)
local integer tic=LoadInteger(udg_hash,ht,1)
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local real x=GetUnitX(hero)
local real y=GetUnitY(hero)
local real dmg=GetUnitAbilityLevel(hero,'A1EL')*40+0.4*GetHeroStr(hero,true)
local real hp=GetUnitAbilityLevel(hero,'A1EL')*40
local unit u
local group g=CreateGroup()
local integer iuh=LoadInteger(Hash,h,0)
if tic>0 and UnitAlive(hero)then
call SetUnitAnimation(hero,"spell puke")
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Taunt\\TauntCaster.mdl",hero,"origin"))
set tic=tic-1
call SaveInteger(udg_hash,ht,1,tic)
if udg_Talante[ID]==1 then
set dmg=dmg+0.03*GetUnitState(hero,UNIT_STATE_MAX_LIFE)
if GetHeroLevel(hero)>49 then
set dmg=dmg+2*(0.2*GetHeroAgi(hero,true)+s__Units_Arm[sUnit[iuh]]+LoadInteger(udg_hash,h,StringHash("BaseArmore")))
endif
elseif udg_Talante[ID]==2 then
if GetHeroLevel(hero)>49 then
set dmg=dmg+0.5*Summ_Attack(hero)
else
set dmg=dmg+0.25*Summ_Attack(hero)
endif
endif
call GroupEnumUnitsInRange(g,x,y,600,null)
if udg_Talante[ID]==1 then
call Heal(true,hp+0.06*GetUnitState(hero,UNIT_STATE_MAX_LIFE),hero,hero)
else
call Heal(true,hp+0.03*GetUnitState(hero,UNIT_STATE_MAX_LIFE),hero,hero)
endif
call GroupRemoveUnit(g,hero)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)then
if IsUnitEnemy(u,Player(ID-1))then
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
elseif udg_Talante[ID]==3 and IsUnitAlly(u,Player(ID-1))then
if IsUnitType(u,UNIT_TYPE_HERO)then
call Heal(true,hp+0.06*GetUnitState(u,UNIT_STATE_MAX_LIFE),u,hero)
else
call Heal(true,hp+0.03*GetUnitState(u,UNIT_STATE_MAX_LIFE),u,hero)
endif
endif
endif
call GroupRemoveUnit(g,u)
endloop
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
call DestroyGroup(g)
set g=null
set hero=null
set u=null
set t=null
endfunction
function Mammoth_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(hero)
local integer talante=LoadInteger(udg_hash,ht,1)
local integer i=LoadInteger(Hash,h,0)
if talante==1 then
set s__Units_AllBlock[sUnit[i]]=s__Units_AllBlock[sUnit[i]]-3000
elseif talante==2 then
set s__Units_AllDmg[sUnit[i]]=s__Units_AllDmg[sUnit[i]]-3000
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set hero=null
set t=null
endfunction
function mammoth_skills takes nothing returns nothing
local unit hero=GetTriggerUnit()
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local integer h=GetHandleId(hero)
local integer ihh=LoadInteger(udg_hash,h,5)
local unit u
local real x
local real y
local real dmg
local real hp
local real r
local timer t
local integer ht
local integer a
local group g=CreateGroup()
local integer i
if GetSpellAbilityId()=='A1EK' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set dmg=GetUnitAbilityLevel(hero,'A1EK')*200
if udg_Talante[ID]==1 then
call Immortal(hero,1.75)
elseif udg_Talante[ID]==2 then
set dmg=dmg+Summ_Attack(hero)
else
set dmg=dmg+2*GetHeroStr(hero,true)
endif
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,275,Condition(function Trig_Filter_ID))
set a=0
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
if not UnitAlive(u)then
set a=1
endif
call GroupRemoveUnit(g,u)
endloop
if a==1 then
call SetHeroStr(hero,GetHeroStr(hero,false)+1,true)
if udg_Talante[ID]==2 then
call SummonStats(false,0,1,hero,hero)
endif
endif
if udg_Talante[ID]==3 then
set r=PositiveDuration(hero,8.)
set hp=GetUnitAbilityLevel(hero,'A1EK')*100+2*GetHeroStr(hero,true)
set a=GetUnitAbilityLevel(hero,'A1EK')*40+GetHeroStr(hero,true)
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,275,Bool_Filter_ID_Ally)
call GroupRemoveUnit(g,hero)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitType(u,UNIT_TYPE_HERO)then
call Heal(true,hp,u,hero)
call TempStats(u,0,0,0,a,0,0,r)
endif
call GroupRemoveUnit(g,u)
endloop
endif
elseif GetSpellAbilityId()=='A1EL' then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveInteger(udg_hash,ht,1,5)
call TimerStart(t,1,true,function Mammoth_W)
elseif GetSpellAbilityId()=='A1EM' then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveInteger(udg_hash,ht,1,12)
call TimerStart(t,1,true,function Mammoth_W)
if udg_Talante[ID]==1 or udg_Talante[ID]==2 then
set i=LoadInteger(Hash,h,0)
if udg_Talante[ID]==1 then
set s__Units_AllBlock[sUnit[i]]=s__Units_AllBlock[sUnit[i]]+3000
elseif udg_Talante[ID]==2 then
set s__Units_AllDmg[sUnit[i]]=s__Units_AllDmg[sUnit[i]]+3000
endif
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveInteger(udg_hash,ht,1,udg_Talante[ID])
call TimerStart(t,PositiveDuration(hero,16),false,function Mammoth_R)
elseif udg_Talante[ID]==3 then
set x=GetUnitX(hero)
set y=GetUnitY(hero)
set a=100+GetHeroStr(hero,false)+(GetHeroStr(hero,true)-GetHeroStr(hero,false)-s__Heroes_TempStr[sHero[ihh]])/2
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,500.,Bool_Filter_ID_Ally)
call GroupRemoveUnit(g,hero)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitType(u,UNIT_TYPE_HERO)then
call HighStat(u,a,PositiveDuration(hero,20))
endif
call GroupRemoveUnit(g,u)
endloop
endif
endif
call DestroyGroup(g)
set g=null
set hero=null
set u=null
set t=null
endfunction
function InitTrig_Mammoth_Skills takes nothing returns nothing
set gg_trg_Mammoth_Skills=CreateTrigger()
call TriggerAddAction(gg_trg_Mammoth_Skills,function mammoth_skills)
endfunction
function HeroQ53_conditions takes nothing returns boolean
return GetSpellAbilityId()=='A1CW'
endfunction
function HeroQ53_Move takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer Id=GetHandleId(t)
local group l__ug=LoadGroupHandle(udg_hash,Id,1)
local group ug2=CreateGroup()
local integer count=LoadInteger(udg_hash,Id,1)
local unit u3
local real x=LoadReal(udg_hash,Id,2)
local real y=LoadReal(udg_hash,Id,3)
local real ux
local real uy
local real angle
call GroupAddGroup(l__ug,ug2)
loop
set u3=FirstOfGroup(ug2)
exitwhen u3==null
set ux=GetUnitX(u3)
set uy=GetUnitY(u3)
set angle=Atan2(y-uy,x-ux)
if IsUnitType(u3,UNIT_TYPE_HERO)then
call SetUnitX(u3,ux+10.*Cos(angle))
call SetUnitY(u3,uy+10.*Sin(angle))
else
call SetUnitX(u3,ux+15.*Cos(angle))
call SetUnitY(u3,uy+15.*Sin(angle))
endif
call GroupRemoveUnit(ug2,u3)
endloop
call DestroyGroup(ug2)
set count=count-1
if count>0 then
call SaveInteger(udg_hash,Id,1,count)
else
call FlushChildHashtable(udg_hash,Id)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(l__ug)
endif
set t=null
set u3=null
set l__ug=null
set ug2=null
endfunction
function HeroQ53_EndDebuff takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer Id=GetHandleId(t)
local group l__ug=LoadGroupHandle(udg_hash,Id,1)
local unit u3
loop
set u3=FirstOfGroup(l__ug)
exitwhen u3==null
call UnitRemoveAbility(u3,'A1D3')
call UnitRemoveAbility(u3,'S009')
call GroupRemoveUnit(l__ug,u3)
endloop
call DestroyGroup(l__ug)
call FlushChildHashtable(udg_hash,Id)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
set u3=null
set l__ug=null
endfunction
function Trig_HeroQ53_Actions takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local unit u2
local unit u3
local player pl=GetOwningPlayer(u)
local integer int=GetHeroInt(u,true)
local integer Skill='A1CW'
local integer lvl=GetUnitAbilityLevel(u,Skill)
local real dmg=150*lvl+4.*int
local location p=GetSpellTargetLoc()
local real x=GetLocationX(p)
local real y=GetLocationY(p)
local group l__ug=CreateGroup()
local group ug2=CreateGroup()
local group ug_effect=CreateGroup()
local timer t=CreateTimer()
local timer t2=CreateTimer()
local integer Id=GetHandleId(t)
local integer Id2=GetHandleId(t2)
local real aoe=260
if GetUnitAbilityLevel(u,'A1D0')==1 then
set dmg=dmg+2.*int
endif
set u2=CreateUnit(pl,'h050',x,y,270)
call UnitApplyTimedLife(u2,'BTLF',2)
call GroupEnumUnitsInRange(l__ug,x,y,aoe,null)
loop
set u3=FirstOfGroup(l__ug)
exitwhen u3==null
if UnitAlive(u3)and IsUnitEnemy(u3,pl)==true then
call UnitDamageTarget(u,u3,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
if IsUnitType(u3,UNIT_TYPE_STRUCTURE)==false and UnitAlive(u3)then
call GroupAddUnit(ug_effect,u3)
call GroupAddUnit(ug2,u3)
call UnitAddAbility(u3,'A1D3')
call UnitAddAbility(u3,'S009')
call SetUnitAbilityLevel(u3,'A1D3',lvl)
endif
endif
call GroupRemoveUnit(l__ug,u3)
endloop
call DestroyGroup(l__ug)
if GetUnitAbilityLevel(u,'A1D0')==1 then
call SaveInteger(udg_hash,Id,1,18)
call TimerStart(t2,6,true,function HeroQ53_EndDebuff)
else
call SaveInteger(udg_hash,Id,1,15)
call TimerStart(t2,3,true,function HeroQ53_EndDebuff)
endif
call TimerStart(t,0.04,true,function HeroQ53_Move)
call SaveGroupHandle(udg_hash,Id,1,ug2)
call SaveGroupHandle(udg_hash,Id2,1,ug_effect)
call SaveReal(udg_hash,Id,2,x)
call SaveReal(udg_hash,Id,3,y)
call RemoveLocation(p)
set p=null
set u=null
set u2=null
set u3=null
set pl=null
set l__ug=null
set ug2=null
set t=null
set t2=null
endfunction
function InitTrig_HeroQ53 takes nothing returns nothing
set gg_trg_HeroQ53=CreateTrigger()
call TriggerAddCondition(gg_trg_HeroQ53,Condition(function HeroQ53_conditions))
call TriggerAddAction(gg_trg_HeroQ53,function Trig_HeroQ53_Actions)
endfunction
function HeroW53_conditions takes nothing returns boolean
return GetSpellAbilityId()=='A1CX'
endfunction
function HeroW53_Dmg takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer Id=GetHandleId(t)
local unit u=LoadUnitHandle(udg_hash,Id,1)
local unit u3
local player pl=GetOwningPlayer(u)
local integer lvl=GetUnitAbilityLevel(u,'A1CX')
local real Int=I2R(GetHeroInt(u,true))
local real x=LoadReal(udg_hash,Id,1)
local real y=LoadReal(udg_hash,Id,2)
local real x2
local real y2
local group l__ug=CreateGroup()
local real L=0
local real dmg_cof=LoadReal(udg_hash,Id,3)
local real dmg=(110*I2R(lvl)+Int*1.10)*dmg_cof
local real aoe=250
if R2I(dmg_cof*100)==100 or R2I(dmg_cof*100)==220 then
call DestroyEffect(AddSpecialEffect("war3mapImported\\Flamestrike Starfire I.mdx",x,y))
set udg_Drop2=GetPlayerId(GetOwningPlayer(u))
call GroupEnumUnitsInRange(l__ug,x,y,aoe,Bool_Filter_ID)
loop
set u3=FirstOfGroup(l__ug)
exitwhen u3==null
call UnitDamageTarget(u,u3,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
call GroupRemoveUnit(l__ug,u3)
endloop
elseif R2I(dmg_cof*100)==130 or R2I(dmg_cof*100)==190 then
loop
set L=L+60
exitwhen L>360
set x2=x+300*Cos(L*bj_DEGTORAD)
set y2=y+300*Sin(L*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("war3mapImported\\Flamestrike Starfire I.mdx",x2,y2))
set udg_Drop2=GetPlayerId(GetOwningPlayer(u))
call GroupEnumUnitsInRange(l__ug,x2,y2,aoe,Bool_Filter_ID)
loop
set u3=FirstOfGroup(l__ug)
exitwhen u3==null
call UnitDamageTarget(u,u3,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
call GroupRemoveUnit(l__ug,u3)
endloop
endloop
elseif R2I(dmg_cof*100)==1.60 then
loop
set L=L+36
exitwhen L>360
set x2=x+600*Cos(L*bj_DEGTORAD)
set y2=y+600*Sin(L*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("war3mapImported\\Flamestrike Starfire I.mdx",x2,y2))
set udg_Drop2=GetPlayerId(GetOwningPlayer(u))
call GroupEnumUnitsInRange(l__ug,x2,y2,aoe,Bool_Filter_ID)
loop
set u3=FirstOfGroup(l__ug)
exitwhen u3==null
call UnitDamageTarget(u,u3,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
call GroupRemoveUnit(l__ug,u3)
endloop
endloop
endif
set dmg_cof=dmg_cof+0.30
call SaveReal(udg_hash,Id,3,dmg_cof)
call DestroyGroup(l__ug)
set l__ug=null
set t=null
set u=null
set u3=null
set pl=null
endfunction
function HeroW53_Dmg2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer Id=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,Id,1)
local integer h=GetHandleId(caster)
local unit u2
local unit u3
local player pl=GetOwningPlayer(caster)
local integer n=GetPlayerId(pl)+1
local integer lvl=GetUnitAbilityLevel(caster,'A1CX')
local real x=LoadReal(udg_hash,Id,1)
local real y=LoadReal(udg_hash,Id,2)
local group g=CreateGroup()
local integer iuu=LoadInteger(Hash,h,0)
local real dmg=0.3*(100*lvl+3.*GetHeroInt(caster,true))*(0.01*I2R(s__Units_MageDamage[sUnit[iuu]]/100))
local real dmg2=0.3*(10*lvl+.2*GetHeroInt(caster,true))
local real life=GetUnitState(caster,UNIT_STATE_LIFE)
local real heal=0
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,710,Bool_Filter_ID)
call RandomUnitFromGroup(3,g)
loop
set u3=FirstOfGroup(g)
exitwhen u3==null
call UnitDamageTarget(caster,u3,dmg,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_WHOKNOWS)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl",u3,"origin"))
set heal=heal+1
if UnitAlive(u3)then
set x=GetUnitX(u3)
set y=GetUnitY(u3)
set u2=CreateUnit(pl,'h009',x,y,0)
call UnitAddAbility(u2,'Apg2')
call UnitApplyTimedLife(u2,'BTLF',2)
call IssueTargetOrder(u2,"purge",u3)
endif
call GroupRemoveUnit(g,u3)
endloop
if heal>10 then
set heal=10
endif
set heal=heal*dmg2
call SetUnitState(caster,UNIT_STATE_LIFE,life+heal)
call DestroyGroup(g)
set g=null
set t=null
set caster=null
set u2=null
set u3=null
set pl=null
endfunction
function Trig_HeroW53_Actions takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local player pl=GetOwningPlayer(u)
local timer t=CreateTimer()
local timer t2=CreateTimer()
