return(GetOwningPlayer(GetFilterUnit())==Player(11))
endfunction
function Trig_MefistoDeath_Func001Func011A takes nothing returns nothing
call SetUnitPositionLoc(GetEnumUnit(),GetUnitLoc(GetDyingUnit()))
endfunction
function Trig_MefistoDeath_Func001C takes nothing returns boolean
if(not(GetDyingUnit()==udg_Mefisto))then
return false
endif
return true
endfunction
function Trig_MefistoDeath_Actions takes nothing returns nothing
if(Trig_MefistoDeath_Func001C())then
call DestroyTrigger(gg_trg_MefistoSummons)
call DestroyTrigger(gg_trg_MefistoSkills)
call DestroyTrigger(gg_trg_MefistoExplosions)
set udg_ug=GetUnitsInRectMatching(GetEntireMapRect(),Condition(function Trig_MefistoDeath_Func001Func004002002))
call ForGroupBJ(udg_ug,function Trig_MefistoDeath_Func001Func005A)
call DestroyGroup(udg_ug)
set udg_ug=GetUnitsInRectMatching(GetEntireMapRect(),Condition(function Trig_MefistoDeath_Func001Func007002002))
call ForGroupBJ(udg_ug,function Trig_MefistoDeath_Func001Func008A)
call DestroyGroup(udg_ug)
set udg_ug=GetUnitsInRectMatching(GetEntireMapRect(),Condition(function Trig_MefistoDeath_Func001Func010002002))
call ForGroupBJ(udg_ug,function Trig_MefistoDeath_Func001Func011A)
call DestroyGroup(udg_ug)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=8
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call SetPlayerAllianceBJ(Player(8),ALLIANCE_SHARED_VISION,true,ConvertedPlayer(GetForLoopIndexA()))
call SetPlayerAllianceBJ(Player(10),ALLIANCE_SHARED_VISION,true,ConvertedPlayer(GetForLoopIndexA()))
call SetPlayerAllianceBJ(Player(11),ALLIANCE_SHARED_VISION,true,ConvertedPlayer(GetForLoopIndexA()))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call EnableTrigger(gg_trg_WinEnd)
call DisableTrigger(GetTriggeringTrigger())
else
endif
endfunction
function InitTrig_MefistoDeath takes nothing returns nothing
set gg_trg_MefistoDeath=CreateTrigger()
call DisableTrigger(gg_trg_MefistoDeath)
