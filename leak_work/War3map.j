function Trig_Iss1_Actions takes nothing returns nothing
local unit u
local integer ID=(GetPlayerId(GetOwningPlayer(GetKillingUnit()))+1)
local group g=CreateGroup()
local real x
local real y
local boolean havHero=true
call GroupEnumUnitsInRect(g,gg_rct_Isp1,null)
if IsUnitInGroup(GetDyingUnit(),g)then
if udg_Hero[ID]!=null then
if(IsUnitInGroup(udg_Hero[ID],g)or GetUnitTypeId(GetKillingUnit())=='e009' or HeroInUnits[ID-1])then
else
set havHero=false
endif
else
set havHero=false
endif
if havHero then
set udg_Iss1[ID]=udg_Iss1[ID]+1
if udg_Iss1[ID]==5 then
set x=GetRandomReal(GetRectMinX(gg_rct_IspWin),GetRectMaxX(gg_rct_IspWin))
set y=GetRandomReal(GetRectMinY(gg_rct_IspWin),GetRectMaxY(gg_rct_IspWin))
call SetUnitPosition(udg_Hero[ID],x,y)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
call PanCameraToTimedForPlayer(Player(ID-1),x,y,0)
call SetHeroStr(udg_Hero[ID],GetHeroStr(udg_Hero[ID],false)+8,true)
call GroupRemoveUnit(g,udg_Hero[ID])
set udg_Iss1[ID]=udg_Iss1[ID]+1
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"|cFF00C850Испытание пройдено! +8 силы.")
loop
set u=FirstOfGroup(g)
exitwhen u==null
if GetOwningPlayer(u)==Player(ID-1)then
set x=GetRandomReal(GetRectMinX(gg_rct_IspWin),GetRectMaxX(gg_rct_IspWin))
set y=GetRandomReal(GetRectMinY(gg_rct_IspWin),GetRectMaxY(gg_rct_IspWin))
call SetUnitPosition(u,x,y)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
endif
call GroupRemoveUnit(g,u)
endloop
if udg_Hero[ID]!=null then
set udg_Sphere[ID]=udg_Sphere[ID]+1
if udg_Sphere[ID]==9 then
set QuestsNT[ID]=QuestsNT[ID]+1
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,"|cFF52EDF1Игрок|r |cFFFFDC00"+GetPlayerName(Player(ID-1))+"|r |cFF52EDF1прошёл все 9 испытаний и получает +500 HP и предмет \"Кристаллизованная сфера\"!")
call UnitAddItemByIdSwapped('I05O',udg_Hero[ID])
call UnitAddItemByIdSwapped('I04V',udg_Hero[ID])
endif
call SelectUnitForPlayerSingle(udg_Hero[ID],GetOwningPlayer(udg_Hero[ID]))
endif
elseif udg_Iss1[ID]>5 then
set u=GetKillingUnit()
set x=GetRandomReal(GetRectMinX(gg_rct_StartPlace),GetRectMaxX(gg_rct_StartPlace))
set y=GetRandomReal(GetRectMinY(gg_rct_StartPlace),GetRectMaxY(gg_rct_StartPlace))
call SetUnitPosition(u,x,y)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
endif
else
set u=GetKillingUnit()
set x=GetRandomReal(GetRectMinX(gg_rct_StartPlace),GetRectMaxX(gg_rct_StartPlace))
set y=GetRandomReal(GetRectMinY(gg_rct_StartPlace),GetRectMaxY(gg_rct_StartPlace))
call SetUnitPosition(u,x,y)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
call FHelpText(ID-1,"|cFFFF0000Ваш герой не был найден в зоне испытания, убийство не засчитано.",15.)
endif
endif
call DestroyGroup(g)
set g=null
set u=null
endfunction
