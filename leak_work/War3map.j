call SetPlayerAbilityAvailable(Player(i),'A1C9',false)
call SetPlayerAbilityAvailable(Player(i),'A1CC',false)
call SetPlayerAbilityAvailable(Player(i),'A16M',false)
set udg_HeroResTime[i+1]=50.
set udg_PN=udg_PN+1
call ForceAddPlayerSimple(Player(i),udg_Quests2[1])
set S_Player[i]=s__Struct_Player__allocate()
set s___Struct_Player_UnLockHero[s__Struct_Player_UnLockHero[S_Player[i]]]=false
set s___Struct_Player_UnLockHero[s__Struct_Player_UnLockHero[S_Player[i]]+1]=false
set s___Struct_Player_UnLockHero[s__Struct_Player_UnLockHero[S_Player[i]]+2]=false
set s___Struct_Player_UnLockHero[s__Struct_Player_UnLockHero[S_Player[i]]+3]=false
set s___Struct_Player_UnLockHero[s__Struct_Player_UnLockHero[S_Player[i]]+4]=false
if Pname[i+1]=="Smurfik333" or Pname[i+1]=="777veiron" then
call SetPlayerTechMaxAllowed(Player(i),'E00Z',1)
call SetPlayerTechMaxAllowed(Player(i),'O012',1)
call SetPlayerTechMaxAllowed(Player(i),'E011',1)
call SetPlayerTechMaxAllowed(Player(i),'U02J',1)
call SetPlayerTechMaxAllowed(Player(i),'O013',1)
set s___Struct_Player_UnLockHero[s__Struct_Player_UnLockHero[S_Player[i]]]=true
set s___Struct_Player_UnLockHero[s__Struct_Player_UnLockHero[S_Player[i]]+1]=true
set s___Struct_Player_UnLockHero[s__Struct_Player_UnLockHero[S_Player[i]]+2]=true
set s___Struct_Player_UnLockHero[s__Struct_Player_UnLockHero[S_Player[i]]+3]=true
elseif Pname[i+1]=="rootik_1" then
call SetPlayerTechMaxAllowed(Player(i),'E00Z',1)
set s___Struct_Player_UnLockHero[s__Struct_Player_UnLockHero[S_Player[i]]]=true
elseif Pname[i+1]=="6_logi_6" then
set s___Struct_Player_UnLockHero[s__Struct_Player_UnLockHero[S_Player[i]]+4]=true
call SetPlayerTechMaxAllowed(Player(i),'O013',1)
endif
else
call GroupEnumUnitsOfPlayer(g,Player(i),null)
call ForGroup(g,function Trig_RemoveGroupUnit)
call GroupClear(g)
endif
set i=i+1
endloop
if udg_PN<=1 then
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,120.00,"В одиночной игре команда -save отключена")
call EnableTrigger(gg_trg_Sheat)
call DestroyTrigger(gg_trg_INICSL)
call DestroyTrigger(gg_trg_hellset)
call DestroyTrigger(gg_trg_ISOV)
endif
set i=0
loop
exitwhen i>11
call SetPlayerAbilityAvailable(Player(i),'A1EB',false)
set s__HelpText[i]=true
set PlayerPickHero[i]=false
set HeroInUnits[i]=false
set KStr[i]=0
set KAgi[i]=0
set KInt[i]=0
