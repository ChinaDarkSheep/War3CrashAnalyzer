function StatsSend takes string msg returns nothing
set udg_StatsMsgId=udg_StatsMsgId+1
call StoreInteger(udg_StatsGC,"val:"+I2S(udg_StatsMsgId),msg,1)
call SyncStoredInteger(udg_StatsGC,"val:"+I2S(udg_StatsMsgId),msg)
call StoreInteger(udg_StatsGC,"chk:"+I2S(udg_StatsMsgId),I2S(udg_StatsMsgId),1)
