function Trig_Timer5min_Func001Func004C takes nothing returns boolean
if(not(udg_Drop==0))then
return false
endif
return true
endfunction
function Trig_Timer5min_Func001C takes nothing returns boolean
if(not(udg_Mode==2))then
return false
endif
return true
endfunction
function Trig_Timer5min_Func004C takes nothing returns boolean
if(not(udg_Minutes==20))then
return false
endif
return true
endfunction
function Trig_Timer5min_Func005C takes nothing returns boolean
if(not(udg_Minutes>=30))then
return false
endif
return true
endfunction
function Trig_Timer5min_Actions takes nothing returns nothing
if(Trig_Timer5min_Func001C())then
call SetPlayerTechResearchedSwap('R01V',(GetPlayerTechCountSimple('R01V',Player(PLAYER_NEUTRAL_AGGRESSIVE))+2),Player(PLAYER_NEUTRAL_AGGRESSIVE))
set udg_Drop=ModuloInteger(GetPlayerTechCountSimple('R056',Player(bj_PLAYER_NEUTRAL_VICTIM)),2)
if(Trig_Timer5min_Func001Func004C())then
call SetPlayerTechResearchedSwap('R056',(GetPlayerTechCountSimple('R056',Player(PLAYER_NEUTRAL_AGGRESSIVE))+1),Player(PLAYER_NEUTRAL_AGGRESSIVE))
else
endif
else
endif
set udg_CountAttackers=(udg_CountAttackers+1)
set udg_Minutes=(udg_Minutes+5)
if(Trig_Timer5min_Func004C())then
set udg_after20min=true
else
endif
if(Trig_Timer5min_Func005C())then
set udg_after20min=false
else
endif
endfunction
