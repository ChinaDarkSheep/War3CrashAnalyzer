set s__QuestGoblinText[0]="|cFF00C850Начальное задание [3/4]: Аномалия|r\n"
set s__QuestGoblinText[1]="Слушай, мой прибор засек какую-то странную аномалию, которая находится чуть южнее города. Иди и разберись с ней, взамен я дам тебе что-нибудь"
set s__QuestGoblinText[2]="|cFFFFDC00Награда успевшему игроку: предмет \"Костюм путешественника\" + доступ к заданиям \"Поиск оружия\"|r"
