function Trig_Reptiloid_Q2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer tic=LoadInteger(udg_hash,ht,0)
local unit target=LoadUnitHandle(udg_hash,ht,1)
local group ge=LoadGroupHandle(udg_hash,GetHandleId(caster),'e')
local unit u
local real x=GetUnitX(target)
local real y=GetUnitY(target)
local real dmg
local group g=CreateGroup()
local integer h=GetHandleId(caster)
local real de
if tic !=0 then
if GetHeroLevel(caster)>=50 then
set de=1.6
else
set de=1.3
endif
set dmg=40*GetUnitAbilityLevel(caster,'A00G')+0.5*GetHeroInt(caster,true)
if tic==1 then
set dmg=2*dmg
set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\Stormfall.mdx",x,y)
call DestroyEffect(bj_lastCreatedEffect)
set u=CreateUnit(GetOwningPlayer(caster),'h009',x,y,0)
call UnitAddAbility(u,'Awrg')
call SetUnitAbilityLevel(u,'Awrg',8)
call IssueImmediateOrder(u,"stomp")
call UnitApplyTimedLife(u,'BTLF',1.5)
else
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
endif
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,275,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitInGroup(u,ge)then
call UnitDamageTarget(caster,u,de*dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
else
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
call GroupRemoveUnit(g,u)
endloop
set tic=tic-1
call SaveInteger(udg_hash,ht,0,tic)
else
call SaveUnitHandle(udg_hash,h,'q',null)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
call DestroyGroup(g)
set t=null
set caster=null
set target=null
set u=null
set g=null
set ge=null
endfunction
