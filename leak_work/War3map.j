function RandomEvent takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer sec=LoadInteger(udg_hash,ht,0)+1
call SaveInteger(udg_hash,ht,0,sec)
if sec<1411 then
if sec==630 then
call TriggerExecute(gg_trg_SmallEvent2)
if udg_Mode==2 then
call SetPlayerHandicapBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE),125.00)
else
call SetPlayerHandicapBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE),110.00)
endif
elseif sec==780 then
call FHelpText(111,"|cFF00C850Все хорошие предметы можно получить путём синтеза в преобразователях или путём убийства боссов.",30)
elseif sec==855 then
call FHelpText(111,"|cFF00C850Вы можете пролистывать таблицу с помощью стрелок \"вправо\" и \"влево\".",30)
elseif sec==930 then
if udg_Mode==2 then
call SetPlayerHandicapBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE),130.00)
else
call SetPlayerHandicapBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE),115.00)
endif
call TriggerExecute(gg_trg_Event1)
elseif sec==1230 then
if udg_Mode==2 then
call SetPlayerHandicapBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE),135.00)
else
call SetPlayerHandicapBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE),120.00)
endif
call FHelpText(111,"|cFF00C850Красный игрок может сам выбрать, какие именно нападающие будут атаковать. Чтобы выбрать, он должен ввести команду \"-set(число)\".",30)
elseif sec==1410 then
call TriggerExecute(gg_trg_LastEvent1)
endif
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
endfunction
