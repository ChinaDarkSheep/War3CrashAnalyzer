function Trig_CaptainSkills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local integer i
local real r
local real x
local real y
local real x1
local real y1
local real angle
local real dmg
local real dist
local group g=CreateGroup()
local group g2
local timer t
local integer ht
local unit u
if GetSpellAbilityId()=='A0T1' then
set dmg=GetUnitAbilityLevel(caster,'A0T1')*60+3*GetHeroStr(caster,true)
if GetUnitAbilityLevel(caster,'A0T6')==1 then
set dmg=dmg+.25*udg_ReflectDmg[ID]
set r=300
set dist=720
else
set r=200
set dist=360
endif
set x=GetSpellTargetX()
set y=GetSpellTargetY()
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",x,y))
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,r,Condition(function Trig_Filter_ID))
set x=GetUnitX(caster)
set y=GetUnitY(caster)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set x1=GetUnitX(u)
set y1=GetUnitY(u)
set angle=bj_RADTODEG*Atan2(y1-y,x1-x)
call KnockBackUnit(u,dist,dist/600,angle,0.05)
call GroupRemoveUnit(g,u)
endloop
else
endif
if GetSpellAbilityId()=='A0T3' then
set g2=CreateGroup()
set i=GetUnitAbilityLevel(caster,'A0T3')
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+(.1+.02*i)*GetUnitState(caster,UNIT_STATE_MAX_LIFE))
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,450,Condition(function Trig_Filter_ID))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitAddAbility(u,'A0T4')
call SetUnitAbilityLevel(u,'A0T4',i)
call GroupAddUnit(g2,u)
call GroupRemoveUnit(g,u)
endloop
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveGroupHandle(udg_hash,ht,0,g2)
call TimerStart(t,10,false,function Trig_CaptainSkills_Q)
endif
if GetSpellAbilityId()=='A01U' then
set i=R2I(20*GetUnitAbilityLevel(caster,'A01U')+0.02*GetUnitState(caster,UNIT_STATE_MAX_LIFE))
if GetUnitAbilityLevel(caster,'A0T6')==1 then
set i=i+R2I(0.08*GetUnitState(caster,UNIT_STATE_MAX_LIFE))
endif
set udg_ReflectDmg[ID]=udg_ReflectDmg[ID]+i
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveInteger(udg_hash,ht,0,ID)
call SaveInteger(udg_hash,ht,1,i)
call TimerStart(t,10,false,function Trig_CaptainSkills_W)
endif
call DestroyGroup(g)
set caster=null
set u=null
set t=null
set g=null
set g2=null
endfunction
