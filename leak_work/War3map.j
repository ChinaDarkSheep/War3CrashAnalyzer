function Leoric_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer sec=LoadInteger(udg_hash,ht,1)
local real x=GetUnitX(hero)
local real y=GetUnitY(hero)
local real dmg
local real hp
if sec>0 then
set dmg=0.5*(300+1.5*GetHeroStr(hero,true))
call GroupDamage(x,y,450.,hero,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
call SaveInteger(udg_hash,ht,1,sec-1)
else
call UnitRemoveAbility(hero,'A0WB')
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(hero),'h04I',x,y,0.)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',5.)
set dmg=12.*GetHeroStr(hero,true)
call GroupDamage(x,y,450.,hero,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
set t=null
set hero=null
endfunction
function Trig_LeoricSkills_Actions takes nothing returns nothing
local unit hero=GetTriggerUnit()
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local integer h
local real x
local real y
local real dmg
local real r
local timer t
local integer ht
local group g=CreateGroup()
local unit u
local integer a
if GetSpellAbilityId()=='A0WA' then
call UnitAddAbility(hero,'A0WB')
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveInteger(udg_hash,ht,1,8*2)
call TimerStart(t,0.5,true,function Leoric_R)
endif
if GetSpellAbilityId()=='A0WD' then
set x=GetUnitX(hero)
set y=GetUnitY(hero)
set bj_lastCreatedUnit=CreateUnit(Player(ID-1),'h04J',x,y,0.)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',3.)
call GroupEnumUnitsInRange(g,x,y,400.,Condition(function FilterAlive))
set a=0
set dmg=300+4*GetHeroStr(hero,true)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitEnemy(u,Player(ID-1))then
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set a=a+1
endif
call GroupRemoveUnit(g,u)
endloop
set r=0.01*(5+a)
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+r*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
if a>=10 then
call SetHeroStr(hero,GetHeroStr(hero,false)+4,true)
endif
endif
if GetSpellAbilityId()=='A0WC' then
set x=GetUnitX(GetSpellTargetUnit())
set y=GetUnitY(GetSpellTargetUnit())
set dmg=1000.+2.*Summ_Attack(hero)
call UnitDamageTarget(hero,GetSpellTargetUnit(),dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupDamage(x,y,300.,hero,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
set bj_lastCreatedUnit=CreateUnit(Player(ID-1),'h009',x,y,0.)
call UnitAddAbility(bj_lastCreatedUnit,'A00H')
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',1.)
call IssueTargetOrder(bj_lastCreatedUnit,"thunderbolt",GetSpellTargetUnit())
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
endif
call DestroyGroup(g)
set t=null
set hero=null
set u=null
set g=null
endfunction
