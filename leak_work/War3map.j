set a='I035'
set b='I02Y'
set c='I033'
set d='I037'
set e='I03E'
endif
elseif drop==2 then
if lvl==2 then
set a='I03W'
set b='I054'
set c='I07J'
set d='I08S'
elseif lvl==3 then
set a='I09K'
set b='I047'
set c='I04E'
set d='I05J'
