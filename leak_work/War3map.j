function OldKoldun_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local real sec=LoadReal(udg_hash,ht,0)
local real x=LoadReal(udg_hash,ht,1)
local real y=LoadReal(udg_hash,ht,2)
local real dist
local real angle
local group g=CreateGroup()
local unit u
local real dmg=50+1.25*GetHeroInt(caster,true)
if sec>0 then
set sec=sec-1.
call SaveReal(udg_hash,ht,0,sec)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,450.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Immolation\\ImmolationDamage.mdl",u,"overhead"))
call GroupRemoveUnit(g,u)
endloop
if GetHeroLevel(caster)>49 then
set dmg=1.5*GetHeroInt(caster,true)
set dist=GetRandomReal(0,360.00)
set angle=GetRandomReal(0,360)
set x=x+dist*Cos(angle*bj_DEGTORAD)
set y=y+dist*Sin(angle*bj_DEGTORAD)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,200.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UDeathSmall\\UDeathSmall.mdl",x,y))
endif
else
call DestroyEffect(LoadEffectHandle(udg_hash,ht,3))
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
call DestroyGroup(g)
set g=null
set caster=null
set u=null
set t=null
endfunction
function Trig_OldKoldunSkills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer h=GetHandleId(caster)
local real x
local real y
local real dmg
local real r
local integer a
local unit u
local unit dummy
local group g=CreateGroup()
local timer t
local integer ht
if GetSpellAbilityId()=='A04E' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveReal(udg_hash,ht,0,16.)
call SaveReal(udg_hash,ht,1,x)
call SaveReal(udg_hash,ht,2,y)
call SaveEffectHandle(udg_hash,ht,3,AddSpecialEffect("war3mapImported\\Soul Hurricane Unholy.mdx",x,y))
call TimerStart(t,1.,true,function OldKoldun_R)
endif
if GetSpellAbilityId()=='A04J' then
set dmg=100.*GetUnitAbilityLevel(caster,'A04J')+3*GetHeroInt(caster,true)
if GetUnitAbilityLevel(caster,'A0BR')==1 then
set dmg=dmg+GetHeroInt(caster,true)
endif
set u=GetSpellTargetUnit()
set x=GetUnitX(u)
set y=GetUnitY(u)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,300.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
if UnitAlive(u)then
set dummy=CreateUnit(GetOwningPlayer(caster),'h009',x,y,0)
call UnitAddAbility(dummy,'A07J')
call SetUnitAbilityLevel(dummy,'A07J',GetUnitAbilityLevel(caster,'A04J'))
call IssueTargetOrder(dummy,"cripple",u)
call UnitApplyTimedLife(dummy,'BTLF',1.)
endif
call GroupRemoveUnit(g,u)
endloop
endif
if GetSpellAbilityId()=='A04I' then
call UnitAddAbility(caster,'A0G9')
set r=5.+0.50*GetUnitAbilityLevel(caster,'A04I')
set a=800
if GetUnitAbilityLevel(caster,'A0BR')==1 then
set a=a+GetHeroInt(caster,false)/2
endif
call TempStats(caster,0,0,a,0,0,0,PositiveDuration(caster,r))
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,r,false,function Trig_OldKoldunSkills_E)
endif
call DestroyGroup(g)
set caster=null
set dummy=null
set u=null
set g=null
endfunction
function InitTrig_OldKoldunSkills takes nothing returns nothing
set gg_trg_OldKoldunSkills=CreateTrigger()
call TriggerAddAction(gg_trg_OldKoldunSkills,function Trig_OldKoldunSkills_Actions)
endfunction
function Trig_Minotaur_Q takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local real xh=GetUnitX(hero)
local real yh=GetUnitY(hero)
local real dmg=LoadReal(udg_hash,ht,1)
local unit u
local group g=CreateGroup()
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,xh,yh,250.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("origin",u,"Abilities\\Spells\\Human\\Feedback\\SpellBreakerAttack.mdl")
call DestroyEffect(bj_lastCreatedEffect)
call GroupRemoveUnit(g,u)
endloop
if udg_Talante[ID]==1 then
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,xh,yh,250.,Bool_Filter_ID)
call RandomUnitFromGroup(1,g)
set u=FirstOfGroup(g)
call HeroAttack(hero,hero,u)
call Modificator(hero,hero,u)
call HeroAttack(hero,hero,u)
call Modificator(hero,hero,u)
endif
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl",xh,yh)
call DestroyEffect(bj_lastCreatedEffect)
if GetUnitAbilityLevel(hero,'A0CC')==1 then
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.15*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
endif
call SetUnitTimeScalePercent(hero,100.00)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
call DestroyGroup(g)
set g=null
set t=null
set hero=null
set u=null
endfunction
function Trig_Minotaur_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(hero)
local real angle=LoadReal(udg_hash,ht,0)
local real dmg=LoadReal(udg_hash,ht,1)
local integer tic=LoadInteger(udg_hash,ht,2)
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local real xh=GetUnitX(hero)
local real yh=GetUnitY(hero)
local real x
local real y
local unit u
local integer a
local integer b
if tic>0 then
if tic==1 then
set dmg=dmg*1.5
endif
set b=1
call SeekMinDummys()
loop
exitwhen b>5
set x=xh+300*Cos((angle+15*b-45)*bj_DEGTORAD)
set y=yh+300*Sin((angle+15*b-45)*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(hero),'h05G',xh,yh,GetUnitFacing(hero))
set a=SeekFreeDummysMin(u,GetHandleId(u))
set s__Dummys_dmg[sDummy[a]]=dmg
call UnitAddAbility(u,'A04P')
call IssuePointOrder(u,"carrionswarm",x,y)
call UnitApplyTimedLife(u,'BTLF',1.75)
set b=b+1
endloop
if GetUnitAbilityLevel(hero,'A0CC')==1 then
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.25*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
endif
call SaveInteger(udg_hash,ht,2,tic-1)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
set hero=null
set u=null
endfunction
function Trig_MinotaurSkills_Actions takes nothing returns nothing
local unit hero=GetTriggerUnit()
local integer h=GetHandleId(hero)
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local real xh=GetUnitX(hero)
local real yh=GetUnitY(hero)
local real x
local real y
local real dmg
local real angle
local timer t
local integer ht
local unit u
local integer a
local integer b
local group g=CreateGroup()
if GetSpellAbilityId()=='A04M' then
call SetUnitTimeScalePercent(hero,200.00)
set dmg=1.2*GetHeroStr(hero,true)+20+20*GetUnitAbilityLevel(hero,'A04M')*GetUnitAbilityLevel(hero,'A04M')
if udg_Talante[ID]==1 then
set dmg=dmg*(1+LoadReal(udg_hash,h,StringHash("Modificator")))
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,xh,yh,250.,Bool_Filter_ID)
call RandomUnitFromGroup(1,g)
set u=FirstOfGroup(g)
call HeroAttack(hero,hero,u)
call Modificator(hero,hero,u)
elseif udg_Talante[ID]==2 then
if GetHeroLevel(hero)>=50 then
call FoTDeath(hero,xh,yh,false)
elseif not LoadBoolean(udg_hash,h,StringHash("Passive_2"))then
call FoTDeath(hero,xh,yh,false)
call Func_CD(hero,"Passive_2",25.)
endif
endif
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,xh,yh,250.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("origin",u,"Abilities\\Spells\\Human\\Feedback\\SpellBreakerAttack.mdl")
call DestroyEffect(bj_lastCreatedEffect)
call GroupRemoveUnit(g,u)
endloop
if GetUnitAbilityLevel(hero,'A0CC')==1 then
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.15*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
endif
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveReal(udg_hash,ht,1,dmg)
call TimerStart(t,0.6,false,function Trig_Minotaur_Q)
endif
if GetSpellAbilityId()=='A04O' then
set dmg=100+1.*GetHeroStr(hero,true)
if udg_Talante[ID]==1 then
set dmg=dmg*(1+LoadReal(udg_hash,h,StringHash("Modificator")))
endif
set angle=bj_RADTODEG*Atan2(GetSpellTargetY()-yh,GetSpellTargetX()-xh)
set b=1
call SeekMinDummys()
loop
exitwhen b>5
set x=xh+300*Cos((angle+15*b-45)*bj_DEGTORAD)
set y=yh+300*Sin((angle+15*b-45)*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(hero),'h05G',xh,yh,GetUnitFacing(hero))
set a=SeekFreeDummysMin(u,GetHandleId(u))
set s__Dummys_dmg[sDummy[a]]=dmg
call UnitAddAbility(u,'A04P')
call IssuePointOrder(u,"carrionswarm",x,y)
call UnitApplyTimedLife(u,'BTLF',1.75)
set b=b+1
endloop
if GetUnitAbilityLevel(hero,'A0CC')==1 then
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.25*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
endif
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveReal(udg_hash,ht,0,angle)
call SaveReal(udg_hash,ht,1,dmg)
call SaveInteger(udg_hash,ht,2,2)
call TimerStart(t,1.2,true,function Trig_Minotaur_R)
endif
call DestroyGroup(g)
set g=null
set t=null
set hero=null
set u=null
endfunction
function InitTrig_MinotaurSkills takes nothing returns nothing
set gg_trg_MinotaurSkills=CreateTrigger()
call TriggerAddAction(gg_trg_MinotaurSkills,function Trig_MinotaurSkills_Actions)
endfunction
function FacelessSkills_Q takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer i=LoadInteger(udg_hash,ht,1)
local real x
local real y
local real dmg
local real hp
if UnitAlive(caster)and i>0 then
set udg_UpgradeTentakle=(udg_UpgradeTentakle+1)
set x=GetUnitX(caster)+(140.00+GetRandomReal(0,40.00))*Cos(GetRandomReal(0,360)*bj_DEGTORAD)
set y=GetUnitY(caster)+(140.00+GetRandomReal(0,40.00))*Sin(GetRandomReal(0,360)*bj_DEGTORAD)
if GetUnitAbilityLevel(caster,'A0O9')==1 then
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'n02C',x,y,0.)
else
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'nfgt',x,y,0.)
endif
call SetUnitAnimation(bj_lastCreatedUnit,"stand")
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',20.)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
call UnitAddAbility(bj_lastCreatedUnit,'A007')
if GetHeroLevel(caster)>=50 then
set hp=100+2*GetHeroStr(caster,true)+8*GetHeroInt(caster,true)
set dmg=10+0.5*GetHeroInt(caster,true)
else
set hp=100+GetHeroStr(caster,true)+4*GetHeroInt(caster,true)
set dmg=10+0.25*GetHeroInt(caster,true)
endif
call SummonStats(true,R2I(hp),R2I(dmg),bj_lastCreatedUnit,caster)
call UnitRemoveAbility(bj_lastCreatedUnit,'A007')
call SaveInteger(udg_hash,ht,1,i-1)
else
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
set t=null
set caster=null
endfunction
function FacelessSkills_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer sec=LoadInteger(udg_hash,ht,1)
local effect e=LoadEffectHandle(udg_hash,ht,2)
local real x=LoadReal(udg_hash,ht,0)
local real y=LoadReal(udg_hash,ht,1)
local real dmg
local real hp
if sec>0 then
if sec>1 then
set dmg=0.2*GetHeroInt(caster,true)
call GroupDamage(x,y,500.,caster,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
else
set dmg=5.*GetHeroInt(caster,true)
call GroupDamage(x,y,500.,caster,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
endif
call SaveInteger(udg_hash,ht,1,sec-1)
else
call DestroyEffect(e)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
set t=null
set caster=null
set e=null
endfunction
function Trig_FacelessSkills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local real dmg
local real x
local real y
local integer a
local integer h=GetHandleId(caster)
local timer t
local integer ht
if GetSpellAbilityId()=='A04Z' then
set a=1+3*GetUnitAbilityLevel(caster,'A04Z')
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveInteger(udg_hash,ht,1,a)
call TimerStart(t,0.3,true,function FacelessSkills_Q)
endif
if GetSpellAbilityId()=='A050' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
call SaveReal(udg_hash,h,StringHash("FacQX"),GetUnitX(caster))
call SaveReal(udg_hash,h,StringHash("FacQY"),GetUnitY(caster))
call UnitAddAbility(caster,'A051')
set dmg=200*GetUnitAbilityLevel(caster,'A050')+4*GetHeroInt(caster,true)
call GroupDamage(x,y,400.,caster,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
call DestroyEffect(AddSpecialEffect("war3mapImported\\Thunder Slam.mdx",x,y))
call TriggerSleepAction(5.00)
call UnitRemoveAbility(caster,'A051')
endif
if GetSpellAbilityId()=='A051' then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl",x,y))
set x=LoadReal(udg_hash,h,StringHash("FacQX"))
set y=LoadReal(udg_hash,h,StringHash("FacQY"))
call SetUnitPosition(caster,x,y)
call UnitRemoveAbility(caster,'A051')
if GetUnitAbilityLevel(caster,'A0O9')==1 then
set dmg=200*GetUnitAbilityLevel(caster,'A050')+4*GetHeroInt(caster,true)
call GroupDamage(x,y,400.,caster,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
call DestroyEffect(AddSpecialEffect("war3mapImported\\Thunder Slam.mdx",x,y))
endif
endif
if GetSpellAbilityId()=='A053' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\Astral_Singularity.mdx",x,y)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveInteger(udg_hash,ht,1,6*5+2)
call SaveEffectHandle(udg_hash,ht,2,bj_lastCreatedEffect)
call SaveReal(udg_hash,ht,0,x)
call SaveReal(udg_hash,ht,1,y)
call TimerStart(t,0.2,true,function FacelessSkills_R)
endif
set caster=null
set t=null
endfunction
