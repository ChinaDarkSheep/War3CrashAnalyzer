function GromSkills_D takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local real sec=LoadReal(Hash,ht,0)
local unit caster=LoadUnitHandle(Hash,ht,1)
local real x=LoadReal(Hash,ht,2)
local real y=LoadReal(Hash,ht,3)
local group g=CreateGroup()
local unit u
local real dmg=GetHeroInt(caster,true)*2
local real angle=GetRandomReal(0,360)
local real dist=GetRandomReal(50.,470.)
if sec>0 then
call SaveReal(Hash,ht,0,sec-.12)
set x=x+dist*Cos(angle*bj_DEGTORAD)
set y=y+dist*Sin(angle*bj_DEGTORAD)
set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\Stormfall.mdx",x,y)
call DestroyEffect(bj_lastCreatedEffect)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,300.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(Hash,ht)
endif
call DestroyGroup(g)
set g=null
set t=null
set caster=null
set u=null
endfunction
function GromSkills_E takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local real sec=LoadReal(udg_hash,ht,0)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local real dmg=LoadReal(udg_hash,ht,1)
local unit ball=LoadUnitHandle(udg_hash,ht,1)
local real tic=LoadReal(udg_hash,ht,10)
local boolean crit=LoadBoolean(udg_hash,ht,11)
local integer id=GetPlayerId(GetOwningPlayer(caster))
local group g=CreateGroup()
local unit u
local location p=GetUnitLoc(ball)
local location p1
local lightning l
if sec>0 then
call SaveReal(udg_hash,ht,0,sec-tic)
set udg_Drop2=id
call GroupEnumUnitsInRangeOfLoc(g,p,400.,Bool_Filter_ID)
if GetHeroLevel(caster)>49 then
call RandomUnitFromGroup(2,g)
else
call RandomUnitFromGroup(1,g)
endif
loop
set u=FirstOfGroup(g)
exitwhen u==null
set p1=GetUnitLoc(u)
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
if crit then
set l=AddLightningEx("AFOD",true,GetLocationX(p),GetLocationY(p),GetLocationZ(p),GetLocationX(p1),GetLocationY(p1),GetLocationZ(p1))
else
set l=AddLightningEx("CLSB",true,GetLocationX(p),GetLocationY(p),GetLocationZ(p),GetLocationX(p1),GetLocationY(p1),GetLocationZ(p1))
endif
call RemoveLocation(p1)
call Effect_Ligthning(l,.2)
call GroupRemoveUnit(g,u)
endloop
else
call RemoveUnit(ball)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
call RemoveLocation(p)
set p=null
set p1=null
call DestroyGroup(g)
set g=null
set t=null
set caster=null
set ball=null
set u=null
set l=null
endfunction
function Trig_GromSkills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer h=GetHandleId(caster)
local group g=CreateGroup()
local group g2=CreateGroup()
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local integer a
local integer b
local unit u
local real r
local real x
local real y
local real x1
local real y1
local real dmg
local integer crit=GetRandomInt(1,3)
local timer t
local integer ht
local boolean spell=false
if GetSpellAbilityId()=='A0GU' then
set spell=true
set x=GetSpellTargetX()
set y=GetSpellTargetY()
call UnitRemoveAbility(caster,'A0GU')
call UnitAddAbility(caster,'A0GT')
call SaveInteger(udg_hash,h,'d',0)
set t=CreateTimer()
set ht=GetHandleId(t)
call FlushChildHashtable(Hash,ht)
call SaveReal(Hash,ht,0,2.)
call SaveUnitHandle(Hash,ht,1,caster)
call SaveReal(Hash,ht,2,x)
call SaveReal(Hash,ht,3,y)
call TimerStart(t,0.12,true,function GromSkills_D)
endif
if GetSpellAbilityId()=='A0AG' then
set spell=true
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set u=CreateUnit(GetOwningPlayer(caster),'h023',x,y,GetUnitFacing(caster))
set x1=GetSpellTargetX()
set y1=GetSpellTargetY()
set r=bj_RADTODEG*Atan2(y1-y,x1-x)
set x1=x+2000.*Cos(r*bj_DEGTORAD)
set y1=y+2000.*Sin(r*bj_DEGTORAD)
call IssuePointOrder(u,"move",x1,y1)
set t=CreateTimer()
set ht=GetHandleId(t)
set r=.4-.06*GetUnitAbilityLevel(caster,'A0AG')
call SaveReal(udg_hash,ht,0,10.)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveUnitHandle(udg_hash,ht,1,u)
call SaveReal(udg_hash,ht,10,r)
if crit==2 then
call CreateTextTagUnitBJ("Ярость громовержца!",caster,0,10.00,100.00,50.00,50.00,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
call SaveBoolean(udg_hash,ht,11,true)
call SetUnitVertexColor(u,255,0,0,255)
set dmg=2*GetHeroInt(caster,true)/3
else
call SaveBoolean(udg_hash,ht,11,false)
set dmg=GetHeroInt(caster,true)/3
endif
call SaveReal(udg_hash,ht,1,dmg)
call TimerStart(t,r,true,function GromSkills_E)
endif
if GetSpellAbilityId()=='A08Q' then
set spell=true
set x=GetSpellTargetX()
set y=GetSpellTargetY()
if crit==2 then
call CreateTextTagUnitBJ("Ярость громовержца!",GetSpellAbilityUnit(),0,10.00,100.00,50.00,50.00,0)
set udg_TEXT=GetLastCreatedTextTag()
