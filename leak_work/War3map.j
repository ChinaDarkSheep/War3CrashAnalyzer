set gg_trg_HeroE53=CreateTrigger()
call TriggerAddCondition(gg_trg_HeroE53,Condition(function HeroE53_conditions))
call TriggerAddAction(gg_trg_HeroE53,function Trig_HeroE53_Actions)
endfunction
