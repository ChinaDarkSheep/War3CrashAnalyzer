function DarkSgustok_D takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit attack=LoadUnitHandle(Hash,ht,0)
local real sec=LoadReal(Hash,ht,0)
local real x=LoadReal(Hash,ht,1)
local real y=LoadReal(Hash,ht,2)
local real range=GetRandomReal(30.00,120.00)
local real angle=GetRandomReal(0.,360.)
local real dmg=LoadReal(Hash,ht,3)
if sec>0 then
set sec=sec-0.08
call SaveReal(Hash,ht,0,sec)
set x=x+range*Cos(angle*bj_DEGTORAD)
set y=y+range*Sin(angle*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",x,y))
call GroupDamage(x,y,130.,attack,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
else
call FlushChildHashtable(Hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
set t=null
set attack=null
endfunction
function HeroAttack takes unit hero,unit attack,unit target returns nothing
local integer a=0
local integer i
local integer i2
local real dmg
local real dmg2
local real heal
local group g=CreateGroup()
local group g2=CreateGroup()
local unit u
local real r
local real x
local real y
local real xa=GetUnitX(attack)
local real ya=GetUnitY(attack)
local real xt=GetUnitX(target)
local real yt=GetUnitY(target)
local timer t
local integer ht
local integer random=GetRandomInt(1,100)
local integer h=GetHandleId(hero)
local integer ha=GetHandleId(attack)
local integer ID=GetPlayerId(GetOwningPlayer(attack))+1
local real bonus=1+LoadReal(udg_hash,h,StringHash("Modificator"))
local real crit
local real all_dmg=Summ_Attack(attack)
local integer ids=ReturnTypeHeroId(ha)
local real CD=s__Heroes_ModCD[sHero[ids]]
if target !=null then
if CD<=0 then
set CD=1
endif
if GetUnitAbilityLevel(attack,'A04N')>0 and udg_BarbarianW then
set dmg=(GetHeroStr(attack,true)/2)*bonus
call UnitDamageTarget(attack,target,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
endif
if GetUnitAbilityLevel(attack,'A0PI')>0 then
if udg_AxeW then
if GetUnitAbilityLevel(target,'A0LN')==0 then
call UnitAddAbility(target,'A0LN')
endif
set i=GetHandleId(target)
call SaveInteger(udg_hash,i,Axe_Ds,LoadInteger(udg_hash,i,Axe_Ds)+1)
endif
if GetUnitAbilityLevel(hero,'A03Q')>0 then
set dmg=(GetUnitAbilityLevel(hero,'A03Q')*25+.5*(GetHeroStr(hero,true)+GetHeroAgi(hero,true)))*bonus
set udg_AxeE=udg_AxeE+1
if udg_AxeE==5 then
set udg_AxeE=0
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,xt,yt,300.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(attack,u,dmg,true,false,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",u,"chest")
call DestroyEffect(bj_lastCreatedEffect)
if GetUnitAbilityLevel(u,'A0LN')==0 then
call UnitAddAbility(u,'A0LN')
endif
set i=GetHandleId(u)
call SaveInteger(udg_hash,i,Axe_Ds,LoadInteger(udg_hash,i,Axe_Ds)+1)
call GroupRemoveUnit(g,u)
endloop
endif
endif
endif
if GetUnitAbilityLevel(hero,'A0RJ')==1 and GetUnitAbilityLevel(hero,'A0RK')>=1 then
if GetRandomInt(1,20)<=3 then
set dmg=(GetUnitAbilityLevel(hero,'A0RK')*40+GetHeroStr(hero,true))*bonus
set dmg2=dmg*0.2
set dmg=dmg*0.8
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,xt,yt,325.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(attack,u,dmg,true,false,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(attack,u,dmg2,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",u,"chest")
call DestroyEffect(bj_lastCreatedEffect)
call GroupRemoveUnit(g,u)
endloop
else
endif
endif
if udg_Talante[ID]==1 then
set a=4
else
