local unit u=LoadUnitHandle(udg_hash,ht,0)
call UnitRemoveAbility(u,'A0OH')
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set u=null
set t=null
endfunction
function Butcher_W takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local real sec=LoadReal(udg_hash,ht,0)-1.
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
if sec>0 then
call SaveReal(udg_hash,ht,0,sec)
if udg_Talante[ID]==2 then
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.01*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
endif
else
if udg_Talante[ID]==1 then
call UnitRemoveAbility(hero,'A0OB')
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set hero=null
set t=null
endfunction
function Butcher_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer sec=LoadInteger(udg_hash,ht,1)
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local unit u
local real xh=GetUnitX(hero)
local real yh=GetUnitY(hero)
local real x
local real y
local real dmg=0.
local group g=CreateGroup()
local group g2=LoadGroupHandle(udg_hash,ht,2)
local real range=350.
if sec>0 then
if udg_Talante[ID]==1 then
set dmg=4.*Summ_Attack(hero)
elseif udg_Talante[ID]==2 then
set dmg=1.5*(2.*GetUnitState(hero,UNIT_STATE_MAX_LIFE)-GetUnitState(hero,UNIT_STATE_LIFE))
if GetUnitAbilityLevel(hero,'A0C0')==1 then
set range=600.
endif
call Immortal(hero,3)
endif
set sec=sec-1
call SaveInteger(udg_hash,ht,1,sec)
if sec==20 then
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.2*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
call UnitRemoveAbility(hero,'A0OG')
call GroupEnumUnitsInRange(g,xh,yh,range,null)
call DestroyEffect(AddSpecialEffect("war3mapImported\\AerialExplosionV3.mdx",xh,yh))
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)and IsUnitEnemy(u,GetOwningPlayer(hero))then
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
if GetUnitAbilityLevel(hero,'A0C0')==1 and udg_Talante[ID]==1 then
call GroupAddUnit(g2,u)
call UnitAddAbility(u,'A0OI')
endif
endif
call GroupRemoveUnit(g,u)
endloop
