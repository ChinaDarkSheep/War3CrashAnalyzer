call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.2*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
call Func_CD(hero,"Elephant",30.)
endif
endif
if s__Heroes_Pass_1sec_1[sHero[ihh]]!="" then
set UNIT=hero
call ExecuteFunc(s__Heroes_Pass_1sec_1[sHero[ihh]])
endif
if s__Heroes_item_I0E8[sHero[ihh]]>0 then
set i=GetPlayerState(Player(ID-1),PLAYER_STATE_RESOURCE_GOLD)/150
if i>200 then
set b=200
set r=50
if LoadBoolean(udg_hash,h,StringHash("SetMidas"))then
set a=(GetPlayerState(GetOwningPlayer(hero),PLAYER_STATE_RESOURCE_GOLD)-30000)/800
set b=b+a
set r=r+.25*a
endif
else
set b=0+i
set r=0.25*i
endif
set i=(s__Heroes_buyStr[sHero[ihh]]+s__Heroes_buyAgi[sHero[ihh]]+s__Heroes_buyInt[sHero[ihh]])/10+5*s__Heroes_buyI0B5[sHero[ihh]]
set b=b+i
set r=r+.25*i
set a=LoadInteger(udg_hash,h,StringHash("AltAdamS"))
set x=LoadReal(udg_hash,h,StringHash("AltAdamR"))
set s__Heroes_Str[sHero[ihh]]=s__Heroes_Str[sHero[ihh]]-a+b
set s__Heroes_Agi[sHero[ihh]]=s__Heroes_Agi[sHero[ihh]]-a+b
set s__Heroes_Int[sHero[ihh]]=s__Heroes_Int[sHero[ihh]]-a+b
call SaveReal(udg_hash,h,StringHash("HPRegen"),LoadReal(udg_hash,h,StringHash("HPRegen"))+r-x)
call SaveInteger(udg_hash,h,StringHash("AltAdamS"),b)
call SaveReal(udg_hash,h,StringHash("AltAdamR"),r)
endif
set i=0
set a=0
loop
exitwhen a>5 or i>0
set b=GetItemTypeId(UnitItemInSlot(hero,a))
if b=='I08A' then
set i=1
elseif b=='I09D' then
set i=1
endif
set a=a+1
endloop
if i==1 then
if LoadBoolean(udg_hash,h,StringHash("HaveBar"))then
if not LoadBoolean(udg_hash,h,StringHash("AmulRinAct"))then
set s__Units_AllDmg[sUnit[iuh]]=s__Units_AllDmg[sUnit[iuh]]+2500
call SaveBoolean(udg_hash,h,StringHash("AmulRinAct"),true)
endif
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.01*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
else
if LoadBoolean(udg_hash,h,StringHash("AmulRinAct"))then
set s__Units_AllDmg[sUnit[iuh]]=s__Units_AllDmg[sUnit[iuh]]-2500
call SaveBoolean(udg_hash,h,StringHash("AmulRinAct"),false)
endif
endif
endif
if LoadBoolean(udg_hash,h,StringHash("HaveBar"))then
set i=0
set a=0
loop
exitwhen a>5 or i>0
set b=GetItemTypeId(UnitItemInSlot(hero,a))
if b=='I0EY' then
set i=1
set dmg=25.+.5*highstat
elseif b=='I0EX' then
set i=1
set dmg=5.+.15*highstat
endif
set a=a+1
endloop
if i==1 then
set dmg=0.5*F_Barrier(hero,dmg)
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,xh,yh,400.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
endif
endif
if UnitHasItemOfTypeBJ(hero,'I038')then
set dmg=0.25*GetHeroStr(hero,true)
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,xh,yh,500.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
endif
if UnitHasItemOfTypeBJ(hero,'I0EW')then
set b=LoadInteger(udg_hash,h,StringHash("SealGreed"))
if GoldNT[ID]>200000 then
set a=142+(GoldNT[ID]-200000)/1750
else
set a=GoldNT[ID]/1400
endif
if LoadBoolean(udg_hash,h,StringHash("SetMidas"))then
set a=4*a
set BHP=BHP+GoldNT[ID]/125
endif
call SaveInteger(udg_hash,h,H_HighStat,LoadInteger(udg_hash,h,H_HighStat)+a-b)
call SaveInteger(udg_hash,h,StringHash("SealGreed"),a)
endif
if UnitHasItemOfTypeBJ(hero,'I07Q')and not day then
set x=GetUnitState(hero,UNIT_STATE_LIFE)
set y=0.01*GetUnitState(hero,UNIT_STATE_MAX_LIFE)
call SetUnitState(hero,UNIT_STATE_LIFE,x+y)
endif
if UnitHasItemOfTypeBJ(hero,'I0EF')then
set x=GetUnitState(hero,UNIT_STATE_MANA)
set y=GetUnitState(hero,UNIT_STATE_MAX_MANA)
call SetUnitState(hero,UNIT_STATE_MANA,x+30.+0.03*(y-x))
endif
if udg_ReflectDmg[ID]>0 then
set i=0
set a=0
loop
exitwhen a>5 or i>0
set b=GetItemTypeId(UnitItemInSlot(hero,a))
if b=='I0F1' then
set i=1
elseif b=='I07E' then
set i=1
elseif b=='I0DM' then
set i=1
elseif b=='I0DR' then
set i=1
elseif b=='I0EE' then
set i=1
endif
set a=a+1
endloop
if i==1 then
set x=.08*F_Reflect(hero)
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+x)
endif
endif
if not IsUnitInGroup(hero,udg_HeroBuild)then
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='brac' then
set x=GetUnitState(hero,UNIT_STATE_LIFE)
set y=GetUnitState(hero,UNIT_STATE_MAX_LIFE)
set x1=0.01*(2.*y)
if x-x1>1 then
call SetUnitState(hero,UNIT_STATE_LIFE,x-x1)
else
call SetUnitState(hero,UNIT_STATE_LIFE,1.)
endif
endif
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='rst1' and LoadBoolean(udg_hash,h,StringHash("Trap"))==false then
set s=LoadStr(udg_hash,h,2)
if s=="Str" then
set dmg=2.5*GetHeroStr(hero,true)
else
if s=="Agi" then
set dmg=2.5*GetHeroAgi(hero,true)
else
set dmg=2.5*GetHeroInt(hero,true)
endif
endif
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(hero),'u01V',xh,yh,GetUnitFacing(hero))
set bj_lastStartedTimer=CreateTimer()
set ht=GetHandleId(bj_lastStartedTimer)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveInteger(udg_hash,ht,1,60)
call SaveUnitHandle(udg_hash,ht,2,bj_lastCreatedUnit)
call SaveReal(udg_hash,ht,3,dmg)
call TimerStart(bj_lastStartedTimer,0.5,true,function Trig_Timer01s_Trap)
call SaveBoolean(udg_hash,h,StringHash("Trap"),true)
set bj_lastStartedTimer=CreateTimer()
set ht=GetHandleId(bj_lastStartedTimer)
call SaveUnitHandle(udg_hash,ht,0,hero)
call TimerStart(bj_lastStartedTimer,12.,false,function Trig_Timer01s_Trap_CD)
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='sorf' and LoadBoolean(udg_hash,h,StringHash("SelRing"))==false then
set a=R2I(100*GoldAvg[ID])
call SetPlayerStateBJ(Player(ID-1),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(ID-1),PLAYER_STATE_RESOURCE_GOLD)+a)
set GoldNT[ID]=GoldNT[ID]+a
call Func_CD(hero,"SelRing",10)
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='stwa' then
set x=0.01*GetUnitState(hero,UNIT_STATE_MAX_LIFE)
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+x)
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='crys' then
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.1*highstat)
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='ssil' then
if GetUnitState(hero,UNIT_STATE_MANA)>=300 and not LoadBoolean(udg_hash,h,StringHash("Hell Helmet"))then
call GroupClear(g)
set udg_Drop2=GetPlayerId(GetOwningPlayer(hero))
call GroupEnumUnitsInRange(g,xh,yh,600.,Bool_Filter_ID)
call RandomUnitFromGroup(1,g)
set u=FirstOfGroup(g)
if u !=null then
set dmg=500.+2.*GetHeroInt(hero,true)
call SetUnitState(hero,UNIT_STATE_MANA,GetUnitState(hero,UNIT_STATE_MANA)-300.)
call SaveBoolean(udg_hash,h,StringHash("Hell Helmet"),true)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(hero),'h05G',xh,yh,GetUnitFacing(hero))
set a=SeekFreeDummys(bj_lastCreatedUnit,GetHandleId(bj_lastCreatedUnit))
set s__Dummys_dmg[sDummy[a]]=dmg
call UnitAddAbility(bj_lastCreatedUnit,'ANbf')
call IssueTargetOrder(bj_lastCreatedUnit,"breathoffire",u)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',2.75)
set bj_lastStartedTimer=CreateTimer()
set a=GetHandleId(bj_lastStartedTimer)
call SaveUnitHandle(udg_hash,a,0,hero)
call SaveReal(udg_hash,a,1,200.)
call TimerStart(bj_lastStartedTimer,0.25,true,function Trig_Timer01s_Hell_Helmet_CD)
endif
endif
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='rag1' and not LoadBoolean(udg_hash,h,StringHash("Crown Poseidon"))then
set x=xh+250*Cos((GetUnitFacing(hero))*bj_DEGTORAD)
set y=yh+250*Sin((GetUnitFacing(hero))*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(hero),'nsel',x,y,GetUnitFacing(hero))
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+10)
call UnitAddAbility(u,'A007')
call SummonStats(true,20*(GetHeroStr(hero,true)+GetHeroInt(hero,true)),GetHeroInt(hero,true),u,hero)
call UnitRemoveAbility(u,'A007')
call UnitApplyTimedLife(u,'BTLF',30.)
call Func_CD(hero,"Crown Poseidon",30.)
endif
set i=0
set a=0
loop
exitwhen a>=6 or i>0
if GetItemTypeId(UnitItemInSlot(hero,a))=='I0DZ' then
set i=1
set dmg=200+1.25*GetHeroInt(hero,true)
endif
if GetItemTypeId(UnitItemInSlot(hero,a))=='I054' then
set i=2
set dmg=400+2.5*GetHeroInt(hero,true)
endif
if GetItemTypeId(UnitItemInSlot(hero,a))=='I0DY' then
set i=3
set dmg=800+4.*GetHeroInt(hero,true)
endif
set a=a+1
endloop
if i>0 and LoadBoolean(udg_hash,h,StringHash("SMALight"))==false then
set udg_Drop2=GetPlayerId(GetOwningPlayer(hero))
call GroupEnumUnitsInRange(g,xh,yh,800.,Bool_Filter_ID)
call RandomUnitFromGroup(1,g)
set u=FirstOfGroup(g)
call GroupClear(g)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(hero),'h05G',xh,yh,GetUnitFacing(hero))
set a=SeekFreeDummys(bj_lastCreatedUnit,GetHandleId(bj_lastCreatedUnit))
set s__Dummys_dmg[sDummy[a]]=dmg
call UnitAddAbility(bj_lastCreatedUnit,'A1B1')
call SetUnitAbilityLevel(bj_lastCreatedUnit,'A1B1',6)
call IssueTargetOrder(bj_lastCreatedUnit,"chainlightning",u)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',3.25)
call SaveBoolean(udg_hash,h,StringHash("SMALight"),true)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call TimerStart(t,10.,false,function Trig_Timer01s_SpaceMarineArmor)
endif
else
set a=R2I((udg_Time[2]*5+10+0.25*udg_Time[2]*udg_Time[2])*udg_HeroExp[ID])
call AddHeroXPSwapped(a,hero,true)
endif
set b=LoadInteger(udg_hash,h,StringHash("BStr"))
set s__Heroes_Str[sHero[ihh]]=s__Heroes_Str[sHero[ihh]]+BStr-b
call SaveInteger(udg_hash,h,StringHash("BStr"),BStr)
set b=LoadInteger(udg_hash,h,StringHash("BAgi"))
set s__Heroes_Agi[sHero[ihh]]=s__Heroes_Agi[sHero[ihh]]+BAgi-b
call SaveInteger(udg_hash,h,StringHash("BAgi"),BAgi)
set b=LoadInteger(udg_hash,h,StringHash("BInt"))
set s__Heroes_Int[sHero[ihh]]=s__Heroes_Int[sHero[ihh]]+BInt-b
call SaveInteger(udg_hash,h,StringHash("BInt"),BInt)
set b=LoadInteger(udg_hash,h,StringHash("BArm"))
set s__Units_Arm[sUnit[iuh]]=s__Units_Arm[sUnit[iuh]]+BArm-b
call SaveInteger(udg_hash,h,StringHash("BArm"),BArm)
set b=LoadInteger(udg_hash,h,StringHash("BGreenAt"))
set s__Units_GAttack[sUnit[iuh]]=s__Units_GAttack[sUnit[iuh]]+BAttack-b
call SaveInteger(udg_hash,h,StringHash("BGreenAt"),BAttack)
set b=LoadInteger(udg_hash,h,StringHash("BHP"))
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]+BHP-b
call SaveInteger(udg_hash,h,StringHash("BHP"),BHP)
set a=(PGStr+LoadInteger(udg_hash,h,StringHash("StrUP")))
if a>0 then
set a=(a*GetHeroStr(hero,false))/100
else
set a=0
endif
set s__Heroes_Str[sHero[ihh]]=s__Heroes_Str[sHero[ihh]]+a-LoadInteger(udg_hash,h,StringHash("StrUPNum"))
call SaveInteger(udg_hash,h,StringHash("StrUPNum"),a)
set a=PGAgi+LoadInteger(udg_hash,h,StringHash("AgiUP"))
if a>0 then
set a=(a*GetHeroAgi(hero,false))/100
else
set a=0
endif
set s__Heroes_Agi[sHero[ihh]]=s__Heroes_Agi[sHero[ihh]]+a-LoadInteger(udg_hash,h,StringHash("AgiUPNum"))
call SaveInteger(udg_hash,h,StringHash("AgiUPNum"),a)
set a=PGInt+LoadInteger(udg_hash,h,StringHash("IntUP"))
if a>0 then
set a=(a*GetHeroInt(hero,false))/100
else
set a=0
endif
set s__Heroes_Int[sHero[ihh]]=s__Heroes_Int[sHero[ihh]]+a-LoadInteger(udg_hash,h,StringHash("IntUPNum"))
call SaveInteger(udg_hash,h,StringHash("IntUPNum"),a)
if HardcoreUP10==4 then
if not LoadBoolean(udg_hash,h,StringHash("HardUp4"))then
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl",xh,yh))
set udg_Drop2=GetPlayerId(GetOwningPlayer(udg_Hero[11]))
call GroupEnumUnitsInRange(g,xh,yh,300.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
set dmg=10+udg_Time[2]*2+0.1*GetUnitState(u,UNIT_STATE_LIFE)
call UnitDamageTarget(udg_Hero[11],u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(udg_Hero[11],u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
call Func_CD(hero,"HardUp4",15.)
endif
endif
call F_Attack(hero,s__Units_GAttack[sUnit[iuh]])
call F_Armore(hero,s__Units_Arm[sUnit[iuh]])
call F_hp(hero,s__Units_HP[sUnit[iuh]])
call F_mp(hero,s__Units_MP[sUnit[iuh]])
call F_Stats(hero)
call SetUnitMoveSpeed(hero,GetUnitDefaultMoveSpeed(hero)+s__Heroes_MS[sHero[ihh]])
set hero=null
set u=null
set t=null
call DestroyGroup(g)
set g=null
endfunction
function Trig_Timer01s_UnordinaryUnit takes nothing returns nothing
local unit u=GetEnumUnit()
local integer h=GetHandleId(u)
local integer id=GetPlayerId(GetOwningPlayer(u))
local integer ID=id+1
local integer hh=GetHandleId(udg_Hero[ID])
local integer iuh=LoadInteger(Hash,hh,0)
local integer dmg
local integer hp
local real r
local real z
local integer a
local integer b
local integer iuu=LoadInteger(Hash,h,0)
if udg_BilderQuestOgr[24]==5 then
if GetUnitTypeId(u)=='n03W' or GetUnitTypeId(u)=='n03U' or GetUnitTypeId(u)=='n03V' then
set r=1.*F_HPregen(udg_Hero[ID])
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+r+0.01*GetUnitState(u,UNIT_STATE_MAX_LIFE))
set dmg=LoadInteger(udg_hash,h,StringHash("UnUnAt"))
set hp=LoadInteger(udg_hash,h,StringHash("UnUnHP"))
set a=LoadInteger(udg_hash,h,StringHash("UnUnAr"))
set s__Units_HP[sUnit[iuu]]=s__Units_HP[sUnit[iuu]]-hp
set s__Units_GAttack[sUnit[iuu]]=s__Units_GAttack[sUnit[iuu]]-dmg
set s__Units_Arm[sUnit[iuu]]=s__Units_Arm[sUnit[iuu]]-a
set a=R2I(.3*I2R(GetHeroAgi(udg_Hero[ID],true)/5+s__Units_Arm[sUnit[iuh]]))
set dmg=Summ_Attack(udg_Hero[ID])
set hp=R2I(GetUnitState(udg_Hero[ID],UNIT_STATE_MAX_LIFE)*1.5)
set s__Units_HP[sUnit[iuu]]=s__Units_HP[sUnit[iuu]]+hp
set s__Units_GAttack[sUnit[iuu]]=s__Units_GAttack[sUnit[iuu]]+dmg
set s__Units_Arm[sUnit[iuu]]=s__Units_Arm[sUnit[iuu]]+a
call SaveInteger(udg_hash,h,StringHash("UnUnAr"),a)
call SaveInteger(udg_hash,h,StringHash("UnUnAt"),dmg)
call SaveInteger(udg_hash,h,StringHash("UnUnHP"),hp)
endif
endif
if GetUnitAbilityLevel(u,'A17Q')==1 then
set s__Units_AllDmg[sUnit[iuu]]=s__Units_AllDmg[sUnit[iuh]]
set s__Units_AllDmgM[sUnit[iuu]]=s__Units_AllDmgM[sUnit[iuh]]
set s__Units_AllTake[sUnit[iuu]]=s__Units_AllTake[sUnit[iuh]]
set s__Units_AllBlock[sUnit[iuu]]=s__Units_AllBlock[sUnit[iuh]]
set s__Units_MageBlock[sUnit[iuu]]=s__Units_MageBlock[sUnit[iuh]]
set s__Units_MageTake[sUnit[iuu]]=s__Units_MageTake[sUnit[iuh]]
set s__Units_MageDamage[sUnit[iuu]]=s__Units_MageDamage[sUnit[iuh]]
set s__Units_NoMageDmg[sUnit[iuu]]=s__Units_NoMageDmg[sUnit[iuh]]
call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)+0.01*GetUnitState(u,UNIT_STATE_MAX_MANA))
set r=1.25*F_HPregen(udg_Hero[ID])+0.01*GetUnitState(u,UNIT_STATE_MAX_LIFE)
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+r)
set b=ReturnTypeUnitsId(GetUnitTypeId(u))
if b !=0 then
set r=0.3+(s__Unit_types_dmg[Unit_type[b]])/200.
set z=0.2+(s__Unit_types_hp[Unit_type[b]])/4000.
else
set r=0.3+0.01*GetUnitLevel(u)
set z=0.3+0.02*GetUnitLevel(u)
endif
set a=GetPlayerTechCount(Player(id),'R04V',true)
set dmg=R2I(Summ_Attack(udg_Hero[ID])*(0.6+0.04*a)*r)
set a=GetPlayerTechCount(Player(id),'R04Y',true)
set hp=R2I(GetUnitState(udg_Hero[ID],UNIT_STATE_MAX_LIFE)*(0.8+0.04*a)*z)
set a=GetPlayerTechCount(Player(id),'R04Z',true)
set r=(GetHeroAgi(udg_Hero[ID],true)/5+s__Units_Arm[sUnit[iuh]])
set b=R2I(r*(0.1+0.01*a))
set s__Units_HP[sUnit[iuu]]=s__Units_HP[sUnit[iuu]]+hp-LoadInteger(udg_hash,h,StringHash("UnUnHP"))
set s__Units_GAttack[sUnit[iuu]]=s__Units_GAttack[sUnit[iuu]]+dmg-LoadInteger(udg_hash,h,StringHash("UnUnAt"))
set s__Units_Arm[sUnit[iuu]]=s__Units_Arm[sUnit[iuu]]+b-LoadInteger(udg_hash,h,StringHash("UnUnAr"))
call SaveInteger(udg_hash,h,StringHash("UnUnAr"),b)
call SaveInteger(udg_hash,h,StringHash("UnUnAt"),dmg)
call SaveInteger(udg_hash,h,StringHash("UnUnHP"),hp)
elseif GetUnitTypeId(u)=='u01C' then
set r=GetUnitState(u,UNIT_STATE_LIFE)+0.6*F_HPregen(udg_Hero[ID])
call SetUnitState(u,UNIT_STATE_LIFE,r)
set a=GetPlayerTechCount(Player(id),'R02Y',true)
set r=(GetHeroAgi(udg_Hero[ID],true)/5+s__Units_Arm[sUnit[iuh]])
set b=R2I(r*(0.1+0.01*a))
set a=GetPlayerTechCount(Player(id),'R02V',true)
set dmg=(R2I(Summ_Attack(udg_Hero[ID]))*(30+2*a))/100
set a=GetPlayerTechCount(Player(id),'R01Z',true)
set hp=(R2I(GetUnitState(udg_Hero[ID],UNIT_STATE_MAX_LIFE))*(60+2*a))/100+500*a
if udg_SReligion[ID]==1 then
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+0.01*GetUnitState(u,UNIT_STATE_MAX_LIFE))
if udg_SMission[1]>=udg_SMission[2]then
set hp=(175*hp)/100
endif
endif
if udg_SReligion[ID]==2 then
set hp=hp+150*udg_SQuest[10]
if udg_SMission[1]>=udg_SMission[2]then
set dmg=(14*dmg)/10
endif
endif
set s__Units_HP[sUnit[iuu]]=s__Units_HP[sUnit[iuu]]+hp-LoadInteger(udg_hash,h,StringHash("UnUnHP"))
set s__Units_GAttack[sUnit[iuu]]=s__Units_GAttack[sUnit[iuu]]+dmg-LoadInteger(udg_hash,h,StringHash("UnUnAt"))
set s__Units_Arm[sUnit[iuu]]=s__Units_Arm[sUnit[iuu]]+b-LoadInteger(udg_hash,h,StringHash("UnUnAr"))
call SaveInteger(udg_hash,h,StringHash("UnUnAr"),b)
call SaveInteger(udg_hash,h,StringHash("UnUnAt"),dmg)
call SaveInteger(udg_hash,h,StringHash("UnUnHP"),hp)
elseif GetUnitAbilityLevel(u,'A12Q')>0 then
set r=0.01*GetUnitState(u,UNIT_STATE_MAX_LIFE)
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+r)
if GetUnitAbilityLevel(u,'A12Q')==2 then
set dmg=LoadInteger(udg_hash,h,StringHash("UnUnAt"))
set hp=LoadInteger(udg_hash,h,StringHash("UnUnHP"))
set s__Units_GAttack[sUnit[iuu]]=s__Units_GAttack[sUnit[iuu]]-dmg
set s__Units_HP[sUnit[iuu]]=s__Units_HP[sUnit[iuu]]-hp
if udg_BilderQuestOrc[24]==2 then
set b=LoadInteger(udg_hash,h,StringHash("UnUnAr"))
set s__Units_Arm[sUnit[iuu]]=s__Units_Arm[sUnit[iuu]]-b
set b=(8*(GetHeroAgi(udg_Hero[ID],true)/5+s__Units_Arm[sUnit[iuh]]))/10
set s__Units_Arm[sUnit[iuu]]=s__Units_Arm[sUnit[iuu]]+b
call SaveInteger(udg_hash,h,StringHash("UnUnAr"),b)
endif
set dmg=Summ_Attack(udg_Hero[ID])+1000
set hp=R2I(1.25*GetUnitState(udg_Hero[ID],UNIT_STATE_MAX_LIFE))
set s__Units_GAttack[sUnit[iuu]]=s__Units_GAttack[sUnit[iuu]]+dmg
set s__Units_HP[sUnit[iuu]]=s__Units_HP[sUnit[iuu]]+hp
call SaveInteger(udg_hash,h,StringHash("UnUnAt"),dmg)
call SaveInteger(udg_hash,h,StringHash("UnUnHP"),hp)
endif
elseif GetUnitTypeId(u)=='n04B' then
set dmg=LoadInteger(udg_hash,h,StringHash("UnUnAt"))
set hp=LoadInteger(udg_hash,h,StringHash("UnUnHP"))
set s__Units_GAttack[sUnit[iuu]]=s__Units_GAttack[sUnit[iuu]]-dmg
set s__Units_HP[sUnit[iuu]]=s__Units_HP[sUnit[iuu]]-hp
set dmg=GetHeroInt(udg_Hero[ID],true)
set hp=15*(GetHeroStr(udg_Hero[ID],true)+GetHeroInt(udg_Hero[ID],true))
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='ratf' then
set dmg=20+dmg
set hp=300+hp
endif
set a=100+R2I(100*LoadReal(udg_hash,hh,StringHash("SummonHP")))
set hp=a*hp/100
set a=100+R2I(100*LoadReal(udg_hash,hh,StringHash("SummonAT")))
set dmg=a*dmg/100
set a=0
loop
exitwhen a>=6
if GetItemTypeId(UnitItemInSlot(udg_Hero[ID],a))=='I0DU' then
set a=6
set hp=13*hp/10
set dmg=13*dmg/10
endif
set a=a+1
endloop
if IsUnitInGroup(udg_Hero[ID],udg_ItemComplectGroup[6])then
set hp=3*hp/2
endif
set s__Units_GAttack[sUnit[iuu]]=s__Units_GAttack[sUnit[iuu]]+dmg
set s__Units_HP[sUnit[iuu]]=s__Units_HP[sUnit[iuu]]+hp
call SaveInteger(udg_hash,h,StringHash("UnUnAt"),dmg)
call SaveInteger(udg_hash,h,StringHash("UnUnHP"),hp)
endif
call F_hp(u,s__Units_HP[sUnit[iuu]])
call F_Armore(u,s__Units_Arm[sUnit[iuu]])
call F_Attack(u,s__Units_GAttack[sUnit[iuu]])
set u=null
endfunction
function Trig_Timer01s_Battlefield takes nothing returns nothing
local unit u=GetEnumUnit()
local integer i
local integer h=GetHandleId(u)
set i=LoadInteger(udg_hash,h,StringHash("Battlefield"))
if i !=0 then
set i=i-1
call SaveInteger(udg_hash,h,StringHash("Battlefield"),i)
else
call GroupRemoveUnit(udg_BattlefieldUG,u)
call UnitRemoveAbility(u,'A13Z')
if LoadInteger(udg_hash,h,StringHash("Battlefield2"))==1 then
set i=LoadInteger(Hash,h,0)
set s__Units_AllBlock[sUnit[i]]=s__Units_AllBlock[sUnit[i]]-2500
call SaveInteger(udg_hash,h,StringHash("Battlefield2"),0)
endif
endif
set u=null
endfunction
function Boss_TreeWave1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit boss=LoadUnitHandle(udg_hash,ht,0)
local real x=LoadReal(udg_hash,ht,1)
local real y=LoadReal(udg_hash,ht,2)
local group g=CreateGroup()
local unit u
local player pl=GetOwningPlayer(boss)
local integer id=GetPlayerId(pl)
local real dmg=1+0.02*s__SetTechUP[id]
local group g2=LoadGroupHandle(udg_hash,GetHandleId(boss),StringHash("TreeWave1QG"))
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
set dmg=3000*dmg
set udg_Drop2=GetPlayerId(GetOwningPlayer(boss))
call GroupEnumUnitsInRange(g,x,y,250.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitInGroup(u,g2)==false then
call UnitDamageTarget(boss,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedUnit=CreateUnit(pl,'h009',x,y,0)
call UnitAddAbility(bj_lastCreatedUnit,'A093')
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',0.75)
call IssueTargetOrder(bj_lastCreatedUnit,"thunderbolt",u)
call GroupAddUnit(g2,u)
endif
call GroupRemoveUnit(g,u)
endloop
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
set g2=null
set pl=null
set boss=null
set g=null
set t=null
endfunction
function BossG_Timer01s takes nothing returns nothing
local unit boss=GetEnumUnit()
local integer h=GetHandleId(boss)
local group g
local unit u
local real x
local real y
local real x1
local real y1
local real r
local integer a=0
local timer t
local integer ht
if UnitAlive(boss)then
call UnitRemoveBuffsBJ(bj_REMOVEBUFFS_NEGATIVE,boss)
if GetUnitTypeId(boss)=='U01A' then
call SetUnitMoveSpeed(boss,522.00)
set r=0.002*GetUnitState(boss,UNIT_STATE_MAX_LIFE)
if GetUnitAbilityLevel(boss,'bssd')==1 or GetUnitAbilityLevel(boss,'Bspo')==1 or GetUnitAbilityLevel(boss,'Bpsd')==1 or GetUnitAbilityLevel(boss,'Bpoi')==1 then
set r=.75*r
endif
call SetUnitState(boss,UNIT_STATE_LIFE,GetUnitState(boss,UNIT_STATE_LIFE)+0.85*r)
endif
if GetUnitTypeId(boss)=='Ecen' and LoadBoolean(udg_hash,h,StringHash("Cenarius"))==false then
call SaveInteger(udg_hash,GetHandleId(boss),'q',LoadInteger(udg_hash,GetHandleId(boss),'q')+1)
set g=CreateGroup()
set x=GetUnitX(boss)
set y=GetUnitY(boss)
set udg_Drop2=GetPlayerId(GetOwningPlayer(boss))
call GroupEnumUnitsInRange(g,x,y,800.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitType(u,UNIT_TYPE_HERO)then
set x=GetUnitX(u)
set y=GetUnitY(u)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(boss),'h009',x,y,0)
call UnitAddAbility(bj_lastCreatedUnit,'A0NP')
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',3.)
call IssueTargetOrder(bj_lastCreatedUnit,"entanglingroots",u)
endif
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
call Func_CD(boss,"Cenarius",25)
endif
if GetUnitTypeId(boss)=='eden' and LoadBoolean(udg_hash,h,StringHash("TreeWave1Q"))==false then
set g=LoadGroupHandle(udg_hash,h,StringHash("TreeWave1QG"))
if g !=null then
call DestroyGroup(g)
endif
set g=CreateGroup()
set udg_Drop2=GetPlayerId(GetOwningPlayer(boss))
call GroupEnumUnitsInRange(g,GetUnitX(boss),GetUnitY(boss),1200,Bool_Filter_ID)
call RandomUnitFromGroup(4,g)
set a=0
loop
set u=FirstOfGroup(g)
exitwhen u==null
set a=1
set x1=GetUnitX(u)
set y1=GetUnitY(u)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(boss),'h02P',GetUnitX(boss),GetUnitY(boss),GetUnitFacing(boss))
set x=x1-GetUnitX(boss)
set y=y1-GetUnitY(boss)
set r=SquareRoot(x*x+y*y)/800.
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',1.)
call IssuePointOrder(bj_lastCreatedUnit,"attackground",x1,y1)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,boss)
call SaveReal(udg_hash,ht,1,x1)
call SaveReal(udg_hash,ht,2,y1)
call TimerStart(t,r,false,function Boss_TreeWave1)
call GroupRemoveUnit(g,u)
endloop
if a==1 then
call SaveGroupHandle(udg_hash,h,StringHash("TreeWave1QG"),CreateGroup())
call Func_CD(boss,"TreeWave1Q",10)
endif
call DestroyGroup(g)
endif
endif
set boss=null
set u=null
set g=null
set t=null
endfunction
