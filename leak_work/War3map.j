function MonolitEffect_DMG takes nothing returns nothing
local real x
local real y
if udg_noSplash==false and GetUnitTypeId(udg_DamageEventSource)=='u022' then
set udg_noSplash=true
call GroupClear(DamageEventG)
set x=GetUnitX(udg_DamageEventTarget)
set y=GetUnitY(udg_DamageEventTarget)
call GroupEnumUnitsInRange(DamageEventG,x,y,475.,g_condDop2)
call ForGroup(DamageEventG,function MonolitEffect_DMG_G)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(udg_DamageEventSource),'h04V',x,y,0)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',2.)
set udg_noSplash=false
endif
endfunction
