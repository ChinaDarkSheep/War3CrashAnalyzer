call ForGroupBJ(udg_ug,function Trig_EP_Attacks_Func001Func003A)
call DestroyGroup(udg_ug)
call PingMinimapLocForForceEx(GetForceOfPlayer(udg_EvilPlayer),udg_EPPoints[udg_Drop],4.00,bj_MINIMAPPINGSTYLE_SIMPLE,0.00,100.00,0.00)
else
