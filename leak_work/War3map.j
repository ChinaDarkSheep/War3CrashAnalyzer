set y=yh+150*Sin(40*bj_forLoopAIndex*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("war3mapImported\\AerialExplosionV3.mdx",x,y))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>12
set x=xh+230*Cos(30*bj_forLoopAIndex*bj_DEGTORAD)
set y=yh+230*Sin(30*bj_forLoopAIndex*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("war3mapImported\\AerialExplosionV3.mdx",x,y))
