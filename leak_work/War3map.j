elseif udg_RandomHero[udg_Drop]=='E00W' and s___Struct_Player_UnLockHero[s__Struct_Player_UnLockHero[S_Player[udg_Drop2-1]]+2]then
set bj_lastCreatedUnit=CreateUnitAtLoc(udg_RHPlayer,'E011',udg_p,bj_UNIT_FACING)
elseif udg_RandomHero[udg_Drop]=='U02B' and s___Struct_Player_UnLockHero[s__Struct_Player_UnLockHero[S_Player[udg_Drop2-1]]+3]then
set bj_lastCreatedUnit=CreateUnitAtLoc(udg_RHPlayer,'U02J',udg_p,bj_UNIT_FACING)
elseif udg_RandomHero[udg_Drop]=='Oshd' and s___Struct_Player_UnLockHero[s__Struct_Player_UnLockHero[S_Player[udg_Drop2-1]]+4]then
set bj_lastCreatedUnit=CreateUnitAtLoc(udg_RHPlayer,'O013',udg_p,bj_UNIT_FACING)
else
set bj_lastCreatedUnit=CreateUnitAtLoc(udg_RHPlayer,udg_RandomHero[udg_Drop],udg_p,bj_UNIT_FACING)
endif
set udg_ZapretHeroes[udg_Drop2]=udg_RandomHero[udg_Drop2]
call RemoveLocation(udg_p)
if GetEventPlayerChatString()=="-random any" then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFFFFDC00Получено 1250 ед. золота за выбор случайного героя!|r")
call AdjustPlayerStateBJ(250,udg_RHPlayer,PLAYER_STATE_RESOURCE_GOLD)
else
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFFFFDC00Получено 1000 ед. золота за выбор случайного героя!|r")
endif
call AdjustPlayerStateBJ(1000,udg_RHPlayer,PLAYER_STATE_RESOURCE_GOLD)
endif
endif
else
set udg_Drop=GetRandomInt(1,66)
set udg_Drop2=0
if(udg_RandomHero[udg_Drop]==udg_ZapretHeroes[1]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[2]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[3]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[4]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[5]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[6]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[7]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[8]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[9]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[10]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[11]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[12]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[13]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[14]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[15]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[16]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[17]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[18]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[19]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[20]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[21]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[22]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[23]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[24]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[25]or udg_RandomHero[udg_Drop]==udg_ZapretHeroes[26])then
set udg_Drop2=1
endif
call ForGroup(udg_AllHeroes,function Trig_RandomHero_Func003Func004A)
if udg_Drop2==1 then
call ConditionalTriggerExecute(gg_trg_RandomHero)
else
set udg_RHLogic=false
set udg_p=GetRectCenter(gg_rct_HeroPick)
set udg_Drop2=GetConvertedPlayerId(udg_RHPlayer)
if udg_RandomHero[udg_Drop]=='E00H' and s___Struct_Player_UnLockHero[s__Struct_Player_UnLockHero[S_Player[udg_Drop2-1]]]then
set bj_lastCreatedUnit=CreateUnitAtLoc(udg_RHPlayer,'E00Z',udg_p,bj_UNIT_FACING)
elseif udg_RandomHero[udg_Drop]=='Obla' and s___Struct_Player_UnLockHero[s__Struct_Player_UnLockHero[S_Player[udg_Drop2-1]]+1]then
set bj_lastCreatedUnit=CreateUnitAtLoc(udg_RHPlayer,'O012',udg_p,bj_UNIT_FACING)
elseif udg_RandomHero[udg_Drop]=='E00W' and s___Struct_Player_UnLockHero[s__Struct_Player_UnLockHero[S_Player[udg_Drop2-1]]+2]then
set bj_lastCreatedUnit=CreateUnitAtLoc(udg_RHPlayer,'E011',udg_p,bj_UNIT_FACING)
elseif udg_RandomHero[udg_Drop]=='U02B' and s___Struct_Player_UnLockHero[s__Struct_Player_UnLockHero[S_Player[udg_Drop2-1]]+3]then
set bj_lastCreatedUnit=CreateUnitAtLoc(udg_RHPlayer,'U02J',udg_p,bj_UNIT_FACING)
elseif udg_RandomHero[udg_Drop]=='Oshd' and s___Struct_Player_UnLockHero[s__Struct_Player_UnLockHero[S_Player[udg_Drop2-1]]+4]then
set bj_lastCreatedUnit=CreateUnitAtLoc(udg_RHPlayer,'O013',udg_p,bj_UNIT_FACING)
else
set bj_lastCreatedUnit=CreateUnitAtLoc(udg_RHPlayer,udg_RandomHero[udg_Drop],udg_p,bj_UNIT_FACING)
endif
set udg_ZapretHeroes[udg_Drop2]=udg_RandomHero[udg_Drop]
call RemoveLocation(udg_p)
if GetPlayerTechCountSimple('R02B',Player(0))>=11 then
call AdjustPlayerStateBJ(500,udg_RHPlayer,PLAYER_STATE_RESOURCE_GOLD)
endif
