function ArtaQ takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local unit rocket=LoadUnitHandle(udg_hash,ht,1)
local real sec=LoadReal(udg_hash,ht,2)
local integer lvl=GetUnitAbilityLevel(hero,'A0B9')
local real dmg=lvl*200+(0.25+0.35*lvl)*Summ_Attack(hero)
local unit u
local group g=CreateGroup()
local group g2=LoadGroupHandle(udg_hash,ht,3)
local integer aa
local integer ad
local real x=GetUnitX(rocket)
local real y=GetUnitY(rocket)
if sec>0 then
if GetUnitAbilityLevel(hero,'A0BQ')==1 then
set aa=0
set ad=26
else
set aa=5
set ad=4
endif
set sec=sec-0.03
call SaveReal(udg_hash,ht,2,sec)
set udg_Drop2=GetPlayerId(GetOwningPlayer(hero))
call GroupEnumUnitsInRange(g,x,y,300,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitInGroup(u,g2)==false then
call UnitDamageTarget(hero,u,dmg,false,true,ConvertAttackType(aa),ConvertDamageType(ad),WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupAddUnit(g2,u)
endif
call GroupRemoveUnit(g,u)
endloop
else
call DestroyGroup(g2)
call RemoveUnit(rocket)
call FlushChildHashtable(udg_hash,GetHandleId(rocket))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
call DestroyGroup(g)
set t=null
set hero=null
set rocket=null
set u=null
set g=null
set g2=null
endfunction
function Trig_ArtaSkills_Actions takes nothing returns nothing
local unit hero=GetTriggerUnit()
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local unit u
local real xh=GetUnitX(hero)
local real yh=GetUnitY(hero)
local real x
local real y
local real x1
local real y1
local real dmg
local real r
local real z
local timer t
local integer ht
if GetSpellAbilityId()=='A0B9' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set u=CreateUnit(Player(ID-1),'h058',xh,yh,bj_RADTODEG*Atan2(y-yh,x-xh))
call KnockBackUnit(u,1800,2.1,bj_RADTODEG*Atan2(y-yh,x-xh),0.03)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveUnitHandle(udg_hash,ht,1,u)
call SaveReal(udg_hash,ht,2,2.13)
call SaveGroupHandle(udg_hash,ht,3,CreateGroup())
call TimerStart(t,0.03,true,function ArtaQ)
endif
if GetSpellAbilityId()=='A067' then
call SetPlayerTechResearchedSwap('R00O',GetUnitAbilityLevelSwapped('A067',GetSpellAbilityUnit()),GetOwningPlayer(GetSpellAbilityUnit()))
