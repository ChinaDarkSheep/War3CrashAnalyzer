function Trig_Al_kill_Actions takes nothing returns nothing
local real gold
local integer drop
local integer ID=GetPlayerId(GetOwningPlayer(udg_HumanBuilder))+1
local integer lvl=GetUnitLevel(GetDyingUnit())
local real x
local real y
if GetOwningPlayer(GetKillingUnitBJ())==Player(9)and IsUnitEnemy(GetDyingUnit(),GetOwningPlayer(GetKillingUnitBJ()))and GetUnitTypeId(GetKillingUnitBJ())!='u00L' and GetPlayerController(GetOwningPlayer(GetDyingUnit()))!=MAP_CONTROL_USER and GetUnitAbilityLevelSwapped('Avul',GetDyingUnit())!=1 then
if udg_HeroGold[ID]>0.00 then
set gold=lvl+3+lvl*(lvl+1)
if GetInventoryIndexOfItemTypeBJ(udg_Hero[ID],'I069')>0 then
set gold=gold+1
endif
if GetPlayerTechCount(Player(ID-1),'R02B',true)>12 then
set gold=gold+1
endif
if IsUnitInGroup(GetDyingUnit(),udg_behelit)then
if GetUnitLevel(GetDyingUnit())<11 then
set gold=gold+0.4*GetUnitLevel(GetDyingUnit())
else
set gold=gold+0.2*GetUnitLevel(GetDyingUnit())
endif
call GroupRemoveUnit(udg_behelit,GetDyingUnit())
endif
if udg_HeroGold[ID]>udg_HeroGoldMax[ID]then
set gold=gold*udg_HeroGoldMax[ID]
else
set gold=gold*udg_HeroGold[ID]
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='mcou' then
if IsUnitType(GetDyingUnit(),UNIT_TYPE_HERO)or(lvl>=15 and ModuloInteger(lvl,5)==0)then
set gold=2*gold
endif
endif
if GetUnitAbilityLevel(GetDyingUnit(),'A0G6')==1 and(udg_Time[2]>=30 or udg_Time[3]>=1)then
set gold=10+1.5*gold
endif
if GetUnitAbilityLevel(GetKillingUnit(),'A0G6')==1 then
if GetRandomInt(1,10)>=2 then
set gold=2*gold
endif
endif
if udg_Setstart==true then
set gold=0.5*gold
endif
if IsUnitInGroup(GetDyingUnit(),udg_CrowW)==true then
set gold=1.75*gold
call GroupRemoveUnitSimple(GetDyingUnit(),udg_CrowW)
endif
if GetUnitTypeId(GetKillingUnit())=='n04B' then
set x=GetUnitX(udg_Hero[ID])-GetUnitX(GetKillingUnit())
set y=GetUnitY(udg_Hero[ID])-GetUnitY(GetKillingUnit())
if SquareRoot(x*x+y*y)>=2000. then
set gold=0.5*gold
endif
endif
set x=GetUnitX(udg_Hero[ID])-GetUnitX(GetDyingUnit())
set y=GetUnitY(udg_Hero[ID])-GetUnitY(GetDyingUnit())
if SquareRoot(x*x+y*y)>=4000. then
set gold=0.86*gold
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='mcou' then
set gold=gold+4+GetUnitLevel(GetDyingUnit())
endif
if GetUnitAbilityLevel(GetDyingUnit(),'A1DX')==1 then
set gold=gold/2
endif
set gold=gold*AllGold[ID]
set drop=R2I(gold)
call AdjustPlayerStateBJ(drop,ConvertedPlayer(ID),PLAYER_STATE_RESOURCE_GOLD)
set GoldNT[GetPlayerId(GetOwningPlayer(GetKillingUnit()))+1]=GoldNT[GetPlayerId(GetOwningPlayer(GetKillingUnit()))+1]+drop
call CreateTextTagUnitBJ(("|cFFFFDC00+"+I2S(drop)),GetDyingUnit(),0,10.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call ShowTextTagForceBJ(false,udg_TEXT,GetPlayersAll())
call ShowTextTagForceBJ(true,udg_TEXT,bj_FORCE_PLAYER[ID-1])
call SetTextTagVelocityBJ(udg_TEXT,75.00,90.00)
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
endif
else
endif
endfunction
