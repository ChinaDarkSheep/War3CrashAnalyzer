function Trig_RaiderSkills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer h=GetHandleId(caster)
local integer id=GetPlayerId(GetOwningPlayer(caster))
local integer ID=id+1
local real x
local real y
local group g=CreateGroup()
local timer t
local integer ht
local integer a
local integer b
local boolean bool=false
local unit u
local unit u2
local integer ihc=ReturnTypeHeroId(h)
if GetSpellAbilityId()=='A07N' then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set u=GetSpellTargetUnit()
set u2=CreateUnit(GetOwningPlayer(caster),'h009',x,y,bj_UNIT_FACING)
call UnitAddAbility(u2,'A07P')
call IssueTargetOrder(u2,"faeriefire",u)
call SetUnitAbilityLevel(u2,'A07P',GetUnitAbilityLevel(caster,'A07N'))
call UnitApplyTimedLife(u2,'BTLF',.75)
set b=LoadInteger(Hash,h,StringHash("RandomQ"))
set a=GetRandomInt(1,100-b)
if a<=33 then
set b=0
call CreateTextTagUnitBJ("|cFFFF0000Ловчий",caster,0,10.00,50.00,100,50.00,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
set udg_Drop2=id
call GroupEnumUnitsInRange(g,x,y,300.,Condition(function Trig_Filter_ID))
loop
set u=FirstOfGroup(g)
exitwhen u==null
set u2=CreateUnit(GetOwningPlayer(caster),'h009',x,y,bj_UNIT_FACING)
call UnitAddAbility(u2,'A07S')
call IssueTargetOrder(u2,"ensnare",u)
call UnitApplyTimedLife(u2,'BTLF',.75)
set u2=CreateUnit(GetOwningPlayer(caster),'h009',x,y,bj_UNIT_FACING)
call UnitAddAbility(u2,'A07P')
call IssueTargetOrder(u2,"faeriefire",u)
call SetUnitAbilityLevel(u2,'A07P',GetUnitAbilityLevel(caster,'A07N'))
call UnitApplyTimedLife(u2,'BTLF',.75)
call GroupRemoveUnit(g,u)
endloop
else
set b=b+2
endif
call SaveInteger(Hash,h,StringHash("RandomQ"),b)
if udg_Talante[ID]==1 then
set a=3*(GetHeroAgi(caster,true)+s__Heroes_BaseDmg[sHero[ihc]])/10
if GetHeroLevel(caster)>=50 then
set a=R2I(a*LoadReal(udg_hash,GetHandleId(caster),4))
endif
call TempStats(caster,0,0,0,a,0,0,PositiveDuration(caster,9))
endif
else
endif
if GetSpellAbilityId()=='A07Q' then
if udg_Talante[ID]==1 then
call UnitAddAbility(caster,'A0XS')
set x=GetUnitX(caster)
set y=GetUnitY(caster)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",x,y))
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,10,false,function Raider_R)
elseif udg_Talante[ID]==2 then
if GetRandomInt(1,3)==1 then
call CreateTextTagUnitBJ("|cFFFF0000Набег",caster,0,10.00,50.00,100,50.00,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
set bj_forLoopAIndexEnd=5
else
set bj_forLoopAIndexEnd=4
endif
set a=R2I(GetHeroStr(caster,true)*8.+GetHeroInt(caster,true)*12.)
set b=R2I(GetHeroInt(caster,true))
if GetHeroLevel(caster)>=50 then
set a=a*2
set bool=true
endif
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set x=GetUnitX(caster)+125*Cos(GetUnitFacing(caster)*bj_DEGTORAD)
set y=GetUnitY(caster)+125*Sin(GetUnitFacing(caster)*bj_DEGTORAD)
set u2=CreateUnit(GetOwningPlayer(caster),'nwwf',x,y,GetUnitFacing(caster))
if bool then
call F_LvlUPAblity(u2,'A1BF',10)
endif
call UnitAddAbility(u2,'A17O')
call SetUnitAbilityLevel(u2,'A17O',8)
call UnitAddAbility(u2,'A13N')
call UnitAddAbility(u2,'A007')
call SummonStats(true,a,b,u2,caster)
call UnitRemoveAbility(u2,'A007')
call UnitApplyTimedLifeBJ(30,'BTLF',u2)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
endif
if GetSpellAbilityId()=='A07O' then
if udg_Talante[ID]==1 then
call TempStats(caster,0,0,0,0,GetHeroAgi(caster,true)/5,0,PositiveDuration(caster,4))
endif
set b=LoadInteger(Hash,h,StringHash("RandomW"))
set a=GetRandomInt(1,100-b)
if a<=20 then
set b=0
call AddSpecialEffectTargetUnitBJ("origin",caster,"Abilities\\Spells\\Human\\Heal\\HealTarget.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call CreateTextTagUnitBJ("|cFFFF0000Рев",caster,0,10.00,50.00,100,50.00,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
call SetUnitLifePercentBJ(caster,(GetUnitLifePercent(caster)+30.00))
else
set b=b+2
endif
call SaveInteger(Hash,h,StringHash("RandomW"),b)
else
endif
if GetSpellAbilityId()=='A18V' then
call GroupEnumUnitsOfPlayer(g,GetOwningPlayer(caster),Condition(function Trig_RaiderSkills_fD))
call ForGroup(g,function Trig_RaiderSkills_gD)
call GroupClear(g)
set a=R2I(I2R(GetHeroStr(caster,true))*20.00+GetHeroInt(caster,true)*20.0)
set b=R2I(I2R(GetHeroInt(caster,true))*2.0)
if GetHeroLevel(caster)>=50 then
set a=a*2
set b=b*2
endif
set x=GetUnitX(caster)+150*Cos(GetUnitFacing(caster)*bj_DEGTORAD)
set y=GetUnitY(caster)+150*Sin(GetUnitFacing(caster)*bj_DEGTORAD)
set u2=CreateUnit(GetOwningPlayer(caster),'n06J',x,y,GetUnitFacing(caster))
if GetHeroLevel(caster)>=3 then
call UnitAddAbility(u2,'A17O')
call SetUnitAbilityLevel(u2,'A17O',GetHeroLevel(caster)/3+1)
if GetHeroLevel(caster)>=50 then
call UnitAddAbility(u2,'A13N')
call SetUnitAbilityLevel(u2,'A13N',3)
endif
endif
call UnitAddAbilityBJ('A007',u2)
call SummonStats(true,a,b,u2,caster)
call UnitRemoveAbilityBJ('A007',u2)
call UnitApplyTimedLifeBJ(60,'BTLF',u2)
else
endif
call DestroyGroup(g)
set g=null
set u=null
set u2=null
set caster=null
endfunction
function InitTrig_RaiderSkills takes nothing returns nothing
set gg_trg_RaiderSkills=CreateTrigger()
call TriggerAddAction(gg_trg_RaiderSkills,function Trig_RaiderSkills_Actions)
endfunction
function Trig_MagnSkills_Q takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local real xt=LoadReal(udg_hash,ht,0)
local real yt=LoadReal(udg_hash,ht,1)
local real xm=LoadReal(udg_hash,ht,2)
local real ym=LoadReal(udg_hash,ht,3)
local real sec=LoadReal(udg_hash,ht,4)
local real angle
local real dmg
if sec>0 then
if GetHeroLevel(hero)>49 then
set dmg=0.6*GetHeroStr(hero,true)+25.*GetUnitAbilityLevel(hero,'A0KK')
else
set dmg=0.4*GetHeroStr(hero,true)+25.*GetUnitAbilityLevel(hero,'A0KK')
endif
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl",xm,ym)
call DestroyEffect(bj_lastCreatedEffect)
call GroupDamage(xm,ym,225.,hero,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
set angle=bj_RADTODEG*Atan2(yt-ym,xt-xm)
set xm=xm+100.*Cos(angle*bj_DEGTORAD)
set ym=ym+100.*Sin(angle*bj_DEGTORAD)
call SaveReal(udg_hash,ht,2,xm)
call SaveReal(udg_hash,ht,3,ym)
set sec=sec-0.15
call SaveReal(udg_hash,ht,4,sec)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
set hero=null
endfunction
function Trig_MagnSkills_W takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local real x=LoadReal(udg_hash,ht,0)
local real y=LoadReal(udg_hash,ht,1)
local integer sec=LoadInteger(udg_hash,ht,3)
local unit u
local real dmg
local group g=CreateGroup()
local integer a=0
if sec>0 then
set sec=sec-1
call SaveInteger(udg_hash,ht,3,sec)
if GetHeroLevel(caster)>49 then
set dmg=1.4*GetHeroStr(caster,true)
else
set dmg=0.8*GetHeroStr(caster,true)
endif
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,300.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set a=a+1
call GroupRemoveUnit(g,u)
endloop
call SetUnitState(udg_Cris,UNIT_STATE_MANA,GetUnitState(udg_Cris,UNIT_STATE_MANA)+a*(1.+0.5*GetUnitAbilityLevel(caster,'A0KL')))
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
call DestroyGroup(g)
set t=null
set caster=null
set u=null
set g=null
endfunction
function Trig_MagnSkills_Actions takes nothing returns nothing
local unit hero=GetTriggerUnit()
local real x
local real y
local real x1
local real y1
local real angle
local real dmg
local timer t
local integer ht
local integer a
if GetSpellAbilityId()=='A0CB' then
if udg_MagnRP !=null then
call RemoveLocation(udg_MagnRP)
endif
set udg_MagnRP=GetSpellTargetLoc()
call StartTimerBJ(udg_MagnR,true,1.00)
endif
if GetSpellAbilityId()=='A0KL' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(hero),'h03H',x,y,0)
call UnitAddAbility(bj_lastCreatedUnit,'A0KM')
call SetUnitAbilityLevel(bj_lastCreatedUnit,'A0KM',GetUnitAbilityLevel(hero,'A0KL'))
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',12.)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveReal(udg_hash,ht,0,x)
call SaveReal(udg_hash,ht,1,y)
call SaveInteger(udg_hash,ht,3,12)
call TimerStart(t,1,true,function Trig_MagnSkills_W)
endif
if GetSpellAbilityId()=='A0KK' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set t=CreateTimer()
set ht=GetHandleId(t)
set angle=bj_RADTODEG*Atan2(y-GetUnitY(hero),x-GetUnitX(hero))
set x1=GetUnitX(hero)+60.*Cos(angle*bj_DEGTORAD)
set y1=GetUnitY(hero)+60.*Sin(angle*bj_DEGTORAD)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveReal(udg_hash,ht,0,x)
call SaveReal(udg_hash,ht,1,y)
call SaveReal(udg_hash,ht,2,x1)
call SaveReal(udg_hash,ht,3,y1)
call SaveReal(udg_hash,ht,4,2.4)
call TimerStart(t,0.15,true,function Trig_MagnSkills_Q)
endif
if GetSpellAbilityId()=='A085' then
set x=GetUnitX(hero)
set y=GetUnitY(hero)
set dmg=10*GetHeroStr(hero,true)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(hero),'h04G',x,y,0.)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',3.30)
call GroupDamage(x,y,1500.,hero,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
endif
if GetSpellAbilityId()=='A082' then
call RemoveUnit(udg_Cris)
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set udg_Cris=CreateUnit(GetOwningPlayer(hero),'h03G',x,y,bj_UNIT_FACING)
call UnitAddAbility(hero,'A0KE')
endif
if GetSpellAbilityId()=='A0KE' then
set a=R2I(GetUnitStateSwap(UNIT_STATE_MANA,udg_Cris))
set x1=GetUnitX(udg_Cris)
set y1=GetUnitY(udg_Cris)
set x=GetUnitX(hero)
set y=GetUnitY(hero)
call PauseUnitBJ(true,hero)
call SelectUnitRemoveForPlayer(hero,GetOwningPlayer(hero))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl",x1,y1))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl",x,y))
call SetUnitPosition(hero,x1,y1)
call PauseUnitBJ(false,hero)
call SelectUnitForPlayerSingle(hero,GetOwningPlayer(hero))
call UnitRemoveAbility(hero,'A0KE')
if a>=100 then
call ModifyHeroStat(bj_HEROSTAT_STR,hero,bj_MODIFYMETHOD_ADD,(a/100))
call ModifyHeroStat(bj_HEROSTAT_INT,hero,bj_MODIFYMETHOD_ADD,(a/200))
endif
call SetUnitLifeBJ(hero,(GetUnitStateSwap(UNIT_STATE_LIFE,hero)+GetUnitStateSwap(UNIT_STATE_MANA,udg_Cris)))
if a>=100 then
call CreateTextTagUnitBJ("|cFF07EDE6+"+I2S(a/100)+" силы и +"+I2S(a/200)+" разум",hero,0,15.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,90.00)
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
endif
call RemoveUnit(udg_Cris)
endif
set hero=null
set t=null
endfunction
