endif
elseif udg_QuestNumber==2 and udg_Quest3Portal then
set BHelpGoblinText=true
set udg_StartQuests=4
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Хм там оказался портал из которого вылезла орда нежити? Хм... Хорошо, данная информация может пригодится. Ну а ты, держи награду")
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFFFFDC00Вы прошли задание\nНаграда: Костюм путешественника")
call UnitAddItemByIdSwapped('I0A1',udg_u)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl",udg_u,"origin"))
set udg_QuestNumber=GetRandomInt(1,2)
if udg_QuestNumber==1 then
call EnableTrigger(gg_trg_KillBandits)
call ForceAddPlayerSimple(Player(id),udg_Quests[5])
