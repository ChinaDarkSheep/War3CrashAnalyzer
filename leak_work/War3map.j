function Cast_FireLord_E takes nothing returns nothing
local integer talante=udg_Talante[GetPlayerId(GetOwningPlayer(udg_FireLord))+1]
local integer lvl=GetUnitAbilityLevel(udg_FireLord,'A03H')
local real damage=lvl*45+0.4*GetHeroInt(udg_FireLord,true)
local timer t3=GetExpiredTimer()
local integer ht=GetHandleId(t3)
local trigger endCast=LoadTriggerHandle(udg_hash,ht,2)
local real x=LoadReal(udg_hash,ht,0)
local real y=LoadReal(udg_hash,ht,1)
local real r=230
if lvl==2 then
set r=250
else
if lvl==3 then
set r=275
else
if lvl==4 then
set r=300
else
if lvl==5 then
set r=330
endif
endif
endif
endif
if GetHeroLevel(udg_FireLord)>=50 then
set damage=damage+0.4*GetHeroInt(udg_FireLord,true)
if talante==1 then
set damage=damage+0.6*GetHeroInt(udg_FireLord,true)
endif
endif
if talante==1 then
set damage=damage+0.6*GetHeroInt(udg_FireLord,true)
endif
set damage=damage*0.33
call SaveInteger(udg_hash,ht,1,9)
call SaveReal(udg_hash,ht,4,damage)
call SaveReal(udg_hash,ht,2,x)
call SaveReal(udg_hash,ht,3,y)
call SaveReal(udg_hash,ht,10,r)
call FlushChildHashtable(udg_hash,GetHandleId(endCast))
call DestroyTrigger(endCast)
call TimerStart(t3,0.33,true,function Trig_FireMage_PerE)
set endCast=null
set t3=null
endfunction
function Trig_FireLord_Actions takes nothing returns nothing
local location p
local location p2
local unit u
local unit target
local integer lvl
local integer ht
local integer talante=udg_Talante[GetPlayerId(GetOwningPlayer(udg_FireLord))+1]
local real damage
local timer t
local real x
local real y
local group g=CreateGroup()
local trigger endCast
if GetSpellAbilityId()=='A03H' then
set endCast=CreateTrigger()
set ht=GetHandleId(endCast)
call TriggerRegisterUnitEvent(endCast,udg_FireLord,EVENT_UNIT_SPELL_ENDCAST)
call TriggerAddAction(endCast,function End_Cast_FireLord)
set t=CreateTimer()
call SaveTimerHandle(udg_hash,ht,0,t)
set ht=GetHandleId(t)
set x=GetSpellTargetX()
set y=GetSpellTargetY()
call SaveReal(udg_hash,ht,0,x)
call SaveReal(udg_hash,ht,1,y)
call SaveTriggerHandle(udg_hash,ht,2,endCast)
call TimerStart(t,1.33,false,function Cast_FireLord_E)
endif
if GetSpellAbilityId()=='A01A' then
set damage=150*GetUnitAbilityLevel(udg_FireLord,'A01A')+4.*GetHeroInt(udg_FireLord,true)
if GetHeroLevel(udg_FireLord)>=50 then
set damage=damage+2.*GetHeroInt(udg_FireLord,true)
endif
if talante==1 then
set damage=2.*damage
endif
set target=GetSpellTargetUnit()
set p=GetUnitLoc(udg_FireLord)
set p2=GetUnitLoc(target)
call TriggerSleepAction(DistanceBetweenPoints(p,p2)/1500.00)
call RemoveLocation(p)
call RemoveLocation(p2)
call UnitDamageTarget(udg_FireLord,target,damage,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
if talante==1 then
set x=GetUnitX(target)
set y=GetUnitY(target)
set damage=0.5*damage
set udg_Drop2=GetPlayerId(GetOwningPlayer(udg_FireLord))
call GroupEnumUnitsInRange(g,x,y,500.,Bool_Filter_ID)
call GroupRemoveUnit(g,target)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(udg_FireLord,u,damage,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
call TriggerSleepAction(1.)
if UnitAlive(target)==false then
set udg_FireLordFdamage=udg_FireLordFdamage+25.
endif
endif
endif
if GetSpellAbilityId()=='A018' then
set p=GetSpellTargetLoc()
set x=GetSpellTargetX()
set y=GetSpellTargetY()
call CreateNUnitsAtLoc(1,'o001',GetOwningPlayer(udg_FireLord),p,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(2.85,'BTLF',GetLastCreatedUnit())
call TriggerSleepAction(0.85)
call AddSpecialEffectLocBJ(p,"war3mapImported\\NewDirtEXNofire.mdx")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=6
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call AddSpecialEffectLocBJ(PolarProjectionBJ(p,256,(60.00*I2R(GetForLoopIndexA()))),"war3mapImported\\NewDirtEXNofire.mdx")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call RemoveLocation(p)
set damage=5*GetHeroInt(udg_FireLord,true)
if talante==1 then
set damage=damage+10*GetHeroInt(udg_FireLord,true)
elseif talante==2 then
set damage=damage+0.5*GetUnitState(udg_FireLord,UNIT_STATE_MAX_LIFE)
endif
set udg_Drop2=GetPlayerId(GetOwningPlayer(udg_FireLord))
call GroupEnumUnitsInRange(g,x,y,450.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(udg_FireLord,u,damage,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
endif
if GetSpellAbilityId()=='A016' then
set x=GetUnitX(udg_FireLord)
set y=GetUnitY(udg_FireLord)
set bj_lastCreatedEffect=AddSpecialEffect("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
set damage=70*GetUnitAbilityLevel(udg_FireLord,'A016')+0.04*GetUnitState(udg_FireLord,UNIT_STATE_MAX_LIFE)
if talante==1 then
set damage=damage+4*GetHeroInt(udg_FireLord,true)
if GetHeroLevel(udg_FireLord)>=50 then
set damage=damage+2*GetHeroInt(udg_FireLord,true)
endif
elseif talante==2 then
set damage=damage+0.4*GetUnitState(udg_FireLord,UNIT_STATE_LIFE)
call SetUnitState(udg_FireLord,UNIT_STATE_LIFE,0.8*GetUnitState(udg_FireLord,UNIT_STATE_LIFE))
endif
set udg_Drop2=GetPlayerId(GetOwningPlayer(udg_FireLord))
call GroupEnumUnitsInRange(g,x,y,500.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(udg_FireLord,u,damage,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
endif
if GetSpellAbilityId()=='A19Z' then
set lvl=15*GetHeroStr(udg_FireLord,true)+10*GetHeroInt(udg_FireLord,true)
set damage=1.5*GetHeroInt(udg_FireLord,true)
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>3
