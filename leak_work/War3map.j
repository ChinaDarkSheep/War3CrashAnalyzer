function Trig_TikondrusD_Conditions takes nothing returns boolean
if(not(GetKillingUnit()==udg_Tikondrus))then
return false
endif
return true
endfunction
function Trig_TikondrusD_Actions takes nothing returns nothing
local real x
local real y
if GetRandomInt(1,5)==1 and udg_Talante[GetPlayerId(GetOwningPlayer(udg_Tikondrus))+1]==2 and not LoadBoolean(udg_hash,GetHandleId(udg_Tikondrus),StringHash("VampD"))then
set x=GetUnitX(GetDyingUnit())
set y=GetUnitY(GetDyingUnit())
set bj_lastCreatedEffect=AddSpecialEffect("Objects\\Spawnmodels\\Orc\\OrcSmallDeathExplode\\OrcSmallDeathExplode.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(udg_Tikondrus),'u000',x,y,GetRandomInt(1,255))
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',45.)
call UnitAddAbility(bj_lastCreatedUnit,'A129')
call UnitAddAbility(bj_lastCreatedUnit,'A12I')
if udg_Talante[GetPlayerId(GetOwningPlayer(udg_Tikondrus))+1]==2 and GetUnitAbilityLevel(udg_Tikondrus,'A0XV')==1 then
call UnitAddAbility(bj_lastCreatedUnit,'A17O')
call SetUnitAbilityLevel(bj_lastCreatedUnit,'A17O',GetUnitAbilityLevel(udg_Tikondrus,'A0B6')*2+1)
call UnitAddAbility(bj_lastCreatedUnit,'A007')
call SummonStats(true,R2I(12.*GetHeroStr(udg_Tikondrus,true)+4.*GetHeroInt(udg_Tikondrus,true)),R2I(0.4*GetHeroStr(udg_Tikondrus,true)),bj_lastCreatedUnit,udg_Tikondrus)
call UnitRemoveAbility(bj_lastCreatedUnit,'A007')
if GetUnitAbilityLevel(bj_lastCreatedUnit,'A1BF')==0 then
call UnitAddAbility(bj_lastCreatedUnit,'A1BF')
endif
call SetUnitAbilityLevel(bj_lastCreatedUnit,'A1BF',GetUnitAbilityLevel(bj_lastCreatedUnit,'A1BF')+10)
endif
call Func_CD(udg_Tikondrus,"VampD",10.)
endif
endfunction
