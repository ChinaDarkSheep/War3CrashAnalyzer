set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'h05G',GetUnitX(caster),GetUnitY(caster),GetUnitFacing(caster))
set a=SeekFreeDummys(bj_lastCreatedUnit,GetHandleId(bj_lastCreatedUnit))
set s__Dummys_dmg[sDummy[a]]=dmg
call UnitAddAbility(bj_lastCreatedUnit,'A08M')
if GetHeroLevel(caster)>=50 then
call SetUnitAbilityLevel(bj_lastCreatedUnit,'A08M',6)
else
call SetUnitAbilityLevel(bj_lastCreatedUnit,'A08M',GetUnitAbilityLevel(caster,'A08K'))
endif
else
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'h009',GetUnitX(caster),GetUnitY(caster),GetUnitFacing(caster))
call UnitAddAbility(bj_lastCreatedUnit,'A08M')
call SetUnitAbilityLevel(bj_lastCreatedUnit,'A08M',GetUnitAbilityLevel(caster,'A08K'))
endif
call IssueTargetOrder(bj_lastCreatedUnit,"chainlightning",GetSpellTargetUnit())
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',2.00)
else
if udg_Talante[ID]==1 then
set dmg=2.*GetHeroInt(caster,true)
if GetHeroLevel(caster)>49 then
set dmg=dmg+GetHeroInt(caster,true)
endif
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'h05G',GetUnitX(caster),GetUnitY(caster),GetUnitFacing(caster))
set a=SeekFreeDummys(bj_lastCreatedUnit,GetHandleId(bj_lastCreatedUnit))
set s__Dummys_dmg[sDummy[a]]=dmg
call UnitAddAbility(bj_lastCreatedUnit,'A08L')
if GetHeroLevel(caster)>=50 then
call SetUnitAbilityLevel(bj_lastCreatedUnit,'A08L',6)
else
