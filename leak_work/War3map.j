function Trig_FlameOrcQ_Actions takes nothing returns nothing
local location p
local group g=CreateGroup()
local unit u
local real dmg
set udg_FlameOrcQ=(udg_FlameOrcQ+1)
if udg_FlameOrcQ==11 then
set dmg=GetUnitAbilityLevel(udg_FlameOrc,'A0QA')*150+4.5*GetHeroStr(udg_FlameOrc,true)
if udg_Talante[GetPlayerId(GetOwningPlayer(udg_FlameOrc))+1]==2 then
set dmg=dmg+0.75*GetHeroStr(udg_FlameOrc,true)
if GetHeroLevel(udg_FlameOrc)>=50 then
set dmg=dmg+0.75*GetHeroStr(udg_FlameOrc,true)
endif
endif
call PauseTimerBJ(true,udg_FlameOrcQTimer)
set p=PolarProjectionBJ(udg_FlameOrcPoint,(I2R(udg_FlameOrcQ)*105.00),udg_FlameOrcReal)
set bj_lastCreatedEffect=AddSpecialEffectLoc("war3mapImported\\NewDirtEXNofire.mdx",p)
call DestroyEffect(bj_lastCreatedEffect)
call GroupEnumUnitsInRangeOfLoc(g,p,300.,Condition(function Trig_FlameOrcQ_Filter))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(udg_FlameOrc,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
call RemoveLocation(p)
else
set dmg=GetUnitAbilityLevel(udg_FlameOrc,'A0QA')*50+1.5*GetHeroStr(udg_FlameOrc,true)
if udg_Talante[GetPlayerId(GetOwningPlayer(udg_FlameOrc))+1]==2 then
set dmg=dmg+0.25*GetHeroStr(udg_FlameOrc,true)
if GetHeroLevel(udg_FlameOrc)>=50 then
set dmg=dmg+0.25*GetHeroStr(udg_FlameOrc,true)
endif
endif
set p=PolarProjectionBJ(udg_FlameOrcPoint,(I2R(udg_FlameOrcQ)*100.00),udg_FlameOrcReal)
set bj_lastCreatedEffect=AddSpecialEffectLoc("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl",p)
call DestroyEffect(bj_lastCreatedEffect)
call GroupEnumUnitsInRangeOfLoc(g,p,150.,Condition(function Trig_FlameOrcQ_Filter))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(udg_FlameOrc,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
call RemoveLocation(p)
endif
call DestroyGroup(g)
set u=null
set g=null
set p=null
endfunction
