function Trig_SamopozertvovanieHeal_Conditions takes nothing returns boolean
if(not(GetUnitAbilityLevel(GetTriggerUnit(),'A0NR')>=1))then
return false
endif
return true
endfunction
function Trig_SamopozertvovanieHeal_Actions takes nothing returns nothing
if GetRandomInt(1,20)==1 then
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(GetTriggerUnit()),'h009',GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),0)
call UnitAddAbility(bj_lastCreatedUnit,'A03M')
call IssueTargetOrder(bj_lastCreatedUnit,"healingwave",GetTriggerUnit())
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',0.75)
else
endif
endfunction
function InitTrig_SamopozertvovanieHeal takes nothing returns nothing
set gg_trg_SamopozertvovanieHeal=CreateTrigger()
