return false
endif
return true
endfunction
function Trig_KovenQuests_Actions takes nothing returns nothing
local integer ID=GetPlayerId(GetOwningPlayer(GetEnteringUnit()))+1
set udg_u=GetEnteringUnit()
if(IsPlayerInForce(Player(ID-1),udg_Quests2[1])==true)and(UnitHasItemOfTypeBJ(udg_u,'I044')==true)and(GetItemCharges(GetItemOfTypeFromUnitBJ(udg_u,'I00K'))>=5)then
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"Так быстро? Благодарю тебя. Совсем скоро мы начнем поиски... Поиски кого? Я расскажу тебе, если ты и дальше согласишься нам помогать.\n\n|cFFFFDC00Вы получили: предмет \"Шляпа ведьмы\" и 500 золота|r")
if GetItemCharges(GetItemOfTypeFromUnitBJ(udg_u,'I044'))>1 then
call SetItemCharges(GetItemOfTypeFromUnitBJ(udg_u,'I044'),(GetItemCharges(GetItemOfTypeFromUnitBJ(udg_u,'I044'))-1))
else
call RemoveItem(GetItemOfTypeFromUnitBJ(udg_u,'I044'))
endif
if GetItemCharges(GetItemOfTypeFromUnitBJ(udg_u,'I00K'))>5 then
call SetItemCharges(GetItemOfTypeFromUnitBJ(udg_u,'I00K'),(GetItemCharges(GetItemOfTypeFromUnitBJ(udg_u,'I00K'))-5))
else
call RemoveItem(GetItemOfTypeFromUnitBJ(udg_u,'I00K'))
endif
call UnitAddItemByIdSwapped('I0A4',udg_u)
if(udg_u==udg_Scorpion)and(udg_ScorpionMutation[3]==3)then
call AdjustPlayerStateBJ(150,GetOwningPlayer(udg_u),PLAYER_STATE_RESOURCE_GOLD)
endif
call AdjustPlayerStateBJ(500,GetOwningPlayer(udg_u),PLAYER_STATE_RESOURCE_GOLD)
call AddSpecialEffectTargetUnitBJ("origin",udg_u,"Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call ForceRemovePlayerSimple(GetOwningPlayer(udg_u),udg_Quests2[1])
call ForceClear(udg_Quests2[1])
call ForceAddPlayerSimple(GetOwningPlayer(udg_u),udg_Quests2[2])
call EnableTrigger(gg_trg_KovenQuest2)
return
else
if IsPlayerInForce(Player(ID-1),udg_Quests2[1])==true then
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"TRIGSTR_049")
endif
endif
if(IsPlayerInForce(Player(ID-1),udg_Quests2[2])==true)and(udg_KGolems[ID]==20)and(udg_KTrees[ID]==8)then
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"Хорошая работа, пока ты убивал этих существ, мои подопечные собирали остатки их магической силы. Теперь у нас достаточно энергии, чтобы призвать духов крови и узнать что случилось с Адрией.\n\n|cFFFFDC00Вы получили: предмет \"Посох Ночи\" и 2500 золота|r")
call UnitAddItemByIdSwapped('I0A5',udg_u)
if(udg_u==udg_Scorpion)and(udg_ScorpionMutation[3]==3)then
call AdjustPlayerStateBJ(750,GetOwningPlayer(udg_u),PLAYER_STATE_RESOURCE_GOLD)
endif
call AdjustPlayerStateBJ(2500,GetOwningPlayer(udg_u),PLAYER_STATE_RESOURCE_GOLD)
call AddSpecialEffectTargetUnitBJ("origin",udg_u,"Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call ForceRemovePlayerSimple(GetOwningPlayer(udg_u),udg_Quests2[2])
call ForceAddPlayerSimple(GetOwningPlayer(udg_u),udg_Quests2[3])
set udg_KQuest3[GetConvertedPlayerId(GetOwningPlayer(udg_u))]=false
return
else
if IsPlayerInForce(Player(ID-1),udg_Quests2[2])==true then
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"TRIGSTR_051")
endif
endif
if(IsPlayerInForce(Player(ID-1),udg_Quests2[3])==true)and(udg_KQuest3[ID]==true)then
if udg_KovenLogic==false then
call EnableTrigger(gg_trg_KovenQuests)
set udg_KovenLogic=true
endif
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"Это были духи крови говоришь? Очень интересно. Я уже отправила исследователей на место твоего сражения, они будут подробно изучать природу этих существ. А ты пока отдохни.\n\n|cFFFFDC00Вы получили: предмет \"Ожерелье кошмаров\" и 3500 золота|r")
call EnableTrigger(gg_trg_KovenQuest4)
call UnitAddItemByIdSwapped('I0A6',udg_u)
if(udg_u==udg_Scorpion)and(udg_ScorpionMutation[3]==3)then
call AdjustPlayerStateBJ(1050,GetOwningPlayer(udg_u),PLAYER_STATE_RESOURCE_GOLD)
endif
call AdjustPlayerStateBJ(3500,GetOwningPlayer(udg_u),PLAYER_STATE_RESOURCE_GOLD)
call AddSpecialEffectTargetUnitBJ("origin",udg_u,"Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call ForceRemovePlayerSimple(GetOwningPlayer(udg_u),udg_Quests2[3])
if udg_LastQuest2==true then
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"|cFFFF5800Кто-то первее вас закончил цепочку заданий и получил последнее задание Ковена. Вы получаете 2000 золотых в качестве утешительного приза =)|r")
if(udg_u==udg_Scorpion)and(udg_ScorpionMutation[3]==3)then
call AdjustPlayerStateBJ(600,GetOwningPlayer(udg_u),PLAYER_STATE_RESOURCE_GOLD)
endif
call AdjustPlayerStateBJ(2000,GetOwningPlayer(udg_u),PLAYER_STATE_RESOURCE_GOLD)
call ForceAddPlayerSimple(GetOwningPlayer(udg_u),udg_Quests2[5])
else
call ForceAddPlayerSimple(GetOwningPlayer(udg_u),udg_Quests2[4])
set udg_LastQuest2=true
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"|cFFFF00FFПоздравляем! Вы первым завершили цепочку заданий \\\"Ведьма прошлого\\\" и получаете доступ к последнему заданию. Удачи!|r")
endif
return
else
if IsPlayerInForce(Player(ID-1),udg_Quests2[3])==true then
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"|cFF00C850Задание \"Ведьма прошлого\" [3/3]|r\n\nМы ничего не смогли узнать про Адрию, но духи сказали, что можно вызвать призраков прошлого, которые могут нам помочь. Итак, вызывай призраков в следущем порядке - дождись ночи, встань на гиблую землю и произнеси на латыни заклинание \"Venite ad me qui antiquorum spirituum!\". Произноси чётко и без ошибок. Возвращайся, как только что-нибудь узнаешь.\n\n|cFFFFDC00Награда: предмет \"Ожерелье кошмаров\" и 3500 золота\nЕсли успеете первым закончить цепочку заданий, то вы получите доступ к последнему заданию Ковена.|r")
endif
endif
if(IsPlayerInForce(Player(ID-1),udg_Quests2[4])==true)and(udg_KQuest4[ID]>399)then
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"Ковен ведьм благодарен тебе, герой! Мы смогли вернуть останки Адрии в реальный мир и... они обладают невероятной силой! Прими от нас посох с её рукой и распоряжайся столь древней магией с умом - мы тебе доверили очень опасный артефакт.\n\n|cFFFFDC00Вы получили: предмет \"Рука Адрии\" и 6000 золота|r")
call UnitAddItemByIdSwapped('I0A7',udg_u)
call EnableTrigger(gg_trg_AdriaHand)
if(udg_u==udg_Scorpion)and(udg_ScorpionMutation[3]==3)then
call AdjustPlayerStateBJ(1800,GetOwningPlayer(udg_u),PLAYER_STATE_RESOURCE_GOLD)
endif
call AdjustPlayerStateBJ(6000,GetOwningPlayer(udg_u),PLAYER_STATE_RESOURCE_GOLD)
call AddSpecialEffectTargetUnitBJ("origin",udg_u,"Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call ForceRemovePlayerSimple(GetOwningPlayer(udg_u),udg_Quests2[4])
call ForceAddPlayerSimple(GetOwningPlayer(udg_u),udg_Quests2[5])
return
else
if IsPlayerInForce(Player(ID-1),udg_Quests2[4])==true then
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"TRIGSTR_055")
endif
endif
if IsPlayerInForce(Player(ID-1),udg_Quests2[5])==true then
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"Наш шабаш окончен, отдыхай до следущего сезона.")
endif
endfunction
