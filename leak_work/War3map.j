call SaveUnitHandle(udg_hash,ht,0,u)
call SaveUnitHandle(udg_hash,ht,1,hero)
call SaveReal(udg_hash,ht,0,dmg)
call TimerStart(t,0.2,true,function Trig_HuntressSkills_R2)
set x1=x+200*Cos((GetUnitFacing(hero)+90)*bj_DEGTORAD)
set y1=y+200*Sin((GetUnitFacing(hero)+90)*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(hero),'e005',x1,y1,0.)
