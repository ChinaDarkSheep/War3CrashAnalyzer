call TriggerRegisterPlayerChatEvent(gg_trg_cam,Player(6),"-cam",false)
call TriggerRegisterPlayerChatEvent(gg_trg_cam,Player(7),"-cam",false)
call TriggerAddAction(gg_trg_cam,function Trig_cam_Actions)
