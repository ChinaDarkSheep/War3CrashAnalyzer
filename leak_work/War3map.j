function Trig_Enter_Actions takes nothing returns nothing
local integer ID=GetPlayerId(GetTriggerPlayer())+1
local real x
local real y
if udg_Hero[ID]!=null and GetUnitTypeId(udg_Hero[ID])!='Nbrn' and GetUnitTypeId(udg_Hero[ID])!='U02A' then
set x=-21800
set y=18501
call SetUnitPosition(udg_Hero[ID],x,y)
if GetLocalPlayer()==GetTriggerPlayer()then
call PanCameraToTimed(x,y,0)
call ClearSelection()
call SelectUnit(udg_Hero[ID],true)
endif
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
endif
endfunction
