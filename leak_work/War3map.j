call TriggerRegisterPlayerChatEvent(gg_trg_newZoom,Player(4),"-zoom",false)
call TriggerRegisterPlayerChatEvent(gg_trg_newZoom,Player(5),"-zoom",false)
call TriggerRegisterPlayerChatEvent(gg_trg_newZoom,Player(6),"-zoom",false)
call TriggerRegisterPlayerChatEvent(gg_trg_newZoom,Player(7),"-zoom",false)
call TriggerAddAction(gg_trg_newZoom,function Trig_newZoom_Actions)
endfunction
function Trig_cam_Actions takes nothing returns nothing
call SetCameraFieldForPlayer(GetTriggerPlayer(),CAMERA_FIELD_TARGET_DISTANCE,S2R(SubStringBJ(GetEventPlayerChatString(),6,9)),2.00)
endfunction
