function Trig_Fase1_Actions takes nothing returns nothing
local timer t=CreateTimer()
call TimerStart(t,1.,true,function Set10_Wave_1)
set t=null
set udg_EnemyType[1]='u01H'
set udg_EnemyType[2]='u01J'
set udg_EnemyType[3]='u01G'
set udg_EnemyType[4]='u01I'
set udg_RandomEvents[1]=GetRandomInt(1,12)
call ConditionalTriggerExecute(udg_RandomEventsTriggers[udg_RandomEvents[1]])
call DisplayTimedTextToForce(GetPlayersAll(),30,"|cFFA000FF==========================|r\n|cFFFFDC00Фаза №1 \"300 вурдалаков\"|r\n|cFFA000FF==========================|r\n|cFFFFDC00Случайные события:|r")
call DisplayTimedTextToForce(GetPlayersAll(),30,udg_RandomEventsText[udg_RandomEvents[1]])
endfunction
function InitTrig_Fase1 takes nothing returns nothing
set gg_trg_Fase1=CreateTrigger()
call DisableTrigger(gg_trg_Fase1)
call TriggerAddAction(gg_trg_Fase1,function Trig_Fase1_Actions)
endfunction
function Trig_SkillFase1_Conditions takes nothing returns boolean
if(not(GetUnitTypeId(GetAttackedUnitBJ())=='u01I'))and(not(GetUnitTypeId(GetAttackedUnitBJ())=='u01X'))then
return false
endif
if(not(IsUnitInGroup(GetAttackedUnitBJ(),udg_TeleGhoul)==false))then
return false
endif
return true
endfunction
function Trig_SkillFase1_Actions takes nothing returns nothing
local unit u=GetAttackedUnitBJ()
set udg_p=GetUnitLoc(GetAttacker())
set udg_p2=PolarProjectionBJ(udg_p,30.00,(GetUnitFacing(GetAttacker())+180.00))
call SetUnitPositionLoc(u,udg_p2)
call AddSpecialEffectLocBJ(udg_p2,"Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call RemoveLocation(udg_p)
call RemoveLocation(udg_p2)
call GroupAddUnit(udg_TeleGhoul,u)
call TriggerSleepAction(6.00)
call GroupRemoveUnit(udg_TeleGhoul,u)
set u=null
endfunction
function InitTrig_SkillFase1 takes nothing returns nothing
set gg_trg_SkillFase1=CreateTrigger()
call TriggerRegisterPlayerUnitEventSimple(gg_trg_SkillFase1,Player(8),EVENT_PLAYER_UNIT_ATTACKED)
call TriggerRegisterPlayerUnitEventSimple(gg_trg_SkillFase1,Player(10),EVENT_PLAYER_UNIT_ATTACKED)
call TriggerRegisterPlayerUnitEventSimple(gg_trg_SkillFase1,Player(11),EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(gg_trg_SkillFase1,Condition(function Trig_SkillFase1_Conditions))
call TriggerAddAction(gg_trg_SkillFase1,function Trig_SkillFase1_Actions)
endfunction
function Trig_EndFase1_Func004Func001C takes nothing returns boolean
if(not(udg_HARDSET==10))then
return false
endif
return true
endfunction
function Trig_EndFase1_Func004C takes nothing returns boolean
if(not(udg_Mode==2))then
return false
endif
return true
endfunction
function Trig_EndFase1_Actions takes nothing returns nothing
call DisableTrigger(GetTriggeringTrigger())
call DisplayTimedTextToForce(GetPlayersAll(),30,"|cFF00C850ПЕРВАЯ ФАЗА ПРОЙДЕНА!\n\nУ вас есть 60 секунд на подготовку к следущей фазе.")
call ConditionalTriggerExecute(gg_trg_Fase2)
if(Trig_EndFase1_Func004C())then
call PlayerGetEXP(2000)
else
if(Trig_EndFase1_Func004Func001C())then
call PlayerGetEXP(1500)
else
call PlayerGetEXP(600)
endif
endif
endfunction
function InitTrig_EndFase1 takes nothing returns nothing
set gg_trg_EndFase1=CreateTrigger()
call DisableTrigger(gg_trg_EndFase1)
call TriggerRegisterTimerEventPeriodic(gg_trg_EndFase1,40.00)
call TriggerAddAction(gg_trg_EndFase1,function Trig_EndFase1_Actions)
endfunction
function Trig_Fase2_Boss takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit boss=LoadUnitHandle(udg_hash,ht,0)
local integer id=PLAYER_NEUTRAL_AGGRESSIVE
local integer a=GetRandomInt(1,3)
local real xb=GetUnitX(boss)
local real yb=GetUnitY(boss)
local real x
local real y
if UnitAlive(boss)then
if a==1 then
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>6
set x=xb+100*Cos((60*bj_forLoopAIndex+GetUnitFacing(boss))*bj_DEGTORAD)
set y=yb+100*Sin((60*bj_forLoopAIndex+GetUnitFacing(boss))*bj_DEGTORAD)
set bj_lastCreatedUnit=CreateUnit(Player(id),'h03K',x,y,bj_UNIT_FACING)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',3.5)
set x=xb+400*Cos((60*bj_forLoopAIndex+GetUnitFacing(boss))*bj_DEGTORAD)
set y=yb+400*Sin((60*bj_forLoopAIndex+GetUnitFacing(boss))*bj_DEGTORAD)
set bj_lastCreatedUnit=CreateUnit(Player(id),'h03K',x,y,bj_UNIT_FACING)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',3.5)
set x=xb+700*Cos((60*bj_forLoopAIndex+GetUnitFacing(boss))*bj_DEGTORAD)
set y=yb+700*Sin((60*bj_forLoopAIndex+GetUnitFacing(boss))*bj_DEGTORAD)
set bj_lastCreatedUnit=CreateUnit(Player(id),'h03K',x,y,bj_UNIT_FACING)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',3.5)
set x=xb+1000*Cos((60*bj_forLoopAIndex+GetUnitFacing(boss))*bj_DEGTORAD)
set y=yb+1000*Sin((60*bj_forLoopAIndex+GetUnitFacing(boss))*bj_DEGTORAD)
set bj_lastCreatedUnit=CreateUnit(Player(id),'h03K',x,y,bj_UNIT_FACING)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',3.5)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
elseif a==2 then
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>16
set x=xb+900*Cos((22.5*bj_forLoopAIndex+GetUnitFacing(boss))*bj_DEGTORAD)
set y=yb+900*Sin((22.5*bj_forLoopAIndex+GetUnitFacing(boss))*bj_DEGTORAD)
set bj_lastCreatedUnit=CreateUnit(Player(id),'h03K',x,y,bj_UNIT_FACING)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',3.5)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>12
set x=xb+600*Cos((30*bj_forLoopAIndex+GetUnitFacing(boss))*bj_DEGTORAD)
set y=yb+600*Sin((30*bj_forLoopAIndex+GetUnitFacing(boss))*bj_DEGTORAD)
set bj_lastCreatedUnit=CreateUnit(Player(id),'h03K',x,y,bj_UNIT_FACING)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',3.5)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
elseif a==3 then
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>6
set x=xb+600*Cos((60*bj_forLoopAIndex+GetUnitFacing(boss))*bj_DEGTORAD)
set y=yb+600*Sin((60*bj_forLoopAIndex+GetUnitFacing(boss))*bj_DEGTORAD)
set bj_lastCreatedUnit=CreateUnit(Player(id),'h03K',x,y,bj_UNIT_FACING)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',3.5)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>4
set x=xb+300*Cos((90*bj_forLoopAIndex+GetUnitFacing(boss))*bj_DEGTORAD)
set y=yb+300*Sin((90*bj_forLoopAIndex+GetUnitFacing(boss))*bj_DEGTORAD)
set bj_lastCreatedUnit=CreateUnit(Player(id),'h03K',x,y,bj_UNIT_FACING)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',3.5)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
set boss=null
endfunction
function Set10_Wave_2 takes nothing returns nothing
local timer t=GetExpiredTimer()
