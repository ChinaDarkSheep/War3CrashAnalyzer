return(UnitAlive(GetFilterUnit())==false and IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO)==false and GetUnitAbilityLevel(GetFilterUnit(),'Avul')!=1 and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false)
endfunction
function Trig_GrobSkills_Filter takes nothing returns boolean
return(UnitAlive(GetFilterUnit())and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(udg_Grob)))
endfunction
function Trig_GrobTimer2_Filter takes nothing returns boolean
return(UnitAlive(GetFilterUnit())and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(udg_Grob)))
endfunction
function Trig_GrobTimer2_Group takes nothing returns nothing
call IssueTargetOrder(GetEnumUnit(),"attack",udg_Grob)
endfunction
function GrobSkills_Q2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer iuh=LoadInteger(Hash,GetHandleId(caster),0)
set s__Units_MageBlock[sUnit[iuh]]=s__Units_MageBlock[sUnit[iuh]]-5000
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set t=null
set caster=null
endfunction
function GrobSkills_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local real sec=LoadReal(udg_hash,ht,0)-.2
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local group g=CreateGroup()
local unit u
local real dmg=GetHeroStr(caster,true)/2
if sec>0 then
call SaveReal(udg_hash,ht,0,sec)
if sec==7. then
set udg_GrobRegen=true
endif
if udg_Talante[GetPlayerId(GetOwningPlayer(caster))+1]==1 then
set dmg=dmg*2.
endif
call GroupEnumUnitsInRange(g,x,y,600.,Condition(function Trig_GrobTimer2_Filter))
call ForGroup(g,function Trig_GrobTimer2_Group)
call RandomUnitFromGroup(1,g)
set u=FirstOfGroup(g)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Undead\\Impale\\ImpaleHitTarget.mdl",u,"origin")
call DestroyEffect(bj_lastCreatedEffect)
set x=GetUnitX(u)
set y=GetUnitY(u)
call GroupClear(g)
call GroupEnumUnitsInRange(g,x,y,150.,Condition(function Trig_GrobTimer2_Filter))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set udg_GrobRegen=false
call SetUnitAnimation(caster,"Morph Defend")
call PauseUnit(caster,false)
endif
call DestroyGroup(g)
set t=null
set caster=null
set u=null
set g=null
endfunction
function GrobSkills_MorphAnim takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
call SetUnitAnimation(caster,"Morph")
call PauseUnit(caster,true)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set caster=null
set t=null
endfunction
function GrobSkills_SpawnCorpse takes unit caster,integer talante,real r returns nothing
local real ang=GetRandomDirectionDeg()*bj_DEGTORAD
local real d=GetRandomReal(100.,300.)
local unit c=CreateUnit(GetOwningPlayer(caster),'u01M',GetUnitX(caster)+d*Cos(ang),GetUnitY(caster)+d*Sin(ang),GetRandomDirectionDeg())
local group g=CreateGroup()
local unit u
call SetUnitAnimation(c,"Birth")
call UnitApplyTimedLife(c,'BTLF',6.)
if talante==1 then
call DestroyEffect(AddSpecialEffect("war3mapImported\\Blood Massacre Blight.mdx",GetUnitX(c),GetUnitY(c)))
call GroupEnumUnitsInRange(g,GetUnitX(c),GetUnitY(c),160,Condition(function Trig_GrobSkills_Filter))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,r,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
endif
call DestroyGroup(g)
set c=null
set u=null
set g=null
endfunction
function GrobSkills_CorpseTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer n=LoadInteger(udg_hash,ht,1)-1
local integer talante=LoadInteger(udg_hash,ht,2)
local real r=LoadReal(udg_hash,ht,3)
call GrobSkills_SpawnCorpse(caster,talante,r)
if n<=0 then
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
else
call SaveInteger(udg_hash,ht,1,n)
endif
set caster=null
set t=null
endfunction
function GrobSkills_HowlEnd takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local real r
call SetUnitVertexColorBJ(caster,100.00,100.00,100.00,0.00)
set r=GetUnitState(caster,UNIT_STATE_LIFE)/GetUnitState(caster,UNIT_STATE_MAX_LIFE)
call SetUnitState(caster,UNIT_STATE_LIFE,r*GetUnitState(caster,UNIT_STATE_MAX_LIFE))
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set caster=null
set t=null
endfunction
function GrobSkills_RemoveA0NK takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
call UnitRemoveAbility(caster,'A0NK')
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set caster=null
set t=null
endfunction
function Trig_GrobSkills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer i=0
local integer a=0
local integer b=0
local integer talante=udg_Talante[GetPlayerId(GetOwningPlayer(caster))+1]
local real r
local unit u
local group g=CreateGroup()
local timer t
local integer ht
if GetSpellAbilityId()=='A0NC' then
call GroupEnumUnitsInRange(g,GetUnitX(caster),GetUnitY(caster),350.,Condition(function Trig_GrobSkills_FilterD))
if udg_Setstart then
set i=36
else
set i=12
endif
if talante==1 then
set a=8
else
set a=7
endif
loop
set u=FirstOfGroup(g)
exitwhen u==null
set b=b+1
set bj_lastCreatedEffect=AddSpecialEffect("Objects\\Spawnmodels\\NightElf\\NightElfLargeDeathExplode\\NightElfLargeDeathExplode.mdl",GetUnitX(u),GetUnitY(u))
call DestroyEffect(bj_lastCreatedEffect)
call F_RemoveUnit(u)
set udg_GrobNumber=udg_GrobNumber+1
if udg_GrobNumber>=i then
set udg_GrobNumber=0
call ModifyHeroStat(bj_HEROSTAT_STR,caster,bj_MODIFYMETHOD_ADD,a)
call CreateTextTagUnitBJ("|c00FF0000+"+I2S(a)+" силы|r",caster,0,10.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
endif
call GroupRemoveUnit(g,u)
endloop
if b>15 then
set b=15
endif
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+(0.02*I2R(b))*GetUnitState(caster,UNIT_STATE_MAX_LIFE))
if talante==2 then
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+0.2*GetUnitState(caster,UNIT_STATE_MAX_LIFE))
endif
endif
if GetSpellAbilityId()=='A0NE' then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveReal(udg_hash,ht,0,8.)
call TimerStart(t,.2,true,function GrobSkills_R)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,.2,false,function GrobSkills_MorphAnim)
endif
if GetSpellAbilityId()=='A0NI' then
if talante==2 then
set i=LoadInteger(Hash,GetHandleId(caster),0)
set s__Units_MageBlock[sUnit[i]]=s__Units_MageBlock[sUnit[i]]+5000
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,5.,false,function GrobSkills_Q2)
endif
call SetPlayerTechResearchedSwap('R02I',GetUnitAbilityLevelSwapped('A0NI',caster),GetOwningPlayer(caster))
if talante==1 then
set r=25*GetUnitAbilityLevel(caster,'A0NI')+GetHeroStr(caster,true)
else
set r=0.
endif
call GrobSkills_SpawnCorpse(caster,talante,r)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveInteger(udg_hash,ht,1,5)
call SaveInteger(udg_hash,ht,2,talante)
call SaveReal(udg_hash,ht,3,r)
call TimerStart(t,0.1,true,function GrobSkills_CorpseTimer)
endif
if GetSpellAbilityId()=='A0NG' then
set i=KillNT[GetPlayerId(GetOwningPlayer(caster))+1]/3
if talante==1 then
set i=i+R2I(0.2*GetHeroStr(caster,true))
endif
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Other\\HowlOfTerror\\HowlCaster.mdl",GetUnitX(caster),GetUnitY(caster))
call DestroyEffect(bj_lastCreatedEffect)
call TempStats(caster,i,0,0,0,0,0,PositiveDuration(caster,20))
call SetUnitVertexColorBJ(caster,80.00,25.00,67.00,0.50)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,PositiveDuration(caster,20),false,function GrobSkills_HowlEnd)
endif
if GetSpellAbilityId()=='A0NJ' then
if talante==1 then
if GetUnitAbilityLevel(caster,'A0NK')<1 then
call UnitAddAbility(caster,'A0NK')
else
call UnitRemoveAbility(caster,'A0NK')
endif
else
call UnitAddAbility(caster,'A0NK')
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,PositiveDuration(caster,10),false,function GrobSkills_RemoveA0NK)
endif
endif
call DestroyGroup(g)
set caster=null
set g=null
set u=null
set t=null
endfunction
function InitTrig_GrobSkills takes nothing returns nothing
set gg_trg_GrobSkills=CreateTrigger()
call TriggerAddAction(gg_trg_GrobSkills,function Trig_GrobSkills_Actions)
endfunction
