function Quest_Boss_Crystall_Laser takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit boss=LoadUnitHandle(udg_hash,ht,0)
local real sec=LoadReal(udg_hash,ht,0)
local real dmg=LoadReal(udg_hash,ht,1)
local real x
local real y
local real x1
local real y1
local integer rotation=LoadInteger(udg_hash,ht,2)
local real angle=LoadReal(udg_hash,ht,3)
local unit u
local group g=CreateGroup()
local group g2=CreateGroup()
local lightning l=LoadLightningHandle(udg_hash,ht,4)
local real r=175.
if UnitAlive(boss)and sec<9.6 then
set sec=sec+.08
call SaveReal(udg_hash,ht,0,sec)
set x=GetUnitX(boss)
set y=GetUnitY(boss)
set angle=angle+rotation*3.
if angle>360. then
set angle=angle-360.
elseif angle<0. then
set angle=angle+360.
endif
set x1=x+1200.*Cos(angle*bj_DEGTORAD)
set y1=y+1200.*Sin(angle*bj_DEGTORAD)
call MoveLightning(l,true,x,y,x1,y1)
call SaveReal(udg_hash,ht,3,angle)
loop
exitwhen r>1175.
set x1=x+r*Cos(angle*bj_DEGTORAD)
set y1=y+r*Sin(angle*bj_DEGTORAD)
set udg_Drop2=GetPlayerId(GetOwningPlayer(boss))
call GroupEnumUnitsInRange(g,x1,y1,150.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if not IsUnitInGroup(u,g2)then
call GroupAddUnit(g2,u)
call UnitDamageTarget(boss,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
call GroupRemoveUnit(g,u)
endloop
set r=r+100.
endloop
else
call DestroyLightning(l)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set l=null
call DestroyGroup(g)
call DestroyGroup(g2)
set g=null
set g2=null
set t=null
set boss=null
set u=null
endfunction
function Quest_Boss_Crystall_FireStrike takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit boss=LoadUnitHandle(udg_hash,ht,0)
local real sec=LoadReal(udg_hash,ht,0)+.25
local real dmg=LoadReal(udg_hash,ht,1)
local real x=LoadReal(udg_hash,ht,2)
local real y=LoadReal(udg_hash,ht,3)
local unit flame=LoadUnitHandle(udg_hash,ht,4)
local unit u
local group g=CreateGroup()
if UnitAlive(boss)and sec<8. then
call SaveReal(udg_hash,ht,0,sec)
if sec>2. then
if not LoadBoolean(udg_hash,ht,5)then
set flame=CreateUnit(Player(11),'h00K',x,y,bj_UNIT_FACING)
call SetUnitScale(flame,1.,1.,1.)
call SetUnitAnimation(flame,"birth")
call SaveUnitHandle(udg_hash,ht,4,flame)
call SaveBoolean(udg_hash,ht,5,true)
endif
if sec>5. then
set dmg=.125*dmg
else
set dmg=.25*dmg
endif
set udg_Drop2=GetPlayerId(GetOwningPlayer(boss))
call GroupEnumUnitsInRange(g,x,y,300.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(boss,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
endif
else
call RemoveUnit(flame)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set flame=null
call DestroyGroup(g)
set g=null
set t=null
set boss=null
set u=null
endfunction
