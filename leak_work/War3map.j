function Trig_ItemKills_Actions takes nothing returns nothing
local boolean kill_boss=false
local boolean this_player=false
local integer idd=GetPlayerId(GetOwningPlayer(GetDyingUnit()))
local integer id=GetPlayerId(GetOwningPlayer(GetKillingUnit()))
local integer h
local integer ID=id+1
local integer drop
local integer a
local integer b
local integer c
local real r
local real x
local real y
local integer lvl=GetUnitLevel(GetTriggerUnit())
local real power=1.
local integer hh
local unit killer=GetKillingUnit()
local boolean killerhero
local group g
local unit u
local integer ihh
if IsUnitType(killer,UNIT_TYPE_HERO)then
set killerhero=true
if GetUnitAbilityLevel(killer,'A0WF')==1 then
set h=GetHandleId(killer)
if udg_LeoricE<600 then
set udg_LeoricE=udg_LeoricE+6
set udg_ReflectDmg[id+1]=udg_ReflectDmg[id+1]+6.
else
endif
set a=2
call SetHeroStr(killer,GetHeroStr(killer,false)+a,true)
call SaveInteger(udg_hash,h,StringHash("LeoricSoul"),LoadInteger(udg_hash,h,StringHash("LeoricSoul"))+a)
endif
else
set killerhero=false
endif
if GetOwningPlayer(killer)==Player(0)then
set udg_RedKill=true
else
set udg_RedKill=false
endif
if ID !=1 or udg_RedKill then
set g=CreateGroup()
set hh=GetHandleId(udg_Hero[ID])
if killerhero then
if GetUnitTypeId(killer)=='Ewar' then
if udg_Talante[ID]==1 and GetUnitAbilityLevel(killer,'A0BT')==1 and lvl>2 then
call Trig_killer_Euphoria(killer,0.1*lvl)
endif
endif
if killer==udg_Bat then
call SaveReal(udg_hash,hh,'d',LoadReal(udg_hash,hh,'d')+1.25)
if udg_BatLogicW then
call SaveReal(udg_hash,hh,'d',LoadReal(udg_hash,hh,'d')+2.5+1.5*GetUnitAbilityLevel(killer,'A0TV'))
endif
endif
endif
if GetUnitAbilityLevel(killer,'A1DX')==1 then
set power=.333*power
endif
if udg_Setstart then
set power=.25*power
endif
if IsUnitType(GetDyingUnit(),UNIT_TYPE_UNDEAD)or IsPlayerInForce(GetOwningPlayer(GetDyingUnit()),udg_CreepsPlayers)then
if GetRandomInt(1,100)<=25*power and GetUnitAbilityLevel(udg_Hero[ID],'A01C')==1 then
set a=GetRandomInt(1,3)
if a==1 then
call InfStats(udg_Hero[ID],1,0,0,0,0,0)
elseif a==2 then
call InfStats(udg_Hero[ID],0,1,0,0,0,0)
else
call InfStats(udg_Hero[ID],0,0,1,0,0,0)
endif
endif
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='k3m1' then
set a=LoadInteger(udg_hash,hh,StringHash("CrownLich"))
call SaveInteger(udg_hash,hh,H_HighStat,LoadInteger(udg_hash,hh,H_HighStat)-a/100)
if a<10000 then
set r=40.*power
elseif a<20000 then
set r=20.*power
else
set r=8.*power
endif
set r=r*(.1+.9*lvl)
if GetOwningPlayer(GetDyingUnit())!=Player(PLAYER_NEUTRAL_AGGRESSIVE)then
set r=.5*r
endif
set b=a+R2I(r)
call SaveInteger(udg_hash,hh,StringHash("CrownLich"),b)
call SaveInteger(udg_hash,hh,H_HighStat,LoadInteger(udg_hash,hh,H_HighStat)+b/100)
endif
if IsUnitType(GetDyingUnit(),UNIT_TYPE_HERO)or(lvl>=15 and ModuloInteger(lvl,5)==0)then
set kill_boss=true
endif
if id>=0 and id<8 then
set this_player=true
if GetUnitAbilityLevel(killer,'A0RK')>=1 and LoadBoolean(udg_hash,hh,StringHash("SharkE"))==false then
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,GetUnitX(GetDyingUnit()),GetUnitY(GetDyingUnit()),325.,Bool_Filter_ID)
set r=GetUnitAbilityLevel(udg_Hero[ID],'A0RK')*40+GetHeroStr(udg_Hero[ID],true)
set x=.2*r
set r=.8*r
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(udg_Hero[ID],u,r,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(udg_Hero[ID],u,x,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",u,"chest"))
call GroupRemoveUnit(g,u)
endloop
call Func_CD(killer,"SharkE",.5)
endif
endif
if GetUnitAbilityLevel(GetDyingUnit(),'A178')==0 then
set h=GetHandleId(udg_Hero[ID])
if IsUnitEnemy(GetDyingUnit(),GetOwningPlayer(killer))and this_player and GetPlayerController(GetOwningPlayer(killer))==MAP_CONTROL_USER and GetPlayerController(GetOwningPlayer(GetDyingUnit()))!=MAP_CONTROL_USER and GetUnitAbilityLevel(GetDyingUnit(),'Avul')!=1 then
if udg_MeshochekCheck[ID]>0 then
if GetUnitAbilityLevel(killer,'A1DX')==1 then
set udg_MeshochekCount[ID]=udg_MeshochekCount[ID]+.25
else
set udg_MeshochekCount[ID]=udg_MeshochekCount[ID]+1
endif
if udg_MeshochekCount[ID]>=50 then
set udg_MeshochekCount[ID]=0
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFFFFDC00Ваш волшебный мешочек превратился в предмет 1 уровня!|r")
call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero[ID],'I062'))
set udg_Item=ChooseRandomItemBJ(2)
call UnitAddItemByIdSwapped(udg_Item,udg_Circle[ID])
endif
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='phlt' then
call SaveInteger(udg_hash,hh,StringHash("InfBox"),LoadInteger(udg_hash,hh,StringHash("InfBox"))+1)
if LoadInteger(udg_hash,hh,StringHash("InfBox"))>450 then
set udg_MeshochekCount[ID]=udg_MeshochekCount[ID]+0.33
else
set udg_MeshochekCount[ID]=udg_MeshochekCount[ID]+0.66
endif
if udg_MeshochekCount[ID]>=50 then
set udg_MeshochekCount[ID]=0
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFFFFDC00Ваш волшебный мешочек превратился в предмет 1 уровня!|r")
call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero[ID],'I062'))
set udg_Item=ChooseRandomItemBJ(2)
call UnitAddItemByIdSwapped(udg_Item,udg_Circle[ID])
endif
endif
set a=LoadInteger(udg_hash,hh,StringHash("StaffGold"))
if udg_MeshochekCheck[a]>0 then
if GetUnitAbilityLevel(killer,'A1DX')==1 then
set udg_MeshochekCount[a]=udg_MeshochekCount[a]+.15
else
set udg_MeshochekCount[a]=udg_MeshochekCount[a]+.5
endif
if udg_MeshochekCount[a]>=50 then
set udg_MeshochekCount[a]=0
call DisplayTextToForce(bj_FORCE_PLAYER[a-1],"|cFFFFDC00Ваш волшебный мешочек превратился в предмет 1 уровня!|r")
call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero[a],'I062'))
set udg_Item=ChooseRandomItemBJ(2)
call UnitAddItemByIdSwapped(udg_Item,udg_Circle[a])
endif
endif
endif
if GetUnitAbilityLevel(udg_Hero[ID],'A04F')==1 then
set r=LoadReal(udg_hash,h,'K')
set a=LoadInteger(udg_hash,h,'L')
set b=LoadInteger(udg_hash,h,'S')
if udg_Setstart==false then
set r=r+1
else
set r=r+0.5
endif
if R2I(r)>=a then
set b=b+1
call SaveInteger(udg_hash,h,'S',b)
if ModuloInteger(b,5)==0 then
set a=a+1
call SaveInteger(udg_hash,h,'L',a)
endif
call SaveReal(udg_hash,h,'K',0)
set drop=GetRandomInt(5,10)
call InfStats(udg_Hero[ID],0,0,drop,0,0,0)
call CreateTextTagUnitBJ("ПОЖИРАТЕЛЬ ДУШ: +"+I2S(drop)+" разума",udg_Hero[ID],0,10.,70.,70.,100,10.)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
else
call SaveReal(udg_hash,h,'K',r)
endif
endif
if UnitAlive(killer)then
if UnitHasItemOfTypeBJ(killer,'I0EM')and lvl>9 then
call SetUnitLifePercentBJ(killer,GetUnitLifePercent(killer)+5.00)
call SetUnitManaPercentBJ(killer,GetUnitManaPercent(killer)+5.00)
endif
if UnitHasItemOfTypeBJ(killer,'I08U')then
call SetUnitLifePercentBJ(killer,GetUnitLifePercent(killer)+2.00)
call SetUnitManaPercentBJ(killer,GetUnitManaPercent(killer)+2.00)
if udg_Frostmourne[ID]>100 then
set a=15
else
set a=40
endif
if not killerhero then
set a=a/2
endif
if GetRandomInt(1,100)<=R2I(a*power)then
set udg_Frostmourne[ID]=udg_Frostmourne[ID]+1
call InfStats(killer,0,0,0,3,0,0)
endif
endif
if GetKillingUnit()==udg_Scorpion and udg_ScorpionMutation[4]==1 and LoadInteger(udg_hash,h,'d')==2 then
set udg_ScorpionKills=GetRandomInt(1,100)
if udg_Setstart then
if udg_ScorpionKills<=(30+lvl)/3 then
call TakeHeroAttack(1,udg_Scorpion)
call SaveInteger(udg_hash,hh,StringHash("AdaptDMG"),LoadInteger(udg_hash,hh,StringHash("AdaptDMG"))+1)
endif
else
if udg_ScorpionKills<=30+lvl then
call TakeHeroAttack(1,udg_Scorpion)
call SaveInteger(udg_hash,hh,StringHash("AdaptDMG"),LoadInteger(udg_hash,hh,StringHash("AdaptDMG"))+1)
endif
endif
endif
endif
if GetOwningPlayer(GetDyingUnit())==Player(PLAYER_NEUTRAL_AGGRESSIVE)and kill_boss then
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='rin1' then
if lvl==15 then
call InfStats(killer,0,0,0,2,25,0)
elseif lvl==20 or lvl==25 then
call InfStats(killer,0,0,0,4,50,0)
elseif lvl>=30 and ModuloInteger(lvl,5)==0 then
call InfStats(killer,0,0,0,10,100,0)
endif
endif
if UnitHasItemOfTypeBJ(udg_Hero[ID],'I0AJ')then
if GetUnitTypeId(udg_Hero[ID])=='E00M' then
set udg_ScorpionBloodstone=(udg_ScorpionBloodstone+1)
endif
if not IsUnitInGroup(udg_Hero[ID],udg_HeroBuild)then
call InfStats(udg_Hero[ID],0,0,0,15,150,0)
else
set a=ReturnTypeHeroId(hh)
set s__Units_HP[sUnit[a]]=s__Units_HP[sUnit[a]]+150
set s__Heroes_BaseDmg[sHero[a]]=s__Heroes_BaseDmg[sHero[a]]+15
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIlm\\AIlmTarget.mdl",udg_Hero[ID],"origin"))
endif
endif
if this_player and(GetTimeOfDay()>18.00 or GetTimeOfDay()<6.00)then
if lvl>=10 then
if udg_Silver[ID]==399 then
set udg_Silver[ID]=udg_Silver[ID]+1
else
set udg_Silver[ID]=udg_Silver[ID]+2
endif
else
set udg_Silver[ID]=udg_Silver[ID]+1
endif
if udg_Silver[ID]==400 then
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("|cFF52EDF1Игрок|r |cFFFFDC00"+(GetPlayerName(Player(id))+"|r |cFF52EDF1убил 400 противников в ночное время суток и получает \"Сильвер\"!")))
set QuestsNT[ID]=QuestsNT[ID]+1
call UnitAddItemByIdSwapped('I047',udg_Hero[ID])
endif
endif
if UnitHasItemOfTypeBJ(udg_Hero[ID],'I05T')then
set x=GetUnitX(GetDyingUnit())-GetUnitX(udg_Hero[ID])
set y=GetUnitY(GetDyingUnit())-GetUnitY(udg_Hero[ID])
if SquareRoot(x*x+y*y)<=2500. then
set r=2.*power
else
set r=.8*power
endif
if GetOwningPlayer(GetDyingUnit())==Player(PLAYER_NEUTRAL_AGGRESSIVE)then
set r=1.75*r
endif
if not killerhero then
set r=0.7*r
endif
set udg_Mask[ID]=udg_Mask[ID]+r
set a=LoadInteger(udg_hash,h,5)
if(s__Heroes_Type[sHero[a]]==1 or s__Heroes_Type[sHero[a]]==4)and GetRandomInt(1,2)==1 then
set b=2
else
set b=1
endif
if udg_Mask[ID]>=udg_Mask[ID+10]then
set udg_Mask[ID]=udg_Mask[ID]-udg_Mask[ID+10]
if udg_Mask[ID+20]>=8 then
set udg_Mask[ID+10]=udg_Mask[ID+10]+1
set udg_Mask[ID+20]=1
else
set udg_Mask[ID+20]=udg_Mask[ID+20]+1
endif
call InfStats(udg_Hero[ID],0,0,b,0,0,0)
endif
endif
if UnitHasItemOfTypeBJ(killer,'I06P')then
if udg_SwordAgi[ID]<100 then
set r=30.*power
elseif udg_SwordAgi[ID]<250 then
set r=5.*power
else
set r=3.*power
endif
if GetOwningPlayer(GetDyingUnit())==Player(PLAYER_NEUTRAL_AGGRESSIVE)then
set r=2.*r
endif
if GetRandomInt(1,100)<=R2I(r)then
set udg_SwordAgi[ID]=udg_SwordAgi[ID]+1
set a=LoadInteger(udg_hash,h,5)
if(s__Heroes_Type[sHero[a]]==1 or s__Heroes_Type[sHero[a]]==4)and GetRandomInt(1,2)==1 then
call InfStats(killer,0,2,0,0,0,0)
else
call InfStats(killer,0,1,0,0,0,0)
endif
endif
endif
endif
if GetUnitAbilityLevel(killer,'A0OC')==1 then
call SetUnitLifePercentBJ(killer,(GetUnitLifePercent(killer)+1))
if GetOwningPlayer(GetDyingUnit())==Player(PLAYER_NEUTRAL_AGGRESSIVE)then
set a=0
set b=0
if lvl==15 then
set a=12
set b=100
elseif lvl==20 or lvl==25 then
set a=20
set b=200
elseif lvl==30 then
set a=50
set b=400
endif
if a>0 then
call InfStats(killer,0,0,0,a,b,0)
call CreateTextTagUnitBJ("|cFFFF1C20Вожделение: +"+I2S(a)+" атаки, +"+I2S(b)+" HP|r",killer,0,10.,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
endif
endif
if GetUnitAbilityLevel(killer,'B009')>0 and GetRandomInt(1,2)==1 then
call InfStats(killer,0,0,0,1,0,0)
endif
endif
if idd==8 or idd==10 or idd==11 or idd==PLAYER_NEUTRAL_AGGRESSIVE then
set a=1
loop
exitwhen a==9
set u=udg_Hero[a]
set b=GetUnitAbilityLevel(u,'A19B')
if b>0 then
set x=GetUnitX(GetDyingUnit())-GetUnitX(u)
set y=GetUnitY(GetDyingUnit())-GetUnitY(u)
set r=SquareRoot(x*x+y*y)
if r<=2000. and GetRandomInt(1,2)==1 then
set c=GetHandleId(u)
set ihh=LoadInteger(udg_hash,c,5)
if ID==a then
set drop=4*b
else
set drop=2*b
endif
call F_Stats(u)
set b=R2I(drop*power)
if GetRandomInt(1,100)<=b then
if lvl>=10 then
set udg_Miasm=udg_Miasm+8
else
set udg_Miasm=udg_Miasm+4
endif
call InfStats(u,0,0,1,0,0,0)
else
set s__Heroes_Int[sHero[ihh]]=s__Heroes_Int[sHero[ihh]]+1
call SaveInteger(udg_hash,c,StringHash("LichE"),LoadInteger(udg_hash,c,StringHash("LichE"))+1)
endif
endif
endif
set a=a+1
endloop
endif
call DestroyGroup(g)
set u=null
set g=null
set killer=null
endif
endfunction
function InitTrig_ItemKills takes nothing returns nothing
set gg_trg_ItemKills=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_ItemKills,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddAction(gg_trg_ItemKills,function Trig_ItemKills_Actions)
endfunction
function Modificator_Teldrassil takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local integer h1=LoadInteger(udg_hash,h,1)
call SaveBoolean(udg_hash,h1,StringHash("Spear Teldrassil"),false)
call FlushChildHashtable(udg_hash,h)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
endfunction
function Modificator_Magic_Sword takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local integer h1=LoadInteger(udg_hash,h,1)
call SaveBoolean(udg_hash,h1,StringHash("Magic Sword"),false)
call FlushChildHashtable(udg_hash,h)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
endfunction
function Trig_AtkSkill_Ghost_Sword takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local integer ID=LoadInteger(udg_hash,h,0)
set udg_ReflectDmg[ID]=udg_ReflectDmg[ID]-6.00
call FlushChildHashtable(udg_hash,h)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
endfunction
function Modificator_Tan takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local unit attack=LoadUnitHandle(udg_hash,h,0)
local integer i=LoadInteger(udg_hash,h,1)
local unit target=LoadUnitHandle(udg_hash,h,2)
local real dmg=LoadReal(udg_hash,h,3)
if i !=0 and UnitAlive(target)then
set i=i-1
call SaveInteger(udg_hash,h,1,i)
set dmg=dmg*(1+(1-GetUnitState(target,UNIT_STATE_LIFE)/GetUnitState(target,UNIT_STATE_MAX_LIFE)))
call UnitDamageTarget(attack,target,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
else
call SaveBoolean(udg_hash,GetHandleId(attack),StringHash("Spear Tan"),false)
call FlushChildHashtable(udg_hash,h)
call PauseTimer(t)
call DestroyTimer(t)
endif
set t=null
set attack=null
set target=null
endfunction
function Trig_AtkSkill_DeathPear takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit attack=LoadUnitHandle(udg_hash,ht,0)
local unit target=LoadUnitHandle(udg_hash,ht,1)
local real sec=LoadReal(udg_hash,ht,2)
local real dmg=LoadReal(udg_hash,ht,3)
local real x
local real y
local unit u
local real bonus=1+LoadReal(udg_hash,GetHandleId(attack),StringHash("Modificator"))
local group g=CreateGroup()
if sec>0 and UnitAlive(target)then
set sec=sec-0.5
call SaveReal(udg_hash,ht,2,sec)
call UnitDamageTarget(attack,target,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
else
set dmg=(GetHeroAgi(attack,true)*3.)*bonus
call SetUnitState(attack,UNIT_STATE_LIFE,GetUnitState(attack,UNIT_STATE_LIFE)+0.2*dmg)
set x=GetUnitX(target)
set y=GetUnitY(target)
set udg_Drop2=GetPlayerId(GetOwningPlayer(attack))
call GroupEnumUnitsInRange(g,x,y,400.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(attack,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Items\\OrbVenom\\OrbVenomSpecialArt.mdl",u,"chest")
call DestroyEffect(bj_lastCreatedEffect)
call GroupRemoveUnit(g,u)
endloop
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
call DestroyGroup(g)
set t=null
set attack=null
set target=null
set u=null
set g=null
endfunction
function Modificator takes unit hero,unit attack,unit target returns nothing
local integer a=0
local integer b
local integer ID=GetPlayerId(GetOwningPlayer(attack))+1
local integer h=GetHandleId(hero)
local integer ha=GetHandleId(attack)
local integer i
local integer i2
local boolean array HaveIt
local timer t
local integer ht
local real x
local real y
local real xa=GetUnitX(attack)
local real ya=GetUnitY(attack)
local real xt=GetUnitX(target)
local real yt=GetUnitY(target)
local real damage
local real dmg
local group g=CreateGroup()
local group g2=CreateGroup()
local unit u
local real bonus=1+LoadReal(udg_hash,h,StringHash("Modificator"))
local real Attacks=Summ_Attack(hero)
local string str
local integer highstat
local integer ids=ReturnTypeHeroId(GetHandleId(hero))
local real CD=s__Heroes_ModCD[sHero[ids]]
if target !=null then
if CD<=0 then
set CD=1
endif
if GetHeroStr(hero,true)>=GetHeroAgi(hero,true)then
if GetHeroStr(hero,true)>=GetHeroInt(hero,true)then
set highstat=GetHeroStr(hero,true)
else
set highstat=GetHeroInt(hero,true)
endif
else
if GetHeroAgi(hero,true)>=GetHeroInt(hero,true)then
set highstat=GetHeroAgi(hero,true)
else
set highstat=GetHeroInt(hero,true)
endif
endif
set udg_VampirHealTarget[ID]=target
set HaveIt[0]=false
set HaveIt[1]=false
set HaveIt[2]=false
set HaveIt[3]=false
set HaveIt[4]=false
set HaveIt[5]=false
set HaveIt[6]=false
set HaveIt[7]=false
set a=0
loop
exitwhen a>5
set b=GetItemTypeId(UnitItemInSlot(hero,a))
if b=='I06O' then
set HaveIt[0]=true
endif
if b=='I051' then
set HaveIt[1]=true
endif
if b=='I0DT' then
set HaveIt[2]=true
endif
if b=='I0BV' then
set HaveIt[3]=true
endif
if b=='I0AE' then
set HaveIt[4]=true
endif
if b=='I0AF' then
set HaveIt[5]=true
endif
if b=='I08Q' then
set HaveIt[6]=true
endif
if b=='I0BB' then
set HaveIt[7]=true
endif
set a=a+1
endloop
if HaveIt[0]then
set udg_DragonSlayerItem[ID]=udg_DragonSlayerItem[ID]+1
if udg_DragonSlayerItem[ID]>=3 then
set damage=(700+0.7*GetHeroInt(hero,true))*bonus
set udg_DragonSlayerItem[ID]=0
call UnitDamageTarget(attack,target,damage,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,xt,yt,275.,Bool_Filter_ID)
call GroupRemoveUnit(g,target)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(attack,u,damage,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
call GroupRemoveUnit(g,u)
endloop
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl",xt,yt)
call DestroyEffect(bj_lastCreatedEffect)
else
endif
endif
if HaveIt[1]then
if GetRandomInt(1,5)==1 then
set damage=60.
if LoadStr(udg_hash,h,2)=="Str" then
set damage=damage+0.4*GetHeroStr(hero,true)
else
if LoadStr(udg_hash,h,2)=="Agi" then
set damage=damage+0.4*GetHeroAgi(hero,true)
else
set damage=damage+0.4*GetHeroInt(hero,true)
endif
endif
set damage=damage*bonus/2
set bj_lastCreatedEffect=AddSpecialEffect("Objects\\Spawnmodels\\Orc\\Orcblood\\BattrollBlood.mdl",xt,yt)
call DestroyEffect(bj_lastCreatedEffect)
call UnitDamageTarget(attack,target,damage,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupDamage(xt,yt,225.,attack,false,damage,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
endif
endif
if HaveIt[2]then
set udg_DemolitronItem=udg_DemolitronItem+1
if udg_DemolitronItem>=6 then
set udg_DemolitronItem=0
set damage=(1000.+4.*GetHeroStr(hero,true))*bonus
call UnitDamageTarget(attack,target,damage,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,xt,yt,325.,Bool_Filter_ID)
call GroupRemoveUnit(g,target)
set damage=0.6*damage
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(attack,u,damage,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
call GroupRemoveUnit(g,u)
endloop
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl",xt,yt)
call DestroyEffect(bj_lastCreatedEffect)
set bj_lastCreatedEffect=AddSpecialEffect("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl",xt,yt)
call DestroyEffect(bj_lastCreatedEffect)
endif
endif
if HaveIt[3]then
if GetRandomInt(1,2)==1 then
set damage=(250+highstat*0.3)*bonus
call SetUnitState(attack,UNIT_STATE_LIFE,GetUnitState(attack,UNIT_STATE_LIFE)+0.5*damage)
call UnitDamageTarget(attack,target,damage,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",target,"origin")
call DestroyEffect(bj_lastCreatedEffect)
endif
endif
if HaveIt[4]then
if GetRandomInt(1,10)<=4 then
set damage=(1.25*GetHeroAgi(hero,true))*bonus
set udg_dmg=damage*0.5
set damage=damage*0.5
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,xa,ya,500.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(attack,u,udg_dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
call UnitDamageTarget(attack,u,damage,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
call GroupRemoveUnit(g,u)
endloop
set bj_lastCreatedEffect=AddSpecialEffect("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",xa,ya)
call DestroyEffect(bj_lastCreatedEffect)
endif
endif
if HaveIt[5]then
set dmg=(1.25*GetHeroAgi(hero,true))*bonus
call UnitDamageTarget(attack,target,0.5*dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
call UnitDamageTarget(attack,target,0.5*dmg,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",attack,"origin")
call DestroyEffect(bj_lastCreatedEffect)
endif
if HaveIt[6]then
if GetUnitLevel(target)>=30 then
set a=25
else
set a=10+GetUnitLevel(target)/2
endif
if GetRandomInt(1,100)<=a then
set damage=.4*highstat*bonus
call GroupDamage(xt,yt,175.,attack,false,damage,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
endif
endif
if HaveIt[7]then
set a=GetPlayerState(GetOwningPlayer(attack),PLAYER_STATE_RESOURCE_GOLD)
if a>30000 then
set damage=(1200+0.024*(a-30000))*bonus
set dmg=(900+0.018*(a-30000))*bonus
else
set damage=(0.04*a)*bonus
set dmg=(0.03*a)*bonus
endif
if LoadBoolean(udg_hash,h,StringHash("SetMidas"))then
set damage=2.*damage
set dmg=2.*dmg
endif
call UnitDamageTarget(attack,target,damage,false,true,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
if GetRandomInt(1,8)==1 then
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,xt,yt,250.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(attack,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
call GroupRemoveUnit(g,u)
endloop
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Other\\Incinerate\\IncinerateBuff.mdl",target,"origin")
call DestroyEffect(bj_lastCreatedEffect)
endif
endif
set HaveIt[0]=false
set HaveIt[1]=false
set HaveIt[2]=false
set HaveIt[3]=false
set HaveIt[4]=false
set HaveIt[5]=false
set HaveIt[6]=false
set HaveIt[7]=false
set a=0
loop
exitwhen a>5
set b=GetItemTypeId(UnitItemInSlot(hero,a))
if b=='I07B' then
set HaveIt[0]=true
endif
if b=='I063' then
set HaveIt[1]=true
endif
if b=='I0A0' then
set HaveIt[2]=true
endif
if b=='I04K' then
set HaveIt[3]=true
endif
if b=='I07W' then
set HaveIt[4]=true
endif
if b=='I0BQ' then
set HaveIt[5]=true
endif
if b=='I061' then
set HaveIt[6]=true
endif
if b=='I079' then
set HaveIt[7]=true
endif
set a=a+1
endloop
if HaveIt[0]then
if GetRandomInt(1,10)==2 then
set damage=(480+0.08*GetHeroAgi(hero,true))*bonus
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,xa,ya,400.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(attack,u,damage,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\Orc\\OrcSmallDeathExplode\\OrcSmallDeathExplode.mdl",u,"chest")
call DestroyEffect(bj_lastCreatedEffect)
call GroupRemoveUnit(g,u)
endloop
endif
endif
if HaveIt[1]then
if GetRandomInt(1,4)==1 then
set damage=(600+0.4*GetHeroStr(hero,true))*bonus
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,xa,ya,450.00,Bool_Filter_ID)
call RandomUnitFromGroup(3,g)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(attack,u,damage,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl",u,"origin")
call DestroyEffect(bj_lastCreatedEffect)
call GroupRemoveUnit(g,u)
endloop
endif
endif
if HaveIt[2]then
if GetRandomInt(1,5)==1 then
