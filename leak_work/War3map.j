endif
if drop[21]>0 then
set it=CreateItem('I006',x,y)
call UnitAddItem(u,it)
call SetWidgetLife(it,1)
call RemoveItem(it)
endif
else
set a=LoadInteger(Hash,h,0)
set s__Units_HP[sUnit[a]]=s__Units_HP[sUnit[a]]+hp
endif
set DelPowerUP=true
set it=null
endfunction
function F_Looting takes unit u,integer change,integer roll,real x,real y returns nothing
local integer ID=GetPlayerId(GetOwningPlayer(u))+1
local integer a
local integer b
local integer c
local integer Nchange=R2I(change*udg_Looting[ID])
if udg_Setstart then
set roll=2*roll
endif
set bj_forLoopBIndex=1
set bj_forLoopBIndexEnd=1+Nchange/roll
loop
exitwhen bj_forLoopBIndex>bj_forLoopBIndexEnd
if GetRandomInt(1,roll)<=Nchange then
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='thle' then
set a=GetRandomInt(1,4)
if a==1 then
call SetPlayerStateBJ(Player(ID-1),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(ID-1),PLAYER_STATE_RESOURCE_GOLD)+150+25*GetRandomInt(0,6))
elseif a==2 then
set b=GetRandomInt(1,3)
set c=GetRandomInt(2,4)
if b==1 then
call SetHeroStr(udg_Hero[ID],GetHeroStr(udg_Hero[ID],false)+c,true)
elseif b==2 then
call SetHeroAgi(udg_Hero[ID],GetHeroAgi(udg_Hero[ID],false)+c,true)
else
call SetHeroInt(udg_Hero[ID],GetHeroInt(udg_Hero[ID],false)+c,true)
endif
elseif a==3 then
set b=75+5*GetRandomInt(0,10)
set c=LoadInteger(Hash,GetHandleId(udg_Hero[ID]),0)
set s__Units_HP[sUnit[c]]=s__Units_HP[sUnit[c]]+b
else
set b=GetRandomInt(2,4)
if UnitAlive(udg_Hero[ID])then
call SummonStats(false,0,b,udg_Hero[ID],udg_Hero[ID])
else
call SaveInteger(udg_hash,GetHandleId(udg_Hero[ID]),StringHash("ResBaseDamage"),LoadInteger(udg_hash,GetHandleId(udg_Hero[ID]),StringHash("ResBaseDamage"))+b)
endif
endif
endif
if GetRandomInt(1,100)<=1 then
set c=GetRandomInt(1,4)
if c==1 then
call CreateItem('I0CA',x,y)
elseif c==2 then
call CreateItem('I0CC',x,y)
elseif c==3 then
call CreateItem('I0CB',x,y)
elseif c==4 then
call CreateItem('I0AB',x,y)
endif
else
set b=GetRandomInt(1,20)
if b<=17 then
set bj_forLoopAIndexEnd=1
elseif b<=19 then
set bj_forLoopAIndexEnd=2
else
set bj_forLoopAIndexEnd=3
endif
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set c=GetRandomInt(1,6)
if c==1 then
call CreateItem('I098',x,y)
elseif c==2 then
call CreateItem('I096',x,y)
elseif c==3 then
call CreateItem('I097',x,y)
elseif c==4 then
call CreateItem('I01U',x,y)
elseif c==5 then
call CreateItem('I099',x,y)
elseif c==6 then
call CreateItem('I04W',x,y)
endif
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
endif
if bj_forLoopBIndexEnd>1 then
set Nchange=Nchange-roll
endif
set bj_forLoopBIndex=bj_forLoopBIndex+1
endloop
endfunction
