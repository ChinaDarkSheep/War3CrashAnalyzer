function RandomEvent_StartTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
call StartTimerBJ(udg_SpawnTimer[1],true,30.)
call StartTimerBJ(udg_SpawnTimer[2],true,45.)
call StartTimerBJ(udg_SpawnTimer[3],true,60.)
call StartTimerBJ(udg_SpawnTimer[4],true,140.)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
endfunction
