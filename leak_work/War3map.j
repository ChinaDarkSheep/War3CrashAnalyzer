set bj_forLoopAIndexEnd=3
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set udg_point2=PolarProjectionBJ(udg_point,200.00,(I2R(GetForLoopIndexA())*120.00))
call AddSpecialEffectLocBJ(udg_point2,"Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call CreateNUnitsAtLoc(1,'e00F',ForcePickRandomPlayer(udg_CreepsPlayers),udg_point2,(I2R(GetForLoopIndexA())*120.00))
call GroupAddUnitSimple(GetLastCreatedUnit(),udg_A3)
call RemoveLocation(udg_point2)
set udg_point2=PolarProjectionBJ(udg_point,200.00,(60.00+(I2R(GetForLoopIndexA())*120.00)))
call AddSpecialEffectLocBJ(udg_point2,"Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call CreateNUnitsAtLoc(1,'e00G',ForcePickRandomPlayer(udg_CreepsPlayers),udg_point2,(I2R(GetForLoopIndexA())*120.00))
call GroupAddUnitSimple(GetLastCreatedUnit(),udg_A3)
call RemoveLocation(udg_point2)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call RemoveLocation(udg_point)
else
endif
if(Trig_FKills_Func002C())then
set udg_point=GetUnitLoc(GetDyingUnit())
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=3
loop
