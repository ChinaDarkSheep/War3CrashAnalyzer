function Gydra_E1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer i=LoadInteger(Hash,GetHandleId(hero),0)
local integer sec=LoadInteger(udg_hash,ht,0)-1
