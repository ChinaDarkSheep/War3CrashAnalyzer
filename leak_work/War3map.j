function Trig_Razlozenie_Q takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer talante=LoadInteger(udg_hash,ht,1)
local group g
local unit u
local integer a
if talante==2 then
set a=LoadInteger(udg_hash,ht,2)
set g=LoadGroupHandle(udg_hash,ht,3)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call SetUnitAbilityLevel(u,'A17N',GetUnitAbilityLevel(u,'A17N')-a)
if GetUnitAbilityLevel(u,'A17N')<2 then
call UnitRemoveAbility(u,'A17N')
endif
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set t=null
set caster=null
set u=null
set g=null
endfunction
function Trig_Razlozenie_W takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer i=LoadInteger(udg_hash,ht,1)
local unit u
local group g=CreateGroup()
local real x
local real y
local real x1
local real y1
local real dmg
if i !=0 and UnitAlive(caster)then
set i=i-1
call SaveInteger(udg_hash,ht,1,i)
set x=GetUnitX(caster)
set y=GetUnitY(caster)
if udg_Talante[GetPlayerId(GetOwningPlayer(caster))+1]==1 then
set dmg=(Summ_Attack(caster))*(1+LoadReal(udg_hash,GetHandleId(caster),StringHash("Modificator")))
if GetUnitAbilityLevel(caster,'A0C9')==1 then
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+0.01*GetUnitState(caster,UNIT_STATE_MAX_LIFE))
endif
else
set dmg=0.5*GetHeroStr(caster,true)
endif
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>16
set x1=x+390*Cos((GetUnitFacing(caster)+22.5*bj_forLoopAIndex)*bj_DEGTORAD)
set y1=y+390*Sin((GetUnitFacing(caster)+22.5*bj_forLoopAIndex)*bj_DEGTORAD)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl",x1,y1)
call DestroyEffect(bj_lastCreatedEffect)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,380.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
call DestroyGroup(g)
set g=null
set caster=null
set u=null
endfunction
function Trig_Razlozenie_R2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local unit u=null
local group g=CreateGroup()
local integer i=LoadInteger(udg_hash,ht,1)
local real x=LoadReal(udg_hash,ht,2)
local real y=LoadReal(udg_hash,ht,3)
local real dmg=600.+2.*GetHeroStr(caster,true)
if i>0 then
call SaveInteger(udg_hash,ht,1,i-1)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,500.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
call DestroyGroup(g)
set g=null
set caster=null
set u=null
endfunction
function Trig_Razlozenie_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local integer h=GetHandleId(caster)
local integer talante=udg_Talante[ID]
local real x
local real y
local real x1
local real y1
local real dmg
local timer t
local integer ht
local group g=CreateGroup()
local group g2
local unit u
local real r
local real z
local integer a
local integer i
if GetSpellAbilityId()=='A1BA' then
set t=CreateTimer()
set ht=GetHandleId(t)
set i=0
if talante==2 then
set r=10*GetUnitAbilityLevel(caster,'A1BA')+0.2*GetHeroStr(caster,true)
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set g2=CreateGroup()
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,425.,Bool_Filter_ID_Ally)
set i=5+GetUnitAbilityLevel(caster,'A1BA')
loop
set u=FirstOfGroup(g)
exitwhen u==null
if Player(ID-1)==GetOwningPlayer(u)and(GetUnitTypeId(u)=='nepl' or GetUnitTypeId(u)=='nenp')then
if GetHeroLevel(caster)>=50 then
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+0.2*GetUnitState(u,UNIT_STATE_MAX_LIFE))
endif
call GroupAddUnit(g2,u)
if GetUnitAbilityLevel(u,'A17N')==0 then
call UnitAddAbility(u,'A17N')
endif
