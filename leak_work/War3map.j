function HardcoreUP30_4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit ghost=LoadUnitHandle(udg_hash,ht,0)
local integer ID=LoadInteger(udg_hash,ht,1)
local real xg
local real yg
local real xh
local real yh
local real r
local real angle
local integer a
if UnitAlive(udg_Hero[ID])then
set xg=GetUnitX(ghost)
set yg=GetUnitY(ghost)
set xh=GetUnitX(udg_Hero[ID])
set yh=GetUnitY(udg_Hero[ID])
set angle=bj_RADTODEG*Atan2(yh-yg,xh-xg)
set xh=xh-xg
set yh=yh-yg
set r=SquareRoot(xh*xh+yh*yh)
if r>1000 then
set a=GetRandomInt(1,15)
set xg=xg+(150+r*0.15)*(0.05+0.05*a)*Cos(angle*bj_DEGTORAD)
set yg=yg+(150+r*0.15)*(0.05+0.05*a)*Sin(angle*bj_DEGTORAD)
call SetUnitX(ghost,xg)
call SetUnitY(ghost,yg)
call DestroyEffect(AddSpecialEffect("war3mapImported\\SoulRitual.mdl",xg,yg))
endif
if r>850 then
call IssuePointOrder(ghost,"move",GetUnitX(udg_Hero[ID]),GetUnitY(udg_Hero[ID]))
else
call IssueTargetOrder(ghost,"attack",udg_Hero[ID])
endif
else
call IssuePointOrder(ghost,"attack",-6400,12850)
endif
set t=null
endfunction
function HardcoreUP30_5_Build takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local real sec=LoadReal(udg_hash,ht,0)
local real x1=LoadReal(udg_hash,ht,1)
local real y1=LoadReal(udg_hash,ht,2)
local real x
local real y
local group g=CreateGroup()
local unit u
if sec>0 then
set sec=sec-0.25
call SaveReal(udg_hash,ht,0,sec)
if sec<3.5 then
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>4
if GetRandomInt(1,2)==1 then
set x=1
else
set x=-1
endif
if GetRandomInt(1,2)==1 then
set y=1
else
set y=-1
endif
set x=x1+x*20*GetRandomInt(1,25)
set y=y1+y*20*GetRandomInt(1,25)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl",x,y))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set udg_Drop2=11
call GroupEnumUnitsInRange(g,x1,y1,750.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if not IsUnitType(u,UNIT_TYPE_STRUCTURE)then
call UnitDamageTarget(udg_Hero[11],u,375+0.03*GetUnitState(u,UNIT_STATE_MAX_LIFE),false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
call GroupRemoveUnit(g,u)
endloop
endif
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
call DestroyGroup(g)
set g=null
set u=null
endfunction
