call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],30.00,"Очки зельеварения: "+I2S(udg_AlchemyPoints[ID]))
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],30.00,"Убийства для предмета \"Волшебный мешочек\": "+I2S(R2I(udg_MeshochekCount[ID])))
