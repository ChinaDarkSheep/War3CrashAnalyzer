function Trig_IncomeOgr takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer id=LoadInteger(Hash,ht,0)
local group g=CreateGroup()
local group g2=CreateGroup()
local unit u
local integer a
set bj_groupEnumTypeId='npgf'
call GroupEnumUnitsOfPlayer(g,Player(id),filterGetUnitsOfPlayerAndTypeId)
set a=20
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitInGroup(u,udg_IncomeGroup2)==true and UnitAlive(u)then
call SetPlayerStateBJ(Player(id),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)+a)
set GoldNT[id+1]=GoldNT[id+1]+a
call CreateTextTagUnitBJ("|cFFE3E300+"+I2S(a),u,0,9.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,90.00)
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
endif
call GroupRemoveUnit(g,u)
endloop
set bj_groupEnumTypeId='obea'
call GroupEnumUnitsOfPlayer(g,Player(id),filterGetUnitsOfPlayerAndTypeId)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitInGroup(u,udg_IncomeGroup2)==true and UnitAlive(u)then
set udg_Drop=0
set udg_Drop2=id
call GroupEnumUnitsInRange(g2,GetUnitX(u),GetUnitY(u),512.,Condition(function Filter_IncomeOgr_Pigfarm))
call ForGroup(g2,function Trig_IncomeOgr_Pigfarm)
set a=udg_Drop*10
if a>0 then
call SetPlayerStateBJ(Player(id),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)+a)
set GoldNT[id+1]=GoldNT[id+1]+a
call CreateTextTagUnitBJ("|cFFE3E300+"+I2S(a),u,0,9.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,90.00)
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
endif
endif
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
call DestroyGroup(g2)
set g=null
set g2=null
set u=null
set t=null
endfunction
