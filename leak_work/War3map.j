function Trig_GetAllTrain_Actions takes nothing returns nothing
local integer ID=GetPlayerId(GetOwningPlayer(GetTriggerUnit()))+1
local location p
local real x
local real y
if udg_Setstart then
set p=GetUnitRallyPoint(GetTriggerUnit())
set x=GetLocationX(p)
set y=GetLocationY(p)
call RemoveLocation(p)
if IsTerrainPathable(x,y,PATHING_TYPE_WALKABILITY)then
set x=x+GetRandomInt(-25,25)
set y=y+GetRandomInt(-25,25)
if IsTerrainPathable(x,y,PATHING_TYPE_WALKABILITY)then
set x=x+GetRandomInt(-25,25)
set y=y+GetRandomInt(-25,25)
if IsTerrainPathable(x,y,PATHING_TYPE_WALKABILITY)then
set x=0.
set y=0.
endif
endif
endif
if(x>0.1 or x<-0.1)and(y>0.1 or y<-0.1)then
call SetUnitPosition(GetTrainedUnit(),x,y)
endif
endif
if GetUnitTypeId(GetTrainedUnit())=='hfoo' then
if udg_BilderQuestAl[4]<60 and udg_BilderQuestAl[22]==0 then
if udg_BilderQuestAl[22]==0 then
set udg_BilderQuestAl[4]=(udg_BilderQuestAl[4]+1)
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],3.00,"Построенно пехотинцев: "+I2S(udg_BilderQuestAl[4])+"/60")
endif
endif
if udg_BilderQuestAl[22]==1 and GetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_LUMBER)>=200 then
set p=GetUnitRallyPoint(GetTriggerUnit())
set x=GetLocationX(p)
set y=GetLocationY(p)
if IsTerrainPathable(x,y,PATHING_TYPE_WALKABILITY)then
set x=x+GetRandomInt(-25,25)
set y=y+GetRandomInt(-25,25)
if IsTerrainPathable(x,y,PATHING_TYPE_WALKABILITY)then
set x=x+GetRandomInt(-25,25)
set y=y+GetRandomInt(-25,25)
if IsTerrainPathable(x,y,PATHING_TYPE_WALKABILITY)then
set x=0.
set y=0.
endif
endif
endif
set bj_lastCreatedUnit=CreateUnit(Player(ID-1),'hfoo',GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),bj_UNIT_FACING)
if(x>0.1 or x<-0.1)and(y>0.1 or y<-0.1)and udg_Setstart then
call SetUnitPosition(bj_lastCreatedUnit,x,y)
endif
set x=GetLocationX(p)
set y=GetLocationY(p)
call IssuePointOrder(bj_lastCreatedUnit,"move",x,y)
call RemoveLocation(p)
call AdjustPlayerStateBJ(-200,GetOwningPlayer(udg_HumanBuilder),PLAYER_STATE_RESOURCE_LUMBER)
endif
endif
set p=null
endfunction
