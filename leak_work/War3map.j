function Trig_WitchD_Actions takes nothing returns nothing
local real max_hp=GetUnitState(udg_Witch,UNIT_STATE_MAX_LIFE)
local real hp=GetUnitState(udg_Witch,UNIT_STATE_LIFE)
local real r=0.004*max_hp+0.01*hp
if hp>r then
call SetUnitState(udg_Witch,UNIT_STATE_LIFE,hp-r)
else
call SetUnitState(udg_Witch,UNIT_STATE_LIFE,1.)
endif
endfunction
