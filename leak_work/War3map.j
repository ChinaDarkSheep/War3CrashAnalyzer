endfunction
function Trig_LeaveNT_Actions takes nothing returns nothing
local integer is=GetPlayerId(GetTriggerPlayer())+1
local multiboarditem mbitem=null
set nameplayer[is]="|cFF8C8C8C"+nameplayer[is]
set StatusNT[is]="|c00FF0000Ливнул"
set is=1
loop
exitwhen is>PlayerOnlineNT+1
set mbitem=MultiboardGetItem(TableNT[10],is,1)
call MultiboardSetItemValue(mbitem,"|cffffcc00"+nameplayer[PlayerNumberNT[is]])
call MultiboardReleaseItem(mbitem)
set is=is+1
endloop
set is=1
loop
exitwhen is>8
set mbitem=MultiboardGetItem(TableNT[is],0,0)
call MultiboardSetItemValue(mbitem,StatusNT[is])
call MultiboardReleaseItem(mbitem)
set is=is+1
endloop
endfunction
function InitTrig_LeaveNT takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterPlayerEvent(t,Player(0),EVENT_PLAYER_LEAVE)
call TriggerRegisterPlayerEvent(t,Player(1),EVENT_PLAYER_LEAVE)
call TriggerRegisterPlayerEvent(t,Player(2),EVENT_PLAYER_LEAVE)
call TriggerRegisterPlayerEvent(t,Player(3),EVENT_PLAYER_LEAVE)
call TriggerRegisterPlayerEvent(t,Player(4),EVENT_PLAYER_LEAVE)
call TriggerRegisterPlayerEvent(t,Player(5),EVENT_PLAYER_LEAVE)
call TriggerRegisterPlayerEvent(t,Player(6),EVENT_PLAYER_LEAVE)
call TriggerRegisterPlayerEvent(t,Player(7),EVENT_PLAYER_LEAVE)
call TriggerAddAction(t,function Trig_LeaveNT_Actions)
set t=null
endfunction
function Trig_ButtonRightNT_Actions takes nothing returns nothing
local integer i=GetPlayerId(GetTriggerPlayer())+1
set butint[i]=butint[i]+1
if butint[i]==12 then
set butint[i]=9
endif
set i=1
loop
exitwhen i>11
if GetLocalPlayer()==GetTriggerPlayer()then
call MultiboardDisplay(TableNT[i],false)
endif
set i=i+1
endloop
set i=GetPlayerId(GetTriggerPlayer())+1
if butint[i]!=9 then
if GetLocalPlayer()==GetTriggerPlayer()then
call MultiboardDisplay(TableNT[butint[i]],true)
endif
endif
endfunction
function InitTrig_ButtonRightNT takes nothing returns nothing
set gg_trg_ButtonRightNT=CreateTrigger()
call TriggerRegisterPlayerKeyEventBJ(gg_trg_ButtonRightNT,Player(0),bj_KEYEVENTTYPE_DEPRESS,bj_KEYEVENTKEY_RIGHT)
call TriggerRegisterPlayerKeyEventBJ(gg_trg_ButtonRightNT,Player(1),bj_KEYEVENTTYPE_DEPRESS,bj_KEYEVENTKEY_RIGHT)
call TriggerRegisterPlayerKeyEventBJ(gg_trg_ButtonRightNT,Player(2),bj_KEYEVENTTYPE_DEPRESS,bj_KEYEVENTKEY_RIGHT)
call TriggerRegisterPlayerKeyEventBJ(gg_trg_ButtonRightNT,Player(3),bj_KEYEVENTTYPE_DEPRESS,bj_KEYEVENTKEY_RIGHT)
call TriggerRegisterPlayerKeyEventBJ(gg_trg_ButtonRightNT,Player(4),bj_KEYEVENTTYPE_DEPRESS,bj_KEYEVENTKEY_RIGHT)
call TriggerRegisterPlayerKeyEventBJ(gg_trg_ButtonRightNT,Player(5),bj_KEYEVENTTYPE_DEPRESS,bj_KEYEVENTKEY_RIGHT)
call TriggerRegisterPlayerKeyEventBJ(gg_trg_ButtonRightNT,Player(6),bj_KEYEVENTTYPE_DEPRESS,bj_KEYEVENTKEY_RIGHT)
call TriggerRegisterPlayerKeyEventBJ(gg_trg_ButtonRightNT,Player(7),bj_KEYEVENTTYPE_DEPRESS,bj_KEYEVENTKEY_RIGHT)
call TriggerAddAction(gg_trg_ButtonRightNT,function Trig_ButtonRightNT_Actions)
endfunction
function Trig_ButtonLeftNT_Actions takes nothing returns nothing
local integer i=GetPlayerId(GetTriggerPlayer())+1
set butint[i]=butint[i]-1
