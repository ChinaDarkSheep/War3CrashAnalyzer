function EnemyDmgABlock takes real dmg,real block returns nothing
local integer i=8
set PlDmg[i]=PlDmg[i]*dmg
set PlBlock[i]=PlBlock[i]*block
set i=10
set PlDmg[i]=PlDmg[i]*dmg
set PlBlock[i]=PlBlock[i]*block
set i=11
set PlDmg[i]=PlDmg[i]*dmg
set PlBlock[i]=PlBlock[i]*block
endfunction
function Trig_RandomAttack_Actions takes nothing returns nothing
local integer a
local integer b
local integer i
local timer t
local integer ht
local real x
local real y
local group g=CreateGroup()
set HardcoreUP10=HardcoreUP10+100
set HardcoreBuff10=HardcoreBuff10+100
set a=0
loop
exitwhen a>8
set GiveDamage[a]=0
set TakeDamage[a]=0
set a=a+1
endloop
call DisableTrigger(gg_trg_PeriodicalAttacks)
call DisableTrigger(gg_trg_Every30sec)
call DisableTrigger(gg_trg_Every45sec)
call DisableTrigger(gg_trg_Every60_sec)
call DisableTrigger(gg_trg_Every140sec)
set udg_Setstart=true
call PauseTimerBJ(true,udg_Timer5min)
if udg_Mode==2 then
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,45,"|cffffcc00Сложность: "+I2S(HardcoreLvl)+"|r")
