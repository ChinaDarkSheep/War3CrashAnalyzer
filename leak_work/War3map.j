function HeroD53_var3_Wave takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer Id=GetHandleId(t)
local real dmg=LoadReal(udg_hash,Id,1)
local real angle=LoadReal(udg_hash,Id,2)
local real x=LoadReal(udg_hash,Id,3)
local real y=LoadReal(udg_hash,Id,4)
local unit u=LoadUnitHandle(udg_hash,Id,1)
local unit u3
local group ug_check=LoadGroupHandle(udg_hash,Id,2)
local group l__ug=CreateGroup()
local player pl=GetOwningPlayer(u)
local real x2
local real y2
local real range=LoadReal(udg_hash,Id,5)
local real L=0
local real aoe=300
set range=range+100
call SaveReal(udg_hash,Id,5,range)
if range<=400 then
loop
set L=L+25
exitwhen L>75
set x2=x+range*Cos((L+angle-50)*bj_DEGTORAD)
set y2=y+range*Sin((L+angle-50)*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",x2,y2))
set udg_Drop2=GetPlayerId(GetOwningPlayer(u))
call GroupEnumUnitsInRange(l__ug,x2,y2,aoe,Bool_Filter_ID)
loop
set u3=FirstOfGroup(l__ug)
exitwhen u3==null
if not IsUnitInGroup(u3,ug_check)then
call UnitDamageTarget(u,u3,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
call GroupAddUnit(ug_check,u3)
endif
call GroupRemoveUnit(l__ug,u3)
endloop
endloop
elseif range<=1200 then
loop
set L=L+15
exitwhen L>75
set x2=x+range*Cos((L+angle-45)*bj_DEGTORAD)
set y2=y+range*Sin((L+angle-45)*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",x2,y2))
set udg_Drop2=GetPlayerId(GetOwningPlayer(u))
call GroupEnumUnitsInRange(l__ug,x2,y2,aoe,Bool_Filter_ID)
loop
set u3=FirstOfGroup(l__ug)
exitwhen u3==null
if not IsUnitInGroup(u3,ug_check)then
call UnitDamageTarget(u,u3,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
call GroupAddUnit(ug_check,u3)
endif
call GroupRemoveUnit(l__ug,u3)
endloop
endloop
else
loop
set L=L+11
exitwhen L>77
set x2=x+range*Cos((L+angle-44)*bj_DEGTORAD)
set y2=y+range*Sin((L+angle-44)*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",x2,y2))
set udg_Drop2=GetPlayerId(GetOwningPlayer(u))
call GroupEnumUnitsInRange(l__ug,x2,y2,aoe,Bool_Filter_ID)
loop
set u3=FirstOfGroup(l__ug)
exitwhen u3==null
if not IsUnitInGroup(u3,ug_check)then
call UnitDamageTarget(u,u3,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
call GroupAddUnit(ug_check,u3)
endif
call GroupRemoveUnit(l__ug,u3)
endloop
endloop
endif
if range>=2000 then
call DestroyGroup(ug_check)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,Id)
endif
call DestroyGroup(l__ug)
set t=null
set u=null
set u3=null
set pl=null
set l__ug=null
set ug_check=null
endfunction
function Trig_HeroD53_var3_Actions takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local unit u3
local integer Id_u=GetHandleId(u)
local timer t=LoadTimerHandle(udg_hash,Id_u,1)
local timer t2=LoadTimerHandle(udg_hash,Id_u,2)
local integer Id=GetHandleId(t)
local integer Id2=GetHandleId(t2)
local player pl=GetOwningPlayer(u)
local texttag text
local integer int_bonus_all=LoadInteger(udg_hash,Id_u,'r')
local real px=GetSpellTargetX()
local real py=GetSpellTargetY()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local group l__ug=CreateGroup()
local group ug_check=CreateGroup()
local real dmg
local real angle
local integer hh=GetHandleId(u)
local integer ihu=LoadInteger(udg_hash,hh,5)
set text=LoadTextTagHandle(udg_hash,Id2,2)
call DestroyTextTag(text)
call FlushChildHashtable(udg_hash,Id)
call FlushChildHashtable(udg_hash,Id2)
call PauseTimer(t)
call PauseTimer(t2)
call DestroyTimer(t)
call DestroyTimer(t2)
call SaveInteger(udg_hash,Id_u,'r',0)
set s__Heroes_TempInt[sHero[ihu]]=s__Heroes_TempInt[sHero[ihu]]-int_bonus_all
call SetUnitVertexColor(u,255,255,255,255)
set dmg=400+5.*GetHeroInt(u,true)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",x,y))
set udg_Drop2=GetPlayerId(GetOwningPlayer(u))
call GroupEnumUnitsInRange(l__ug,x,y,250,Bool_Filter_ID)
loop
set u3=FirstOfGroup(l__ug)
exitwhen u3==null
call UnitDamageTarget(u,u3,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
call GroupAddUnit(ug_check,u3)
call GroupRemoveUnit(l__ug,u3)
endloop
set angle=bj_RADTODEG*Atan2(py-y,px-x)
set t=CreateTimer()
set Id=GetHandleId(t)
call SaveReal(udg_hash,Id,1,dmg)
call SaveReal(udg_hash,Id,2,angle)
call SaveReal(udg_hash,Id,3,x)
call SaveReal(udg_hash,Id,4,y)
call SaveUnitHandle(udg_hash,Id,1,u)
call SaveGroupHandle(udg_hash,Id,2,ug_check)
call TimerStart(t,0.07,true,function HeroD53_var3_Wave)
call DisableTrigger(gg_trg_HeroD53_var3)
set u=null
set u3=null
call DestroyGroup(l__ug)
set l__ug=null
set ug_check=null
set pl=null
set t=null
set t2=null
set text=null
endfunction
function InitTrig_HeroD53_var3 takes nothing returns nothing
set gg_trg_HeroD53_var3=CreateTrigger()
call DisableTrigger(gg_trg_HeroD53_var3)
call TriggerAddCondition(gg_trg_HeroD53_var3,Condition(function HeroD53_var3_conditions))
call TriggerAddAction(gg_trg_HeroD53_var3,function Trig_HeroD53_var3_Actions)
endfunction
function s__ColorDialog_create takes nothing returns integer
local integer this=s__ColorDialog__allocate()
set s__ColorDialog_window[this]=DialogCreate()
set s__ColorDialog_id[this]=GetHandleId(s__ColorDialog_window[this])
call SaveInteger(Hash,DialogParentKey,s__ColorDialog_id[this],this)
set s__ColorDialog_whoSee[this]=CreateForce()
set s__ColorDialog_next[this]=this
set s__ColorDialog_prev[this]=this
return this
endfunction
function s__ColorDialog_getClicked takes nothing returns integer
return LoadInteger(Hash,DialogParentKey,GetHandleId(GetClickedDialog()))
endfunction
function s__ColorDialog_addButton takes integer this,string text,integer color returns nothing
call SaveInteger(Hash,s__ColorDialog_id[this],GetHandleId(DialogAddButton(s__ColorDialog_window[this],text,0)),color)
endfunction
function s__ColorDialog_getClickedColor takes integer this returns integer
return LoadInteger(Hash,s__ColorDialog_id[this],GetHandleId(GetClickedButton()))
endfunction
function s__ColorDialog_addColorButton takes integer this,integer color returns nothing
call s__ColorDialog_addButton(this,s__Color_hex[color]+s__Color_name[color],color)
endfunction
function s__ColorDialog_addColorButtons takes integer this,integer index returns integer
local integer n=0
loop
exitwhen index>=bj_MAX_PLAYERS or n==MaxColorsOnPage
call s__ColorDialog_addColorButton(this,(index))
set index=index+1
set n=n+1
endloop
return index
endfunction
function s__ColorDialog_addNextButton takes integer this,integer next returns nothing
set s__ColorDialog_next[this]=next
call s__ColorDialog_addButton(this,Message_NextPage,ColorDialogs___COLOR_NEXT)
endfunction
function s__ColorDialog_addPrevButton takes integer this,integer prev returns nothing
set s__ColorDialog_prev[this]=prev
call s__ColorDialog_addButton(this,Message_PrevPage,ColorDialogs___COLOR_PREV)
endfunction
function s__ColorDialog_addCloseButton takes integer this returns nothing
call s__ColorDialog_addButton(this,Message_Close,ColorDialogs___COLOR_CLOSE)
endfunction
function s__ColorDialog_toggleViewForPlayer takes integer this,player p,boolean show returns nothing
if show then
call ForceAddPlayer(s__ColorDialog_whoSee[this],p)
call DialogDisplay(p,s__ColorDialog_window[this],true)
elseif IsPlayerInForce(p,s__ColorDialog_whoSee[this])then
call ForceRemovePlayer(s__ColorDialog_whoSee[this],p)
if p==GetLocalPlayer()then
call EnableUserControl(true)
endif
endif
endfunction
function s__ColorDialog_show takes integer this,player p returns nothing
call s__ColorDialog_toggleViewForPlayer(this,p,true)
endfunction
function s__ColorDialog_hide takes integer this,player p returns nothing
call s__ColorDialog_toggleViewForPlayer(this,p,false)
endfunction
function s__ColorDialog_destroy takes integer this returns nothing
local integer a=0
if IsPlayerInForce(GetLocalPlayer(),s__ColorDialog_whoSee[this])then
call EnableUserControl(true)
endif
call DestroyForce(s__ColorDialog_whoSee[this])
set s__ColorDialog_whoSee[this]=null
call FlushChildHashtable(Hash,s__ColorDialog_id[this])
call RemoveSavedInteger(Hash,DialogParentKey,s__ColorDialog_id[this])
call DialogDestroy(s__ColorDialog_window[this])
set s__ColorDialog_window[this]=null
endfunction
function ColorDialogs___ChangeColorFilter takes nothing returns nothing
call SetUnitColor(GetFilterUnit(),ColorDialogs___NewColor)
endfunction
function ColorDialogs___TriggerClick_Actions takes nothing returns nothing
local player p=GetTriggerPlayer()
local integer d=s__ColorDialog_getClicked()
local integer color=s__ColorDialog_getClickedColor(d)
call s__ColorDialog_hide(d,p)
if color==ColorDialogs___COLOR_NEXT then
call s__ColorDialog_show(s__ColorDialog_next[d],p)
elseif color==ColorDialogs___COLOR_PREV then
call s__ColorDialog_show(s__ColorDialog_prev[d],p)
elseif-1<color and color<bj_MAX_PLAYERS then
set ColorDialogs___NewColor=ConvertPlayerColor(color)
call SetPlayerColor(p,ColorDialogs___NewColor)
call GroupEnumUnitsOfPlayer(ColorGroup,p,ColorDialogs___ChangeUnitColor)
endif
set p=null
endfunction
function ColorDialogs___init takes nothing returns nothing
local integer number=R2Iup(1.*bj_MAX_PLAYERS/MaxColorsOnPage)-1
local integer top=-1
local integer array dialogs
local integer a=0
loop
exitwhen top>=number
set top=top+1
set dialogs[top]=s__ColorDialog_create()
call TriggerRegisterDialogEvent(TriggerClick,s__ColorDialog_window[dialogs[top]])
set a=s__ColorDialog_addColorButtons(dialogs[top],a)
endloop
if number==0 then
call s__ColorDialog_addCloseButton(dialogs[0])
else
call s__ColorDialog_addNextButton(dialogs[0],dialogs[1])
call s__ColorDialog_addPrevButton(dialogs[0],dialogs[top])
call s__ColorDialog_addCloseButton(dialogs[0])
call s__ColorDialog_addNextButton(dialogs[top],dialogs[0])
call s__ColorDialog_addPrevButton(dialogs[top],dialogs[top-1])
call s__ColorDialog_addCloseButton(dialogs[top])
set a=1
loop
exitwhen a>=top
call s__ColorDialog_addNextButton(dialogs[a],dialogs[a+1])
call s__ColorDialog_addPrevButton(dialogs[a],dialogs[a-1])
call s__ColorDialog_addCloseButton(dialogs[a])
set a=a+1
endloop
endif
set FirstPage=dialogs[0]
set ColorDialogs___ChangeUnitColor=Filter(function ColorDialogs___ChangeColorFilter)
call TriggerAddAction(TriggerClick,function ColorDialogs___TriggerClick_Actions)
endfunction
function Trig_ColorTrig_Actions takes nothing returns nothing
call s__ColorDialog_show(FirstPage,GetTriggerPlayer())
endfunction
function InitTrig_ColorTrig takes nothing returns nothing
set gg_trg_ColorTrig=CreateTrigger()
call DisableTrigger(gg_trg_ColorTrig)
call TriggerRegisterPlayerChatEvent(gg_trg_ColorTrig,Player(0),"-color",true)
call TriggerRegisterPlayerChatEvent(gg_trg_ColorTrig,Player(1),"-color",true)
call TriggerRegisterPlayerChatEvent(gg_trg_ColorTrig,Player(2),"-color",true)
call TriggerRegisterPlayerChatEvent(gg_trg_ColorTrig,Player(3),"-color",true)
call TriggerRegisterPlayerChatEvent(gg_trg_ColorTrig,Player(4),"-color",true)
call TriggerRegisterPlayerChatEvent(gg_trg_ColorTrig,Player(5),"-color",true)
call TriggerRegisterPlayerChatEvent(gg_trg_ColorTrig,Player(6),"-color",true)
call TriggerRegisterPlayerChatEvent(gg_trg_ColorTrig,Player(7),"-color",true)
call TriggerAddAction(gg_trg_ColorTrig,function Trig_ColorTrig_Actions)
endfunction
function Trig_Sheat_Actions takes nothing returns nothing
local string text=GetEventPlayerChatString()
local string command=SubString(text,1,15)
if command=="start" then
call TriggerExecute(gg_trg_Delete)
elseif command=="immortal" then
if GetUnitAbilityLevel(gg_unit_htow_0002,'Avul')!=1 then
call UnitAddAbility(gg_unit_htow_0002,'Avul')
else
call UnitRemoveAbility(gg_unit_htow_0002,'Avul')
endif
elseif command=="createhero" and udg_Hero[2]==null then
set udg_Circle[2]=CreateUnit(Player(1),'ncop',-4864.,15424.,270.)
call CreateUnit(Player(1),'Hpb2',GetRectCenterX(gg_rct_HeroPick),GetRectCenterY(gg_rct_HeroPick),0)
call SetPlayerAllianceStateBJ(Player(1),Player(0),bj_ALLIANCE_ALLIED_ADVUNITS)
endif
set text=""
set command=""
endfunction
function InitTrig_Sheat takes nothing returns nothing
set gg_trg_Sheat=CreateTrigger()
call DisableTrigger(gg_trg_Sheat)
call TriggerRegisterPlayerChatEvent(gg_trg_Sheat,Player(0),"-",false)
call TriggerAddAction(gg_trg_Sheat,function Trig_Sheat_Actions)
endfunction
function Trig_CommandJass_Actions takes nothing returns nothing
local string text=GetEventPlayerChatString()
local string command=SubString(text,1,5)
local string s
local integer i
local integer a
local integer id=GetPlayerId(GetTriggerPlayer())
local integer ID=id+1
local real r=0
if command=="gold" then
set i=S2I(SubString(text,6,7))-1
set a=S2I(SubString(text,8,15))
if i<0 or i>8 then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Неккоретный номер игрока|r")
else
if GetPlayerSlotState(Player(i))!=PLAYER_SLOT_STATE_PLAYING then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Этот игрок не в игре!|r")
else
if IsPlayerAlly(Player(i),Player(id))==false then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Нельзя передавать врагу!|r")
else
if i==id then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Нелья передавать самому себе|r")
else
if i<0 or i>9 then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Неккоретный номер игрока|r")
else
if a>0 and a<=GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)then
call SetPlayerStateBJ(Player(i),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD)+a)
call SetPlayerStateBJ(Player(id),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)-a)
call DisplayTextToForce(bj_FORCE_PLAYER[i],"|cffffcc00Вы получили: "+I2S(a)+" золота от "+GetPlayerName(Player(id))+"|r")
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Отправлено: "+I2S(a)+" золота игроку "+GetPlayerName(Player(i))+"|r")
else
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Неккоретная сумма|r")
endif
endif
endif
endif
endif
endif
endif
if command=="wood" and SubString(text,6,7)!="" and SubString(text,6,7)!=" " and SubString(text,8,15)!="" and SubString(text,8,15)!=" " then
set i=S2I(SubString(text,6,7))-1
set a=S2I(SubString(text,8,15))
if i<0 or i>8 then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Неккоретный номер игрока|r")
else
if GetPlayerSlotState(Player(i))!=PLAYER_SLOT_STATE_PLAYING then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Этот игрок не в игре!|r")
else
if IsPlayerAlly(Player(i),Player(id))==false then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Нельзя передавать врагу!|r")
else
if i==id then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Нелья передавать самому себе|r")
else
if i<0 or i>9 then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Неккоретный номер игрока|r")
else
if a>0 and a<=GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_LUMBER)then
call SetPlayerStateBJ(Player(i),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(Player(i),PLAYER_STATE_RESOURCE_LUMBER)+a)
call SetPlayerStateBJ(Player(id),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_LUMBER)-a)
call DisplayTextToForce(bj_FORCE_PLAYER[i],"|cffffcc00Вы получили: "+I2S(a)+" дерева от "+GetPlayerName(Player(id))+"|r")
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Отправлено: "+I2S(a)+" дерева игроку "+GetPlayerName(Player(i))+"|r")
else
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Неккоретная сумма|r")
endif
endif
endif
endif
endif
endif
endif
set command=SubString(text,1,6)
if udg_Mode==2 then
if not udg_Setstart then
if(command=="HcLvl" or command=="Hclvl" or command=="hclvl")then
set a=S2I(SubString(text,7,8))
if a<1 or a>3 then
set a=1
endif
set HardcoreLvl=a
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,30,"|cffffcc00Установлена сложность: "+I2S(a)+"|r")
endif
else
if(command=="he" or command=="ру")then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],45,HardcoreBuff10Str+"\n"+HardcoreUP10Str+"\n"+HardcoreUP30Str)
endif
endif
endif
set command=SubString(text,1,8)
if command=="r" or command=="к" or command=="repair" or command=="кузфшк" then
if UnitAlive(gg_unit_htow_0002)==false then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Апотропа нет на карте!|r")
else
if GetUnitState(gg_unit_htow_0002,UNIT_STATE_LIFE)/GetUnitState(gg_unit_htow_0002,UNIT_STATE_MAX_LIFE)==1 then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00У Апотропа полное здоровье|r")
else
if GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)>4500 then
call SetUnitLifePercentBJ(gg_unit_htow_0002,(GetUnitLifePercent(gg_unit_htow_0002)+25.00))
set SpendGold[ID]=SpendGold[ID]+4500
call SetPlayerStateBJ(Player(id),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)-4500)
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFF00C850Ремонт прошёл успешно!|r")
else
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Неккоретная сумма|r")
endif
endif
endif
endif
if command=="re" or command=="reactor" or command=="р" then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00"+LoadStr(udg_hash,GetHandleId(udg_Hero[id+1]),StringHash("Aganime"))+"|r")
endif
if command=="stat" then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],60.00,"Имя игрока - его очки - его уровень:")
set bj_forLoopAIndex=0
set bj_forLoopAIndexEnd=8
loop
exitwhen bj_forLoopAIndex>=bj_forLoopAIndexEnd
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],60.00,GetPlayerName(Player(bj_forLoopAIndex))+"     "+I2S(udg_PlayerExp[bj_forLoopAIndex+1])+"     "+I2S(GetPlayerTechCount(Player(bj_forLoopAIndex),'R02B',true)))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
if command=="info" then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],60.00,"Имя игрока - его номер:")
set bj_forLoopAIndex=0
set bj_forLoopAIndexEnd=8
loop
exitwhen bj_forLoopAIndex>=bj_forLoopAIndexEnd
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],60.00,GetPlayerName(Player(bj_forLoopAIndex))+"     "+I2S(bj_forLoopAIndex+1))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
if command=="clear" or command=="c" then
call ClearTextMessagesBJ(bj_FORCE_PLAYER[id])
endif
if command=="m" or command=="miasm" then
if GetTriggerPlayer()==GetOwningPlayer(udg_Lich)then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],10,"Очков миазм:  "+R2S(udg_Miasm))
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],10,"Некромантия:  "+R2S(udg_Miasm+GetUnitState(udg_Lich,UNIT_STATE_MAX_MANA)*0.8))
endif
endif
if command=="dmg" then
if GetUnitAbilityLevel(udg_Hero[ID],'A0A2')>0 then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],10,("Текущий накопленный урон: "+I2S(udg_BersDMG)))
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],10,"+15 ед. за подбор книги или монетки")
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],10,"+2 ед. за любое убийство")
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],10,"+8 ед. за убийство умением Копьё духов")
endif
if GetTriggerPlayer()==GetOwningPlayer(udg_Bat)then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],10,("Текущий накопленный урон: "+R2S(LoadReal(udg_hash,GetHandleId(udg_Hero[ID]),'d'))+" (без учета макс. здоровья и бомб)"))
if UnitHasItemOfTypeBJ(udg_Hero[ID],'I0BD')then
set r=1.4*GetUnitState(udg_Bat,UNIT_STATE_MAX_LIFE)
else
if UnitHasItemOfTypeBJ(udg_Hero[ID],'I013')then
set r=0.8*GetUnitState(udg_Hero[ID],UNIT_STATE_MAX_LIFE)
else
set r=0.4*GetUnitState(udg_Hero[ID],UNIT_STATE_MAX_LIFE)
endif
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],10,"Суммарный урон: "+R2S(LoadReal(udg_hash,GetHandleId(udg_Hero[ID]),'d')+r)+" (с макс. здоровьем)")
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],10,"15% от макс здоровья")
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],10,"+22 ед. за подбор книги или монетки")
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],10,"+2 ед. за любое убийство")
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],10,"+4/6/8/10/12 дополнительных ед. за любое убийство под действием умения Режим берсерка")
endif
endif
if GetTriggerPlayer()==GetOwningPlayer(udg_Witch)then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],10,"Текущий бонус от умения \"Порочное колдовство\": +"+I2S(R2I(udg_WitchDBonus*100))+"%")
endif
endif
if command=="z" or command=="з" then
call SetCameraFieldForPlayer(GetTriggerPlayer(),CAMERA_FIELD_TARGET_DISTANCE,2400.00,2.00)
endif
if command=="regen" or command=="reg" then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],8.00,"Регенерация здоровья:  "+R2S(F_HPregen(udg_Hero[ID])))
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],8.00,"Регенерация маны:  "+R2S(F_MPregen(udg_Hero[ID])))
endif
if command=="attack" or command=="at" then
