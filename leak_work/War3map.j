function Trig_GuardianSkill_Actions takes nothing returns nothing
local unit hero=GetTriggerUnit()
local integer h=GetHandleId(hero)
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local integer ihh=LoadInteger(udg_hash,h,5)
local real x
local real y
local real dmg
local real dmg1
local real r
local real z
local unit u
local group g=CreateGroup()
local integer a
local timer t
local integer ht
if GetSpellAbilityId()=='A12C' then
if udg_Talante[ID]==2 then
set x=GetUnitX(hero)
set y=GetUnitY(hero)
set udg_Drop2=GetPlayerId(GetOwningPlayer(hero))
call GroupEnumUnitsInRange(g,x,y,350.,Bool_Filter_ID_Ally)
else
call GroupAddUnit(g,hero)
endif
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)and GetOwningPlayer(u)==Player(ID-1)then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call SaveInteger(udg_hash,ht,0,8*2)
call SaveEffectHandle(udg_hash,ht,1,AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl",u,"origin"))
call TimerStart(t,0.5,true,function GuardianQ)
endif
call GroupRemoveUnit(g,u)
endloop
elseif GetSpellAbilityId()=='A02C' then
set dmg=GetUnitAbilityLevel(hero,'A02C')*60+GetHeroStr(hero,true)
if udg_Talante[ID]==1 then
set dmg=dmg+2*GetHeroStr(hero,true)
elseif udg_Talante[ID]==2 then
set z=0.04*GetUnitState(hero,UNIT_STATE_MAX_LIFE)+0.1*GetHeroInt(hero,true)
set r=0.3*GetUnitState(hero,UNIT_STATE_MAX_LIFE)+2*GetHeroInt(hero,true)
if GetHeroLevel(hero)>=50 then
set r=r*2
endif
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>3
set x=GetUnitX(hero)+175*Cos((GetUnitFacing(hero)+180*bj_forLoopAIndex)*bj_DEGTORAD)
set y=GetUnitY(hero)+175*Sin((GetUnitFacing(hero)+180*bj_forLoopAIndex)*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(hero),'e00I',x,y,GetUnitFacing(hero))
if GetHeroLevel(hero)>=50 then
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+10)
endif
call UnitAddAbility(u,'A007')
call SummonStats(false,R2I(GetUnitAbilityLevel(hero,'A02C')*300),R2I(GetUnitAbilityLevel(hero,'A02C')*15),u,hero)
call SummonStats(true,R2I(r),R2I(z),u,hero)
call UnitRemoveAbility(u,'A007')
call UnitApplyTimedLife(u,'BTLF',30)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
set x=GetUnitX(hero)
set y=GetUnitY(hero)
set dmg1=dmg+2*GetHeroStr(hero,true)
set udg_Drop2=GetPlayerId(GetOwningPlayer(hero))
call GroupEnumUnitsInRange(g,x,y,350.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitInGroup(u,udg_NatureGuardianW)then
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl",u,"origin")
call DestroyEffect(bj_lastCreatedEffect)
if GetUnitState(hero,UNIT_STATE_LIFE)/GetUnitState(hero,UNIT_STATE_MAX_LIFE)>=0.5 then
call UnitDamageTarget(hero,u,1.5*dmg1,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
else
call UnitDamageTarget(hero,u,1.5*dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
else
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl",u,"origin")
call DestroyEffect(bj_lastCreatedEffect)
if GetUnitState(hero,UNIT_STATE_LIFE)/GetUnitState(hero,UNIT_STATE_MAX_LIFE)>=0.5 then
call UnitDamageTarget(hero,u,dmg1,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
else
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
call GroupAddUnit(udg_NatureGuardianW,u)
endif
call GroupRemoveUnit(g,u)
endloop
elseif GetSpellAbilityId()=='A02E' then
set x=GetUnitX(hero)
set y=GetUnitY(hero)
set u=CreateUnit(Player(ID-1),'e000',x,y,GetUnitFacing(hero))
call UnitApplyTimedLife(u,'BTLF',50)
if udg_Talante[ID]==1 then
call UnitAddAbility(u,'A17O')
call SetUnitAbilityLevel(u,'A17O',GetUnitAbilityLevel(u,'A17O')+8)
endif
call UnitAddAbility(u,'A007')
call UnitAddAbility(u,'A12P')
set dmg=GetUnitState(hero,UNIT_STATE_MAX_LIFE)-(16.5*0.5*s__Heroes_TempStr[sHero[ihh]])
call SummonStats(true,R2I(dmg*2),R2I(dmg*0.1),u,hero)
call UnitRemoveAbility(u,'A007')
endif
call DestroyGroup(g)
set hero=null
set u=null
set t=null
set g=null
endfunction
