function PaladinSkills_Q_T takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,h,0)
local integer i=LoadInteger(udg_hash,h,1)
local integer tik=LoadInteger(udg_hash,h,4)
local integer talante=LoadInteger(udg_hash,h,5)
local integer a=0
local real x=LoadReal(udg_hash,h,2)
local real y=LoadReal(udg_hash,h,3)
local real x1
local real y1
local group g=CreateGroup()
local unit u
local real heal=50*GetUnitAbilityLevel(caster,'A03I')
local real dmg=40*GetUnitAbilityLevel(caster,'A03I')
if i !=0 then
if tik==3 and GetUnitAbilityLevel(caster,'A0CD')==1 then
set tik=0
set heal=heal+GetHeroInt(caster,true)
set dmg=dmg+GetHeroStr(caster,true)
else
set tik=tik+1
endif
if talante==1 then
set dmg=2.*dmg
endif
if talante==2 then
set heal=heal+50*GetUnitAbilityLevel(caster,'A03I')
if tik==3 and GetUnitAbilityLevel(caster,'A0CD')==1 then
set heal=heal+.75*GetHeroStr(caster,true)
endif
endif
set i=i-1
call SaveInteger(udg_hash,h,1,i)
call SaveInteger(udg_hash,h,4,tik)
call GroupEnumUnitsInRange(g,x,y,300.,Bool_FilterAlive)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitEnemy(u,GetOwningPlayer(caster))then
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
else
call Heal(true,heal,u,caster)
if talante==2 and GetOwningPlayer(u)!=GetOwningPlayer(caster)then
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+0.02*GetUnitState(u,UNIT_STATE_MAX_LIFE))
endif
if u==caster then
set a=1
endif
endif
call GroupRemoveUnit(g,u)
endloop
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=5
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set bj_forLoopBIndex=1
set bj_forLoopBIndexEnd=2
loop
exitwhen bj_forLoopBIndex>bj_forLoopBIndexEnd
set x1=x+GetRandomReal(30.,290.)*Cos(GetRandomReal(bj_forLoopAIndex*72.,(bj_forLoopAIndex+1)*72.)*bj_DEGTORAD)
set y1=y+GetRandomReal(30.,290.)*Sin(GetRandomReal(bj_forLoopAIndex*72.,(bj_forLoopAIndex+1)*72.)*bj_DEGTORAD)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",x1,y1)
call DestroyEffect(bj_lastCreatedEffect)
set bj_forLoopBIndex=bj_forLoopBIndex+1
endloop
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
if talante==1 then
set i=LoadInteger(Hash,GetHandleId(caster),0)
if a==1 and LoadBoolean(udg_hash,GetHandleId(caster),'d')==false then
set s__Units_AllDmg[sUnit[i]]=s__Units_AllDmg[sUnit[i]]+5000
call SaveBoolean(udg_hash,GetHandleId(caster),'d',true)
elseif a !=1 and LoadBoolean(udg_hash,GetHandleId(caster),'d')then
set s__Units_AllDmg[sUnit[i]]=s__Units_AllDmg[sUnit[i]]-5000
call SaveBoolean(udg_hash,GetHandleId(caster),'d',false)
endif
endif
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,h)
if LoadBoolean(udg_hash,GetHandleId(caster),'d')then
set i=LoadInteger(Hash,GetHandleId(caster),0)
set s__Units_AllDmg[sUnit[i]]=s__Units_AllDmg[sUnit[i]]-5000
call SaveBoolean(udg_hash,GetHandleId(caster),'d',false)
endif
endif
call DestroyGroup(g)
set t=null
set g=null
set u=null
set caster=null
endfunction
