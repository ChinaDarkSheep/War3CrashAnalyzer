set bool=true
endif
if not LoadBoolean(udg_hash,h,StringHash("SetMage"))then
elseif name=='I0BP' or name=='I0BA' or name=='I0B3' or name=='I09A' or name=='I09W' or name=='I0BT' or name=='I0BS' or name=='I07Y' or name=='I08V' or name=='I0EG' or name=='I0BJ' or name=='I0EU' or name=='I0ED' or name=='I0A9' then
