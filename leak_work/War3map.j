function Trig_KovenQuest3_Actions takes nothing returns nothing
local integer ID=GetPlayerId(GetTriggerPlayer())+1
set udg_p=GetUnitLoc(udg_Hero[ID])
if IsPointBlightedBJ(udg_p)==true and udg_KQuest3[ID]==false and(GetTimeOfDay()<6.00 or GetTimeOfDay()>18.00)then
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=10
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set udg_p2=PolarProjectionBJ(udg_p,15.00,I2R((GetForLoopIndexA()*36)))
call AddSpecialEffectLocBJ(udg_p2,"Objects\\Spawnmodels\\Orc\\OrcSmallDeathExplode\\OrcSmallDeathExplode.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call RemoveLocation(udg_p2)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set udg_HeroResTime[ID]=udg_HeroResTime[ID]-20.00
call KillUnit(udg_Hero[ID])
set udg_HeroResTime[ID]=udg_HeroResTime[ID]+20.00
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"Магия крови имеет особую агрессивную природу, поэтому связаться со свидетелями ведьмы Адрии можно только через собственную пролитую кровь. Вы узнали множество тайн прошедших лет, пора возвращаться в Ковен... после воскрешения, конечно.")
set udg_KQuest3[ID]=true
else
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"Заклинание прочтено правильно, но чего-то не хватило...")
endif
call RemoveLocation(udg_p)
endfunction
