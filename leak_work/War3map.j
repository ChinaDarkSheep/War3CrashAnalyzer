endif
endif
if GetSpellAbilityId()=='A0E5' then
set a=R2I(2.25*GetHeroStr(caster,false))
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",GetUnitX(caster),GetUnitY(caster))
call DestroyEffect(bj_lastCreatedEffect)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",GetUnitX(caster),GetUnitY(caster))
call DestroyEffect(bj_lastCreatedEffect)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",GetUnitX(caster),GetUnitY(caster))
call DestroyEffect(bj_lastCreatedEffect)
call UnitAddAbility(caster,'A0KW')
call UnitAddAbility(caster,'A05D')
call SetUnitVertexColor(caster,150,0,0,255)
call SetUnitScalePercent(caster,220.00,220.00,220.00)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
