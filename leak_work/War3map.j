call DestroyTimer(t)
set t=null
set caster=null
endfunction
function Barbarion_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(caster)
local integer ihc=ReturnTypeHeroId(h)
local integer iuh=LoadInteger(Hash,h,0)
if UnitAlive(caster)then
call SummonStats(false,0,s__Heroes_BaseDmg[sHero[ihc]],caster,caster)
else
call SaveInteger(udg_hash,h,StringHash("ResBaseDamage"),LoadInteger(udg_hash,h,StringHash("ResBaseDamage"))+s__Heroes_BaseDmg[sHero[ihc]])
endif
call F_Armore(caster,s__Units_Arm[sUnit[iuh]])
call F_Attack(caster,s__Units_GAttack[sUnit[iuh]])
call F_Stats(caster)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
set caster=null
endfunction
function Barbarion_Q takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local unit Axe=LoadUnitHandle(udg_hash,ht,1)
local group g2=LoadGroupHandle(udg_hash,ht,2)
local real dmg
local real x
local real y
local unit u
local group g=CreateGroup()
if UnitAlive(Axe)then
set x=GetUnitX(Axe)
set y=GetUnitY(Axe)
set dmg=GetUnitAbilityLevel(caster,'A16A')*50+2*Summ_Attack(caster)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,200.,Condition(function Trig_Filter_ID))
loop
set u=FirstOfGroup(g)
exitwhen u==null
if not IsUnitInGroup(u,g2)then
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupAddUnit(g2,u)
endif
call GroupRemoveUnit(g,u)
endloop
else
call DestroyGroup(g2)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
call DestroyGroup(g)
set g=null
set g2=null
set t=null
set caster=null
set Axe=null
endfunction
function Barbarion_Q_Move takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit Axe=LoadUnitHandle(udg_hash,ht,1)
local real sec=LoadReal(udg_hash,ht,0)
local real tic=LoadInteger(udg_hash,ht,1)
local real angle=LoadReal(udg_hash,ht,2)
local real x=GetUnitX(Axe)
local real y=GetUnitY(Axe)
if tic>0 then
set sec=sec-0.04
if sec>0 then
set x=x+40*Cos(angle*bj_DEGTORAD)
set y=y+40*Sin(angle*bj_DEGTORAD)
call SetUnitPosition(Axe,x,y)
call SaveReal(udg_hash,ht,0,sec)
else
if tic==2 then
call SaveInteger(udg_hash,ht,1,1)
call SaveReal(udg_hash,ht,0,1.3)
set angle=angle+180
if angle>360 then
set angle=angle-360
endif
call GroupClear(LoadGroupHandle(udg_hash,ht,2))
call SaveReal(udg_hash,ht,2,angle)
else
call SaveInteger(udg_hash,ht,1,0)
endif
endif
else
call FlushChildHashtable(udg_hash,GetHandleId(Axe))
call RemoveUnit(Axe)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
set Axe=null
endfunction
function Trig_Barbarion_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local timer t
local integer ht
local real x
local real y
local real x1
local real y1
local real r
local real dmg
local group g=CreateGroup()
local unit u
if GetSpellAbilityId()=='A16A' then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set x1=GetSpellTargetX()-x
set y1=GetSpellTargetY()-y
set r=bj_RADTODEG*Atan2(y1,x1)
set u=CreateUnit(GetOwningPlayer(caster),'e00P',x,y,r)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveUnitHandle(udg_hash,ht,1,u)
call SaveGroupHandle(udg_hash,ht,2,g)
call TimerStart(t,0.13,true,function Barbarion_Q)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveReal(udg_hash,ht,0,1.2)
call SaveUnitHandle(udg_hash,ht,1,u)
if GetHeroLevel(caster)>49 then
call SaveInteger(udg_hash,ht,1,2)
else
call SaveInteger(udg_hash,ht,1,1)
endif
call SaveReal(udg_hash,ht,2,r)
call SaveGroupHandle(udg_hash,ht,2,g)
call TimerStart(t,0.04,true,function Barbarion_Q_Move)
set g=CreateGroup()
else
endif
if GetSpellAbilityId()=='A04N' then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set dmg=GetHeroStr(caster,true)*4+100*GetUnitAbilityLevel(caster,'A04N')
if GetHeroLevel(caster)>=50 then
set dmg=dmg+GetHeroStr(caster,true)*2
endif
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,400,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
set udg_BarbarianW=true
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,PositiveDuration(caster,5),false,function Barbarion_W)
endif
if GetSpellAbilityId()=='A16E' then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,0.36,false,function Barbarion_R)
endif
call DestroyGroup(g)
set g=null
set caster=null
set u=null
set t=null
endfunction
function InitTrig_Barbarion takes nothing returns nothing
set gg_trg_Barbarion=CreateTrigger()
call TriggerAddAction(gg_trg_Barbarion,function Trig_Barbarion_Actions)
endfunction
