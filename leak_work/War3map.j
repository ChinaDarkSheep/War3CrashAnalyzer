call Modificator(hero,hero,u)
endif
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
call DestroyGroup(g)
set g=null
set hero=null
set u=null
set t=null
