call GroupEnumUnitsInRange(g,x,y,200.,null)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)and IsUnitEnemy(u,GetOwningPlayer(caster))then
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
else
if GetUnitTypeId(u)=='z002' then
set bj_lastCreatedItem=CreateItem('I054',x,y)
call ExplodeUnitBJ(u)
endif
endif
call GroupRemoveUnit(g,u)
endloop
endif
if GetSpellAbilityId()=='A08K' then
set spell=true
if crit==2 then
call CreateTextTagUnitBJ("Ярость громовержца!",GetSpellAbilityUnit(),0,10.00,100.00,50.00,50.00,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
