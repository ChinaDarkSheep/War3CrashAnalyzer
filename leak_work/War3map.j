endif
if command=="armore" or command=="ar" then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],8.00,"Защиты:  "+R2S(GetHeroAgi(udg_Hero[ID],true)/5+s__Units_Arm[sUnit[LoadInteger(Hash,GetHandleId(udg_Hero[ID]),0)]]))
endif
if command=="q" then
if LoadStr(udg_hash,GetHandleId(udg_Hero[ID]),StringHash("CommandQ"))!=null then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],8.00,LoadStr(udg_hash,GetHandleId(udg_Hero[ID]),StringHash("CommandQ")))
endif
endif
if command=="f" then
if LoadStr(udg_hash,GetHandleId(udg_Hero[ID]),StringHash("CommandF"))!=null then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],8.00,LoadStr(udg_hash,GetHandleId(udg_Hero[ID]),StringHash("CommandF")))
endif
endif
set command=SubString(text,1,12)
if command=="helptext" or command=="ht" then
if s__HelpText[id]then
set s__HelpText[id]=false
else
set s__HelpText[id]=true
endif
endif
if(command=="quest" or command=="й")then
if udg_StartQuests<5 then
call DisplayTextToForce(bj_FORCE_PLAYER[id],s__QuestGoblinText[0])
call DisplayTextToForce(bj_FORCE_PLAYER[id],s__QuestGoblinText[1])
call DisplayTextToForce(bj_FORCE_PLAYER[id],s__QuestGoblinText[2])
if udg_StartQuests==1 then
call PingMinimapForForceEx(bj_FORCE_PLAYER[id],GetRectCenterX(gg_rct_Spawn6),GetRectCenterY(gg_rct_Spawn6),5.,bj_MINIMAPPINGSTYLE_SIMPLE,100,0.,0.)
elseif udg_StartQuests==2 and udg_QuestNumber==2 then
call PingMinimapForForceEx(bj_FORCE_PLAYER[id],GetRectCenterX(gg_rct_SI1),GetRectCenterY(gg_rct_SI1),5.,bj_MINIMAPPINGSTYLE_SIMPLE,100,0.,0.)
elseif udg_StartQuests==3 and udg_QuestNumber==2 then
call PingMinimapForForceEx(bj_FORCE_PLAYER[id],GetRectCenterX(gg_rct_Spawn15),GetRectCenterY(gg_rct_Spawn15),5.,bj_MINIMAPPINGSTYLE_SIMPLE,100,0.,0.)
endif
else
if IsPlayerInForce(Player(id),udg_Quests[5])then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFF00C850Задание \"Поиск оружия\" [1/3]|r\n\nО, это снова ты. Слушай, я вычитал в том дневнике, что где-то на этом острове спрятано древнее оружие невероятной силы, но нечайно пролил на продолжение этой страницы эликсир маны. Возможно кто-то из местных жителей знает что-то про это, сходи узнай, а я пока дальше покопаюсь в дневнике.(убейте 30 троллей, 30 кобольдов, 15 големов и 10 беорнов)")
call DisplayTextToForce(bj_FORCE_PLAYER[id],"\n|cFFFFDC00Награда: предмет \"Сверхострое копье\" и 2000 золота\nЕсли успеете первым закончить цепочку заданий, то вы получите доступ к последнему заданию Гильдии.|r")
elseif IsPlayerInForce(Player(id),udg_Quests[6])then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFF00C850Задание \"Поиск оружия\" [2/3]|r\n\nВсё-таки ты хорошо поработал! Только когда ты ушел я нашел нужную информацию на следующей странице дневника. Там сказано, что этот предмет просто так не найти и лишь кровь трупоедов может заинтересовать сам предмет! Думаю, тебе придется найти пару вурдалаков и проверить это на деле! (попробуйте убить 20 вурдалаков)")
call DisplayTextToForce(bj_FORCE_PLAYER[id],"\n|cFFFFDC00Награда: 6000 золота\nЕсли успеете первым закончить цепочку заданий, то вы получите доступ к последнему заданию Гильдии.|r")
elseif IsPlayerInForce(Player(id),udg_Quests[7])then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFF00C850Задание \"Поиск оружия\" [3/3]|r\n\nУх ты, вот это оружие, вот это работа! Гляди, тут написано, что оно для другого героя - какого-то разрушителя. Но это ерунда - в дневнике про это тоже написано! А еще там написано, что можно изменить его сущность, для этого нужно искупать его в душах водных существ... Да, так и написано. Ну давай, за дело. (убейте 5 наг-гвардейцев, 10 мурлоков-сектантов и 15 лобстеров)")
call DisplayTextToForce(bj_FORCE_PLAYER[id],"\n|cFFFFDC00Награда: предмет \"Ультимативные сапоги\" и 3000 золота\nЕсли успеете первым закончить цепочку заданий, то вы получите доступ к последнему заданию Гильдии.|r")
elseif IsPlayerInForce(Player(id),udg_Quests[8])then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFF00C850Последнее задание!|r\n\nСлушай, судя по всему хозяин этого оружия против того, что мы с ним делаем и он хочет тебя найти. Хорошо, что не меня... Так что если ты хочешь использовать это оружие, то тебе придется разобраться с его хозяином. Ну а я пока спрячу этот \"Испепелитель\" подальше от своего дома... Советую тебе попросить помощи у других героев.\n\n|cFFFFDC00Награда: предмет \"Хорадрический куб\" (5 уровень)|r")
call PingMinimapForForceEx(bj_FORCE_PLAYER[id],GetRectCenterX(gg_rct_A2),GetRectCenterY(gg_rct_A2),5.,bj_MINIMAPPINGSTYLE_SIMPLE,100,0.,0.)
elseif IsPlayerInForce(Player(id),udg_Quests[9])then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Ты очень хорошо поработал - больше у меня нет для тебя заданий.")
endif
endif
endif
if command=="HS1" or command=="hs1" then
call DisplayTextToForce(bj_FORCE_PLAYER[id],s__PlayerStruct_hs1[sPlayer[id]])
elseif command=="HS2" or command=="hs2" then
call DisplayTextToForce(bj_FORCE_PLAYER[id],s__PlayerStruct_hs2[sPlayer[id]])
elseif command=="HS3" or command=="hs3" then
call DisplayTextToForce(bj_FORCE_PLAYER[id],s__PlayerStruct_hs3[sPlayer[id]])
