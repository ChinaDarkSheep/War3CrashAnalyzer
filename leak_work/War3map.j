function MadEnginerR takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit mine=LoadUnitHandle(udg_hash,ht,0)
local integer tic=LoadInteger(udg_hash,ht,0)
local unit u
local group g=CreateGroup()
local real x=GetUnitX(mine)
local real y=GetUnitY(mine)
if tic>0 then
set tic=tic-1
call SaveInteger(udg_hash,ht,0,tic)
call SetUnitVertexColorBJ(mine,100,R2I(tic*10),R2I(tic*10),0)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Taunt\\TauntCaster.mdl",x,y))
set udg_Drop2=GetPlayerId(GetOwningPlayer(mine))
call GroupEnumUnitsInRange(g,x,y,700,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call IssuePointOrder(u,"move",x,y)
call GroupRemoveUnit(g,u)
endloop
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
call DestroyGroup(g)
set t=null
set mine=null
set u=null
set g=null
endfunction
function Trig_MadEnginerSkills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local unit u
local real hp
local real dmg
local real x
local real y
local real x1
local real y1
local timer t
local integer ht
if GetSpellAbilityId()=='A09D' then
if GetHeroLevel(caster)==70 then
call SetPlayerTechResearchedSwap('R00X',84,GetOwningPlayer(caster))
else
call SetPlayerTechResearchedSwap('R00X',GetHeroLevel(caster),GetOwningPlayer(caster))
endif
set hp=12.*(GetHeroStr(caster,true)+GetHeroInt(caster,true))
set dmg=1.5*GetHeroInt(caster,true)
call PauseUnitBJ(true,caster)
call AddSpecialEffectTargetUnitBJ("origin",caster,"Abilities\\Spells\\NightElf\\TrueshotAura\\TrueshotAura.mdl")
set udg_Effect[10]=GetLastCreatedEffectBJ()
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set x1=x+200*Cos(GetUnitFacing(caster)*bj_DEGTORAD)
set y1=y+200*Sin(GetUnitFacing(caster)*bj_DEGTORAD)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'ngir',x1,y1,GetUnitFacing(caster))
set udg_Rezak=GetLastCreatedUnit()
call UnitAddAbilityBJ('A007',GetLastCreatedUnit())
if GetUnitAbilityLevel(caster,'A0BM')==1 then
call UnitAddAbilityBJ('A01Y',GetLastCreatedUnit())
set hp=3.*hp
set dmg=3.*dmg
endif
if GetUnitAbilityLevel(udg_Rezak,'A1BF')==0 then
call UnitAddAbility(udg_Rezak,'A1BF')
endif
call SetUnitAbilityLevel(udg_Rezak,'A1BF',GetUnitAbilityLevel(udg_Rezak,'A1BF')+10)
call SummonStats(true,R2I(hp),R2I(dmg),udg_Rezak,caster)
call UnitRemoveAbilityBJ('A007',udg_Rezak)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl",x,y))
call SelectUnitForPlayerSingle(GetLastCreatedUnit(),GetOwningPlayer(caster))
call SetUnitScalePercent(GetLastCreatedUnit(),(100.00+(I2R(GetHeroLevel(caster))*2.00)),(100.00+(I2R(GetHeroLevel(caster))*2.00)),(100.00+(I2R(GetHeroLevel(caster))*2.00)))
call SetUnitVertexColorBJ(GetLastCreatedUnit(),100,(100.00-I2R(GetHeroLevel(caster))),(100.00-I2R(GetHeroLevel(caster))),0)
call UnitApplyTimedLifeBJ(30.00,'BTLF',GetLastCreatedUnit())
endif
if GetSpellAbilityId()=='A09H' then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
if UnitHasItemOfTypeBJ(caster,'I0DV')then
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>6
set x1=x+100*Cos((60*bj_forLoopAIndex)*bj_DEGTORAD)
set y1=y+100*Sin((60*bj_forLoopAIndex)*bj_DEGTORAD)
set u=CreateUnit(Player(ID-1),'nglm',x1,y1,bj_UNIT_FACING)
call SetUnitAnimation(u,"Birth")
call UnitApplyTimedLife(u,'BTLF',120)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>10
set x1=x+400*Cos((36*bj_forLoopAIndex)*bj_DEGTORAD)
set y1=y+400*Sin((36*bj_forLoopAIndex)*bj_DEGTORAD)
set u=CreateUnit(Player(ID-1),'nglm',x1,y1,bj_UNIT_FACING)
call SetUnitAnimation(u,"Birth")
call UnitApplyTimedLife(u,'BTLF',120)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>8
set x1=x+700*Cos((45*bj_forLoopAIndex)*bj_DEGTORAD)
set y1=y+700*Sin((45*bj_forLoopAIndex)*bj_DEGTORAD)
set u=CreateUnit(Player(ID-1),'nglm',x1,y1,bj_UNIT_FACING)
call SetUnitAnimation(u,"Birth")
call UnitApplyTimedLife(u,'BTLF',120)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
else
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>4
set x1=x+100*Cos((90*bj_forLoopAIndex)*bj_DEGTORAD)
set y1=y+100*Sin((90*bj_forLoopAIndex)*bj_DEGTORAD)
set u=CreateUnit(Player(ID-1),'nglm',x1,y1,bj_UNIT_FACING)
call SetUnitAnimation(u,"Birth")
call UnitApplyTimedLife(u,'BTLF',120)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>8
set x1=x+400*Cos((45*bj_forLoopAIndex)*bj_DEGTORAD)
set y1=y+400*Sin((45*bj_forLoopAIndex)*bj_DEGTORAD)
set u=CreateUnit(Player(ID-1),'nglm',x1,y1,bj_UNIT_FACING)
call SetUnitAnimation(u,"Birth")
call UnitApplyTimedLife(u,'BTLF',120)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>4
set x1=x+700*Cos((90*bj_forLoopAIndex)*bj_DEGTORAD)
set y1=y+700*Sin((90*bj_forLoopAIndex)*bj_DEGTORAD)
set u=CreateUnit(Player(ID-1),'nglm',x1,y1,bj_UNIT_FACING)
call SetUnitAnimation(u,"Birth")
call UnitApplyTimedLife(u,'BTLF',120)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
endif
if GetSpellAbilityId()=='A09I' then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>6
set x1=x+300*Cos((60*bj_forLoopAIndex)*bj_DEGTORAD)
set y1=y+300*Sin((60*bj_forLoopAIndex)*bj_DEGTORAD)
set u=CreateUnit(Player(ID-1),'ngsp',x1,y1,bj_UNIT_FACING)
call UnitApplyTimedLife(u,'BTLF',15)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl",x1,y1))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
if GetUnitAbilityLevelSwapped('A0BM',caster)==1 then
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>6
set x1=x+200*Cos((60*bj_forLoopAIndex)*bj_DEGTORAD)
set y1=y+200*Sin((60*bj_forLoopAIndex)*bj_DEGTORAD)
set u=CreateUnit(Player(ID-1),'ngsp',x1,y1,bj_UNIT_FACING)
call UnitApplyTimedLife(u,'BTLF',15)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl",x1,y1))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
endif
if GetSpellAbilityId()=='A09J' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set u=CreateUnit(Player(ID-1),'h01R',x,y,bj_UNIT_FACING)
call UnitApplyTimedLife(u,'BTLF',6)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call SaveInteger(udg_hash,ht,0,10)
call TimerStart(t,0.5,true,function MadEnginerR)
endif
set u=null
set caster=null
set t=null
endfunction
