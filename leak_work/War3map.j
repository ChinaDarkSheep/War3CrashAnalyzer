function Trig_Fase2_Actions takes nothing returns nothing
local timer t=CreateTimer()
call TimerStart(t,1.,true,function Set10_Wave_2)
set t=null
endfunction
function InitTrig_Fase2 takes nothing returns nothing
set gg_trg_Fase2=CreateTrigger()
call DisableTrigger(gg_trg_Fase2)
call TriggerAddAction(gg_trg_Fase2,function Trig_Fase2_Actions)
endfunction
function Trig_SkillFase2_2_Filter takes nothing returns boolean
return(IsUnitEnemy(GetFilterUnit(),Player(PLAYER_NEUTRAL_AGGRESSIVE))and UnitAlive(GetFilterUnit()))
endfunction
function Trig_SkillFase2_2_Actions takes nothing returns nothing
local real x=GetUnitX(GetDyingUnit())
local real y=GetUnitY(GetDyingUnit())
local group g=CreateGroup()
local unit u
local real dmg
if GetUnitTypeId(GetDyingUnit())=='h03K' then
if udg_HardestLogic then
set dmg=3000
else
set dmg=2000
endif
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl",x,y))
call GroupEnumUnitsInRange(g,x,y,150,Condition(function Trig_SkillFase2_2_Filter))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(GetDyingUnit(),u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
call F_RemoveUnit(GetDyingUnit())
endif
call DestroyGroup(g)
set g=null
endfunction
function InitTrig_SkillFase2_2 takes nothing returns nothing
set gg_trg_SkillFase2_2=CreateTrigger()
call DisableTrigger(gg_trg_SkillFase2_2)
call TriggerRegisterAnyUnitEventBJ(gg_trg_SkillFase2_2,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddAction(gg_trg_SkillFase2_2,function Trig_SkillFase2_2_Actions)
endfunction
function Trig_EndFase2_Func005Func001C takes nothing returns boolean
if(not(udg_HARDSET==10))then
return false
endif
return true
endfunction
function Trig_EndFase2_Func005C takes nothing returns boolean
if(not(udg_Mode==2))then
return false
endif
return true
endfunction
function Trig_EndFase2_Actions takes nothing returns nothing
call DisableTrigger(GetTriggeringTrigger())
call DisplayTimedTextToForce(GetPlayersAll(),30,"|cFF00C850ВТОРАЯ ФАЗА ПРОЙДЕНА!\n\nУ вас есть 60 секунд на подготовку к следущей фазе.")
call DestroyTrigger(gg_trg_SkillFase2_2)
call ConditionalTriggerExecute(gg_trg_Fase3)
if(Trig_EndFase2_Func005C())then
call PlayerGetEXP(2000)
else
if(Trig_EndFase2_Func005Func001C())then
call PlayerGetEXP(1500)
else
call PlayerGetEXP(900)
endif
endif
endfunction
function InitTrig_EndFase2 takes nothing returns nothing
set gg_trg_EndFase2=CreateTrigger()
call DisableTrigger(gg_trg_EndFase2)
call TriggerRegisterTimerEventPeriodic(gg_trg_EndFase2,40.00)
call TriggerAddAction(gg_trg_EndFase2,function Trig_EndFase2_Actions)
endfunction
function Set10_Wave_3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer sec=LoadInteger(udg_hash,ht,0)+1
local real x
local real y
local integer a
if sec<66 then
call SaveInteger(udg_hash,ht,0,sec)
if sec==60 then
set RandomSpawnX[1]=GetRectCenterX(gg_rct_Spawn73)
set RandomSpawnY[1]=GetRectCenterY(gg_rct_Spawn73)
set RandomSpawnX[2]=GetRectCenterX(gg_rct_Spawn40)
set RandomSpawnY[2]=GetRectCenterY(gg_rct_Spawn40)
set RandomSpawnX[3]=GetRectCenterX(gg_rct_Spawn7)
set RandomSpawnY[3]=GetRectCenterY(gg_rct_Spawn7)
set udg_EnemyType[1]='e00R'
set udg_EnemyType[2]='e00S'
set udg_RandomEvents[1]=GetRandomInt(1,12)
call ConditionalTriggerExecute(gg_trg_RandomEvent3)
elseif sec==61 then
call ConditionalTriggerExecute(udg_RandomEventsTriggers[udg_RandomEvents[1]])
call ConditionalTriggerExecute(udg_RandomEventsTriggers[udg_RandomEvents[2]])
call ConditionalTriggerExecute(udg_RandomEventsTriggers[udg_RandomEvents[3]])
call DisplayTimedTextToForce(GetPlayersAll(),30,"|cFFA000FF==========================|r\n|cFFFFDC00Фаза №3 \"Кенарий\"|r\b|cFFA000FF==========================|r\n|cFFFFDC00Случайные события:|r")
call DisplayTimedTextToForce(GetPlayersAll(),30,udg_RandomEventsText[udg_RandomEvents[1]])
call DisplayTimedTextToForce(GetPlayersAll(),30,udg_RandomEventsText[udg_RandomEvents[2]])
call DisplayTimedTextToForce(GetPlayersAll(),30,udg_RandomEventsText[udg_RandomEvents[3]])
endif
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
call EnableTrigger(gg_trg_EndFase3)
set x=GetRectCenterX(gg_rct_Priziv)
set y=GetRectCenterY(gg_rct_Priziv)
if HardcoreUP30==3 then
set bj_lastCreatedUnit=CreateUnit(ForcePickRandomPlayer(udg_CreepsPlayers),'ncte',x,y,bj_UNIT_FACING)
call GroupAddUnit(udg_A3,bj_lastCreatedUnit)
endif
set bj_lastCreatedUnit=CreateUnit(ForcePickRandomPlayer(udg_CreepsPlayers),'Ecen',x,y,bj_UNIT_FACING)
set udg_Mefisto=bj_lastCreatedUnit
set a=GetHandleId(udg_Mefisto)
call SeekFreeHero(a)
call SeekFreeUnit(a)
call GroupAddUnit(BossG,udg_Mefisto)
call SaveBoolean(udg_hash,a,'b',true)
call GroupAddUnit(udg_ug_Regen,udg_Mefisto)
call TriggerRegisterUnitEvent(gg_trg_BossDamaged,udg_Mefisto,EVENT_UNIT_DAMAGED)
call EnableTrigger(gg_trg_SkillFase3_3)
call EnableTrigger(gg_trg_SkillFase3)
call EnableTrigger(gg_trg_SpawnFase3)
if udg_HardestLogic then
call UnitAddItemByIdSwapped('I090',udg_Mefisto)
call UnitAddItemByIdSwapped('I09E',udg_Mefisto)
call UnitAddItemByIdSwapped('I0DA',udg_Mefisto)
call UnitAddItemByIdSwapped('I08R',udg_Mefisto)
call UnitAddItemByIdSwapped('I0A0',udg_Mefisto)
call UnitAddItemByIdSwapped('I0DM',udg_Mefisto)
else
call UnitAddItemByIdSwapped('I04N',udg_Mefisto)
call UnitAddItemByIdSwapped('I09E',udg_Mefisto)
call UnitAddItemByIdSwapped('I07W',udg_Mefisto)
call UnitAddItemByIdSwapped('I08R',udg_Mefisto)
call UnitAddItemByIdSwapped('I07E',udg_Mefisto)
call UnitAddItemByIdSwapped('I042',udg_Mefisto)
endif
call SetHeroLevelBJ(udg_Mefisto,50,false)
call TransmissionFromUnitWithNameBJ(bj_FORCE_ALL_PLAYERS,udg_Mefisto,"Кенарий",null,"Я очищу эти земли!",bj_TIMETYPE_ADD,0,true)
endif
set t=null
endfunction
function Trig_Fase3_Actions takes nothing returns nothing
local timer t=CreateTimer()
call TimerStart(t,1.,true,function Set10_Wave_3)
set t=null
endfunction
function InitTrig_Fase3 takes nothing returns nothing
set gg_trg_Fase3=CreateTrigger()
