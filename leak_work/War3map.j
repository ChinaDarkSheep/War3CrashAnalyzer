function Trig_PristTaurenE_Actions takes nothing returns nothing
local group g=CreateGroup()
local real x=GetUnitX(udg_TaurenPrist)
local real y=GetUnitY(udg_TaurenPrist)
local unit u
local real heal=GetUnitAbilityLevel(udg_TaurenPrist,'A18B')*10.00+GetHeroInt(udg_TaurenPrist,true)/5.00
local real heal_hero=2.25*heal
