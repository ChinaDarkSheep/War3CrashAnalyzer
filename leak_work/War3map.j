set udg_RifleLogic[5]=true
call UnitAddAbility(u,'A15U')
call DisplayTimedTextToPlayer(GetOwningPlayer(u),0,0,20.,"|cFF90A2EAУникальный комплект \"Профессионал\" собран!")
endif
endif
if tid=='I05Y' or tid=='I08Q' or tid=='I071' or tid=='I08V' then
if RifleHasItem(u,'I05Y','I08Q',0)and RifleHasItem(u,'I071','I08V',0)and udg_RifleLogic[6]==false then
set udg_RifleLogic[6]=true
call ModifyHeroStat(bj_HEROSTAT_AGI,u,bj_MODIFYMETHOD_ADD,150)
call UnitAddAbility(u,'Apiv')
call DisplayTimedTextToPlayer(GetOwningPlayer(u),0,0,20.,"|cFF90A2EAУникальный комплект \"Диверсант\" собран!")
endif
endif
if tid=='I0DK' or tid=='I0DN' or tid=='I0DM' or tid=='I0DR' or tid=='I0DB' or tid=='I0E3' or tid=='I0DW' or tid=='I0DX' or tid=='I0DO' or tid=='I0EN' or tid=='I0DL' then
set c=0
set i=0
loop
exitwhen i>5
set sid=GetItemTypeId(UnitItemInSlot(u,i))
if sid=='I0DK' or sid=='I0DN' or sid=='I0DM' or sid=='I0DR' or sid=='I0DB' or sid=='I0E3' or sid=='I0DW' or sid=='I0DX' or sid=='I0DO' or sid=='I0EN' or sid=='I0DL' then
set c=c+1
endif
set i=i+1
endloop
if c>=2 and udg_RifleLogic[7]==false then
set udg_RifleLogic[7]=true
call DisplayTimedTextToPlayer(GetOwningPlayer(u),0,0,20.,"|cFF90A2EAУникальный комплект \"Коллекционер\" собран!")
endif
endif
if tid=='I05H' then
set c=0
set i=0
loop
exitwhen i>5
if GetItemTypeId(UnitItemInSlot(u,i))=='I05H' then
set c=c+1
endif
set i=i+1
endloop
if c>=2 and udg_RifleLogic[8]==false then
