set pl=null
endfunction
function HeroR53_Bonus takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer Id=GetHandleId(t)
local unit u=LoadUnitHandle(udg_hash,Id,1)
local player pl=GetOwningPlayer(u)
local timer t2=LoadTimerHandle(udg_hash,Id,2)
local integer Id2=GetHandleId(t2)
local integer Id_u=GetHandleId(u)
local integer count=LoadInteger(udg_hash,Id,1)
local texttag text
local integer str=GetHeroStr(u,false)
local integer agi=GetHeroAgi(u,false)
local integer int=GetHeroInt(u,false)
local integer intlose=R2I(0.05*GetHeroInt(u,false))
local integer int_bonus=0
local integer int_bonus_all=LoadInteger(udg_hash,Id_u,'r')
local real int_cof=0.04+LoadReal(udg_hash,Id,3)
local integer hh=GetHandleId(u)
local integer ihu=LoadInteger(udg_hash,hh,5)
call SaveReal(udg_hash,Id,3,int_cof)
set count=count-1
if count>5 then
set int_bonus=R2I(I2R(int)*int_cof)
set int_bonus_all=int_bonus_all+int_bonus
set s__Heroes_TempInt[sHero[ihu]]=s__Heroes_TempInt[sHero[ihu]]+int_bonus
call SaveInteger(udg_hash,Id_u,'r',int_bonus_all)
call SaveInteger(udg_hash,Id,1,count)
call SaveInteger(udg_hash,Id2,1,count)
elseif count==0 then
set text=LoadTextTagHandle(udg_hash,Id2,2)
call DestroyTextTag(text)
call FlushChildHashtable(udg_hash,Id)
call FlushChildHashtable(udg_hash,Id2)
call SaveInteger(udg_hash,Id_u,'r',0)
call DestroyTimer(t)
call DestroyTimer(t2)
set s__Heroes_TempInt[sHero[ihu]]=s__Heroes_TempInt[sHero[ihu]]-int_bonus_all
if int>intlose then
call SetHeroInt(u,int-intlose,true)
else
call SetHeroInt(u,1,true)
endif
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)-0.6*GetUnitState(u,UNIT_STATE_MAX_LIFE))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl",u,"origin"))
call SetUnitVertexColor(u,255,255,255,255)
call DisableTrigger(gg_trg_HeroD53_var3)
else
call SaveInteger(udg_hash,Id,1,count)
call SaveInteger(udg_hash,Id2,1,count)
endif
set t=null
set t2=null
set u=null
set pl=null
set text=null
endfunction
function Trig_HeroR53_Actions takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local player pl=GetOwningPlayer(u)
local timer t=CreateTimer()
local timer t2=CreateTimer()
local integer Id=GetHandleId(t)
local integer Id2=GetHandleId(t2)
local integer Id_u=GetHandleId(u)
local texttag text
local integer count=12
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",u,"overhead"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",u,"origin"))
call SetUnitVertexColor(u,125,125,255,125)
set text=CreateTextTagUnitBJ("|cFF6496FF"+I2S(count),u,0,12.00,255,255,255,0)
call ShowTextTagForceBJ(false,text,bj_FORCE_ALL_PLAYERS)
call ShowTextTagForceBJ(true,text,bj_FORCE_PLAYER[GetPlayerId(pl)])
call SaveUnitHandle(udg_hash,Id,1,u)
call SaveUnitHandle(udg_hash,Id2,1,u)
call SaveTextTagHandle(udg_hash,Id2,2,text)
call SaveTimerHandle(udg_hash,Id,2,t2)
call SaveInteger(udg_hash,Id,1,count)
call SaveInteger(udg_hash,Id2,1,count)
call SaveReal(udg_hash,Id,3,0.11)
call SaveTimerHandle(udg_hash,Id_u,1,t)
call SaveTimerHandle(udg_hash,Id_u,2,t2)
call TimerStart(t,1,true,function HeroR53_Bonus)
call TimerStart(t2,0.04,true,function HeroR53_Text)
call EnableTrigger(gg_trg_HeroD53_var3)
set text=null
set u=null
set pl=null
set t=null
set t2=null
endfunction
