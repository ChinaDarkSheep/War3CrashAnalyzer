function Trig_BossHP_Conditions takes nothing returns boolean
if(not(GetUnitTypeId(GetTriggerUnit())=='ncte'))then
return false
endif
return true
endfunction
function Trig_BossHP_Actions takes nothing returns nothing
if GetUnitLifePercent(GetTriggerUnit())<=50.00 and GetUnitAbilityLevel(GetTriggerUnit(),'A0IW')==1 then
call DisplayTimedTextToForce(GetPlayersAll(),45.00,"|cFFFF5800Аура рассеяна! Часть силы древа рассеивается, но не исчезает полностью...")
call UnitRemoveAbilityBJ('A0IW',GetTriggerUnit())
call UnitRemoveAbilityBJ('A0S8',GetTriggerUnit())
else
endif
endfunction
