endif
return true
endfunction
function Trig_DefenceBox_Timer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local unit cart=LoadUnitHandle(udg_hash,h,0)
local integer sec=LoadInteger(udg_hash,h,1)
local integer end=LoadInteger(udg_hash,h,2)
local integer random
local real x=GetUnitX(cart)
local real y=GetUnitY(cart)
local real x1
local real y1
local unit u
local player pl=Player(11)
local integer ID
local integer gold=0
local group g=CreateGroup()
if UnitAlive(cart)then
call GroupEnumUnitsInRect(g,gg_rct_F1,null)
if IsUnitInGroup(cart,g)then
set bj_forLoopAIndex=1
set x1=0
loop
exitwhen bj_forLoopAIndex>8
set x1=x1+udg_QuestPoints[bj_forLoopAIndex]
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>8
if udg_QuestPoints[bj_forLoopAIndex]>0 then
set udg_QuestPoints[bj_forLoopAIndex]=4000.*(udg_QuestPoints[bj_forLoopAIndex]/x1)
else
set udg_QuestPoints[bj_forLoopAIndex]=0
endif
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,30.00,"|cFFFFDC00Задание выполнено!\n\nНаграда: +400 золотых, +5% к получаемому золоту и +2000 опыта всем героям.|r")
set ID=1
loop
exitwhen ID>8
set gold=400
if GetOwningPlayer(udg_Scorpion)==Player(ID-1)and udg_ScorpionMutation[3]==3 then
set gold=R2I(1.3*gold)
endif
set udg_HeroGold[ID]=(udg_HeroGold[ID]+0.05)
if udg_Hero[ID]!=null then
call AddHeroXP(udg_Hero[ID],R2I(2000.00*udg_HeroExp[ID]),true)
endif
call SetPlayerStateBJ(Player(ID-1),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(ID-1),PLAYER_STATE_RESOURCE_GOLD)+gold+R2I(udg_QuestPoints[ID]))
set GoldNT[ID]=GoldNT[ID]+gold+R2I(udg_QuestPoints[ID])
set QuestsNT[ID]=QuestsNT[ID]+1
if R2I(udg_QuestPoints[ID])>0 then
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"|cffffcc00За активную защиту повозки вам дополнительно дали "+I2S(R2I(udg_QuestPoints[ID]))+" ед. золота|r")
endif
set ID=ID+1
endloop
set udg_Quest=true
call RemoveUnit(cart)
call DestroyTrigger(LoadTriggerHandle(udg_hash,h,10))
call DestroyTrigger(LoadTriggerHandle(udg_hash,h,12))
call FlushChildHashtable(udg_hash,h)
call PauseTimer(t)
call DestroyTimer(t)
else
if sec<200 then
call IssuePointOrder(cart,"move",GetRectCenterX(gg_rct_F1),GetRectCenterY(gg_rct_F1))
if ModuloInteger(sec,13)==0 and sec>0 then
set random=GetRandomInt(1,5)
call SaveInteger(udg_hash,h,1,0)
if random==1 then
set bj_forLoopAIndex=1
loop
set x1=x+GetRandomReal(200,500)*Cos((GetRandomReal(0,360))*bj_DEGTORAD)
set y1=y+GetRandomReal(200,500)*Sin((GetRandomReal(0,360))*bj_DEGTORAD)
set u=CreateUnit(pl,'nenf',x1,y1,bj_UNIT_FACING)
call GroupAddUnit(udg_TaksGroup,u)
exitwhen bj_forLoopAIndex>=5
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
if random==2 then
set bj_forLoopAIndex=1
loop
set x1=x+GetRandomReal(200,500)*Cos((GetRandomReal(0,360))*bj_DEGTORAD)
set y1=y+GetRandomReal(200,500)*Sin((GetRandomReal(0,360))*bj_DEGTORAD)
set u=CreateUnit(pl,'nass',x1,y1,bj_UNIT_FACING)
call GroupAddUnit(udg_TaksGroup,u)
exitwhen bj_forLoopAIndex>=6
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
if random==3 then
set bj_forLoopAIndex=1
loop
set x1=x+GetRandomReal(200,500)*Cos((GetRandomReal(0,360))*bj_DEGTORAD)
set y1=y+GetRandomReal(200,500)*Sin((GetRandomReal(0,360))*bj_DEGTORAD)
set u=CreateUnit(pl,'n011',x1,y1,bj_UNIT_FACING)
call GroupAddUnit(udg_TaksGroup,u)
exitwhen bj_forLoopAIndex>=1
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
if random==4 then
set bj_forLoopAIndex=1
loop
set x1=x+GetRandomReal(200,500)*Cos((GetRandomReal(0,360))*bj_DEGTORAD)
set y1=y+GetRandomReal(200,500)*Sin((GetRandomReal(0,360))*bj_DEGTORAD)
set u=CreateUnit(pl,'n012',x1,y1,bj_UNIT_FACING)
call GroupAddUnit(udg_TaksGroup,u)
exitwhen bj_forLoopAIndex>=2
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
if random==5 then
set bj_forLoopAIndex=1
loop
set x1=x+GetRandomReal(200,500)*Cos((GetRandomReal(0,360))*bj_DEGTORAD)
set y1=y+GetRandomReal(200,500)*Sin((GetRandomReal(0,360))*bj_DEGTORAD)
set u=CreateUnit(pl,'h01D',x1,y1,bj_UNIT_FACING)
call GroupAddUnit(udg_TaksGroup,u)
exitwhen bj_forLoopAIndex>=2
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
if random==6 then
set bj_forLoopAIndex=1
loop
set x1=x+GetRandomReal(200,500)*Cos((GetRandomReal(0,360))*bj_DEGTORAD)
set y1=y+GetRandomReal(200,500)*Sin((GetRandomReal(0,360))*bj_DEGTORAD)
set u=CreateUnit(pl,'h01X',x1,y1,bj_UNIT_FACING)
call GroupAddUnit(udg_TaksGroup,u)
exitwhen bj_forLoopAIndex>=2
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
else
set sec=sec+1
call SaveInteger(udg_hash,h,1,sec)
endif
else
set udg_Quest=true
call RemoveUnit(cart)
call DestroyTrigger(LoadTriggerHandle(udg_hash,h,10))
call DestroyTrigger(LoadTriggerHandle(udg_hash,h,12))
call FlushChildHashtable(udg_hash,h)
call PauseTimer(t)
call DestroyTimer(t)
endif
endif
else
if end<10 then
set end=end+1
call SaveInteger(udg_hash,h,2,end)
else
set udg_Quest=true
call RemoveUnit(cart)
call DestroyTrigger(LoadTriggerHandle(udg_hash,h,10))
call DestroyTrigger(LoadTriggerHandle(udg_hash,h,12))
call FlushChildHashtable(udg_hash,h)
call PauseTimer(t)
call DestroyTimer(t)
endif
endif
call DestroyGroup(g)
set g=null
set cart=null
set t=null
set pl=null
set u=null
endfunction
function Trig_DefenceBox_Kills takes nothing returns nothing
local integer ID=GetPlayerId(GetOwningPlayer(GetKillingUnit()))+1
if IsUnitInGroup(GetDyingUnit(),udg_TaksGroup)and IsUnitEnemy(GetDyingUnit(),GetOwningPlayer(GetKillingUnit()))and ID<8 then
set udg_QuestPoints[ID]=udg_QuestPoints[ID]+1+0.5*GetUnitLevel(GetDyingUnit())
endif
endfunction
function Trig_DefenceBox_Actions takes nothing returns nothing
local unit cart
local timer t
local integer h
local trigger trig
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>8
set udg_QuestPoints[bj_forLoopAIndex]=0
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set trig=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(trig,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddAction(trig,function Trig_DefenceBox_Kills)
call GroupClear(udg_TaksGroup)
set udg_Quest=false
call RemoveItem(GetItemOfTypeFromUnitBJ(GetManipulatingUnit(),'I05Q'))
call PlaySoundBJ(gg_snd_Hint)
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,30.00,"|cFFCD8948Активировано задание \"Ценный груз\"|r\n\nЦель: защитить ценный груз - он не должен быть разрушен до прибытия на форпост. Если груз будет уничтожен - задание провалено.\n\n|cFFFFDC00Награда: +400 золотых, +5% к получаемому золоту и +2000 опыта всем героям.")
call PingMinimapForForceEx(bj_FORCE_ALL_PLAYERS,-4736.00,5631.00,12.00,bj_MINIMAPPINGSTYLE_SIMPLE,100,87.00,0.00)
call TriggerSleepAction(6.00)
set cart=CreateUnit(Player(9),'hbew',-4736.00,5760.00,bj_UNIT_FACING)
set t=CreateTimer()
set h=GetHandleId(t)
call SaveUnitHandle(udg_hash,h,0,cart)
call SaveInteger(udg_hash,h,1,0)
call SaveInteger(udg_hash,h,2,0)
call SaveTriggerHandle(udg_hash,h,10,GetTriggeringTrigger())
call SaveTriggerHandle(udg_hash,h,12,trig)
call TimerStart(t,1.,true,function Trig_DefenceBox_Timer)
set cart=null
set trig=null
endfunction
function InitTrig_DefenceBox takes nothing returns nothing
set gg_trg_DefenceBox=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_DefenceBox,EVENT_PLAYER_UNIT_USE_ITEM)
call TriggerAddCondition(gg_trg_DefenceBox,Condition(function Trig_DefenceBox_Conditions))
call TriggerAddAction(gg_trg_DefenceBox,function Trig_DefenceBox_Actions)
endfunction
function Trig_FourObelisk_Conditions takes nothing returns boolean
if(not(udg_Quest==true))then
return false
endif
if(not(GetItemTypeId(GetManipulatedItem())=='I00I'))then
return false
endif
return true
endfunction
function FourObelisk_Count takes nothing returns nothing
if UnitAlive(GetEnumUnit())then
set udg_Drop=udg_Drop+1
endif
endfunction
function FourObelisk_Timer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer sec=LoadInteger(Hash,ht,0)+1
local group g=LoadGroupHandle(Hash,ht,1)
local group g2
local integer i
local real x
local real y
local unit u
call SaveInteger(Hash,ht,0,sec)
if udg_Setstart==false then
set g2=CreateGroup()
set i=0
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)then
call GroupAddUnit(g2,u)
set i=i+1
else
if GetUnitTypeId(u)=='nico' then
set i=i+1
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>3
set x=GetUnitX(u)
set y=GetUnitY(u)
set bj_lastCreatedUnit=CreateUnit(Player(11),'u00X',x,y,bj_UNIT_FACING)
call GroupAddUnit(g2,bj_lastCreatedUnit)
set bj_lastCreatedUnit=CreateUnit(Player(11),'n058',x,y,bj_UNIT_FACING)
call GroupAddUnit(g2,bj_lastCreatedUnit)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
endif
call GroupRemoveUnit(g,u)
endloop
call ForGroup(g,function FourObelisk_Count)
if i==0 then
set i=1
loop
exitwhen i>8
set GoldNT[i]=GoldNT[i]+2000
set udg_HeroGold[i]=udg_HeroGold[i]+0.20
set udg_HeroGoldMax[i]=udg_HeroGoldMax[i]+0.10
set QuestsNT[i]=QuestsNT[i]+1
set i=i+1
endloop
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,30.,"|cFFFFDC00Задание выполнено!\n\nНаграда: +2000 золота, +20% получаемого золота и +10% макс получаемого золота всем героям.|r")
if udg_Scorpion !=null and udg_ScorpionMutation[3]==3 then
call AdjustPlayerStateBJ(180,GetOwningPlayer(udg_Scorpion),PLAYER_STATE_RESOURCE_GOLD)
endif
call DestroyGroup(g2)
call DestroyTimerDialog(LoadTimerDialogHandle(Hash,ht,2))
call PauseTimer(LoadTimerHandle(Hash,ht,3))
call DestroyTimer(LoadTimerHandle(Hash,ht,3))
set udg_Quest=true
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(Hash,ht)
elseif sec>=120 then
call DestroyGroup(g2)
call DestroyTimerDialog(LoadTimerDialogHandle(Hash,ht,2))
call DestroyTimer(LoadTimerHandle(Hash,ht,3))
call PauseTimer(LoadTimerHandle(Hash,ht,3))
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,15.,"|cFFC60000Время вышло, вы не смогли уничтожить обелиски вовремя!|r")
set udg_Quest=true
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(Hash,ht)
else
call SaveGroupHandle(Hash,ht,1,g2)
endif
else
call DestroyTimerDialog(LoadTimerDialogHandle(Hash,ht,2))
call PauseTimer(LoadTimerHandle(Hash,ht,3))
call DestroyTimer(LoadTimerHandle(Hash,ht,3))
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,15.,"|cFFC60000Время вышло, вы не смогли уничтожить обелиски вовремя!|r")
set udg_Quest=true
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(Hash,ht)
endif
call DestroyGroup(g)
set t=null
set g=null
set g2=null
set u=null
endfunction
function Trig_FourObelisk_Actions takes nothing returns nothing
local timer t=CreateTimer()
local integer ht=GetHandleId(t)
local timer t2=CreateTimer()
local group g=CreateGroup()
set bj_lastCreatedUnit=CreateUnit(Player(11),'nico',6399.00,-6527.00,bj_UNIT_FACING)
call GroupAddUnit(g,bj_lastCreatedUnit)
set bj_lastCreatedUnit=CreateUnit(Player(11),'nico',7423.00,-5250.00,bj_UNIT_FACING)
call GroupAddUnit(g,bj_lastCreatedUnit)
set bj_lastCreatedUnit=CreateUnit(Player(11),'nico',7983.00,-6529.00,bj_UNIT_FACING)
call GroupAddUnit(g,bj_lastCreatedUnit)
set bj_lastCreatedUnit=CreateUnit(Player(11),'nico',10111.00,-5887.00,bj_UNIT_FACING)
call GroupAddUnit(g,bj_lastCreatedUnit)
set udg_Quest=false
call RemoveItem(GetItemOfTypeFromUnitBJ(GetManipulatingUnit(),'I00I'))
call TimerStart(t2,120.,false,null)
call CreateTimerDialogBJ(t2,"Обелиски")
call TimerDialogDisplay(bj_lastCreatedTimerDialog,true)
call SaveGroupHandle(Hash,ht,1,g)
call SaveTimerDialogHandle(Hash,ht,2,bj_lastCreatedTimerDialog)
call SaveTimerHandle(Hash,ht,3,t2)
call PlaySoundBJ(gg_snd_Hint)
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,30.,"|cFFCD8948Активировано задание \"Четыре обелиска\"|r\n\nЦель: уничтожить 4 обелиска за 120 секунд.\n\n|cFFFFDC00Награда: +2000 золота, +20% получаемому и +10% макс. золоту всем героям.")
call PingMinimapForForceEx(bj_FORCE_ALL_PLAYERS,7935.,-6400.,12.00,bj_MINIMAPPINGSTYLE_SIMPLE,100,87.00,0.00)
call TimerStart(t,1.,true,function FourObelisk_Timer)
call DestroyTrigger(GetTriggeringTrigger())
set t2=null
set g=null
set t=null
endfunction
function InitTrig_FourObelisk takes nothing returns nothing
set gg_trg_FourObelisk=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_FourObelisk,EVENT_PLAYER_UNIT_USE_ITEM)
call TriggerAddCondition(gg_trg_FourObelisk,Condition(function Trig_FourObelisk_Conditions))
call TriggerAddAction(gg_trg_FourObelisk,function Trig_FourObelisk_Actions)
endfunction
function Trig_StartQuests_Conditions takes nothing returns boolean
if(not(IsUnitType(GetEnteringUnit(),UNIT_TYPE_HERO)))then
return false
endif
return true
endfunction
function QuestGoblinGold takes integer id,integer gold returns nothing
if GetUnitAbilityLevel(udg_Hero[id+1],'A0A4')>0 and udg_ScorpionMutation[3]==3 then
set gold=(gold*13)/10
endif
call SetPlayerStateBJ(Player(id),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)+gold)
set GoldNT[id+1]=GoldNT[id+1]+gold
endfunction
function Trig_StartQuests_Actions takes nothing returns nothing
local integer id=GetPlayerId(GetOwningPlayer(GetEnteringUnit()))
local integer ID=id+1
local boolean BHelpGoblinText=false
if GetUnitTypeId(GetEnteringUnit())!='N009' and GetUnitTypeId(GetEnteringUnit())!='N03T' and GetUnitTypeId(GetEnteringUnit())!='N025' and GetUnitTypeId(GetEnteringUnit())!='H04O' and GetUnitTypeId(GetEnteringUnit())!='H04Q' and GetUnitTypeId(GetEnteringUnit())!='H02T' and GetUnitTypeId(GetEnteringUnit())!='H000' then
set udg_u=GetEnteringUnit()
if udg_StartQuests==1 and UnitHasItemOfTypeBJ(udg_u,'I09O')then
set BHelpGoblinText=true
set udg_StartQuests=2
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Ох спасибо дружище! Так-так, хм... это не надо, плазмопушка не нужна... флюгегехаймен тоже не подойдет... Слушай, возьми батарейку, она у меня тут лишняя, тебе может пригодится")
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFFFFDC00Вы прошли задание\nНаграда: Батарейка")
call RemoveItem(GetItemOfTypeFromUnitBJ(udg_u,'I09O'))
call UnitAddItemByIdSwapped('I06Y',udg_u)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl",udg_u,"origin"))
call ForceAddPlayerSimple(Player(id),udg_Quests[5])
set udg_QuestNumber=GetRandomInt(1,2)
if udg_QuestNumber==1 then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Следующее задание |cFF00C850Рудокоп|r")
set s__QuestGoblinText[0]="|cFF00C850Начальное задание [2/4] Рудокоп|r\n"
set s__QuestGoblinText[1]="Cпacибo зa зaпчacти, нo y мeня вoзниклa eщe oднa пpoблeмa... Дeлo в тoм, чтo мнe нeгдe cпaть, вы cпитe нa мягкиx кpoвaтяx c кaкими-тo пoдyшкaми, a y мeня нa poдинe пpинятo cпaть нa кaмняx... Бoлee тoгo, ecли клacть гoлoвy нa aлый caмoцвeт, тo yтpoм пpocнeшьcя eщe yмнee чeм вчepa! Дyмaю, мнe xвaтит пpимepнo 10 oбычныx кaмнeй и oднoгo aлoгo caмoцвeтa."
set s__QuestGoblinText[2]="|cFFFFDC00Награда успевшему игроку: предмет \"Отличная кирка\", 500 золота + доступ к заданиям \"Поиск оружия\"|r"
else
call TriggerExecute(gg_trg_QuestBandits)
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Следующее задание |cFF00C850Разбойники|r")
set s__QuestGoblinText[0]="|cFF00C850Начальное задание [2/4] Разбойники|r\n"
set s__QuestGoblinText[1]="Cпacибo зa зaпчacти, нo y мeня вoзниклa eщe oднa пpoблeмa... Дeлo в тoм, чтo пpямo в гopoдe вoзлe мoeгo дoмa oбocнoвaлиcь бaндиты. Я oчeнь бecпoкoюcь, чтo oднaжды вcтpeчycь c ними пo дopoгe и oни мeня oбкpaдyт. Мoжeшь c ними paзoбpaтьcя?"
set s__QuestGoblinText[2]="|cFFFFDC00Награда успевшему игроку: предмет \"Отличная кирка\", 500 золота + доступ к заданиям \"Поиск оружия\"|r"
endif
elseif udg_StartQuests==2 then
if udg_QuestNumber==1 and UnitHasItemOfTypeBJ(udg_u,'I03C')and GetItemCharges(GetItemOfTypeFromUnitBJ(udg_u,'I03B'))>=10 then
set BHelpGoblinText=true
set udg_StartQuests=3
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Уже принес камни? Как ты из добыл без кирки? Я только хотел дать тебе её, но ты сразу куда-то сбежал. Но спасибо тебе, наконец-то я смогу нормально поспать.")
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFFFFDC00Вы прошли задание\nНаграда: Отличная кирка и +500 золотых")
call RemoveItem(GetItemOfTypeFromUnitBJ(udg_u,'I03C'))
if GetItemCharges(GetItemOfTypeFromUnitBJ(udg_u,'I03B'))>10 then
call SetItemCharges(GetItemOfTypeFromUnitBJ(udg_u,'I03B'),(GetItemCharges(GetItemOfTypeFromUnitBJ(udg_u,'I03B'))-10))
else
call RemoveItem(GetItemOfTypeFromUnitBJ(udg_u,'I03B'))
endif
set udg_QuestNumber=GetRandomInt(1,2)
if udg_QuestNumber==1 then
call ShowUnitShow(gg_unit_h040_1265)
call EnableTrigger(gg_trg_QuestMurloc)
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Следующее задание |cFF00C850Монокль|r")
set s__QuestGoblinText[0]="|cFF00C850Начальное задание [3/4]: Моноколь|r\n"
set s__QuestGoblinText[1]="Cпacибo, чтo пoмoг c кpoвaтью, я oтличнo выcпaлcя! И зaoднo вcпoмнил, чтo пo пyти cюдa кaкoй-тo кoбoльд втюxaл мнe зaпиcнyю книжкy eгo пpaпpaпpaдeдa - нeкoгo Koбoл`Дaнa. He дyмaю, чтo тaм чтo-тo интepecнoe, нo мнe бoльшe нeчeгo читaть. Ecть oднa пpoблeмa - бeз oчкoв я ничeгo нe вижy. Гoвopят, y кaкoгo-тo мypлoкa нa вocтoчнoм ocтpoвe ecть мoнoкль - для чтeния тoжe пoдoйдёт. Hy чтo, cмoжeшь пpинecти мнe мoнoкль?"
set s__QuestGoblinText[2]="|cFFFFDC00Награда успевшему игроку: предмет \"Костюм путешественника\" + 5000 золота + доступ к заданиям \"Поиск оружия\"|r"
else
call EnableTrigger(gg_trg_QuestPortal)
set udg_Quest3Portal=false
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Следующее задание |cFF00C850Аномалия|r")
set s__QuestGoblinText[0]="|cFF00C850Начальное задание [3/4]: Аномалия|r\n"
set s__QuestGoblinText[1]="Слушай, мой прибор засек какую-то странную аномалию, которая находится чуть южнее города. Иди и разберись с ней, взамен я дам тебе что-нибудь"
set s__QuestGoblinText[2]="|cFFFFDC00Награда успевшему игроку: предмет \"Костюм путешественника\" + доступ к заданиям \"Поиск оружия\"|r"
endif
call ForceAddPlayerSimple(Player(id),udg_Quests[5])
call UnitAddItemByIdSwapped('I09P',udg_u)
call QuestGoblinGold(id,500)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl",udg_u,"origin"))
elseif udg_QuestNumber==2 and CountUnitsInGroup(udg_Quest3UG)==0 then
set BHelpGoblinText=true
set udg_StartQuests=3
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Ты с ними разобрался? Ох, спасибо, ты избавил меня от лишней мороки. Вот держи это в качестве награды\n\n|cFFFFDC00Вы прошли задание\nНаграда: Отличная кирка и +250 золотых")
set udg_QuestNumber=GetRandomInt(1,2)
if udg_QuestNumber==1 then
call ShowUnitShow(gg_unit_h040_1265)
call EnableTrigger(gg_trg_QuestMurloc)
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Следующее задание |cFF00C850Монокль|r")
set s__QuestGoblinText[0]="|cFF00C850Начальное задание [3/4]: Моноколь|r\n"
set s__QuestGoblinText[1]="Cпacибo, чтo пoмoг c кpoвaтью, я oтличнo выcпaлcя! И зaoднo вcпoмнил, чтo пo пyти cюдa кaкoй-тo кoбoльд втюxaл мнe зaпиcнyю книжкy eгo пpaпpaпpaдeдa - нeкoгo Koбoл`Дaнa. He дyмaю, чтo тaм чтo-тo интepecнoe, нo мнe бoльшe нeчeгo читaть. Ecть oднa пpoблeмa - бeз oчкoв я ничeгo нe вижy. Гoвopят, y кaкoгo-тo мypлoкa нa вocтoчнoм ocтpoвe ecть мoнoкль - для чтeния тoжe пoдoйдёт. Hy чтo, cмoжeшь пpинecти мнe мoнoкль?"
set s__QuestGoblinText[2]="|cFFFFDC00Награда успевшему игроку: предмет \"Костюм путешественника\" + 5000 золота + доступ к заданиям \"Поиск оружия\"|r"
else
