call SelectUnitForPlayerSingle(GetEnteringUnit(),GetOwningPlayer(GetEnteringUnit()))
call AddSpecialEffectLocBJ(l,"Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call RemoveLocation(l)
set l=null
endfunction
function InitTrig_Exit_1 takes nothing returns nothing
set gg_trg_Exit_1=CreateTrigger()
call TriggerRegisterEnterRectSimple(gg_trg_Exit_1,gg_rct_ISP)
call TriggerAddCondition(gg_trg_Exit_1,Condition(function Trig_Exit_1_Conditions))
call TriggerAddAction(gg_trg_Exit_1,function Trig_Exit_1_Actions)
endfunction
function Trig_SpawnW_u00E takes nothing returns boolean
return(GetUnitTypeId(GetFilterUnit())=='u00E' and GetOwningPlayer(GetFilterUnit())==Player(PLAYER_NEUTRAL_AGGRESSIVE))
endfunction
