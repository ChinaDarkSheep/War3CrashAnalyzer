function Trig_List_Income takes nothing returns nothing
local integer ID=GetPlayerId(GetOwningPlayer(GetEnumUnit()))+1
local real gold
local integer a
if udg_Time[2]>19 and udg_Time[2]<30 and udg_Time[3]==0 then
set a=(110*R2I(8+2*GoldAvg[ID]))/10
set gold=70+GetRandomInt(100,a)
else
set gold=70
endif
if udg_ScorpionMutation[3]==3 and GetEnumUnit()==udg_Scorpion then
set gold=gold*1.3
endif
if GetInventoryIndexOfItemTypeBJ(GetEnumUnit(),'I0E9')>0 then
set gold=gold*1.3
endif
set a=R2I(gold)
call AdjustPlayerStateBJ(a,GetOwningPlayer(GetEnumUnit()),PLAYER_STATE_RESOURCE_GOLD)
set GoldNT[ID]=GoldNT[ID]+a
call CreateTextTagUnitBJ(("|cFFFFDC00+"+I2S(a)),GetEnumUnit(),0,10.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call ShowTextTagForceBJ(false,udg_TEXT,GetPlayersAll())
call ShowTextTagForceBJ(true,udg_TEXT,bj_FORCE_PLAYER[ID-1])
call SetTextTagVelocityBJ(udg_TEXT,75.00,90.00)
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
endfunction
function Trig_List_Func005A takes nothing returns nothing
call SetUnitManaPercentBJ(GetEnumUnit(),(GetUnitManaPercent(GetEnumUnit())+1.00))
endfunction
function Trig_List_Func006A takes nothing returns nothing
call SetUnitLifePercentBJ(GetEnumUnit(),(GetUnitLifePercent(GetEnumUnit())*0.98))
endfunction
function Trig_List_HellBoots takes nothing returns nothing
local unit hero=GetEnumUnit()
local unit u
local real x
local real y
local group g=CreateGroup()
local real dmg=1.5*GetHeroStr(hero,true)
if UnitAlive(hero)then
set x=GetUnitX(hero)
set y=GetUnitY(hero)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
call GroupEnumUnitsInRange(g,x,y,400.,null)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)and IsUnitEnemy(u,GetOwningPlayer(hero))then
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
call GroupRemoveUnit(g,u)
endloop
endif
call DestroyGroup(g)
set hero=null
set u=null
set g=null
endfunction
function Trig_List_Matrix takes nothing returns nothing
local unit hero=GetEnumUnit()
local unit u
local real x
local real y
local group g=CreateGroup()
local real dmg=udg_MatrixDamage[GetPlayerId(GetOwningPlayer(hero))+1]
if UnitAlive(hero)then
if UnitHasItemOfTypeBJ(hero,'I08W')==true then
set dmg=500+0.15*GetUnitState(hero,UNIT_STATE_MAX_LIFE)
else
if UnitHasItemOfTypeBJ(hero,'I064')==true then
set dmg=200+0.15*GetUnitState(hero,UNIT_STATE_MAX_LIFE)
endif
endif
set x=GetUnitX(hero)
set y=GetUnitY(hero)
call GroupEnumUnitsInRange(g,x,y,300.,null)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)and IsUnitEnemy(u,GetOwningPlayer(hero))then
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Weapons\\DragonHawkMissile\\DragonHawkMissile.mdl",u,"original")
call DestroyEffect(bj_lastCreatedEffect)
endif
call GroupRemoveUnit(g,u)
endloop
endif
call DestroyGroup(g)
set hero=null
set u=null
set g=null
endfunction
function Trig_List_Hero takes nothing returns nothing
local unit hero=GetEnumUnit()
local integer h=GetHandleId(hero)
local integer iuh=LoadInteger(Hash,h,0)
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local integer a
local integer b
local integer c
local unit u
local real x
local real y
local real xh=GetUnitX(hero)
local real yh=GetUnitY(hero)
local group g=CreateGroup()
local real dmg
local real r
if UnitAlive(hero)then
if ID<9 then
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='glsk' then
set dmg=GetUnitState(hero,UNIT_STATE_LIFE)*.25+.15*GetUnitState(hero,UNIT_STATE_MAX_LIFE)
set r=0.25*dmg
set dmg=0.75*dmg
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,xh,yh,500.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,true,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(hero,u,r,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
call DestroyEffect(AddSpecialEffect("war3mapImported\\NewDirtEXNofire.mdx",xh,yh))
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)*.925)
elseif GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='rlif' then
set x=2.+0.02*GetUnitState(hero,UNIT_STATE_MAX_LIFE)
set y=GetUnitState(hero,UNIT_STATE_LIFE)
if y-x>1. then
call SetUnitState(hero,UNIT_STATE_LIFE,y-x)
else
call SetUnitState(hero,UNIT_STATE_LIFE,1.)
endif
if udg_Time[2]<30 and udg_Time[3]==0 then
set a=30+3*udg_Time[2]
else
set a=30
endif
if GetInventoryIndexOfItemTypeBJ(hero,'I0E9')>0 then
set a=R2I(a*1.3)
endif
call AdjustPlayerStateBJ(a,GetOwningPlayer(hero),PLAYER_STATE_RESOURCE_GOLD)
set GoldNT[ID]=GoldNT[ID]+a
call CreateTextTagUnitBJ(("|cFFFFDC00+"+I2S(a)),hero,-125,10.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call ShowTextTagForceBJ(false,udg_TEXT,GetPlayersAll())
call ShowTextTagForceBJ(true,udg_TEXT,bj_FORCE_PLAYER[ID-1])
call SetTextTagVelocityBJ(udg_TEXT,75.00,90.00)
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='rde1' then
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+20+1.*GetHeroLevel(hero))
if LoadInteger(udg_hash,GetHandleId(hero),StringHash("Grapevine"))<110 then
call SaveInteger(udg_hash,GetHandleId(hero),StringHash("Grapevine"),1+LoadInteger(udg_hash,GetHandleId(hero),StringHash("Grapevine")))
if LoadInteger(udg_hash,GetHandleId(hero),StringHash("Grapevine"))==110 then
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"|cffffcc00Достигнут лимит предмета: "+GetItemName(UnitItemInSlot(udg_Trophy_build[ID],0))+"|r")
endif
set a=4
else
set a=2
endif
if a>=GetRandomInt(1,10)then
set a=GetRandomInt(1,4)
if a==1 then
call SetHeroStr(hero,(GetHeroStr(hero,false)+1),true)
elseif a==2 then
call SetHeroAgi(hero,(GetHeroAgi(hero,false)+1),true)
elseif a==3 then
call SetHeroInt(hero,(GetHeroInt(hero,false)+1),true)
elseif a==4 then
if LoadStr(udg_hash,GetHandleId(hero),2)=="Str" then
call SetHeroStr(hero,(GetHeroStr(hero,false)+1),true)
elseif LoadStr(udg_hash,GetHandleId(hero),2)=="Agi" then
call SetHeroAgi(hero,(GetHeroAgi(hero,false)+1),true)
else
call SetHeroInt(hero,(GetHeroInt(hero,false)+1),true)
endif
endif
endif
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='hval' then
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,xh,yh,1200.,Bool_Filter_ID_Ally)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if not IsUnitInGroup(u,angel_wings)then
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+0.75*(GetUnitState(u,UNIT_STATE_MAX_LIFE)/100))
call GroupAddUnit(angel_wings,u)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl",u,"original")
call DestroyEffect(bj_lastCreatedEffect)
endif
call GroupRemoveUnit(g,u)
endloop
endif
if UnitHasItemOfTypeBJ(hero,'I01L')then
call F_Looting(hero,8,100,GetUnitX(udg_Circle[ID]),GetUnitY(udg_Circle[ID]))
endif
if GetUnitAbilityLevel(hero,'A173')>0 then
set dmg=(GetUnitAbilityLevel(hero,'A173')*0.1+0.3)*Summ_Attack(hero)*Psych_crit(hero,1.,1.)
call GroupDamage_e(xh,yh,600,hero,true,dmg,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,"Abilities\\Weapons\\Rifle\\RifleImpact.mdl")
endif
if UnitHasItemOfTypeBJ(hero,'I03Y')and GetInventoryIndexOfItemTypeBJ(hero,'I0E9')>0 then
set a=10
if udg_ScorpionMutation[3]==3 and hero==udg_Scorpion then
set a=R2I(a*1.3)
endif
call AdjustPlayerStateBJ(a,GetOwningPlayer(hero),PLAYER_STATE_RESOURCE_GOLD)
set GoldNT[GetPlayerId(GetOwningPlayer(hero))+1]=GoldNT[GetPlayerId(GetOwningPlayer(hero))+1]+a
call CreateTextTagUnitBJ(("|cFFFFDC00+"+I2S(a)),hero,0,10.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call ShowTextTagForceBJ(false,udg_TEXT,GetPlayersAll())
call ShowTextTagForceBJ(true,udg_TEXT,bj_FORCE_PLAYER[ID-1])
call SetTextTagVelocityBJ(udg_TEXT,75.00,90.00)
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
endif
endif
if LoadBoolean(udg_hash,h,StringHash("HaveBar"))then
if UnitHasItemOfTypeBJ(hero,'I0F2')then
if udg_Time[2]>19 and udg_Time[2]<30 and udg_Time[3]==0 then
set b=50
else
set b=25
endif
set a=R2I(b*(2.5+7.5*GoldAvg[ID]))/10
call SetPlayerStateBJ(Player(ID-1),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(ID-1),PLAYER_STATE_RESOURCE_GOLD)+a)
set GoldNT[ID]=GoldNT[ID]+a
call CreateTextTagUnitBJ("|cFFFFDC00+"+I2S(a),hero,0,10.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call ShowTextTagForceBJ(false,udg_TEXT,GetPlayersAll())
call ShowTextTagForceBJ(true,udg_TEXT,bj_FORCE_PLAYER[ID-1])
call SetTextTagVelocityBJ(udg_TEXT,75.00,90.00)
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
endif
endif
if udg_Mode !=4 then
set a=0
set x=0.
loop
exitwhen a>=5
if GetItemTypeId(UnitItemInSlot(hero,a))=='I026' then
set x=x+udg_Time[2]*5+25
elseif GetItemTypeId(UnitItemInSlot(hero,a))=='I05H' then
set x=x+udg_Time[2]*5+25
elseif GetItemTypeId(UnitItemInSlot(hero,a))=='I07Z' then
set x=x+udg_Time[2]*2+5
endif
set a=a+1
endloop
set x=x+udg_Time[2]*2
if x>0. then
set a=R2I(x*udg_HeroExp[ID])
call AddHeroXPSwapped(a,hero,true)
endif
endif
if UnitHasItemOfTypeBJ(hero,'I09A')then
call SetUnitState(hero,UNIT_STATE_MANA,GetUnitState(hero,UNIT_STATE_MANA)+0.06*GetUnitState(hero,UNIT_STATE_MAX_MANA))
endif
if UnitHasItemOfTypeBJ(hero,'I09K')then
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.03*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
call SetUnitState(hero,UNIT_STATE_MANA,GetUnitState(hero,UNIT_STATE_MANA)+0.03*GetUnitState(hero,UNIT_STATE_MAX_MANA))
endif
if UnitHasItemOfTypeBJ(hero,'I0E4')then
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.03*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
endif
if UnitHasItemOfTypeBJ(hero,'I03V')then
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.06*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
endif
if GetInventoryIndexOfItemTypeBJ(hero,'I0BP')>0 and(GetUnitState(hero,UNIT_STATE_LIFE)/GetUnitState(hero,UNIT_STATE_MAX_LIFE))<=.3 then
set y=GetUnitState(hero,UNIT_STATE_MAX_LIFE)
set x=0
set bj_forLoopAIndex=0
set bj_forLoopAIndexEnd=6
loop
exitwhen bj_forLoopAIndex>=bj_forLoopAIndexEnd
if GetItemTypeId(UnitItemInSlot(hero,bj_forLoopAIndex))=='I0BP' then
set x=x+1
endif
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set y=(0.015*y)+(0.015*y*x)
if GetUnitState(hero,UNIT_STATE_LIFE)>y then
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)-y)
else
call SetUnitState(hero,UNIT_STATE_LIFE,1.)
endif
endif
if UnitHasItemOfTypeBJ(hero,'I0B8')==true then
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,xh,yh,2000.,Condition(function Trig_Filter_ID_Ally))
loop
set u=FirstOfGroup(g)
exitwhen u==null
if not IsUnitInGroup(u,udg_StoneHeal)then
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+0.01*GetUnitState(u,UNIT_STATE_MAX_LIFE))
call GroupAddUnit(udg_StoneHeal,u)
endif
call GroupRemoveUnit(g,u)
endloop
endif
if UnitHasItemOfTypeBJ(hero,'I078')then
if udg_Time[2]>19 and udg_Time[2]<30 and udg_Time[3]==0 then
set a=GetRandomInt(10,15)
else
set a=GetRandomInt(8,10)
endif
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]+a
set b=LoadInteger(udg_hash,h,StringHash("StaffGold1"))
if UnitHasItemOfTypeBJ(hero,'I0E9')and b>0 then
set c=LoadInteger(Hash,GetHandleId(udg_Hero[LoadInteger(udg_hash,h,StringHash("StaffGoldID"))+1]),0)
set s__Units_HP[sUnit[c]]=s__Units_HP[sUnit[c]]+a
endif
endif
if UnitHasItemOfTypeBJ(hero,'I0EC')then
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl",xh,yh))
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,xh,yh,400.,Bool_Filter_ID)
set dmg=1.5*GetHeroStr(hero,true)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
endif
if UnitHasItemOfTypeBJ(hero,'I0AX')then
set dmg=0.2*GetHeroInt(hero,true)
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,xh,yh,300.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Weapons\\DragonHawkMissile\\DragonHawkMissile.mdl",u,"original")
call DestroyEffect(bj_lastCreatedEffect)
call GroupRemoveUnit(g,u)
endloop
endif
endif
call DestroyGroup(g)
set hero=null
set u=null
set g=null
endfunction
function Filter_HeroesIncBoss takes nothing returns boolean
return(IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO)and not IsUnitInGroup(GetFilterUnit(),G_HeroesIncBoss))
endfunction
function ADD_G_HeroesIncBoss takes nothing returns nothing
call GroupAddUnit(G_HeroesIncBoss,GetEnumUnit())
endfunction
function Trig_List_Actions takes nothing returns nothing
local group g=CreateGroup()
call GroupClear(udg_StoneHeal)
call GroupClear(angel_wings)
call GroupEnumUnitsInRect(g,GetWorldBounds(),Condition(function Filter_HeroesIncBoss))
call ForGroup(g,function ADD_G_HeroesIncBoss)
call ForGroup(G_HeroesIncBoss,function Trig_List_Hero)
call ForGroup(udg_RedTalismanGroup,function Trig_List_Income)
call ForGroup(udg_DeathNecklaceGroup,function Trig_List_Func005A)
call ForGroup(udg_DarkEyeGroup,function Trig_List_Func006A)
call ForGroup(udg_DiabolicBoots,function Trig_List_HellBoots)
call ForGroup(udg_MatrixGroup,function Trig_List_Matrix)
call DestroyGroup(g)
set s__Heroes_Str[sHero[0]]=0
set s__Heroes_Agi[sHero[0]]=0
set s__Heroes_Int[sHero[0]]=0
set s__Units_AllDmg[sUnit[0]]=10000
set s__Units_AllDmgM[sUnit[0]]=10000
set s__Units_AllTake[sUnit[0]]=10000
set s__Units_AllBlock[sUnit[0]]=10000
set s__Units_MageBlock[sUnit[0]]=10000
set s__Units_MageTake[sUnit[0]]=10000
set s__Units_MageDamage[sUnit[0]]=10000
set s__Units_NoMageDmg[sUnit[0]]=10000
set s__Units_Immortal[sUnit[0]]=0
set s__Units_HP[sUnit[0]]=0
set s__Units_MP[sUnit[0]]=0
set s__Units_GAttack[sUnit[0]]=0
set s__Units_Arm[sUnit[0]]=0
set s__Units_BarE[sUnit[0]]=null
set s__Units_Bar[sUnit[0]]=0.
set s__Units_BarLich[sUnit[0]]=0.
set g=null
call SeekMinDummys()
endfunction
function InitTrig_List takes nothing returns nothing
set gg_trg_List=CreateTrigger()
call TriggerRegisterTimerExpireEventBJ(gg_trg_List,udg_ListTimer)
call TriggerAddAction(gg_trg_List,function Trig_List_Actions)
endfunction
function Trig_AnciestSeal_Func001A takes nothing returns nothing
local integer a
if UnitAlive(GetEnumUnit())then
if udg_Time[2]>17 and udg_Time[2]<30 and udg_Time[3]==0 then
set a=GetRandomInt(2,4)
else
if GetRandomInt(1,3)==1 then
set a=1
else
set a=2
endif
endif
call ModifyHeroStat(bj_HEROSTAT_STR,GetEnumUnit(),bj_MODIFYMETHOD_ADD,a)
endif
endfunction
function Trig_AnciestSeal_Actions takes nothing returns nothing
call ForGroup(udg_AnciestSealGroup,function Trig_AnciestSeal_Func001A)
call StatsSnapshot()
endfunction
function InitTrig_AnciestSeal takes nothing returns nothing
set gg_trg_AnciestSeal=CreateTrigger()
call TriggerRegisterTimerExpireEventBJ(gg_trg_AnciestSeal,udg_AnciestSealTimer)
call TriggerAddAction(gg_trg_AnciestSeal,function Trig_AnciestSeal_Actions)
endfunction
function Trig_UseItemJass_EnergyDrink takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer sec=LoadInteger(udg_hash,ht,1)
if sec>0 and UnitAlive(caster)then
set sec=sec-1
call SaveInteger(udg_hash,ht,1,sec)
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)*0.99)
else
if UnitAlive(caster)then
call SetUnitMoveSpeed(caster,GetUnitDefaultMoveSpeed(caster))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
endif
set caster=null
set t=null
endfunction
function Trig_UseItemJass_LGA takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(caster)
local integer a=LoadInteger(udg_hash,ht,1)
local integer ihh=LoadInteger(udg_hash,h,5)
set s__Heroes_TempStr[sHero[ihh]]=s__Heroes_TempStr[sHero[ihh]]-a
call F_Stats(caster)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set caster=null
set t=null
endfunction
function Trig_UseItemJass_GladiatorShield takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(caster)
local effect e=LoadEffectHandle(udg_hash,ht,1)
local integer iuh=LoadInteger(Hash,h,0)
set s__Units_AllBlock[sUnit[iuh]]=s__Units_AllBlock[sUnit[iuh]]-3000
set s__Units_MageBlock[sUnit[iuh]]=s__Units_MageBlock[sUnit[iuh]]-3000
call DestroyEffect(e)
call PauseTimer(t)
call FlushChildHashtable(udg_hash,ht)
call DestroyTimer(t)
set caster=null
set e=null
set t=null
endfunction
function Trig_UseItemJass_HelpStaff takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local group gt=LoadGroupHandle(udg_hash,ht,0)
local integer sec=LoadInteger(udg_hash,ht,1)
local real heal=LoadReal(udg_hash,ht,2)
local unit caster=LoadUnitHandle(udg_hash,ht,3)
local group g=CreateGroup()
local unit u
if sec !=0 then
set sec=sec-1
call SaveInteger(udg_hash,ht,1,sec)
loop
set u=FirstOfGroup(gt)
exitwhen u==null
if UnitAlive(u)then
call Heal(true,heal,u,caster)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Human\\Heal\\HealTarget.mdl",u,"origin")
call DestroyEffect(bj_lastCreatedEffect)
call GroupAddUnit(g,u)
endif
call GroupRemoveUnit(gt,u)
endloop
call SaveGroupHandle(udg_hash,ht,0,g)
else
call PauseTimer(t)
call FlushChildHashtable(udg_hash,ht)
call DestroyTimer(t)
call DestroyGroup(g)
endif
call DestroyGroup(gt)
set gt=null
set g=null
set caster=null
set u=null
set t=null
endfunction
function UseItemJass_ScaleArmor takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local real sec=LoadReal(udg_hash,ht,1)
local real dmg=F_HPregen(caster)*2
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
if sec>0 and UnitAlive(caster)then
set sec=sec-.5
call SaveReal(udg_hash,ht,1,sec)
call GroupDamage(x,y,375.,caster,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\NightElf\\FanOfKnives\\FanOfKnivesCaster.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
else
call PauseTimer(t)
call FlushChildHashtable(udg_hash,ht)
call DestroyTimer(t)
endif
set caster=null
set t=null
endfunction
function PerfectCire takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local real dmg=LoadReal(udg_hash,ht,0)
local integer ID=LoadInteger(udg_hash,ht,1)
set udg_ReflectDmg[ID]=udg_ReflectDmg[ID]-dmg
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
endfunction
function F_AmuletRin takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(caster)
local real sec=LoadReal(udg_hash,h,StringHash("AmuRinSec"))-.25
local integer ihh=LoadInteger(udg_hash,h,5)
local integer iuh=LoadInteger(Hash,h,0)
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
if sec>0. and s__Heroes_BarAmRin[sHero[ihh]]>0. then
call SaveReal(udg_hash,h,StringHash("AmuRinSec"),sec)
else
call SaveReal(udg_hash,h,StringHash("AmuRinSec"),0.)
set s__Units_Bar[sUnit[iuh]]=s__Units_Bar[sUnit[iuh]]-s__Heroes_BarAmRin[sHero[ihh]]
set s__Heroes_BarAmRin[sHero[ihh]]=0.
if s__Units_Bar[sUnit[iuh]]<1. and s__Units_BarE[sUnit[iuh]]!=null then
call DestroyEffect(s__Units_BarE[sUnit[iuh]])
set s__Units_BarE[sUnit[iuh]]=null
endif
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
set caster=null
set t=null
endfunction
function SingularitySphere_Dmg takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer Id=GetHandleId(t)
local unit u=LoadUnitHandle(udg_hash,Id,1)
local player pl=GetOwningPlayer(u)
local integer count=LoadInteger(udg_hash,Id,1)
local real dmg=(GetHeroStr(u,true)+GetHeroAgi(u,true)+GetHeroInt(u,true))*1.25*0.20
local real dist=700-count*12.5
local real angle
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x3
local real y3
local unit u3
local group l__ug=CreateGroup()
set udg_noSplash=true
call GroupEnumUnitsInRange(l__ug,x,y,dist,null)
loop
set u3=FirstOfGroup(l__ug)
exitwhen u3==null
if UnitAlive(u3)and IsUnitEnemy(u3,pl)then
call UnitDamageTarget(u,u3,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
if UnitAlive(u3)and IsUnitType(u3,UNIT_TYPE_ANCIENT)!=true and IsUnitType(u3,UNIT_TYPE_STRUCTURE)!=true then
set x3=GetUnitX(u3)
set y3=GetUnitY(u3)
set angle=bj_RADTODEG*Atan2(y-y3,x-x3)
call KnockBackUnit(u3,30,0.20,angle,0.05)
endif
endif
call GroupRemoveUnit(l__ug,u3)
endloop
set udg_noSplash=false
if count==0 or UnitAlive(u)==false then
call PauseTimer(t)
call DestroyEffect(LoadEffectHandle(udg_hash,Id,2))
call FlushChildHashtable(udg_hash,Id)
call DestroyTimer(t)
else
call SaveInteger(udg_hash,Id,1,count-1)
endif
call DestroyGroup(l__ug)
set l__ug=null
set u=null
set pl=null
set t=null
set u3=null
endfunction
function WatchDeath takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer sec=LoadInteger(udg_hash,ht,1)
local real dmg=F_HPregen(caster)*3
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
if sec !=0 and UnitAlive(caster)then
set sec=sec-1
call SaveInteger(udg_hash,ht,1,sec)
else
if UnitAlive(caster)then
call SaveBoolean(udg_hash,GetHandleId(caster),StringHash("WatchDeath"),false)
call KillUnit(caster)
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set caster=null
set t=null
endfunction
