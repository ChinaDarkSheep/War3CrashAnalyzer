function Trig_StackItem_Actions takes nothing returns nothing
local unit u=GetKillingUnit()
local integer id=GetPlayerId(GetOwningPlayer(u))+1
local unit hero=udg_Hero[id]
local item It
local integer a
local integer b
local integer h=GetHandleId(hero)
if udg_ChampionSpearLvl !=3 then
if Player(id-1)==GetOwningPlayer(udg_ChampionSpearUnit)then
if udg_ChampionSpearLvl==2 then
if IsUnitType(hero,UNIT_TYPE_HERO)or GetUnitLevel(GetDyingUnit())>9 then
set a=2
else
set a=1
endif
if GetOwningPlayer(GetDyingUnit())==Player(PLAYER_NEUTRAL_AGGRESSIVE)then
set a=a+1
endif
call SetItemCharges(GetItemOfTypeFromUnitBJ(hero,'I0AT'),(GetItemCharges(GetItemOfTypeFromUnitBJ(hero,'I0AT'))+a))
if GetItemCharges(GetItemOfTypeFromUnitBJ(hero,'I0AT'))>=400 then
call AddSpecialEffectTargetUnitBJ("origin",hero,"Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
set udg_ChampionSpearLvl=3
if UnitAlive(hero)then
call RemoveItem(GetItemOfTypeFromUnitBJ(hero,'I0AT'))
call UnitAddItemByIdSwapped('I0AU',hero)
else
call RemoveItem(GetItemOfTypeFromUnitBJ(hero,'I0AT'))
call UnitAddItemByIdSwapped('I0AU',udg_Circle[id])
endif
else
endif
else
if udg_ChampionSpearLvl==1 then
if IsUnitType(hero,UNIT_TYPE_HERO)or GetUnitLevel(GetDyingUnit())>9 then
set a=2
else
set a=1
endif
if GetOwningPlayer(GetDyingUnit())==Player(PLAYER_NEUTRAL_AGGRESSIVE)then
set a=a+1
endif
call SetItemCharges(GetItemOfTypeFromUnitBJ(hero,'I09L'),(GetItemCharges(GetItemOfTypeFromUnitBJ(hero,'I09L'))+a))
if GetItemCharges(GetItemOfTypeFromUnitBJ(hero,'I09L'))>=250 then
call AddSpecialEffectTargetUnitBJ("origin",hero,"Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
set udg_ChampionSpearLvl=2
if UnitAlive(hero)then
call RemoveItem(GetItemOfTypeFromUnitBJ(hero,'I09L'))
call UnitAddItemByIdSwapped('I0AT',hero)
else
call RemoveItem(GetItemOfTypeFromUnitBJ(hero,'I09L'))
call UnitAddItemByIdSwapped('I0AT',udg_Circle[id])
endif
else
endif
else
endif
endif
else
endif
else
endif
if LoadInteger(udg_hash,h,StringHash("BrokenSword"))>0 then
set a=0
loop
set It=UnitItemInSlot(hero,a)
if GetItemTypeId(It)=='I0CK' then
if GetUnitLevel(GetDyingUnit())>9 then
set b=GetItemCharges(It)+2
else
set b=GetItemCharges(It)+1
endif
if b>=200 then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",hero,"origin"))
if UnitAlive(hero)then
call RemoveItem(It)
call UnitAddItemByIdSwapped('I0CL',hero)
else
call RemoveItem(It)
call UnitAddItemByIdSwapped('I0CL',udg_Circle[id])
endif
else
call SetItemCharges(It,b)
set b=b/2
set a=LoadInteger(Hash,h,0)
set s__Units_GAttack[sUnit[a]]=s__Units_GAttack[sUnit[a]]+b-LoadInteger(udg_hash,h,StringHash("BrokenSwordAt"))
call SaveInteger(udg_hash,h,StringHash("BrokenSwordAt"),b)
endif
set a=10
endif
set a=a+1
exitwhen a>5
endloop
else
endif
set It=null
endfunction
