else
endif
if GetSpellAbilityId()=='A0PR' then
call ForGroup(udg_DruidGroup,function Trig_DruidSkills_W)
endif
if GetSpellAbilityId()=='A0PS' then
set u=GetSpellTargetUnit()
set hu=GetHandleId(u)
set lvl=GetUnitAbilityLevel(caster,'A0PS')
set a=LoadInteger(udg_hash,hu,StringHash("DruidD"))
if a>0 then
call SaveInteger(udg_hash,hu,StringHash("DruidD"),a+15)
endif
call UnitAddAbility(u,'A0PT')
call SetUnitAbilityLevel(u,'A0PT',lvl)
set a=GetHeroInt(caster,true)-s__Heroes_TempInt[sHero[ihh]]
if GetUnitAbilityLevel(u,'A0PV')==0 then
call UnitAddAbility(u,'A0PV')
endif
call SetUnitAbilityLevel(u,'A0PU',(a/100)+2)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call SaveInteger(udg_hash,ht,1,R2I(PositiveDuration(caster,16)))
call TimerStart(t,1,true,function Druid_E)
else
endif
if GetSpellAbilityId()=='A0PW' then
set dmg=GetUnitAbilityLevel(caster,'A0PW')*100+2*GetHeroInt(caster,true)
if GetHeroLevel(caster)>=50 then
set dmg=dmg+1.25*GetHeroInt(caster,true)
endif
set x=GetSpellTargetX()
set y=GetSpellTargetY()
call GroupEnumUnitsInRange(g,x,y,275.,null)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)then
if IsUnitAlly(u,Player(ID-1))and IsUnitInGroup(u,udg_DruidGroup)then
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+0.25*GetUnitState(u,UNIT_STATE_MAX_LIFE))
elseif IsUnitEnemy(u,Player(ID-1))then
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
endif
call GroupRemoveUnit(g,u)
endloop
set bj_lastCreatedEffect=AddSpecialEffect("Objects\\Spawnmodels\\NightElf\\NEDeathMedium\\NEDeath.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
endif
if GetSpellAbilityId()=='A0PY' then
set a=1
set b=(35*(GetHeroInt(caster,true)-s__Heroes_TempInt[sHero[ihh]]/2))/100
loop
exitwhen a>8
if GetUnitAbilityLevel(udg_Hero[a],'A0PP')==1 then
call TempStats(udg_Hero[a],b,b,b,0,0,0,PositiveDuration(caster,12))
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl",udg_Hero[a],"origin")
call DestroyEffect(bj_lastCreatedEffect)
endif
set a=a+1
endloop
endif
if GetSpellAbilityId()=='A0PX' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set dmg=10*GetHeroInt(caster,true)
call GroupEnumUnitsInRange(g,x,y,450.,null)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)and IsUnitEnemy(u,Player(ID-1))then
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
call GroupRemoveUnit(g,u)
endloop
endif
call DestroyGroup(g)
set g=null
set caster=null
set u=null
set t=null
endfunction
