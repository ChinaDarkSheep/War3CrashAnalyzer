function Set2_Wave1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer sec=LoadInteger(udg_hash,ht,0)+1
if sec<190 then
call SaveInteger(udg_hash,ht,0,sec)
if sec==10 then
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,45.00,"|cFFFF5800На карте находится Забытый, который своей аурой усиливает атаки врагов. Пока он не будет уничтожен, волны врагов будут бесконечны. Через 120 сек. его местоположение раскрывается.")
set RandomSpawnX[1]=GetRectCenterX(gg_rct_Spawn19)
set RandomSpawnY[1]=GetRectCenterY(gg_rct_Spawn19)
set RandomSpawnX[2]=GetRectCenterX(gg_rct_Spawn58)
set RandomSpawnY[2]=GetRectCenterY(gg_rct_Spawn58)
set RandomSpawnX[3]=GetRectCenterX(gg_rct_Spawn86)
set RandomSpawnY[3]=GetRectCenterY(gg_rct_Spawn86)
set RandomSpawnX[4]=GetRectCenterX(gg_rct_Spawn55)
set RandomSpawnY[4]=GetRectCenterY(gg_rct_Spawn55)
set RandomSpawnX[5]=GetRectCenterX(gg_rct_A2)
set RandomSpawnY[5]=GetRectCenterY(gg_rct_A2)
set RandomSpawnX[6]=GetRectCenterX(gg_rct_Spawn16)
set RandomSpawnY[6]=GetRectCenterY(gg_rct_Spawn16)
if HardcoreUP30==3 then
set bj_forLoopAIndexEnd=2
else
set bj_forLoopAIndexEnd=1
endif
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set udg_Drop=GetRandomInt(1,6)
set bj_lastCreatedUnit=CreateUnit(ForcePickRandomPlayer(udg_CreepsPlayers),'nfgo',RandomSpawnX[udg_Drop],RandomSpawnY[udg_Drop],bj_UNIT_FACING)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,bj_lastCreatedUnit)
call TimerStart(t,6.,true,function ForgetBoss)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call EnableTrigger(gg_trg_MoveAttackers)
call EnableTrigger(gg_trg_AntiBugAttackers)
