function InitTrig_ISOV takes nothing returns nothing
set gg_trg_ISOV=CreateTrigger()
call TriggerRegisterPlayerChatEvent(gg_trg_ISOV,Player(0),"-save",true)
call TriggerRegisterPlayerChatEvent(gg_trg_ISOV,Player(1),"-save",true)
call TriggerRegisterPlayerChatEvent(gg_trg_ISOV,Player(2),"-save",true)
call TriggerRegisterPlayerChatEvent(gg_trg_ISOV,Player(3),"-save",true)
call TriggerRegisterPlayerChatEvent(gg_trg_ISOV,Player(4),"-save",true)
call TriggerRegisterPlayerChatEvent(gg_trg_ISOV,Player(5),"-save",true)
call TriggerRegisterPlayerChatEvent(gg_trg_ISOV,Player(6),"-save",true)
call TriggerRegisterPlayerChatEvent(gg_trg_ISOV,Player(7),"-save",true)
call TriggerAddAction(gg_trg_ISOV,function Trig_ISOV_Actions)
endfunction
function Trig_ILOD_Upgrade takes integer ID returns nothing
local integer id=ID-1
local player pl=Player(id)
local integer Minc=0
local integer staff=0
local real gold=0.
local real exp=0.
local integer startGold=0
local integer RandGold=0
local integer attack=0
local integer hp=0
local integer mainstat=0
local integer rstatlvl4=0
local real cswap=0.
local integer i=1
local multiboarditem mbitem=null
if udg_PlayerExp[ID]>=0 then
call SetPlayerTechResearched(Player(id),'R02B',0)
endif
if udg_PlayerExp[ID]>=100 then
call SetPlayerTechResearched(Player(id),'R02B',1)
set udg_HeroGold[ID]=udg_HeroGold[ID]+0.02
set udg_HeroGoldMax[ID]=udg_HeroGoldMax[ID]+0.02
set gold=gold+0.02
set udg_HeroExp[ID]=udg_HeroExp[ID]+0.02
set exp=exp+0.02
endif
if udg_PlayerExp[ID]>=400 then
call SetPlayerTechResearched(Player(id),'R02B',2)
set staff=1
endif
if udg_PlayerExp[ID]>=800 then
call SetPlayerTechResearched(Player(id),'R02B',3)
set udg_HeroGold[ID]=udg_HeroGold[ID]+0.02
set udg_HeroGoldMax[ID]=udg_HeroGoldMax[ID]+0.02
set gold=gold+0.02
set udg_HeroExp[ID]=udg_HeroExp[ID]+0.02
set exp=exp+0.02
endif
if udg_PlayerExp[ID]>=1250 then
call SetPlayerTechResearched(Player(id),'R02B',4)
set udg_HeroGold[ID]=udg_HeroGold[ID]+0.02
set udg_HeroGoldMax[ID]=udg_HeroGoldMax[ID]+0.02
set gold=gold+0.02
set udg_HeroExp[ID]=udg_HeroExp[ID]+0.02
set exp=exp+0.02
endif
if udg_PlayerExp[ID]>=2000 then
call SetPlayerTechResearched(Player(id),'R02B',5)
set staff=2
set udg_HeroGold[ID]=udg_HeroGold[ID]+0.02
set udg_HeroGoldMax[ID]=udg_HeroGoldMax[ID]+0.02
set gold=gold+0.02
set udg_HeroExp[ID]=udg_HeroExp[ID]+0.02
set exp=exp+0.02
endif
if udg_PlayerExp[ID]>=3000 then
call SetPlayerTechResearched(Player(id),'R02B',6)
set udg_HeroGold[ID]=udg_HeroGold[ID]+0.02
set udg_HeroGoldMax[ID]=udg_HeroGoldMax[ID]+0.02
set gold=gold+0.02
set udg_HeroExp[ID]=udg_HeroExp[ID]+0.02
set exp=exp+0.02
endif
if udg_PlayerExp[ID]>=5000 then
call SetPlayerTechResearched(Player(id),'R02B',7)
set udg_HeroGold[ID]=udg_HeroGold[ID]+0.02
set udg_HeroGoldMax[ID]=udg_HeroGoldMax[ID]+0.02
set gold=gold+0.02
set udg_HeroExp[ID]=udg_HeroExp[ID]+0.02
set exp=exp+0.02
endif
if udg_PlayerExp[ID]>=7500 then
call SetPlayerTechResearched(Player(id),'R02B',8)
set staff=3
set Mincome[ID]=Mincome[ID]+30
endif
if udg_PlayerExp[ID]>=10000 then
call SetPlayerTechResearched(Player(id),'R02B',9)
set udg_HeroGold[ID]=udg_HeroGold[ID]+0.04
set udg_HeroGoldMax[ID]=udg_HeroGoldMax[ID]+0.04
set gold=gold+0.04
set udg_HeroExp[ID]=udg_HeroExp[ID]+0.04
set exp=exp+0.04
endif
if udg_PlayerExp[ID]>=13000 then
call SetPlayerTechResearched(Player(id),'R02B',10)
set staff=4
endif
if udg_PlayerExp[ID]>=16000 then
call SetPlayerTechResearched(Player(id),'R02B',11)
set startGold=startGold+250
set RandGold=RandGold+500
endif
if udg_PlayerExp[ID]>=20000 then
call SetPlayerTechResearched(Player(id),'R02B',12)
set attack=attack+10
set hp=hp+200
endif
if udg_PlayerExp[ID]>=25000 then
call SetPlayerTechResearched(Player(id),'R02B',13)
set mainstat=mainstat+4
set rstatlvl4=rstatlvl4+1
endif
if udg_PlayerExp[ID]>=30000 then
call SetPlayerTechResearched(Player(id),'R02B',14)
set startGold=startGold+75
set CostSwap[ID]=CostSwap[ID]-0.05
set cswap=cswap+0.05
endif
if udg_PlayerExp[ID]>=40000 then
call SetPlayerTechResearched(Player(id),'R02B',15)
set udg_HeroGold[ID]=udg_HeroGold[ID]+0.05
set udg_HeroGoldMax[ID]=udg_HeroGoldMax[ID]+0.05
set gold=gold+0.05
set udg_HeroExp[ID]=udg_HeroExp[ID]+0.05
set exp=exp+0.05
endif
if udg_PlayerExp[ID]>=50000 then
call SetPlayerTechResearched(Player(id),'R02B',16)
set Mincome[ID]=Mincome[ID]+30
set Minc=Minc+30
set udg_Looting[ID]=udg_Looting[ID]+0.1
endif
if udg_PlayerExp[ID]>=60000 then
call SetPlayerTechResearched(Player(id),'R02B',17)
set startGold=startGold+75
set CostSwap[ID]=CostSwap[ID]-0.05
set cswap=cswap+0.05
endif
if udg_PlayerExp[ID]>=80000 then
call SetPlayerTechResearched(Player(id),'R02B',18)
set Mincome[ID]=Mincome[ID]+30
set Minc=Minc+30
set udg_Looting[ID]=udg_Looting[ID]+0.1
endif
if udg_PlayerExp[ID]>=100000 then
call SetPlayerTechResearched(Player(id),'R02B',19)
set udg_HeroExp[ID]=udg_HeroExp[ID]+0.1
set exp=exp+0.1
endif
if udg_PlayerExp[ID]>=200000 then
call SetPlayerTechResearched(Player(id),'R02B',20)
endif
call DisplayTextToForce(bj_FORCE_PLAYER[id],("|cFF20C6CDВаш уровень - "+I2S(GetPlayerTechCount(pl,'R02B',true))))
if staff>0 then
if staff==4 then
call DisplayTextToPlayer(pl,0.,0.,"|cFFDF7AD8Вы получаете \"Посох чародея\" после выбора героя|r")
elseif staff==3 then
call DisplayTextToPlayer(pl,0.,0.,"|cFFDF7AD8Вы получаете \"Усиленный посох телепортации\" после выбора героя|r")
elseif staff==2 then
call DisplayTextToPlayer(pl,0.,0.,"|cFFDF7AD8Вы получаете \"Посох адепта\" после выбора героя|r")
else
call DisplayTextToPlayer(pl,0.,0.,"|cFFDF7AD8Вы получаете \"Посох ученика\" после выбора героя|r")
endif
endif
if gold>0 then
call DisplayTextToPlayer(pl,0.,0.,"|cFFDF7AD8+"+R2S(gold)+"% к получаемому и макс. получаемому золоту|r")
endif
if exp>0 then
call DisplayTextToPlayer(pl,0.,0.,"|cFFDF7AD8+"+R2S(exp)+"% к получаемому (героем) опыту|r")
endif
if Minc>0 then
call DisplayTextToPlayer(pl,0.,0.,"|cFFDF7AD8+"+I2S(Minc)+" золота в минуту|r")
endif
if startGold>0 then
call DisplayTextToPlayer(pl,0.,0.,"|cFFDF7AD8+"+I2S(startGold)+" стратового золота|r")
endif
if RandGold>0 then
call DisplayTextToPlayer(pl,0.,0.,"|cFFDF7AD8+"+I2S(RandGold)+" золота за случайного героя|r")
endif
if cswap>0 then
call DisplayTextToPlayer(pl,0.,0.,"|cFFDF7AD8+"+R2S(cswap)+"% скидка к замене|r")
endif
if GetPlayerTechCount(pl,'R02B',true)>12 then
call DisplayTextToPlayer(pl,0.,0.,"|cFFDF7AD8+1 к награде за убийство (умножается за получаемое золота|r")
endif
if mainstat>0 then
call DisplayTextToPlayer(pl,0.,0.,"|cFFDF7AD8+"+I2S(mainstat)+" к main stat|r")
endif
if rstatlvl4>0 then
call DisplayTextToPlayer(pl,0.,0.,"|cFFDF7AD8+"+I2S(rstatlvl4)+" к случайной характеристики повышении при каждом 4 повышении уровня|r")
endif
if attack>0 then
call DisplayTextToPlayer(pl,0.,0.,"|cFFDF7AD8+"+I2S(attack)+" к базовой атаке героя|r")
endif
if hp>0 then
call DisplayTextToPlayer(pl,0.,0.,"|cFFDF7AD8+"+I2S(hp)+" к здоровью героя|r")
endif
call SetPlayerStateBJ(pl,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(pl,PLAYER_STATE_RESOURCE_GOLD)+startGold)
set bj_forLoopBIndex=1
set bj_forLoopBIndexEnd=udg_Check
loop
exitwhen bj_forLoopBIndex>bj_forLoopBIndexEnd
if id==udg_PlayerNumber[bj_forLoopBIndex]then
call MultiboardSetItemIconBJ(udg_TableConvert[1],1,bj_forLoopBIndex+1,udg_lvlicon[GetPlayerTechCount(pl,'R02B',true)])
else
endif
set bj_forLoopBIndex=bj_forLoopBIndex+1
endloop
call MultiboardSetItemIconBJ(udg_TableConvert[2],id,2,udg_lvlicon[GetPlayerTechCount(pl,'R02B',true)])
call MultiboardSetItemValueBJ(udg_TableConvert[2],id,2,udg_lvlname[GetPlayerTechCount(pl,'R02B',true)])
set rankiconNT[ID]=udg_lvlicon[GetPlayerTechCount(pl,'R02B',true)]
set i=1
loop
exitwhen i>check
set mbitem=MultiboardGetItem(TableNT[10],i,1)
call MultiboardSetItemIcon(mbitem,heroiconNT[PlayerNumberNT[i]])
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(TableNT[10],i,0)
call MultiboardSetItemIcon(mbitem,rankiconNT[PlayerNumberNT[i]])
call MultiboardReleaseItem(mbitem)
set i=i+1
endloop
set mbitem=null
set pl=null
endfunction
function Trig_ILOD_Actions takes nothing returns nothing
local string array dc
local string array lc
local string array l2
local string array l3
local string array l4
local string fc
local player pl=GetTriggerPlayer()
local integer i=GetPlayerId(pl)+1
local integer a
local integer b
local integer c
local string array e
local integer r=0
local string s=GetEventPlayerChatString()
local string ss
local integer size=0
local integer array swap
local string array rand
local integer array ran
set a=1
loop
exitwhen a>7
set lc[a]=""
set a=a+1
endloop
set e[1]=SubString(s,9,10)
set e[2]=SubString(s,14,15)
set e[3]=SubString(s,23,24)
set e[4]=SubString(s,26,27)
set e[5]=SubString(s,31,32)
set e[6]=SubString(s,17,18)
set e[7]=SubString(s,34,35)
set rand[0]=SubString(s,32,33)
set rand[1]=SubString(s,30,31)
set rand[2]=SubString(s,6,7)
set rand[3]=SubString(s,7,8)
set rand[4]=SubString(s,12,13)
set rand[5]=SubString(s,11,12)
set rand[6]=SubString(s,21,22)
set rand[7]=SubString(s,28,29)
set rand[8]=SubString(s,16,17)
set rand[10]=SubString(s,33,34)
set rand[9]="0"
set bj_forLoopAIndex=0
loop
exitwhen bj_forLoopAIndex>10
set a=1
loop
exitwhen a>37
if rand[bj_forLoopAIndex]==SubString(alpbB,a-1,a)then
set ran[bj_forLoopAIndex]=a
elseif rand[bj_forLoopAIndex]==SubString(alpbS,a-1,a)then
set ran[bj_forLoopAIndex]=a
endif
set a=a+1
endloop
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set ran[12]=ran[1]+ran[2]+ran[3]+ran[4]+ran[5]+ran[6]+ran[7]+ran[8]
set a=ran[12]-36*(ran[12]/36)
if a<1 then
set a=1
