endfunction
function Trig_DruidD_Func001A takes nothing returns nothing
local unit u=GetEnumUnit()
if UnitAlive(u)==false or IsUnitEnemy(u,GetOwningPlayer(udg_Druid))or LoadInteger(udg_hash,GetHandleId(u),StringHash("DruidD"))<1 then
call UnitRemoveAbilityBJ('A0PP',GetEnumUnit())
call SaveInteger(udg_hash,GetHandleId(u),StringHash("DruidD"),0)
call GroupRemoveUnitSimple(GetEnumUnit(),udg_DruidGroup)
else
call SaveInteger(udg_hash,GetHandleId(u),StringHash("DruidD"),LoadInteger(udg_hash,GetHandleId(u),StringHash("DruidD"))-1)
if GetUnitState(u,UNIT_STATE_LIFE)/GetUnitState(u,UNIT_STATE_MAX_LIFE)<0.99 and GetOwningPlayer(u)!=GetOwningPlayer(udg_Druid)then
set udg_Drop=GetPlayerId(GetOwningPlayer(udg_Druid))+1
if IsUnitType(u,UNIT_TYPE_HERO)then
set udg_Drop2=10
else
set udg_Drop2=5
endif
set udg_Drop2=R2I((I2R(udg_Drop2)*udg_HeroGold[udg_Drop]))
call AdjustPlayerStateBJ(udg_Drop2,ConvertedPlayer(udg_Drop),PLAYER_STATE_RESOURCE_GOLD)
set GoldNT[GetPlayerId(GetOwningPlayer(udg_Druid))+1]=GoldNT[GetPlayerId(GetOwningPlayer(udg_Druid))+1]+udg_Drop2
call CreateTextTagUnitBJ(("|cFFFFDC00+"+I2S(udg_Drop2)),udg_Druid,0,10.00,100,100,100,0)
call ShowTextTagForceBJ(false,GetLastCreatedTextTag(),GetPlayersAll())
call ShowTextTagForceBJ(true,GetLastCreatedTextTag(),bj_FORCE_PLAYER[GetPlayerId(GetOwningPlayer(udg_Druid))])
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
else
endif
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+0.01*GetUnitState(u,UNIT_STATE_MAX_LIFE))
endif
set u=null
endfunction
function Trig_DruidD_Actions takes nothing returns nothing
call ForGroupBJ(udg_DruidGroup,function Trig_DruidD_Func001A)
endfunction
