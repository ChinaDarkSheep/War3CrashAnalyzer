if udg_QuestNumber==1 and UnitHasItemOfTypeBJ(udg_u,'I09Q')then
set BHelpGoblinText=true
set udg_StartQuests=4
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Монокль? Хм, сойдет. Интересно, а на какой глаз его одевают... Да как он держится!? Ух, не понимаю как это можно использовать нормально... Что? Награда? А, точно, возьми вот")
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFFFFDC00Вы прошли задание\nНаграда: Костюм путешественника и +5000 золотых")
call RemoveItem(GetItemOfTypeFromUnitBJ(udg_u,'I09Q'))
call UnitAddItemByIdSwapped('I0A1',udg_u)
call QuestGoblinGold(id,5000)
