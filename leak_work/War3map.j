call TriggerAddAction(gg_trg_TakeEnergy,function Trig_TakeEnergy_Actions)
endfunction
function FireRing_Timer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local real dmg=LoadReal(udg_hash,ht,0)
local real x=LoadReal(udg_hash,ht,1)
local real y=LoadReal(udg_hash,ht,2)
local real x1
local real y1
call GroupDamage(x,y,300.,caster,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=6
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set x1=x+140.*Cos(60.00*bj_forLoopAIndex*bj_DEGTORAD)
set y1=y+140.*Sin(60.00*bj_forLoopAIndex*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl",x,y))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
set caster=null
endfunction
