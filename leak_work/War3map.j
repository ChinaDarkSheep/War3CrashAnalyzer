function InitTrig_Swap takes nothing returns nothing
set gg_trg_Swap=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Swap,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddAction(gg_trg_Swap,function Trig_Swap_Actions)
endfunction
function Trig_GetAbilityJass_Actions takes nothing returns nothing
local unit hero=GetTriggerUnit()
local integer i=GetPlayerId(GetOwningPlayer(GetTriggerUnit()))+1
local integer ID=i
local integer drop=0
local integer talante=udg_Talante[ID]
local integer h=GetHandleId(hero)
local integer a
local real dmg
local integer ihh=ReturnTypeHeroId(GetHandleId(hero))
local integer iuh=LoadInteger(Hash,h,0)
if GetLearnedSkill()=='A0SJ' then
set udg_MoargR=true
elseif GetLearnedSkill()=='A18J' then
set udg_SpellBreaker50=true
elseif GetLearnedSkill()=='A18B' then
call EnableTrigger(gg_trg_PristTaurenE)
elseif GetLearnedSkill()=='A16C' then
call ModifyHeroStat(bj_HEROSTAT_STR,udg_Barbarion,bj_MODIFYMETHOD_ADD,4)
if GetUnitAbilityLevel(hero,'A16C')<2 then
call EnableTrigger(gg_trg_BarbarionE)
endif
elseif GetLearnedSkill()=='A0BX' then
call SetPlayerTechResearchedSwap('R05D',1,GetOwningPlayer(GetTriggerUnit()))
elseif GetLearnedSkill()=='A195' then
if GetUnitAbilityLevelSwapped('A0E3',GetTriggerUnit())==0 then
call UnitAddAbilityBJ('A0E3',GetTriggerUnit())
if udg_Talante[ID]==2 then
call SetUnitAbilityLevelSwapped('A0E3',GetTriggerUnit(),6)
endif
else
call SetUnitAbilityLevelSwapped('A0E3',GetTriggerUnit(),(GetUnitAbilityLevelSwapped('A0E3',GetTriggerUnit())+1))
endif
elseif GetLearnedSkill()=='A0BB' then
call UnitAddAbilityBJ('A12G',udg_RockDefender)
elseif GetLearnedSkill()=='A0T5' then
call UnitAddItemByIdSwapped('I04V',GetTriggerUnit())
elseif GetLearnedSkill()=='A14Z' then
call UnitAddItemByIdSwapped('I085',GetTriggerUnit())
elseif GetLearnedSkill()=='A0O9' then
call UnitAddAbilityBJ('A0QI',udg_Faceless)
elseif GetLearnedSkill()=='A052' then
call SetPlayerTechResearchedSwap('R03T',(GetPlayerTechCountSimple('R03T',GetOwningPlayer(GetTriggerUnit()))+1),GetOwningPlayer(GetTriggerUnit()))
elseif GetLearnedSkill()=='A0SI' then
set udg_MoargDLimit=2.00
call SetUnitAbilityLevelSwapped('A0SH',udg_Moarg,2)
elseif GetLearnedSkill()=='A03G' then
call SetUnitAbilityLevelSwapped('A0SB',udg_AstralDrak,2)
elseif GetLearnedSkill()=='A06E' then
call SetPlayerTechResearchedSwap('R012',GetLearnedSkillLevel(),GetOwningPlayer(GetLearningUnit()))
elseif GetLearnedSkill()=='AEar' then
call SetPlayerTechResearchedSwap('R02J',GetLearnedSkillLevel(),GetOwningPlayer(GetLearningUnit()))
