function Trig_HeroD53_var1_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local real xc=GetUnitX(caster)
local real yc=GetUnitY(caster)
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local real dmg=25+0.4*GetHeroInt(caster,true)
local group g=CreateGroup()
local unit u
local integer a
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,300.,Bool_Filter_ID)
if GetUnitAbilityLevel(caster,'A1D0')==1 then
set dmg=dmg+GetHeroInt(caster,true)
endif
call SeekMinDummys()
loop
set u=FirstOfGroup(g)
exitwhen u==null
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'h05G',xc,yc,GetUnitFacing(caster))
set a=SeekFreeDummysMin(bj_lastCreatedUnit,GetHandleId(bj_lastCreatedUnit))
set s__Dummys_dmg[sDummy[a]]=dmg
call UnitAddAbility(bj_lastCreatedUnit,'A1D5')
call IssueTargetOrder(bj_lastCreatedUnit,"magicleash",u)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',5.)
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
set caster=null
set u=null
set g=null
endfunction
