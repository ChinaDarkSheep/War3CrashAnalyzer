function Set2_Wave_2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer sec=LoadInteger(udg_hash,ht,0)+1
local real x
local real y
if sec<250 then
call SaveInteger(udg_hash,ht,0,sec)
if sec==60 then
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>8
call SetPlayerAllianceBJ(Player(8),ALLIANCE_SHARED_VISION,false,ConvertedPlayer(GetForLoopIndexA()))
call SetPlayerAllianceBJ(Player(10),ALLIANCE_SHARED_VISION,false,ConvertedPlayer(GetForLoopIndexA()))
call SetPlayerAllianceBJ(Player(11),ALLIANCE_SHARED_VISION,false,ConvertedPlayer(GetForLoopIndexA()))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
if udg_HARDSET==2 then
if udg_Mode==2 then
call DisplayTimedTextToForce(GetPlayersAll(),45.00,"|cFFC60000Надвигается опасность!|r\n\n|cFFFF5800Нападать будут -  твари недр (1200% мощности).")
else
call DisplayTimedTextToForce(GetPlayersAll(),45.00,"|cFFC60000Надвигается опасность!|r\n\n|cFFFF5800Нападать будут -  твари недр (400% мощности).")
endif
else
call DisplayTimedTextToForce(GetPlayersAll(),45.00,"|cFFC60000Надвигается опасность!|r\n\n|cFFFF5800Нападать будут -  твари недр (сложность: сложно).")
endif
set RandomSpawnX[1]=GetRectCenterX(gg_rct_A1)
set RandomSpawnY[1]=GetRectCenterY(gg_rct_A1)
set RandomSpawnX[2]=GetRectCenterX(gg_rct_Spawn23)
set RandomSpawnY[2]=GetRectCenterY(gg_rct_Spawn23)
set RandomSpawnX[3]=GetRectCenterX(gg_rct_Spawn47)
set RandomSpawnY[3]=GetRectCenterY(gg_rct_Spawn47)
set RandomSpawnX[4]=GetRectCenterX(gg_rct_Spawn16)
set RandomSpawnY[4]=GetRectCenterY(gg_rct_Spawn16)
elseif sec==70 then
call EnableTrigger(gg_trg_Tentakles)
call EnableTrigger(gg_trg_TV4)
call EnableTrigger(gg_trg_TV5)
call TriggerExecute(gg_trg_TV4)
call Effect_Del(AddSpecialEffect("Abilities\\Spells\\Human\\FlameStrike\\FlameStrikeTarget.mdl",-5630.00,13700.00),100.)
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>20
set udg_Drop=GetRandomInt(1,4)
set bj_lastCreatedUnit=CreateUnit(ForcePickRandomPlayer(udg_CreepsPlayers),'n040',RandomSpawnX[udg_Drop],RandomSpawnY[udg_Drop],bj_UNIT_FACING)
call GroupAddUnit(udg_A3,bj_lastCreatedUnit)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call ForGroup(udg_A3,function Trig_MoveAttackers_Func003A)
elseif sec==110 then
call DisplayTimedTextToForce(GetPlayersAll(),45.00,"|cFFFF5800На протяжении всей атаки в центре города будут появляться щупальца и потом появится \"Демон Недр\". Уничтожив его, вы остановите наступление врагов и появление ")
call TriggerExecute(gg_trg_TV5)
elseif sec==170 then
if HardcoreUP30==3 then
set bj_forLoopAIndexEnd=2
else
set bj_forLoopAIndexEnd=1
endif
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
if bj_forLoopAIndex==1 then
set x=-5630
set y=13700
else
set x=-6800
set y=13700
endif
set bj_lastCreatedUnit=CreateUnit(Player(11),'n03Z',x,y,bj_UNIT_FACING)
set bj_lastCreatedUnit=CreateUnit(Player(11),'h00K',x,y,bj_UNIT_FACING)
call SetUnitAnimation(bj_lastCreatedUnit,"birth")
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',8)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>8
set udg_Drop=GetRandomInt(1,4)
set bj_lastCreatedUnit=CreateUnit(ForcePickRandomPlayer(udg_CreepsPlayers),'n03I',RandomSpawnX[udg_Drop],RandomSpawnY[udg_Drop],bj_UNIT_FACING)
call GroupAddUnit(udg_A3,bj_lastCreatedUnit)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call ForGroup(udg_A3,function Trig_MoveAttackers_Func003A)
endif
else
set bj_forLoopAIndex=0
loop
exitwhen bj_forLoopAIndex>7
call SetPlayerAllianceBJ(Player(8),ALLIANCE_SHARED_VISION,true,Player(bj_forLoopAIndex))
call SetPlayerAllianceBJ(Player(10),ALLIANCE_SHARED_VISION,true,Player(bj_forLoopAIndex))
call SetPlayerAllianceBJ(Player(11),ALLIANCE_SHARED_VISION,true,Player(bj_forLoopAIndex))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call EnableTrigger(gg_trg_WinEnd)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
endfunction
