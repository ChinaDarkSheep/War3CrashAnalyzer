if(not(IsUnitType(GetEnteringUnit(),UNIT_TYPE_HERO)==true))then
return false
endif
return true
endfunction
function BunkerDE takes nothing returns nothing
if udg_DamageEventTarget==udg_FlameOrc and udg_FlameOrcD then
set udg_Drop=GetPlayerId(GetOwningPlayer(udg_FlameOrc))+1
if udg_Talante[udg_Drop]==1 then
set udg_DamageEventAmount=udg_DamageEventAmount*0.6
else
set udg_DamageEventAmount=udg_DamageEventAmount*0.7
endif
endif
endfunction
function DarkSgustokDE takes nothing returns nothing
if GetUnitTypeId(udg_DamageEventSource)=='h04M' and IsUnitInGroup(udg_DamageEventTarget,udg_DarkSgustokQ)==false then
call GroupAddUnit(udg_DarkSgustokQ,udg_DamageEventTarget)
call UnitDamageTarget(udg_Hero[GetPlayerId(GetOwningPlayer(udg_DamageEventSource))+1],udg_DamageEventTarget,LoadReal(udg_hash,GetHandleId(udg_DamageEventSource),'d'),true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
endif
endfunction
function ThingRegen takes nothing returns nothing
local real value
local real maxValue
if udg_ThingBody !=null then
set value=GetUnitState(udg_ThingBody,UNIT_STATE_LIFE)
set maxValue=GetUnitState(udg_ThingBody,UNIT_STATE_MAX_LIFE)
set value=value/maxValue
set value=(value+0.01)
call SetUnitState(udg_ThingBody,UNIT_STATE_LIFE,GetUnitState(udg_ThingBody,UNIT_STATE_MAX_LIFE)*value)
endif
endfunction
function SpellBreaker takes nothing returns nothing
if GetUnitAbilityLevel(udg_DamageEventTarget,'A153')==1 and not udg_IsDamageSpell then
set udg_Damage[3]=udg_DamageEventAmount*0.25
set udg_DamageEventAmount=udg_DamageEventAmount*0.75
call UnitDamageTarget(udg_DamageEventSource,udg_DamageEventTarget,udg_Damage[3],true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
endif
endfunction
function MinotaurE takes nothing returns nothing
set udg_Drop=GetUnitAbilityLevel(udg_DamageEventTarget,'A0YB')
if udg_Drop>=1 and udg_DamageEventAmount>20.00 then
set udg_r=I2R(udg_Drop)*3.
if udg_DamageEventAmount-udg_r>20. then
set udg_DamageEventAmount=udg_DamageEventAmount-udg_r
else
set udg_DamageEventAmount=20.
endif
endif
endfunction
function CapitanD takes nothing returns nothing
local real angle=GetUnitFacing(udg_DamageEventTarget)
local real x1=GetUnitX(udg_DamageEventTarget)
local real y1=GetUnitY(udg_DamageEventTarget)
local real x2=GetUnitX(udg_DamageEventSource)
local real y2=GetUnitY(udg_DamageEventSource)
local real Co=Cos(angle*bj_DEGTORAD)
local real Si=Sin(angle*bj_DEGTORAD)
local real scale
if udg_DamageEventTarget==udg_Captain and udg_CaptainD then
set x2=x2-x1
set y2=y2-y1
set scale=(Co*x2+Si*y2)/(SquareRoot(x2*x2+y2*y2))
if scale>0.5 then
set udg_DamageEventAmount=udg_DamageEventAmount*.75
endif
endif
endfunction
function Trig_Damage_Engine_RE_Actions takes nothing returns nothing
if GetUnitTypeId(GetEnteringUnit())=='O00W' then
call TriggerAddAction(gg_trg_Set_Damage,function BunkerDE)
elseif GetUnitTypeId(GetEnteringUnit())=='U00O' then
call TriggerAddAction(gg_trg_Set_Damage,function DarkSgustokDE)
elseif GetUnitTypeId(GetEnteringUnit())=='U02A' then
call TriggerAddAction(gg_trg_List,function ThingRegen)
elseif GetUnitTypeId(GetEnteringUnit())=='E00X' then
call TriggerAddAction(gg_trg_Set_Damage,function SpellBreaker)
elseif GetUnitTypeId(GetEnteringUnit())=='O003' then
call TriggerAddAction(gg_trg_Set_Damage,function MinotaurE)
elseif GetUnitTypeId(GetEnteringUnit())=='N05H' then
call TriggerAddAction(gg_trg_Set_Damage,function CapitanD)
endif
endfunction
