function Trig_KovenQuest4_Actions takes nothing returns nothing
local integer ID=GetPlayerId(GetOwningPlayer(GetKillingUnit()))+1
local real x
local real y
local real x1
local real y1
if udg_KQuest4[ID]>399 then
call DestroyTrigger(GetTriggeringTrigger())
else
set x=GetUnitX(udg_Hero[ID])
set y=GetUnitY(udg_Hero[ID])
set x1=GetUnitX(GetDyingUnit())-x
set y1=GetUnitY(GetDyingUnit())-y
set y=SquareRoot(x1*x1+y1*y1)
if y<=2000. then
set udg_KQuest4[ID]=udg_KQuest4[ID]+2
if GetUnitLevel(GetDyingUnit())>9 then
set udg_KQuest4[ID]=udg_KQuest4[ID]+2
endif
else
set udg_KQuest4[ID]=udg_KQuest4[ID]+1
if GetUnitLevel(GetDyingUnit())>9 then
set udg_KQuest4[ID]=udg_KQuest4[ID]+1
endif
endif
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],4.00,"Убито: "+I2S(udg_KQuest4[ID])+"/400")
endif
endfunction
