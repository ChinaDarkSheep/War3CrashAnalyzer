function Trig_E12_Action_Actions takes nothing returns nothing
local real x=GetUnitX(GetDyingUnit())
local real y=GetUnitY(GetDyingUnit())
local group g=CreateGroup()
local unit u
local real dmg
if udg_HardestLogic then
set dmg=600
else
set dmg=300
endif
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl",x,y))
set udg_Drop2=GetPlayerId(GetOwningPlayer(GetDyingUnit()))
call GroupEnumUnitsInRange(g,x,y,250,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(GetDyingUnit(),u,dmg,false,true,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
if udg_CreepsAmount==0 then
call DisableTrigger(GetTriggeringTrigger())
endif
call DestroyGroup(g)
set g=null
endfunction
