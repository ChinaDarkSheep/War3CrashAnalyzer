function Trig_KillPeon_Actions takes nothing returns nothing
if GetSpellAbilityId()=='A0IP' then
if(GetUnitTypeId(GetSpellAbilityUnit())=='h04P')or(GetUnitTypeId(GetSpellAbilityUnit())=='h02U')or(GetUnitTypeId(GetSpellAbilityUnit())=='h001')then
set udg_p=GetUnitLoc(GroupPickRandomUnit(GetUnitsOfPlayerAndTypeId(GetOwningPlayer(GetSpellAbilityUnit()),'ncop')))
else
set udg_p=GetUnitLoc(GetSpellAbilityUnit())
endif
