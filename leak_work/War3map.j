if udg_SMission[1]==udg_SMission[2]then
call DisplayTimedTextToForce(GetPlayersAll(),30.00,"|cFFA000FFСектанты Нер`Зула выполнили свою Великую миссию. Теперь Альянс принимает их веру и становится сильнее!")
call SetPlayerColorBJ(Player(9),ConvertPlayerColor(12),true)
set udg_HeroGold[ID]=udg_HeroGold[ID]+0.40
set udg_HeroGoldMax[ID]=udg_HeroGoldMax[ID]+0.40
call DestroyTrigger(GetTriggeringTrigger())
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveInteger(udg_hash,ht,0,ID)
call TimerStart(t,10.,true,function SMission3_Spawn)
endif
set t=null
endfunction
