function RifleHasItem takes unit u,integer a,integer b,integer c returns boolean
local integer i=0
local integer it
loop
exitwhen i>5
set it=GetItemTypeId(UnitItemInSlot(u,i))
if(a !=0 and it==a)or(b !=0 and it==b)or(c !=0 and it==c)then
return true
endif
set i=i+1
endloop
return false
endfunction
