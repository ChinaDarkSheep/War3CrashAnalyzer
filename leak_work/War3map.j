if udg_Talante[ID]==2 then
if YesCD(GetSpellAbilityId())then
if not spell then
set a=LoadInteger(udg_hash,h,StringHash("Маг арт стак"))
set b=LoadInteger(udg_hash,h,StringHash("Маг арт лимит"))
if b==a then
call SetHeroInt(caster,GetHeroInt(caster,false)+1,true)
call SaveInteger(udg_hash,h,StringHash("Маг арт лимит"),b+1)
call SaveInteger(udg_hash,h,StringHash("Маг арт стак"),0)
else
