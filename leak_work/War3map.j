function Trig_MishkaAndDeItem_Conditions takes nothing returns boolean
if IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)then
return false
endif
return true
endfunction
function MishkaAndDeItem_Mishka takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit bear=LoadUnitHandle(udg_hash,ht,0)
local integer id=GetPlayerId(GetOwningPlayer(bear))
local integer iuu=LoadInteger(Hash,GetHandleId(bear),0)
set udg_Mishka=udg_Mishka+1
if udg_Mishka==20 then
call IncUnitAbilityLevel(bear,'A0Y2')
else
endif
if udg_Mishka<31 then
call RemoveItem(GetItemOfTypeFromUnitBJ(bear,GetItemTypeId(GetManipulatedItem())))
call UnitRemoveAbility(bear,'A0CR')
call UnitAddAbility(bear,'A007')
if udg_Mishka==15 then
call UnitAddAbility(bear,'A13N')
call SetPlayerTechResearchedSwap('R055',1,GetOwningPlayer(bear))
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Достигнуто 15 усиление юнита \"Голодный мишка\", он получает физический сплеш")
endif
if udg_Mishka==30 then
call GroupAddUnit(udg_UnordinaryUnit,bear)
if iuu==0 then
set iuu=SeekFreeUnit(GetHandleId(bear))
endif
set s__Units_Arm[sUnit[iuu]]=s__Units_Arm[sUnit[iuu]]+60
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Достигнут лимит усиление юнита \"Голодный мишка\", он получает дополнительные бонусы и больше не может есть \"Сочное Мясо\"")
call SetPlayerTechResearchedSwap('R055',2,GetOwningPlayer(bear))
else
endif
call UnitAddItemByIdSwapped('I08L',bear)
call UnitAddItemByIdSwapped('I08L',bear)
call UnitAddItemByIdSwapped('I08L',bear)
call UnitAddItemByIdSwapped('I08L',bear)
call UnitAddItemByIdSwapped('I085',bear)
call UnitAddItemByIdSwapped('I085',bear)
call UnitRemoveAbility(bear,'A007')
call UnitAddAbility(bear,'A0CR')
else
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Достигнут лимит усилений юнита \"Голодный мишка\"!")
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set t=null
set bear=null
endfunction
function Trig_MishkaAndDeItem_Actions takes nothing returns nothing
local integer a
local timer t
local integer ht
if GetUnitTypeId(GetManipulatingUnit())=='ncop' then
call UnitRemoveItemSwapped(GetManipulatedItem(),GetManipulatingUnit())
call DisableTrigger(GetTriggeringTrigger())
call UnitAddItemSwapped(GetManipulatedItem(),GetManipulatingUnit())
call EnableTrigger(GetTriggeringTrigger())
else
endif
if GetUnitTypeId(GetManipulatingUnit())=='n04B' then
if GetItemTypeId(GetManipulatedItem())=='I07U' then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,GetManipulatingUnit())
call TimerStart(t,0.1,false,function MishkaAndDeItem_Mishka)
else
endif
else
endif
set t=null
endfunction
function InitTrig_MishkaAndDeItem takes nothing returns nothing
set gg_trg_MishkaAndDeItem=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_MishkaAndDeItem,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddCondition(gg_trg_MishkaAndDeItem,Condition(function Trig_MishkaAndDeItem_Conditions))
call TriggerAddAction(gg_trg_MishkaAndDeItem,function Trig_MishkaAndDeItem_Actions)
endfunction
