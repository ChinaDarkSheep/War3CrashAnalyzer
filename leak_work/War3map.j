function Trig_CDAttacks_Func003C takes nothing returns boolean
if(not(GetUnitTypeId(udg_u)=='N05L'))then
return false
endif
if(not(IsUnitInGroup(udg_u,udg_CheckBossSkillsGroup)==false))then
return false
endif
return true
endfunction
function Trig_CDAttacks_Func004C takes nothing returns boolean
if(not(GetUnitTypeId(udg_u)=='N070'))then
return false
endif
if(not(GetUnitLifePercent(udg_u)<=35.00))then
return false
endif
if(not(IsUnitInGroup(udg_u,udg_CheckBossSkillsGroup)==false))then
return false
endif
return true
endfunction
function Trig_CDAttacks_Func005C takes nothing returns boolean
if(not(GetUnitTypeId(udg_u)=='U013'))then
return false
endif
if(not(GetUnitLifePercent(udg_u)<=60.00))then
return false
endif
if(not(IsUnitInGroup(udg_u,udg_CheckBossSkillsGroup)==false))then
return false
endif
return true
endfunction
function Trig_CDAttacks_Func006C takes nothing returns boolean
if(not(GetUnitTypeId(udg_u)=='U01U'))then
return false
endif
if(not(IsUnitInGroup(udg_u,udg_CheckBossSkillsGroup)==false))then
return false
endif
return true
endfunction
function Trig_CDAttacks_Actions takes nothing returns nothing
local unit u
set udg_u=GetAttacker()
if(Trig_CDAttacks_Func003C())then
set udg_p=GetUnitLoc(udg_u)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=4
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set udg_p2=PolarProjectionBJ(udg_p,200.00,(GetUnitFacing(udg_u)+I2R((GetForLoopIndexA()*90))))
call CreateNUnitsAtLoc(1,'h04F',ForcePickRandomPlayer(udg_CreepsPlayers),udg_p2,bj_UNIT_FACING)
call GroupAddUnitSimple(GetLastCreatedUnit(),udg_A1)
call AddSpecialEffectLocBJ(udg_p2,"Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call RemoveLocation(udg_p2)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call RemoveLocation(udg_p)
call GroupAddUnitSimple(udg_u,udg_CheckBossSkillsGroup)
set u=udg_u
call TriggerSleepAction(14.00)
set udg_u=u
call GroupRemoveUnitSimple(udg_u,udg_CheckBossSkillsGroup)
else
endif
if(Trig_CDAttacks_Func004C())then
call GroupAddUnitSimple(udg_u,udg_CheckBossSkillsGroup)
call SetUnitVertexColor(udg_u,255,30,30,255)
call AddSpecialEffectTargetUnitBJ("origin",udg_u,"Abilities\\Spells\\NightElf\\BattleRoar\\RoarCaster.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call UnitAddAbility(udg_u,'A0QE')
call SetUnitAbilityLevel(udg_u,'A0QE',3)
else
endif
if(Trig_CDAttacks_Func005C())then
set udg_p=GetUnitLoc(udg_u)
set udg_p2=PolarProjectionBJ(udg_p,GetRandomReal(120.00,400.00),GetRandomDirectionDeg())
call CreateNUnitsAtLoc(1,'h03K',Player(PLAYER_NEUTRAL_AGGRESSIVE),udg_p2,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(2.50,'BTLF',GetLastCreatedUnit())
call RemoveLocation(udg_p2)
call RemoveLocation(udg_p)
else
endif
if(Trig_CDAttacks_Func006C())then
set udg_p=GetUnitLoc(udg_u)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=5
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set udg_p2=PolarProjectionBJ(udg_p,300.00,(I2R(GetForLoopIndexA())*72.00))
call CreateNUnitsAtLoc(1,'h03K',Player(PLAYER_NEUTRAL_AGGRESSIVE),udg_p2,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(2.25,'BTLF',GetLastCreatedUnit())
call RemoveLocation(udg_p2)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=10
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set udg_p2=PolarProjectionBJ(udg_p,550.00,(I2R(GetForLoopIndexA())*36.00))
call CreateNUnitsAtLoc(1,'h03K',Player(PLAYER_NEUTRAL_AGGRESSIVE),udg_p2,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(2.25,'BTLF',GetLastCreatedUnit())
call RemoveLocation(udg_p2)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call RemoveLocation(udg_p)
call GroupAddUnitSimple(udg_u,udg_CheckBossSkillsGroup)
set u=udg_u
call TriggerSleepAction(11.00)
set udg_u=u
call GroupRemoveUnitSimple(udg_u,udg_CheckBossSkillsGroup)
else
endif
set u=null
endfunction
