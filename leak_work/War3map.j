function Trig_WitchOpt_Actions takes nothing returns nothing
local integer random
set udg_u=GetDyingUnit()
if IsUnitInGroup(udg_u,udg_WitchSkillQ[1])then
call GroupRemoveUnit(udg_WitchSkillQ[1],udg_u)
endif
if IsUnitInGroup(udg_u,udg_WitchSkillQ[2])then
call GroupRemoveUnit(udg_WitchSkillQ[2],udg_u)
endif
if IsUnitInGroup(udg_u,udg_WitchSkillQ[3])then
call GroupRemoveUnit(udg_WitchSkillQ[3],udg_u)
endif
if GetKillingUnit()==udg_Witch then
set udg_WitchDStucks=udg_WitchDStucks+1
if udg_Setstart then
set random=20
else
set random=10
endif
if udg_WitchDStucks==random then
set udg_WitchDStucks=0
set udg_WitchDBonus=udg_WitchDBonus+0.01
if GetUnitAbilityLevelSwapped('A0GX',udg_Witch)==1 then
set udg_WitchD=udg_WitchD+0.01
else
endif
call CreateTextTagUnitBJ("|cFF64A92B+1%|r",udg_Witch,0,13.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call ShowTextTagForceBJ(false,udg_TEXT,GetPlayersAll())
call ShowTextTagForceBJ(true,udg_TEXT,bj_FORCE_PLAYER[GetPlayerId(GetOwningPlayer(udg_Witch))])
call SetTextTagVelocityBJ(udg_TEXT,75.00,90.00)
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,4.00)
call SetTextTagFadepointBJ(udg_TEXT,3.00)
else
endif
else
endif
endfunction
