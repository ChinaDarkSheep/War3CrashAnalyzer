function Trig_PeriodicalAttacks_Actions takes nothing returns nothing
call StartTimerBJ(udg_TimerWave,false,GetRandomReal(55.00,80.00))
set udg_CountAttackers=(udg_CountAttackers+1)
if(Trig_PeriodicalAttacks_Func003C())then
set udg_Drop=GetRandomInt(1,3)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=(6+udg_CountAttackers)
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call CreateNUnitsAtLoc(1,udg_AttackersType[GetRandomInt(1,udg_CountAttackers)],ForcePickRandomPlayer(udg_CreepsPlayers),udg_EPPoints[udg_Drop],bj_UNIT_FACING)
call GroupAddUnitSimple(GetLastCreatedUnit(),udg_A1)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
else
if(Trig_PeriodicalAttacks_Func003Func003C())then
set udg_Drop=GetRandomInt(4,5)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=(6+udg_CountAttackers)
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call CreateNUnitsAtLoc(1,udg_AttackersType[GetRandomInt(1,udg_CountAttackers)],ForcePickRandomPlayer(udg_CreepsPlayers),udg_EPPoints[udg_Drop],bj_UNIT_FACING)
call GroupAddUnitSimple(GetLastCreatedUnit(),udg_A2)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
else
set udg_Drop=GetRandomInt(6,8)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=(6+udg_CountAttackers)
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call CreateNUnitsAtLoc(1,udg_AttackersType[GetRandomInt(1,udg_CountAttackers)],ForcePickRandomPlayer(udg_CreepsPlayers),udg_EPPoints[udg_Drop],bj_UNIT_FACING)
call GroupAddUnitSimple(GetLastCreatedUnit(),udg_A3)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
endif
call ForGroupBJ(udg_A1,function Trig_PeriodicalAttacks_Func004A)
call ForGroupBJ(udg_A2,function Trig_PeriodicalAttacks_Func005A)
call ForGroupBJ(udg_A3,function Trig_PeriodicalAttacks_Func006A)
set udg_Drop=GetRandomInt(1,2)
if(Trig_PeriodicalAttacks_Func008C())then
set udg_AttackersBoolean=true
call ConditionalTriggerExecute(gg_trg_PeriodicalAttacks)
else
set udg_AttackersBoolean=false
endif
set udg_Drop=GetRandomInt(1,10)
if(Trig_PeriodicalAttacks_Func010C())then
set udg_CountAttackers=(udg_CountAttackers+1)
else
endif
endfunction
