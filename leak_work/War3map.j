function Trig_DropItems_Actions takes nothing returns nothing
local item Item=GetManipulatedItem()
local unit u=GetManipulatingUnit()
local integer ID=GetPlayerId(GetOwningPlayer(u))+1
local integer h=GetHandleId(u)
local integer name=GetItemTypeId(Item)
local integer a
if IsUnitType(u,UNIT_TYPE_HERO)then
if name=='I064' then
set udg_MatrixDamage[ID]=udg_MatrixDamage[ID]-250
if udg_MatrixDamage[ID]<1 then
call GroupRemoveUnitSimple(u,udg_MatrixGroup)
endif
endif
if name=='I08W' then
set udg_MatrixDamage[ID]=(udg_MatrixDamage[ID]-1)
if udg_MatrixDamage[ID]<1 then
call GroupRemoveUnitSimple(u,udg_MatrixGroup)
else
endif
endif
if name=='I062' then
set udg_MeshochekCheck[ID]=(udg_MeshochekCheck[ID]-1)
else
endif
if name=='I0BU' then
call GroupRemoveUnitSimple(u,udg_RedTalismanGroup)
else
endif
if name=='I07M' then
call GroupRemoveUnitSimple(u,udg_DiabolicBoots)
else
endif
if name=='I0AX' then
call GroupRemoveUnitSimple(u,udg_DarkEyeGroup)
else
endif
if name=='I09L' or name=='I0AT' or name=='I0AU' then
set udg_ChampionSpearUnit=null
else
endif
if name=='I07J' then
call GroupRemoveUnitSimple(u,udg_DeathNecklaceGroup)
else
endif
if name=='I09J' and GetManipulatedItem()!=udg_CheckItem then
set a=LoadInteger(udg_hash,h,5)
if s__Heroes_Type[sHero[a]]!=1 and s__Heroes_Type[sHero[a]]!=4 then
call RemoveItem(GetItemOfTypeFromUnitBJ(u,'I09I'))
endif
endif
if GetItemTypeId(GetManipulatedItem())=='I09S' and GetManipulatedItem()!=udg_CheckItem then
set a=LoadInteger(udg_hash,h,5)
if s__Heroes_Type[sHero[a]]!=1 and s__Heroes_Type[sHero[a]]!=4 then
call RemoveItem(GetItemOfTypeFromUnitBJ(u,'I09I'))
call RemoveItem(GetItemOfTypeFromUnitBJ(u,'I09I'))
call RemoveItem(GetItemOfTypeFromUnitBJ(u,'I09I'))
endif
endif
if GetItemTypeId(GetManipulatedItem())=='I078' then
call GroupRemoveUnitSimple(u,udg_EssenceOfLifeGroup)
else
endif
if GetItemTypeId(GetManipulatedItem())=='I09V' and GetManipulatedItem()!=udg_CheckItem then
call GroupRemoveUnitSimple(u,udg_AnciestSealGroup)
set a=LoadInteger(udg_hash,h,5)
if s__Heroes_Type[sHero[a]]!=1 and s__Heroes_Type[sHero[a]]!=4 then
call RemoveItem(GetItemOfTypeFromUnitBJ(u,'I09I'))
else
endif
else
endif
if IsUnitInGroup(u,udg_ShamanItem)==true and UnitHasItemOfTypeBJ(u,'I07F')==true then
call UnitRemoveAbilityBJ('A0W6',u)
call GroupRemoveUnitSimple(u,udg_ShamanItem)
call UnitRemoveAbilityBJ('A0DK',u)
else
endif
if name=='I0A7' or name=='I0A8' or name=='I0A9' then
set udg_AdriaHand=null
else
endif
endif
set Item=null
set u=null
endfunction
