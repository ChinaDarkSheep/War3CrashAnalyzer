function Trig_Gold_Conditions takes nothing returns boolean
if not IsUnitIllusion(GetDyingUnit())then
return true
else
return false
endif
endfunction
function Trig_Exp_Func002Func006A takes nothing returns nothing
set udg_Drop=GetPlayerId(GetOwningPlayer(GetEnumUnit()))+1
if udg_HeroExp[udg_Drop]>0. then
set udg_Drop2=R2I(1.8+7.2*GetUnitLevel(GetDyingUnit())*udg_HeroExp[udg_Drop])
call AddHeroXPSwapped(udg_Drop2,GetEnumUnit(),true)
else
endif
endfunction
function Trig_Gold_Actions takes nothing returns nothing
local unit death=GetDyingUnit()
local real r
local real z
local integer a
local integer b
local integer c
local real gold
local integer ID=GetPlayerId(GetOwningPlayer(GetKillingUnit()))+1
local integer id
local integer lvl=GetUnitLevel(death)
local real x
local real y
local real x1
local real y1
local integer hh
if IsUnitEnemy(death,GetOwningPlayer(GetKillingUnit()))and GetPlayerController(GetOwningPlayer(death))!=MAP_CONTROL_USER and GetUnitAbilityLevel(death,'Avul')!=1 and GetOwningPlayer(GetKillingUnit())!=Player(9)and GetOwningPlayer(GetKillingUnit())!=Player(8)and GetOwningPlayer(GetKillingUnit())!=Player(10)and GetOwningPlayer(GetKillingUnit())!=Player(8)then
if GetOwningPlayer(GetKillingUnit())==Player(0)then
set udg_RedKill=true
else
set udg_RedKill=false
endif
if ID>1 or udg_RedKill then
if udg_Hero[ID]!=null then
set udg_Drop2=R2I(1.2+4.8*lvl*udg_HeroExp[ID])
call AddHeroXPSwapped(udg_Drop2,udg_Hero[ID],true)
endif
call ForGroup(udg_AllHeroes,function Trig_Exp_Func002Func006A)
if udg_HeroGold[ID]>0 then
set hh=GetHandleId(udg_Hero[ID])
set id=LoadInteger(udg_hash,hh,StringHash("StaffGold"))
if GetKillingUnit()==udg_Hero[ID]then
set x=(3.+.5*lvl)*LoadInteger(udg_hash,hh,StringHash("RenDuk"))
else
set x=((3.+.5*lvl)*LoadInteger(udg_hash,hh,StringHash("RenDuk")))*0.6
endif
set gold=1.2*lvl+3.5+lvl*(lvl+.8)+x+3.*LoadInteger(udg_hash,hh,StringHash("GoldSword"))
if GetPlayerTechCount(Player(ID-1),'R02B',true)>12 then
set gold=gold+1
endif
if HardcoreBuff10==2 then
set gold=1.12*gold+3
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='mcou' then
set gold=gold+3+0.75*lvl
set y=2.
else
set y=1.
endif
if not(GetOwningPlayer(death)==Player(PLAYER_NEUTRAL_AGGRESSIVE))then
set gold=.85*gold
elseif(IsUnitType(death,UNIT_TYPE_HERO)or(lvl>=15 and ModuloInteger(lvl,5)==0))then
if HardcoreBuff10==1 then
set y=y+1.5
endif
set gold=y*gold
endif
if IsUnitInGroup(death,udg_behelit)then
if lvl<11 then
set gold=gold*1.6+10
else
set gold=gold*1.3+5
endif
call GroupRemoveUnit(udg_behelit,death)
endif
if GetInventoryIndexOfItemTypeBJ(udg_Hero[id],'I069')>0 then
set gold=gold*(GoldAvg[ID]+0.3*AllGold[ID])
else
set gold=gold*GoldAvg[ID]
endif
if GetUnitAbilityLevel(death,'A0G6')==1 and(udg_Time[2]>=20 or udg_Time[3]>=1)then
set gold=20+1.5*gold
endif
if GetUnitAbilityLevel(GetKillingUnit(),'A0G6')==1 then
if GetRandomInt(1,10)>=4 then
set gold=2*gold
endif
endif
if udg_Setstart then
set gold=0.25*gold
endif
if IsUnitInGroup(death,udg_CrowW)then
set gold=1.75*gold
call GroupRemoveUnitSimple(death,udg_CrowW)
endif
set x=GetUnitX(death)
set y=GetUnitY(death)
set x1=GetUnitX(udg_Hero[ID])
set y1=GetUnitY(udg_Hero[ID])
set x1=x1-x
set y1=y1-y
set r=SquareRoot(x1*x1+y1*y1)
if GetUnitTypeId(GetKillingUnit())=='n04B' then
if r>=2000. then
set gold=0.5*gold
endif
endif
if r>=4000. then
set gold=0.85*gold
endif
if GetUnitAbilityLevel(death,'A1DX')==1 then
set gold=gold/3
endif
if UnitAlive(udg_Hero[id])and GetInventoryIndexOfItemTypeBJ(udg_Hero[id],'I0E9')>0 then
set x1=GetUnitX(udg_Hero[id])
set y1=GetUnitY(udg_Hero[id])
set x1=x1-x
set y1=y1-y
set z=SquareRoot(x1*x1+y1*y1)
if r<=2000. and z<=2000. then
if GetUnitAbilityLevel(death,'A0UW')>0 then
set a=R2I(0.3*gold)
else
set a=R2I(0.2*gold)
endif
if a<0 then
set a=1
endif
set a=R2I(a*(.9+0.1*GoldAvg[id]))
call SetPlayerStateBJ(Player(id-1),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id-1),PLAYER_STATE_RESOURCE_GOLD)+a)
set GoldNT[id]=GoldNT[id]+a
call CreateTextTagUnitBJ(("|cFFFFDC00+"+I2S(a)),death,0,10.00,100,100,100,0)
if GetLocalPlayer()==Player(id-1)then
call SetTextTagVisibility(bj_lastCreatedTextTag,true)
else
call SetTextTagVisibility(bj_lastCreatedTextTag,false)
endif
call SetTextTagVelocityBJ(bj_lastCreatedTextTag,75.00,90.00)
call SetTextTagSuspendedBJ(bj_lastCreatedTextTag,false)
call SetTextTagPermanentBJ(bj_lastCreatedTextTag,false)
call SetTextTagLifespanBJ(bj_lastCreatedTextTag,3.00)
call SetTextTagFadepointBJ(bj_lastCreatedTextTag,2.00)
endif
endif
set a=R2I(gold)
call SetPlayerStateBJ(Player(ID-1),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(ID-1),PLAYER_STATE_RESOURCE_GOLD)+a)
set GoldNT[ID]=GoldNT[ID]+a
call CreateTextTagUnitBJ(("|cFFFFDC00+"+I2S(a)),death,0,10.00,100,100,100,0)
if GetLocalPlayer()==Player(ID-1)then
call SetTextTagVisibility(bj_lastCreatedTextTag,true)
else
call SetTextTagVisibility(bj_lastCreatedTextTag,false)
endif
call SetTextTagVelocityBJ(bj_lastCreatedTextTag,75.00,90.00)
call SetTextTagSuspendedBJ(bj_lastCreatedTextTag,false)
call SetTextTagPermanentBJ(bj_lastCreatedTextTag,false)
call SetTextTagLifespanBJ(bj_lastCreatedTextTag,3.00)
call SetTextTagFadepointBJ(bj_lastCreatedTextTag,2.00)
set udg_RedKill=false
endif
if GetOwningPlayer(death)==Player(PLAYER_NEUTRAL_AGGRESSIVE)then
set x=GetRandomReal(GetRectMinX(gg_rct_StartPlace),GetRectMaxX(gg_rct_StartPlace))
set y=GetRandomReal(GetRectMinY(gg_rct_StartPlace),GetRectMaxY(gg_rct_StartPlace))
if udg_Time[2]<30 and udg_Time[3]==0 then
set r=1+lvl
if(lvl>=15 and ModuloInteger(lvl,5)==0)then
set r=4*r
endif
if udg_Time[2]>=5 and udg_TrophyNeed1[100]>0 then
set udg_TrophyNeed1[ID]=udg_TrophyNeed1[ID]+r
if udg_TrophyNeed1[ID]>=300 then
set bj_lastCreatedItem=CreateItem('ratc',x,y)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl",GetItemX(bj_lastCreatedItem),GetItemY(bj_lastCreatedItem))
call DestroyEffect(bj_lastCreatedEffect)
set a=0
loop
exitwhen a==8
if a==ID-1 then
call DisplayTextToForce(bj_FORCE_PLAYER[a],"|cffffcc00Вы получили "+GetItemName(bj_lastCreatedItem)+"|r")
else
call DisplayTextToForce(bj_FORCE_PLAYER[a],"|cffffcc00Игрок "+GetPlayerName(Player(ID-1))+" получил "+GetItemName(bj_lastCreatedItem)+"|r")
endif
set a=a+1
endloop
set udg_TrophyNeed1[ID]=-100
set udg_TrophyNeed1[100]=udg_TrophyNeed1[100]-1
endif
endif
if udg_Time[2]>=10 and udg_TrophyNeed2[100]>0 then
set udg_TrophyNeed2[ID]=udg_TrophyNeed2[ID]+r
if udg_TrophyNeed2[ID]>=600 then
set bj_lastCreatedItem=CreateItem('rat6',x,y)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl",GetItemX(bj_lastCreatedItem),GetItemY(bj_lastCreatedItem))
call DestroyEffect(bj_lastCreatedEffect)
set a=0
loop
exitwhen a==8
if a==ID-1 then
call DisplayTextToForce(bj_FORCE_PLAYER[a],"|cffffcc00Вы получили "+GetItemName(bj_lastCreatedItem)+"|r")
else
call DisplayTextToForce(bj_FORCE_PLAYER[a],"|cffffcc00Игрок "+GetPlayerName(Player(ID-1))+" получил "+GetItemName(bj_lastCreatedItem)+"|r")
endif
set a=a+1
endloop
set udg_TrophyNeed2[ID]=-250
set udg_TrophyNeed2[100]=udg_TrophyNeed2[100]-1
endif
endif
if udg_Time[2]>=15 and udg_TrophyNeed3[100]>0 then
set udg_TrophyNeed3[ID]=udg_TrophyNeed3[ID]+r
if udg_TrophyNeed3[ID]>=1500 then
set bj_lastCreatedItem=CreateItem('rat9',x,y)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl",GetItemX(bj_lastCreatedItem),GetItemY(bj_lastCreatedItem))
call DestroyEffect(bj_lastCreatedEffect)
set a=0
loop
exitwhen a==8
if a==ID-1 then
call DisplayTextToForce(bj_FORCE_PLAYER[a],"|cffffcc00Вы получили "+GetItemName(bj_lastCreatedItem)+"|r")
else
call DisplayTextToForce(bj_FORCE_PLAYER[a],"|cffffcc00Игрок "+GetPlayerName(Player(ID-1))+" получил "+GetItemName(bj_lastCreatedItem)+"|r")
endif
set a=a+1
endloop
set udg_TrophyNeed3[ID]=-750
set udg_TrophyNeed3[100]=udg_TrophyNeed3[100]-1
endif
endif
if GetUnitTypeId(death)=='even' or GetUnitTypeId(death)=='espv' or GetUnitTypeId(death)=='echm' then
if GetUnitTypeId(death)=='echm' then
set starkills=starkills+10
set a=15
elseif GetUnitTypeId(death)=='espv' then
set starkills=starkills+2
set a=2
else
set starkills=starkills+1
set a=1
endif
set x=GetUnitX(death)
set y=GetUnitY(death)
if IsTerrainPathable(x,y,PATHING_TYPE_WALKABILITY)then
set x=9920+GetRandomInt(-100,100)
set y=22450+GetRandomInt(-100,100)
endif
if starkills>120 then
call SPawnStackItem('dthb',a*6,x,y)
else
call SPawnStackItem('dthb',R2I(a*(1+starkills/30)),x,y)
endif
endif
endif
endif
set a=lvl
if lvl>=15 and ModuloInteger(lvl,5)==0 then
set a=4*a
endif
call F_Looting(udg_Hero[ID],a,300,GetUnitX(death),GetUnitY(death))
endif
endif
set death=null
endfunction
