function QuestNew_ResetTimerQuest takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer id=LoadInteger(udg_hash,ht,0)
local timerdialog td=LoadTimerDialogHandle(udg_hash,ht,10)
set s__PlayerQuest[id]=s__PlayerQuest[id]-1
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Вы можете выбрать новое задание|r")
call DestroyTimerDialog(td)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
set td=null
endfunction
function Quest_New_TimerDialog takes nothing returns nothing
local timer t=GetExpiredTimer()
call PauseTimer(t)
call DestroyTimer(t)
set t=null
endfunction
function Quest_New_Reward takes integer id,integer ht returns nothing
local integer sec=LoadInteger(udg_hash,ht,1)
local integer gold=LoadInteger(udg_hash,ht,2)
local integer lvl=LoadInteger(udg_hash,ht,'l')
local integer reward=LoadInteger(udg_hash,ht,'r')
local integer b
local integer a
local unit hero=udg_Hero[id+1]
local integer h=GetHandleId(hero)
local integer typeQ=LoadInteger(udg_hash,ht,'t')
local timer t=CreateTimer()
local string text
local item it
local real r
call SaveInteger(udg_hash,GetHandleId(t),0,id)
set bj_lastCreatedTimerDialog=CreateTimerDialogBJ(t,"Новое задание гильдии")
call SaveTimerDialogHandle(udg_hash,GetHandleId(t),10,bj_lastCreatedTimerDialog)
call TimerDialogDisplay(bj_lastCreatedTimerDialog,false)
call TimerDialogDisplayForPlayerBJ(true,bj_lastCreatedTimerDialog,Player(id))
call TimerStart(t,75.,false,function QuestNew_ResetTimerQuest)
if typeQ==3 then
set a=LoadInteger(udg_hash,ht,'p')
set bj_forLoopAIndex=0
loop
exitwhen bj_forLoopAIndex>7
if bj_forLoopAIndex !=id then
set r=a*(0.75+0.25*GoldAvg[bj_forLoopAIndex+1])
set r=r*AllGold[bj_forLoopAIndex+1]
set b=R2I(r)
set GoldNT[bj_forLoopAIndex+1]=GoldNT[bj_forLoopAIndex+1]+b
call DisplayTextToForce(bj_FORCE_PLAYER[bj_forLoopAIndex],"|cffffcc00задание игрока"+GetPlayerName(Player(id))+" успешно выполнено|r")
call DisplayTextToForce(bj_FORCE_PLAYER[bj_forLoopAIndex],"|cffffcc00Награда"+I2S(b)+" ед. золота|r")
call SetPlayerStateBJ(Player(bj_forLoopAIndex),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(bj_forLoopAIndex),PLAYER_STATE_RESOURCE_GOLD)+b)
endif
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
else
set a=LoadInteger(udg_hash,ht,2)
endif
set r=a*(0.75+0.25*GoldAvg[id+1])
set r=r*AllGold[id+1]
set gold=R2I(r)
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Задание гильдии выполнено!|r")
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Получено "+I2S(gold)+" ед. золота!|r")
if reward==0 then
if hero==null then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00У вас нет героя!|r")
else
if lvl==1 then
set a=3
set b=3
elseif lvl==2 then
set a=6
set b=6
elseif lvl==3 then
set a=9
set b=9
elseif lvl==4 then
set a=16
set b=16
endif
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Дополнительно получено+"+I2S(a)+" all stat и "+I2S(b)+" main stat|r")
call SetHeroStr(hero,GetHeroStr(hero,false)+a,true)
call SetHeroAgi(hero,GetHeroAgi(hero,false)+a,true)
call SetHeroInt(hero,GetHeroInt(hero,false)+a,true)
if LoadStr(udg_hash,h,2)=="Str" then
call SetHeroStr(hero,GetHeroStr(hero,false)+b,true)
else
if LoadStr(udg_hash,h,2)=="Agi" then
call SetHeroAgi(hero,GetHeroAgi(hero,false)+b,true)
else
call SetHeroInt(hero,GetHeroInt(hero,false)+b,true)
endif
endif
endif
elseif reward==1 then
if lvl==4 then
set text="|cffffcc00Дополнительно получено 1 чистейщий и 1 ограненный на выбор|r"
set it=CreateItem('schl',GetUnitX(udg_Circle[id+1]),GetUnitY(udg_Circle[id+1]))
call SaveInteger(udg_hash,GetHandleId(it),'l',2)
call SaveInteger(udg_hash,GetHandleId(it),StringHash("QTRew"),1)
call SaveBoolean(udg_hash,GetHandleId(it),StringHash("Original"),true)
call UnitAddItem(udg_Circle[id+1],it)
elseif lvl==3 then
set text="|cffffcc00Дополнительно получено 1 полированный самоцвет на выбор|r"
elseif lvl==2 then
set text="|cffffcc00Дополнительно получено 1 ограненный самоцвет на выбор|r"
elseif lvl==1 then
set text="|cffffcc00Дополнительно получено 1 неочищенный самоцвет на выбор|r"
endif
call DisplayTextToForce(bj_FORCE_PLAYER[id],text)
set it=CreateItem('schl',GetUnitX(udg_Circle[id+1]),GetUnitY(udg_Circle[id+1]))
call SaveBoolean(udg_hash,GetHandleId(it),StringHash("Original"),true)
call SaveInteger(udg_hash,GetHandleId(it),StringHash("QTRew"),1)
call SaveInteger(udg_hash,GetHandleId(it),'l',lvl)
call UnitAddItem(udg_Circle[id+1],it)
elseif reward==2 then
set a=0
if lvl==1 then
set a=275
elseif lvl==2 then
set a=700
elseif lvl==3 then
set a=1400
elseif lvl==4 then
set a=2500
endif
set r=a*(0.75+0.25*GoldAvg[id+1])
set r=r*AllGold[id+1]
set a=R2I(r)
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Дополнительно получено "+I2S(a)+" ед. золота|r")
set gold=gold+a
elseif reward==3 then
set udg_HeroGoldMax[id+1]=udg_HeroGoldMax[id+1]+s__QuestRewGoldPer[lvl-1]
set udg_HeroGold[id+1]=udg_HeroGold[id+1]+s__QuestRewGoldPer[lvl-1]
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Вы получаете +"+R2S(100*s__QuestRewGoldPer[lvl-1])+"% больше золота и +"+R2S(100*s__QuestRewGoldPer[lvl-1])+"% макс. больше золота (+)|r")
set gold=gold+a
elseif reward==4 then
set udg_Looting[id+1]=udg_Looting[id+1]+s__QuestRewLooting[lvl-1]
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Вы получаете +"+R2S(100*s__QuestRewLooting[lvl-1])+" к шансу лутинга|r")
elseif reward==5 then
set it=CreateItem('schl',GetUnitX(udg_Circle[id+1]),GetUnitY(udg_Circle[id+1]))
call SaveInteger(udg_hash,GetHandleId(it),'l',lvl)
call SaveInteger(udg_hash,GetHandleId(it),StringHash("QTRew"),2)
call SaveBoolean(udg_hash,GetHandleId(it),StringHash("Original"),true)
call UnitAddItem(udg_Circle[id+1],it)
call SaveStr(udg_hash,h,'t',"1 из секретных предметов на выбор")
elseif reward==6 then
if lvl==4 then
set a=ChooseRandomItem(3)
elseif lvl==3 then
set a=ChooseRandomItem(2)
endif
set bj_lastCreatedItem=CreateItem(a,GetUnitX(udg_Circle[id+1]),GetUnitY(udg_Circle[id+1]))
call UnitAddItem(udg_Circle[id+1],bj_lastCreatedItem)
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Получен предмет"+GetItemName(bj_lastCreatedItem))
endif
set GoldNT[id+1]=GoldNT[id+1]+gold
call SetPlayerStateBJ(Player(id),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)+gold)
set hero=null
set t=null
set it=null
set text=""
endfunction
function QuestNew_ResetOrderId takes integer i returns item
local integer name=0
local integer a=1
local integer b=1
local integer level=1
local integer h
local integer phase
if CommandPhase==0 then
if udg_Time[2]<5. then
set phase=1
elseif udg_Time[2]<10. then
set phase=2
elseif udg_Time[2]<15. then
set phase=3
elseif udg_Time[2]<20. then
set phase=4
elseif udg_Time[2]<25. then
set phase=5
else
set phase=6
endif
else
set phase=CommandPhase
endif
if phase==1 then
set a=GetRandomInt(1,12)
if a==1 then
set name='amrc'
elseif a>=3 and a<=5 then
set name='cnob'
elseif a>=6 and a<=9 then
set name='spsh'
else
set name='ward'
endif
elseif phase==2 then
set b=GetRandomInt(1,100)
if b<75 then
set a=GetRandomInt(1,12)
if a>=1 and a<=3 then
set name='amrc'
elseif a>=5 and a<=8 then
set name='cnob'
elseif a>=7 and a<=10 then
set name='spsh'
else
set name='ward'
endif
else
set a=GetRandomInt(1,10)
if a==1 then
set name='gobm'
elseif a>=3 and a<=5 then
set name='dsum'
elseif a>=6 and a<=9 then
set name='wolg'
else
set name='penr'
endif
endif
elseif phase==3 then
set b=GetRandomInt(1,100)
if b<50 then
set a=GetRandomInt(1,12)
if a>=1 and a<=3 then
set name='amrc'
elseif a>=5 and a<=8 then
set name='cnob'
elseif a>=7 and a<=10 then
set name='spsh'
else
set name='ward'
endif
elseif b<80 then
set a=GetRandomInt(1,10)
if a==1 then
set name='gobm'
elseif a>=3 and a<=5 then
set name='dsum'
elseif a>=6 and a<=9 then
set name='wolg'
else
set name='penr'
endif
else
