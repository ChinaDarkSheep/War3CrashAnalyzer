function Trig_KillQuest6_Actions takes nothing returns nothing
local real x
local real y
local integer a=GetPlayerId(GetOwningPlayer(GetKillingUnit()))+1
if IsPlayerInForce(Player(a-1),udg_Quests[6])then
if GetUnitTypeId(GetDyingUnit())=='u000' or GetUnitTypeId(GetDyingUnit())=='u00I' or GetUnitTypeId(GetDyingUnit())=='ugho' then
if udg_QGhouls[a]==20 then
set x=GetUnitX(GetDyingUnit())
set y=GetUnitY(GetDyingUnit())
set udg_QGhouls[a]=udg_QGhouls[a]+1
set bj_lastCreatedUnit=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),'n06S',x,y,bj_UNIT_FACING)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl",x,y))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl",x,y))
else
if not(udg_QGhouls[a]>20)then
set udg_QGhouls[a]=udg_QGhouls[a]+1
call DisplayTimedTextToForce(bj_FORCE_PLAYER[a-1],4.00,"Убито вурдалаков: "+I2S(udg_QGhouls[a])+"/20")
endif
endif
endif
endif
if GetUnitTypeId(GetDyingUnit())=='n06S' then
set x=GetUnitX(GetDyingUnit())
set y=GetUnitY(GetDyingUnit())
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl",x,y))
set bj_lastCreatedItem=CreateItem('I09S',x,y)
set a=0
loop
exitwhen a>7
if IsPlayerInForce(Player(a),udg_Quests[6])then
call SetItemPlayer(bj_lastCreatedItem,Player(a),false)
endif
set a=a+1
endloop
call DestroyTrigger(GetTriggeringTrigger())
endif
endfunction
