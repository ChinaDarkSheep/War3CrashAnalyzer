if GetItemTypeId(Item)=='I097' then
set a=0
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='tkno' then
set a=a+2
endif
if HardcoreBuff10==5 then
set a=a+1
endif
call SetHeroInt(u,(GetHeroInt(u,false)+a),true)
endif
endif
endif
if GetItemTypeId(Item)=='I077' then
if IsUnitInGroup(u,udg_ItemComplectGroup[1])then
call SetItemPosition(Item,GetUnitX(u),GetUnitY(u))
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],20.00,"Предмет нельзя носить с Комплектом \"Безумия\"")
call UnitRemoveAbility(u,'B01S')
endif
endif
if s__Heroes_Type[sHero[ids]]==1 and GetItemTypeId(Item)!='I09I' then
if GetItemTypeId(Item)=='I0CG' or GetItemTypeId(Item)=='I0DL' or GetItemTypeId(Item)=='I0DV' then
if s__Heroes_Mech_2Slot[sHero[ids]]==1 then
call RemoveItem(GetItemOfTypeFromUnitBJ(u,'I09I'))
set a=LoadInteger(udg_hash,h,42)+1
call SaveInteger(udg_hash,h,42,a)
else
set udg_Drop=0
set a=LoadInteger(udg_hash,h,42)+1
set bj_forLoopAIndex=0
loop
exitwhen bj_forLoopAIndex>2
if IsItemOwned(UnitItemInSlot(u,bj_forLoopAIndex))and GetItemTypeId(UnitItemInSlot(u,bj_forLoopAIndex))!='I09I' then
set udg_Drop=udg_Drop+1
endif
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
if udg_Drop>a then
call UnitRemoveItemSwapped(GetManipulatedItem(),u)
endif
endif
else
set udg_Drop=0
set a=LoadInteger(udg_hash,h,42)+1
set bj_forLoopAIndex=0
loop
exitwhen bj_forLoopAIndex>2
if IsItemOwned(UnitItemInSlot(u,bj_forLoopAIndex))and GetItemTypeId(UnitItemInSlot(u,bj_forLoopAIndex))!='I09I' then
set udg_Drop=udg_Drop+1
endif
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
if udg_Drop>a then
call UnitRemoveItemSwapped(GetManipulatedItem(),u)
endif
endif
endif
call F_Attack(u,s__Units_GAttack[sUnit[iuh]])
call F_Armore(u,s__Units_Arm[sUnit[iuh]])
call F_hp(u,s__Units_HP[sUnit[iuh]])
call F_mp(u,s__Units_MP[sUnit[iuh]])
call F_Stats(u)
set u=null
set t=null
endfunction
