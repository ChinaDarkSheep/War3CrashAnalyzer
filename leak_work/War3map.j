set y=yh+310*Sin(24*bj_forLoopAIndex*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("war3mapImported\\AerialExplosionV3.mdx",x,y))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
else
if GetUnitAbilityLevel(hero,'A0C0')==1 and udg_Talante[ID]==1 then
loop
set u=FirstOfGroup(g2)
exitwhen u==null
call UnitRemoveAbility(u,'A0OI')
call GroupRemoveUnit(g2,u)
endloop
endif
call DestroyGroup(g2)
call PauseTimer(t)
call DestroyTimer(t)
