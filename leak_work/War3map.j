function NormSLChar takes string s returns string
local integer a=1
loop
exitwhen a>37
if s==SubString(alpbB,a-1,a)then
return s
endif
if s==SubString(alpbS,a-1,a)then
return s
endif
if s==SubString(alpbA,a-1,a)then
return s
endif
set a=a+1
endloop
return "a"
endfunction
function NormSLName takes string s returns string
local integer a=0
local string res=""
loop
exitwhen a>=StringLength(s)
set res=res+NormSLChar(SubString(s,a,a+1))
set a=a+1
endloop
return res
endfunction
