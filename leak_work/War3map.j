function OgreTalan_GiveGold takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer id=LoadInteger(udg_hash,ht,0)
call AdjustPlayerStateBJ(30000,Player(id),PLAYER_STATE_RESOURCE_GOLD)
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],4.00,"Вы получили 30 000 золота!")
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set t=null
endfunction
