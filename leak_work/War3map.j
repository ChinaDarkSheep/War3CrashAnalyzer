function Trig_MechGolem_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer h=GetHandleId(caster)
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local group g=CreateGroup()
local group g2
local unit u
local real x
local real y
local real x1
local real y1
local real dmg
local lightning array Ligth
local integer a
local timer t
local integer ht
local real r
local boolean HReact=false
if GetSpellAbilityId()=='A0E1' then
set dmg=GetHeroStr(caster,true)*4+100+75*GetPlayerTechCount(Player(ID-1),'R025',true)
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,600,Bool_Filter_ID)
if GetPlayerTechCountSimple('R01G',GetOwningPlayer(caster))==2 then
call RandomUnitFromGroup(6,g)
else
call RandomUnitFromGroup(4,g)
endif
set a=0
loop
set u=FirstOfGroup(g)
exitwhen u==null
set x1=GetUnitX(u)
set y1=GetUnitY(u)
set Ligth[a]=AddLightningEx("FORK",true,x,y,0,x1,y1,0)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl",x1,y1))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\Purge\\PurgeBuffTarget.mdl",x1,y1))
call GroupDamage(x1,y1,250.,caster,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
set a=a+1
call GroupRemoveUnit(g,u)
endloop
if a !=0 then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveInteger(udg_hash,ht,0,a)
loop
exitwhen a==0
call SaveLightningHandle(udg_hash,ht,a,Ligth[a-1])
set Ligth[a]=null
set a=a-1
endloop
call TimerStart(t,.5,false,function MechGolem_Q)
endif
elseif GetSpellAbilityId()=='A0I2' then
call UnitAddAbility(caster,'A0DU')
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveReal(udg_hash,ht,0,18.)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,1.,true,function MechGolem_W)
elseif GetSpellAbilityId()=='A0I5' then
set dmg=300.+30.*GetHeroLevel(caster)+400.*GetPlayerTechCount(GetOwningPlayer(caster),'R029',true)
if GetHeroLevel(caster)>=50 then
set dmg=dmg+0.2*GetUnitState(GetSpellTargetUnit(),UNIT_STATE_MAX_LIFE)
endif
set a=LoadInteger(udg_hash,GetHandleId(GetSpellTargetUnit()),5)
if s__Heroes_Type[sHero[a]]==4 then
set dmg=2.*dmg
endif
call SetUnitState(GetSpellTargetUnit(),UNIT_STATE_LIFE,GetUnitState(GetSpellTargetUnit(),UNIT_STATE_LIFE)+dmg)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl",GetSpellTargetUnit(),"origin")
call DestroyEffect(bj_lastCreatedEffect)
elseif GetSpellAbilityId()=='A0I1' then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",caster,"origin"))
set g2=CreateGroup()
set x=GetUnitX(caster)
set y=GetUnitY(caster)
if UnitHasItemOfTypeBJ(caster,'I0DV')then
set HReact=true
set dmg=18*GetHeroStr(caster,true)
set a=1
loop
exitwhen a>6
set x1=x+250.*Cos(60.*I2R(a)*bj_DEGTORAD)
set y1=y+250.*Sin(60.*I2R(a)*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl",x1,y1))
set a=a+1
endloop
endif
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,650,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if HReact then
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
call UnitAddAbility(u,'A0JH')
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\Purge\\PurgeBuffTarget.mdl",u,"origin"))
call GroupAddUnit(g2,u)
call GroupRemoveUnit(g,u)
endloop
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveReal(udg_hash,ht,0,15.)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveGroupHandle(udg_hash,ht,1,g2)
call TimerStart(t,.1,true,function MechGolem_R)
set x=PositiveDuration(caster,15.)
if udg_ReactorAganim[ID]then
set dmg=60*GetPlayerTechCount(GetOwningPlayer(caster),'R027',true)
set a=LoadInteger(Hash,h,0)
set s__Units_MageBlock[sUnit[a]]=s__Units_MageBlock[sUnit[a]]+5000
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,x,false,function MechGolem_R_Aganime)
else
set dmg=0.
endif
set a=20+GetHeroStr(caster,true)/5
call TempStats(caster,0,0,0,R2I(dmg),a,0,x)
endif
set t=null
call DestroyGroup(g)
set caster=null
set g=null
set g2=null
set u=null
endfunction
