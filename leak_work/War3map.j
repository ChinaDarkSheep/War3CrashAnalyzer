function Rifle_Q takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local unit target=LoadUnitHandle(udg_hash,ht,1)
local real dmg=LoadReal(udg_hash,ht,0)
local unit u
local group g=CreateGroup()
local real x=GetUnitX(target)
local real y=GetUnitY(target)
if udg_RifleLogic[4]then
set dmg=dmg+9.*GetHeroStr(hero,true)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.3*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
endif
call UnitDamageTarget(hero,target,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
if udg_RifleLogic[2]then
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
set udg_Drop2=GetPlayerId(GetOwningPlayer(hero))
call GroupEnumUnitsInRange(g,x,y,250,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,0.6*dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
call DestroyGroup(g)
set t=null
set hero=null
set target=null
set u=null
set g=null
endfunction
function Trig_RifleSkills_Actions takes nothing returns nothing
local unit hero=GetTriggerUnit()
local unit target
local timer t
local integer ht
local real dmg
local real xh=GetUnitX(hero)
local real yh=GetUnitY(hero)
local real x
local real y
local real r
local integer a
if GetSpellAbilityId()=='A144' then
if udg_RifleLogic[6]then
set udg_RifleAttackBoost=12
endif
set target=GetSpellTargetUnit()
set x=GetUnitX(target)
set y=GetUnitY(target)
set x=x-xh
set y=y-yh
set r=SquareRoot(x*x+y*y)/2000
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveUnitHandle(udg_hash,ht,1,target)
call SaveReal(udg_hash,ht,0,GetUnitAbilityLevel(hero,'A144')*400+8*GetHeroAgi(hero,true))
call TimerStart(t,r,false,function Rifle_Q)
endif
if GetSpellAbilityId()=='A142' then
set udg_Rifle50=1.00
if udg_RifleR[2]>0 and GetUnitAbilityLevel(hero,'A145')==1 then
set udg_RifleR[1]=udg_RifleR[1]+udg_RifleR[2]/2
if udg_RifleR[1]>udg_RifleR[2]then
set udg_RifleR[1]=udg_RifleR[2]
endif
endif
if udg_RifleLogic[3]then
call RemoveLocation(udg_RifleRPoint[2])
set udg_RifleRPoint[2]=GetUnitLoc(hero)
endif
if udg_RifleLogic[2]==true then
set a=80+4*GetHeroAgi(hero,true)/10
call TempStats(hero,0,0,0,a,0,0,PositiveDuration(hero,5))
endif
endif
if GetSpellAbilityId()=='A146' then
if GetUnitAbilityLevel(hero,'A146')==1 then
call SetUnitAbilityLevel(hero,'A146',2)
elseif GetUnitAbilityLevel(hero,'A146')==2 then
call SetUnitAbilityLevel(hero,'A146',3)
elseif GetUnitAbilityLevel(hero,'A146')==3 then
call SetUnitAbilityLevel(hero,'A146',4)
elseif GetUnitAbilityLevel(hero,'A146')==4 then
call SetUnitAbilityLevel(hero,'A146',5)
elseif GetUnitAbilityLevel(hero,'A146')==5 then
call SetUnitAbilityLevel(hero,'A146',6)
else
call SetUnitAbilityLevel(hero,'A146',1)
endif
endif
set hero=null
set target=null
set t=null
endfunction
function InitTrig_RifleSkills takes nothing returns nothing
set gg_trg_RifleSkills=CreateTrigger()
call TriggerAddAction(gg_trg_RifleSkills,function Trig_RifleSkills_Actions)
endfunction
