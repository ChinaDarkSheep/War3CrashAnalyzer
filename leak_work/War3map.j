function Trig_ResHero takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local real sec=LoadReal(udg_hash,ht,0)
local integer ID=LoadInteger(udg_hash,ht,1)
local real x
local real y
if not UnitAlive(udg_Hero[ID])then
set sec=sec-1.
call SaveReal(udg_hash,ht,0,sec)
if sec<0. then
call ReviveHero(udg_Hero[ID],s__SpawnX[ID],s__SpawnY[ID],true)
call SetUnitState(udg_Hero[ID],UNIT_STATE_MANA,0.5*GetUnitState(udg_Hero[ID],UNIT_STATE_MAX_LIFE))
call DamageRes(udg_Hero[ID])
call PanCameraToTimedForPlayer(Player(ID-1),s__SpawnX[ID],s__SpawnY[ID],0)
call SelectUnitForPlayerSingle(udg_Hero[ID],Player(ID-1))
if GetUnitAbilityLevel(udg_Hero[ID],'A0BS')==1 and udg_Talante[ID]==2 then
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl",s__SpawnX[ID],s__SpawnY[ID]))
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>12
set x=s__SpawnX[ID]+256*Cos(bj_forLoopAIndex*30.*bj_DEGTORAD)
set y=s__SpawnY[ID]+256*Sin(bj_forLoopAIndex*30.*bj_DEGTORAD)
set bj_lastCreatedUnit=CreateUnit(Player(ID-1),'h009',s__SpawnX[ID],s__SpawnY[ID],bj_UNIT_FACING)
call UnitAddAbility(bj_lastCreatedUnit,'A0HC')
call IssuePointOrder(bj_lastCreatedUnit,"breathoffire",x,y)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',1.5)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set udg_Drop2=GetRandomInt(1,3)
if udg_Drop2==1 then
call CreateTextTagUnitBJ("|cFFFF0000Пепельный демон: +20 силы|r",udg_Hero[ID],0,12.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
call ModifyHeroStat(bj_HEROSTAT_STR,udg_Hero[ID],bj_MODIFYMETHOD_ADD,20)
elseif udg_Drop2==2 then
call CreateTextTagUnitBJ("|cFFFF0000Пепельный демон: +20 ловкости|r",udg_Hero[ID],0,12.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
call ModifyHeroStat(bj_HEROSTAT_AGI,udg_Hero[ID],bj_MODIFYMETHOD_ADD,20)
else
call CreateTextTagUnitBJ("|cFFFF0000Пепельный демон: +20 разум|r",udg_Hero[ID],0,12.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
call ModifyHeroStat(bj_HEROSTAT_INT,udg_Hero[ID],bj_MODIFYMETHOD_ADD,20)
endif
endif
endif
else
call PauseTimer(LoadTimerHandle(udg_hash,ht,0))
call DestroyTimer(LoadTimerHandle(udg_hash,ht,0))
call DestroyTimerDialog(udg_DieHeroTimerWindow[ID])
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
endfunction
function Sangvin_Timer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(hero)
local integer tic=LoadInteger(udg_hash,h,StringHash("Sangvin"))-1
local integer iuh=LoadInteger(Hash,h,0)
if tic>0 and UnitAlive(hero)then
call SaveInteger(udg_hash,h,StringHash("Sangvin"),tic)
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.03*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
else
set s__Units_AllDmg[sUnit[iuh]]=s__Units_AllDmg[sUnit[iuh]]-2500
set s__Units_AllBlock[sUnit[iuh]]=s__Units_AllBlock[sUnit[iuh]]-2500
call SaveInteger(udg_hash,h,StringHash("Sangvin"),0)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
set hero=null
endfunction
function FoTDeath takes unit hero,real x,real y,boolean TrueDeath returns nothing
local group g=CreateGroup()
local group g2=CreateGroup()
local integer h=GetHandleId(hero)
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local real dmg
local real dmg2
local integer a
local integer b
local real r
local unit u
local real res=60
local boolean minimum=false
local real res_per=1.
local timer t
local integer ht
local integer iuh=LoadInteger(Hash,h,0)
if not TrueDeath then
if UnitHasItemOfTypeBJ(hero,'I0EV')then
set b=LoadInteger(udg_hash,h,StringHash("Sangvin"))
if b==0 then
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.03*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
set s__Units_AllDmg[sUnit[iuh]]=s__Units_AllDmg[sUnit[iuh]]+2500
set s__Units_AllBlock[sUnit[iuh]]=s__Units_AllBlock[sUnit[iuh]]+2500
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call TimerStart(t,1.,true,function Sangvin_Timer)
endif
call SaveInteger(udg_hash,h,StringHash("Sangvin"),5)
endif
if udg_Talante[ID]==2 then
if udg_Setstart then
set a=12
else
set a=4
endif
if GetUnitAbilityLevel(hero,'A04K')>0 and GetRandomInt(1,a)==1 then
call SetHeroStr(hero,GetHeroStr(hero,false)+1,true)
endif
if GetUnitTypeId(hero)=='U01Q' then
set a=20
if udg_Setstart then
set a=a/4
endif
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]+a
endif
endif
else
if UnitHasItemOfTypeBJ(hero,'I078')then
if UnitAlive(hero)then
if udg_Time[2]>19 and udg_Time[2]<30 and udg_Time[3]==0 then
set a=GetRandomInt(50,80)
else
set a=40
endif
if udg_Setstart then
set a=a/4
endif
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]+a
endif
endif
endif
if udg_Talante[ID]==2 then
if GetUnitAbilityLevel(hero,'A04L')>0 then
set dmg=60*GetUnitAbilityLevel(hero,'A04L')+1.*GetHeroStr(hero,true)
if GetHeroLevel(hero)>=50 then
set dmg=dmg+.15*GetUnitState(hero,UNIT_STATE_MAX_LIFE)
endif
set dmg2=dmg*2
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,250.,Bool_Filter_ID)
call GroupEnumUnitsInRange(g2,x,y,350.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg2,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
call GroupRemoveUnit(g2,u)
call GroupRemoveUnit(g,u)
endloop
loop
set u=FirstOfGroup(g2)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
call GroupRemoveUnit(g2,u)
endloop
endif
if GetUnitAbilityLevel(hero,'A0RZ')>0 then
call SaveInteger(udg_hash,h,'e',30)
endif
set a=0
if GetUnitAbilityLevel(hero,'A0RV')==1 then
set a=20
endif
if a>0 and udg_Setstart then
set a=a/4
endif
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]+a
elseif udg_Talante[ID]==3 then
if GetUnitAbilityLevel(hero,'A0A2')==1 then
set t=LoadTimerHandle(udg_hash,h,'e')
if t !=null then
call DestroyTimer(t)
call SaveTimerHandle(udg_hash,h,'e',null)
endif
call SaveBoolean(udg_hash,h,StringHash("Passive_1"),false)
endif
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='rhth' then
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]+10
endif
if UnitHasItemOfTypeBJ(hero,'I049')then
if TrueDeath then
set dmg=100
set a=200
else
set dmg=70
set a=140
endif
set dmg=dmg*GoldAvg[ID]
set a=R2I(dmg+a)
if UnitHasItemOfTypeBJ(hero,'I0E9')then
set a=(a*15)/10
endif
if udg_Setstart then
set a=a/4
endif
call SetPlayerStateBJ(Player(ID-1),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(ID-1),PLAYER_STATE_RESOURCE_GOLD)+a)
set GoldNT[ID]=GoldNT[ID]+a
call CreateTextTagUnitBJ(("|cFFFFDC00+"+I2S(a)),hero,0,10.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call ShowTextTagForceBJ(false,udg_TEXT,GetPlayersAll())
call ShowTextTagForceBJ(true,udg_TEXT,bj_FORCE_PLAYER[ID-1])
call SetTextTagVelocityBJ(udg_TEXT,75.00,90.00)
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
endif
if UnitHasItemOfTypeBJ(hero,'I016')then
call F_Looting(hero,50,100,GetUnitX(udg_Circle[ID]),GetUnitY(udg_Circle[ID]))
endif
if GetUnitAbilityLevel(hero,'A0UO')==0 or not TrueDeath then
set a=0
set b=0
loop
exitwhen a>5
if GetItemTypeId(UnitItemInSlot(hero,a))=='I0BD' then
set b=1
set a=5
set dmg=2.*GetUnitState(hero,UNIT_STATE_MAX_LIFE)
elseif GetItemTypeId(UnitItemInSlot(hero,a))=='I013' then
set b=1
set a=5
set dmg=GetUnitState(hero,UNIT_STATE_MAX_LIFE)
endif
set a=a+1
endloop
if b==1 then
set bj_lastCreatedUnit=CreateUnit(Player(ID-1),'h03W',x,y,0.)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',5.)
if GetTriggerUnit()==udg_Murky and udg_Talante[ID]==2 then
set dmg=dmg+4*(GetHeroStr(hero,true)+GetHeroAgi(hero,true))
endif
if not TrueDeath then
set dmg=.3*dmg
endif
set r=0.5*dmg
set dmg=0.5*dmg
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,600,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,r,true,true,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
endif
endif
call DestroyGroup(g2)
call DestroyGroup(g)
set hero=null
set u=null
set g2=null
set g=null
set t=null
endfunction
function F_DeathBelt takes unit hero returns nothing
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
if udg_BeltOfDeath[ID]<9 then
if GetUnitTypeId(udg_Hero[ID])=='E00M' then
set udg_ScorpionBloodstone=udg_ScorpionBloodstone+2
endif
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",udg_Hero[ID],"origin")
call DestroyEffect(bj_lastCreatedEffect)
call InfStats(hero,0,0,0,30,300,0)
set udg_BeltOfDeath[ID]=udg_BeltOfDeath[ID]+1
else
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"Лимит бонусов за смерти героев превышен - Пояс Смерти больше вам не нужен.")
endif
endfunction
function Trig_DieHero_Actions takes nothing returns nothing
local unit hero=GetDyingUnit()
local group g=CreateGroup()
local integer h=GetHandleId(hero)
local real x=GetUnitX(hero)
local real y=GetUnitY(hero)
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local real dmg
local integer a
local integer b
local real r
local unit u
local real res=60
local boolean minimum=false
local real res_per=1.
local timer t
local integer ht
local integer iuh=LoadInteger(Hash,h,0)
set udg_DeathAmount[ID]=udg_DeathAmount[ID]+1
if GetKillingUnit()!=null then
call StatsKill(GetPlayerId(GetOwningPlayer(GetKillingUnit()))+1,ID)
else
call StatsKill(0,ID)
endif
if GetUnitTypeId(hero)=='O00W' then
set bj_groupEnumTypeId='o00X'
call GroupEnumUnitsOfPlayer(g,Player(ID-1),filterGetUnitsOfPlayerAndTypeId)
call ForGroup(g,function GF_RemoveUnit)
call GroupClear(g)
endif
if udg_DeathAmount[ID]==10 then
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,"|cFF52EDF1Игрок|r |cFFFFDC00"+GetPlayerName(Player(ID-1))+"|r |cFF52EDF1умирает 10 раз и получает 2000 золота и \"Щит мертвеца\"!")
call SetPlayerStateBJ(Player(ID-1),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(ID-1),PLAYER_STATE_RESOURCE_GOLD)+2000)
set GoldNT[ID]=GoldNT[ID]+2000
set QuestsNT[ID]=QuestsNT[ID]+1
call UnitAddItemByIdSwapped('I04E',udg_Circle[ID])
endif
if UnitHasItemOfTypeBJ(hero,'I06H')and udg_Mode !=4 and IsUnitType(hero,UNIT_TYPE_HERO)then
call SetHeroStr(hero,GetHeroStr(hero,false)+2,true)
call SetPlayerTechResearchedSwap('R010',(GetPlayerTechCountSimple('R010',GetOwningPlayer(hero))+1),GetOwningPlayer(hero))
if GetUnitTypeId(GetTriggerUnit())!='O003' and hero !=udg_FireLord and hero !=udg_Murky and hero !=udg_Bat then
if udg_HeroResTime[ID]>20 then
set b=5
else
set b=3
endif
else
set b=1
endif
set a=1
loop
exitwhen a>8
call SetHeroStr(udg_Hero[a],GetHeroStr(udg_Hero[a],false)+b,true)
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\NightElf\\NECancelDeath\\NECancelDeath.mdl",udg_Hero[a],"origin"))
set a=a+1
endloop
if not UnitAlive(udg_UnitSeedOfLife[ID])then
set u=CreateUnit(Player(ID-1),'e00Y',x,y,bj_UNIT_FACING)
call UnitAddAbility(u,'A007')
set dmg=GetUnitState(GetTriggerUnit(),UNIT_STATE_MAX_LIFE)
call SummonStats(true,R2I(0.2*dmg),R2I(0.04*dmg),u,GetTriggerUnit())
call UnitRemoveAbility(u,'A007')
set udg_UnitSeedOfLife[ID]=u
call SetUnitAnimation(u,"Morph")
else
call SetUnitState(udg_UnitSeedOfLife[ID],UNIT_STATE_LIFE,GetUnitState(udg_UnitSeedOfLife[ID],UNIT_STATE_LIFE)+0.2*GetUnitState(udg_UnitSeedOfLife[ID],UNIT_STATE_MAX_LIFE))
endif
endif
set a=1
loop
exitwhen a>8
if udg_Hero[a]!=null then
set b=R2I((100+2*GetUnitLevel(hero))*udg_HeroExp[a])
call AddHeroXP(udg_Hero[a],b,true)
if UnitAlive(udg_Hero[a])then
if udg_Mode !=4 then
if IsUnitAlly(hero,Player(a-1))and UnitHasItemOfTypeBJ(udg_Hero[a],'I08P')then
call F_DeathBelt(udg_Hero[a])
endif
endif
endif
endif
set a=a+1
endloop
if UnitHasItemOfTypeBJ(hero,'I05G')then
call RemoveItem(GetItemOfTypeFromUnitBJ(hero,'I05G'))
set udg_p=GetUnitLoc(hero)
call CreateNUnitsAtLoc(1,'n03N',GetOwningPlayer(hero),udg_p,bj_UNIT_FACING)
call RemoveLocation(udg_p)
endif
call FoTDeath(hero,x,y,true)
if UnitHasItemOfTypeBJ(hero,'I0B4')then
if GetPlayerState(GetOwningPlayer(hero),PLAYER_STATE_RESOURCE_GOLD)>=15000 then
call AdjustPlayerStateBJ(-15000,GetOwningPlayer(hero),PLAYER_STATE_RESOURCE_GOLD)
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],15.00,"|cFFBB0000Вы потеряли 15000 золота на ремонт Хрустального венца!")
else
call RemoveItem(GetItemOfTypeFromUnitBJ(hero,'I0B4'))
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],15.00,"|cFFBB0000Ваш хрустальный венец уничтожен!")
endif
else
endif
if hero==udg_Murky and udg_Mode !=4 then
call SetPlayerTechResearchedSwap('R02R',(GetPlayerTechCountSimple('R02R',GetOwningPlayer(udg_Murky))+1),GetOwningPlayer(udg_Murky))
call SetPlayerTechResearchedSwap('R02S',(GetPlayerTechCountSimple('R02S',GetOwningPlayer(udg_Murky))+1),GetOwningPlayer(udg_Murky))
if GetPlayerTechCountSimple('R02S',GetOwningPlayer(udg_Murky))<=30 then
call SaveReal(udg_hash,h,StringHash("HPRegen"),LoadReal(udg_hash,h,StringHash("HPRegen"))+5)
endif
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='odef' and LoadBoolean(udg_hash,GetHandleId(hero),StringHash("Coffin"))==false then
call ReviveHero(hero,GetUnitX(hero),GetUnitY(hero),true)
call SetUnitLifePercentBJ(hero,50.00)
if udg_HeroResTime[ID]<=10 then
call Func_CD(hero,"Coffin",80.)
else
call Func_CD(hero,"Coffin",60.+2.*udg_HeroResTime[ID])
endif
endif
if UnitHasItemOfTypeBJ(hero,'I0EK')then
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]+50
call GroupEnumUnitsInRange(g,x,y,2000,Bool_FilterAlive)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitType(u,UNIT_TYPE_HERO)then
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+0.03*GetUnitState(u,UNIT_STATE_MAX_LIFE))
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Human\\Heal\\HealTarget.mdl",u,"origin")
call DestroyEffect(bj_lastCreatedEffect)
endif
call GroupRemoveUnit(g,u)
endloop
if not UnitAlive(hero)and not LoadBoolean(udg_hash,h,StringHash("2HeartCD"))then
set minimum=true
call Func_CD(hero,"2HeartCD",120.)
endif
endif
if not UnitAlive(hero)then
if GetUnitAbilityLevel(hero,'A04K')==1 then
call ReviveHero(hero,x,y,true)
call SetUnitLifePercentBJ(hero,80.00)
call PanCameraToTimedForPlayer(GetOwningPlayer(hero),x,y,0)
call GroupDamage(x,y,300.,hero,false,0.2*GetUnitState(hero,UNIT_STATE_MAX_LIFE),ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
call UnitRemoveAbilityBJ('A04K',hero)
call UnitAddAbilityBJ('A174',hero)
call SelectUnitForPlayerSingle(hero,GetOwningPlayer(hero))
if udg_HeroResTime[ID]<10 then
set r=35
else
set r=25+udg_HeroResTime[ID]
endif
if udg_Talante[ID]==2 then
set r=r-10
endif
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call TimerStart(t,r,false,function DieHero_Minotaur)
else
if LoadBoolean(udg_hash,h,StringHash("WatchDeath"))then
set res_per=res_per*0.5
call SaveBoolean(udg_hash,h,StringHash("WatchDeath"),false)
endif
if minimum then
set res=10.*res_per
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],res,"|cFF00FF00Ваш герой воскреснет через "+I2S(R2I(res))+" секунд.|r")
elseif udg_HeroResTime[ID]<10.00 then
set res=(10.+udg_HellLife[ID+10])*res_per
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],10.00,"|cFF00FF00Ваш герой восстанет через "+I2S(R2I(res))+" секунд на месте смерти. Вы достигли минимального времени воскрешения!|r")
else
set res=udg_HeroResTime[ID]*res_per
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],res,"|cFF00FF00Ваш герой воскреснет через "+I2S(R2I(res))+" секунд.|r")
endif
if GetUnitAbilityLevel(hero,'A0BS')==1 and udg_Talante[ID]==2 then
set s__SpawnX[ID]=GetUnitX(hero)
set s__SpawnY[ID]=GetUnitY(hero)
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]+50
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(hero),'h02Q',x,y,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(udg_HeroResTime[ID]*res_per,'BTLF',GetLastCreatedUnit())
call GroupDamage(x,y,600.,hero,true,udg_FireLordFdamage*0.60,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL)
call GroupDamage(x,y,600.,hero,false,udg_FireLordFdamage*0.40,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
else
if res>10 then
if not(udg_Mode==4)then
set s__SpawnX[ID]=GetRandomReal(GetRectMinX(gg_rct_StartPlace),GetRectMaxX(gg_rct_StartPlace))
set s__SpawnY[ID]=GetRandomReal(GetRectMinY(gg_rct_StartPlace),GetRectMaxY(gg_rct_StartPlace))
else
set s__SpawnX[ID]=GetLocationX(udg_HeroResPoint)
set s__SpawnY[ID]=GetLocationY(udg_HeroResPoint)
endif
else
set s__SpawnX[ID]=GetUnitX(hero)
set s__SpawnY[ID]=GetUnitY(hero)
endif
if hero==udg_CrowRTarget then
set udg_CrowRLogic=false
set udg_CrowRTarget=null
call DisplayTimedTextToForce(bj_FORCE_PLAYER[GetPlayerId(GetOwningPlayer(udg_Crow))],10.00,"|cFFFF5800Вы больше не привязаны к герою!|r")
endif
endif
if IsUnitInGroup(hero,udg_AllHeroes)then
set bj_lastStartedTimer=CreateTimer()
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveReal(udg_hash,ht,0,res)
call SaveInteger(udg_hash,ht,1,ID)
call SaveTimerHandle(udg_hash,ht,0,bj_lastStartedTimer)
call TimerStart(t,1,true,function Trig_ResHero)
call TimerStart(bj_lastStartedTimer,res,false,function Trig_ResHeroWindow)
call CreateTimerDialogBJ(bj_lastStartedTimer,"Воскрешение")
set udg_DieHeroTimerWindow[ID]=bj_lastCreatedTimerDialog
call TimerDialogDisplayBJ(false,udg_DieHeroTimerWindow[ID])
call TimerDialogDisplayForPlayerBJ(true,udg_DieHeroTimerWindow[ID],Player(ID-1))
endif
endif
endif
call DestroyGroup(g)
set hero=null
set u=null
set g=null
set t=null
endfunction
