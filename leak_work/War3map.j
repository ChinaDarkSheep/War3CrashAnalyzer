function GetQuest takes integer id returns integer
local integer i=s__Quests_Guild_unlock[sQuest[id]]
local integer a=s__Quests_Guild_unlock[sQuest[id]]
local integer b
local integer sel=GetRandomInt(1,s__Quests_Guild_unlock[sQuest[id]])
set b=s___Quests_Guild_list[s__Quests_Guild_list[sQuest[id]]+sel]
set s___Quests_Guild_list[s__Quests_Guild_list[sQuest[id]]+sel]=s___Quests_Guild_list[s__Quests_Guild_list[sQuest[id]]+a]
set s___Quests_Guild_list[s__Quests_Guild_list[sQuest[id]]+a]=b
loop
exitwhen i==s__Quests_Guild_size[sQuest[id]]
set a=s___Quests_Guild_list[s__Quests_Guild_list[sQuest[id]]+i]
set s___Quests_Guild_list[s__Quests_Guild_list[sQuest[id]]+i]=s___Quests_Guild_list[s__Quests_Guild_list[sQuest[id]]+i+1]
set s___Quests_Guild_list[s__Quests_Guild_list[sQuest[id]]+i+1]=a
set i=i+1
endloop
set s__Quests_Guild_unlock[sQuest[id]]=s__Quests_Guild_unlock[sQuest[id]]-1
return b
endfunction
