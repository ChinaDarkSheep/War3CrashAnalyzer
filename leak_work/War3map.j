endif
endif
if GetUnitAbilityLevel(caster,'A0C6')==1 then
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,GetUnitX(caster),GetUnitY(caster),700.,Bool_Filter_ID)
if udg_ReactorAganim[ID]then
set r=2.*GetHeroInt(caster,true)
else
set r=1.5*GetHeroInt(caster,true)
endif
call RandomUnitFromGroup(8,g)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,r,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl",GetUnitX(u),GetUnitY(u))
call DestroyEffect(bj_lastCreatedEffect)
call GroupRemoveUnit(g,u)
endloop
endif
endif
else
if spell and GetUnitAbilityLevel(caster,'A0C6')==1 and GetSpellAbilityId()!='Amec' then
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,GetUnitX(caster),GetUnitY(caster),700.,Bool_Filter_ID)
if udg_ReactorAganim[ID]then
set r=1.5*GetHeroInt(caster,true)
else
set r=GetHeroInt(caster,true)
endif
call RandomUnitFromGroup(8,g)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,r,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl",GetUnitX(u),GetUnitY(u))
call DestroyEffect(bj_lastCreatedEffect)
call GroupRemoveUnit(g,u)
endloop
endif
endif
call DestroyGroup(g)
call DestroyGroup(g2)
set g=null
set g2=null
set caster=null
set u=null
set t=null
endfunction
