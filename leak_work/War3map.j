function ComlpectDropJass_Mech takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit u=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(u)
local integer a=0
local integer b=0
set b=0
loop
exitwhen b>2
if GetItemTypeId(UnitItemInSlot(u,b))!='I09I' then
set a=a+1
endif
set b=b+1
endloop
if a>LoadInteger(udg_hash,h,42)then
if GetItemTypeId(UnitItemInSlot(u,2))!='I09I' then
call UnitRemoveItemFromSlot(u,2)
call UnitAddItemToSlotById(u,'I09I',2)
elseif GetItemTypeId(UnitItemInSlot(u,1))!='I09I' then
call UnitRemoveItemFromSlot(u,1)
call UnitAddItemToSlotById(u,'I09I',1)
elseif GetItemTypeId(UnitItemInSlot(u,0))!='I09I' then
call UnitRemoveItemFromSlot(u,0)
call UnitAddItemToSlotById(u,'I09I',0)
endif
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set t=null
set u=null
endfunction
