function Trig_OgreSpell_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local unit u
local group g=CreateGroup()
local real x
local real y
local real dmg
local integer a
set udg_u=GetSpellAbilityUnit()
if GetSpellAbilityId()=='A10Y' then
set u=GetSpellTargetUnit()
call SetUnitLifeBJ(u,GetUnitStateSwap(UNIT_STATE_LIFE,u)+1.00*GetHeroInt(udg_Ogr,true))
endif
if GetSpellAbilityId()=='A10W' then
set a=GetHeroLevel(udg_Ogr)/10+3
set x=GetUnitX(caster)
set y=GetUnitY(caster)
if udg_Setstart then
set dmg=60.
else
set dmg=30.
endif
if udg_BilderQuestOgr[23]==1 then
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>a
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'nogl',x,y,bj_UNIT_FACING)
call UnitAddAbility(bj_lastCreatedUnit,'A0AH')
call UnitAddAbility(bj_lastCreatedUnit,'A007')
call SummonStats(false,3000,0,bj_lastCreatedUnit,caster)
call UnitRemoveAbility(bj_lastCreatedUnit,'A007')
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',dmg)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
else
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>a
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'nogr',x,y,bj_UNIT_FACING)
call UnitRemoveAbility(bj_lastCreatedUnit,'A11V')
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',dmg)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
endif
if GetSpellAbilityId()=='A10Z' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set dmg=100.+0.33*GetHeroInt(caster,true)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,225.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\FlakCannons\\FlakTarget.mdl",u,"origin"))
call GroupRemoveUnit(g,u)
endloop
endif
if GetSpellAbilityId()=='Aroa' and GetUnitTypeId(caster)=='njgb' and GetPlayerTechCount(GetOwningPlayer(caster),'R05P',true)>0 then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set dmg=I2R(udg_BilderQuestOrc[1])*250.00
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,500.,Bool_Filter_ID_Ally)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if GetOwningPlayer(caster)==GetOwningPlayer(u)then
set a=GetUnitTypeId(u)
if a=='nogm' or a=='nogl' or a=='nomg' or a=='nogr' or a=='njga' or a=='njgb' then
set dmg=0.1*GetUnitState(u,UNIT_STATE_MAX_LIFE)
if dmg>4000 then
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+4000)
else
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+dmg)
endif
else
if a=='n03U' or a=='n03W' or a=='n03V' then
set dmg=0.04*GetUnitState(u,UNIT_STATE_MAX_LIFE)
if dmg>20000 then
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+20000)
else
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+dmg)
endif
endif
endif
endif
call GroupRemoveUnit(g,u)
endloop
endif
set caster=null
set u=null
call DestroyGroup(g)
set g=null
endfunction
