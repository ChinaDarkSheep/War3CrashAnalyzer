local integer h=GetHandleId(u)
local integer iuu=LoadInteger(Hash,h,0)
local integer idu=LoadInteger(Hash,h,IDDammy)
set s__Units_id[sUnit[iuu]]=0
set s__Dummys_id[sDummy[idu]]=0
set udg_Drop3=0-(iuu+idu)
if GetUnitAbilityLevel(u,'A0LN')>0 or udg_Drop3 !=0 then
call FlushChildHashtable(udg_hash,h)
call FlushChildHashtable(Hash,h)
endif
call RemoveUnit(u)
set u=null
endfunction
