function InitTrig_ArtaSkills takes nothing returns nothing
set gg_trg_ArtaSkills=CreateTrigger()
call TriggerAddAction(gg_trg_ArtaSkills,function Trig_ArtaSkills_Actions)
endfunction
function Trig_ExplodeWard_Conditions takes nothing returns boolean
if(not(GetUnitTypeId(GetDyingUnit())=='otot'))then
return false
endif
return true
endfunction
function Trig_ExplodeWard_Actions takes nothing returns nothing
local unit dead=GetDyingUnit()
local player pl=GetOwningPlayer(dead)
local integer ID=GetPlayerId(pl)+1
local integer talante=udg_Talante[ID]
local real x=GetUnitX(dead)
local real y=GetUnitY(dead)
local real x1=0.
local real y1=0.
local real heal=0.
local real dmg=0.
local group g=CreateGroup()
local unit u
local integer lvl=GetUnitAbilityLevel(udg_Hero[ID],'A06F')
set dmg=0.75*GetHeroInt(udg_Hero[ID],true)
if talante==1 then
set dmg=dmg+50+50*lvl+GetHeroInt(udg_Hero[ID],true)
endif
if talante==2 then
set heal=200.*lvl+1.75*GetHeroInt(udg_Hero[ID],true)
if GetHeroLevel(udg_Hero[ID])>=50 then
set heal=heal+1.75*GetHeroInt(udg_Hero[ID],true)
endif
endif
if GetUnitAbilityLevel(udg_Hero[ID],'A0C7')==1 then
set dmg=2.*dmg
endif
call GroupEnumUnitsInRange(g,x,y,450.,null)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)then
if IsUnitEnemy(u,pl)then
call UnitDamageTarget(udg_Hero[ID],u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Human\\Feedback\\ArcaneTowerAttack.mdl",u,"origin")
call DestroyEffect(bj_lastCreatedEffect)
else
if talante==2 and not IsUnitType(u,UNIT_TYPE_STRUCTURE)then
call Heal(true,heal,u,udg_Hero[ID])
endif
endif
endif
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
set pl=null
set dead=null
set g=null
endfunction
function InitTrig_ExplodeWard takes nothing returns nothing
set gg_trg_ExplodeWard=CreateTrigger()
call DisableTrigger(gg_trg_ExplodeWard)
call TriggerRegisterAnyUnitEventBJ(gg_trg_ExplodeWard,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(gg_trg_ExplodeWard,Condition(function Trig_ExplodeWard_Conditions))
call TriggerAddAction(gg_trg_ExplodeWard,function Trig_ExplodeWard_Actions)
endfunction
function Trig_TrollSkills_Battlefield takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit Totem=LoadUnitHandle(udg_hash,ht,0)
local integer i=LoadInteger(udg_hash,ht,1)
local real x=GetUnitX(Totem)
local real y=GetUnitY(Totem)
local unit u
local group g=CreateGroup()
local integer ID=GetPlayerId(GetOwningPlayer(Totem))+1
local integer talante=udg_Talante[ID]
local integer h
if i !=0 and UnitAlive(Totem)then
set i=i-1
call SaveInteger(udg_hash,ht,0,i)
set udg_Drop2=ID-1
call SeekMinUnit()
call GroupEnumUnitsInRange(g,x,y,400.,Bool_Filter_ID_Ally)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if not IsUnitType(u,UNIT_TYPE_STRUCTURE)and IsUnitType(u,UNIT_TYPE_HERO)then
if IsUnitInGroup(u,udg_BattlefieldUG)==false then
call GroupAddUnit(udg_BattlefieldUG,u)
call UnitAddAbility(u,'A13Z')
endif
call SetUnitAbilityLevel(u,'A13Y',GetUnitAbilityLevel(udg_Hero[ID],'A0MG'))
set h=GetHandleId(u)
if talante==2 and LoadInteger(udg_hash,h,StringHash("Battlefield2"))==0 then
set i=LoadInteger(Hash,h,0)
if i<1 then
set i=SeekFreeUnitMin(h)
endif
set s__Units_AllBlock[sUnit[i]]=s__Units_AllBlock[sUnit[i]]+2500
call SaveInteger(udg_hash,h,StringHash("Battlefield2"),1)
endif
call SaveInteger(udg_hash,h,StringHash("Battlefield"),18)
endif
call GroupRemoveUnit(g,u)
endloop
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
call DestroyGroup(g)
set Totem=null
set t=null
set g=null
set u=null
endfunction
function Trig_TrollSkills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local integer talante=udg_Talante[ID]
local unit u
local integer a
local integer b
local integer c
local timer t
local integer ht
local integer h=GetHandleId(caster)
local integer ihh=LoadInteger(udg_hash,h,5)
local integer i
local real x
local real y
local real hp
local real dmg
local integer lvl
local group g=CreateGroup()
if GetSpellAbilityId()=='A06G' then
if talante==3 then
set hp=3.5*(GetHeroStr(caster,true)+GetHeroInt(caster,true))
set dmg=0.85*GetHeroInt(caster,true)
if GetHeroLevel(caster)>=50 then
set hp=2.*hp
set dmg=2.*dmg
endif
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>3
set x=GetSpellTargetX()+25*Cos((GetUnitFacing(caster)+180*bj_forLoopAIndex)*bj_DEGTORAD)
set y=GetSpellTargetY()+25*Sin((GetUnitFacing(caster)+180*bj_forLoopAIndex)*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(caster),'ngrk',x,y,GetUnitFacing(caster))
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
if GetHeroLevel(caster)>=50 then
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+10)
endif
if GetUnitAbilityLevel(u,'A17O')==0 then
call UnitAddAbility(u,'A17O')
endif
call SetUnitAbilityLevel(u,'A17O',GetUnitAbilityLevel(u,'A17O')+6)
call UnitRemoveAbility(u,'A007')
call UnitApplyTimedLife(u,'BTLF',38.)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
endif
if GetSpellAbilityId()=='A06E' then
set lvl=GetUnitAbilityLevel(caster,'A06E')
set hp=1.5*GetHeroStr(caster,true)+GetHeroInt(caster,true)
set dmg=0.35*GetHeroInt(caster,true)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=3
if talante==1 then
set a=4+4*lvl+5*GetHeroInt(caster,true)/100
call TempStats(caster,0,0,0,0,a,0,PositiveDuration(caster,8))
set u=CreateUnit(GetOwningPlayer(caster),'otot',GetUnitX(caster),GetUnitY(caster),270.)
call UnitApplyTimedLife(u,'BTLF',50.)
endif
if talante==3 then
set hp=2.*hp
set dmg=2.*dmg
endif
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set x=GetUnitX(caster)+250*Cos((GetUnitFacing(caster)+120*bj_forLoopAIndex)*bj_DEGTORAD)
set y=GetUnitY(caster)+250*Sin((GetUnitFacing(caster)+120*bj_forLoopAIndex)*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(caster),'osp1',x,y,270.)
call UnitAddAbility(u,'A007')
call SummonStats(false,R2I(100*(lvl-1)),R2I(8*(lvl-1)),u,caster)
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'A007')
call UnitApplyTimedLife(u,'BTLF',40.)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=3
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set x=GetUnitX(caster)+250*Cos(((GetUnitFacing(caster)+60)+120*bj_forLoopAIndex)*bj_DEGTORAD)
set y=GetUnitY(caster)+250*Sin(((GetUnitFacing(caster)+60)+120*bj_forLoopAIndex)*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(caster),'osp1',x,y,270.)
call UnitAddAbility(u,'A007')
call SummonStats(false,R2I(100*(lvl-1)),R2I(8*(lvl-1)),u,caster)
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'A007')
call UnitApplyTimedLife(u,'BTLF',40.)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
if GetUnitAbilityLevel(caster,'A0C7')==1 then
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=3
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set x=GetUnitX(caster)+360*Cos((GetUnitFacing(caster)+120*bj_forLoopAIndex)*bj_DEGTORAD)
set y=GetUnitY(caster)+360*Sin((GetUnitFacing(caster)+120*bj_forLoopAIndex)*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(caster),'osp1',x,y,270.)
call UnitAddAbility(u,'A007')
call SummonStats(false,R2I(100*(lvl-1)),R2I(8*(lvl-1)),u,caster)
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'A007')
call UnitApplyTimedLife(u,'BTLF',40.)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=3
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set x=GetUnitX(caster)+360*Cos((GetUnitFacing(caster)+60+120*bj_forLoopAIndex)*bj_DEGTORAD)
set y=GetUnitY(caster)+360*Sin((GetUnitFacing(caster)+60+120*bj_forLoopAIndex)*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(caster),'osp1',x,y,270.)
call UnitAddAbility(u,'A007')
call SummonStats(false,R2I(100*(lvl-1)),R2I(8*(lvl-1)),u,caster)
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'A007')
call UnitApplyTimedLife(u,'BTLF',40.)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
endif
if GetSpellAbilityId()=='A06F' then
if talante==3 then
set i=GetUnitAbilityLevel(caster,'A06E')
set hp=1.5*GetHeroStr(caster,true)+GetHeroInt(caster,true)
set dmg=0.35*GetHeroInt(caster,true)
if talante==3 then
set hp=2.*hp
set dmg=2.*dmg
endif
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>2
set x=GetSpellTargetX()+25*Cos((GetUnitFacing(caster)+180*bj_forLoopAIndex)*bj_DEGTORAD)
set y=GetSpellTargetY()+25*Sin((GetUnitFacing(caster)+180*bj_forLoopAIndex)*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(caster),'osp1',x,y,GetUnitFacing(caster))
call UnitAddAbility(u,'A007')
call SummonStats(false,R2I(100*(i-1)),R2I(8*(i-1)),u,caster)
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'A007')
call UnitApplyTimedLife(u,'BTLF',40.)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
endif
if GetSpellAbilityId()=='A0MG' then
set lvl=GetUnitAbilityLevel(caster,'A0MG')
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set u=CreateUnit(GetOwningPlayer(caster),'h03T',x,y,270.)
call UnitApplyTimedLife(u,'BTLF',18.)
call UnitAddAbility(u,'A0MH')
call SetUnitAbilityLevel(u,'A0MH',lvl)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call SaveInteger(udg_hash,ht,1,18)
call TimerStart(t,1.,true,function Trig_TrollSkills_Battlefield)
if talante==1 then
set dmg=200.*lvl+4.*GetHeroInt(caster,true)
if GetHeroLevel(caster)>=50 then
set dmg=dmg+3.*GetHeroInt(caster,true)
endif
call GroupDamage(x,y,400.,caster,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
endif
endif
if GetSpellAbilityId()=='A0ZB' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
call GroupEnumUnitsInRange(g,x,y,300.,Condition(function FilterAlive))
loop
set u=FirstOfGroup(g)
exitwhen u==null
if GetUnitTypeId(u)=='otot' then
call KillUnit(u)
endif
call GroupRemoveUnit(g,u)
endloop
endif
if GetSpellAbilityId()=='A06I' then
set u=GetSpellTargetUnit()
set a=GetHeroInt(caster,false)/2+(GetHeroInt(caster,true)-s__Heroes_TempInt[sHero[ihh]])/2
if a<0 then
set a=0
endif
if talante==2 and u !=caster then
set x=24.
else
set x=16.
endif
call TempStats(u,a,a,a,0,0,0,PositiveDuration(caster,x))
endif
call DestroyGroup(g)
set caster=null
set u=null
set t=null
set g=null
endfunction
function InitTrig_TrollSkills takes nothing returns nothing
set gg_trg_TrollSkills=CreateTrigger()
call TriggerAddAction(gg_trg_TrollSkills,function Trig_TrollSkills_Actions)
endfunction
function Trig_HoundSkills_D2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer a=LoadInteger(udg_hash,ht,1)
local integer h=GetHandleId(hero)
call DestroyEffect(LoadEffectHandle(udg_hash,ht,2))
call SaveBoolean(udg_hash,h,'d',false)
call SaveReal(udg_hash,h,StringHash("HPRegenBonusMult"),LoadReal(udg_hash,h,StringHash("HPRegenBonusMult"))/1.15)
call SaveReal(udg_hash,h,StringHash("SelfHealUP"),LoadReal(udg_hash,h,StringHash("SelfHealUP"))-0.15)
call SaveReal(udg_hash,h,StringHash("HPRegen"),LoadReal(udg_hash,h,StringHash("HPRegen"))-a)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set t=null
set hero=null
endfunction
function Trig_HoundSkills_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(hero)
local integer sec=LoadInteger(udg_hash,ht,1)
local integer talante=LoadInteger(udg_hash,ht,2)
local integer i=LoadInteger(Hash,h,0)
if sec>0 then
set sec=sec-1
call SaveInteger(udg_hash,ht,1,sec)
if sec==6 then
set s__Units_Immortal[sUnit[i]]=s__Units_Immortal[sUnit[i]]-1
call SetUnitVertexColor(hero,255,255,255,255)
call PauseUnit(hero,false)
call DestroyEffect(LoadEffectHandle(udg_hash,ht,3))
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.4*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
else
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.05*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
endif
else
if talante==2 then
set s__Units_AllBlock[sUnit[i]]=s__Units_AllBlock[sUnit[i]]-3000
else
set s__Units_AllDmg[sUnit[i]]=s__Units_AllDmg[sUnit[i]]-2500
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
set hero=null
endfunction
function Trig_HoundSkills_F takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(hero)
local real dmg
local integer f=LoadInteger(udg_hash,h,StringHash("HoundF"))
local real x=GetUnitX(hero)
local real y=GetUnitY(hero)
local real r
local group g=CreateGroup()
local unit u
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local integer talante=udg_Talante[ID]
if f==1 and UnitAlive(hero)then
set r=0.3*(0.03*GetUnitState(hero,UNIT_STATE_LIFE)+0.33*F_HPregen(hero))
if r>GetUnitState(hero,UNIT_STATE_LIFE)then
call SetUnitState(hero,UNIT_STATE_LIFE,1.)
else
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)-r)
endif
set dmg=0.3*(0.01*GetUnitState(hero,UNIT_STATE_MAX_LIFE)+2.*F_HPregen(hero))
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,475.,Condition(function Trig_Filter_ID))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",u,"chest")
call DestroyEffect(bj_lastCreatedEffect)
call GroupRemoveUnit(g,u)
endloop
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\Orc\\Orcblood\\BattrollBlood.mdl",hero,"origin")
call DestroyEffect(bj_lastCreatedEffect)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\Undead\\UndeadLargeDeathExplode\\UndeadLargeDeathExplode.mdl",hero,"origin")
call DestroyEffect(bj_lastCreatedEffect)
else
call DestroyEffect(LoadEffectHandle(udg_hash,ht,1))
call SaveInteger(udg_hash,h,StringHash("HoundF"),0)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set hero=null
call DestroyGroup(g)
set g=null
set u=null
set t=null
endfunction
function Trig_HoundSkills_Actions takes nothing returns nothing
local unit hero=GetTriggerUnit()
local integer h=GetHandleId(hero)
local unit u
local unit target
local real x
local real y
local real dmg
local timer t
local integer ht
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local integer talante=udg_Talante[ID]
local integer a
local integer b
local group g=CreateGroup()
if GetSpellAbilityId()=='A1E5' then
call SaveReal(udg_hash,h,StringHash("HPRegenBonusMult"),LoadReal(udg_hash,h,StringHash("HPRegenBonusMult"))*1.15)
call SaveReal(udg_hash,h,StringHash("SelfHealUP"),LoadReal(udg_hash,h,StringHash("SelfHealUP"))+0.15)
set a=10+GetHeroLevel(hero)
call SaveReal(udg_hash,h,StringHash("HPRegen"),LoadReal(udg_hash,h,StringHash("HPRegen"))+a)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
if GetUnitAbilityLevel(hero,'A0CS')==1 then
call SaveBoolean(udg_hash,h,'d',true)
endif
call SaveInteger(udg_hash,ht,1,a)
call SaveEffectHandle(udg_hash,ht,2,AddSpecialEffectTarget("war3mapImported\\Providence Aura Green.mdx",hero,"origin"))
call TimerStart(t,10.,false,function Trig_HoundSkills_D2)
elseif GetSpellAbilityId()=='A1EN' then
set target=GetSpellTargetUnit()
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\Orc\\OrcSmallDeathExplode\\OrcSmallDeathExplode.mdl",target,"chest")
call DestroyEffect(bj_lastCreatedEffect)
set dmg=200*GetUnitAbilityLevel(hero,'A1EN')+2.*GetHeroAgi(hero,true)
if talante==2 then
set dmg=dmg+0.05*GetUnitState(hero,UNIT_STATE_MAX_LIFE)+1.*GetHeroAgi(hero,true)
elseif talante==1 then
set dmg=dmg+0.5*Summ_Attack(hero)
endif
if LoadInteger(udg_hash,h,StringHash("HoundF"))==1 then
call Heal(true,1.5*dmg,hero,hero)
else
call Heal(true,dmg,hero,hero)
endif
if talante==1 then
set a=1
loop
exitwhen a>3
call HeroAttack(hero,hero,GetSpellTargetUnit())
call Modificator(hero,hero,GetSpellTargetUnit())
set a=a+1
endloop
endif
if talante==1 and GetUnitAbilityLevel(hero,'A0CS')==1 then
call UnitDamageTarget(hero,target,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set dmg=0.5*dmg
set x=GetUnitX(target)
set y=GetUnitY(target)
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,375.,Condition(function Trig_Filter_ID))
call GroupRemoveUnit(g,target)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\Orc\\OrcSmallDeathExplode\\OrcSmallDeathExplode.mdl",u,"chest")
call DestroyEffect(bj_lastCreatedEffect)
call GroupRemoveUnit(g,u)
endloop
else
if talante==2 then
if GetUnitAbilityLevel(hero,'A0CS')==1 then
set dmg=dmg+4*F_HPregen(hero)
endif
if LoadInteger(udg_hash,h,StringHash("HoundF"))==1 then
set dmg=1.5*dmg
endif
endif
call UnitDamageTarget(hero,target,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
if talante==2 then
set x=GetUnitX(target)
set y=GetUnitY(target)
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,300.,Condition(function Trig_Filter_ID))
call GroupRemoveUnit(g,target)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\Orc\\OrcSmallDeathExplode\\OrcSmallDeathExplode.mdl",u,"chest")
call DestroyEffect(bj_lastCreatedEffect)
call GroupRemoveUnit(g,u)
endloop
endif
endif
elseif GetSpellAbilityId()=='A09S' then
set a=LoadInteger(Hash,h,0)
if talante==2 then
set s__Units_AllBlock[sUnit[a]]=s__Units_AllBlock[sUnit[a]]+3000
elseif talante==1 then
set b=6*GetHeroAgi(hero,false)/10
call TempStats(hero,0,b,0,0,0,0,PositiveDuration(hero,10))
set s__Units_AllDmg[sUnit[a]]=s__Units_AllDmg[sUnit[a]]+2500
endif
set s__Units_Immortal[sUnit[a]]=s__Units_Immortal[sUnit[a]]+1
call PauseUnit(hero,true)
call SetUnitVertexColor(hero,51,51,255,178)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Undead\\FreezingBreath\\FreezingBreathTargetArt.mdl",hero,"origin")
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveInteger(udg_hash,ht,1,7)
call SaveInteger(udg_hash,ht,2,talante)
call SaveEffectHandle(udg_hash,ht,3,bj_lastCreatedEffect)
call TimerStart(t,1.,true,function Trig_HoundSkills_R)
elseif GetSpellAbilityId()=='A1E6' then
if LoadInteger(udg_hash,h,StringHash("HoundF"))==1 then
call SaveInteger(udg_hash,h,StringHash("HoundF"),0)
set t=LoadTimerHandle(udg_hash,h,'f')
set ht=GetHandleId(t)
call DestroyEffect(LoadEffectHandle(udg_hash,ht,1))
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
else
call SaveInteger(udg_hash,h,StringHash("HoundF"),1)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveEffectHandle(udg_hash,ht,1,AddSpecialEffectTarget("Abilities\\Spells\\Other\\SoulBurn\\SoulBurnbuff.mdl",hero,"overhead"))
call SaveTimerHandle(udg_hash,h,'f',t)
call TimerStart(t,0.3,true,function Trig_HoundSkills_F)
endif
endif
call DestroyGroup(g)
set g=null
set hero=null
set target=null
set u=null
set t=null
endfunction
