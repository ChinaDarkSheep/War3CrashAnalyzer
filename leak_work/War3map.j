function Trig_Axe001_Q_Move takes nothing returns nothing
local timer t=GetExpiredTimer()
local timer t2
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer i=LoadInteger(udg_hash,ht,1)
local location p=LoadLocationHandle(udg_hash,ht,3)
local real x
local real y
local real tx=GetLocationX(p)
local real ty=GetLocationY(p)
if i==0 then
set t2=LoadTimerHandle(udg_hash,ht,2)
call FlushChildHashtable(udg_hash,GetHandleId(t2))
call PauseTimer(t2)
call DestroyTimer(t2)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
call RemoveLocation(p)
call IssueImmediateOrder(hero,"stop")
else
set i=i-1
call SaveInteger(udg_hash,ht,1,i)
set x=GetUnitX(hero)
set y=GetUnitY(hero)
if(x-tx)*(x-tx)+(y-ty)*(y-ty)>81 then
call SetUnitPosition(hero,x+9*Cos(GetUnitFacing(hero)*bj_DEGTORAD),y+9*Sin(GetUnitFacing(hero)*bj_DEGTORAD))
else
call SetUnitPosition(hero,tx,ty)
endif
set x=GetUnitX(hero)
set y=GetUnitY(hero)
if(x-tx)*(x-tx)+(y-ty)*(y-ty)>81 then
call SetUnitPosition(hero,x+9*Cos(GetUnitFacing(hero)*bj_DEGTORAD),y+9*Sin(GetUnitFacing(hero)*bj_DEGTORAD))
else
call SetUnitPosition(hero,tx,ty)
endif
call SetUnitAnimation(hero,"Attack Walk Stand Spin")
endif
set t=null
set t2=null
set hero=null
set p=null
endfunction
function Trig_Axe001_Q_Dmg takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local unit u
local group g=CreateGroup()
local real x=GetUnitX(hero)
local real y=GetUnitY(hero)
local real dmg=0.6*(50.*GetUnitAbilityLevel(hero,'A0IR')+2.*GetHeroStr(hero,true))
local real dmg2=0.4*(50.*GetUnitAbilityLevel(hero,'A0IR')+2.*GetHeroStr(hero,true))
local integer hu
if GetUnitAbilityLevel(hero,'A03J')>0 then
set dmg=1.5*dmg
set dmg2=1.5*dmg2
endif
set udg_Drop2=GetPlayerId(GetOwningPlayer(hero))
call GroupEnumUnitsInRange(g,x,y,320.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(hero,u,dmg2,false,false,ATTACK_TYPE_HERO,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Orc\\OrcSmallDeathExplode\\OrcSmallDeathExplode.mdl",u,"chest"))
if GetUnitAbilityLevel(u,'A0LN')==0 then
call UnitAddAbility(u,'A0LN')
endif
set hu=GetHandleId(u)
call SaveInteger(udg_hash,hu,Axe_Ds,LoadInteger(udg_hash,hu,Axe_Ds)+2)
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
set t=null
set hero=null
set u=null
set g=null
endfunction
function Axe_D takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local real sec=LoadReal(udg_hash,ht,0)
local group g=LoadGroupHandle(udg_hash,ht,1)
local group g2=CreateGroup()
local group g3=CreateGroup()
local real dmg
local unit u
local real x
local real y
local real x1
local real y1
local integer a
if GetUnitAbilityLevel(caster,'A03J')==1 then
set x=LoadReal(udg_hash,GetHandleId(caster),'d')
if x>40 then
set x=40
endif
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+(x*GetUnitState(caster,UNIT_STATE_MAX_LIFE))/100)
call SaveReal(udg_hash,GetHandleId(caster),'d',0)
endif
if sec<=0 then
call DestroyGroup(g3)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
call UnitRemoveAbility(caster,'A0FF')
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call SelectUnitForPlayerSingle(caster,GetOwningPlayer(caster))
call SetUnitTimeScalePercent(caster,100.00)
else
set a=0
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)then
call GroupAddUnit(g2,u)
call GroupAddUnit(g3,u)
set a=a+1
endif
call GroupRemoveUnit(g,u)
endloop
if a>0 then
set sec=sec-0.07
call SaveReal(udg_hash,ht,0,sec)
call SetUnitAnimation(caster,"attack")
call RandomUnitFromGroup(1,g2)
set u=FirstOfGroup(g2)
call GroupRemoveUnit(g3,u)
set x=GetUnitX(u)
set y=GetUnitY(u)
set x1=x+40*Cos(GetUnitFacing(u)*bj_DEGTORAD)
set y1=y+40*Sin(GetUnitFacing(u)*bj_DEGTORAD)
call SetUnitX(caster,x1)
call SetUnitY(caster,y1)
call SetUnitFacing(caster,GetUnitFacing(caster))
set x=GetUnitX(caster)
set y=GetUnitY(caster)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl",x,y))
set a=LoadInteger(udg_hash,GetHandleId(u),Axe_Ds)
set dmg=a*(GetHeroStr(caster,true)+GetHeroAgi(caster,true))
if GetUnitAbilityLevel(caster,'A03J')==1 then
call SaveReal(udg_hash,GetHandleId(caster),'d',LoadReal(udg_hash,GetHandleId(caster),'d')+0.5*a)
endif
call UnitDamageTarget(caster,u,dmg,false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call CreateTextTagUnitBJ("|cFFFF0000"+I2S(R2I(dmg))+" dmg!",u,0,11.00,100,100,100,0)
call SaveInteger(udg_hash,GetHandleId(u),Axe_Ds,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,90.00)
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
call SaveGroupHandle(udg_hash,ht,1,g3)
else
call DestroyGroup(g3)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
call UnitRemoveAbility(caster,'A0FF')
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call SelectUnitForPlayerSingle(caster,GetOwningPlayer(caster))
call SetUnitTimeScalePercent(caster,100.00)
endif
endif
call DestroyGroup(g2)
call DestroyGroup(g)
set caster=null
set t=null
set u=null
set g=null
set g2=null
set g3=null
endfunction
function Trig_Axe001_W takes nothing returns nothing
local timer t=GetExpiredTimer()
set udg_AxeW=false
call PauseTimer(t)
call DestroyTimer(t)
set t=null
endfunction
function Trig_Axe001_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local timer t
local timer t2
local integer h=GetHandleId(caster)
local integer ht
local real r
local unit u
local real x
local real y
local real dmg
local group g=CreateGroup()
local group g2
local integer hu
if GetSpellAbilityId()=='A0CO' then
set udg_AxeW=true
if GetUnitAbilityLevel(caster,'A03J')>0 then
call TempStats(caster,0,0,0,R2I(GetHeroStr(caster,true)*LoadReal(udg_hash,h,4)),(2*GetHeroStr(caster,true))/25,0,PositiveDuration(caster,10))
endif
set t=CreateTimer()
call TimerStart(t,15.,true,function Trig_Axe001_W)
elseif GetSpellAbilityId()=='A0IR' then
set t2=CreateTimer()
set ht=GetHandleId(t2)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t2,0.22,true,function Trig_Axe001_Q_Dmg)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveInteger(udg_hash,ht,1,32)
call SaveTimerHandle(udg_hash,ht,2,t2)
call SaveLocationHandle(udg_hash,ht,3,GetSpellTargetLoc())
call TimerStart(t,0.03,true,function Trig_Axe001_Q_Move)
elseif GetSpellAbilityId()=='A0IS' then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set dmg=200+6*GetHeroStr(caster,true)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,350,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_HERO,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",u,"chest")
call DestroyEffect(bj_lastCreatedEffect)
if GetUnitAbilityLevel(u,'A0LN')==0 then
call UnitAddAbility(u,'A0LN')
endif
set hu=GetHandleId(u)
call SaveInteger(udg_hash,hu,Axe_Ds,LoadInteger(udg_hash,hu,Axe_Ds)+8)
call GroupRemoveUnit(g,u)
endloop
elseif GetSpellAbilityId()=='A0PI' then
call SaveReal(udg_hash,GetHandleId(caster),'d',0)
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,600,Bool_Filter_ID)
set g2=CreateGroup()
loop
set u=FirstOfGroup(g)
exitwhen u==null
set hu=GetHandleId(u)
if LoadInteger(udg_hash,hu,Axe_Ds)>0 then
call GroupAddUnit(g2,u)
endif
call GroupRemoveUnit(g,u)
endloop
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveGroupHandle(udg_hash,ht,1,g2)
call SaveReal(udg_hash,ht,0,5)
call TimerStart(t,0.07,true,function Axe_D)
if GetUnitAbilityLevel(caster,'A03J')==1 then
call SetUnitLifePercentBJ(caster,(GetUnitLifePercent(caster)+10.00))
call SaveReal(udg_hash,GetHandleId(caster),'d',5.)
endif
call UnitAddAbility(caster,'A0FF')
call SelectUnitRemoveForPlayer(caster,GetOwningPlayer(caster))
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call SetUnitTimeScalePercent(caster,400.00)
endif
call DestroyGroup(g)
set g2=null
set g=null
set caster=null
set u=null
set t=null
set t2=null
endfunction
function InitTrig_Axe001 takes nothing returns nothing
set gg_trg_Axe001=CreateTrigger()
call TriggerAddAction(gg_trg_Axe001,function Trig_Axe001_Actions)
endfunction
function Trig_Sdren003_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A0HP'
endfunction
function Trig_Sdren003_E takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local unit target=LoadUnitHandle(udg_hash,h,0)
local integer attack=LoadInteger(udg_hash,h,1)
local integer iuu=LoadInteger(Hash,GetHandleId(target),0)
set s__Units_GAttack[sUnit[iuu]]=s__Units_GAttack[sUnit[iuu]]-attack
call F_Attack(target,s__Units_GAttack[sUnit[iuu]])
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIre\\AIreTarget.mdl",target,"origin"))
call UnitRemoveAbility(target,'A0HV')
call UnitRemoveAbility(target,'A0HW')
call UnitRemoveAbility(target,'A0HX')
call FlushChildHashtable(udg_hash,h)
call PauseTimer(t)
call DestroyTimer(t)
set target=null
set t=null
endfunction
function Trig_Sdren003_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer h=GetHandleId(caster)
local unit u=GetSpellTargetUnit()
local real maxValue=GetUnitState(u,UNIT_STATE_MAX_LIFE)
local real value=GetUnitState(u,UNIT_STATE_LIFE)/maxValue*100.
local integer i1=(100-R2I(value))/10
local timer t=CreateTimer()
local integer ht=GetHandleId(t)
local real r
local integer a
local integer iuu
local integer ihh=LoadInteger(udg_hash,h,5)
call UnitAddAbility(u,'A0HV')
call UnitAddAbility(u,'A0HW')
call UnitAddAbility(u,'A0HX')
call SetUnitAbilityLevel(u,'A0HV',i1)
call SetUnitAbilityLevel(u,'A0HW',i1)
call SetUnitAbilityLevel(u,'A0HX',i1)
set value=value/100.
set value=value+.10+(0.10*I2R(GetUnitAbilityLevel(caster,'A0HP')))
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_MAX_LIFE)*value)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIre\\AIreTarget.mdl",u,"origin"))
if GetHeroLevel(caster)>=50 then
set r=GetUnitAbilityLevel(caster,'A0HP')*25+1.25*(GetHeroInt(caster,true)-0.25*s__Heroes_TempInt[sHero[ihh]])
else
set r=GetUnitAbilityLevel(caster,'A0HP')*25+0.75*(GetHeroInt(caster,true)-0.25*s__Heroes_TempInt[sHero[ihh]])
endif
set r=r*(0.75+0.25*LoadReal(udg_hash,GetHandleId(u),4))
set a=R2I(r)
set iuu=LoadInteger(Hash,GetHandleId(u),0)
set s__Units_GAttack[sUnit[iuu]]=s__Units_GAttack[sUnit[iuu]]+a
call F_Attack(u,s__Units_GAttack[sUnit[iuu]])
call SaveUnitHandle(udg_hash,ht,0,u)
call SaveInteger(udg_hash,ht,1,a)
call TimerStart(t,PositiveDuration(caster,20),false,function Trig_Sdren003_E)
set caster=null
set u=null
set t=null
endfunction
function InitTrig_Sdren003 takes nothing returns nothing
local trigger t=CreateTrigger()
local integer index
set index=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(index),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set index=index+1
exitwhen index==16
endloop
call TriggerAddCondition(t,Condition(function Trig_Sdren003_Conditions))
call TriggerAddAction(t,function Trig_Sdren003_Actions)
endfunction
