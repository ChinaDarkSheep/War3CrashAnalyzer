function Trig_Delete_Func002Func002A takes nothing returns nothing
call PauseUnit(GetEnumUnit(),true)
endfunction
function gg_trg_Delete_Filter takes nothing returns boolean
return(GetOwningPlayer(GetFilterUnit())==Player(PLAYER_NEUTRAL_AGGRESSIVE)or GetOwningPlayer(GetFilterUnit())==Player(11)or GetOwningPlayer(GetFilterUnit())==Player(10)or GetOwningPlayer(GetFilterUnit())==Player(8))
endfunction
function gg_trg_Delete_Del takes nothing returns nothing
call F_RemoveUnit(GetEnumUnit())
endfunction
function Trig_Delete_Actions takes nothing returns nothing
local group g=CreateGroup()
set udg_after20min=false
if udg_Mode==3 then
call GroupEnumUnitsInRect(g,GetWorldBounds(),null)
call ForGroup(g,function Trig_Delete_Func002Func002A)
call DestroyGroup(g)
call DisplayTimedTextToForce(GetPlayersAll(),300.00,"|cFF00C850ПОБЕДА АЛЬЯНСА!|n|nЗлодей не успел разрушить Апотроп, он проиграл!")
call TriggerSleepAction(20.00)
call CustomVictoryBJ(Player(9),true,true)
call CustomDefeatBJ(Player(8),"Вы проиграли!")
call CustomDefeatBJ(Player(10),"Вы проиграли!")
call CustomDefeatBJ(Player(11),"Вы проиграли!")
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=8
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
if ConvertedPlayer(bj_forLoopAIndex)==udg_EvilPlayer then
call CustomDefeatBJ(udg_EvilPlayer,"Вы проиграли!")
else
call CustomVictoryBJ(ConvertedPlayer(bj_forLoopAIndex),true,true)
endif
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
return
else
endif
call GroupClear(g)
