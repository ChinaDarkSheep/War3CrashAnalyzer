call DisableTrigger(gg_trg_EndFase3)
call TriggerRegisterTimerEventPeriodic(gg_trg_EndFase3,10.00)
call TriggerAddCondition(gg_trg_EndFase3,Condition(function Trig_EndFase3_Conditions))
call TriggerAddAction(gg_trg_EndFase3,function Trig_EndFase3_Actions)
endfunction
function Set10_E1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer sec=LoadInteger(udg_hash,ht,0)+1
local real x
local real y
local integer a
if sec<110 then
