function Trig_PickHero_Actions takes nothing returns nothing
local integer i=1
local multiboarditem mbitem=null
local real x=GetRandomReal(GetRectMinX(gg_rct_StartPlace),GetRectMaxX(gg_rct_StartPlace))
local real y=GetRandomReal(GetRectMinY(gg_rct_StartPlace),GetRectMaxY(gg_rct_StartPlace))
set udg_TableConvert[1]=TableNT[10]
set udg_Drop2=GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))
set udg_Drop=GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))
set udg_ZapretHeroes[udg_Drop]=GetUnitTypeId(GetEnteringUnit())
set udg_Hero[udg_Drop]=GetTriggerUnit()
if udg_Mode==4 then
call UnitAddItemByIdSwapped('I02R',udg_Hero[udg_Drop])
call UnitAddItemByIdSwapped('I08L',udg_Hero[udg_Drop])
endif
set bj_forLoopBIndex=1
set bj_forLoopBIndexEnd=udg_Check
loop
exitwhen bj_forLoopBIndex>bj_forLoopBIndexEnd
if I2R(udg_Drop2)==I2R(udg_PlayerNumber[GetForLoopIndexB()])then
call MultiboardSetItemIconBJ(udg_TableConvert[1],2,(GetForLoopIndexB()+1),LoadStr(udg_hash,StringHashBJ(UnitId2StringBJ(GetUnitTypeId(GetEnteringUnit()))),1))
endif
set bj_forLoopBIndex=bj_forLoopBIndex+1
endloop
call MultiboardSetItemIconBJ(udg_TableConvert[2],GetConvertedPlayerId(GetOwningPlayer(GetEnteringUnit())),3,LoadStr(udg_hash,StringHashBJ(UnitId2StringBJ(GetUnitTypeId(GetEnteringUnit()))),1))
call MultiboardSetItemValueBJ(udg_TableConvert[2],GetConvertedPlayerId(GetOwningPlayer(GetEnteringUnit())),3,GetUnitName(GetEnteringUnit()))
set heroiconNT[GetConvertedPlayerId(GetOwningPlayer(GetEnteringUnit()))]=LoadStr(udg_hash,StringHashBJ(UnitId2StringBJ(GetUnitTypeId(GetEnteringUnit()))),1)
loop
exitwhen i>check
set mbitem=MultiboardGetItem(TableNT[10],i,1)
call MultiboardSetItemIcon(mbitem,heroiconNT[PlayerNumberNT[i]])
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(TableNT[10],i,0)
call MultiboardSetItemIcon(mbitem,rankiconNT[PlayerNumberNT[i]])
call MultiboardReleaseItem(mbitem)
set i=i+1
endloop
call ForceAddPlayerSimple(GetOwningPlayer(GetEnteringUnit()),udg_RHCheck)
if GetUnitTypeId(GetEnteringUnit())=='U018' then
set udg_EvilPlayer=GetOwningPlayer(GetEnteringUnit())
call CreateFogModifierRectBJ(true,udg_EvilPlayer,FOG_OF_WAR_VISIBLE,gg_rct_EvilZone)
call SetPlayerAllianceStateBJ(udg_EvilPlayer,Player(8),bj_ALLIANCE_ALLIED_VISION)
call SetPlayerAllianceStateBJ(udg_EvilPlayer,Player(10),bj_ALLIANCE_ALLIED_VISION)
call SetPlayerAllianceStateBJ(udg_EvilPlayer,Player(11),bj_ALLIANCE_ALLIED_VISION)
call SetPlayerAllianceStateBJ(udg_EvilPlayer,Player(PLAYER_NEUTRAL_AGGRESSIVE),bj_ALLIANCE_ALLIED_VISION)
call SetPlayerAllianceStateBJ(Player(8),udg_EvilPlayer,bj_ALLIANCE_ALLIED_VISION)
call SetPlayerAllianceStateBJ(Player(10),udg_EvilPlayer,bj_ALLIANCE_ALLIED_VISION)
call SetPlayerAllianceStateBJ(Player(11),udg_EvilPlayer,bj_ALLIANCE_ALLIED_VISION)
call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE),udg_EvilPlayer,bj_ALLIANCE_ALLIED_VISION)
call SetPlayerAllianceStateBJ(udg_EvilPlayer,Player(9),bj_ALLIANCE_UNALLIED)
call SetPlayerAllianceStateBJ(Player(9),udg_EvilPlayer,bj_ALLIANCE_UNALLIED)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=8
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
if ConvertedPlayer(GetForLoopIndexA())!=udg_EvilPlayer then
call SetPlayerAllianceStateBJ(udg_EvilPlayer,ConvertedPlayer(GetForLoopIndexA()),bj_ALLIANCE_UNALLIED)
call SetPlayerAllianceStateBJ(ConvertedPlayer(GetForLoopIndexA()),udg_EvilPlayer,bj_ALLIANCE_UNALLIED)
endif
