endfunction
function F_Stats takes unit u returns nothing
local integer ID=GetPlayerId(GetOwningPlayer(u))+1
local integer h=GetHandleId(u)
local integer ihh=LoadInteger(udg_hash,h,5)
local integer iuh=LoadInteger(Hash,h,0)
local integer str=0+s__Heroes_Str[sHero[ihh]]
local integer agi=0+s__Heroes_Agi[sHero[ihh]]
local integer int=0+s__Heroes_Int[sHero[ihh]]
local integer tempStr=0+s__Heroes_TempStr[sHero[ihh]]
local integer tempAgi=0+s__Heroes_TempAgi[sHero[ihh]]
local integer tempInt=0+s__Heroes_TempInt[sHero[ihh]]
local integer array a
local integer array b
local integer array c
local real per
set s__Units_Immortal[sUnit[iuh]]=s__Units_Immortal[sUnit[iuh]]+1
set a[0]=GetHeroStr(u,false)+s__Heroes_Str[sHero[ihh]]+s__Heroes_TempStr[sHero[ihh]]-LoadInteger(udg_hash,h,StringHash("NGreenStr"))
set b[0]=GetHeroAgi(u,false)+s__Heroes_Agi[sHero[ihh]]+s__Heroes_TempAgi[sHero[ihh]]-LoadInteger(udg_hash,h,StringHash("NGreenAgi"))
