function Trig_HuntressSkills_Actions takes nothing returns nothing
local unit hero=GetTriggerUnit()
local integer h=GetHandleId(hero)
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local unit u
local timer t
local integer ht
local real r
local real x
local real y
local real dist
local real angle
local real x1
local real y1
local real dmg
local integer i
local integer talante=udg_Talante[ID]
if GetSpellAbilityId()=='A040' then
if talante==1 then
set x=(40*GetUnitAbilityLevel(hero,'A040')+0.75*GetHeroAgi(hero,true))*(.6+.4*LoadReal(udg_hash,h,4))
call TempStats(hero,0,0,0,R2I(x),0,0,PositiveDuration(hero,10))
if GetUnitAbilityLevel(hero,'A0O2')==1 then
set i=LoadInteger(Hash,h,0)
set s__Units_AllBlock[sUnit[i]]=s__Units_AllBlock[sUnit[i]]+2500
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call TimerStart(t,8.,false,function Trig_HuntressSkills_Q1)
endif
endif
if talante==2 then
set dmg=75*GetUnitAbilityLevel(hero,'A040')+0.5*GetHeroAgi(hero,true)
if GetUnitAbilityLevel(hero,'A0O2')==1 and(GetFloatGameState(GAME_STATE_TIME_OF_DAY)<6.00 or GetFloatGameState(GAME_STATE_TIME_OF_DAY)>18.00)then
set dmg=1.2*dmg
endif
set u=CreateUnit(Player(ID-1),'h05G',-22000,18500,0.)
call SetUnitX(u,GetUnitX(hero))
call SetUnitY(u,GetUnitY(hero))
call UnitAddAbility(u,'A041')
set i=SeekFreeDummys(u,GetHandleId(u))
set s__Dummys_dmg[sDummy[i]]=dmg
set s__Dummys_RangeAOE[sDummy[i]]=225.
set s__Dummys_dmgAOE[sDummy[i]]=0.5
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveUnitHandle(udg_hash,ht,1,u)
if GetUnitAbilityLevel(hero,'A0O2')==1 then
call SaveReal(udg_hash,ht,0,5.)
else
call SaveReal(udg_hash,ht,0,3.)
endif
call TimerStart(t,0.1,true,function Trig_HuntressSkills_Q2)
endif
elseif GetSpellAbilityId()=='A043' then
set r=3.+GetUnitAbilityLevel(hero,'A043')
set y=0.5*(GetHeroAgi(hero,true)+GetHeroInt(hero,true))
set u=GetSpellTargetUnit()
set bj_lastCreatedEffect=AddSpecialEffectTarget("Units\\NightElf\\Owl\\Owl.mdl",u,"overhead")
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveUnitHandle(udg_hash,ht,1,u)
call SaveReal(udg_hash,ht,10,r)
call SaveReal(udg_hash,ht,3,0.5*y)
call SaveInteger(udg_hash,ht,6,talante)
call SaveEffectHandle(udg_hash,ht,5,bj_lastCreatedEffect)
if GetUnitAbilityLevel(hero,'A0O2')==1 and talante==1 then
set i=LoadInteger(Hash,h,0)
set s__Units_AllBlock[sUnit[i]]=s__Units_AllBlock[sUnit[i]]+2000
call SaveBoolean(udg_hash,ht,4,true)
else
call SaveBoolean(udg_hash,ht,4,false)
endif
call TimerStart(t,0.5,true,function Trig_HuntressSkills_W)
if GetUnitAbilityLevel(hero,'A0O2')==1 and talante==2 then
call TempStats(u,0,GetHeroAgi(u,false)/5,0,0,0,0,PositiveDuration(u,r))
endif
elseif GetSpellAbilityId()=='A04A' then
if GetUnitAbilityLevel(hero,'A0O2')==1 and talante==2 then
set r=8
else
set r=5
endif
set x=GetUnitX(hero)
set y=GetUnitY(hero)
set dmg=GetUnitAbilityLevel(hero,'A04A')*20
if talante==1 then
set dmg=dmg+0.4*Summ_Attack(hero)
elseif talante==2 then
set dmg=dmg+1.5*GetHeroAgi(hero,true)
endif
set dist=100.
set angle=0.
set x1=x+dist*Cos(angle*bj_DEGTORAD)
set y1=y+dist*Sin(angle*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(hero),'e005',x1,y1,0.)
call UnitApplyTimedLife(u,'BTLF',r)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call SaveUnitHandle(udg_hash,ht,1,hero)
call SaveReal(udg_hash,ht,0,dist)
call SaveReal(udg_hash,ht,1,angle)
call SaveReal(udg_hash,ht,2,x)
call SaveReal(udg_hash,ht,3,y)
call TimerStart(t,0.03,true,function Trig_HuntressSkills_E)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call SaveUnitHandle(udg_hash,ht,1,hero)
call SaveReal(udg_hash,ht,0,dmg)
call TimerStart(t,0.2,true,function Trig_HuntressSkills_E_DMG)
set angle=180.
set x1=x+dist*Cos(angle*bj_DEGTORAD)
set y1=y+dist*Sin(angle*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(hero),'e005',x1,y1,0.)
call UnitApplyTimedLife(u,'BTLF',r)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
