set x=GetUnitX(u)
set y=GetUnitY(u)
set dmg=75*GetUnitAbilityLevel(caster,'A00G')+2*GetHeroInt(caster,true)
if GetHeroLevel(caster)>=50 then
set dmg=dmg+GetHeroInt(caster,true)
endif
if IsUnitInGroup(u,ge)then
call UnitDamageTarget(caster,u,de*dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
else
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
call GroupDamage(x,y,350.,caster,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'h009',x,y,0.)
call UnitAddAbility(bj_lastCreatedUnit,'A00H')
call IssueTargetOrder(bj_lastCreatedUnit,"thunderbolt",u)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',0.75)
if talante==1 then
call SaveUnitHandle(udg_hash,h,'q',u)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,h,0,caster)
call TimerStart(t,10.,false,function Trig_Reptiloid_Q1)
elseif talante==2 then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveUnitHandle(udg_hash,ht,1,u)
call SaveInteger(udg_hash,ht,0,3)
call TimerStart(t,1.,true,function Trig_Reptiloid_Q2)
endif
endif
if GetSpellAbilityId()=='A0TO' then
if talante==1 then
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+0.2*GetUnitState(caster,UNIT_STATE_MAX_LIFE))
set x=200*GetUnitAbilityLevel(caster,'A0TO')+3*GetHeroInt(caster,true)
set dmg=10*GetUnitAbilityLevel(caster,'A0TO')+0.5*GetHeroInt(caster,true)
set y=0.1*GetHeroInt(caster,true)
if GetHeroLevel(caster)>=50 then
set x=2*x
set y=2*y
set dmg=2*dmg
endif
set dmg=dmg*(0.5+0.5*LoadReal(udg_hash,h,4))
call TempStats(caster,0,0,0,R2I(dmg),R2I(y),R2I(x),PositiveDuration(caster,12))
endif
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set dmg=75*GetUnitAbilityLevel(caster,'A0TO')+3*GetHeroInt(caster,true)
if GetHeroLevel(caster)>=50 then
set dmg=dmg+2*GetHeroInt(caster,true)
endif
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,275.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitInGroup(u,ge)then
call UnitDamageTarget(caster,u,de*dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
else
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
call GroupRemoveUnit(g,u)
endloop
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
if talante==2 then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,0.5,false,function Trig_Reptiloid_W2)
endif
endif
if GetSpellAbilityId()=='ANht' then
if talante==2 then
if ge !=null then
call DestroyGroup(ge)
endif
set ge=CreateGroup()
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set dmg=3+GetUnitAbilityLevel(caster,'ANht')
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(ge,x,y,600.,Bool_Filter_ID)
call SaveGroupHandle(udg_hash,h,'e',ge)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,dmg,false,function Trig_Reptiloid_E2)
endif
endif
if GetSpellAbilityId()=='A00I' then
set dmg=500+5.*GetHeroInt(caster,true)
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,800.,Bool_Filter_ID)
call RandomUnitFromGroup(4,g)
loop
set u=FirstOfGroup(g)
exitwhen u==null
set u2=CreateUnit(GetOwningPlayer(caster),'h05G',x,y,GetUnitFacing(caster))
set a=SeekFreeDummys(u2,GetHandleId(u2))
set s__Dummys_dmg[sDummy[a]]=dmg
call UnitAddAbility(u2,'A1B1')
call SetUnitAbilityLevel(u2,'A1B1',7)
call IssueTargetOrder(u2,"chainlightning",u)
call UnitApplyTimedLife(u2,'BTLF',3.25)
call GroupRemoveUnit(g,u)
endloop
endif
call DestroyGroup(g)
set caster=null
set t=null
set u=null
set u2=null
set g=null
set ge=null
endfunction
