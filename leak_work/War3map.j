function Trig_Timer01s takes nothing returns nothing
local unit u
local real x
local real y
local real x1
local real y1
local integer a=0
call GroupClear(ElfHealTowerG)
call GroupClear(mammothE)
call ForGroup(ElfHealTowerSelf,function Trig_Timer01s_ElfHealTower)
call ForGroup(udg_AllHeroes,function Trig_Timer01s_Heroes)
set a=1
loop
exitwhen a>8
if udg_HeroGold[a]>udg_HeroGoldMax[a]then
set GoldAvg[a]=udg_HeroGoldMax[a]*AllGold[a]
else
set GoldAvg[a]=udg_HeroGold[a]*AllGold[a]
endif
set a=a+1
endloop
call ForGroup(BossG,function BossG_Timer01s)
call ForGroup(udg_UnordinaryUnit,function Trig_Timer01s_UnordinaryUnit)
if udg_RifleLogic[5]then
if UnitAlive(udg_Rifle)then
call SetUnitState(udg_Rifle,UNIT_STATE_LIFE,GetUnitState(udg_Rifle,UNIT_STATE_LIFE)+0.01*GetUnitState(udg_Rifle,UNIT_STATE_MAX_LIFE))
call SetUnitState(udg_Rifle,UNIT_STATE_MANA,GetUnitState(udg_Rifle,UNIT_STATE_MANA)+0.01*GetUnitState(udg_Rifle,UNIT_STATE_MAX_MANA))
endif
endif
if udg_CrowRLogic==true then
set x=GetUnitX(udg_Crow)
set y=GetUnitY(udg_Crow)
set x1=GetUnitX(udg_CrowRTarget)
set y1=GetUnitY(udg_CrowRTarget)
set x=x1-x
set y=y1-y
if SquareRoot(x*x+y*y)>650. then
call SetUnitPosition(udg_Crow,x1,y1)
endif
endif
if udg_AvatarGod !=null then
set x=GetUnitX(udg_AvatarGod)
set y=GetUnitY(udg_AvatarGod)
set x1=GetUnitX(udg_TaurenPrist)
set y1=GetUnitY(udg_TaurenPrist)
set x=x1-x
set y=y1-y
if SquareRoot(x*x+y*y)>2000. and UnitAlive(udg_AvatarGod)and UnitAlive(udg_TaurenPrist)then
call UnitRemoveAbility(udg_AvatarGod,'A18A')
set a=LoadInteger(Hash,GetHandleId(udg_AvatarGod),0)
set s__Units_AllDmg[sUnit[a]]=s__Units_AllDmg[sUnit[a]]-2500
set udg_AvatarGod=null
endif
endif
if CountUnitsInGroup(udg_BattlefieldUG)>0 then
call ForGroup(udg_BattlefieldUG,function Trig_Timer01s_Battlefield)
endif
if udg_Mode==2 and udg_Setstart then
set a=1
loop
exitwhen a>8
if not UnitAlive(udg_Hero[a])then
elseif not(LoadInteger(udg_hash,GetHandleId(udg_Hero[a]),5)!=1)then
elseif GetUnitState(udg_Hero[a],UNIT_STATE_LIFE)/GetUnitState(udg_Hero[a],UNIT_STATE_MAX_LIFE)<.99 or GetUnitState(udg_Hero[a],UNIT_STATE_MANA)/GetUnitState(udg_Hero[a],UNIT_STATE_MAX_MANA)<.99 then
set x=GetUnitX(udg_Hero[a])
set y=GetUnitY(udg_Hero[a])
if GetRectMinX(gg_rct_SpawnZone)<=x and x<=GetRectMaxX(gg_rct_SpawnZone)and GetRectMinY(gg_rct_SpawnZone)<=y and y<=GetRectMaxY(gg_rct_SpawnZone)and LoadBoolean(udg_hash,GetHandleId(udg_Hero[a]),StringHash("HardcoreFountan"))==false then
call SetUnitState(udg_Hero[a],UNIT_STATE_LIFE,GetUnitState(udg_Hero[a],UNIT_STATE_LIFE)+.5*GetUnitState(udg_Hero[a],UNIT_STATE_MAX_LIFE))
call SetUnitState(udg_Hero[a],UNIT_STATE_MANA,GetUnitState(udg_Hero[a],UNIT_STATE_MANA)+.5*GetUnitState(udg_Hero[a],UNIT_STATE_MAX_MANA))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",x,y))
call Func_CD(udg_Hero[a],"HardcoreFountan",30.)
endif
endif
set a=a+1
endloop
endif
set u=null
endfunction
