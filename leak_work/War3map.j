if(not(IsUnitType(GetManipulatingUnit(),UNIT_TYPE_HERO)))then
return false
endif
return true
endfunction
function Trig_DropItemJass_Actions takes nothing returns nothing
local item Item=GetManipulatedItem()
local integer i_lvl=GetItemLevel(Item)
local unit u=GetManipulatingUnit()
local integer h=GetHandleId(u)
local integer ID=GetPlayerId(GetOwningPlayer(u))+1
local integer i
local integer a
local real x
local real y
local real z
local real r
local timer t
local string s=LoadStr(udg_hash,GetHandleId(u),2)
local integer ids=ReturnTypeHeroId(GetHandleId(u))
local integer ihh=LoadInteger(udg_hash,h,5)
local integer iuh=LoadInteger(Hash,h,0)
local integer idi=LoadInteger(Hash,GetItemTypeId(Item),Hash_ItId)
if s__SItem_SpecStatID[sItem[idi]]<100 then
call TakeItem(u,idi,-1)
endif
if GetItemTypeId(Item)=='I069' then
call SaveInteger(udg_hash,h,StringHash("GoldSword"),LoadInteger(udg_hash,h,StringHash("GoldSword"))-1)
endif
if GetItemTypeId(Item)=='I0F3' then
call SaveInteger(udg_hash,h,StringHash("RenDuk"),LoadInteger(udg_hash,h,StringHash("RenDuk"))-1)
endif
if i_lvl==0 then
if GetItemTypeId(Item)=='I0BE' then
call SaveInteger(udg_hash,h,StringHash("Greed"),LoadInteger(udg_hash,h,StringHash("Greed"))-1)
endif
if GetItemTypeId(Item)=='I0B1' then
call SaveReal(udg_hash,h,StringHash("SummonAT"),LoadReal(udg_hash,h,StringHash("SummonAT"))-0.15)
endif
if GetItemTypeId(Item)=='I0B8' then
call SaveReal(udg_hash,h,StringHash("SummonHP"),LoadReal(udg_hash,h,StringHash("SummonHP"))-0.2)
endif
if GetItemTypeId(Item)=='I0B9' then
set a=LoadInteger(udg_hash,h,StringHash("MageRobe"))
set s__Units_MP[sUnit[iuh]]=s__Units_MP[sUnit[iuh]]-a
call SaveInteger(udg_hash,h,StringHash("MageRobe"),0)
endif
if GetItemTypeId(Item)=='I0BJ' then
set s__Units_MageDamage[sUnit[iuh]]=s__Units_MageDamage[sUnit[iuh]]-500
endif
if GetItemTypeId(Item)=='I0BR' then
set AllGold[ID]=AllGold[ID]-0.025
endif
elseif i_lvl==4 then
if GetItemTypeId(Item)=='I07H' then
call SaveReal(udg_hash,h,StringHash("SummonAT"),LoadReal(udg_hash,h,StringHash("SummonAT"))-0.1)
endif
if GetItemTypeId(Item)=='I0DV' then
set s__Heroes_Mech_2Slot[sHero[ids]]=s__Heroes_Mech_2Slot[sHero[ids]]-1
endif
if GetItemTypeId(Item)=='I0EB' then
call SaveReal(udg_hash,h,StringHash("HealUP"),LoadReal(udg_hash,h,StringHash("HealUP"))-0.25)
endif
elseif i_lvl==6 then
if GetItemTypeId(Item)=='I0EW' then
set a=LoadInteger(udg_hash,h,StringHash("SealGreed"))
call SaveInteger(udg_hash,h,StringHash("HighStat"),LoadInteger(udg_hash,h,StringHash("HighStat"))-a)
call SaveInteger(udg_hash,h,StringHash("SealGreed"),0)
endif
if GetItemTypeId(Item)=='I04D' or GetItemTypeId(Item)=='I0EN' then
set a=LoadInteger(udg_hash,h,StringHash("UltCore"))
if s=="Str" then
call SetHeroStr(u,GetHeroStr(u,false)-a,true)
call SaveInteger(udg_hash,h,StringHash("BTStr"),LoadInteger(udg_hash,h,StringHash("BTStr"))-a)
else
if s=="Agi" then
call SetHeroAgi(u,GetHeroAgi(u,false)-a,true)
call SaveInteger(udg_hash,h,StringHash("BTAgi"),LoadInteger(udg_hash,h,StringHash("BTAgi"))-a)
else
call SetHeroInt(u,GetHeroInt(u,false)-a,true)
call SaveInteger(udg_hash,h,StringHash("BTInt"),LoadInteger(udg_hash,h,StringHash("BTInt"))-a)
endif
endif
call SaveInteger(udg_hash,h,StringHash("UltCore"),0)
endif
if GetItemTypeId(Item)=='I070' then
set a=LoadInteger(udg_hash,h,StringHash("HeavyAmulet"))
set s__Units_Arm[sUnit[iuh]]=s__Units_Arm[sUnit[iuh]]-a
call SaveInteger(udg_hash,h,StringHash("HeavyAmulet"),0)
endif
if GetItemTypeId(Item)=='I071' then
set s__Heroes_buyI071[sHero[ids]]=s__Heroes_buyI071[sHero[ids]]-1
endif
if GetItemTypeId(Item)=='I08U' then
call SetHeroStr(u,GetHeroStr(u,false)-LoadInteger(udg_hash,h,StringHash("FrostStr")),true)
call SetHeroAgi(u,GetHeroAgi(u,false)-LoadInteger(udg_hash,h,StringHash("FrostAgi")),true)
call SetHeroInt(u,GetHeroInt(u,false)-LoadInteger(udg_hash,h,StringHash("FrostInt")),true)
call SaveInteger(udg_hash,h,StringHash("FrostStr"),0)
call SaveInteger(udg_hash,h,StringHash("FrostAgi"),0)
call SaveInteger(udg_hash,h,StringHash("FrostInt"),0)
set a=LoadInteger(udg_hash,h,StringHash("FrostDMG"))
call RemoveAttack(a,u)
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]-LoadInteger(udg_hash,h,StringHash("FrostHP"))
set s__Units_MP[sUnit[iuh]]=s__Units_MP[sUnit[iuh]]-LoadInteger(udg_hash,h,StringHash("FrostMP"))
call SaveInteger(udg_hash,h,StringHash("FrostDMG"),0)
call SaveInteger(udg_hash,h,StringHash("FrostHP"),0)
call SaveInteger(udg_hash,h,StringHash("FrostMP"),0)
endif
if GetItemTypeId(Item)=='I0CG' then
set s__Heroes_Mech_2Slot[sHero[ids]]=s__Heroes_Mech_2Slot[sHero[ids]]-1
endif
if GetItemTypeId(Item)=='I0CH' then
call SaveReal(udg_hash,h,StringHash("HealUP"),LoadReal(udg_hash,h,StringHash("HealUP"))-0.5)
endif
if GetItemTypeId(Item)=='I0DL' then
set s__Heroes_Mech_2Slot[sHero[ids]]=s__Heroes_Mech_2Slot[sHero[ids]]-1
endif
if GetItemTypeId(Item)=='I0E4' then
call SaveReal(udg_hash,h,StringHash("SelfHealUP"),LoadReal(udg_hash,h,StringHash("SelfHealUP"))-0.25)
endif
if GetItemTypeId(Item)=='I0ED' then
call SaveInteger(udg_hash,h,StringHash("Greed"),LoadInteger(udg_hash,h,StringHash("Greed"))-1)
set s__Heroes_item_I0ED[sHero[ids]]=s__Heroes_item_I0ED[sHero[ids]]-1
endif
if GetItemTypeId(Item)=='I0ES' then
set s__Heroes_ModCD[sHero[ids]]=s__Heroes_ModCD[sHero[ids]]-0.3
endif
if GetItemTypeId(Item)=='I0EU' then
set s__Units_MageDamage[sUnit[iuh]]=s__Units_MageDamage[sUnit[iuh]]-5000
set s__Units_MageBlock[sUnit[iuh]]=s__Units_MageBlock[sUnit[iuh]]-2000
set s__Units_AllTake[sUnit[iuh]]=s__Units_AllTake[sUnit[iuh]]-1000
call SaveInteger(udg_hash,h,StringHash("Greed"),LoadInteger(udg_hash,h,StringHash("Greed"))-1)
endif
elseif i_lvl==7 then
if GetItemTypeId(Item)=='I00J' then
set a=LoadInteger(udg_hash,h,StringHash("Evolvente"))
set s__Units_GAttack[sUnit[iuh]]=s__Units_GAttack[sUnit[iuh]]-a
call SaveInteger(udg_hash,h,StringHash("AllAttack"),LoadInteger(udg_hash,h,StringHash("AllAttack"))-a)
call SaveInteger(udg_hash,h,StringHash("Evolvente"),0)
endif
if GetItemTypeId(Item)=='I09A' then
set a=LoadInteger(udg_hash,h,StringHash("EniSphere"))
set s__Heroes_Int[sHero[ihh]]=s__Heroes_Int[sHero[ihh]]-a
call SaveInteger(udg_hash,h,StringHash("EniSphere"),0)
endif
if GetItemTypeId(Item)=='I093' then
call SetHeroAgi(u,GetHeroAgi(u,false)-100,true)
endif
if GetItemTypeId(Item)=='I09X' then
call SaveReal(udg_hash,h,StringHash("HealUP"),LoadReal(udg_hash,h,StringHash("HealUP"))-0.5)
endif
endif
if i_lvl==0 then
if GetItemTypeId(Item)=='I0CK' then
call SaveInteger(udg_hash,h,StringHash("BrokenSword"),LoadInteger(udg_hash,h,StringHash("BrokenSword"))-1)
set a=LoadInteger(udg_hash,h,StringHash("BrokenSwordAt"))
set s__Units_GAttack[sUnit[iuh]]=s__Units_GAttack[sUnit[iuh]]-a
call SaveInteger(udg_hash,h,StringHash("BrokenSwordAt"),0)
endif
if GetItemTypeId(Item)=='I0EQ' then
set s__Heroes_item_I0EQ[sHero[ids]]=s__Heroes_item_I0EQ[sHero[ids]]-1
endif
if GetItemTypeId(Item)=='I0ER' then
set s__Heroes_item_I0ER[sHero[ids]]=s__Heroes_item_I0ER[sHero[ids]]-1
endif
if GetItemTypeId(Item)=='I0BG' then
call RemoveAttack(200,u)
endif
if GetItemTypeId(Item)=='I0E7' then
call SaveReal(udg_hash,h,StringHash("Modificator"),LoadReal(udg_hash,h,StringHash("Modificator"))-0.5)
call SaveInteger(udg_hash,h,StringHash("Greed"),LoadInteger(udg_hash,h,StringHash("Greed"))-1)
endif
if GetItemTypeId(Item)=='I0EP' then
set s__Heroes_item_I0EP[sHero[ids]]=s__Heroes_item_I0EP[sHero[ids]]-1
if s__Heroes_item_I0EP[sHero[ids]]<1 then
set a=LoadInteger(udg_hash,h,StringHash("Bedrock"))
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]-a
call SaveInteger(udg_hash,h,StringHash("Bedrock"),0)
endif
endif
if GetItemTypeId(Item)=='I0E8' then
set s__Heroes_item_I0E8[sHero[ids]]=s__Heroes_item_I0E8[sHero[ids]]-1
if s__Heroes_item_I0E8[sHero[ids]]==0 then
set a=LoadInteger(udg_hash,h,StringHash("AltAdamS"))
set z=LoadReal(udg_hash,h,StringHash("AltAdamR"))
set s__Heroes_Str[sHero[ihh]]=s__Heroes_Str[sHero[ihh]]-a
set s__Heroes_Agi[sHero[ihh]]=s__Heroes_Agi[sHero[ihh]]-a
set s__Heroes_Int[sHero[ihh]]=s__Heroes_Int[sHero[ihh]]-a
call SaveReal(udg_hash,h,StringHash("HPRegen"),LoadReal(udg_hash,h,StringHash("HPRegen"))-z)
call SaveInteger(udg_hash,h,StringHash("AltAdamS"),0)
call SaveReal(udg_hash,h,StringHash("AltAdamR"),0)
endif
endif
if GetItemTypeId(Item)=='I0EM' then
set s__Heroes_item_I0EM[sHero[ids]]=s__Heroes_item_I0EM[sHero[ids]]-1
endif
endif
if GetItemTypeId(Item)=='I08A' or GetItemTypeId(Item)=='I09D' then
if LoadBoolean(udg_hash,h,StringHash("AmulRinAct"))then
set s__Units_AllDmg[sUnit[iuh]]=s__Units_AllDmg[sUnit[iuh]]-2500
call SaveBoolean(udg_hash,h,StringHash("AmulRinAct"),false)
endif
endif
if i_lvl==0 or i_lvl==1 then
if GetItemTypeId(Item)=='I0A9' then
call SaveInteger(udg_hash,h,StringHash("Greed"),LoadInteger(udg_hash,h,StringHash("Greed"))-1)
endif
if GetItemTypeId(Item)=='I0E9' then
set s__Units_AllDmgM[sUnit[iuh]]=s__Units_AllDmgM[sUnit[iuh]]-4000
endif
if GetItemTypeId(Item)=='shwd' then
call SaveReal(udg_hash,h,StringHash("SummonHP"),LoadReal(udg_hash,h,StringHash("SummonHP"))-0.5)
endif
if GetItemTypeId(Item)=='engs' then
set s__Heroes_item_engs[sHero[ids]]=s__Heroes_item_engs[sHero[ids]]-1
endif
endif
call F_Attack(u,s__Units_GAttack[sUnit[iuh]])
call F_Armore(u,s__Units_Arm[sUnit[iuh]])
call F_hp(u,s__Units_HP[sUnit[iuh]])
call F_mp(u,s__Units_MP[sUnit[iuh]])
call F_Stats(u)
set u=null
set t=null
set Item=null
endfunction
function InitTrig_DropItemJass takes nothing returns nothing
set gg_trg_DropItemJass=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_DropItemJass,EVENT_PLAYER_UNIT_DROP_ITEM)
call TriggerAddCondition(gg_trg_DropItemJass,Condition(function Trig_DropItemJass_Conditions))
call TriggerAddAction(gg_trg_DropItemJass,function Trig_DropItemJass_Actions)
endfunction
function Trig_InfityGlovesCraft takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local real r=LoadReal(Hash,ht,0)+30.
local real x=LoadReal(Hash,ht,1)
local real y=LoadReal(Hash,ht,2)
local real x1
local real y1
local integer a
if r<1500. then
call SaveReal(Hash,ht,0,r)
set a=1
loop
exitwhen a>10
set x1=x+r*Cos(a*36.*bj_DEGTORAD)
set y1=y+r*Sin(a*36.*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",x1,y1))
set a=a+1
endloop
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(Hash,ht)
endif
set t=null
endfunction
function Trig_ComlpectTakeJassAll_Actions takes nothing returns nothing
local item Item=GetManipulatedItem()
local unit u=GetManipulatingUnit()
local integer ID=GetPlayerId(GetOwningPlayer(u))+1
local integer h=GetHandleId(u)
local integer name=GetItemTypeId(Item)
local integer a
local integer b
local integer c
local boolean array ComplectS
local timer t
local integer ht
if name=='I03G' or name=='I03O' or name=='I040' or name=='I03I' or name=='I03Q' or name=='I02K' then
set ComplectS[0]=false
set ComplectS[1]=false
set ComplectS[2]=false
set ComplectS[3]=false
set ComplectS[4]=false
set ComplectS[5]=false
set a=0
loop
exitwhen a>5
set b=GetItemTypeId(UnitItemInSlot(u,a))
if b=='I03G' then
set ComplectS[0]=true
elseif b=='I03O' then
set ComplectS[1]=true
elseif b=='I040' then
set ComplectS[2]=true
elseif b=='I03I' then
set ComplectS[3]=true
elseif b=='I03Q' then
set ComplectS[4]=true
elseif b=='I02K' then
set ComplectS[5]=true
endif
set a=a+1
endloop
if ComplectS[0]and ComplectS[1]and ComplectS[2]and ComplectS[3]and ComplectS[4]and ComplectS[5]then
set a=0
loop
exitwhen a>5
call RemoveItem(UnitItemInSlot(u,a))
set a=a+1
endloop
call UnitAddItemByIdSwapped('I05S',u)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveReal(Hash,ht,1,GetUnitX(u))
call SaveReal(Hash,ht,2,GetUnitY(u))
call TimerStart(t,0.05,true,function Trig_InfityGlovesCraft)
endif
endif
if IsUnitType(u,UNIT_TYPE_HERO)then
if name=='modt' or name=='I01A' or name=='I019' or name=='I01Z' or name=='I04I' or name=='I0BV' or name=='I0C9' or name=='I08O' or name=='I0EZ' or name=='I08G' or name=='I0D9' then
set a=0
set b=0
set c=0
loop
exitwhen a>5
set b=GetItemTypeId(UnitItemInSlot(u,a))
if b=='modt' or b=='I01A' or b=='I019' or b=='I01Z' or b=='I04I' then
set c=c+1
elseif b=='I0BV' or b=='I0C9' or b=='I08O' or b=='I0EZ' or b=='I08G' then
set c=c+1
elseif b=='I0D9' then
set c=c+1
endif
set a=a+1
endloop
if c>1 then
call SetItemPosition(Item,GetUnitX(u),GetUnitY(u))
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],20.,"Предметы с вампиризмом не складываются!")
endif
endif
if name=='I077' or name=='I04F' or name=='I0DO' or name=='I0BH' then
set a=0
set b=0
set c=0
loop
exitwhen a>5
set b=GetItemTypeId(UnitItemInSlot(u,a))
if b=='I077' or b=='I04F' or b=='I0DO' or b=='I0BH' then
set c=c+1
endif
set a=a+1
endloop
if c>1 then
call SetItemPosition(Item,GetUnitX(u),GetUnitY(u))
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],20.,"Данные предметы не складываются!")
endif
endif
endif
set Item=null
set t=null
set u=null
endfunction
function InitTrig_ComlpectTakeJassAll takes nothing returns nothing
set gg_trg_ComlpectTakeJassAll=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_ComlpectTakeJassAll,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddAction(gg_trg_ComlpectTakeJassAll,function Trig_ComlpectTakeJassAll_Actions)
endfunction
function Trig_ComlpectTakeJass_Conditions takes nothing returns boolean
if(not(IsUnitType(GetManipulatingUnit(),UNIT_TYPE_HERO)))then
return false
endif
return true
endfunction
function Trig_ComlpectTakeJass_Actions takes nothing returns nothing
local item Item=GetManipulatedItem()
local unit u=GetManipulatingUnit()
local integer ID=GetPlayerId(GetOwningPlayer(u))+1
local integer h=GetHandleId(u)
local integer name=GetItemTypeId(Item)
local integer a
local integer b
local boolean array ComplectS
local timer t
local integer ht
local integer iuu=LoadInteger(Hash,h,0)
local integer ihh=LoadInteger(udg_hash,h,5)
local integer iuh=LoadInteger(Hash,h,0)
if(name=='I0BJ' or name=='I0BI' or name=='I0BS')and not IsUnitInGroup(u,udg_ItemComplectGroup[3])then
if UnitHasItemOfTypeBJ(u,'I0BJ')and UnitHasItemOfTypeBJ(u,'I0BI')and UnitHasItemOfTypeBJ(u,'I0BS')then
if LoadInteger(udg_hash,h,StringHash("Greed"))==0 then
set s__Units_MageDamage[sUnit[iuu]]=s__Units_MageDamage[sUnit[iuu]]+5000
call SaveInteger(udg_hash,h,StringHash("Greed"),LoadInteger(udg_hash,h,StringHash("Greed"))+1)
call GroupAddUnit(udg_ItemComplectGroup[3],u)
set s__Units_Arm[sUnit[iuh]]=s__Units_Arm[sUnit[iuh]]+50
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]+2500
if LoadStr(udg_hash,h,2)=="Str" then
set s__Heroes_Str[sHero[ihh]]=s__Heroes_Str[sHero[ihh]]+200
else
if LoadStr(udg_hash,h,2)=="Agi" then
set s__Heroes_Agi[sHero[ihh]]=s__Heroes_Agi[sHero[ihh]]+200
else
set s__Heroes_Int[sHero[ihh]]=s__Heroes_Int[sHero[ihh]]+200
endif
endif
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],25.,"|cFF90A2EAКомплект \"Аркановый чародей\" собран:\n+200 main stat\n+50 защиты\n+2500 HP\n\n+50% к магическому урону (+, Магическая тонкость)|r")
else
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],20.,"|cFF90A2EAНельзя носить несколько предметов с эффектом Магическая тонкость|r")
call UnitRemoveItem(u,Item)
endif
else
call FHelpText(ID-1,"|cFF90A2EAКомплект \"Аркановый чародей\" не собран|r",20.)
endif
endif
if(name=='I0BH' or name=='I0BK' or name=='I0BL')and IsUnitInGroup(u,udg_ItemComplectGroup[1])==false then
if UnitHasItemOfTypeBJ(u,'I0BH')and UnitHasItemOfTypeBJ(u,'I0BK')and UnitHasItemOfTypeBJ(u,'I0BL')then
set a=0
loop
exitwhen a>5
if GetItemTypeId(UnitItemInSlot(u,a))=='I077' then
call SetItemPosition(UnitItemInSlot(u,a),GetUnitX(u),GetUnitY(u))
call UnitRemoveAbility(u,'B01S')
endif
