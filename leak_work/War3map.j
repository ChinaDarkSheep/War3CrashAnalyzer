return false
endif
return true
endfunction
function Trig_AttackersDeath_Func004C takes nothing returns boolean
if(not(IsUnitInGroup(GetDyingUnit(),udg_A3)==true))then
return false
endif
return true
endfunction
function Trig_AttackersDeath_Actions takes nothing returns nothing
if(Trig_AttackersDeath_Func002C())then
call GroupRemoveUnitSimple(GetDyingUnit(),udg_A1)
else
endif
if(Trig_AttackersDeath_Func003C())then
call GroupRemoveUnitSimple(GetDyingUnit(),udg_A2)
else
endif
if(Trig_AttackersDeath_Func004C())then
call GroupRemoveUnitSimple(GetDyingUnit(),udg_A3)
else
endif
endfunction
