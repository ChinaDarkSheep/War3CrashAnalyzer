function Trig_PaladinSkills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local unit u
local group g=CreateGroup()
local timer t
local integer h=GetHandleId(caster)
local integer ht
local real x
local real y
local real x1
local real y1
local player pl=GetOwningPlayer(caster)
local integer ID=GetPlayerId(pl)+1
local integer drop=GetPlayerId(pl)+1
local real dmg
local real r
local integer talante=udg_Talante[drop]
local integer a
local integer b
if GetSpellAbilityId()=='A03F' then
set r=3.*(GetHeroStr(caster,true)+GetHeroInt(caster,true))
set dmg=4.*GetHeroInt(caster,true)
if talante==1 then
set a=R2I(GetHeroStr(caster,true)*LoadReal(udg_hash,h,4))/2
call TempStats(caster,0,0,0,a,0,0,PositiveDuration(caster,15))
elseif talante==2 then
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+0.2*GetUnitState(caster,UNIT_STATE_MAX_LIFE))
elseif talante==3 then
set r=r+3.*GetHeroInt(caster,true)
endif
set a=1
loop
exitwhen a>8
if UnitAlive(udg_Hero[a])then
if IsUnitAlly(udg_Hero[a],GetOwningPlayer(caster))then
set x=GetUnitX(udg_Hero[a])
set y=GetUnitY(udg_Hero[a])
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl",x,y))
call SetUnitState(udg_Hero[a],UNIT_STATE_LIFE,GetUnitState(udg_Hero[a],UNIT_STATE_LIFE)+r)
if GetUnitAbilityLevel(caster,'A0CD')==1 then
set b=1
loop
exitwhen b>4
set x1=x+200*Cos((90*b)*bj_DEGTORAD)
set y1=y+200*Sin((90*b)*bj_DEGTORAD)
set bj_lastCreatedUnit=CreateUnit(pl,'h01B',x1,y1,0)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',5)
call DestroyEffect(AddSpecialEffect("war3mapImported\\Ground Slam Fire.mdx",x1,y1))
call GroupDamage(x1,y1,250.,caster,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
set b=b+1
endloop
endif
endif
endif
set a=a+1
