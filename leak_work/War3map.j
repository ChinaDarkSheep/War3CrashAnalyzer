function Set_Damage_Grob takes nothing returns nothing
if udg_DamageEventTarget==udg_Grob and udg_DamageEventAmount>=GetUnitState(udg_Grob,UNIT_STATE_LIFE)and LoadBoolean(udg_hash,GetHandleId(udg_Grob),'l')==false then
call SaveBoolean(udg_hash,GetHandleId(udg_Grob),'l',true)
set udg_DamageEventAmount=0.
call SetUnitState(udg_Grob,UNIT_STATE_LIFE,GetUnitState(udg_Grob,UNIT_STATE_LIFE)+2.*GetHeroStr(udg_Grob,true)+0.1*GetUnitState(udg_Grob,UNIT_STATE_MAX_LIFE))
set bj_lastStartedTimer=CreateTimer()
call TimerStart(bj_lastStartedTimer,40.,false,function Grob_Life)
endif
endfunction
function GuardionTreeDE takes nothing returns nothing
if GetUnitTypeId(udg_DamageEventSource)=='e000' and not udg_noSplash then
set udg_noSplash=true
set udg_Damage[3]=(GetUnitState(udg_NatureGuardian,UNIT_STATE_MAX_LIFE)/5.00)
call UnitDamageTarget(udg_DamageEventSource,udg_DamageEventTarget,udg_Damage[3],true,false,ATTACK_TYPE_MELEE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
if udg_DamageEventTarget==udg_TargetTree then
set udg_Damage[3]=(GetUnitState(udg_NatureGuardian,UNIT_STATE_MAX_LIFE)/5.00)
call UnitDamageTarget(udg_DamageEventSource,udg_DamageEventTarget,udg_Damage[3],true,false,ATTACK_TYPE_MELEE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
endif
set udg_noSplash=false
endif
endfunction
