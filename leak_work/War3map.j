function Trig_Scorpion_Actions_Regenerator takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(hero)
local real sec=LoadReal(udg_hash,ht,0)
local real reg=LoadReal(udg_hash,ht,1)
local integer Choise_adapt=LoadInteger(udg_hash,h,'d')
call SaveReal(udg_hash,h,StringHash("HPRegen"),LoadReal(udg_hash,h,StringHash("HPRegen"))-reg)
if sec>0 then
set sec=sec-0.25
call SaveReal(udg_hash,ht,0,sec)
if Choise_adapt==1 then
set reg=GetHeroStr(hero,true)
else
if Choise_adapt==2 then
set reg=GetHeroAgi(hero,true)
else
set reg=GetHeroInt(hero,true)
endif
endif
set reg=0.15*reg
call SaveReal(udg_hash,h,StringHash("HPRegen"),LoadReal(udg_hash,h,StringHash("HPRegen"))+reg)
call SaveReal(udg_hash,ht,1,reg)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
set hero=null
endfunction
function Trig_Scorpion_Actions_Q takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit target=LoadUnitHandle(udg_hash,ht,1)
local unit target2=LoadUnitHandle(udg_hash,ht,2)
local effect e=LoadEffectHandle(udg_hash,ht,0)
local real sec=LoadReal(udg_hash,ht,0)
if sec>0 then
set sec=sec-1.
call SaveReal(udg_hash,ht,0,sec)
if sec==9. and e !=null then
call DestroyEffect(e)
endif
else
call UnitRemoveAbility(target,'A15J')
call UnitRemoveAbility(target2,'A15J')
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
set target=null
set target2=null
set e=null
endfunction
function Scorpion_W takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(hero)
local integer sec=LoadInteger(udg_hash,ht,0)
local real x=LoadReal(udg_hash,ht,0)
local real y=LoadReal(udg_hash,ht,1)
local integer adapt
local real dmg
local integer Choise_adapt=LoadInteger(udg_hash,h,'d')
if Choise_adapt==1 then
set adapt=GetHeroStr(hero,true)
else
if Choise_adapt==2 then
set adapt=GetHeroAgi(hero,true)
else
set adapt=GetHeroInt(hero,true)
endif
endif
if sec>0 then
set sec=sec-1
call SaveInteger(udg_hash,ht,0,sec)
set dmg=0.4*adapt
if udg_ScorpionMutation[3]==1 then
set dmg=2.5*dmg
endif
if udg_ScorpionMutation[10]==1 then
set dmg=dmg+50*GetUnitAbilityLevel(hero,'A14H')
else
set dmg=dmg+25*GetUnitAbilityLevel(hero,'A14H')
endif
if GetHeroLevel(hero)>49 then
set dmg=1.5*dmg
endif
call GroupDamage(x,y,300.,hero,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
if udg_ScorpionMutation[5]==2 then
set dmg=0.25*adapt
call GroupDamage(x,y,300.,hero,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
else
endif
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
set hero=null
endfunction
function Scorpion_F_Obr takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local real dmg=LoadReal(udg_hash,ht,0)
local integer armore=LoadInteger(udg_hash,ht,1)
local integer h=GetHandleId(hero)
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local integer iuh=LoadInteger(Hash,h,0)
set udg_ReflectDmg[ID]=udg_ReflectDmg[ID]-dmg
set s__Units_Arm[sUnit[iuh]]=s__Units_Arm[sUnit[iuh]]-armore
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set t=null
set hero=null
endfunction
function Trig_Scorpion_Actions takes nothing returns nothing
