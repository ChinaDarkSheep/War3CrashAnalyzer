function Trig_RezakDied_Actions takes nothing returns nothing
local integer ID=GetPlayerId(GetOwningPlayer(GetDyingUnit()))+1
local real x=GetUnitX(GetTriggerUnit())
local real y=GetUnitY(GetTriggerUnit())
local real x1
local real y1
local real dmg
local real damage
if GetDyingUnit()==udg_Rezak then
call PauseUnitBJ(false,udg_Hero[ID])
call DestroyEffectBJ(udg_Effect[10])
if GetUnitAbilityLevel(udg_Hero[ID],'A0BM')==1 then
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>3
set x1=x+150*Cos((120.00*bj_forLoopAIndex)*bj_DEGTORAD)
set y1=y+150*Sin((120.00*bj_forLoopAIndex)*bj_DEGTORAD)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Human\\Polymorph\\PolyMorphDoneGround.mdl",x1,y1)
call DestroyEffect(bj_lastCreatedEffect)
set bj_lastCreatedUnit=CreateUnit(Player(ID-1),'ngsp',x1,y1,0.)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',15.)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
else
endif
else
endif
if GetUnitTypeId(GetDyingUnit())=='ngsp' then
if GetHeroLevel(udg_Hero[ID])>=70 then
set dmg=18.*GetHeroLevel(udg_Hero[ID])
else
set dmg=15.*GetHeroLevel(udg_Hero[ID])
endif
set damage=1.*GetHeroInt(udg_Hero[ID],true)
call GroupDamage(x,y,300.,udg_Hero[ID],false,dmg,ATTACK_TYPE_SIEGE,DAMAGE_TYPE_UNIVERSAL)
call GroupDamage(x,y,300.,udg_Hero[ID],false,damage,ATTACK_TYPE_SIEGE,DAMAGE_TYPE_MAGIC)
set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\NewDirtEXNofire.mdx",x,y)
call DestroyEffect(bj_lastCreatedEffect)
else
endif
if GetUnitTypeId(GetDyingUnit())=='nglm' then
if GetHeroLevel(udg_Hero[ID])>=70 then
set dmg=14.4*GetHeroLevel(udg_Hero[ID])
else
set dmg=12*GetHeroLevel(udg_Hero[ID])
endif
set damage=0.75*GetHeroInt(udg_Hero[ID],true)
call GroupDamage(x,y,200.,udg_Hero[ID],false,dmg,ATTACK_TYPE_SIEGE,DAMAGE_TYPE_UNIVERSAL)
call GroupDamage(x,y,200.,udg_Hero[ID],false,damage,ATTACK_TYPE_SIEGE,DAMAGE_TYPE_MAGIC)
else
endif
if GetUnitTypeId(GetDyingUnit())=='h01R' then
if GetHeroLevel(udg_Hero[ID])==70 then
set dmg=4200
else
set dmg=50*GetHeroLevel(udg_Hero[ID])
endif
set damage=5*GetHeroInt(udg_Hero[ID],true)
if UnitHasItemOfTypeBJ(udg_Hero[ID],'I013')or UnitHasItemOfTypeBJ(udg_Hero[ID],'I0BD')then
set dmg=2*dmg
set damage=2.*damage
endif
call GroupDamage(x,y,500.,udg_Hero[ID],false,dmg,ATTACK_TYPE_SIEGE,DAMAGE_TYPE_UNIVERSAL)
call GroupDamage(x,y,500.,udg_Hero[ID],false,damage,ATTACK_TYPE_SIEGE,DAMAGE_TYPE_UNIVERSAL)
set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\NewDirtEXNofire.mdx",x,y)
call Effect_Del(bj_lastCreatedEffect,3.)
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>8
set x1=x+256*Cos((45.00*bj_forLoopAIndex)*bj_DEGTORAD)
set y1=y+256*Sin((45.00*bj_forLoopAIndex)*bj_DEGTORAD)
set bj_lastCreatedEffect=AddSpecialEffect("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl",x1,y1)
call DestroyEffect(bj_lastCreatedEffect)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
else
endif
endfunction
function InitTrig_RezakDied takes nothing returns nothing
set gg_trg_RezakDied=CreateTrigger()
call DisableTrigger(gg_trg_RezakDied)
call TriggerRegisterAnyUnitEventBJ(gg_trg_RezakDied,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddAction(gg_trg_RezakDied,function Trig_RezakDied_Actions)
endfunction
function Trig_Med1_Q takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local real sec=LoadReal(udg_hash,ht,0)
local real x=LoadReal(udg_hash,ht,1)
local real y=LoadReal(udg_hash,ht,2)
local real x1
local real y1
if sec>0 then
call SaveReal(udg_hash,ht,0,sec-1)
else
set x1=x+565.*Cos(45.*bj_DEGTORAD)
set y1=y+565.*Sin(45.*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl",x1,y1))
set x1=x+565.*Cos(135.*bj_DEGTORAD)
set y1=y+565.*Sin(135.*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl",x1,y1))
set x1=x+565.*Cos(225.*bj_DEGTORAD)
set y1=y+565.*Sin(225.*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl",x1,y1))
set x1=x+565.*Cos(315.*bj_DEGTORAD)
set y1=y+565.*Sin(315.*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl",x1,y1))
call RemoveDestructable(LoadDestructableHandle(udg_hash,ht,11))
call RemoveDestructable(LoadDestructableHandle(udg_hash,ht,12))
call RemoveDestructable(LoadDestructableHandle(udg_hash,ht,13))
call RemoveDestructable(LoadDestructableHandle(udg_hash,ht,14))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
endfunction
function Trig_Med1_W takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local real sec=LoadReal(udg_hash,ht,0)
local real x=LoadReal(udg_hash,ht,1)
local real y=LoadReal(udg_hash,ht,2)
local real x1
local real y1
local group g=CreateGroup()
local real dmg=GetUnitAbilityLevel(caster,'A09R')*30+GetHeroInt(caster,true)
local unit u
local real dist
local real angle
if sec>0 then
call SaveReal(udg_hash,ht,0,sec-1)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,500,Condition(function Trig_Filter_ID))
if GetHeroLevel(caster)>=50 then
set dmg=dmg+.5*GetHeroInt(caster,true)
endif
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>8
set bj_forLoopBIndex=1
loop
exitwhen bj_forLoopBIndex>3
set dist=GetRandomReal(30,490)
set angle=GetRandomReal(bj_forLoopAIndex*45,(bj_forLoopAIndex+1)*45)
set x1=x+dist*Cos(angle*bj_DEGTORAD)
set y1=y+dist*Sin(angle*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Environment\\UndeadBuildingFire\\UndeadLargeBuildingFire1.mdl",x1,y1))
set bj_forLoopBIndex=bj_forLoopBIndex+1
endloop
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
call DestroyGroup(g)
set t=null
set caster=null
set g=null
set u=null
endfunction
function Trig_Med1_E_F takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local real dmg=LoadReal(udg_hash,ht,0)
local real x=LoadReal(udg_hash,ht,1)
local real y=LoadReal(udg_hash,ht,2)
local real x1=LoadReal(udg_hash,ht,3)
local real y1=LoadReal(udg_hash,ht,4)
local group g=CreateGroup()
local unit u
local unit dummy
local integer a
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x1,y1,265.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
set dummy=CreateUnit(GetOwningPlayer(caster),'h03L',x,y,GetUnitFacing(caster))
call UnitApplyTimedLife(dummy,'BTLF',3.)
set a=SeekFreeDummysMin(dummy,GetHandleId(dummy))
set s__Dummys_dmg[sDummy[a]]=dmg
call IssueTargetOrder(dummy,"attack",u)
call GroupRemoveUnit(g,u)
endloop
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
call DestroyGroup(g)
set t=null
set caster=null
set g=null
set dummy=null
set u=null
endfunction
function Trig_Med1_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
call UnitRemoveAbility(caster,'A09V')
call UnitRemoveAbility(caster,'Aroc')
call UnitRemoveAbility(caster,'A0M1')
call SetUnitVertexColor(caster,255,255,255,255)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set t=null
set caster=null
endfunction
function Trig_Med1_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local real x
local real y
local real x1
local real y1
local group g=CreateGroup()
local unit u
local unit u2
local real dmg
local timer t
local integer ht
local integer a
local real angle
if GetSpellAbilityId()=='A09P' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveReal(udg_hash,ht,0,GetUnitAbilityLevel(caster,'A09P')*3+3)
set x1=x+400.*Cos(0.*bj_DEGTORAD)
set y1=y+400.*Sin(0.*bj_DEGTORAD)
call SaveDestructableHandle(udg_hash,ht,11,CreateDestructable('Dofw',x1,y1,0,1,0))
set x1=x+400.*Cos(180.*bj_DEGTORAD)
set y1=y+400.*Sin(180.*bj_DEGTORAD)
call SaveDestructableHandle(udg_hash,ht,12,CreateDestructable('Dofw',x1,y1,0,1,0))
set x1=x+400.*Cos(90.*bj_DEGTORAD)
set y1=y+400.*Sin(90.*bj_DEGTORAD)
call SaveDestructableHandle(udg_hash,ht,13,CreateDestructable('Dofw',x1,y1,90,1,0))
set x1=x+400.*Cos(270.*bj_DEGTORAD)
set y1=y+400.*Sin(270.*bj_DEGTORAD)
call SaveDestructableHandle(udg_hash,ht,14,CreateDestructable('Dofw',x1,y1,90,1,0))
set x1=x+565.*Cos(45.*bj_DEGTORAD)
set y1=y+565.*Sin(45.*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl",x1,y1))
set x1=x+565.*Cos(135.*bj_DEGTORAD)
set y1=y+565.*Sin(135.*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl",x1,y1))
set x1=x+565.*Cos(225.*bj_DEGTORAD)
set y1=y+565.*Sin(225.*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl",x1,y1))
set x1=x+565.*Cos(315.*bj_DEGTORAD)
set y1=y+565.*Sin(315.*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl",x1,y1))
call SaveReal(udg_hash,ht,1,x)
call SaveReal(udg_hash,ht,2,y)
call TimerStart(t,1,true,function Trig_Med1_Q)
elseif GetSpellAbilityId()=='A09Q' then
set dmg=3*GetHeroInt(caster,true)
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+dmg)
elseif GetSpellAbilityId()=='A09T' then
set dmg=GetUnitAbilityLevel(caster,'A09T')*50.+GetHeroInt(caster,true)
if GetUnitAbilityLevel(caster,'A0C4')==1 then
set dmg=dmg+1.5*GetHeroInt(caster,true)
endif
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set x1=GetSpellTargetX()
set y1=GetSpellTargetY()
call SeekMinDummys()
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x1,y1,265.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
set u2=CreateUnit(GetOwningPlayer(caster),'h03L',x,y,GetUnitFacing(caster))
call UnitApplyTimedLife(u2,'BTLF',3)
set a=SeekFreeDummysMin(u2,GetHandleId(u2))
set s__Dummys_dmg[sDummy[a]]=dmg
call IssueTargetOrder(u2,"attack",u)
call GroupRemoveUnit(g,u)
endloop
if GetUnitAbilityLevel(caster,'Aroc')==1 then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveReal(udg_hash,ht,1,x)
call SaveReal(udg_hash,ht,2,y)
call SaveReal(udg_hash,ht,3,x1)
call SaveReal(udg_hash,ht,4,y1)
call SaveReal(udg_hash,ht,0,dmg)
call TimerStart(t,.2,false,function Trig_Med1_E_F)
endif
elseif GetSpellAbilityId()=='A09R' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveReal(udg_hash,ht,0,10)
call SaveReal(udg_hash,ht,1,x)
call SaveReal(udg_hash,ht,2,y)
call TimerStart(t,1.,true,function Trig_Med1_W)
elseif GetSpellAbilityId()=='A09U' then
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UDeathMedium\\UDeath.mdl",GetUnitX(caster),GetUnitY(caster)))
call UnitAddAbility(caster,'A09V')
call UnitAddAbility(caster,'Aroc')
call UnitAddAbility(caster,'A0M1')
call TempStats(caster,0,0,GetHeroInt(caster,false),0,0,0,PositiveDuration(caster,20))
call SetUnitVertexColor(caster,140,200,140,255)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,PositiveDuration(caster,20),false,function Trig_Med1_R)
endif
call DestroyGroup(g)
set caster=null
set u=null
set u2=null
set g=null
set t=null
endfunction
function InitTrig_Med1 takes nothing returns nothing
set gg_trg_Med1=CreateTrigger()
call TriggerAddAction(gg_trg_Med1,function Trig_Med1_Actions)
endfunction
function Trig_Berserk_D takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
call UnitRemoveAbility(caster,'A0Y8')
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set t=null
set caster=null
endfunction
function Trig_Berserk_Q takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(hero)
local effect e=LoadEffectHandle(udg_hash,ht,1)
local effect e1=LoadEffectHandle(udg_hash,ht,2)
if LoadBoolean(udg_hash,ht,3)then
call SaveReal(udg_hash,h,StringHash("Modificator"),LoadReal(udg_hash,h,StringHash("Modificator"))-0.5)
endif
call DestroyEffect(e)
call DestroyEffect(e1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set hero=null
set e1=null
set e=null
set t=null
endfunction
function Trig_Berserk_W takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local real dmg=LoadReal(udg_hash,ht,0)
local real x=LoadReal(udg_hash,ht,1)
local real y=LoadReal(udg_hash,ht,2)
local group g=CreateGroup()
local unit u
local integer h=GetHandleId(caster)
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local attacktype at=ATTACK_TYPE_NORMAL
local damagetype dt=DAMAGE_TYPE_MAGIC
if udg_Talante[ID]==1 then
set at=ATTACK_TYPE_NORMAL
set dt=DAMAGE_TYPE_UNIVERSAL
elseif udg_Talante[ID]==3 then
set at=ATTACK_TYPE_CHAOS
set dt=DAMAGE_TYPE_NORMAL
call FoTDeath(caster,x,y,false)
endif
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,300.,Condition(function Trig_Filter_ID))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,at,dt,WEAPON_TYPE_AXE_MEDIUM_CHOP)
if not UnitAlive(u)then
set udg_BersDMG=udg_BersDMG+6
endif
call GroupRemoveUnit(g,u)
endloop
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
call DestroyGroup(g)
set t=null
set caster=null
set u=null
set g=null
set at=null
set dt=null
endfunction
function Trig_Berserk_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local real sec=LoadReal(udg_hash,ht,0)-0.5
local integer h=GetHandleId(caster)
local integer a=LoadInteger(Hash,h,0)
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
if sec>0 then
call SaveReal(udg_hash,ht,0,sec)
if udg_Talante[ID]==3 then
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+0.02*GetUnitState(caster,UNIT_STATE_MAX_LIFE))
endif
else
call SaveBoolean(udg_hash,h,StringHash("BersR1"),false)
set s__Units_AllDmg[sUnit[a]]=s__Units_AllDmg[sUnit[a]]-2500
set s__Units_Immortal[sUnit[a]]=s__Units_Immortal[sUnit[a]]-1
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
set caster=null
endfunction
function Trig_Berserk_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer h=GetHandleId(caster)
local integer ihh=LoadInteger(udg_hash,h,5)
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local unit u
local real x
local real y
local real x1
local real y1
local real r
local group g=CreateGroup()
local real dmg
local timer t
local integer ht
local integer a
local integer b
local boolean Bool=false
if GetSpellAbilityId()=='A09Y' then
set a=40*GetUnitAbilityLevel(caster,'A09Y')+GetHeroAgi(caster,false)/5
set b=0
if udg_Talante[ID]==1 and GetUnitAbilityLevel(caster,'A0BU')==1 then
set a=a+s__Heroes_BaseDmg[sHero[ihh]]/5
elseif udg_Talante[ID]==2 then
set a=a+GetHeroAgi(caster,false)/10
if GetUnitAbilityLevel(caster,'A0BU')==1 then
call SaveReal(udg_hash,h,StringHash("Modificator"),LoadReal(udg_hash,h,StringHash("Modificator"))+0.5)
set Bool=true
endif
elseif udg_Talante[ID]==3 then
set b=a
endif
call TempStats(caster,b,a,0,0,0,0,PositiveDuration(caster,14))
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Weapons\\SerpentWardMissile\\SerpentWardMissile.mdl",caster,"hand left")
call SaveEffectHandle(udg_hash,ht,1,bj_lastCreatedEffect)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Weapons\\SerpentWardMissile\\SerpentWardMissile.mdl",caster,"hand right")
call SaveEffectHandle(udg_hash,ht,2,bj_lastCreatedEffect)
call SaveBoolean(udg_hash,ht,3,Bool)
call TimerStart(t,PositiveDuration(caster,14),false,function Trig_Berserk_Q)
elseif GetSpellAbilityId()=='A0KU' then
if udg_Talante[ID]==1 then
call SaveBoolean(udg_hash,h,StringHash("BersR1"),true)
endif
set a=LoadInteger(Hash,h,0)
set s__Units_AllDmg[sUnit[a]]=s__Units_AllDmg[sUnit[a]]+2500
set s__Units_Immortal[sUnit[a]]=s__Units_Immortal[sUnit[a]]+1
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveReal(udg_hash,ht,0,PositiveDuration(caster,10.))
call TimerStart(t,.5,true,function Trig_Berserk_R)
elseif GetSpellAbilityId()=='A0A1' then
set dmg=GetUnitAbilityLevel(caster,'A0A1')*80+2*GetHeroAgi(caster,true)+I2R(udg_BersDMG)
if udg_Talante[ID]==1 and GetHeroLevel(caster)>=50 then
set dmg=dmg+Summ_Attack(caster)
elseif udg_Talante[ID]==2 then
set dmg=dmg*(1+LoadReal(udg_hash,h,StringHash("Modificator")))
elseif udg_Talante[ID]==3 and GetHeroLevel(caster)>=50 then
set dmg=dmg+.8*GetUnitState(caster,UNIT_STATE_MAX_LIFE)
endif
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set x1=GetSpellTargetX()
set y1=GetSpellTargetY()
set u=CreateUnit(GetOwningPlayer(caster),'h020',x,y,GetUnitFacing(caster))
call IssuePointOrder(u,"attackground",x1,y1)
call UnitApplyTimedLife(u,'BTLF',.75)
set x=x-x1
set y=y-y1
set r=SquareRoot(x*x+y*y)/800.
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveReal(udg_hash,ht,0,dmg)
call SaveReal(udg_hash,ht,1,x1)
call SaveReal(udg_hash,ht,2,y1)
call TimerStart(t,r,false,function Trig_Berserk_W)
elseif GetSpellAbilityId()=='A0A2' then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set dmg=40+4*GetHeroAgi(caster,true)
call GroupEnumUnitsInRange(g,x,y,750,Condition(function FilterAlive))
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitAlly(u,GetOwningPlayer(caster))then
call Heal(true,dmg,u,caster)
endif
call GroupRemoveUnit(g,u)
endloop
if GetHeroLevel(caster)<50 then
elseif udg_Talante[ID]==1 then
call UnitAddAbility(caster,'A0Y8')
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,PositiveDuration(caster,9),false,function Trig_Berserk_D)
elseif udg_Talante[ID]==3 then
call FoTDeath(caster,GetUnitX(caster),GetUnitY(caster),false)
endif
endif
set caster=null
set u=null
call DestroyGroup(g)
set g=null
set t=null
endfunction
function InitTrig_Berserk takes nothing returns nothing
set gg_trg_Berserk=CreateTrigger()
call TriggerAddAction(gg_trg_Berserk,function Trig_Berserk_Actions)
endfunction
function Trig_BooksBers_Conditions takes nothing returns boolean
if(not(GetItemType(GetManipulatedItem())==ITEM_TYPE_POWERUP))then
return false
endif
return true
endfunction
function Trig_BooksBers_Actions takes nothing returns nothing
set udg_BersDMG=(udg_BersDMG+15)
endfunction
function InitTrig_BooksBers takes nothing returns nothing
set gg_trg_BooksBers=CreateTrigger()
call TriggerAddAction(gg_trg_BooksBers,function Trig_BooksBers_Actions)
endfunction
function Trig_killer_Daggers takes unit caster,real x,real y,integer number returns nothing
local integer id=GetPlayerId(GetOwningPlayer(caster))
local integer talante=udg_Talante[id+1]
local unit u
local real dmg=GetUnitAbilityLevel(caster,'AEfk')*200.00-100.00+GetHeroAgi(caster,true)
local group g=CreateGroup()
if talante==2 then
set dmg=dmg+GetHeroAgi(caster,true)
if GetUnitAbilityLevel(caster,'A0BT')==1 then
set dmg=dmg+2*GetHeroAgi(caster,true)
endif
endif
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,500.00,Bool_Filter_ID)
call RandomUnitFromGroup(number,g)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
call CreateTextTagUnitBJ(("|cFF199619"+I2S(R2I(dmg))),u,0,10.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,90.00)
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
set g=null
set u=null
endfunction
function Trig_killer_W takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,h,0)
local integer a=LoadInteger(Hash,GetHandleId(caster),0)
set s__Units_AllBlock[sUnit[a]]=s__Units_AllBlock[sUnit[a]]-1000
call FlushChildHashtable(udg_hash,h)
call PauseTimer(t)
call DestroyTimer(t)
set caster=null
set t=null
endfunction
function Trig_killer_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(caster)
local integer a=LoadInteger(udg_hash,ht,1)
local effect e=LoadEffectHandle(udg_hash,ht,2)
local effect e2=LoadEffectHandle(udg_hash,ht,3)
local integer ihh=LoadInteger(udg_hash,h,5)
set s__Heroes_TempAgi[sHero[ihh]]=s__Heroes_TempAgi[sHero[ihh]]-a
call F_Stats(caster)
call UnitRemoveAbility(caster,'Apiv')
call DestroyEffect(e)
call DestroyEffect(e2)
set s__Heroes_MS[sHero[ihh]]=s__Heroes_MS[sHero[ihh]]-1000.
call SetUnitMoveSpeed(caster,GetUnitDefaultMoveSpeed(caster)+s__Heroes_MS[sHero[ihh]])
call SetUnitVertexColor(caster,255,255,255,255)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set caster=null
set e=null
set e2=null
set t=null
endfunction
function Trig_killer_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer h=GetHandleId(caster)
local integer ihh=LoadInteger(udg_hash,h,5)
local integer id=GetPlayerId(GetOwningPlayer(caster))
local integer talante=udg_Talante[id+1]
local integer a
local integer b
local integer c
local timer t
local integer ht
local real dmg
local real x
local real y
local real r
local effect e
local effect e2
if GetSpellAbilityId()=='AEfk' then
if talante==1 then
set c=GetHeroAgi(caster,true)-(3*s__Heroes_TempAgi[sHero[ihh]])/4
set r=.5+0.5*LoadReal(udg_hash,h,4)
set a=20*GetUnitAbilityLevel(caster,'AEfk')+R2I(.2*c*r)
if GetUnitAbilityLevel(caster,'A0BT')==1 then
set a=R2I((a+0.2*c)*r)
set b=125*GetUnitAbilityLevel(caster,'AEfk')+2*c
else
set b=0
endif
call TempStats(caster,0,0,0,a,0,b,PositiveDuration(caster,8.))
endif
set dmg=40*GetUnitAbilityLevel(caster,'AEfk')+GetHeroAgi(caster,true)
if talante==2 then
set dmg=2*dmg
endif
if GetUnitAbilityLevel(caster,'A0BT')==1 then
set a=8
else
set a=2
endif
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set r=500.
call GroupDamage(x,y,r,caster,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
call Trig_killer_Daggers(caster,x,y,a)
endif
if GetSpellAbilityId()=='AEbl' then
set dmg=200.*GetUnitAbilityLevel(caster,'AEbl')+2.*GetHeroAgi(caster,true)
if GetHeroLevel(caster)>50 then
set dmg=dmg+0.5*GetHeroAgi(caster,true)
endif
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+dmg)
if udg_ReactorAganim[id+1]then
call SaveBoolean(udg_hash,h,'d',true)
endif
if talante==2 then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
if GetUnitAbilityLevel(caster,'A0BT')==1 then
set a=4
else
set a=2
endif
call Trig_killer_Daggers(caster,x,y,a)
if GetUnitAbilityLevel(caster,'A0BT')==1 then
set a=LoadInteger(Hash,GetHandleId(caster),0)
set s__Units_AllBlock[sUnit[a]]=s__Units_AllBlock[sUnit[a]]+1000
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,3.,false,function Trig_killer_W)
endif
endif
endif
if GetSpellAbilityId()=='A0A5' then
if talante==1 then
set r=30.
else
set r=25.
endif
set r=PositiveDuration(caster,r)
set a=GetHeroAgi(caster,false)
set s__Heroes_TempAgi[sHero[ihh]]=s__Heroes_TempAgi[sHero[ihh]]+a
call F_Stats(caster)
call UnitAddAbility(caster,'Apiv')
call SetUnitVertexColor(caster,130,130,130,130)
set e=AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl",caster,"hand left")
set e2=AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl",caster,"hand right")
call SetUnitMoveSpeed(caster,GetUnitDefaultMoveSpeed(caster)+s__Heroes_MS[sHero[ihh]])
set s__Heroes_MS[sHero[ihh]]=s__Heroes_MS[sHero[ihh]]+1000.
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveInteger(udg_hash,ht,1,a)
call SaveEffectHandle(udg_hash,ht,2,e)
call SaveEffectHandle(udg_hash,ht,3,e2)
call TimerStart(t,r,false,function Trig_killer_R)
if GetUnitAbilityLevel(caster,'A0BT')==1 then
call Trig_killer_Euphoria(caster,r)
endif
endif
set caster=null
set t=null
set e=null
set e2=null
endfunction
function InitTrig_killer takes nothing returns nothing
set gg_trg_killer=CreateTrigger()
call TriggerAddAction(gg_trg_killer,function Trig_killer_Actions)
endfunction
function Trig_WardenAtk_Conditions takes nothing returns boolean
if(not(IsUnitEnemy(GetTriggerUnit(),GetOwningPlayer(GetAttacker()))==true))then
return false
endif
if(not(GetAttacker()==udg_Warden))then
return false
endif
return true
endfunction
function Trig_WardenAtk_Actions takes nothing returns nothing
local unit hero=GetTriggerUnit()
local integer id=GetPlayerId(GetOwningPlayer(hero))
local unit u
local real x
local real y
local real dmg
local group g=CreateGroup()
if GetTriggerUnit()==udg_WardenTarget then
if GetUnitAbilityLevel(udg_Warden,'A0BT')==1 then
if udg_WardenAgi>=150 then
if GetUnitAbilityLevel(hero,'A0BT')==1 then
call Trig_killer_Euphoria(hero,0.25)
endif
else
set udg_WardenAgi=udg_WardenAgi+3
call SetHeroAgi(udg_Warden,GetHeroAgi(udg_Warden,false)+3,true)
if LoadBoolean(udg_hash,GetHandleId(udg_Warden),'d')then
call SetHeroAgi(udg_Warden,GetHeroAgi(udg_Warden,false)+150-udg_WardenAgi,true)
set udg_WardenAgi=150
call SaveBoolean(udg_hash,GetHandleId(udg_Warden),'d',false)
endif
endif
else
if udg_WardenAgi==50 then
else
set udg_WardenAgi=udg_WardenAgi+2
call SetHeroAgi(udg_Warden,GetHeroAgi(udg_Warden,false)+2,true)
endif
endif
else
if GetUnitAbilityLevel(udg_Warden,'A0BT')==1 then
call SetHeroAgi(udg_Warden,GetHeroAgi(udg_Warden,false)-udg_WardenAgi,true)
set udg_WardenAgi=0
set udg_WardenAgi=udg_WardenAgi+3
call SetHeroAgi(udg_Warden,GetHeroAgi(udg_Warden,false)+3,true)
set udg_WardenTarget=GetTriggerUnit()
if LoadBoolean(udg_hash,GetHandleId(udg_Warden),'d')then
call SetHeroAgi(udg_Warden,GetHeroAgi(udg_Warden,false)+150-udg_WardenAgi,true)
set udg_WardenAgi=150
call SaveBoolean(udg_hash,GetHandleId(udg_Warden),'d',false)
endif
else
call SetHeroAgi(udg_Warden,GetHeroAgi(udg_Warden,false)-udg_WardenAgi,true)
set udg_WardenAgi=0
set udg_WardenAgi=(udg_WardenAgi+2)
call SetHeroAgi(udg_Warden,GetHeroAgi(udg_Warden,false)+2,true)
set udg_WardenTarget=GetTriggerUnit()
endif
endif
set u=null
call DestroyGroup(g)
set g=null
endfunction
function InitTrig_WardenAtk takes nothing returns nothing
local integer index
set gg_trg_WardenAtk=CreateTrigger()
set index=0
loop
call TriggerRegisterPlayerUnitEvent(gg_trg_WardenAtk,Player(index),EVENT_PLAYER_UNIT_ATTACKED,null)
set index=index+1
exitwhen index==bj_MAX_PLAYER_SLOTS
endloop
call DisableTrigger(gg_trg_WardenAtk)
call TriggerAddCondition(gg_trg_WardenAtk,Condition(function Trig_WardenAtk_Conditions))
call TriggerAddAction(gg_trg_WardenAtk,function Trig_WardenAtk_Actions)
endfunction
function Trig_RockDefender_Q takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,h,0)
local real dmg=LoadReal(udg_hash,h,1)
local real x=LoadReal(udg_hash,h,2)
local real y=LoadReal(udg_hash,h,3)
local group g=CreateGroup()
local unit u
set udg_Drop2=GetPlayerId(GetOwningPlayer(hero))
call GroupEnumUnitsInRange(g,x,y,300.,Bool_Filter_ID)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(hero),'h009',x,y,0)
call UnitAddAbility(bj_lastCreatedUnit,'A00H')
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',0.75)
call IssueTargetOrder(bj_lastCreatedUnit,"thunderbolt",u)
call GroupRemoveUnit(g,u)
endloop
call FlushChildHashtable(udg_hash,h)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
set hero=null
set g=null
set t=null
endfunction
function Trig_RockDefender_W takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local group g=LoadGroupHandle(udg_hash,ht,0)
local real sec=LoadReal(udg_hash,ht,1)
local real xp=LoadReal(udg_hash,ht,2)
local real yp=LoadReal(udg_hash,ht,3)
local unit u
local real x
local real y
local real angle
local group g2=CreateGroup()
if sec<0.25 then
set sec=sec+0.05
call SaveReal(udg_hash,ht,1,sec)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)then
set x=GetUnitX(u)
set y=GetUnitY(u)
call SetUnitX(u,x+20.)
if x !=GetUnitX(u)then
set angle=bj_RADTODEG*Atan2(y-yp,x-xp)
set x=x+50.*Cos(angle*bj_DEGTORAD)
set y=y+50.*Sin(angle*bj_DEGTORAD)
call SetUnitPosition(u,x,y)
endif
call GroupAddUnit(g2,u)
endif
call GroupRemoveUnit(g,u)
endloop
call SaveGroupHandle(udg_hash,ht,0,g2)
else
call DestroyGroup(g2)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
call DestroyGroup(g)
set t=null
set g=null
set g2=null
endfunction
function Trig_RockDefender_E takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(caster)
local real x
local real y
local real dmg
local real x1
local real y1
local integer a
call UnitRemoveAbility(caster,'A184')
if GetUnitAbilityLevel(caster,'A0BB')==1 then
set udg_RockDefender50=false
else
endif
call SetUnitVertexColor(caster,255,255,255,255)
if GetUnitState(caster,UNIT_STATE_LIFE)>(udg_RockDefenderE*0.50)then
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)-0.5*udg_RockDefenderE)
else
call SetUnitState(caster,UNIT_STATE_LIFE,1.)
endif
call CreateTextTagUnitBJ(("|c00FF0000"+(I2S(R2I(udg_RockDefenderE))+" урона")),caster,0,10.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call ShowTextTagForceBJ(false,udg_TEXT,GetPlayersAll())
call ShowTextTagForceBJ(true,udg_TEXT,bj_FORCE_PLAYER[GetPlayerId(GetOwningPlayer(caster))])
call SetTextTagVelocityBJ(udg_TEXT,75.00,90.00)
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set dmg=udg_RockDefenderE*(0.55+0.15*GetUnitAbilityLevel(caster,'A0UR'))
call GroupDamage(x,y,300.,caster,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
call SaveBoolean(udg_hash,GetHandleId(caster),'E',false)
set a=LoadInteger(Hash,h,0)
set s__Units_Immortal[sUnit[a]]=s__Units_Immortal[sUnit[a]]-1
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=10
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set x1=x+300.*Cos((36.*bj_forLoopAIndex)*bj_DEGTORAD)
set y1=y+300.*Sin((36.*bj_forLoopAIndex)*bj_DEGTORAD)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl",x1,y1)
call DestroyEffect(bj_lastCreatedEffect)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set udg_RockDefenderE=0.00
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set t=null
set caster=null
endfunction
function Trig_RockDefender_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local real sec=LoadReal(udg_hash,ht,0)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local real x=LoadReal(udg_hash,ht,1)
local real y=LoadReal(udg_hash,ht,2)
local real dist=LoadReal(udg_hash,ht,3)
local real x1
local real y1
local real dmg=LoadReal(udg_hash,ht,4)
local real angle
local integer random
local group g=CreateGroup()
local unit u
if sec>0 then
call SaveReal(udg_hash,ht,0,sec-0.03)
set angle=GetRandomReal(0,360)
set x1=x+dist*Cos(angle*bj_DEGTORAD)
set y1=y+dist*Sin(angle*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",x1,y1))
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x1,y1,300.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
set dist=dist+GetRandomReal(-7.00,18.00)
call SaveReal(udg_hash,ht,3,dist)
set random=GetRandomInt(1,3)
if random==1 then
set angle=GetRandomReal(0,360)
set x1=x+dist*Cos(angle*bj_DEGTORAD)
set y1=y+dist*Sin(angle*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",x1,y1))
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x1,y1,300.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
set dist=dist+GetRandomReal(-7.00,18.00)
call SaveReal(udg_hash,ht,3,dist)
endif
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
call DestroyGroup(g)
set g=null
set u=null
set t=null
set caster=null
endfunction
function Trig_RockDefender_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer h=GetHandleId(caster)
local real x
local real y
local real x1
local real y1
local real r
local real dmg
local group g
local group g2
local unit u
local integer a
local integer ht
local timer t
if GetSpellAbilityId()=='A0A8' then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set x1=GetSpellTargetX()
set y1=GetSpellTargetY()
set r=x1-x
set dmg=y1-y
set r=SquareRoot(r*r+dmg*dmg)/800.
set dmg=100.*GetUnitAbilityLevel(caster,'A0A8')+5.*GetHeroStr(caster,true)
set u=CreateUnit(GetOwningPlayer(caster),'h02P',x,y,GetUnitFacing(caster))
call UnitApplyTimedLife(u,'BTLF',1.)
call IssuePointOrder(u,"attackground",x1,y1)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveReal(udg_hash,ht,1,dmg)
call SaveReal(udg_hash,ht,2,x1)
call SaveReal(udg_hash,ht,3,y1)
call TimerStart(t,r,false,function Trig_RockDefender_Q)
endif
if GetSpellAbilityId()=='A0NL' then
set g=CreateGroup()
set g2=CreateGroup()
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set dmg=100.*GetUnitAbilityLevel(caster,'A0NL')+4.*GetHeroStr(caster,true)
if GetHeroLevel(caster)>=50 then
set dmg=dmg+2.5*GetHeroStr(caster,true)
call TempStats(caster,0,0,0,0,GetHeroStr(caster,true)/5,0,5.)
endif
set r=1.4*dmg
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,350.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if(GetUnitAbilityLevel(u,'BPSE')+GetUnitAbilityLevel(u,'BSTN'))>0 then
call UnitDamageTarget(caster,u,r,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
else
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
if UnitAlive(u)and IsUnitType(u,UNIT_TYPE_STRUCTURE)==false then
call GroupAddUnit(g2,u)
endif
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",caster,"origin")
call DestroyEffect(bj_lastCreatedEffect)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveGroupHandle(udg_hash,ht,0,g2)
call SaveReal(udg_hash,ht,1,0)
call SaveReal(udg_hash,ht,2,x)
call SaveReal(udg_hash,ht,3,y)
call TimerStart(t,0.05,true,function Trig_RockDefender_W)
else
endif
if GetSpellAbilityId()=='A0UR' then
set bj_lastCreatedItem=CreateItem('rma2',GetUnitX(caster),GetUnitY(caster))
call UnitAddItem(caster,bj_lastCreatedItem)
call SaveBoolean(udg_hash,GetHandleId(caster),'E',true)
set a=LoadInteger(Hash,h,0)
set s__Units_Immortal[sUnit[a]]=s__Units_Immortal[sUnit[a]]+1
call UnitAddAbility(caster,'A184')
if GetUnitAbilityLevel(caster,'A0BB')==1 then
set udg_RockDefender50=true
endif
call SetUnitVertexColor(caster,183,126,54,255)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\BattleRoar\\RoarCaster.mdl",caster,"origin")
call DestroyEffect(bj_lastCreatedEffect)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,6.,false,function Trig_RockDefender_E)
else
endif
if GetSpellAbilityId()=='A0AA' then
if udg_RockDefender50 then
set dmg=GetHeroStr(caster,true)
else
set dmg=GetHeroStr(caster,true)/2
endif
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveReal(udg_hash,ht,0,4.)
call SaveReal(udg_hash,ht,1,x)
call SaveReal(udg_hash,ht,2,y)
call SaveReal(udg_hash,ht,3,150.)
call SaveReal(udg_hash,ht,4,dmg)
call TimerStart(t,.03,true,function Trig_RockDefender_R)
endif
set caster=null
set u=null
set t=null
set g=null
set g2=null
endfunction
function InitTrig_RockDefender takes nothing returns nothing
set gg_trg_RockDefender=CreateTrigger()
call TriggerAddAction(gg_trg_RockDefender,function Trig_RockDefender_Actions)
endfunction
function Trig_Partizan_Conditions takes nothing returns boolean
