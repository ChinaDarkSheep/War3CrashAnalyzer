function Trig_ShinobiE_F takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local real sec=LoadReal(udg_hash,ht,0)-0.25
local boolean bool=LoadBoolean(udg_hash,ht,1)
local real xf=LoadReal(udg_hash,ht,2)
local real yf=LoadReal(udg_hash,ht,3)
local real x=GetUnitX(hero)-xf
local real y=GetUnitY(hero)-yf
if sec>0 then
call SaveReal(udg_hash,ht,0,sec)
if x>-350. and x<350. and y>-350. and y<350. then
if not bool then
call UnitAddAbility(hero,'A0S4')
endif
call SaveBoolean(udg_hash,ht,1,true)
else
if bool then
call UnitRemoveAbility(hero,'A0S4')
endif
call SaveBoolean(udg_hash,ht,1,false)
endif
else
if bool then
call UnitRemoveAbility(hero,'A0S4')
endif
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
set t=null
set hero=null
endfunction
function Trig_Shinobi_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer h=GetHandleId(caster)
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local unit u
local group g=CreateGroup()
local group g2=CreateGroup()
local integer lvl=GetHeroLevel(caster)
local integer lvla
local real x
local real y
local real x1
local real y1
local real x2
local real y2
local real r
local real angle
local real dmg
local real dmgUP=1.
local timer t
local integer ht
local integer a
local boolean fox=false
local boolean f=false
local integer iuh=LoadInteger(Hash,h,0)
if GetUnitAbilityLevel(caster,'A149')==1 then
set fox=true
if udg_Talante[ID]==2 then
set dmgUP=3.
else
set dmgUP=2.
endif
endif
if GetUnitAbilityLevel(caster,'A16Z')==1 then
set f=true
endif
if f and fox and udg_Talante[ID]==2 then
set x1=0.
if GetSpellAbilityId()=='A16K' or GetSpellAbilityId()=='A16L' or GetSpellAbilityId()=='A16M' or GetSpellAbilityId()=='A16S' or GetSpellAbilityId()=='A16P' or GetSpellAbilityId()=='A16Q' then
set x1=2.
elseif YesCD(GetSpellAbilityId())then
set x1=1.
endif
set y1=x1*(GetUnitState(caster,UNIT_STATE_MAX_LIFE)*.025+0.05*GetHeroAgi(caster,true))
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+y1)
set dmg=x1*.4*GetHeroAgi(caster,true)
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,425.,Condition(function Trig_Filter_ID))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
call GroupRemoveUnit(g,u)
endloop
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\ReplenishHealth\\ReplenishHealthCaster.mdl",x,y))
endif
if GetSpellAbilityId()=='A16K' then
if GetUnitAbilityLevel(caster,'A16I')==1 then
call UnitRemoveAbility(caster,'A16I')
call SetUnitAbilityLevel(caster,'A16K',2)
call UnitAddAbility(caster,'A149')
else
call SetUnitAbilityLevel(caster,'A16K',1)
call UnitRemoveAbility(caster,'A149')
call UnitAddAbility(caster,'A16I')
endif
elseif GetSpellAbilityId()=='A16L' or GetSpellAbilityId()=='A16M' then
set lvla=GetUnitAbilityLevel(caster,'A16N')
set dmg=40*lvla+1.*GetHeroAgi(caster,true)
if f then
set dmg=dmg+0.5*GetHeroAgi(caster,true)
endif
set dmg=dmgUP*dmg
if not fox and udg_Talante[ID]==1 then
if GetSpellAbilityId()=='A16L' then
set a=1
else
set a=2
endif
if a==1 then
call SetUnitAbilityLevel(caster,'A16J',lvla+1)
else
call SetUnitAbilityLevel(caster,'A16U',lvla+1)
endif
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveReal(udg_hash,ht,0,PositiveDuration(caster,8))
call SaveInteger(udg_hash,ht,1,a)
call TimerStart(t,0.1,true,function Trig_Shinobi_W_Dragon)
elseif fox and udg_Talante[ID]==1 then
set dmg=dmg*(1+LoadReal(udg_hash,h,StringHash("Modificator")))
endif
if GetSpellAbilityId()=='A16L' then
set a=0
loop
exitwhen a>7
call SetPlayerAbilityAvailable(Player(a),'A16L',false)
call SetPlayerAbilityAvailable(Player(a),'A16M',true)
set a=a+1
endloop
else
set a=0
loop
exitwhen a>7
call SetPlayerAbilityAvailable(Player(a),'A16L',true)
call SetPlayerAbilityAvailable(Player(a),'A16M',false)
set a=a+1
endloop
endif
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set x1=GetSpellTargetX()
set y1=GetSpellTargetY()
set x2=x1-x
set y2=y1-y
set r=SquareRoot(x2*x2+y2*y2)/9
set angle=bj_RADTODEG*Atan2(y1-y,x1-x)
set a=0
loop
exitwhen a>8
set x2=x+a*r*Cos(angle*bj_DEGTORAD)
set y2=y+a*r*Sin(angle*bj_DEGTORAD)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x2,y2,215.,Condition(function Trig_Filter_ID))
loop
set u=FirstOfGroup(g)
exitwhen u==null
if not IsUnitInGroup(u,g2)then
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupAddUnit(g2,u)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\HeroBloodElfBlood.mdl",u,"origin")
call DestroyEffect(bj_lastCreatedEffect)
endif
call GroupRemoveUnit(g,u)
endloop
set a=a+1
endloop
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,215.,Condition(function Trig_Filter_ID))
loop
set u=FirstOfGroup(g)
exitwhen u==null
if not IsUnitInGroup(u,g2)then
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupAddUnit(g2,u)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\HeroBloodElfBlood.mdl",u,"origin")
call DestroyEffect(bj_lastCreatedEffect)
endif
call GroupRemoveUnit(g,u)
endloop
if f and not fox and udg_Talante[ID]==1 then
set dmg=Summ_Attack(caster)
set x2=Psych_crit(caster,1.,1.)
if x2>1. then
set dmg=x2*dmg
endif
loop
set u=FirstOfGroup(g2)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g2,u)
endloop
elseif f and fox and udg_Talante[ID]==1 then
call RandomUnitFromGroup(6,g2)
loop
set u=FirstOfGroup(g2)
exitwhen u==null
call HeroAttack(caster,caster,u)
call Modificator(caster,caster,u)
call GroupRemoveUnit(g2,u)
endloop
elseif not fox and udg_Talante[ID]==2 then
set s__Units_Immortal[sUnit[iuh]]=s__Units_Immortal[sUnit[iuh]]+1
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,.75,false,function Trig_Shinobi_W2Dragon)
endif
elseif GetSpellAbilityId()=='A16S' then
set lvla=GetUnitAbilityLevel(caster,'A16S')
set dmg=dmgUP*(80*lvla+1.5*GetHeroAgi(caster,true))
set u=GetSpellTargetUnit()
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set x1=GetUnitX(u)-x
set y1=GetUnitY(u)-y
set r=SquareRoot(x1*x1+y1*y1)/1050.
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveUnitHandle(udg_hash,ht,1,u)
call SaveReal(udg_hash,ht,2,dmg)
call SaveReal(udg_hash,ht,0,r)
call SaveBoolean(udg_hash,ht,3,true)
call TimerStart(t,0.15,true,function Trig_Shinobi_QBoom)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\HeroBloodElfBlood.mdl",u,"origin")
call DestroyEffect(bj_lastCreatedEffect)
elseif GetSpellAbilityId()=='A16Q' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set dmg=dmgUP*(5*GetHeroAgi(caster,true)+GetHeroInt(caster,true))
set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\NewDirtEXNofire.mdx",x,y)
call DestroyEffect(bj_lastCreatedEffect)
call GroupDamage(x,y,325.,caster,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
elseif GetSpellAbilityId()=='A16P' then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set x1=GetSpellTargetX()
set y1=GetSpellTargetY()
set u=CreateUnit(GetOwningPlayer(caster),'h059',x,y,GetUnitFacing(caster))
call UnitApplyTimedLife(u,'BTLF',14.)
call IssuePointOrder(u,"cloudoffog",x1,y1)
if fox and udg_Talante[ID]==2 then
set dmg=.5*(25.*GetUnitAbilityLevel(caster,'A16P')+0.6*GetHeroAgi(caster,true))
if GetHeroLevel(caster)>=50 then
set dmg=2.*dmg
endif
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveInteger(udg_hash,ht,1,24)
call SaveReal(udg_hash,ht,2,dmg)
call SaveReal(udg_hash,ht,3,x1)
call SaveReal(udg_hash,ht,4,y1)
call TimerStart(t,0.5,true,function Trig_ShinobiE_Timer)
endif
if not fox and udg_Talante[ID]==2 then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveReal(udg_hash,ht,0,12.)
call SaveBoolean(udg_hash,ht,1,false)
call SaveReal(udg_hash,ht,2,x)
call SaveReal(udg_hash,ht,3,y)
call TimerStart(t,.25,true,function Trig_ShinobiE_F)
endif
elseif GetSpellAbilityId()=='A1ET' then
if not fox then
call SaveInteger(udg_hash,h,StringHash("SinobyR1"),11)
call UnitAddAbility(caster,'A11Q')
call SetUnitAbilityLevel(caster,'A11Q',2)
else
call SaveInteger(udg_hash,h,StringHash("SinobyR1"),12)
endif
set a=50+GetHeroAgi(caster,true)/5
set s__Units_Arm[sUnit[iuh]]=s__Units_Arm[sUnit[iuh]]+a
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveInteger(udg_hash,ht,0,a)
call TimerStart(t,30.,false,function Trig_ShinobiR1)
endif
call DestroyGroup(g)
call DestroyGroup(g2)
set g=null
set g2=null
set caster=null
set u=null
endfunction
