set udg_BossAmount[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]=udg_BossAmount[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]+1
set udg_Drop=ModuloInteger(GetPlayerTechCountSimple('R056',Player(bj_PLAYER_NEUTRAL_VICTIM)),3)
if udg_Drop==0 then
call SetPlayerTechResearchedSwap('R056',(GetPlayerTechCountSimple('R056',Player(PLAYER_NEUTRAL_AGGRESSIVE))+1),Player(PLAYER_NEUTRAL_AGGRESSIVE))
