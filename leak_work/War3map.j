if a==1 then
set name='envl'
elseif a>=2 and a<=4 then
set name='sbch'
elseif a>=5 and a<=8 then
set name='mgtk'
else
set name='pmna'
endif
endif
elseif phase==4 then
set b=GetRandomInt(1,100)
if b<20 then
set a=GetRandomInt(1,12)
if a>=1 and a<=3 then
set name='amrc'
elseif a>=5 and a<=8 then
set name='cnob'
elseif a>=7 and a<=10 then
set name='spsh'
else
set name='ward'
endif
elseif b<60 then
set a=GetRandomInt(1,10)
if a==1 then
set name='gobm'
elseif a>=2 and a<=4 then
set name='dsum'
elseif a>=5 and a<=8 then
set name='wolg'
else
set name='penr'
endif
elseif b<90 then
