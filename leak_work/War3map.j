function Trig_Secret9_Skill_Actions takes nothing returns nothing
local timer t
call DisableTrigger(GetTriggeringTrigger())
set udg_point=GetUnitLoc(udg_Alkap)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=3
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set udg_p=PolarProjectionBJ(udg_point,500.00,((I2R(GetForLoopIndexA())*120.00)+GetUnitFacing(udg_Alkap)))
call CreateNUnitsAtLoc(1,'h03Z',Player(PLAYER_NEUTRAL_AGGRESSIVE),udg_p,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(3.50,'BTLF',GetLastCreatedUnit())
call RemoveLocation(udg_p)
set udg_p=PolarProjectionBJ(udg_point,250.00,((I2R(GetForLoopIndexA())*120.00)+(GetUnitFacing(udg_Alkap)+60.00)))
call CreateNUnitsAtLoc(1,'h03Z',Player(PLAYER_NEUTRAL_AGGRESSIVE),udg_p,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(3.50,'BTLF',GetLastCreatedUnit())
call RemoveLocation(udg_p)
set udg_p=PolarProjectionBJ(udg_point,433.01,((I2R(GetForLoopIndexA())*120.00)+(GetUnitFacing(udg_Alkap)+30.00)))
call CreateNUnitsAtLoc(1,'h03Z',Player(PLAYER_NEUTRAL_AGGRESSIVE),udg_p,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(3.50,'BTLF',GetLastCreatedUnit())
call RemoveLocation(udg_p)
set udg_p=PolarProjectionBJ(udg_point,433.01,((I2R(GetForLoopIndexA())*120.00)+(GetUnitFacing(udg_Alkap)+90.00)))
call CreateNUnitsAtLoc(1,'h03Z',Player(PLAYER_NEUTRAL_AGGRESSIVE),udg_p,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(3.50,'BTLF',GetLastCreatedUnit())
call RemoveLocation(udg_p)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call RemoveLocation(udg_point)
set t=CreateTimer()
call SaveTriggerHandle(udg_hash,GetHandleId(t),0,GetTriggeringTrigger())
call TimerStart(t,12.,false,function gg_trg_Secret9_Timer)
set t=null
endfunction
