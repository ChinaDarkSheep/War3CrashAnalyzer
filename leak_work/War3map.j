function Trig_CreepSpell_FrostArmore takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit target=LoadUnitHandle(udg_hash,ht,0)
local integer armore=LoadInteger(udg_hash,ht,1)
local real sec=LoadReal(udg_hash,ht,2)
local integer h=GetHandleId(target)
local integer iut=LoadInteger(Hash,h,0)
if sec>0 then
set sec=sec-0.25
call SaveReal(udg_hash,ht,2,sec)
else
call SaveTimerHandle(udg_hash,h,StringHash("FrostArmore"),null)
set s__Units_Arm[sUnit[iut]]=s__Units_Arm[sUnit[iut]]-armore
call F_Armore(target,s__Units_Arm[sUnit[iut]])
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
set target=null
endfunction
function CreepSpell_FrostArrow takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local unit target=LoadUnitHandle(udg_hash,ht,1)
local real dmg=LoadReal(udg_hash,ht,1)
call UnitDamageTarget(caster,target,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set caster=null
set t=null
endfunction
function CreepSpell_NineWall takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(Hash,ht,0)
local group g2=LoadGroupHandle(Hash,ht,10)
local real sec=LoadReal(Hash,ht,0)
local real x=LoadReal(Hash,ht,1)
local real y=LoadReal(Hash,ht,2)
local real dmg=LoadReal(Hash,ht,3)
local real angle=LoadReal(Hash,ht,4)
local real range=LoadReal(Hash,ht,5)+40
local group g=CreateGroup()
local unit u
if sec>0 then
set x=x+90*Cos(angle*bj_DEGTORAD)
set y=y+90*Sin(angle*bj_DEGTORAD)
call SaveReal(Hash,ht,1,x)
call SaveReal(Hash,ht,2,y)
call SaveReal(Hash,ht,0,sec-0.1)
call SaveReal(Hash,ht,5,range)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,range,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if not IsUnitInGroup(u,g2)then
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupAddUnit(g2,u)
endif
call GroupRemoveUnit(g,u)
endloop
else
call DestroyGroup(g2)
call FlushChildHashtable(Hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
call DestroyGroup(g)
set g=null
set g2=null
set caster=null
set u=null
set t=null
endfunction
function Trig_CreepSpell_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local unit u
local timer t
local integer ht
local integer h
local real xc=GetUnitX(caster)
local real yc=GetUnitY(caster)
local real x
local real y
local real x1
local real y1
local real r
local real z
local real dmg
local integer lvl=GetUnitLevel(caster)
local integer a
local integer b
local group g=CreateGroup()
if ID<=8 then
if GetSpellAbilityId()=='A1EX' then
call SetUnitPosition(udg_Hero[ID],xc,yc)
endif
if GetSpellAbilityId()=='A1EB' then
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='tlum' then
set x1=GetSpellTargetX()
set y1=GetSpellTargetY()
set u=CreateUnit(GetOwningPlayer(caster),'h049',x1,y1,GetUnitFacing(caster))
call UnitAddAbility(u,'A16W')
call UnitApplyTimedLife(u,'BTLF',20)
endif
if not IsUnitInGroup(udg_Hero[ID],udg_HeroBuild)then
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='pams' then
call SetUnitPosition(udg_Hero[ID],GetSpellTargetX(),GetSpellTargetY())
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl",GetUnitX(udg_Hero[ID]),GetUnitY(udg_Hero[ID]))
call DestroyEffect(bj_lastCreatedEffect)
elseif GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='azhr' then
set x=GetUnitX(udg_Hero[ID])
set y=GetUnitY(udg_Hero[ID])
set x1=GetSpellTargetX()
set y1=GetSpellTargetY()
set r=bj_RADTODEG*Atan2(y1-y,x1-x)
call KnockBackUnit(udg_Hero[ID],1200,1,r,0.03)
endif
endif
endif
if GetSpellAbilityId()=='ACcb' then
set x=GetSpellTargetX()-GetUnitX(GetTriggerUnit())
set y=GetSpellTargetY()-GetUnitY(GetTriggerUnit())
set y=SquareRoot(x*x+y*y)/3000.
set x=2.*GetHeroInt(udg_Hero[ID],true)
if GetUnitAbilityLevel(caster,'A17Z')==1 then
set x=x*6
endif
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,GetTriggerUnit())
call SaveUnitHandle(udg_hash,ht,1,GetSpellTargetUnit())
call SaveReal(udg_hash,ht,1,x)
call TimerStart(t,y,false,function CreepSpell_FrostArrow)
elseif GetSpellAbilityId()=='ACcv' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set y=bj_RADTODEG*Atan2(y-GetUnitY(GetTriggerUnit()),x-GetUnitX(GetTriggerUnit()))
set x=GetHeroInt(udg_Hero[ID],true)
if GetUnitAbilityLevel(caster,'A17Z')==1 then
set x=x*6
endif
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(Hash,ht,0,GetTriggerUnit())
call SaveGroupHandle(Hash,ht,10,CreateGroup())
call SaveReal(Hash,ht,0,.6)
call SaveReal(Hash,ht,1,GetUnitX(GetTriggerUnit()))
call SaveReal(Hash,ht,2,GetUnitY(GetTriggerUnit()))
call SaveReal(Hash,ht,3,x)
call SaveReal(Hash,ht,4,y)
call SaveReal(Hash,ht,5,175.)
call TimerStart(t,0.1,true,function CreepSpell_NineWall)
endif
endif
if lvl>=15 and ModuloInteger(lvl,5)==0 then
if GetSpellAbilityId()=='A0R2' then
if GetUnitTypeId(caster)=='n00Z' then
set udg_Drop2=PLAYER_NEUTRAL_AGGRESSIVE
call GroupEnumUnitsInRange(g,xc,yc,400,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call GroupRemoveUnit(g,u)
set x=GetUnitX(u)
set y=GetUnitY(u)
set r=bj_RADTODEG*Atan2(y-yc,x-xc)
set x=x+250.*Cos(r*bj_DEGTORAD)
set y=y+250.*Sin(r*bj_DEGTORAD)
call SetUnitX(u,x)
call SetUnitY(u,y)
endloop
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>5
set r=bj_forLoopAIndex*72+GetUnitFacing(caster)
set z=GetRandomReal(120.,400.)
set x=xc+z*Cos(r*bj_DEGTORAD)
set y=yc+z*Sin(r*bj_DEGTORAD)
set bj_lastCreatedUnit=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),'h045',x,y,bj_UNIT_FACING)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',2.50)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
elseif GetUnitTypeId(caster)=='n06V' then
set udg_Drop2=PLAYER_NEUTRAL_AGGRESSIVE
call GroupEnumUnitsInRange(g,xc,yc,400,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call GroupRemoveUnit(g,u)
set x=GetUnitX(u)
set y=GetUnitY(u)
set r=bj_RADTODEG*Atan2(y-yc,x-xc)
set x=x+350.*Cos(r*bj_DEGTORAD)
set y=y+350.*Sin(r*bj_DEGTORAD)
call SetUnitX(u,x)
call SetUnitY(u,y)
endloop
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>9
set r=bj_forLoopAIndex*72+GetUnitFacing(caster)
set z=GetRandomReal(120.,400.)
set x=xc+z*Cos(r*bj_DEGTORAD)
set y=yc+z*Sin(r*bj_DEGTORAD)
set bj_lastCreatedUnit=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),'h03K',x,y,bj_UNIT_FACING)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',2.50)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
elseif GetUnitTypeId(caster)=='n02F' then
set udg_Drop2=PLAYER_NEUTRAL_AGGRESSIVE
call GroupEnumUnitsInRange(g,xc,yc,400,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call GroupRemoveUnit(g,u)
set x=GetUnitX(u)
set y=GetUnitY(u)
set r=bj_RADTODEG*Atan2(y-yc,x-xc)
set x=x+300.*Cos(r*bj_DEGTORAD)
set y=y+300.*Sin(r*bj_DEGTORAD)
call SetUnitX(u,x)
call SetUnitY(u,y)
endloop
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>9
set r=bj_forLoopAIndex*72+GetUnitFacing(caster)
set z=GetRandomReal(120.,400.)
set x=xc+z*Cos(r*bj_DEGTORAD)
set y=yc+z*Sin(r*bj_DEGTORAD)
set bj_lastCreatedUnit=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),'h045',x,y,bj_UNIT_FACING)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',2.50)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
endif
if GetSpellAbilityId()=='A0R7' then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\BattleRoar\\RoarCaster.mdl",GetSpellAbilityUnit(),"origin"))
endif
endif
if GetSpellAbilityId()=='A112' then
call KillUnit(GetSpellAbilityUnit())
endif
if GetSpellAbilityId()=='A09F' then
call KillUnit(GetSpellAbilityUnit())
endif
if GetSpellAbilityId()=='A18X' then
set dmg=(200.00+(0.10*GetUnitStateSwap(UNIT_STATE_MAX_LIFE,GetSpellAbilityUnit())))
call SetUnitLifeBJ(GetSpellAbilityUnit(),(GetUnitStateSwap(UNIT_STATE_LIFE,GetSpellAbilityUnit())+(dmg*1.00)))
call UnitDamageTarget(GetSpellAbilityUnit(),GetSpellTargetUnit(),dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call AddSpecialEffectTargetUnitBJ("chest",GetSpellTargetUnit(),"Objects\\Spawnmodels\\Orc\\OrcSmallDeathExplode\\OrcSmallDeathExplode.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
endif
if GetSpellAbilityId()=='A00M' then
if GetUnitTypeId(caster)=='nrvd' then
set x=GetUnitX(caster)+200*Cos(GetUnitFacing(caster)*bj_DEGTORAD)
set y=GetUnitY(caster)+200*Sin(GetUnitFacing(caster)*bj_DEGTORAD)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'nrvs',x,y,GetUnitFacing(caster))
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',30.)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'nrvs',x,y,GetUnitFacing(caster))
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',30.)
set x=GetUnitX(caster)+200*Cos((GetUnitFacing(caster)+180)*bj_DEGTORAD)
set y=GetUnitY(caster)+200*Sin((GetUnitFacing(caster)+180)*bj_DEGTORAD)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'n04G',x,y,GetUnitFacing(caster))
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',30.)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'n04G',x,y,GetUnitFacing(caster))
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',30.)
endif
if GetUnitTypeId(caster)=='nrvd' then
set x=GetUnitX(caster)+200*Cos(GetUnitFacing(caster)*bj_DEGTORAD)
set y=GetUnitY(caster)+200*Sin(GetUnitFacing(caster)*bj_DEGTORAD)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'n063',x,y,GetUnitFacing(caster))
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',60.)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'n063',x,y,GetUnitFacing(caster))
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',60.)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'n063',x,y,GetUnitFacing(caster))
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',60.)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'n063',x,y,GetUnitFacing(caster))
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',60.)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'n063',x,y,GetUnitFacing(caster))
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',60.)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'n063',x,y,GetUnitFacing(caster))
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',60.)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'n063',x,y,GetUnitFacing(caster))
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',60.)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'n063',x,y,GetUnitFacing(caster))
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',60.)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'n063',x,y,GetUnitFacing(caster))
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',60.)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'n063',x,y,GetUnitFacing(caster))
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',60.)
endif
endif
if GetSpellAbilityId()=='A00M' then
set u=GetSpellTargetUnit()
set h=GetHandleId(u)
set a=LoadInteger(Hash,h,0)
if a==0 then
set a=SeekFreeUnit(h)
endif
if IsUnitType(u,UNIT_TYPE_HERO)then
set t=LoadTimerHandle(udg_hash,h,StringHash("FrostArmore"))
if t==null then
set b=GetHeroAgi(u,true)/5
set s__Units_Arm[sUnit[a]]=s__Units_Arm[sUnit[a]]+b
call F_Armore(u,s__Units_Arm[sUnit[a]])
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveTimerHandle(udg_hash,h,StringHash("FrostArmore"),t)
call SaveUnitHandle(udg_hash,ht,0,u)
call SaveInteger(udg_hash,ht,1,b)
call SaveReal(udg_hash,ht,2,10)
call TimerStart(t,0.25,true,function Trig_CreepSpell_FrostArmore)
else
set b=GetHeroAgi(u,true)/5
set s__Units_Arm[sUnit[a]]=s__Units_Arm[sUnit[a]]+b-LoadInteger(udg_hash,ht,1)
call F_Armore(u,s__Units_Arm[sUnit[a]])
set ht=GetHandleId(t)
call SaveInteger(udg_hash,ht,1,b)
call SaveReal(udg_hash,ht,2,10)
endif
endif
endif
if GetSpellAbilityId()=='ACrj' then
set u=GetSpellTargetUnit()
if IsUnitType(u,UNIT_TYPE_HERO)==false then
if u==caster then
set dmg=0.12*GetUnitState(u,UNIT_STATE_MAX_LIFE)
else
set dmg=0.1*GetUnitState(u,UNIT_STATE_MAX_LIFE)
endif
else
set dmg=0.06*GetUnitState(u,UNIT_STATE_MAX_LIFE)
endif
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+dmg)
endif
call DestroyGroup(g)
set g=null
set t=null
set caster=null
set u=null
endfunction
