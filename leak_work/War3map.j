function Leave_Win takes nothing returns nothing
local integer a
call CustomDefeatBJ(Player(9),"Вы проиграли")
call CustomVictoryBJ(Player(8),true,true)
call CustomVictoryBJ(Player(10),true,true)
call CustomVictoryBJ(Player(11),true,true)
set a=0
loop
exitwhen a>7
if Player(a)==udg_EvilPlayer then
call CustomVictoryBJ(udg_EvilPlayer,true,true)
else
call CustomDefeatBJ(Player(a),"Вы проиграли!")
endif
set a=a+1
endloop
endfunction
function Trig_Leave_Actions takes nothing returns nothing
local player pl=GetTriggerPlayer()
local integer a
local integer b
local integer ID=GetPlayerId(pl)+1
local integer gold
local integer maxplayer=0
local integer array P
call ForceAddPlayer(GroupeLeave,pl)
if pl==udg_EvilPlayer then
call DisplayTimedTextToForce(GetPlayersAll(),300.00,(("[|cFFC60000Leave|r] Игрок |cFFFFDC00"+GetPlayerName(pl))+"|r покинул игру! Этот игрок играл Злодеем, игра закончится через 20 сек."))
call TimerStart(CreateTimer(),20.,false,function Leave_Win)
else
set udg_PN=udg_PN-1
if udg_Mode==3 then
set udg_CheckEvil=udg_CheckEvil-1
else
endif
set a=0
loop
exitwhen a>7
if Player(a)!=udg_EvilPlayer and PlayerPickHero[a]and IsPlayerInForce(Player(a),GroupeLeave)==false then
set P[a]=1
set maxplayer=maxplayer+1
else
set P[a]=0
endif
set a=a+1
endloop
set a=0
set gold=GetPlayerState(pl,PLAYER_STATE_RESOURCE_GOLD)/maxplayer
loop
exitwhen a>7
if Player(a)!=udg_EvilPlayer and P[a]==1 then
call SetPlayerAllianceStateBJ(pl,Player(a),bj_ALLIANCE_ALLIED_ADVUNITS)
call DisplayTimedTextToForce(bj_FORCE_PLAYER[a],20.00,"Вы получили "+I2S(gold)+" ед. золота от ушедшего игрока.")
call SetPlayerStateBJ(Player(a),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(a),PLAYER_STATE_RESOURCE_GOLD)+gold)
else
endif
set a=a+1
endloop
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,20.00,"[|cFFC60000Leave|r] Игрок |cFFFFDC00"+GetPlayerName(pl)+"|r покинул игру!")
endif
call SetPlayerStateBJ(pl,PLAYER_STATE_RESOURCE_GOLD,0)
set pl=null
endfunction
