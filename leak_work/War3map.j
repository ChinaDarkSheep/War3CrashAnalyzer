function Trig_IncomeRegister_Actions takes nothing returns nothing
local unit build=GetConstructedStructure()
local integer ID=GetPlayerId(GetOwningPlayer(GetTriggerUnit()))+1
local integer h=GetHandleId(udg_Hero[ID])
local group TG=LoadGroupHandle(udg_hash,h,StringHash("ElfTower"))
local integer hp_up=R2I(250*GetPlayerTechCount(Player(ID-1),'Rhac',true)*GetPlayerHandicap(Player(ID-1)))
if GetUnitTypeId(build)=='hgtw' then
call GroupAddUnit(TG,build)
call UnitAddAbility(build,'A007')
call SummonStats(false,hp_up,0,build,udg_Hero[ID])
call UnitRemoveAbility(build,'A007')
elseif GetUnitTypeId(build)=='hctw' then
call GroupAddUnit(TG,build)
call UnitAddAbility(build,'A007')
call SummonStats(false,hp_up+R2I(50*GetPlayerTechCount(Player(ID-1),'R016',true)*GetPlayerHandicap(Player(ID-1))),0,build,udg_Hero[ID])
call UnitRemoveAbility(build,'A007')
elseif GetUnitTypeId(build)=='hatw' then
call GroupAddUnit(TG,build)
call UnitAddAbility(build,'A007')
call SummonStats(false,hp_up,0,build,udg_Hero[ID])
call UnitRemoveAbility(build,'A007')
elseif GetUnitTypeId(build)=='net1' then
call GroupAddUnit(TG,build)
call UnitAddAbility(build,'A007')
call SummonStats(false,hp_up,0,build,udg_Hero[ID])
call UnitRemoveAbility(build,'A007')
elseif GetUnitTypeId(build)=='negm' then
call GroupAddUnit(TG,build)
call GroupAddUnit(ElfHealTowerSelf,build)
call UnitAddAbility(build,'A007')
call SummonStats(false,hp_up,0,build,udg_Hero[ID])
call UnitRemoveAbility(build,'A007')
elseif GetUnitTypeId(build)=='hars' then
call GroupAddUnit(TG,build)
call UnitAddAbility(build,'A007')
call SummonStats(false,hp_up,0,build,udg_Hero[ID])
call UnitRemoveAbility(build,'A007')
elseif GetUnitTypeId(build)=='n00K' then
call GroupAddUnit(TG,build)
call UnitAddAbility(build,'A007')
call SummonStats(false,hp_up,0,build,udg_Hero[ID])
call UnitRemoveAbility(build,'A007')
endif
if GetUnitTypeId(build)=='n00H' then
call GroupAddUnitSimple(build,udg_IncomeGroup)
elseif GetUnitTypeId(build)=='n00K' then
call UnitAddAbility(build,'A1DC')
endif
set TG=null
endfunction
