function Trig_FlameOrcSkills_R1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(hero)
local integer iuh=LoadInteger(Hash,h,0)
local integer f=LoadInteger(udg_hash,ht,0)
local real sec=LoadReal(udg_hash,ht,0)
local real hp
local integer a
local integer b
if sec>0 then
set b=LoadInteger(udg_hash,h,StringHash("MekAttack"))
set a=R2I(Summ_Attack(hero)/2-LoadInteger(udg_hash,h,StringHash("AllAttack")))
set s__Units_GAttack[sUnit[iuh]]=s__Units_GAttack[sUnit[iuh]]+a-b
call SaveInteger(udg_hash,h,StringHash("MekAttack"),a)
call SaveInteger(udg_hash,h,StringHash("AllAttack"),LoadInteger(udg_hash,h,StringHash("AllAttack"))+a-b)
if f==1 then
if GetUnitState(hero,UNIT_STATE_LIFE)>1 then
set hp=1.-0.02*0.25
call SetUnitState(hero,UNIT_STATE_LIFE,hp*GetUnitState(hero,UNIT_STATE_LIFE))
endif
endif
set sec=sec-0.25
call SaveReal(udg_hash,ht,0,sec)
else
call SaveInteger(udg_hash,h,StringHash("MekR1"),0)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
if f==0 then
set s__Units_AllTake[sUnit[iuh]]=s__Units_AllTake[sUnit[iuh]]-3000
endif
set b=LoadInteger(udg_hash,h,StringHash("MekAttack"))
set s__Units_GAttack[sUnit[iuh]]=s__Units_GAttack[sUnit[iuh]]-b
call SaveInteger(udg_hash,h,StringHash("AllAttack"),LoadInteger(udg_hash,h,StringHash("AllAttack"))-b)
call SaveInteger(udg_hash,h,StringHash("MekAttack"),0)
endif
set t=null
set hero=null
endfunction
function Trig_Jass_Skill_Bunker takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit bunker=LoadUnitHandle(udg_hash,ht,0)
if bunker !=null and UnitAlive(bunker)then
call SetUnitState(bunker,UNIT_STATE_LIFE,GetUnitState(bunker,UNIT_STATE_LIFE)+GetUnitState(bunker,UNIT_STATE_MAX_LIFE)/200)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
set bunker=null
endfunction
function Trig_FlameOrcSkills_Actions takes nothing returns nothing
local integer ID=GetPlayerId(GetOwningPlayer(GetTriggerUnit()))+1
local unit hero=udg_Hero[ID]
local integer talante=udg_Talante[ID]
local integer h=GetHandleId(hero)
local integer ihh=LoadInteger(udg_hash,h,5)
local timer t
local integer ht
local integer f=GetUnitAbilityLevel(hero,'A0Q7')
local real dmg
local real r
local real x
local real y
local integer i
if GetSpellAbilityId()=='A0Q5' then
call ShowUnit(hero,false)
set x=GetUnitX(hero)
set y=GetUnitY(hero)
set udg_Bunker=CreateUnit(Player(ID-1),'o00X',x,y,270.)
call UnitAddAbility(udg_Bunker,'A007')
set dmg=5*(GetHeroStr(hero,true)-0.55*s__Heroes_TempStr[sHero[ihh]])
set r=75*(GetHeroStr(hero,true)-0.55*s__Heroes_TempStr[sHero[ihh]])
call SummonStats(true,R2I(r),R2I(dmg),udg_Bunker,hero)
call UnitRemoveAbility(udg_Bunker,'A007')
call SelectUnitForPlayerSingle(udg_Bunker,GetOwningPlayer(hero))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",x,y))
set t=CreateTimer()
call SaveUnitHandle(udg_hash,GetHandleId(t),0,udg_Bunker)
call TimerStart(t,1.,true,function Trig_Jass_Skill_Bunker)
endif
if GetSpellAbilityId()=='A0QA' or GetSpellAbilityId()=='A0QB' then
if talante==1 and GetUnitTypeId(GetTriggerUnit())=='O00W' then
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.2*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
endif
set udg_FlameOrcPoint=GetUnitLoc(GetSpellAbilityUnit())
set udg_p=GetSpellTargetLoc()
set udg_FlameOrcReal=AngleBetweenPoints(udg_FlameOrcPoint,udg_p)
set udg_FlameOrcQ=0
call RemoveLocation(udg_p)
call StartTimerBJ(udg_FlameOrcQTimer,true,0.08)
endif
if GetSpellAbilityId()=='A0Y9' or GetSpellAbilityId()=='A0YC' then
set dmg=15*GetUnitAbilityLevel(udg_FlameOrc,'A0Y9')+GetHeroStr(udg_FlameOrc,true)/2
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(udg_FlameOrc),'h05G',GetUnitX(hero),GetUnitY(hero),GetUnitFacing(udg_FlameOrc))
set i=SeekFreeDummys(bj_lastCreatedUnit,GetHandleId(bj_lastCreatedUnit))
set s__Dummys_dmg[sDummy[i]]=dmg
call UnitAddAbility(bj_lastCreatedUnit,'A0QC')
call IssueTargetOrder(bj_lastCreatedUnit,"acidbomb",GetSpellTargetUnit())
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',22.)
endif
if GetSpellAbilityId()=='A0Q0' then
set udg_FlameOrcD=true
call UnitAddAbilityBJ('A0Q4',udg_FlameOrc)
call TriggerSleepAction(18.00)
call UnitRemoveAbilityBJ('A0Q4',udg_FlameOrc)
set udg_FlameOrcD=false
endif
if GetSpellAbilityId()=='A0Q6' then
call KillUnit(GetSpellAbilityUnit())
endif
if GetSpellAbilityId()=='A1DW' then
if f==0 then
set i=LoadInteger(Hash,h,0)
set s__Units_AllTake[sUnit[i]]=s__Units_AllTake[sUnit[i]]+3000
endif
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveInteger(udg_hash,h,StringHash("MekR1"),1)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveInteger(udg_hash,ht,0,f)
call SaveReal(udg_hash,ht,0,20.)
call TimerStart(t,0.25,true,function Trig_FlameOrcSkills_R1)
endif
set hero=null
set t=null
endfunction
