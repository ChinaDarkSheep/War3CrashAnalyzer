function Trig_GemsCraft_Actions takes nothing returns nothing
local unit u=GetManipulatingUnit()
local integer ID=GetPlayerId(GetOwningPlayer(u))+1
local integer i
local integer a
local integer b
local integer c
local integer d
local integer e
local integer lvl
local integer drop
local item Item=GetManipulatedItem()
local integer n=GetItemTypeId(Item)
if ID<9 then
if GetUnitTypeId(u)=='ncop' or GetUnitTypeId(u)=='h05I' or IsUnitType(u,UNIT_TYPE_HERO)then
if pick_item[ID]then
elseif GetItemTypeId(Item)=='ratc' then
if LTrophy_1[ID]>0 then
set LTrophy_1[ID]=LTrophy_1[ID]-1
call GetRandomItemInList(20,5)
call Pick_Item(ID,udg_Trophy1[random_list[0]],udg_Trophy1[random_list[1]],udg_Trophy1[random_list[2]],udg_Trophy1[random_list[3]],udg_Trophy1[random_list[4]],0,true)
call RemoveItem(Item)
else
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"|cffffcc00Вы больше не можете получить трофей данного уровня|r")
endif
elseif GetItemTypeId(Item)=='schl' then
set i=GetHandleId(Item)
set a=0
set b=0
set c=0
set d=0
set e=0
call SaveReal(udg_hash,i,100,100)
set lvl=LoadInteger(udg_hash,i,'l')
set drop=LoadInteger(udg_hash,i,StringHash("QTRew"))
if drop==1 then
if lvl==1 then
set a='I01B'
set b='I01C'
set c='I01D'
set d='I01F'
set e='I01E'
