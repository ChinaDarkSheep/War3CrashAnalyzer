function boss_Monolit_Spawn takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit monolit=LoadUnitHandle(udg_hash,ht,0)
local real x
local real y
if UnitAlive(monolit)then
set x=GetUnitX(monolit)
set y=GetUnitY(monolit)
if GetRandomInt(1,4)==1 then
set bj_lastCreatedUnit=CreateUnit(ForcePickRandomPlayer(udg_CreepsPlayers),'u027',x,y,bj_UNIT_FACING)
call GroupAddUnit(udg_A1,bj_lastCreatedUnit)
endif
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>3
set bj_lastCreatedUnit=CreateUnit(ForcePickRandomPlayer(udg_CreepsPlayers),'h04T',x,y,bj_UNIT_FACING)
call GroupAddUnit(udg_A1,bj_lastCreatedUnit)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>2
set bj_lastCreatedUnit=CreateUnit(ForcePickRandomPlayer(udg_CreepsPlayers),'u023',x,y,bj_UNIT_FACING)
call GroupAddUnit(udg_A1,bj_lastCreatedUnit)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
set monolit=null
endfunction
function Boss_Monolit_DMG_1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit monolit=LoadUnitHandle(udg_hash,ht,0)
local unit hero=LoadUnitHandle(udg_hash,ht,1)
local integer tic=LoadInteger(udg_hash,ht,2)
local timer t2=LoadTimerHandle(udg_hash,ht,3)
local integer ht2=GetHandleId(t2)
local group g2=LoadGroupHandle(udg_hash,ht2,1)
local group g=CreateGroup()
local real x
local real y
local integer a
local unit u
if tic<120 then
if tic<25 then
set x=LoadReal(udg_hash,ht,4)
set y=LoadReal(udg_hash,ht,5)
set bj_lastCreatedEffect=AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
set udg_Drop2=GetPlayerId(GetOwningPlayer(monolit))
call GroupEnumUnitsInRange(g,x,y,225.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(monolit,u,0.25*(250+0.025*GetUnitState(u,UNIT_STATE_MAX_LIFE)),false,false,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
endif
set tic=tic+1
call SaveInteger(udg_hash,ht,2,tic)
else
call GroupRemoveUnit(g2,hero)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
call DestroyGroup(g)
set g=null
set g2=null
set t=null
set t2=null
set hero=null
set monolit=null
set u=null
endfunction
function Boss_Monolit_DeathWave takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit monolit=LoadUnitHandle(udg_hash,ht,0)
local group g=LoadGroupHandle(udg_hash,ht,1)
local real x
local real y
local real dmg
local integer a
local timer t2
local integer ht2
if UnitAlive(monolit)then
set x=GetUnitX(monolit)
set y=GetUnitY(monolit)
set a=1
loop
exitwhen a>8
if UnitAlive(udg_Hero[a])and IsUnitInGroup(udg_Hero[a],g)==false then
call GroupAddUnit(g,udg_Hero[a])
set t2=CreateTimer()
set ht2=GetHandleId(t2)
call SaveUnitHandle(udg_hash,ht2,0,monolit)
call SaveUnitHandle(udg_hash,ht2,1,udg_Hero[a])
call SaveInteger(udg_hash,ht2,2,0)
call SaveTimerHandle(udg_hash,ht2,3,t)
call SaveReal(udg_hash,ht2,4,GetUnitX(udg_Hero[a]))
call SaveReal(udg_hash,ht2,5,GetUnitY(udg_Hero[a]))
call TimerStart(t2,0.25,true,function Boss_Monolit_DMG_1)
endif
set a=a+1
endloop
else
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set g=null
set t=null
set t2=null
set monolit=null
endfunction
function MonolitEffect_DMG_G takes nothing returns nothing
