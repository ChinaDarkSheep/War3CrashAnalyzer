if a==1 then
set name='iwbr'
else
set name='dkfw'
endif
endif
endif
call FlushChildHashtable(udg_hash,GetHandleId(UnitItemInSlot(BaseGuild,i)))
call RemoveItem(UnitItemInSlot(BaseGuild,i))
set bj_lastCreatedItem=CreateItem(name,GetUnitX(BaseGuild),GetUnitY(BaseGuild))
set h=GetHandleId(bj_lastCreatedItem)
if name=='iwbr' or name=='dkfw' then
set level=4
