function Trig_Time_Actions takes nothing returns nothing
local integer a=1
local integer b=1
local integer c=1
local integer d=1
local integer i=1
local string s
if udg_StatsGC==null then
call StatsInit()
endif
set udg_StatsSec=udg_StatsSec+1
set udg_Time[1]=udg_Time[1]+1
if udg_Time[1]==60. then
set udg_Time[1]=0
set a=GetRandomInt(1,14)
if a<10 then
set MinRandom=GetRandomInt(0,80)
elseif a<14 then
set MinRandom=80+6*GetRandomInt(1,20)
else
set MinRandom=200+10*GetRandomInt(1,20)
endif
set SumRandom=100+IncRandom+MinRandom
set udg_Time[2]=udg_Time[2]+1
if HardcoreUP10==1 then
call SetPlayerTechResearched(Player(PLAYER_NEUTRAL_AGGRESSIVE),'R01V',GetPlayerTechCount(Player(PLAYER_NEUTRAL_AGGRESSIVE),'R01V',true)+1)
endif
set a=1
loop
exitwhen a>8
call SetPlayerStateBJ(Player(a-1),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(a-1),PLAYER_STATE_RESOURCE_GOLD)+Mincome[a])
set a=a+1
endloop
if udg_Start then
if udg_Mode==2 and udg_Time[2]==10 then
if GetRandomInt(1,100)>5 then
set HardcoreBuff10=GetRandomInt(1,5)
else
set HardcoreBuff10=10
endif
if HardcoreBuff10==1 then
set HardcoreBuff10Str="|cFFC9AD00+150% к награде за убийство лесных боссов|r"
elseif HardcoreBuff10==2 then
set HardcoreBuff10Str="|cFFC9AD00+(3+12%) к награде за убийство|r"
elseif HardcoreBuff10==3 then
set HardcoreBuff10Str="|cFFC9AD00+25 очков для усиленных лесных точек|r"
set ForestPoints[100]=ForestPoints[100]+25
elseif HardcoreBuff10==4 then
set HardcoreBuff10Str="|cFFC9AD00+30% к базовой награде золота от ранговых квестов|r"
elseif HardcoreBuff10==5 then
set HardcoreBuff10Str="|cFFC9AD00+1 к атрибуту от книг лутинга, +10% шансу лутинга|r"
set a=1
loop
exitwhen a>8
set udg_Looting[a]=udg_Looting[a]+0.10
set a=a+1
endloop
else
set HardcoreBuff10Str="|cFFC9AD00+50% к награде глыб|r"
endif
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,45,HardcoreBuff10Str)
set HardcoreUP10=GetRandomInt(1,5)
if HardcoreUP10==1 then
set HardcoreUP10Str="|cFFC9AD00+50% к мощности лесным врагам. +10% к мощности каждую минуту|r"
call SetPlayerTechResearched(Player(PLAYER_NEUTRAL_AGGRESSIVE),'R01V',GetPlayerTechCount(Player(PLAYER_NEUTRAL_AGGRESSIVE),'R01V',true)+5)
elseif HardcoreUP10==2 then
set HardcoreUP10Str="|cFFC9AD00Усиление ранговых заданий|r"
elseif HardcoreUP10==3 then
set HardcoreUP10Str="|cFFC9AD00Усиление случайных события|r"
elseif HardcoreUP10==4 then
set HardcoreUP10Str="|cFFC9AD00Кара небес|r"
elseif HardcoreUP10==5 then
set HardcoreUP10Str="|cFFC9AD00Отмщение|r"
endif
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,45,HardcoreUP10Str)
endif
if udg_Mode<=3 and udg_Time[2]==17 then
call EnableTrigger(gg_trg_Every45sec)
set udg_after17min=true
set b=1
set d=500
loop
exitwhen ForestPoints[100]<FPLast[0]or tSpawner<b or d<0
set d=d-1
set a=GetRandomInt(b,tSpawner)
set i=ForestPoints[a]
if ForestPoints[100]>=s__SpawnerSys_cost[sSpawner[i]]then
set s__SpawnerSys_open[sSpawner[i]]=true
set c=ForestPoints[b]
set ForestPoints[b]=i
call PingMinimapForForceEx(bj_FORCE_ALL_PLAYERS,s__SpawnerSys_x[sSpawner[i]],s__SpawnerSys_y[sSpawner[i]],15.,bj_MINIMAPPINGSTYLE_FLASHY,20.,80.,20.)
if s__SpawnerSys_cost[sSpawner[i]]==10 then
set FPLast[1]=FPLast[1]-1
elseif s__SpawnerSys_cost[sSpawner[i]]==15 then
set FPLast[2]=FPLast[2]-1
elseif s__SpawnerSys_cost[sSpawner[i]]==20 then
set FPLast[3]=FPLast[3]-1
endif
if FPLast[1]==0 and FPLast[0]==10 then
set FPLast[0]=15
endif
if FPLast[2]==0 and FPLast[0]==15 then
set FPLast[0]=20
endif
set ForestPoints[100]=ForestPoints[100]-s__SpawnerSys_cost[sSpawner[i]]
set ForestPoints[a]=c
set b=b+1
endif
endloop
set oSpawners=b-1
set s="Усилены следующие зоны("+I2S(oSpawners)+"): "
set a=1
loop
exitwhen a>oSpawners
set s=s+s__SpawnerSys_name[sSpawner[ForestPoints[a]]]
if a !=oSpawners then
set s=s+", "
else
set s=s+"."
endif
set a=a+1
endloop
set s=s+" Доступна команда -os/щы"
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,45,s)
endif
endif
if not udg_Setstart then
set a=8
set s__SetTechUP[a]=GetPlayerTechCount(Player(a),'R01V',true)+GetPlayerTechCount(Player(a),'R05B',true)+GetPlayerTechCount(Player(a),'R05C',true)
set a=10
set s__SetTechUP[a]=GetPlayerTechCount(Player(a),'R01V',true)+GetPlayerTechCount(Player(a),'R05B',true)+GetPlayerTechCount(Player(a),'R05C',true)
set a=11
set s__SetTechUP[a]=GetPlayerTechCount(Player(a),'R01V',true)+GetPlayerTechCount(Player(a),'R05B',true)+GetPlayerTechCount(Player(a),'R05C',true)
call SetPlayerTechResearchedSwap('R01V',(GetPlayerTechCountSimple('R01V',Player(PLAYER_NEUTRAL_AGGRESSIVE))+1),Player(PLAYER_NEUTRAL_AGGRESSIVE))
endif
else
if not udg_Setstart then
set a=PLAYER_NEUTRAL_AGGRESSIVE
set s__SetTechUP[a]=GetPlayerTechCount(Player(a),'R01V',true)+GetPlayerTechCount(Player(a),'R05B',true)+GetPlayerTechCount(Player(a),'R05C',true)
endif
endif
if udg_Time[2]==60. then
set udg_Time[2]=0
set udg_Time[3]=udg_Time[3]+1
endif
call MultiboardSetTitleText(udg_TableConvert[1],udg_ModeString+"    ["+I2S(udg_Time[3])+":"+I2S(udg_Time[2])+":"+I2S(udg_Time[1])+"]")
call MultiboardSetTitleText(udg_TableConvert[2],udg_ModeString+"    ["+I2S(udg_Time[3])+":"+I2S(udg_Time[2])+":"+I2S(udg_Time[1])+"]")
endfunction
function InitTrig_Time takes nothing returns nothing
call InitSpawnerQuest()
set gg_trg_Time=CreateTrigger()
call TriggerRegisterTimerExpireEventBJ(gg_trg_Time,udg_Timer01s)
call TriggerAddAction(gg_trg_Time,function Trig_Time_Actions)
endfunction
