function HardcoreUP30_6 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer ID=LoadInteger(udg_hash,ht,4)
local real sec=LoadReal(udg_hash,ht,0)
local real xf=LoadReal(udg_hash,ht,1)
local real yf=LoadReal(udg_hash,ht,2)
local real warm=LoadReal(udg_hash,ht,3)
local real xh=GetUnitX(udg_Hero[ID])
local real yh=GetUnitY(udg_Hero[ID])
local real r
local string s=""
if sec>0 then
set sec=sec-0.15
call SaveReal(udg_hash,ht,0,sec)
else
call DestroyEffect(LoadEffectHandle(udg_hash,ht,0))
call SaveReal(udg_hash,ht,0,30)
if Player(ID-1)==GetLocalPlayer()then
set s="war3mapImported\\OrbFireX.mdx"
else
set s=""
endif
set xf=xh+60*GetRandomInt(-10,10)
set yf=yh+60*GetRandomInt(-10,10)
if IsTerrainPathable(xf,yf,PATHING_TYPE_WALKABILITY)then
set xf=xh+60*GetRandomInt(-10,10)
set yf=yh+60*GetRandomInt(-10,10)
if IsTerrainPathable(xf,yf,PATHING_TYPE_WALKABILITY)then
set xf=xh+60*GetRandomInt(-10,10)
set yf=yh+60*GetRandomInt(-10,10)
if IsTerrainPathable(xf,yf,PATHING_TYPE_WALKABILITY)then
set xf=xh+60*GetRandomInt(-10,10)
set yf=yh+60*GetRandomInt(-10,10)
if IsTerrainPathable(xf,yf,PATHING_TYPE_WALKABILITY)then
set xf=xh+60*GetRandomInt(-10,10)
set yf=yh+60*GetRandomInt(-10,10)
endif
endif
endif
endif
set bj_lastCreatedEffect=AddSpecialEffect(s,xf,yf)
call SaveReal(udg_hash,ht,1,xf)
call SaveReal(udg_hash,ht,2,yf)
call SaveEffectHandle(udg_hash,ht,0,bj_lastCreatedEffect)
if Player(ID-1)==GetLocalPlayer()then
set s="Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl"
else
set s=""
endif
set bj_lastCreatedEffect=AddSpecialEffect(s,xf,yf)
call DestroyEffect(bj_lastCreatedEffect)
endif
set xf=xf-xh
set yf=yf-yh
set r=SquareRoot(xf*xf+yf*yf)
if r<275 then
if warm<20 then
set warm=warm+0.45
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Heal\\HealTarget.mdl",udg_Hero[ID],"overhead"))
endif
else
if warm>0 then
set warm=warm-0.15
else
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIob\\AIobSpecialArt.mdl",udg_Hero[ID],"overhead"))
set r=0.15*(50+0.01*GetUnitState(udg_Hero[ID],UNIT_STATE_MAX_LIFE)+0.01*GetUnitState(udg_Hero[ID],UNIT_STATE_LIFE))
if GetUnitState(udg_Hero[ID],UNIT_STATE_LIFE)>r then
call SetUnitState(udg_Hero[ID],UNIT_STATE_LIFE,GetUnitState(udg_Hero[ID],UNIT_STATE_LIFE)-r)
else
call SetUnitState(udg_Hero[ID],UNIT_STATE_LIFE,1)
endif
endif
endif
call SaveReal(udg_hash,ht,3,warm)
set t=null
set s=""
endfunction
function MefistoImmortal takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit boss=LoadUnitHandle(udg_hash,ht,0)
local integer tic=LoadInteger(udg_hash,ht,0)
local integer h=GetHandleId(boss)
local integer i=LoadInteger(Hash,h,0)
if UnitAlive(boss)then
if tic<25 then
set s__Units_AllBlock[sUnit[i]]=s__Units_AllBlock[sUnit[i]]-1000
else
if tic==60 or tic==70 or tic==80 or tic==90 then
set s__Units_AllDmg[sUnit[i]]=s__Units_AllDmg[sUnit[i]]+600
set s__Units_AllBlock[sUnit[i]]=s__Units_AllBlock[sUnit[i]]+600
endif
endif
call SaveInteger(udg_hash,ht,0,tic+1)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
set boss=null
endfunction
function ForgetBoss takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit boss=LoadUnitHandle(udg_hash,ht,0)
local real x
local real y
local real dmg=10.*(GetPlayerTechCount(GetOwningPlayer(boss),'R01V',true)+GetPlayerTechCount(GetOwningPlayer(boss),'R05B',true)+GetPlayerTechCount(GetOwningPlayer(boss),'R05C',true))
if UnitAlive(boss)then
if GetRandomInt(1,2)==1 then
set x=GetRandomInt(-7700,-7000)
else
set x=GetRandomInt(-5750,-5050)
endif
if GetRandomInt(1,2)==1 then
set y=GetRandomInt(11242,12000)
else
set y=GetRandomInt(13400,14138)
endif
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(boss),'n03Y',x,y,0.)
call UnitAddAbility(bj_lastCreatedUnit,'Aloc')
call UnitAddAbility(bj_lastCreatedUnit,'A13N')
call SetUnitAbilityLevel(bj_lastCreatedUnit,'A13N',4)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',50.)
call SetUnitVertexColor(bj_lastCreatedUnit,255,255,255,255)
call F_Attack(bj_lastCreatedUnit,R2I(dmg))
call PingMinimapForForceEx(bj_FORCE_ALL_PLAYERS,GetUnitX(boss),GetUnitY(boss),2.,bj_MINIMAPPINGSTYLE_SIMPLE,100.,35.,0.)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set boss=null
set t=null
endfunction
function PingIceTower takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit boss=LoadUnitHandle(udg_hash,ht,0)
if UnitAlive(boss)then
set udg_Drop=GetRandomInt(4,6)
call SetUnitPosition(boss,RandomSpawnX[udg_Drop],RandomSpawnY[udg_Drop])
call PingMinimapForForceEx(bj_FORCE_ALL_PLAYERS,GetUnitX(boss),GetUnitY(boss),33.,bj_MINIMAPPINGSTYLE_SIMPLE,100.,35.,0.)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set boss=null
set t=null
endfunction
