function Trig_KovenQuests_Conditions takes nothing returns boolean
if(not(IsUnitType(GetEnteringUnit(),UNIT_TYPE_HERO)==true))then
return false
endif
if(not(GetUnitTypeId(GetEnteringUnit())!='N009'))then
return false
endif
if(not(GetUnitTypeId(GetEnteringUnit())!='N03T'))then
return false
endif
if(not(GetUnitTypeId(GetEnteringUnit())!='N025'))then
return false
endif
