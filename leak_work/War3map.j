elseif udg_StartQuests==5 then
if IsPlayerInForce(Player(id),udg_Quests[5])and udg_QTrolls[ID]==30 and udg_QKobolds[ID]==30 and udg_QGolems[ID]==15 and udg_QBeorns[ID]==10 then
set udg_StartQuests=5
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Hy чтo, yзнaл чтo-нибyдь? Hичeгo нe знaют? Ax, жaль-жaль. Haдo былo cнaчaлa cпpocить, a пoтoм yбивaть, a нe нaoбopoт - вeчнo вac, гepoeв, yчить нaдo!\n\n|cFFFFDC00Награда: предмет \"Сверхострое копье\" и 2000 золота|r")
call UnitAddItemByIdSwapped('I09R',udg_u)
call QuestGoblinGold(id,2000)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl",udg_u,"origin"))
call ForceRemovePlayerSimple(Player(id),udg_Quests[5])
call ForceAddPlayerSimple(Player(id),udg_Quests[6])
call EnableTrigger(gg_trg_KillQuest6)
return
else
if IsPlayerInForce(Player(id),udg_Quests[5])then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFF00C850Задание \"Поиск оружия\" [1/3]|r")
call DisplayTextToForce(bj_FORCE_PLAYER[id],"O, этo cнoвa ты. Cлyшaй, я вычитaл в тoм днeвникe, чтo гдe-тo нa этoм ocтpoвe cпpятaнo дpeвнee opyжиe нeвepoятнoй cилы, нo нeчaйнo пpoлил нa пpoдoлжeниe этoй cтpaницы эликcиp мaны. Boзмoжнo ктo-тo из мecтныx житeлeй знaeт чтo-тo пpo этo, cxoди yзнaй, a я пoкa дaльшe пoкoпaюcь в днeвникe. (yбeйтe 30 тpoллeй, 30 кoбoльдoв, 15 гoлeмoв и 10 бeopнoв)")
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFFFFDC00Награда: предмет \"Сверхострое копье\" и 2000 золота\nЕсли успеете первым закончить цепочку заданий, то вы получите доступ к последнему заданию Гильдии.|r")
endif
endif
if IsPlayerInForce(Player(id),udg_Quests[6])and UnitHasItemOfTypeBJ(udg_u,'I09S')then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Ух ты! Скорее неси его мне! Сейчас мы его будем изучать...\n\n|cFFFFDC00Награда: 6000 золота|r")
call RemoveItem(GetItemOfTypeFromUnitBJ(udg_u,'I09S'))
call QuestGoblinGold(id,6000)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl",udg_u,"origin"))
call ForceRemovePlayerSimple(Player(id),udg_Quests[6])
call ForceAddPlayerSimple(Player(id),udg_Quests[7])
call EnableTrigger(gg_trg_KillQuest7)
return
else
if IsPlayerInForce(Player(id),udg_Quests[6])then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFF00C850Задание \"Поиск оружия\" [2/3]|r")
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Bcё-тaки ты xopoшo пopaбoтaл! Тoлькo кoгдa ты yшeл я нaшeл нyжнyю инфopмaцию нa cлeдyющeй cтpaницe днeвникa. Тaм cкaзaнo, чтo этoт пpeдмeт пpocтo тaк нe нaйти и лишь кpoвь тpyпoeдoв мoжeт зaинтepecoвaть caм пpeдмeт! Дyмaю, тeбe пpидeтcя нaйти пapy вypдaлaкoв и пpoвepить этo нa дeлe! (пoпpoбyйтe yбить 20 вypдaлaкoв)")
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFFFFDC00Награда: 6000 золота\nЕсли успеете первым закончить цепочку заданий, то вы получите доступ к последнему заданию Гильдии.|r")
endif
endif
if IsPlayerInForce(Player(id),udg_Quests[7])and udg_QNaga[ID]==5 and udg_QMurlocs[ID]==10 and udg_QLobster[ID]==15 then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Hy чтo, дaвaй пocмoтpим... Тaк, пoмaзaть eщe тyт... Тpи икc в кyбe плюc кoнcтaнтa... Пoлyчилocь! Тeпepь oн для клacca \"кypoщyп\"! Ты жe кypoщyп, вepнo?\n\n|cFFFFDC00Haгpaдa: пpeдмeт \"Ультимaтивныe caпoги\" и 3000 зoлoтa|r")
call UnitAddItemByIdSwapped('I09T',udg_u)
call QuestGoblinGold(id,3000)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl",udg_u,"origin"))
call ForceRemovePlayerSimple(Player(id),udg_Quests[7])
if udg_LastQuest then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFFFF5800Кто-то первее вас закончил цепочку заданий и получил последнее задание Гильдии. Вы получаете 6000 золотых в качестве утешительного приза =)|r")
call QuestGoblinGold(id,6000)
call ForceAddPlayerSimple(Player(id),udg_Quests[9])
else
call ForceAddPlayerSimple(Player(id),udg_Quests[8])
set udg_LastQuest=true
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFFFF00FFПоздравляем! Вы первым завершили цепочку заданий \"Поиск оружия\" и получаете доступ к последнему заданию. Удачи!|r")
set udg_p=GetRectCenter(gg_rct_A2)
call CreateNUnitsAtLoc(1,'n071',Player(PLAYER_NEUTRAL_AGGRESSIVE),udg_p,bj_UNIT_FACING)
call TriggerRegisterUnitEvent(gg_trg_LastQuest,GetLastCreatedUnit(),EVENT_UNIT_DEATH)
call RemoveLocation(udg_p)
endif
return
else
if IsPlayerInForce(Player(id),udg_Quests[7])then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFF00C850Задание \"Поиск оружия\" [3/3]|r\n\nУх ты, вот это оружие, вот это работа! Гляди, тут написано, что оно для другого героя - какого-то разрушителя. Но это ерунда - в дневнике про это тоже написано! А еще там написано, что можно изменить его сущность, для этого нужно искупать его в душах водных существ... Да, так и написано. Ну давай, за дело. (убейте 5 наг-гвардейцев, 10 мурлоков-сектантов и 15 лобстеров)")
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFFFFDC00Награда: предмет \"Ультимативные сапоги\" и 3000 золота\nЕсли успеете первым закончить цепочку заданий, то вы получите доступ к последнему заданию Гильдии.|r")
endif
endif
if IsPlayerInForce(Player(id),udg_Quests[8])and udg_LastQuestReward then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Ты чтo, пpaвдa этo cдeлaл? A я yжe coбиpaл людeй, чтoбы oтпpaвитьcя иcкaть твoй тpyп... Дa шyчy я, лyчшe пocмoтpи кaк я бyдy yлyчшaть этoт пpeдмeт! Тaк, ceйчac пocмoтpим... Угy, этo cюдa... Тaк... Пoлyчилocь! Пpeдмeт нaчaл paзвaливaтьcя! Или тaк нe дoлжнo быть?")
call DisplayTextToForce(bj_FORCE_PLAYER[id],"\nHa вaшиx глaзax вeликoe opyжиe бyквaльнo нaчaлo paccыпaтьcя в пecoк и oт нeгo ocтaлcя лишь кaкoй тo кyбик...\n\n|cFFFFDC00Haгpaдa: пpeдмeт \"Kyб Kaнaи\"|r")
call UnitAddItemByIdSwapped('I0A2',udg_u)
call AddSpecialEffectTargetUnitBJ("origin",udg_u,"Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call ForceRemovePlayerSimple(Player(id),udg_Quests[8])
call ForceAddPlayerSimple(Player(id),udg_Quests[9])
else
if IsPlayerInForce(Player(id),udg_Quests[8])then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFF00C850Последнее задание!|r\nСлушай, судя по всему хозяин этого оружия против того, что мы с ним делаем и он хочет тебя найти. Хорошо, что не меня... Так что если ты хочешь использовать это оружие, то тебе придется разобраться с его хозяином. Ну а я пока спрячу этот \"Испепелитель\" подальше от своего дома... Советую тебе попросить помощи у других героев.")
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFFFFDC00Награда: предмет \"Хорадрический куб\" (5 уровень)|r")
call PingMinimapForForceEx(bj_FORCE_PLAYER[id],GetRectCenterX(gg_rct_A2),GetRectCenterY(gg_rct_A2),5.,bj_MINIMAPPINGSTYLE_SIMPLE,100,0.,0.)
endif
endif
endif
if udg_StartQuests<5 and not BHelpGoblinText then
call DisplayTextToForce(bj_FORCE_PLAYER[id],s__QuestGoblinText[0])
call DisplayTextToForce(bj_FORCE_PLAYER[id],s__QuestGoblinText[1])
call DisplayTextToForce(bj_FORCE_PLAYER[id],s__QuestGoblinText[2])
if udg_StartQuests==1 then
call PingMinimapForForceEx(bj_FORCE_PLAYER[id],GetRectCenterX(gg_rct_Spawn6),GetRectCenterY(gg_rct_Spawn6),5.,bj_MINIMAPPINGSTYLE_SIMPLE,100,0.,0.)
elseif udg_QuestNumber==2 and udg_QuestNumber==2 then
call PingMinimapForForceEx(bj_FORCE_PLAYER[id],GetRectCenterX(gg_rct_SI1),GetRectCenterY(gg_rct_SI1),5.,bj_MINIMAPPINGSTYLE_SIMPLE,100,0.,0.)
elseif udg_StartQuests==3 and udg_QuestNumber==2 then
call PingMinimapForForceEx(bj_FORCE_PLAYER[id],GetRectCenterX(gg_rct_Spawn15),GetRectCenterY(gg_rct_Spawn15),5.,bj_MINIMAPPINGSTYLE_SIMPLE,100,0.,0.)
endif
elseif not IsPlayerInForce(Player(id),udg_Quests[5])and not IsPlayerInForce(Player(id),udg_Quests[6])and not IsPlayerInForce(Player(id),udg_Quests[7])and not IsPlayerInForce(Player(id),udg_Quests[8])then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Нет, я тебе не доверю поиск могущественного оружия. Только герои, которые помогли мне с начальными заданиями, могут заслужить моё доверие!")
elseif IsPlayerInForce(Player(id),udg_Quests[9])then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Ты очень хорошо поработал - больше у меня нет для тебя заданий.")
endif
endif
endfunction
function InitTrig_StartQuests takes nothing returns nothing
set gg_trg_StartQuests=CreateTrigger()
call TriggerRegisterEnterRectSimple(gg_trg_StartQuests,gg_rct_QuestZone)
call TriggerAddCondition(gg_trg_StartQuests,Condition(function Trig_StartQuests_Conditions))
call TriggerAddAction(gg_trg_StartQuests,function Trig_StartQuests_Actions)
endfunction
function Trig_QuestMurloc_Conditions takes nothing returns boolean
if(not(udg_StartQuests==3))then
return false
endif
if(not(IsUnitType(GetEnteringUnit(),UNIT_TYPE_HERO)==true))then
return false
endif
return true
endfunction
function Trig_QuestMurloc_Func002C takes nothing returns boolean
if(not(UnitHasItemOfTypeBJ(udg_u,'I01S')==true))then
return false
endif
if(not(UnitHasItemOfTypeBJ(udg_u,'I01Q')==true))then
return false
endif
if(not(UnitHasItemOfTypeBJ(udg_u,'I01O')==true))then
return false
endif
return true
endfunction
function Trig_QuestMurloc_Actions takes nothing returns nothing
set udg_u=GetEnteringUnit()
if(Trig_QuestMurloc_Func002C())then
call RemoveItem(GetItemOfTypeFromUnitBJ(udg_u,'I01S'))
call RemoveItem(GetItemOfTypeFromUnitBJ(udg_u,'I01Q'))
call RemoveItem(GetItemOfTypeFromUnitBJ(udg_u,'I01O'))
call UnitAddItemByIdSwapped('I09Q',udg_u)
call DisplayTextToForce(GetForceOfPlayer(GetOwningPlayer(udg_u)),"Отгадал мою загадку? Молодец, вот держи обещанный монокль, а вещички с испытаний я оставлю себе, хе-хе!")
else
call DisplayTextToForce(GetForceOfPlayer(GetOwningPlayer(udg_u)),"|cFF00C850Подсказка:|r\n\nМррмгл-ммрглл! ММГЛЛРГРЛЛЛ!!! Да ладно, я шучу. Монокль? Я могу дать тебе монокль, если ты решишь мою загадку:\n\n\"Я давно не виделся со своими лучшими друзьями - рыцарем, магом и лучником. Приведи их, и я отдам тебе монокль.\"")
endif
endfunction
function InitTrig_QuestMurloc takes nothing returns nothing
set gg_trg_QuestMurloc=CreateTrigger()
call DisableTrigger(gg_trg_QuestMurloc)
call TriggerRegisterEnterRectSimple(gg_trg_QuestMurloc,gg_rct_QuestMurloc)
call TriggerAddCondition(gg_trg_QuestMurloc,Condition(function Trig_QuestMurloc_Conditions))
call TriggerAddAction(gg_trg_QuestMurloc,function Trig_QuestMurloc_Actions)
endfunction
function Trig_QuestPortal_Conditions takes nothing returns boolean
if(not(udg_StartQuests==3))then
return false
endif
if(not(IsUnitType(GetEnteringUnit(),UNIT_TYPE_HERO)==true))then
return false
endif
return true
endfunction
function Trig_QuestPortal_Win takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local real sec=LoadReal(udg_hash,h,0)
local integer wave=LoadInteger(udg_hash,h,1)
local unit portal=LoadUnitHandle(udg_hash,h,2)
local unit hero=LoadUnitHandle(udg_hash,h,3)
local real x=GetUnitX(portal)
local real y=GetUnitY(portal)
local real x1
local real y1
local real xh=GetUnitX(hero)
local real yh=GetUnitY(hero)
local unit u
local integer a=0
if sec<78 then
if wave==0 and sec>10 then
loop
set a=a+1
set u=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),'u000',x,y,GetRandomInt(1,255))
call GroupAddUnit(udg_Quest3UG,u)
exitwhen a==5
endloop
set wave=wave+1
call SaveInteger(udg_hash,h,1,wave)
endif
if wave==1 and sec>40 then
set a=0
loop
set a=a+1
set u=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),'u00S',x,y,GetRandomInt(1,255))
call GroupAddUnit(udg_Quest3UG,u)
set u=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),'n00Q',x,y,GetRandomInt(1,255))
call GroupAddUnit(udg_Quest3UG,u)
set u=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),'n00P',x,y,GetRandomInt(1,255))
call GroupAddUnit(udg_Quest3UG,u)
exitwhen a==3
endloop
set wave=wave+1
call SaveInteger(udg_hash,h,1,wave)
endif
if wave==2 and sec>75 then
set a=0
loop
set a=a+1
set u=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),'uabo',x,y,GetRandomInt(1,255))
call F_Armore(u,10)
call GroupAddUnit(udg_Quest3UG,u)
exitwhen a==3
endloop
set wave=wave+1
call SaveInteger(udg_hash,h,1,wave)
endif
set x1=xh-x
set y1=yh-y
if SquareRoot(x1*x1+y1*y1)<2000 then
set sec=sec+0.1
else
set sec=sec+0.02
endif
call SaveReal(udg_hash,h,0,sec)
else
if CountUnitsInGroup(udg_Quest3UG)==0 then
call PauseTimer(t)
call DestroyTimer(t)
set udg_Quest3Portal=true
call KillUnit(portal)
call FlushChildHashtable(udg_hash,h)
endif
endif
set t=null
set portal=null
set hero=null
set u=null
endfunction
function Trig_QuestPortal_Actions takes nothing returns nothing
local real x=-7840
local real y=3290
local timer t=CreateTimer()
local integer h=GetHandleId(t)
local unit u
local integer a=0
set u=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),'hprt',x,y,200)
call SaveReal(udg_hash,h,0,0)
call SaveInteger(udg_hash,h,1,0)
call SaveUnitHandle(udg_hash,h,2,u)
call SaveUnitHandle(udg_hash,h,3,GetTriggerUnit())
call TimerStart(t,0.1,true,function Trig_QuestPortal_Win)
call DisableTrigger(gg_trg_QuestPortal)
set u=null
set t=null
endfunction
