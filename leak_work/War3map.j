local real yc=GetUnitY(caster)
local real x
local real y
local timer t
local integer ht
if GetSpellAbilityId()=='A006' then
set hp=12.*GetHeroStr(caster,true)
set dmg=0.85*GetHeroStr(caster,true)
call RemoveUnit(udg_Summon)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'ngz1',xc,yc,bj_UNIT_FACING)
set udg_Summon=GetLastCreatedUnit()
call UnitAddAbilityBJ('A007',udg_Summon)
if GetUnitAbilityLevel(caster,'A15Q')==1 then
call UnitAddAbilityBJ('A13N',udg_Summon)
set dmg=1.4*dmg
set hp=1.4*hp
endif
call F_LvlUPAblity(bj_lastCreatedUnit,'A1BF',3)
call SummonStats(true,R2I(hp),R2I(dmg),bj_lastCreatedUnit,caster)
call UnitRemoveAbilityBJ('A007',udg_Summon)
elseif GetSpellAbilityId()=='A00A' then
set hp=6.*GetHeroStr(caster,true)+4.5*GetHeroAgi(caster,true)
set dmg=1.15*GetHeroAgi(caster,true)
if GetUnitAbilityLevel(caster,'A15Q')==1 then
set hp=1.3*hp
endif
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'nqb1',xc,yc,bj_UNIT_FACING)
call F_LvlUPAblity(bj_lastCreatedUnit,'A1BF',3)
call UnitAddAbilityBJ('A007',GetLastCreatedUnit())
call SummonStats(true,R2I(hp),R2I(dmg),bj_lastCreatedUnit,caster)
call UnitRemoveAbilityBJ('A007',GetLastCreatedUnit())
call UnitApplyTimedLifeBJ(60,'BTLF',GetLastCreatedUnit())
if GetUnitAbilityLevel(caster,'A15Q')==1 then
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'nqb1',xc,yc,bj_UNIT_FACING)
call F_LvlUPAblity(bj_lastCreatedUnit,'A1BF',3)
call UnitAddAbilityBJ('A007',GetLastCreatedUnit())
call SummonStats(true,R2I(hp),R2I(dmg),bj_lastCreatedUnit,caster)
call UnitRemoveAbilityBJ('A007',GetLastCreatedUnit())
call UnitApplyTimedLifeBJ(60,'BTLF',GetLastCreatedUnit())
endif
elseif GetSpellAbilityId()=='A00B' then
set hp=4.5*(GetHeroStr(caster,true)+GetHeroInt(caster,true))
set dmg=0.85*GetHeroInt(caster,true)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'nwe2',xc,yc,bj_UNIT_FACING)
call F_LvlUPAblity(bj_lastCreatedUnit,'A1BF',3)
call UnitAddAbilityBJ('A007',GetLastCreatedUnit())
if GetUnitAbilityLevel(caster,'A15Q')==1 then
call UnitAddAbilityBJ('A11K',GetLastCreatedUnit())
call UnitAddAbilityBJ('A026',GetLastCreatedUnit())
set hp=1.3*hp
else
endif
call SummonStats(true,R2I(hp),R2I(dmg),bj_lastCreatedUnit,caster)
call UnitRemoveAbilityBJ('A007',GetLastCreatedUnit())
call UnitApplyTimedLifeBJ(60,'BTLF',GetLastCreatedUnit())
elseif GetSpellAbilityId()=='A00C' then
set hp=10*GetHeroStr(caster,true)+2*GetHeroAgi(caster,true)+2*GetHeroInt(caster,true)
set dmg=0.45*(GetHeroStr(caster,true)+GetHeroAgi(caster,true)+GetHeroInt(caster,true))
if GetUnitAbilityLevel(caster,'A15Q')==1 then
set hp=2*hp
set dmg=1.3*dmg
endif
set x=xc+125*Cos(GetUnitFacing(caster)*bj_DEGTORAD)
set y=yc+125*Sin(GetUnitFacing(caster)*bj_DEGTORAD)
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>6
set u=CreateUnit(GetOwningPlayer(caster),'nstw',x,y,GetUnitFacing(caster))
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
set bj_lastCreatedItem=CreateItem('I0DD',GetUnitX(u),GetUnitY(u))
call UnitAddItem(u,bj_lastCreatedItem)
set bj_lastCreatedItem=CreateItem('I0DD',GetUnitX(u),GetUnitY(u))
call UnitAddItem(u,bj_lastCreatedItem)
set bj_lastCreatedItem=CreateItem('I0DF',GetUnitX(u),GetUnitY(u))
call UnitAddItem(u,bj_lastCreatedItem)
call UnitRemoveAbility(u,'A007')
call UnitApplyTimedLife(u,'BTLF',50.)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
if GetSpellAbilityId()=='A1DK' then
set u=CreateUnit(GetOwningPlayer(caster),'ngzc',xc,yc,GetUnitFacing(caster))
call UnitApplyTimedLife(u,'BTLF',14)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveUnitHandle(udg_hash,ht,1,u)
call TimerStart(t,0.25,true,function Trig_Zveroboy_Jojo)
elseif GetSpellAbilityId()=='A1DL' then
set hp=20+0.25*GetHeroStr(caster,true)+GetHeroLevel(caster)
set dmg=20+0.25*GetHeroAgi(caster,true)+GetHeroLevel(caster)
if GetUnitAbilityLevel(caster,'A1DO')==1 and GetUnitAbilityLevel(caster,'B039')>=1 then
set r=20+0.25*GetHeroInt(caster,true)+GetHeroLevel(caster)
else
set r=0
endif
call TempStats(caster,R2I(hp),R2I(dmg),R2I(r),0,0,0,PositiveDuration(caster,12.))
elseif GetSpellAbilityId()=='A1DM' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set u=CreateUnit(GetOwningPlayer(caster),'nwe1',xc,yc,GetUnitFacing(caster))
call UnitApplyTimedLife(u,'BTLF',20)
call IssuePointOrder(u,"move",x,y)
endif
set caster=null
set u=null
set t=null
endfunction
