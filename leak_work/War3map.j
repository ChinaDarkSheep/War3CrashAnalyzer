function Trig_Thing_Actions takes nothing returns nothing
local unit thingbody
local integer id=GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
local unit u
local real x
local real y
local real hp
local integer a
if GetSpellAbilityId()=='A17L' then
set u=GetSpellTargetUnit()
set a=0
if GetUnitLevel(u)>=15 and ModuloInteger(GetUnitLevel(u),5)==0 then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],3.00,"Нельзя скопировать босса!")
set a=1
endif
if GetUnitAbilityLevel(u,'Arsk')==1 or IsUnitType(u,UNIT_TYPE_HERO)or GetUnitTypeId(u)=='n02P' then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],3.00,"Нельзя скопировать данное существо!")
set a=1
endif
if GetHeroLevel(udg_Hero[id+1])<50 then
if GetHeroLevel(udg_Hero[id+1])<GetUnitLevel(u)*3 then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],3.00,"Вам нехватает уровня!")
set a=1
endif
endif
if a==0 then
set udg_ThingSummon[udg_ThingNumber]=GetUnitTypeId(u)
set udg_ThingSummon[4]=GetUnitTypeId(u)
endif
endif
if GetSpellAbilityId()=='A17M' then
if udg_Setstart then
call SetUnitAbilityLevel(udg_Thing,'A17M',2)
endif
call ShowUnit(udg_Thing,false)
set x=GetUnitX(udg_Thing)
set y=GetUnitY(udg_Thing)
set udg_ThingBody=CreateUnit(Player(id),udg_ThingSummon[4],x,y,GetUnitFacing(udg_Thing))
call SeekFreeUnit(GetHandleId(udg_ThingBody))
set thingbody=udg_ThingBody
call GroupAddUnit(udg_UnordinaryUnit,thingbody)
set udg_ThingHP=GetUnitState(thingbody,UNIT_STATE_MAX_LIFE)
call UnitAddAbility(thingbody,'A0U7')
call UnitAddAbility(thingbody,'A0LN')
call UnitAddAbility(thingbody,'A18D')
call UnitAddAbility(thingbody,'A140')
call UnitAddAbility(thingbody,'A17N')
call UnitAddAbility(thingbody,'A17O')
call UnitAddAbility(thingbody,'A17Q')
set a=GetPlayerTechCount(Player(id),'R03J',true)
call SetUnitAbilityLevel(thingbody,'A11P',a+1)
set a=GetPlayerTechCount(Player(id),'R04W',true)
call SetUnitAbilityLevel(thingbody,'A17N',a*2+1)
set a=GetPlayerTechCount(Player(id),'R04Z',true)
call SetUnitAbilityLevel(thingbody,'A17O',a+1)
set a=GetPlayerTechCount(Player(id),'R052',true)
call SetUnitAbilityLevel(thingbody,'A17R',a+1)
call SetUnitAbilityLevel(thingbody,'A17U',a+1)
call UnitAddAbility(thingbody,'A007')
set hp=(600.+0.1*GetUnitState(thingbody,UNIT_STATE_MAX_LIFE))*GetPlayerTechCount(Player(id),'R04Y',true)
set hp=hp+400
call SummonStats(false,R2I(hp),32,thingbody,thingbody)
call UnitRemoveAbility(thingbody,'A007')
call SelectUnitForPlayerSingle(udg_ThingBody,Player(id))
endif
if GetSpellAbilityId()=='A0YY' then
set udg_ThingNumber=1
set udg_ThingSummon[4]=udg_ThingSummon[udg_ThingNumber]
endif
if GetSpellAbilityId()=='A17V' then
set udg_ThingNumber=2
set udg_ThingSummon[4]=udg_ThingSummon[udg_ThingNumber]
endif
if GetSpellAbilityId()=='A17W' then
set udg_ThingNumber=3
set udg_ThingSummon[4]=udg_ThingSummon[udg_ThingNumber]
endif
if GetSpellAbilityId()=='A18C' then
set udg_ThingNumber=5
set udg_ThingSummon[4]=udg_ThingSummon[udg_ThingNumber]
endif
set thingbody=null
set u=null
endfunction
function InitTrig_Thing takes nothing returns nothing
set gg_trg_Thing=CreateTrigger()
call TriggerAddAction(gg_trg_Thing,function Trig_Thing_Actions)
endfunction
