function Quest_New_Boss_Tornado takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit tornado=LoadUnitHandle(udg_hash,ht,0)
local unit boss=LoadUnitHandle(udg_hash,ht,1)
local real dist=LoadReal(udg_hash,ht,0)
local real ugol=LoadReal(udg_hash,ht,1)
local real dmg=LoadReal(udg_hash,ht,2)*0.015
local boolean circle=LoadBoolean(udg_hash,ht,0)
local real xb=GetUnitX(boss)
local real yb=GetUnitY(boss)
local real x
local real y
if UnitAlive(boss)then
if circle==false then
if dist>=800. then
set dist=800.
call SaveBoolean(udg_hash,ht,0,true)
else
set dist=dist+0.9
endif
else
if dist<250. then
set dist=250.
call SaveBoolean(udg_hash,ht,0,false)
else
set dist=dist-0.9
endif
endif
set ugol=ugol+2.25
if ugol>360. then
set ugol=ugol-360.
endif
set x=xb+dist*Cos(ugol*bj_DEGTORAD)
set y=yb+dist*Sin(ugol*bj_DEGTORAD)
call GroupDamage(x,y,250.,boss,false,dmg,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL)
call GroupDamage(x,y,250.,boss,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
call SetUnitX(tornado,x)
call SetUnitY(tornado,y)
call SaveReal(udg_hash,ht,0,dist)
call SaveReal(udg_hash,ht,1,ugol)
else
call RemoveUnit(tornado)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
set tornado=null
set boss=null
endfunction
function Quest_New_FlowerS takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer ht2=LoadInteger(udg_hash,ht,0)
local integer number=LoadInteger(udg_hash,ht2,3)
local integer id=LoadInteger(udg_hash,ht2,0)
local real sec=LoadReal(udg_hash,ht,0)
local real xf=LoadReal(udg_hash,ht,'x')
local real yf=LoadReal(udg_hash,ht,'y')
local real xh=GetUnitX(udg_Hero[id+1])
local real yh=GetUnitY(udg_Hero[id+1])
local real dx
local real dy
local real range
local real max_range=LoadReal(udg_hash,ht2,4)
local boolean end=false
local real finish=3.
if number>0 and number !=0 and udg_Time[2]<30. then
set dx=xf-xh
set dy=yf-yh
set range=SquareRoot(dx*dx+dy*dy)
if range<max_range then
call SaveReal(udg_hash,ht2,4,range)
endif
if range<300. then
set sec=sec+0.1*(1.+0.001*(GetHeroStr(udg_Hero[id+1],true)+GetHeroAgi(udg_Hero[id+1],true)+GetHeroInt(udg_Hero[id+1],true)))
call SaveReal(udg_hash,ht,0,sec)
if HardcoreUP10==2 then
set finish=5
endif
if sec>finish then
set end=true
set number=number-1
call SaveInteger(udg_hash,ht2,3,number)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl",xf,yf)
call DestroyEffect(bj_lastCreatedEffect)
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Осталось цветов: "+I2S(number))
set udg_TEXT=CreateTextTag()
call SetTextTagTextBJ(udg_TEXT,"|c0096FF96Цветок собран",10.)
call SetTextTagPos(udg_TEXT,xf,yf,0)
call SetTextTagColorBJ(udg_TEXT,100,100,100,0)
call ShowTextTagForceBJ(false,udg_TEXT,GetPlayersAll())
call ShowTextTagForceBJ(true,udg_TEXT,bj_FORCE_PLAYER[id])
call SetTextTagVelocityBJ(udg_TEXT,75.00,90.00)
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
endif
else
call SaveReal(udg_hash,ht,0,0.)
endif
else
set end=true
endif
if end then
call DestroyEffect(LoadEffectHandle(udg_hash,ht,1))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
endfunction
function Quest_New_Use takes nothing returns nothing
local integer Slot
local boolean QuestStart=false
local integer hi
local item Item
local item BuyItem=GetSoldItem()
local integer itid
local integer select
local real x
local real y
local real x1
local real y1
local integer id=GetPlayerId(GetOwningPlayer(GetBuyingUnit()))
local timer t
local timer t2
local integer h
local integer ht
local integer ht2
local integer gold
local integer a=0
local integer b=0
local integer c=0
local integer d=0
local integer questB=0
local integer ra
local real dmg
local real hp
local real r
local real angle
local real dist
local integer lvl
local integer reward
local unit u
local group g
local integer slot
local real up=1
if HardcoreUP10==2 then
set up=up+0.4
endif
call PauseTimer(TimerResetQuest)
if GetUnitTypeId(GetSellingUnit())=='h043' then
if GetItemTypeId(BuyItem)=='thdm' then
set Item=UnitItemInSlot(BaseGuild,0)
set slot=0
set questB=1
elseif GetItemTypeId(BuyItem)=='srtl' then
set Item=UnitItemInSlot(BaseGuild,1)
set slot=1
set questB=1
elseif GetItemTypeId(BuyItem)=='blba' then
set Item=UnitItemInSlot(BaseGuild,2)
set slot=2
set questB=1
elseif GetItemTypeId(BuyItem)=='tels' then
set Item=UnitItemInSlot(BaseGuild,3)
set slot=3
set questB=1
elseif GetItemTypeId(BuyItem)=='anfg' then
set Item=UnitItemInSlot(BaseGuild,4)
set slot=4
set questB=1
elseif GetItemTypeId(BuyItem)=='soul' then
set Item=UnitItemInSlot(BaseGuild,5)
set slot=5
set questB=1
elseif GetItemTypeId(BuyItem)=='esaz' then
if GetLocalPlayer()==Player(id)then
call ClearTextMessages()
endif
set bj_forLoopAIndex=0
loop
exitwhen bj_forLoopAIndex>5
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Задание №|r"+I2S(bj_forLoopAIndex+1)+": "+LoadStr(udg_hash,GetHandleId(UnitItemInSlot(BaseGuild,bj_forLoopAIndex)),'t'))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call RemoveItem(BuyItem)
endif
if questB==1 then
set QuestStart=true
set hi=GetHandleId(UnitItemInSlot(BaseGuild,slot))
set lvl=LoadInteger(udg_hash,GetHandleId(Item),'l')
set reward=LoadInteger(udg_hash,GetHandleId(Item),'r')
endif
if QuestStart==false then
elseif s__PlayerQuest[id]>0 then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00В данный момент вы не можете выбрать новое задание|r")
call FlushChildHashtable(udg_hash,GetHandleId(BuyItem))
call RemoveItem(BuyItem)
else
set itid=GetItemTypeId(Item)
if itid=='cnob' or itid=='dsum' or itid=='sbch' then
if s__Quests_Guild_unlock[sQuest[0]]==0 then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Все точки заняты")
set QuestStart=false
else
set select=GetQuest(0)
set x=s___Quests_Guild_x[s__Quests_Guild_x[sQuest[0]]+select]
set y=s___Quests_Guild_y[s__Quests_Guild_y[sQuest[0]]+select]
set u=CreateUnit(Player(11),'n07H',x,y,0.)
set h=GetHandleId(u)
call UnitAddAbility(u,'A17N')
call SetUnitAbilityLevel(u,'A17N',11)
if itid=='cnob' then
set r=400.
set hp=1500.
set dmg=100.
set gold=225+GetRandomInt(1,4)*25
elseif itid=='dsum' then
set r=1250.
set hp=7000.
set dmg=450.
set gold=500+GetRandomInt(1,6)*25
elseif itid=='sbch' then
set r=4000.
set hp=15000.
set dmg=900.
set gold=1000+GetRandomInt(1,4)*50
endif
set hp=hp*up
set dmg=dmg*up
if HardcoreBuff10==4 then
set gold=R2I(gold*1.3)
endif
call UnitAddAbility(u,'A1DX')
call UnitAddAbility(u,'A007')
call SummonStats(false,R2I(hp),R2I(dmg),u,u)
call SetUnitOwner(u,Player(PLAYER_NEUTRAL_AGGRESSIVE),true)
call UnitRemoveAbility(u,'A007')
call PingMinimapForForceEx(bj_FORCE_PLAYER[id],x,y,60.,bj_MINIMAPPINGSTYLE_FLASHY,20.,20.,80.)
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Убейте бандита в заданной точке в течении 2 минут!|r")
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cffffcc00Награда "+I2S(gold)+" ед. золота|r")
