function Trig_Zveroboy_Jojo takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local unit bear=LoadUnitHandle(udg_hash,ht,1)
local real xh=GetUnitX(hero)
local real yh=GetUnitY(hero)
local real xb=GetUnitX(bear)
local real yb=GetUnitY(bear)
local real r
local real r1
local real dx=xb-xh
local real dy=yb-yh
if UnitAlive(bear)then
call SetUnitMoveSpeed(bear,GetUnitMoveSpeed(hero))
set r=GetRandomInt(1,2)
set r1=GetRandomInt(1,2)
if r==1 then
set r=GetRandomInt(50,100)
else
set r=0-GetRandomInt(50,100)
endif
if r1==1 then
set r1=GetRandomInt(50,100)
else
set r1=0-GetRandomInt(50,100)
endif
if SquareRoot(dx*dx+dy*dy)>1200 then
call SetUnitX(bear,xh)
call SetUnitY(bear,yh)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl",xh+r,yh+r1)
call DestroyEffect(bj_lastCreatedEffect)
endif
call IssuePointOrder(bear,"attack",xh+r,yh+r1)
else
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
set t=null
set hero=null
set bear=null
endfunction
function Trig_Zveroboy_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
