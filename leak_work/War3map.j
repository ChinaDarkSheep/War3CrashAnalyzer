function Trig_HeroD53_var2_Actions takes nothing returns nothing
local unit caster=GetSpellAbilityUnit()
local unit target=GetSpellTargetUnit()
local real time
local timer t
local integer h
local integer ht=GetHandleId(target)
local real y
local integer i
if GetUnitAbilityLevel(caster,'A00A')==1 then
set time=20
else
set time=15
endif
if IsUnitAlly(target,GetOwningPlayer(caster))then
set i=4*GetHeroInt(target,false)/10
call TempStats(caster,0,0,i,0,0,0,time)
call TempStats(target,0,0,i,0,0,0,time)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Human\\MagicSentry\\MagicSentryCaster.mdl",caster,"overhead")
call Effect_Del(bj_lastCreatedEffect,time)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Human\\MagicSentry\\MagicSentryCaster.mdl",target,"overhead")
call Effect_Del(bj_lastCreatedEffect,time)
else
call TempStats(caster,0,0,3*GetHeroInt(caster,false)/10,0,0,0,time)
set i=LoadInteger(Hash,ht,0)
set s__Units_MageTake[sUnit[i]]=s__Units_MageTake[sUnit[i]]+3000
set t=CreateTimer()
set h=GetHandleId(t)
call SaveUnitHandle(udg_hash,h,0,target)
call TimerStart(t,time,false,function Trig_HeroD53_var2_MageBlock)
endif
set t=null
set caster=null
set target=null
endfunction
