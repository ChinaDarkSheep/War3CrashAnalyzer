call SeekFreeUnit(h)
endif
set s__Units_Immortal[sUnit[i]]=s__Units_Immortal[sUnit[i]]+1
call SaveInteger(udg_hash,ht,0,h)
call TimerStart(t,sec,false,function Immortal_Timer)
set t=null
endfunction
