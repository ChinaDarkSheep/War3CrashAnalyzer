function Trig_RenaSkills_Q takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit Q=LoadUnitHandle(udg_hash,ht,0)
local real x=GetUnitX(Q)
local real y=GetUnitY(Q)
set bj_lastCreatedEffect=AddSpecialEffect("Objects\\Spawnmodels\\NightElf\\NECancelDeath\\NECancelDeath.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
call F_RemoveUnit(Q)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set Q=null
set t=null
endfunction
function F_Rena_D takes unit caster,unit u,boolean perm returns nothing
local integer h=GetHandleId(caster)
local integer ihh=LoadInteger(udg_hash,h,5)
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local integer int=GetHeroInt(caster,true)-s__Heroes_TempInt[sHero[ihh]]/2
local real dmg=.4*int
local real hp=4.*int
if GetUnitAbilityLevel(u,'A0M7')==1 then
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"|cFFF52719Нельзя применить к этому воину!|r")
else
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl",u,"origin")
call DestroyEffect(bj_lastCreatedEffect)
call SetUnitVertexColorBJ(u,40.00,100,40.00,0)
call UnitAddAbility(u,'A0M7')
if GetUnitAbilityLevel(caster,'A0M6')==1 and GetUnitTypeId(u)=='n051' then
set hp=2*hp
set dmg=2*dmg
if perm then
call UnitPauseTimedLife(u,true)
endif
else
endif
call UnitAddAbility(u,'A007')
call SummonStats(false,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'A007')
if GetUnitTypeId(GetSpellTargetUnit())=='n04B' then
call UnitAddAbility(u,'A0CR')
else
endif
endif
endfunction
function Trig_RenaSkills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer h=GetHandleId(caster)
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local integer ihh=LoadInteger(udg_hash,h,5)
local unit u
local real x
local real y
local real x1
local real y1
local integer int=GetHeroInt(caster,true)-s__Heroes_TempInt[sHero[ihh]]/2
local integer a
local real dmg=0
local real hp=0
local real r
local timer t
local integer ht
local group g
if GetSpellAbilityId()=='A0M8' then
set a=0
loop
exitwhen a>=8
if not UnitAlive(udg_Hero[a+1])and a !=ID-1 and udg_Hero[a+1]!=null then
set x=GetUnitX(caster)+GetRandomReal(40.00,120.00)*Cos((GetRandomReal(0,360))*bj_DEGTORAD)
set y=GetUnitY(caster)+GetRandomReal(40.00,120.00)*Sin((GetRandomReal(0,360))*bj_DEGTORAD)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Other\\Awaken\\Awaken.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
call ReviveHero(udg_Hero[a+1],x,y,true)
call DamageRes(udg_Hero[a+1])
call PanCameraToTimedForPlayer(Player(a),x,y,0)
call SelectUnitForPlayerSingle(udg_Hero[a+1],Player(a))
endif
set a=a+1
endloop
endif
if GetSpellAbilityId()=='A0ME' then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
if GetHeroLevel(caster)>=50 then
set hp=GetHeroStr(caster,true)*2+8*int
else
set hp=GetHeroStr(caster,true)*1+4*int
endif
set dmg=0.2*int
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>4
set x1=x+120*Cos((GetUnitFacing(caster)+90.*bj_forLoopAIndex)*bj_DEGTORAD)
set y1=y+120*Sin((GetUnitFacing(caster)+90.*bj_forLoopAIndex)*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(caster),'n051',x1,y1,(GetUnitFacing(caster)+90*bj_forLoopAIndex))
if GetUnitAbilityLevel(caster,'A0M6')==1 then
call UnitApplyTimedLife(u,'BTLF',80.)
else
call UnitApplyTimedLife(u,'BTLF',40.)
endif
if ModuloInteger(bj_forLoopAIndex,2)==0 then
call F_Rena_D(caster,u,false)
endif
if GetHeroLevel(caster)>=50 then
call UnitAddAbility(u,'A0DC')
endif
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'A007')
if GetHeroLevel(caster)>=50 then
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+10)
endif
set bj_lastCreatedEffect=AddSpecialEffect("Objects\\Spawnmodels\\Demon\\DemonSmallDeathExplode\\DemonSmallDeathExplode.mdl",x1,y1)
call DestroyEffect(bj_lastCreatedEffect)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
if udg_ReactorAganim[ID]then
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>4
set x1=x+240*Cos((GetUnitFacing(caster)+90.*bj_forLoopAIndex)*bj_DEGTORAD)
set y1=y+240*Sin((GetUnitFacing(caster)+90.*bj_forLoopAIndex)*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(caster),'n051',x1,y1,(GetUnitFacing(caster)+90*bj_forLoopAIndex))
call UnitApplyTimedLife(u,'BTLF',40.)
call UnitAddAbility(u,'A0DC')
call F_Rena_D(caster,u,false)
set bj_lastCreatedEffect=AddSpecialEffect("Objects\\Spawnmodels\\Demon\\DemonSmallDeathExplode\\DemonSmallDeathExplode.mdl",x1,y1)
call DestroyEffect(bj_lastCreatedEffect)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
endif
if GetSpellAbilityId()=='A0M5' and IsUnitAlly(GetSpellTargetUnit(),GetOwningPlayer(caster))then
set u=GetSpellTargetUnit()
call F_Rena_D(caster,u,true)
endif
if GetSpellAbilityId()=='A0MB' then
set x1=GetSpellTargetX()
set y1=GetSpellTargetY()
set u=CreateUnit(GetOwningPlayer(caster),'h03S',x1,y1,0.)
call SetUnitAbilityLevel(u,'A0MD',GetUnitAbilityLevel(caster,'A0MB'))
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call TimerStart(t,20.,false,function Trig_RenaSkills_Q)
set bj_lastCreatedEffect=AddSpecialEffect("Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl",x1,y1)
call DestroyEffect(bj_lastCreatedEffect)
if GetHeroLevel(caster)>=50 then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set bj_forLoopAIndex=1
set r=90.
if GetHeroLevel(caster)>=50 then
set hp=GetHeroStr(caster,true)*2+8*int
else
set hp=GetHeroStr(caster,true)*1+4*int
endif
set dmg=0.2*int
loop
exitwhen bj_forLoopAIndex>4
set x1=x+120*Cos(((GetUnitFacing(caster)+r*I2R(bj_forLoopAIndex))+120*bj_forLoopAIndex)*bj_DEGTORAD)
set y1=y+120*Sin(((GetUnitFacing(caster)+r*I2R(bj_forLoopAIndex))+120*bj_forLoopAIndex)*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(caster),'n051',x1,y1,(GetUnitFacing(caster)+r*bj_forLoopAIndex))
call UnitAddAbility(u,'A0M7')
call UnitAddAbility(u,'A13N')
call UnitApplyTimedLife(u,'BTLF',30.)
call UnitAddAbility(u,'A007')
call UnitAddAbility(u,'A0DC')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+10)
call UnitRemoveAbility(u,'A007')
set bj_lastCreatedEffect=AddSpecialEffect("Objects\\Spawnmodels\\Demon\\DemonSmallDeathExplode\\DemonSmallDeathExplode.mdl",x1,y1)
call DestroyEffect(bj_lastCreatedEffect)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
endif
if GetSpellAbilityId()=='A0MC' then
set x1=GetSpellTargetX()
set y1=GetSpellTargetY()
set g=CreateGroup()
set dmg=50*GetUnitAbilityLevel(caster,'A0MC')+3*GetHeroInt(caster,true)
call GroupEnumUnitsInRange(g,x1,y1,300.,Condition(function FilterAlive))
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitEnemy(u,GetOwningPlayer(caster))then
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("war3mapImported\\Lava_Burn_Green.mdx",u,"origin")
call DestroyEffect(bj_lastCreatedEffect)
if GetUnitAbilityLevel(u,'B01B')>0 and UnitAlive(u)then
set x=GetUnitX(u)
set y=GetUnitY(u)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'h009',x,y,0)
call UnitAddAbility(bj_lastCreatedUnit,'A0SD')
call SetUnitAbilityLevel(bj_lastCreatedUnit,'A0SD',GetUnitAbilityLevel(caster,'A0MC'))
call IssueTargetOrder(bj_lastCreatedUnit,"entanglingroots",u)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',0.75)
endif
endif
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
else
endif
set g=null
set caster=null
set u=null
set t=null
endfunction
function InitTrig_RenaSkills takes nothing returns nothing
set gg_trg_RenaSkills=CreateTrigger()
call TriggerAddAction(gg_trg_RenaSkills,function Trig_RenaSkills_Actions)
endfunction
function Trig_Grifon_Filter takes nothing returns boolean
return(UnitAlive(GetFilterUnit())and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(GetTriggerUnit())))
endfunction
function Trig_Grifon_Gromootvod takes unit caster,real x,real y,real radius,integer count returns nothing
local integer id=GetPlayerId(GetOwningPlayer(caster))
local integer h=GetHandleId(caster)
local integer iuh=LoadInteger(Hash,h,0)
local unit u
local unit target
local real dmg
local integer lvl
local integer a
local integer ht
local real x1
local real y1
local integer talante=udg_Talante[id+1]
local group g=CreateGroup()
local group g1=CreateGroup()
local group g2=CreateGroup()
local integer Loop=1
if talante==1 then
set a=50*GetUnitAbilityLevel(caster,'A0MU')+GetHeroStr(caster,true)+s__Units_GAttack[sUnit[iuh]]
call TempStats(caster,0,0,0,a,0,0,PositiveDuration(caster,6))
endif
set dmg=GetHeroStr(caster,true)+.75*GetHeroInt(caster,true)+100.*GetUnitAbilityLevel(caster,'A0MU')
if talante==2 then
set dmg=2.*dmg
endif
loop
exitwhen Loop>count
set udg_Drop2=id
set FilterGroup=g2
call GroupEnumUnitsInRange(g,x,y,radius,Bool_Trig_Filter_ID_FG)
call RandomUnitFromGroup(1,g)
set target=FirstOfGroup(g)
set x1=GetUnitX(target)
set y1=GetUnitY(target)
set bj_lastCreatedUnit=CreateUnit(Player(id),'h03V',x1,y1,bj_UNIT_FACING)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',0.19)
set udg_Drop2=id
set FilterGroup=g2
call GroupEnumUnitsInRange(g1,x1,y1,225.,Bool_Trig_Filter_ID_FG)
loop
set u=FirstOfGroup(g1)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupAddUnit(g2,u)
call GroupRemoveUnit(g1,u)
endloop
set Loop=Loop+1
endloop
call DestroyGroup(g)
call DestroyGroup(g1)
call DestroyGroup(g2)
set g=null
set g1=null
set g2=null
set u=null
set target=null
endfunction
function Trig_Grifon_Q takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,1)
local unit tornado=LoadUnitHandle(udg_hash,ht,0)
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local real dmg=30*GetUnitAbilityLevel(caster,'A0MZ')+0.6*GetHeroStr(caster,true)
local real x=GetUnitX(tornado)
local real y=GetUnitY(tornado)
local integer talante=udg_Talante[ID]
local integer tic=LoadInteger(udg_hash,ht,0)+1
if UnitAlive(tornado)then
call SaveInteger(udg_hash,ht,0,tic)
call GroupDamage(x,y,300,caster,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
if talante==2 and GetUnitAbilityLevel(caster,'A0N1')==1 and ModuloInteger(tic,4)==0 then
call Trig_Grifon_Gromootvod(caster,x,y,500.,2)
endif
else
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
set caster=null
set tornado=null
set t=null
endfunction
function Trig_Grifon_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local group g=LoadGroupHandle(udg_hash,ht,1)
local unit u
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitAddAbility(u,'A0MW')
call GroupRemoveUnit(g,u)
endloop
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
set g=null
set t=null
set u=null
endfunction
function Trig_Grifon_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local integer h=GetHandleId(caster)
local unit u
local real xc=GetUnitX(caster)
local real yc=GetUnitY(caster)
local real dmg
local integer lvl
local integer a
local timer t
local integer ht
local real x
local real y
local real r
local group g=CreateGroup()
local group g1
local integer talante=udg_Talante[ID]
if GetSpellAbilityId()=='A1CV' then
set lvl=LoadInteger(udg_hash,h,'D')
set dmg=175.
if lvl>=10 then
set dmg=4500.
else
if lvl==2 then
set dmg=350.
elseif lvl==3 then
set dmg=525.
elseif lvl==4 then
set dmg=750.
elseif lvl==5 then
set dmg=1100.
elseif lvl==6 then
set dmg=1500.
elseif lvl==7 then
set dmg=2100.
elseif lvl==8 then
set dmg=2750.
elseif lvl==9 then
set dmg=3600.
endif
endif
if GetHeroLevel(caster)>=50 then
set dmg=dmg+4.*GetHeroStr(caster,true)
endif
set u=GetSpellTargetUnit()
if talante==1 then
set dmg=dmg+Summ_Attack(caster)
if GetUnitAbilityLevel(caster,'A0N1')==1 then
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>5
call Modificator(caster,caster,u)
call HeroAttack(caster,caster,u)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
elseif talante==2 then
call SaveUnitHandle(udg_hash,h,'d',u)
if GetUnitAbilityLevel(caster,'A0N1')==1 then
set dmg=1.5*dmg
endif
endif
call CreateTextTagUnitBJ("|cFFFF5800"+I2S(R2I(dmg))+"|r",caster,0,10.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
set u=CreateUnit(GetOwningPlayer(caster),'h05G',xc,yc,GetUnitFacing(caster))
call UnitApplyTimedLife(u,'BTLF',5.)
set a=SeekFreeDummys(u,GetHandleId(u))
set s__Dummys_dmg[sDummy[a]]=dmg
call UnitAddAbility(u,'A0MX')
call IssueTargetOrder(u,"thunderbolt",GetSpellTargetUnit())
set udg_StormBoltGrifon=udg_StormBoltGrifon+1
if udg_StormBoltGrifon==10 and lvl<10 then
set udg_StormBoltGrifon=0
call SaveInteger(udg_hash,h,'D',lvl+1)
endif
elseif GetSpellAbilityId()=='A0MZ' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set r=bj_RADTODEG*Atan2(y-yc,x-xc)
set x=x+2000.*Cos(r*bj_DEGTORAD)
set y=y+2000.*Sin(r*bj_DEGTORAD)
set u=CreateUnit(Player(ID-1),'ntor',xc,yc,GetUnitFacing(caster))
call IssuePointOrder(u,"move",x,y)
call UnitApplyTimedLife(u,'BTLF',9.)
if talante==1 then
call UnitAddAbility(u,'A177')
call SetUnitAbilityLevel(u,'A177',5+GetUnitAbilityLevel(caster,'A0MZ'))
call UnitAddAbility(u,'A11Q')
call SetUnitAbilityLevel(u,'A11Q',2)
endif
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call SaveUnitHandle(udg_hash,ht,1,caster)
call SaveInteger(udg_hash,ht,0,0)
call TimerStart(t,1.,true,function Trig_Grifon_Q)
elseif GetSpellAbilityId()=='A0MU' then
if talante==2 and GetUnitAbilityLevel(caster,'A0N1')==1 then
set a=8
set r=800.
else
set a=6
set r=600.
endif
call Trig_Grifon_Gromootvod(caster,xc,yc,r,a)
elseif GetSpellAbilityId()=='A0MV' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set dmg=(GetHeroStr(caster,true)+GetHeroInt(caster,true))*4
if talante==2 then
set dmg=dmg+GetHeroStr(caster,true)*8
endif
set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\Eternal Explode.mdx",x,y)
call DestroyEffect(bj_lastCreatedEffect)
set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\Eternal Explode.mdx",x,y)
call DestroyEffect(bj_lastCreatedEffect)
call GroupEnumUnitsInRange(g,x,y,350.,Condition(function Trig_Grifon_Filter))
set g1=CreateGroup()
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
if UnitAlive(u)then
call GroupAddUnit(g1,u)
call UnitAddAbility(u,'A0MW')
endif
call GroupRemoveUnit(g,u)
endloop
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveGroupHandle(udg_hash,ht,1,g1)
call TimerStart(t,7.,false,function Trig_Grifon_R)
endif
call DestroyGroup(g)
set g=null
set g1=null
set caster=null
set u=null
set t=null
endfunction
function InitTrig_Grifon takes nothing returns nothing
set gg_trg_Grifon=CreateTrigger()
call TriggerAddAction(gg_trg_Grifon,function Trig_Grifon_Actions)
endfunction
