local integer i
local integer a
local integer b
local real x
local real y
local real z
local real r
local real x1
local real y1
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local integer id=GetPlayerId(GetOwningPlayer(hero))
local integer talante=udg_Talante[ID]
local group g=CreateGroup()
local unit u
local timer t
local integer ht
local integer ihh=LoadInteger(udg_hash,h,5)
if GetUnitAbilityLevel(hero,'A196')>0 then
set x=GetUnitX(hero)
set y=GetUnitY(hero)
set x1=x-LoadReal(udg_hash,h,StringHash("RouteX"))
set y1=y-LoadReal(udg_hash,h,StringHash("RouteY"))
set r=SquareRoot(x1*x1+y1*y1)
set z=LoadReal(udg_hash,h,StringHash("RouteR"))+r
call SaveReal(udg_hash,h,StringHash("RouteR"),z)
call SaveReal(udg_hash,h,StringHash("RouteX"),x)
call SaveReal(udg_hash,h,StringHash("RouteY"),y)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveReal(udg_hash,ht,1,r)
call TimerStart(t,4.,false,function Timer25ms_Route)
set a=GetUnitAbilityLevel(hero,'A196')*3+GetHeroStr(hero,false)/10
set b=GetUnitAbilityLevel(hero,'A196')*3+GetHeroAgi(hero,false)/10
set r=1+z/2000
if r>4 then
set a=a*4
set b=b*4
else
set a=R2I(a*r)
set b=R2I(b*r)
endif
set s__Heroes_Str[sHero[ihh]]=s__Heroes_Str[sHero[ihh]]+a-LoadInteger(udg_hash,h,StringHash("RouteStr"))
set s__Heroes_Agi[sHero[ihh]]=s__Heroes_Agi[sHero[ihh]]+b-LoadInteger(udg_hash,h,StringHash("RouteAgi"))
call SaveInteger(udg_hash,h,StringHash("RouteStr"),a)
call SaveInteger(udg_hash,h,StringHash("RouteAgi"),b)
endif
if GetUnitAbilityLevel(hero,'A0CS')==1 and talante==2 then
set i=LoadInteger(Hash,h,0)
set a=LoadInteger(udg_hash,h,'f')
set s__Units_AllBlock[sUnit[i]]=s__Units_AllBlock[sUnit[i]]-a
set a=R2I(100*GetUnitState(hero,UNIT_STATE_LIFE)/GetUnitState(hero,UNIT_STATE_MAX_LIFE))
if a<=50 then
set a=800+10*(100-a)
set s__Units_AllBlock[sUnit[i]]=s__Units_AllBlock[sUnit[i]]+a
else
set a=0
endif
call SaveInteger(udg_hash,h,'f',a)
endif
if s__Heroes_item_I0EQ[sHero[ihh]]>0 then
set x=GetUnitX(hero)
set y=GetUnitY(hero)
set x1=x+375.*Cos(GetUnitFacing(hero)*bj_DEGTORAD)
set y1=y+375.*Sin(GetUnitFacing(hero)*bj_DEGTORAD)
set udg_Drop2=id
call GroupEnumUnitsInRange(g,x1,y1,425.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call GroupAddUnit(Ggorgona,u)
call GroupRemoveUnit(g,u)
endloop
endif
if s__Heroes_item_I0ER[sHero[ihh]]>0 then
set x=GetUnitState(hero,UNIT_STATE_LIFE)/GetUnitState(hero,UNIT_STATE_MAX_LIFE)
if x>0.8 then
call SetUnitState(hero,UNIT_STATE_LIFE,0.8*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
endif
set y=GetUnitState(hero,UNIT_STATE_LIFE)
if y>100 then
call SetUnitState(hero,UNIT_STATE_LIFE,y-(0.02*y)*0.25)
endif
set r=0.25*(0.08*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
set x=GetUnitX(hero)
set y=GetUnitY(hero)
set udg_Drop2=id
call GroupEnumUnitsInRange(g,x,y,400.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,r,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
endif
set dmg=1.
set a=0
set i=0
loop
exitwhen a>5
if GetItemTypeId(UnitItemInSlot(hero,a))=='I077' then
set i=1
set a=5
endif
set a=a+1
endloop
if i>0 then
set dmg=dmg+1.15
endif
set a=0
set i=0
loop
exitwhen a>5
if GetItemTypeId(UnitItemInSlot(hero,a))=='I010' then
set i=1
set a=5
endif
set a=a+1
endloop
if i>0 then
set dmg=dmg+0.4
endif
set a=0
set i=0
loop
exitwhen a>5
if GetItemTypeId(UnitItemInSlot(hero,a))=='I011' then
set i=1
set a=5
endif
set a=a+1
endloop
if i>0 then
set dmg=dmg+0.5
endif
set a=0
set i=0
loop
exitwhen a>5
if GetItemTypeId(UnitItemInSlot(hero,a))=='I0B2' then
set i=1
set a=5
endif
set a=a+1
endloop
if i>0 then
set dmg=dmg+0.4
endif
if GetUnitAbilityLevel(hero,'B025')>0 then
set dmg=dmg+0.6
endif
if GetInventoryIndexOfItemTypeBJ(hero,'I0B1')>0 or GetUnitAbilityLevel(hero,'B020')>0 then
set dmg=dmg+0.35
endif
if GetUnitAbilityLevel(hero,'A0WX')>0 then
set dmg=dmg+.6
endif
if GetUnitAbilityLevel(hero,'B02C')>0 then
set dmg=dmg+0.4
endif
if GetUnitAbilityLevel(hero,'BEar')>0 then
set dmg=dmg+0.05+0.05*GetUnitAbilityLevel(hero,'BEar')
endif
if GetUnitAbilityLevel(hero,'B024')>0 then
set dmg=dmg+0.8
endif
if GetUnitAbilityLevel(hero,'B004')>0 then
set dmg=dmg+1.2
endif
if GetUnitAbilityLevel(hero,'B02I')>0 then
set dmg=dmg+0.4
endif
if GetUnitAbilityLevel(hero,'B02Y')>0 then
set dmg=dmg+0.3
endif
if GetUnitAbilityLevel(hero,'B02E')>0 then
set dmg=dmg+0.5
endif
if GetUnitAbilityLevel(hero,'B02A')>0 then
set dmg=dmg+0.8
endif
if GetUnitAbilityLevel(hero,'B02P')>0 then
set dmg=dmg+0.4
endif
if GetUnitAbilityLevel(hero,'B039')>0 then
set dmg=dmg+0.4
endif
if GetUnitAbilityLevel(hero,'B02Q')>0 then
set dmg=dmg+1.2
endif
if GetUnitAbilityLevel(hero,'B02Z')>0 then
set dmg=dmg+1.
