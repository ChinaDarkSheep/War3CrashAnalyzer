function Trig_Shinobi_QBoom takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local real sec=LoadReal(udg_hash,ht,0)-.15
local unit target=LoadUnitHandle(udg_hash,ht,1)
local real dmg=LoadReal(udg_hash,ht,2)
local integer h=GetHandleId(caster)
local real DMG
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local boolean fox=false
local boolean f=false
local real x=GetUnitX(target)
local real y=GetUnitY(target)
local group g=CreateGroup()
local timer t2
local integer ht2
local unit u
local boolean First=LoadBoolean(udg_hash,ht,3)
local integer iuh=LoadInteger(Hash,h,0)
if GetUnitAbilityLevel(caster,'A149')>0 then
set fox=true
endif
if GetUnitAbilityLevel(caster,'A16Z')>0 then
set f=true
endif
if sec>0. then
call SaveReal(udg_hash,ht,0,sec)
elseif First and sec<=0. then
call SaveBoolean(udg_hash,ht,3,false)
call SaveReal(udg_hash,ht,0,.9)
call UnitDamageTarget(caster,target,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
if udg_Talante[ID]==1 then
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+1.5*GetHeroAgi(caster,true))
endif
if not fox then
if udg_Talante[ID]==1 then
call UnitAddAbility(target,'A16V')
call SetUnitAbilityLevel(target,'A16V',GetUnitAbilityLevel(caster,'A16S'))
set t2=CreateTimer()
set ht2=GetHandleId(t2)
call SaveUnitHandle(udg_hash,ht2,0,target)
call TimerStart(t2,8.,false,function Trig_Shinobi_Q_Dragon)
elseif udg_Talante[ID]==2 then
call Heal(true,1.5*GetHeroAgi(caster,true),caster,caster)
if f then
set s__Units_AllBlock[sUnit[iuh]]=s__Units_AllBlock[sUnit[iuh]]+3000
set t2=CreateTimer()
set ht2=GetHandleId(t2)
call SaveUnitHandle(udg_hash,ht2,0,caster)
call TimerStart(t2,4.,false,function Trig_Shinobi_Q_Fox)
endif
endif
endif
elseif not First and sec<=0. then
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,250.,Condition(function Trig_Filter_ID))
loop
set u=FirstOfGroup(g)
exitwhen u==null
set DMG=1.+dmg
if f and fox then
if GetUnitAbilityLevel(u,'Bclf')>0 then
set DMG=2.*dmg
endif
endif
call UnitDamageTarget(caster,u,DMG,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
call DestroyGroup(g)
set t=null
set t2=null
set g=null
set caster=null
set target=null
set u=null
endfunction
