function Trig_DruidSkills_W takes nothing returns nothing
local unit u=GetEnumUnit()
local real perhp=(GetUnitState(u,UNIT_STATE_LIFE)/GetUnitState(u,UNIT_STATE_MAX_LIFE))
local real permp=(GetUnitState(u,UNIT_STATE_MANA)/GetUnitState(u,UNIT_STATE_MAX_MANA))
if(perhp<.30 or permp<.30)and GetOwningPlayer(u)!=GetOwningPlayer(udg_Druid)and IsUnitType(u,UNIT_TYPE_HERO)then
call SetHeroInt(udg_Druid,GetHeroInt(udg_Druid,false)+2,true)
call CreateTextTagUnitBJ("|cFF07B4F1+2 ед. разума|r",udg_Druid,0,11.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
endif
call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)+GetUnitAbilityLevel(udg_Druid,'A0PR')*80+GetHeroInt(udg_Druid,true))
call Heal(true,(70.00*GetUnitAbilityLevel(udg_Druid,'A0PR')+3.00*GetHeroInt(udg_Druid,true)),u,udg_Druid)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIma\\AImaTarget.mdl",u,"origin"))
set u=null
endfunction
