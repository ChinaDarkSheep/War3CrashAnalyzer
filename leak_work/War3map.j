function RandomAttack_Buff takes integer ALLUP,integer HPUP,integer FixUP returns nothing
local integer id=8
local player pl=Player(id)
local integer array INT
set INT[1]=0
set INT[0]=R2I(ALLUP*(0.9+0.05*udg_PN))
if INT[0]>200 then
set INT[0]=100
set INT[1]=100
elseif INT[0]>60 then
set INT[1]=INT[0]-60
set INT[0]=INT[0]-INT[1]
endif
set INT[2]=R2I(HPUP*(0.9+0.05*udg_PN))
set INT[3]=R2I(FixUP*(0.9+0.05*udg_PN))
call SetPlayerTechResearched(pl,'R01V',GetPlayerTechCount(pl,'R01V',true)+INT[0])
call SetPlayerTechResearched(pl,'R05C',GetPlayerTechCount(pl,'R05C',true)+INT[1])
call SetPlayerTechResearched(pl,'R02Z',GetPlayerTechCount(pl,'R02Z',true)+INT[2])
call SetPlayerTechResearched(pl,'R030',GetPlayerTechCount(pl,'R030',true)+INT[3])
set s__SetTechUP[id]=GetPlayerTechCount(pl,'R01V',true)+GetPlayerTechCount(pl,'R05B',true)+GetPlayerTechCount(pl,'R05C',true)
set id=10
set pl=Player(id)
call SetPlayerTechResearched(pl,'R01V',GetPlayerTechCount(pl,'R01V',true)+INT[0])
call SetPlayerTechResearched(pl,'R05C',GetPlayerTechCount(pl,'R05C',true)+INT[1])
call SetPlayerTechResearched(pl,'R02Z',GetPlayerTechCount(pl,'R02Z',true)+INT[2])
call SetPlayerTechResearched(pl,'R030',GetPlayerTechCount(pl,'R030',true)+INT[3])
set s__SetTechUP[id]=GetPlayerTechCount(pl,'R01V',true)+GetPlayerTechCount(pl,'R05B',true)+GetPlayerTechCount(pl,'R05C',true)
set id=11
set pl=Player(id)
call SetPlayerTechResearched(pl,'R01V',GetPlayerTechCount(pl,'R01V',true)+INT[0])
call SetPlayerTechResearched(pl,'R05C',GetPlayerTechCount(pl,'R05C',true)+INT[1])
call SetPlayerTechResearched(pl,'R02Z',GetPlayerTechCount(pl,'R02Z',true)+INT[2])
call SetPlayerTechResearched(pl,'R030',GetPlayerTechCount(pl,'R030',true)+INT[3])
set s__SetTechUP[id]=GetPlayerTechCount(pl,'R01V',true)+GetPlayerTechCount(pl,'R05B',true)+GetPlayerTechCount(pl,'R05C',true)
set pl=null
endfunction
