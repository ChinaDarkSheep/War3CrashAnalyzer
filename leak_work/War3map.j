elseif level==3 then
call SaveStr(udg_hash,h,'t',"|cffffcc00Дополнительные 1400 золота|r")
elseif level==2 then
call SaveStr(udg_hash,h,'t',"|cffffcc00Дополнительные 700 золота|r")
elseif level==1 then
call SaveStr(udg_hash,h,'t',"|cffffcc00Дополнительные 275 золота|r")
endif
elseif b==3 then
call SaveStr(udg_hash,h,'t',"|cffffcc00+"+R2S(100*s__QuestRewGoldPer[level-1])+" бoльшe зoлoтa и +"+R2S(100*s__QuestRewGoldPer[level-1])+" к мaкc бoльшe зoлoтa (+)|r")
elseif b==4 then
call SaveStr(udg_hash,h,'t',"|cffffcc00+"+R2S(100*s__QuestRewLooting[level-1])+" к шансу лутинга|r")
elseif b==5 then
call SaveStr(udg_hash,h,'t',"|cffffcc001 из секретных предметов на выбор|r")
elseif b==6 then
if level==4 then
call SaveStr(udg_hash,h,'t',"|cffffcc00Случайный предмет 2 уровня|r")
elseif level==3 then
call SaveStr(udg_hash,h,'t',"|cffffcc00Случайный предмет 1 уровня|r")
endif
else
if level==4 then
call SaveStr(udg_hash,h,'t',"|cffffcc00Бонус к базовым атрибутам: +16 all stat и + 16 main stat|r")
elseif level==3 then
call SaveStr(udg_hash,h,'t',"|cffffcc00Бонус к базовым атрибутам: +9 all stat и + 9 main stat|r")
elseif level==2 then
call SaveStr(udg_hash,h,'t',"|cffffcc00Бонус к базовым атрибутам: +6 all stat и + 6 main stat|r")
elseif level==1 then
call SaveStr(udg_hash,h,'t',"|cffffcc00Бонус к базовым атрибутам: +3 all stat и + 3 main stat|r")
endif
endif
call SaveInteger(udg_hash,h,'l',level)
call SaveInteger(udg_hash,h,'r',b)
call UnitAddItem(BaseGuild,bj_lastCreatedItem)
return bj_lastCreatedItem
endfunction
function Quest_New_Bandit_Coin takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit bandit=LoadUnitHandle(udg_hash,ht,0)
local integer sec=LoadInteger(udg_hash,ht,0)
local integer coin_num=LoadInteger(udg_hash,ht,1)
local real x1
local real y1
local real x
local real y
local unit u
local real dmg=LoadReal(udg_hash,GetHandleId(bandit),'c')
local integer a=0
local unit coin
if sec>0 then
set sec=sec-1
call SaveInteger(udg_hash,ht,0,sec)
if sec==5 then
loop
set a=a+1
exitwhen a==coin_num
set coin=LoadUnitHandle(udg_hash,ht,a)
set x1=GetUnitX(coin)
set y1=GetUnitY(coin)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl",x1,y1)
call GroupDamage(x1,y1,275.,bandit,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
call DestroyEffect(bj_lastCreatedEffect)
call RemoveUnit(coin)
endloop
endif
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
call SaveBoolean(udg_hash,GetHandleId(bandit),1,false)
endif
set t=null
set bandit=null
set u=null
set coin=null
endfunction
