function Trig_BarbarionE_Actions takes nothing returns nothing
local timer t
local integer ht
set udg_BarbarionE=udg_BarbarionE+GetEventDamage()
if udg_BarbarionE>440. then
set udg_BarbarionE=0.
if udg_BarbarionStacks<251 then
set udg_BarbarionStacks=(udg_BarbarionStacks+1)
call ModifyHeroStat(bj_HEROSTAT_STR,udg_Barbarion,bj_MODIFYMETHOD_ADD,2)
set t=CreateTimer()
set ht=GetHandleId(t)
call TimerStart(t,4.+2.*GetUnitAbilityLevel(udg_Barbarion,'A16C'),false,function BarbarionE_Str)
set t=null
endif
if udg_BarbarianELogic==false then
set udg_BarbarianELogic=true
call UnitRemoveBuffs(udg_Barbarion,false,true)
set t=CreateTimer()
set ht=GetHandleId(t)
call TimerStart(t,3.,false,function BarbarionE_Debuff)
set t=null
endif
endif
endfunction
