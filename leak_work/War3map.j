function InitTrig_ILOD takes nothing returns nothing
set gg_trg_ILOD=CreateTrigger()
call TriggerAddAction(gg_trg_ILOD,function Trig_ILOD_Actions)
endfunction
function Trig_Unit_Indexer_Func005Func002C takes nothing returns boolean
if(not(udg_UnitIndexLock[udg_UDex]==0))then
return false
endif
return true
endfunction
function Trig_Unit_Indexer_Func005C takes nothing returns boolean
if(not(GetUnitUserData(udg_UDexUnits[udg_UDex])==0))then
return false
endif
return true
endfunction
function Trig_Unit_Indexer_Func014Func003C takes nothing returns boolean
if(not(udg_UDexWasted==32))then
return false
endif
return true
endfunction
function Trig_Unit_Indexer_Func014Func005C takes nothing returns boolean
if(not(udg_UDexRecycle==0))then
return false
endif
return true
endfunction
function Trig_Unit_Indexer_Func014C takes nothing returns boolean
if(not(udg_UnitIndexerEnabled==true))then
return false
endif
if(not(GetUnitUserData(GetFilterUnit())==0))then
return false
endif
return true
endfunction
function Trig_Unit_Indexer_Actions takes nothing returns nothing
call ExecuteFunc("InitializeUnitIndexer")
endfunction
function ClearUnitIndex takes nothing returns nothing
if(Trig_Unit_Indexer_Func005C())then
set udg_UnitIndexLock[udg_UDex]=(udg_UnitIndexLock[udg_UDex]-1)
if(Trig_Unit_Indexer_Func005Func002C())then
set udg_UDexNext[udg_UDexPrev[udg_UDex]]=udg_UDexNext[udg_UDex]
set udg_UDexPrev[udg_UDexNext[udg_UDex]]=udg_UDexPrev[udg_UDex]
set udg_UDexPrev[udg_UDex]=0
set udg_UnitIndexEvent=0.00
set udg_UnitIndexEvent=2.00
set udg_UnitIndexEvent=0.00
set udg_UDexUnits[udg_UDex]=null
set udg_UDexNext[udg_UDex]=udg_UDexRecycle
set udg_UDexRecycle=udg_UDex
else
endif
else
endif
endfunction
function IndexUnit takes nothing returns boolean
local integer pdex=udg_UDex
local integer ndex
if(Trig_Unit_Indexer_Func014C())then
set udg_UDexWasted=(udg_UDexWasted+1)
if(Trig_Unit_Indexer_Func014Func003C())then
set udg_UDexWasted=0
set udg_UDex=udg_UDexNext[0]
loop
exitwhen udg_UDex==0
set ndex=udg_UDexNext[udg_UDex]
call ClearUnitIndex()
set udg_UDex=ndex
endloop
else
endif
if(Trig_Unit_Indexer_Func014Func005C())then
set udg_UDex=(udg_UDexGen+1)
set udg_UDexGen=udg_UDex
else
set udg_UDex=udg_UDexRecycle
set udg_UDexRecycle=udg_UDexNext[udg_UDex]
endif
set udg_UDexUnits[udg_UDex]=GetFilterUnit()
call SetUnitUserData(udg_UDexUnits[udg_UDex],udg_UDex)
set udg_UDexPrev[udg_UDexNext[0]]=udg_UDex
set udg_UDexNext[udg_UDex]=udg_UDexNext[0]
set udg_UDexNext[0]=udg_UDex
set udg_UnitIndexLock[udg_UDex]=1
set udg_UnitIndexEvent=0.00
set udg_UnitIndexEvent=1.00
set udg_UnitIndexEvent=0.00
set udg_UDex=pdex
else
endif
return false
endfunction
function InitializeUnitIndexer takes nothing returns nothing
local integer i=bj_MAX_PLAYER_SLOTS
local boolexpr b=Filter(function IndexUnit)
local region re=CreateRegion()
local trigger t=GetTriggeringTrigger()
local rect r=GetWorldBounds()
call RegionAddRect(re,r)
call TriggerRegisterEnterRegion(t,re,b)
call TriggerClearActions(t)
call TriggerAddAction(t,function ClearUnitIndex)
set udg_UnitIndexerEnabled=true
loop
set i=i-1
call GroupEnumUnitsOfPlayer(bj_lastCreatedGroup,Player(i),b)
exitwhen i==0
endloop
call RemoveRect(r)
set re=null
set r=null
set t=null
set b=null
set udg_UnitIndexEvent=3.00
set udg_UnitIndexEvent=0.00
endfunction
function InitTrig_Unit_Indexer takes nothing returns nothing
set gg_trg_Unit_Indexer=CreateTrigger()
call TriggerAddAction(gg_trg_Unit_Indexer,function Trig_Unit_Indexer_Actions)
endfunction
function Trig_Damage_Engine_Config_Actions takes nothing returns nothing
set udg_DamageBlockingAbility='A11U'
set udg_SpellDamageAbility='A18P'
set udg_DamageTypeExplosive=-1
set udg_DamageTypeCriticalStrike=1
set udg_DamageTypeHeal=2
set udg_DamageTypeReduced=3
set udg_DamageTypeBlocked=4
set udg_DmgEvBracers='fgrg'
set udg_DAMAGE_FACTOR_BRACERS=0.67
set udg_DAMAGE_FACTOR_ELUNES=0.80
set udg_DAMAGE_FACTOR_ETHEREAL=1.67
set udg_DamageEventAOE=1
set udg_DamageEventLevel=1
set udg_AfterDamageEvent=(udg_DamageEvent+(udg_AOEDamageEvent+udg_DamageModifierEvent))
set udg_ClearDamageEvent=GetTriggeringTrigger()
set udg_DamageEventAmount=udg_DamageEventPrevAmt
set udg_DamageEventOverride=udg_NextDamageOverride
set udg_DamageEventSource=udg_DamageEventTarget
set udg_DamageEventTrigger=udg_DmgEvTrig
set udg_DamageEventType=(udg_LastDmgPrevType[0]+udg_NextDamageType)
set udg_DamageEventsWasted=udg_DmgEvRecursionN
set udg_DmgEvRunning=udg_DmgEvStarted
set udg_IsDamageSpell=udg_LastDmgWasSpell[0]
set udg_LastDamageHP=TimerGetElapsed(udg_DmgEvTimer)
set udg_LastDmgPrevAmount[0]=udg_LastDmgValue[0]
set udg_LastDmgSource[0]=udg_LastDmgTarget[0]
set udg_HideDamageFrom[0]=false
set udg_UnitDamageRegistered[0]=false
endfunction
function InitTrig_Damage_Engine_Config takes nothing returns nothing
set gg_trg_Damage_Engine_Config=CreateTrigger()
call TriggerAddAction(gg_trg_Damage_Engine_Config,function Trig_Damage_Engine_Config_Actions)
endfunction
function DmgEvResetVars takes nothing returns nothing
local integer i=udg_DmgEvRecursionN-2
set udg_DmgEvRecursionN=i+1
if i>=0 then
set udg_DamageEventPrevAmt=udg_LastDmgPrevAmount[i]
set udg_DamageEventAmount=udg_LastDmgValue[i]
set udg_DamageEventSource=udg_LastDmgSource[i]
set udg_DamageEventTarget=udg_LastDmgTarget[i]
set udg_IsDamageSpell=udg_LastDmgWasSpell[i]
set udg_DamageEventType=udg_LastDmgPrevType[i]
endif
endfunction
function CheckDamagedLifeEvent takes boolean clear returns nothing
if clear then
set udg_NextDamageOverride=false
set udg_NextDamageType=0
endif
if udg_DmgEvTrig !=null then
call DestroyTrigger(udg_DmgEvTrig)
set udg_DmgEvTrig=null
if udg_IsDamageSpell then
call SetWidgetLife(udg_DamageEventTarget,RMaxBJ(udg_LastDamageHP,0.41))
if udg_LastDamageHP<=0.405 then
if udg_DamageEventType<0 then
call SetUnitExploded(udg_DamageEventTarget,true)
endif
call DisableTrigger(udg_DamageEventTrigger)
call UnitDamageTarget(udg_DamageEventSource,udg_DamageEventTarget,-999,false,false,null,DAMAGE_TYPE_UNIVERSAL,null)
call EnableTrigger(udg_DamageEventTrigger)
endif
elseif GetUnitAbilityLevel(udg_DamageEventTarget,udg_DamageBlockingAbility)>0 then
call UnitRemoveAbility(udg_DamageEventTarget,udg_DamageBlockingAbility)
call SetWidgetLife(udg_DamageEventTarget,udg_LastDamageHP)
endif
if udg_DamageEventAmount !=0.00 and not udg_HideDamageFrom[GetUnitUserData(udg_DamageEventSource)]then
set udg_AfterDamageEvent=0.00
set udg_AfterDamageEvent=1.00
set udg_AfterDamageEvent=0.00
endif
call DmgEvResetVars()
endif
endfunction
function DmgEvOnExpire takes nothing returns nothing
set udg_DmgEvStarted=false
call CheckDamagedLifeEvent(true)
set udg_DamageEventTarget=null
set udg_DamageEventSource=null
endfunction
function PreCheckDamagedLifeEvent takes nothing returns boolean
call CheckDamagedLifeEvent(true)
return false
endfunction
function OnUnitDamage takes nothing returns boolean
local boolean override=udg_DamageEventOverride
local integer i
local integer e=udg_DamageEventLevel
local integer a=udg_DamageEventAOE
local string s
local real prevAmount
local real life
local real prevLife
local unit u
local unit f
call CheckDamagedLifeEvent(false)
set i=udg_DmgEvRecursionN-1
if i<0 then
set u=udg_DamageEventTarget
set f=udg_DamageEventSource
elseif i<16 then
set udg_LastDmgPrevAmount[i]=udg_DamageEventPrevAmt
set udg_LastDmgValue[i]=udg_DamageEventAmount
set udg_LastDmgSource[i]=udg_DamageEventSource
set udg_LastDmgTarget[i]=udg_DamageEventTarget
set udg_LastDmgWasSpell[i]=udg_IsDamageSpell
set udg_LastDmgPrevType[i]=udg_DamageEventType
else
set s="WARNING: Recursion error when dealing damage! Make sure when you deal damage from within a DamageEvent trigger, do it like this:\n\n"
set s=s+"Trigger - Turn off (This Trigger)\n"
set s=s+"Unit - Cause...\n"
set s=s+"Trigger - Turn on (This Trigger)"
call ClearTextMessages()
call DisplayTimedTextToPlayer(GetLocalPlayer(),0.00,0.00,999.00,s)
return false
endif
set udg_DmgEvRecursionN=i+2
set prevAmount=GetEventDamage()
set udg_DamageEventTarget=GetTriggerUnit()
set udg_DamageEventSource=GetEventDamageSource()
set udg_DamageEventAmount=prevAmount
set udg_DamageEventType=udg_NextDamageType
set udg_NextDamageType=0
set udg_DamageEventOverride=udg_NextDamageOverride
set udg_NextDamageOverride=false
if prevAmount==0.00 then
if not udg_HideDamageFrom[GetUnitUserData(udg_DamageEventSource)]then
set udg_DamageEventPrevAmt=0.00
set udg_DamageEvent=0.00
set udg_DamageEvent=2.00
set udg_DamageEvent=0.00
endif
call DmgEvResetVars()
else
set u=udg_DamageEventTarget
set udg_IsDamageSpell=prevAmount<0.00
if udg_IsDamageSpell then
set prevAmount=-udg_DamageEventAmount
set life=1.00
if IsUnitType(u,UNIT_TYPE_ETHEREAL)and not IsUnitType(u,UNIT_TYPE_HERO)then
set life=life*udg_DAMAGE_FACTOR_ETHEREAL
endif
if GetUnitAbilityLevel(u,'Aegr')>0 then
set life=life*udg_DAMAGE_FACTOR_ELUNES
endif
if udg_DmgEvBracers !=0 and IsUnitType(u,UNIT_TYPE_HERO)then
set i=6
loop
set i=i-1
if GetItemTypeId(UnitItemInSlot(u,i))==udg_DmgEvBracers then
set life=life*udg_DAMAGE_FACTOR_BRACERS
exitwhen true
endif
exitwhen i==0
endloop
endif
set udg_DamageEventAmount=prevAmount*life
endif
set udg_DamageEventPrevAmt=prevAmount
set udg_DamageModifierEvent=0.00
if not udg_DamageEventOverride then
set udg_DamageModifierEvent=1.00
if not udg_DamageEventOverride then
set udg_DamageModifierEvent=2.00
set udg_DamageModifierEvent=3.00
endif
endif
set udg_DamageEventOverride=override
if udg_DamageEventAmount>0.00 then
set udg_DamageModifierEvent=4.00
endif
set udg_DamageModifierEvent=0.00
if not udg_HideDamageFrom[GetUnitUserData(udg_DamageEventSource)]then
set udg_DamageEvent=0.00
set udg_DamageEvent=1.00
set udg_DamageEvent=0.00
endif
call CheckDamagedLifeEvent(true)
set life=GetWidgetLife(u)
set udg_DmgEvTrig=CreateTrigger()
call TriggerAddCondition(udg_DmgEvTrig,Filter(function PreCheckDamagedLifeEvent))
if not udg_IsDamageSpell then
if udg_DamageEventAmount !=prevAmount then
set life=life+prevAmount-udg_DamageEventAmount
if GetUnitState(u,UNIT_STATE_MAX_LIFE)<life then
set udg_LastDamageHP=life-prevAmount
call UnitAddAbility(u,udg_DamageBlockingAbility)
endif
call SetWidgetLife(u,RMaxBJ(life,0.42))
endif
call TriggerRegisterUnitStateEvent(udg_DmgEvTrig,u,UNIT_STATE_LIFE,LESS_THAN,RMaxBJ(0.41,life-prevAmount/2.00))
else
set udg_LastDamageHP=GetUnitState(u,UNIT_STATE_MAX_LIFE)
set prevLife=life
if life+prevAmount*0.75>udg_LastDamageHP then
set life=RMaxBJ(udg_LastDamageHP-prevAmount/2.00,1.00)
call SetWidgetLife(u,life)
set life=(life+udg_LastDamageHP)/2.00
else
set life=life+prevAmount*0.50
endif
set udg_LastDamageHP=prevLife-(prevAmount-(prevAmount-udg_DamageEventAmount))
call TriggerRegisterUnitStateEvent(udg_DmgEvTrig,u,UNIT_STATE_LIFE,GREATER_THAN,life)
endif
endif
set u=null
set f=null
return false
endfunction
function CreateDmgEvTrg takes nothing returns nothing
set udg_DamageEventTrigger=CreateTrigger()
call TriggerAddCondition(udg_DamageEventTrigger,Filter(function OnUnitDamage))
endfunction
function SetupDmgEv takes nothing returns boolean
local integer i=udg_UDex
local unit u
if udg_UnitIndexEvent==1.00 then
set u=udg_UDexUnits[i]
if GetUnitAbilityLevel(u,'Aloc')==0 and TriggerEvaluate(gg_trg_Damage_Engine_Config)then
set udg_UnitDamageRegistered[i]=true
call TriggerRegisterUnitEvent(udg_DamageEventTrigger,u,EVENT_UNIT_DAMAGED)
call UnitAddAbility(u,udg_SpellDamageAbility)
call UnitMakeAbilityPermanent(u,true,udg_SpellDamageAbility)
endif
set u=null
else
set udg_HideDamageFrom[i]=false
if udg_UnitDamageRegistered[i]then
set udg_UnitDamageRegistered[i]=false
set udg_DamageEventsWasted=udg_DamageEventsWasted+1
if udg_DamageEventsWasted==32 then
set udg_DamageEventsWasted=0
call DestroyTrigger(udg_DamageEventTrigger)
call CreateDmgEvTrg()
set i=udg_UDexNext[0]
loop
exitwhen i==0
if udg_UnitDamageRegistered[i]then
call TriggerRegisterUnitEvent(udg_DamageEventTrigger,udg_UDexUnits[i],EVENT_UNIT_DAMAGED)
endif
set i=udg_UDexNext[i]
endloop
endif
endif
endif
return false
endfunction
function InitTrig_Damage_Engine takes nothing returns nothing
local unit u=CreateUnit(Player(bj_PLAYER_NEUTRAL_EXTRA),'uloc',0,0,0)
local integer i=bj_MAX_PLAYERS
local trigger t=CreateTrigger()
call TriggerRegisterVariableEvent(t,"udg_UnitIndexEvent",EQUAL,1.00)
call TriggerRegisterVariableEvent(t,"udg_UnitIndexEvent",EQUAL,2.00)
call TriggerAddCondition(t,Filter(function SetupDmgEv))
set t=null
if gg_trg_Damage_Engine_Config==null then
call ExecuteFunc("Trig_Damage_Engine_Config_Actions")
else
call TriggerExecute(gg_trg_Damage_Engine_Config)
endif
call CreateDmgEvTrg()
set udg_ClearDamageEvent=CreateTrigger()
call TriggerAddCondition(udg_ClearDamageEvent,Filter(function PreCheckDamagedLifeEvent))
loop
set i=i-1
call SetPlayerAbilityAvailable(Player(i),udg_SpellDamageAbility,false)
exitwhen i==0
endloop
call UnitAddAbility(u,udg_DamageBlockingAbility)
call UnitAddAbility(u,udg_SpellDamageAbility)
call RemoveUnit(u)
set u=null
endfunction
function GoliafDE takes nothing returns nothing
local integer a=0
local real r
if not udg_IsDamageSpell then
set udg_Drop=0
loop
exitwhen a==6
if GetItemTypeId(UnitItemInSlot(udg_DamageEventTarget,a))=='I0BZ' then
set udg_Drop=1
endif
set a=a+1
endloop
if udg_Drop==1 and IsUnitType(udg_DamageEventTarget,UNIT_TYPE_HERO)then
set r=udg_DamageEventAmount-(10.+R2I(udg_DamageEventAmount/30))
if GetUnitLevel(udg_DamageEventSource)<10 then
set r=.5*r
endif
if r>0 then
set udg_DamageEventAmount=r
else
set udg_DamageEventAmount=0
endif
endif
endif
endfunction
function Trig_Set_Damage_Item_Actions takes nothing returns nothing
if udg_Drop==2 then
call TriggerAddAction(gg_trg_Set_Damage,function GoliafDE)
endif
endfunction
function InitTrig_Set_Damage_Item takes nothing returns nothing
set gg_trg_Set_Damage_Item=CreateTrigger()
call TriggerAddAction(gg_trg_Set_Damage_Item,function Trig_Set_Damage_Item_Actions)
endfunction
function Grob_Life takes nothing returns nothing
local timer t=GetExpiredTimer()
call SaveBoolean(udg_hash,GetHandleId(udg_Grob),'l',false)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
endfunction
function Set_Damage_Dop2 takes nothing returns boolean
return(UnitAlive(GetFilterUnit())and GetFilterUnit()!=udg_DamageEventTarget and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(udg_DamageEventSource)))
endfunction
function Trig_Set_Damage_Func004 takes nothing returns boolean
return(UnitAlive(GetFilterUnit())and GetFilterUnit()!=udg_DamageEventTarget and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(udg_DamageEventSource)))
endfunction
function Trig_Set_Damage_Func003 takes nothing returns nothing
call UnitDamageTarget(udg_DamageEventSource,GetEnumUnit(),(udg_DamageEventAmount*0.25),true,false,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
endfunction
function Trig_Set_Damage_g1f takes nothing returns boolean
return(GetFilterUnit()!=udg_DamageEventTarget and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(udg_DamageEventSource))and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false)
endfunction
function Trig_Set_Damage_g2f takes nothing returns boolean
return(GetFilterUnit()!=udg_DamageEventTarget and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(udg_DamageEventSource))and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO)==false)
endfunction
function Trig_Set_Damage_g1 takes nothing returns nothing
call UnitDamageTarget(udg_DamageEventSource,GetEnumUnit(),udg_Damage[99],true,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
endfunction
function Trig_Set_Damage_g2 takes nothing returns nothing
call UnitDamageTarget(udg_DamageEventSource,GetEnumUnit(),udg_Damage[98],true,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
endfunction
function Trig_Set_Damage_Hero takes nothing returns nothing
call UnitDamageTarget(udg_Hero[udg_Drop3],GetEnumUnit(),udg_Damage[99],false,true,G_AttType,G_DmgType,WEAPON_TYPE_METAL_LIGHT_CHOP)
endfunction
function Trig_Set_Damage_Actions takes nothing returns nothing
local real r
local real x
local real y
local integer a=0
local integer b
local integer ht=GetHandleId(udg_DamageEventTarget)
local integer hs=GetHandleId(udg_DamageEventSource)
local integer ihh
local integer IDS=GetPlayerId(GetOwningPlayer(udg_DamageEventSource))+1
local integer IDT=GetPlayerId(GetOwningPlayer(udg_DamageEventTarget))+1
local integer ius=LoadInteger(Hash,hs,0)
local integer iut=LoadInteger(Hash,ht,0)
local boolean enemy=false
if IsUnitEnemy(udg_DamageEventSource,Player(IDT-1))then
set enemy=true
set TakeDamage[IDT]=TakeDamage[IDT]+udg_DamageEventAmount
endif
set a=((100*s__Units_AllDmg[sUnit[ius]]/s__Units_AllDmgM[sUnit[ius]])*s__Units_AllTake[sUnit[iut]])/s__Units_AllBlock[sUnit[iut]]
set udg_DamageEventAmount=udg_DamageEventAmount*(0.01*a)*PlDmg[IDS-1]*PlBlock[IDT-1]
if GetUnitAbilityLevel(udg_DamageEventTarget,'A00V')==1 then
if GetPlayerTechCount(Player(IDT-1),'R006',true)==1 then
if GetRandomInt(1,4)==1 then
set udg_DamageEventAmount=udg_DamageEventAmount*0.5
endif
endif
endif
if udg_IsDamageSpell then
if GetUnitAbilityLevel(udg_DamageEventTarget,'A18Q')==1 then
set udg_DamageEventAmount=udg_DamageEventAmount*0.2
elseif GetUnitAbilityLevel(udg_DamageEventTarget,'A0M3')==1 then
set udg_DamageEventAmount=udg_DamageEventAmount*0.3
elseif GetUnitAbilityLevel(udg_DamageEventTarget,'A18R')==1 then
set udg_DamageEventAmount=udg_DamageEventAmount*0.4
elseif GetUnitAbilityLevel(udg_DamageEventTarget,'A15Z')==1 then
set udg_DamageEventAmount=udg_DamageEventAmount*0.5
elseif GetUnitAbilityLevel(udg_DamageEventTarget,'A0S7')==1 then
set udg_DamageEventAmount=udg_DamageEventAmount*0.6
elseif GetUnitAbilityLevel(udg_DamageEventTarget,'A12I')==1 then
set udg_DamageEventAmount=udg_DamageEventAmount*0.7
elseif GetUnitAbilityLevel(udg_DamageEventTarget,'A0S8')==1 then
set udg_DamageEventAmount=udg_DamageEventAmount*0.8
endif
set a=((100*s__Units_MageDamage[sUnit[ius]]/s__Units_MageBlock[sUnit[iut]])*s__Units_MageTake[sUnit[iut]])/10000
set udg_DamageEventAmount=udg_DamageEventAmount*(0.01*a)
else
set a=s__Units_NoMageDmg[sUnit[ius]]/100
set udg_DamageEventAmount=udg_DamageEventAmount*(0.01*I2R(a))
set udg_DamageEngineService[1]=GetUnitAbilityLevel(udg_DamageEventSource,'A13N')
if not udg_noSplash and udg_DamageEngineService[1]>0 then
set udg_noSplash=true
set x=GetUnitX(udg_DamageEventTarget)
set y=GetUnitY(udg_DamageEventTarget)
if GetUnitTypeId(udg_DamageEventSource)=='Nman' then
call GroupClear(DamageEventG)
call GroupEnumUnitsInRange(DamageEventG,x,y,400.00,g_Set_Damage_Func004)
call ForGroup(DamageEventG,function Trig_Set_Damage_Func003)
endif
set udg_Damage[99]=udg_DamageEventAmount*(udg_DamageEngineService[1]*0.1+0.1)
set udg_Damage[98]=udg_DamageEventAmount*(udg_DamageEngineService[1]*0.1)
call GroupClear(DamageEventG)
call GroupEnumUnitsInRange(DamageEventG,x,y,300.00,g_Set_Damage_g1f)
call ForGroup(DamageEventG,function Trig_Set_Damage_g1)
call GroupClear(DamageEventG)
call GroupEnumUnitsInRange(DamageEventG,x,y,300.00,g_Set_Damage_g2f)
call ForGroup(DamageEventG,function Trig_Set_Damage_g2)
set udg_noSplash=false
else
if GetUnitTypeId(udg_DamageEventTarget)=='htow' then
if GetUnitTypeId(udg_DamageEventSource)=='n03Y' or GetUnitTypeId(udg_DamageEventSource)=='n076' then
set udg_DamageEventAmount=udg_DamageEventAmount*0.40
endif
endif
endif
endif
if s__Units_Bar[sUnit[iut]]>0. then
set ihh=LoadInteger(udg_hash,ht,5)
if s__Units_Bar[sUnit[iut]]>=udg_DamageEventAmount then
set r=udg_DamageEventAmount
set s__Units_Bar[sUnit[iut]]=s__Units_Bar[sUnit[iut]]-r
else
set r=s__Units_Bar[sUnit[iut]]
set s__Units_Bar[sUnit[iut]]=0.
endif
set udg_DamageEventAmount=udg_DamageEventAmount-r
if s__Heroes_BarSetMage[sHero[ihh]]>0. then
if s__Heroes_BarSetMage[sHero[ihh]]>=r then
set x=r
set s__Heroes_BarSetMage[sHero[ihh]]=s__Heroes_BarSetMage[sHero[ihh]]-x
else
set x=s__Heroes_BarSetMage[sHero[ihh]]
set s__Heroes_BarSetMage[sHero[ihh]]=0.
endif
set r=r-x
endif
if s__Heroes_BarAmRin[sHero[ihh]]>0. then
if s__Heroes_BarAmRin[sHero[ihh]]>=r then
set x=r
set s__Heroes_BarAmRin[sHero[ihh]]=s__Heroes_BarAmRin[sHero[ihh]]-x
else
set x=s__Heroes_BarAmRin[sHero[ihh]]
set s__Heroes_BarAmRin[sHero[ihh]]=0.
endif
set r=r-x
endif
if s__Heroes_BarSkill[sHero[ihh]]>0. then
if s__Heroes_BarSkill[sHero[ihh]]>=r then
set x=r
set s__Heroes_BarSkill[sHero[ihh]]=s__Heroes_BarSkill[sHero[ihh]]-x
else
set x=s__Heroes_BarSkill[sHero[ihh]]
set s__Heroes_BarSkill[sHero[ihh]]=0.
endif
set r=r-x
if udg_SpellBreakerR and GetUnitAbilityLevel(udg_DamageEventTarget,'A18N')==1 then
set udg_SpellBreakerRdmg=udg_SpellBreakerRdmg+0.4*x
endif
endif
if s__Units_BarLich[sUnit[iut]]>0. then
if s__Units_BarLich[sUnit[iut]]>=r then
set x=r
set s__Units_BarLich[sUnit[iut]]=s__Units_BarLich[sUnit[iut]]-x
else
set x=s__Units_BarLich[sUnit[iut]]
set s__Units_BarLich[sUnit[iut]]=0.
endif
set r=r-x
endif
if s__Units_Bar[sUnit[iut]]<1. and s__Units_BarE[sUnit[iut]]!=null then
call DestroyEffect(s__Units_BarE[sUnit[iut]])
set s__Units_BarE[sUnit[iut]]=null
endif
endif
if IsUnitType(udg_DamageEventTarget,UNIT_TYPE_HERO)then
if GetUnitAbilityLevel(udg_DamageEventSource,'A1F5')==1 then
set udg_DamageEventAmount=udg_DamageEventAmount*2
endif
else
set udg_DamageEventAmount=udg_DamageEventAmount*No_HeroTake[IDT]/No_HeroBlock[IDT]
endif
if IsUnitType(udg_DamageEventSource,UNIT_TYPE_HERO)and udg_DamageEventAmount>0. then
set ihh=LoadInteger(udg_hash,hs,5)
if udg_IsDamageSpell then
if s__Heroes_item_I0ED[sHero[ihh]]>0 then
if GetRandomInt(1,10)<=4 then
set udg_DamageEventAmount=udg_DamageEventAmount*2.25
endif
endif
endif
set r=GetUnitState(udg_DamageEventTarget,UNIT_STATE_LIFE)/GetUnitState(udg_DamageEventTarget,UNIT_STATE_MAX_LIFE)
if r>=0.8 then
if s__Heroes_item_engs[sHero[ihh]]>0 then
set udg_DamageEventAmount=1.4*udg_DamageEventAmount
endif
endif
if s__Heroes_item_I0EM[sHero[ihh]]>0 then
set a=GetUnitLevel(udg_DamageEventTarget)
if a>9 then
if a>30 then
set r=1.35
else
set r=1.05+0.01*a
endif
set udg_DamageEventAmount=udg_DamageEventAmount*r
endif
endif
if udg_DamageEventTarget==udg_VampirHealTarget[IDS]then
if udg_IsDamageSpell then
set x=0.75*udg_DamageEventAmount
else
set x=1.*udg_DamageEventAmount
endif
if s__Heroes_AllVamp[sHero[ihh]]>0. then
set r=x*s__Heroes_AllVamp[sHero[ihh]]
call SetUnitState(udg_DamageEventSource,UNIT_STATE_LIFE,GetUnitState(udg_DamageEventSource,UNIT_STATE_LIFE)+r)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl",udg_DamageEventSource,"origin"))
endif
endif
else
set udg_DamageEventAmount=udg_DamageEventAmount*No_HeroDMG[IDS]/No_HeroDMGm[IDS]
if GetUnitAbilityLevel(udg_DamageEventTarget,'A0MR')==1 then
set udg_DamageEventAmount=udg_DamageEventAmount*0.75
endif
endif
if GetUnitAbilityLevel(udg_DamageEventSource,'A0J7')==1 then
set a=LoadInteger(Hash,hs,IDDammy)
set G_AttType=ConvertAttackType(s__Dummys_AttType[sDummy[a]])
set G_DmgType=ConvertDamageType(s__Dummys_DmgType[sDummy[a]])
call UnitDamageTarget(udg_Hero[IDS],udg_DamageEventTarget,s__Dummys_dmg[sDummy[a]],false,true,G_AttType,G_DmgType,WEAPON_TYPE_METAL_LIGHT_CHOP)
if s__Dummys_RangeAOE[sDummy[a]]>0. then
set udg_Damage[99]=s__Dummys_dmg[sDummy[a]]*s__Dummys_dmgAOE[sDummy[a]]
set x=GetUnitX(udg_DamageEventTarget)
set y=GetUnitY(udg_DamageEventTarget)
call GroupClear(DamageEventG)
call GroupEnumUnitsInRange(DamageEventG,x,y,s__Dummys_RangeAOE[sDummy[a]],g_Set_Damage_g1f)
set udg_Drop3=IDS
call ForGroup(DamageEventG,function Trig_Set_Damage_Hero)
endif
endif
if s__Units_Immortal[sUnit[iut]]>0 then
if GetUnitTypeId(udg_DamageEventTarget)=='E00Q' then
if LoadBoolean(udg_hash,ht,'E')then
set udg_RockDefenderE=udg_RockDefenderE+udg_DamageEventAmount
endif
endif
set udg_DamageEventAmount=0.
else
if GetUnitAbilityLevel(udg_DamageEventSource,'Arsk')==1 or IsUnitType(udg_DamageEventSource,UNIT_TYPE_HERO)then
else
set ihh=LoadInteger(udg_hash,ht,5)
if ihh>0 then
set a=s__Heroes_WeakBlock[sHero[ihh]]/100
set udg_DamageEventAmount=udg_DamageEventAmount*0.01*a
endif
endif
if IsUnitInGroup(udg_DamageEventTarget,mammothE)then
set udg_DamageEventAmount=.8*udg_DamageEventAmount
endif
if IsUnitInGroup(udg_DamageEventTarget,Ggorgona)then
set udg_DamageEventAmount=1.2*udg_DamageEventAmount
endif
if noReflect==0 and vampirism>0. then
set r=GetUnitState(udg_DamageEventSource,UNIT_STATE_LIFE)+udg_DamageEventAmount*vampirism
call SetUnitState(udg_DamageEventSource,UNIT_STATE_LIFE,r)
endif
if enemy then
set GiveDamage[IDS]=GiveDamage[IDS]+udg_DamageEventAmount
endif
if GetUnitAbilityLevel(udg_DamageEventTarget,'A1EA')==1 and noReflect==0 then
set noReflect=noReflect+1
if IsUnitType(udg_DamageEventSource,UNIT_TYPE_HERO)then
set r=0.04*udg_DamageEventAmount
else
set r=0.2*udg_DamageEventAmount
endif
if GetUnitAbilityLevel(udg_DamageEventSource,'A0IQ')==1 then
set r=0.3*r
endif
call UnitDamageTarget(udg_DamageEventTarget,udg_DamageEventSource,r,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
set noReflect=noReflect-1
endif
endif
endfunction
function InitTrig_Set_Damage takes nothing returns nothing
set gg_trg_Set_Damage=CreateTrigger()
call TriggerRegisterVariableEvent(gg_trg_Set_Damage,"udg_DamageModifierEvent",EQUAL,1.00)
call TriggerAddAction(gg_trg_Set_Damage,function Trig_Set_Damage_Actions)
set g_condDop2=Condition(function Set_Damage_Dop2)
set g_Set_Damage_Func004=Condition(function Trig_Set_Damage_Func004)
set g_Set_Damage_g1f=Condition(function Trig_Set_Damage_g1f)
set g_Set_Damage_g2f=Condition(function Trig_Set_Damage_g2f)
endfunction
function Trig_Mana_Shield_Fix_Actions takes nothing returns nothing
if GetUnitAbilityLevel(udg_DamageEventTarget,'BNms')>0 then
set udg_DmgEvMana=GetUnitStateSwap(UNIT_STATE_MANA,udg_DamageEventTarget)
set udg_DmgEvMSlvl=GetUnitAbilityLevel(udg_DamageEventTarget,'ANms')
if udg_DmgEvMSlvl==0 then
set udg_DmgEvManaMult=2.00
else
set udg_DmgEvManaMult=2.+udg_DmgEvMSlvl
endif
set udg_DmgEvMana=udg_DmgEvMana*udg_DmgEvManaMult
if udg_DamageEventAmount<udg_DmgEvMana-0.01 then
set udg_DmgEvMana=udg_DmgEvMana-0.72*udg_DamageEventAmount
set udg_DamageEventAmount=0.18*udg_DamageEventAmount
set udg_DmgEvMana=udg_DmgEvMana/udg_DmgEvManaMult
set udg_DamageEventType=udg_DamageTypeBlocked
else
set udg_DamageEventAmount=udg_DamageEventAmount-udg_DmgEvMana
set udg_DmgEvMana=0.00
call IssueImmediateOrderBJ(udg_DamageEventTarget,"manashieldoff")
set udg_DamageEventType=udg_DamageTypeReduced
endif
call SetUnitManaBJ(udg_DamageEventTarget,udg_DmgEvMana)
else
endif
endfunction
function InitTrig_Mana_Shield_Fix takes nothing returns nothing
set gg_trg_Mana_Shield_Fix=CreateTrigger()
