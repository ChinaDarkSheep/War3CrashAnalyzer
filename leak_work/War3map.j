return false
endif
return true
endfunction
function Trig_Partizan_Actions takes nothing returns nothing
if GetOwningPlayer(GetDyingUnit())==Player(9)and GetUnitTypeId(GetDyingUnit())!='u00L' then
set udg_PartizanStr=udg_PartizanStr+1
if udg_PartizanStr==5 then
set udg_PartizanStr=0
if GetRandomInt(1,2)==2 then
if udg_Talante[udg_Drop]==1 then
call ModifyHeroStat(bj_HEROSTAT_STR,udg_Partizan,bj_MODIFYMETHOD_ADD,1)
else
call ModifyHeroStat(bj_HEROSTAT_STR,udg_Partizan,bj_MODIFYMETHOD_ADD,2)
endif
call AddSpecialEffectTargetUnitBJ("origin",udg_Partizan,"Abilities\\Spells\\Items\\AIem\\AIemTarget.mdl")
call DestroyEffect(bj_lastCreatedEffect)
endif
endif
endif
if IsUnitType(GetDyingUnit(),UNIT_TYPE_HERO)and GetDyingUnit()!=udg_Partizan then
if udg_Talante[udg_Drop]==1 then
call ModifyHeroStat(bj_HEROSTAT_STR,udg_Partizan,bj_MODIFYMETHOD_ADD,4)
else
call ModifyHeroStat(bj_HEROSTAT_STR,udg_Partizan,bj_MODIFYMETHOD_ADD,2)
endif
call AddSpecialEffectTargetUnitBJ("origin",udg_Partizan,"Abilities\\Spells\\Items\\AIem\\AIemTarget.mdl")
call DestroyEffect(bj_lastCreatedEffect)
else
endif
if GetUnitAbilityLevel(udg_Partizan,'A0JE')==1 then
if GetDyingUnit()==gg_unit_h005_0249 then
call ModifyHeroStat(bj_HEROSTAT_STR,udg_Partizan,bj_MODIFYMETHOD_ADD,50)
call AddSpecialEffectTargetUnitBJ("origin",udg_Partizan,"Abilities\\Spells\\Items\\AIem\\AIemTarget.mdl")
call DestroyEffect(bj_lastCreatedEffect)
else
endif
if GetDyingUnit()==gg_unit_harm_0390 then
call ModifyHeroStat(bj_HEROSTAT_STR,udg_Partizan,bj_MODIFYMETHOD_ADD,50)
call AddSpecialEffectTargetUnitBJ("origin",udg_Partizan,"Abilities\\Spells\\Items\\AIem\\AIemTarget.mdl")
call DestroyEffect(bj_lastCreatedEffect)
else
endif
if GetDyingUnit()==gg_unit_htow_0002 then
call ModifyHeroStat(bj_HEROSTAT_STR,udg_Partizan,bj_MODIFYMETHOD_ADD,50)
call AddSpecialEffectTargetUnitBJ("origin",udg_Partizan,"Abilities\\Spells\\Items\\AIem\\AIemTarget.mdl")
call DestroyEffect(bj_lastCreatedEffect)
else
endif
endif
endfunction
function InitTrig_Partizan takes nothing returns nothing
set gg_trg_Partizan=CreateTrigger()
call DisableTrigger(gg_trg_Partizan)
call TriggerRegisterAnyUnitEventBJ(gg_trg_Partizan,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(gg_trg_Partizan,Condition(function Trig_Partizan_Conditions))
call TriggerAddAction(gg_trg_Partizan,function Trig_Partizan_Actions)
endfunction
function Trig_PartizanSkills_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,h,0)
local integer i=LoadInteger(udg_hash,h,1)
local real x=LoadReal(udg_hash,h,2)
local real y=LoadReal(udg_hash,h,3)
local group g=CreateGroup()
local group g2=LoadGroupHandle(udg_hash,h,4)
local unit u
if i !=0 then
set i=i-1
call SaveInteger(udg_hash,h,1,i)
call GroupEnumUnitsInRange(g,x,y,300.,null)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)and IsUnitAlly(u,GetOwningPlayer(hero))then
call UnitRemoveBuffs(u,false,true)
endif
call GroupRemoveUnit(g,u)
endloop
else
loop
set u=FirstOfGroup(g2)
exitwhen u==null
call RemoveUnit(u)
call GroupRemoveUnit(g2,u)
endloop
call DestroyGroup(g2)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,h)
endif
call DestroyGroup(g)
set t=null
set g=null
set g2=null
set hero=null
set u=null
endfunction
function SpawnPartizanUnit takes unit caster,integer uType,real x,real y,real facing,real timedLife,integer hp,integer dmg,integer drop returns nothing
local unit u=CreateUnit(GetOwningPlayer(caster),uType,x,y,facing)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl",x,y))
if timedLife>1. then
call UnitApplyTimedLife(u,'BTLF',timedLife)
endif
if GetHeroLevel(caster)>=50 then
call UnitAddAbility(u,'A0S7')
endif
if udg_Talante[drop]==2 then
call UnitAddAbility(u,'A007')
if GetHeroLevel(caster)>=50 then
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+10)
endif
if GetUnitTypeId(u)=='nhea' then
call SummonStats(true,hp,R2I(0.75*dmg),u,caster)
elseif GetUnitTypeId(u)=='hkni' then
call SummonStats(true,3*(hp/2),R2I(dmg),u,caster)
else
call SummonStats(true,hp,dmg,u,caster)
endif
call UnitRemoveAbility(u,'A007')
endif
set u=null
endfunction
function Trig_PartizanSkills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer h=GetHandleId(caster)
local integer ihh=LoadInteger(udg_hash,h,5)
local real x=0
local real y=0
local real x1
local real y1
local real r
local real z
local group g
local integer i=0
local integer a=0
local integer hp=0
local integer dmg=0
local integer drop=GetPlayerId(GetOwningPlayer(caster))+1
local integer str
local integer int
local integer name
local timer t
local integer ht
local integer Loop
local unit u
if GetSpellAbilityId()=='A0AO' then
if udg_Mode==4 then
if udg_PartizanLimit[1]==2 then
set caster=null
return
else
set udg_PartizanLimit[1]=(udg_PartizanLimit[1]+1)
endif
else
endif
if udg_Talante[drop]==1 then
set x=(20*GetUnitAbilityLevel(caster,'A0AO')+GetHeroStr(caster,true))*LoadReal(udg_hash,h,4)
call TempStats(caster,0,0,0,R2I(x),0,0,20.)
endif
if udg_Talante[drop]==2 then
set int=GetHeroInt(caster,true)-R2I(0.5*s__Heroes_TempInt[sHero[ihh]])
set str=GetHeroStr(caster,true)-R2I(0.5*s__Heroes_TempStr[sHero[ihh]])
set hp=R2I(3.*I2R(str)+3.*I2R(int))
set dmg=R2I(0.35*I2R(int))
if GetHeroLevel(caster)>=50 then
set hp=hp*2
endif
endif
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set Loop=1
set r=50.
loop
exitwhen Loop>4
set x1=x+250.*Cos((GetUnitFacing(caster)+180.+Loop*45.-90.)*bj_DEGTORAD)
set y1=y+250.*Sin((GetUnitFacing(caster)+180.+Loop*45.-90.)*bj_DEGTORAD)
set name=udg_PartizanSummon[GetRandomInt(1,4+GetUnitAbilityLevel(caster,'A0AO'))]
if ModuloInteger(Loop,2)==0 then
set z=r
else
set z=0.
endif
call SpawnPartizanUnit(caster,name,x1,y1,GetUnitFacing(caster),z,hp,dmg,drop)
set Loop=Loop+1
endloop
if GetUnitAbilityLevel(caster,'A0JE')==1 then
set Loop=1
loop
exitwhen Loop>2
set x1=x+350.*Cos((GetUnitFacing(caster)+45.+Loop*90.)*bj_DEGTORAD)
set y1=y+350.*Sin((GetUnitFacing(caster)+45.+Loop*90.)*bj_DEGTORAD)
set name=udg_PartizanSummon[GetRandomInt(1,4+GetUnitAbilityLevel(caster,'A0AO'))]
call SpawnPartizanUnit(caster,name,x1,y1,GetUnitFacing(caster),r,hp,dmg,drop)
set Loop=Loop+1
endloop
set Loop=1
loop
exitwhen Loop>2
set x1=x+300.*Cos((GetUnitFacing(caster)+45.+Loop*90.)*bj_DEGTORAD)
set y1=y+300.*Sin((GetUnitFacing(caster)+45.+Loop*90.)*bj_DEGTORAD)
set name=udg_PartizanSummon[GetRandomInt(1,4+GetUnitAbilityLevel(caster,'A0AO'))]
call SpawnPartizanUnit(caster,name,x1,y1,GetUnitFacing(caster),r,hp,dmg,drop)
set Loop=Loop+1
endloop
set Loop=1
loop
exitwhen Loop>2
set x1=x+300.*Cos((GetUnitFacing(caster)-90.+Loop*180.)*bj_DEGTORAD)
set y1=y+300.*Sin((GetUnitFacing(caster)-90.+Loop*180.)*bj_DEGTORAD)
set name=udg_PartizanSummon[GetRandomInt(1,4+GetUnitAbilityLevel(caster,'A0AO'))]
call SpawnPartizanUnit(caster,name,x1,y1,GetUnitFacing(caster),0.,hp,dmg,drop)
set Loop=Loop+1
endloop
endif
endif
if GetSpellAbilityId()=='A0AN' then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set u=CreateUnit(GetOwningPlayer(caster),'h009',x,y,bj_UNIT_FACING)
call UnitAddAbility(u,'Aivs')
call IssueTargetOrder(u,"invisibility",GetSpellAbilityUnit())
call UnitApplyTimedLife(u,'BTLF',.75)
if udg_Talante[drop]==1 then
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+GetUnitState(caster,UNIT_STATE_MAX_LIFE)*(0.07+0.03*GetUnitAbilityLevel(caster,'A0AN')))
endif
set Loop=1
loop
exitwhen Loop>12
set u=CreateUnit(GetOwningPlayer(caster),'h026',x,y,30.*Loop)
set x1=x+500.*Cos(30.*Loop*bj_DEGTORAD)
set y1=y+500.*Sin(30.*Loop*bj_DEGTORAD)
call IssuePointOrder(u,"attack",x,y)
call UnitApplyTimedLife(u,'BTLF',8.)
set Loop=Loop+1
endloop
endif
if GetSpellAbilityId()=='A0AP' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set g=CreateGroup()
set u=CreateUnit(GetOwningPlayer(caster),'h027',x,y,GetRandomReal(0,360))
call GroupAddUnit(g,u)
set Loop=1
loop
exitwhen Loop>12
set r=GetRandomReal(100.00,300.00)
set z=GetRandomReal(0,360)
set x1=x+r*Cos(z*bj_DEGTORAD)
set y1=y+r*Sin(z*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(caster),'h027',x1,y1,GetRandomReal(0,360))
call UnitRemoveAbility(u,'A0AR')
call UnitRemoveAbility(u,'A0AS')
call GroupAddUnit(g,u)
set Loop=Loop+1
endloop
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveInteger(udg_hash,ht,1,15)
call SaveReal(udg_hash,ht,2,x)
call SaveReal(udg_hash,ht,3,y)
call SaveGroupHandle(udg_hash,ht,4,g)
call TimerStart(t,1.,true,function Trig_PartizanSkills_R)
endif
if GetSpellAbilityId()=='A17D' then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set int=GetHeroInt(caster,true)-R2I(0.5*s__Heroes_TempInt[sHero[ihh]])
set str=GetHeroStr(caster,true)-R2I(0.5*s__Heroes_TempStr[sHero[ihh]])
set hp=R2I(9*I2R(str)+9*I2R(int))
set dmg=R2I(1.05*I2R(int))
if GetHeroLevel(caster)>=50 then
set hp=hp*2
endif
set Loop=1
loop
exitwhen Loop>6
set z=GetUnitFacing(caster)+180.00+Loop*45.00-90.00
set x1=x+250.*Cos(z*bj_DEGTORAD)
set y1=y+250.*Sin(z*bj_DEGTORAD)
set name=udg_PartizanSummon[GetRandomInt(1,4+GetUnitAbilityLevel(caster,'A0AO'))]
call SpawnPartizanUnit(caster,name,x1,y1,GetUnitFacing(caster),30.,hp,dmg,drop)
set Loop=Loop+1
endloop
endif
set caster=null
set u=null
set g=null
set t=null
endfunction
function InitTrig_PartizanSkills takes nothing returns nothing
set gg_trg_PartizanSkills=CreateTrigger()
call TriggerAddAction(gg_trg_PartizanSkills,function Trig_PartizanSkills_Actions)
endfunction
function Trig_PartizanSkills2_Conditions takes nothing returns boolean
if(not(GetSpellAbilityId()=='A0AQ'))then
return false
endif
return true
endfunction
function Trig_PartizanSkills2_Actions takes nothing returns nothing
local unit caster=GetSpellTargetUnit()
local integer h=GetHandleId(caster)
local integer ihh=LoadInteger(udg_hash,h,5)
local integer str
local integer int
local unit u
local real x
local real y
local real hp
local real dmg
local integer lvl
local boolean spawn=true
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local integer talante=udg_Talante[ID]
local real r=0.
if udg_Mode==4 then
if udg_PartizanLimit[2]==2 then
set spawn=false
else
set udg_PartizanLimit[2]=(udg_PartizanLimit[2]+1)
endif
endif
if spawn then
call UnitAddItemByIdSwapped(udg_PartizanItems[GetRandomInt(1,6)],caster)
endif
if talante==2 then
set int=GetHeroInt(caster,true)-R2I(0.5*s__Heroes_TempInt[sHero[ihh]])
set str=GetHeroStr(caster,true)-R2I(0.5*s__Heroes_TempStr[sHero[ihh]])
set hp=R2I(3.*I2R(str)+3.*I2R(int))
set dmg=R2I(0.35*I2R(int))
if GetHeroLevel(caster)>=50 then
set hp=hp*2
endif
set bj_forLoopAIndex=1
if GetHeroLevel(caster)>=50 then
set bj_forLoopAIndexEnd=6
set r=45.
else
set bj_forLoopAIndexEnd=2
set r=180.
endif
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set x=GetUnitX(caster)+250.*Cos((GetUnitFacing(caster)+180.+bj_forLoopAIndex*r-90.)*bj_DEGTORAD)
set y=GetUnitY(caster)+250.*Sin((GetUnitFacing(caster)+180.+bj_forLoopAIndex*r-90.)*bj_DEGTORAD)
call SpawnPartizanUnit(caster,'hfoo',x,y,GetUnitFacing(caster),50.,R2I(hp),R2I(dmg),ID)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
endfunction
function InitTrig_PartizanSkills2 takes nothing returns nothing
set gg_trg_PartizanSkills2=CreateTrigger()
call TriggerAddCondition(gg_trg_PartizanSkills2,Condition(function Trig_PartizanSkills2_Conditions))
call TriggerAddAction(gg_trg_PartizanSkills2,function Trig_PartizanSkills2_Actions)
endfunction
function Trig_DarkSgustokSkills_W takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(hero)
local unit dummy=LoadUnitHandle(udg_hash,ht,1)
local real sec=LoadReal(udg_hash,ht,0)
local real x1
local real y1
local real x
local real y
if sec>0 then
set sec=sec-0.1
call SaveReal(udg_hash,ht,0,sec)
call SetUnitX(dummy,GetUnitX(hero))
call SetUnitY(dummy,GetUnitY(hero))
else
call F_RemoveUnit(dummy)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
set hero=null
set dummy=null
endfunction
function Trig_DarkSgustokSkills_E takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit hero=LoadUnitHandle(udg_hash,GetHandleId(t),0)
local unit u
local real hp=GetHeroStr(hero,true)+4.*GetHeroInt(hero,true)
local real dmg=0.25*GetHeroInt(hero,true)
local group g=CreateGroup()
local integer a
if GetHeroLevel(hero)>=50 then
set hp=2.*hp
endif
if udg_Talante[GetPlayerId(GetOwningPlayer(hero))+1]==2 then
set hp=1.3*hp
set dmg=1.3*dmg
endif
set bj_groupEnumTypeId='e009'
call GroupEnumUnitsOfPlayer(g,GetOwningPlayer(hero),filterGetUnitsOfPlayerAndTypeId)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)and LoadBoolean(udg_hash,GetHandleId(u),StringHash("noE"))==false then
set a=SeekFreeUnitMin(GetHandleId(u))
if udg_Talante[GetPlayerId(GetOwningPlayer(hero))+1]==2 then
call UnitAddAbility(u,'AIev')
if GetHeroLevel(hero)>=50 then
set s__Units_Arm[sUnit[a]]=s__Units_Arm[sUnit[a]]+20
call F_Armore(u,s__Units_Arm[sUnit[a]])
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+10)
endif
endif
call UnitAddAbility(u,'A1EX')
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),u,hero)
call UnitRemoveAbility(u,'A007')
endif
call GroupRemoveUnit(g,u)
endloop
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,GetHandleId(t))
call DestroyGroup(g)
set t=null
set g=null
set hero=null
set u=null
endfunction
function Trig_DarkSgustokSkills_F takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,h,0)
local integer i=LoadInteger(udg_hash,h,1)
local real x=LoadReal(udg_hash,h,2)
local real y=LoadReal(udg_hash,h,3)
local unit u
local real dmg=GetHeroInt(hero,true)
local group g=CreateGroup()
if i !=0 then
set i=i-1
call SaveInteger(udg_hash,h,1,i)
call GroupEnumUnitsInRange(g,x,y,475.,null)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)and IsUnitEnemy(u,GetOwningPlayer(hero))then
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
call GroupRemoveUnit(g,u)
endloop
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,GetHandleId(t))
endif
call DestroyGroup(g)
set t=null
set g=null
set hero=null
set u=null
endfunction
function Trig_DarkSgustokSkills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local integer talante=udg_Talante[ID]
local group g=CreateGroup()
local integer h
local real x
local real y
local unit u
local real hp
local real dmg
local integer a
local timer t
local integer ht
if GetSpellAbilityId()=='A0KO' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set u=CreateUnit(GetOwningPlayer(caster),'h03I',x,y,0.)
call UnitApplyTimedLife(u,'BTLF',20.)
if talante==1 then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveInteger(udg_hash,ht,1,40)
call SaveReal(udg_hash,ht,2,x)
call SaveReal(udg_hash,ht,3,y)
call TimerStart(t,0.5,true,function Trig_DarkSgustokSkills_F)
endif
elseif GetSpellAbilityId()=='A0AW' then
set dmg=2.*GetHeroInt(caster,true)+60*GetUnitAbilityLevel(caster,'A0AW')
if talante==1 then
set dmg=dmg+2.*GetHeroInt(caster,true)
if GetHeroLevel(caster)>=50 then
set dmg=dmg+2.*GetHeroInt(caster,true)
endif
endif
call GroupClear(udg_DarkSgustokQ)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=10
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set x=GetUnitX(caster)+256*Cos(36.*bj_forLoopAIndex*bj_DEGTORAD)
set y=GetUnitY(caster)+256*Sin(36.*bj_forLoopAIndex*bj_DEGTORAD)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'h04M',GetUnitX(caster),GetUnitY(caster),bj_UNIT_FACING)
call SaveReal(udg_hash,GetHandleId(bj_lastCreatedUnit),'d',dmg)
call UnitAddAbility(bj_lastCreatedUnit,'A0AX')
call SetUnitAbilityLevel(bj_lastCreatedUnit,'A0AX',GetUnitAbilityLevel(caster,'A0AW'))
call IssuePointOrder(bj_lastCreatedUnit,"carrionswarm",x,y)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',3.75)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
elseif GetSpellAbilityId()=='A0B0' then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,1.6,false,function Trig_DarkSgustokSkills_E)
elseif GetSpellAbilityId()=='A0KN' then
if talante==2 then
set hp=6.5*GetHeroInt(GetTriggerUnit(),true)
set dmg=0.325*GetHeroInt(GetTriggerUnit(),true)
if GetHeroLevel(GetTriggerUnit())>=50 then
set hp=2.*hp
endif
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>4
set x=GetUnitX(GetTriggerUnit())+225*Cos(120.*bj_forLoopAIndex*bj_DEGTORAD)
set y=GetUnitY(GetTriggerUnit())+225*Sin(120.*bj_forLoopAIndex*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(GetTriggerUnit()),'e009',x,y,GetUnitFacing(GetTriggerUnit()))
call SaveBoolean(udg_hash,GetHandleId(u),StringHash("noE"),true)
if GetHeroLevel(caster)>=50 then
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+10)
endif
set a=SeekFreeUnitMin(GetHandleId(u))
if GetHeroLevel(caster)>=50 then
set s__Units_Arm[sUnit[a]]=s__Units_Arm[sUnit[a]]+20
endif
call F_Armore(u,s__Units_Arm[sUnit[a]])
call UnitAddAbility(u,'AIev')
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),u,GetTriggerUnit())
call UnitRemoveAbility(u,'A007')
call UnitApplyTimedLife(u,'BTLF',22.)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
set dmg=GetUnitAbilityLevel(caster,'A0KN')*30+.15*GetHeroInt(caster,true)
if talante==1 then
set dmg=dmg+.15*GetHeroInt(caster,true)
if GetHeroLevel(caster)>=50 then
set dmg=dmg+.15*GetHeroInt(caster,true)
endif
endif
set u=CreateUnit(Player(ID-1),'h05G',-22000,18500,0.)
call SetUnitX(u,GetUnitX(caster))
call SetUnitY(u,GetUnitY(caster))
call UnitAddAbility(u,'A0AY')
set a=SeekFreeDummys(u,GetHandleId(u))
set s__Dummys_dmg[sDummy[a]]=dmg
set s__Dummys_RangeAOE[sDummy[a]]=300.
set s__Dummys_dmgAOE[sDummy[a]]=0.5
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveUnitHandle(udg_hash,ht,1,u)
call SaveReal(udg_hash,ht,0,10.)
call TimerStart(t,0.1,true,function Trig_DarkSgustokSkills_W)
elseif GetSpellAbilityId()=='A0AZ' then
set dmg=GetUnitState(caster,UNIT_STATE_MAX_MANA)
set u=GetSpellTargetUnit()
call UnitDamageTargetBJ(caster,u,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
if talante==1 then
set dmg=dmg+10*GetHeroInt(caster,true)
set x=GetSpellTargetX()
set y=GetSpellTargetY()
call GroupEnumUnitsInRange(g,x,y,300.,null)
call GroupRemoveUnit(g,u)
set dmg=dmg*0.5
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitEnemy(u,GetOwningPlayer(caster))and UnitAlive(u)then
call UnitDamageTargetBJ(caster,u,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
endif
call GroupRemoveUnit(g,u)
endloop
endif
endif
call DestroyGroup(g)
set caster=null
set u=null
set t=null
endfunction
function InitTrig_DarkSgustokSkills takes nothing returns nothing
set gg_trg_DarkSgustokSkills=CreateTrigger()
call TriggerAddAction(gg_trg_DarkSgustokSkills,function Trig_DarkSgustokSkills_Actions)
endfunction
function Trig_TikondrusSkills_Q takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer i=LoadInteger(udg_hash,ht,0)
local real dmg=10*GetUnitAbilityLevel(caster,'A0B7')+0.1*GetHeroStr(caster,true)
local real x
local real y
local real x1
local real y1
local unit u
local group g=CreateGroup()
if i !=0 then
set i=i-1
call SaveInteger(udg_hash,ht,0,i)
if udg_Talante[GetPlayerId(GetOwningPlayer(caster))+1]==1 then
set dmg=dmg+6*GetUnitAbilityLevel(caster,'A0B7')+0.1*Summ_Attack(caster)
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+0.3*(0.25*GetHeroStr(caster,true)))
endif
if udg_NatrezimR==true then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,400.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>15
