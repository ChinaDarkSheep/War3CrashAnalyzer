function ChargesConnect_Actions takes nothing returns nothing
local unit u=GetManipulatingUnit()
local item Item=GetManipulatedItem()
local integer Item_Id=GetItemTypeId(Item)
local integer L
local integer i
local integer i2
local integer array StarsItem
if GetItemCharges(Item)>0 then
set L=0
set i=0
set i2=0
loop
exitwhen L>5
if GetItemTypeId(UnitItemInSlot(u,L))==Item_Id then
set i=i+1
set i2=i2+GetItemCharges(UnitItemInSlot(u,L))
endif
set L=L+1
endloop
if i>1 then
set L=0
loop
exitwhen L>5
if GetItemTypeId(UnitItemInSlot(u,L))==Item_Id then
call RemoveItem(UnitItemInSlot(u,L))
endif
set L=L+1
endloop
set Item=CreateItem(Item_Id,0,0)
call UnitAddItem(u,Item)
call SetItemCharges(Item,i2)
if i2>=500 and Item_Id=='dthb' then
if i2==500 then
call RemoveItem(Item)
else
call SetItemCharges(Item,i2-500)
endif
set StarsItem[1]='mort'
set StarsItem[2]='engs'
set StarsItem[3]='shwd'
set StarsItem[4]='k3m3'
set StarsItem[5]='gopr'
set StarsItem[6]='kygh'
set Item=CreateItem(StarsItem[GetRandomInt(1,6)],0,0)
call UnitAddItem(u,Item)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\ReplenishMana\\ReplenishManaCasterOverhead.mdl",u,"overhead"))
endif
endif
endif
set u=null
set Item=null
endfunction
function InitTrig_ChargesConnect takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddAction(t,function ChargesConnect_Actions)
set t=null
endfunction
function Trig_Trophy_Take_Actions takes nothing returns nothing
local item Item=GetManipulatedItem()
local integer ID=GetPlayerId(GetOwningPlayer(GetTriggerUnit()))+1
local unit Building=GetTriggerUnit()
local unit u=udg_Hero[ID]
local boolean is_trophy=false
local integer h=GetHandleId(u)
local string s=LoadStr(udg_hash,h,2)
local integer ids=ReturnTypeHeroId(GetHandleId(u))
local integer a
local integer ihh=LoadInteger(udg_hash,h,5)
local integer iuh=LoadInteger(Hash,h,0)
local integer idi=LoadInteger(Hash,GetItemTypeId(Item),Hash_ItId)
if s__SItem_SpecStatID[sItem[idi]]>=100 and s__SItem_SpecStatID[sItem[idi]]<200 then
set is_trophy=true
call TakeItem(u,idi,1)
endif
if GetItemTypeId(Item)=='sehr' then
set is_trophy=true
elseif GetItemTypeId(Item)=='cnhn' then
set s__Heroes_MS[sHero[ids]]=s__Heroes_MS[sHero[ids]]+150
elseif GetItemTypeId(Item)=='azhr' then
set is_trophy=true
set s__Heroes_MS[sHero[ids]]=s__Heroes_MS[sHero[ids]]+60
call SetPlayerAbilityAvailable(Player(ID-1),'A1EB',true)
endif
if GetItemTypeId(Item)=='belv' then
set s__Units_NoMageDmg[sUnit[iuh]]=s__Units_NoMageDmg[sUnit[iuh]]+1200
set s__Units_AllTake[sUnit[iuh]]=s__Units_AllTake[sUnit[iuh]]+600
endif
if GetItemTypeId(Item)=='rde2' then
call UnitAddAbility(Building,'A1C0')
endif
if GetItemTypeId(Item)=='tbsm' then
set s__Heroes_MS[sHero[ids]]=s__Heroes_MS[sHero[ids]]-50
elseif GetItemTypeId(Item)=='bzbf' then
call SaveReal(udg_hash,h,StringHash("HealUP"),LoadReal(udg_hash,h,StringHash("HealUP"))+0.2)
call SaveReal(udg_hash,h,StringHash("SelfHealUP"),LoadReal(udg_hash,h,StringHash("SelfHealUP"))+0.2)
elseif GetItemTypeId(Item)=='wtlg' then
set is_trophy=true
if udg_Time[1]<30 then
call SaveInteger(udg_hash,h,StringHash("Hourglass"),1)
set s__Units_GAttack[sUnit[iuh]]=s__Units_GAttack[sUnit[iuh]]+80
set s__Heroes_Str[sHero[ihh]]=s__Heroes_Str[sHero[ihh]]+20
set s__Heroes_Agi[sHero[ihh]]=s__Heroes_Agi[sHero[ihh]]+20
set s__Heroes_Int[sHero[ihh]]=s__Heroes_Int[sHero[ihh]]+20
set s__Units_AllDmg[sUnit[iuh]]=s__Units_AllDmg[sUnit[iuh]]+1500
else
call SaveInteger(udg_hash,h,StringHash("Hourglass"),2)
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]+1500
call SaveReal(udg_hash,h,StringHash("HPRegen"),LoadReal(udg_hash,h,StringHash("HPRegen"))+20)
set s__Units_AllBlock[sUnit[iuh]]=s__Units_AllBlock[sUnit[iuh]]+1500
endif
elseif GetItemTypeId(Item)=='k3m1' then
set is_trophy=true
set a=LoadInteger(udg_hash,h,StringHash("CrownLich"))/100
call SaveInteger(udg_hash,h,H_HighStat,LoadInteger(udg_hash,h,H_HighStat)+a)
endif
if GetItemTypeId(Item)=='clsd' then
call UnitAddAbility(u,'A1C2')
endif
if GetItemTypeId(Item)=='lhst' then
call UnitAddAbility(Building,'A1C3')
endif
if GetItemTypeId(Item)=='hcun' then
call UnitAddAbility(u,'A1CC')
endif
if GetItemTypeId(Item)=='tlum' then
set is_trophy=true
call SetPlayerAbilityAvailable(Player(ID-1),'A1EB',true)
elseif GetItemTypeId(Item)=='sksh' then
set is_trophy=true
set s__Units_AllTake[sUnit[iuh]]=s__Units_AllTake[sUnit[iuh]]+1500
endif
if GetItemTypeId(Item)=='lgdh' then
call SaveReal(udg_hash,h,StringHash("SummonAT"),LoadReal(udg_hash,h,StringHash("SummonAT"))+0.12)
call SaveReal(udg_hash,h,StringHash("SummonHP"),LoadReal(udg_hash,h,StringHash("SummonHP"))+0.12)
endif
if GetItemTypeId(Item)=='afac' then
call UnitAddAbility(u,'A1C7')
call UnitMakeAbilityPermanent(u,true,'A1C7')
endif
if GetItemTypeId(Item)=='kpin' then
call UnitAddAbility(u,'A1C9')
call UnitMakeAbilityPermanent(u,true,'A1C9')
call UnitMakeAbilityPermanent(u,true,'A1C8')
endif
if GetItemTypeId(Item)=='crys' then
call SaveReal(udg_hash,GetHandleId(u),StringHash("Modificator"),LoadReal(udg_hash,GetHandleId(u),StringHash("Modificator"))+0.1)
endif
if GetItemTypeId(Item)=='hval' then
call SaveReal(udg_hash,h,StringHash("HealUP"),LoadReal(udg_hash,h,StringHash("HealUP"))+0.2)
endif
if GetItemTypeId(Item)=='odef' then
set s__Units_AllTake[sUnit[iuh]]=s__Units_AllTake[sUnit[iuh]]+1500
endif
if GetItemTypeId(Item)=='pams' then
set s__Heroes_MS[sHero[ids]]=s__Heroes_MS[sHero[ids]]+100.
call SetPlayerAbilityAvailable(Player(ID-1),'A1EB',true)
endif
if GetItemTypeId(Item)=='oflg' then
set s__Heroes_MS[sHero[ids]]=s__Heroes_MS[sHero[ids]]+100.
endif
if GetItemTypeId(Item)=='ktrm' then
set is_trophy=true
call SaveReal(udg_hash,h,StringHash("SummonHP"),LoadReal(udg_hash,h,StringHash("SummonHP"))+0.1)
endif
if is_trophy==false then
call UnitRemoveItem(Building,Item)
else
call F_Attack(u,s__Units_GAttack[sUnit[iuh]])
call F_Armore(u,s__Units_Arm[sUnit[iuh]])
call F_hp(u,s__Units_HP[sUnit[iuh]])
call F_mp(u,s__Units_MP[sUnit[iuh]])
call F_Stats(u)
endif
set Item=null
set Building=null
set u=null
endfunction
function InitTrig_Trophy_Take takes nothing returns nothing
set gg_trg_Trophy_Take=CreateTrigger()
call TriggerAddAction(gg_trg_Trophy_Take,function Trig_Trophy_Take_Actions)
endfunction
function Trig_Trophy_Drop_Actions takes nothing returns nothing
local item Item=GetManipulatedItem()
local integer ID=GetPlayerId(GetOwningPlayer(GetTriggerUnit()))+1
local unit Building=GetTriggerUnit()
local unit u=udg_Hero[ID]
local integer h=GetHandleId(u)
local string s=LoadStr(udg_hash,h,2)
local integer a
local integer b
local integer c
local integer ihh=LoadInteger(udg_hash,h,5)
local integer iuh=LoadInteger(Hash,h,0)
local integer idi=LoadInteger(Hash,GetItemTypeId(Item),Hash_ItId)
if s__SItem_SpecStatID[sItem[idi]]>=100 and s__SItem_SpecStatID[sItem[idi]]<200 then
call TakeItem(u,idi,-1)
endif
if GetItemTypeId(Item)=='sehr' then
set a=LoadInteger(udg_hash,h,StringHash("VeicoinG"))
call SetPlayerStateBJ(Player(ID-1),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(ID-1),PLAYER_STATE_RESOURCE_GOLD)+a)
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],20,"Получено: "+I2S(a)+" ед. золота")
call SaveInteger(udg_hash,h,StringHash("VeicoinG"),0)
elseif GetItemTypeId(Item)=='cnhn' then
set s__Heroes_MS[sHero[ihh]]=s__Heroes_MS[sHero[ihh]]-150
elseif GetItemTypeId(Item)=='azhr' then
set s__Heroes_MS[sHero[ihh]]=s__Heroes_MS[sHero[ihh]]-60
call SetPlayerAbilityAvailable(Player(ID-1),'A1EB',false)
endif
if GetItemTypeId(Item)=='belv' then
set s__Units_NoMageDmg[sUnit[iuh]]=s__Units_NoMageDmg[sUnit[iuh]]-1200
set s__Units_AllTake[sUnit[iuh]]=s__Units_AllTake[sUnit[iuh]]-600
endif
if GetItemTypeId(Item)=='rde2' then
call UnitRemoveAbility(Building,'A1C0')
endif
if GetItemTypeId(Item)=='ches' then
set a=LoadInteger(udg_hash,h,StringHash("Diadem"))
call SaveInteger(udg_hash,h,H_HighStat,LoadInteger(udg_hash,h,H_HighStat)-a)
call SaveInteger(udg_hash,h,StringHash("Diadem"),0)
endif
if GetItemTypeId(Item)=='tbsm' then
set s__Heroes_MS[sHero[ihh]]=s__Heroes_MS[sHero[ihh]]+50
elseif GetItemTypeId(Item)=='sclp' then
set a=LoadInteger(udg_hash,h,StringHash("Bracs"))
set s__Heroes_Str[sHero[ihh]]=s__Heroes_Str[sHero[ihh]]-a
set s__Heroes_Agi[sHero[ihh]]=s__Heroes_Agi[sHero[ihh]]-a
set s__Heroes_Int[sHero[ihh]]=s__Heroes_Int[sHero[ihh]]-a
call SaveInteger(udg_hash,h,StringHash("Bracs"),0)
elseif GetItemTypeId(Item)=='bzbf' then
call SaveReal(udg_hash,h,StringHash("HealUP"),LoadReal(udg_hash,h,StringHash("HealUP"))-0.2)
call SaveReal(udg_hash,h,StringHash("SelfHealUP"),LoadReal(udg_hash,h,StringHash("SelfHealUP"))-0.2)
elseif GetItemTypeId(Item)=='wtlg' then
if LoadInteger(udg_hash,h,StringHash("Hourglass"))==1 then
set s__Units_GAttack[sUnit[iuh]]=s__Units_GAttack[sUnit[iuh]]-80
set s__Heroes_Str[sHero[ihh]]=s__Heroes_Str[sHero[ihh]]-20
set s__Heroes_Agi[sHero[ihh]]=s__Heroes_Agi[sHero[ihh]]-20
set s__Heroes_Int[sHero[ihh]]=s__Heroes_Int[sHero[ihh]]-20
set s__Units_AllDmg[sUnit[iuh]]=s__Units_AllDmg[sUnit[iuh]]-1500
elseif LoadInteger(udg_hash,h,StringHash("Hourglass"))==2 then
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]-1500
call SaveReal(udg_hash,h,StringHash("HPRegen"),LoadReal(udg_hash,h,StringHash("HPRegen"))-20)
set s__Units_AllBlock[sUnit[iuh]]=s__Units_AllBlock[sUnit[iuh]]-1500
endif
endif
if GetItemTypeId(Item)=='k3m1' then
set a=LoadInteger(udg_hash,h,StringHash("CrownLich"))/100
call SaveInteger(udg_hash,h,H_HighStat,LoadInteger(udg_hash,h,H_HighStat)-a)
endif
if GetItemTypeId(Item)=='clsd' then
call UnitRemoveAbility(u,'A1C2')
endif
if GetItemTypeId(Item)=='lhst' then
call UnitRemoveAbility(Building,'A1C3')
endif
if GetItemTypeId(Item)=='hcun' then
call UnitRemoveAbility(u,'A1CC')
endif
if GetItemTypeId(Item)=='ledg' then
set a=LoadInteger(udg_hash,h,StringHash("BKeyS"))
set b=LoadInteger(udg_hash,h,StringHash("BKeyA"))
set c=LoadInteger(udg_hash,h,StringHash("BKeyI"))
call SaveInteger(udg_hash,h,StringHash("BKeyS"),0)
call SaveInteger(udg_hash,h,StringHash("BKeyA"),0)
call SaveInteger(udg_hash,h,StringHash("BKeyI"),0)
set s__Heroes_Str[sHero[ihh]]=s__Heroes_Str[sHero[ihh]]-a
set s__Heroes_Agi[sHero[ihh]]=s__Heroes_Agi[sHero[ihh]]-b
set s__Heroes_Int[sHero[ihh]]=s__Heroes_Int[sHero[ihh]]-c
call SaveInteger(udg_hash,h,StringHash("NGreenStr"),LoadInteger(udg_hash,h,StringHash("NGreenStr"))-a)
call SaveInteger(udg_hash,h,StringHash("NGreenAgi"),LoadInteger(udg_hash,h,StringHash("NGreenAgi"))-b)
call SaveInteger(udg_hash,h,StringHash("NGreenInt"),LoadInteger(udg_hash,h,StringHash("NGreenInt"))-c)
elseif GetItemTypeId(Item)=='tlum' then
call SetPlayerAbilityAvailable(Player(ID-1),'A1EB',false)
elseif GetItemTypeId(Item)=='sksh' then
set s__Units_AllTake[sUnit[iuh]]=s__Units_AllTake[sUnit[iuh]]-1500
endif
if GetItemTypeId(Item)=='lgdh' then
call SaveReal(udg_hash,h,StringHash("SummonAT"),LoadReal(udg_hash,h,StringHash("SummonAT"))-0.12)
call SaveReal(udg_hash,h,StringHash("SummonHP"),LoadReal(udg_hash,h,StringHash("SummonHP"))-0.12)
endif
if GetItemTypeId(Item)=='afac' then
call UnitRemoveAbility(u,'A1C7')
endif
if GetItemTypeId(Item)=='kpin' then
call UnitRemoveAbility(u,'A1C9')
endif
if GetItemTypeId(Item)=='crys' then
call SaveReal(udg_hash,GetHandleId(u),StringHash("Modificator"),LoadReal(udg_hash,GetHandleId(u),StringHash("Modificator"))-0.1)
endif
if GetItemTypeId(Item)=='hval' then
call SaveReal(udg_hash,h,StringHash("HealUP"),LoadReal(udg_hash,h,StringHash("HealUP"))-0.2)
endif
if GetItemTypeId(Item)=='odef' then
set s__Units_AllTake[sUnit[iuh]]=s__Units_AllTake[sUnit[iuh]]-1500
endif
if GetItemTypeId(Item)=='pams' then
set s__Heroes_MS[sHero[ihh]]=s__Heroes_MS[sHero[ihh]]-100.
call SetPlayerAbilityAvailable(Player(ID-1),'A1EB',false)
endif
if GetItemTypeId(Item)=='oflg' then
set s__Heroes_MS[sHero[ihh]]=s__Heroes_MS[sHero[ihh]]-100.
endif
if GetItemTypeId(Item)=='gmfr' then
set a=LoadInteger(udg_hash,h,StringHash("Gilean"))
set s__Units_MP[sUnit[iuh]]=s__Units_MP[sUnit[iuh]]-a
set s__Units_Arm[sUnit[iuh]]=s__Units_Arm[sUnit[iuh]]-(25*a)/1000
call SaveReal(udg_hash,h,StringHash("HPRegen"),LoadReal(udg_hash,h,StringHash("HPRegen"))-0.04*(a))
call SaveReal(udg_hash,h,StringHash("MPRegen"),LoadReal(udg_hash,h,StringHash("MPRegen"))-0.02*(a))
call SaveInteger(udg_hash,h,StringHash("Gilean"),0)
endif
if GetItemTypeId(Item)=='ktrm' then
call SaveReal(udg_hash,h,StringHash("SummonHP"),LoadReal(udg_hash,h,StringHash("SummonHP"))-0.1)
endif
call F_Attack(u,s__Units_GAttack[sUnit[iuh]])
call F_Armore(u,s__Units_Arm[sUnit[iuh]])
call F_hp(u,s__Units_HP[sUnit[iuh]])
call F_mp(u,s__Units_MP[sUnit[iuh]])
call F_Stats(u)
set Item=null
set u=null
set Building=null
endfunction
