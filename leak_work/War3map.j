function Trig_ComandQ2_Actions takes nothing returns nothing
local integer id=GetPlayerId(GetTriggerPlayer())
if IsPlayerInForce(Player(id),udg_Quests2[1])then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFF00C850Задание \"Ведьма прошлого\" [1/3]|r\n\nЗдравствуй путник, добро пожаловать в Ковен ведьм. Это место, где собираются ведьмы и колдуньи со всего мира, чтобы поделиться новыми знаниями... Но на этот раз у нас совсем другая цель собрания. Нам бы не помешали способные волшебницы... и волшебники. Но сначала нам надо собрать некоторые ингридиенты. Принеси нам 5 мотков паутины и одну лапу беорна.")
call DisplayTextToForce(bj_FORCE_PLAYER[id],"\n|cFFFFDC00Награда: предмет \"Шляпа ведьмы\" и 500 ед. золота.\n    Если успеете первым закончить цепочку заданий, то вы получите доступ к последнему заданию Ковена.|r")
endif
if IsPlayerInForce(Player(id),udg_Quests2[2])then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFF00C850Зaдaниe \"Beдьмa пpoшлoгo\" [2/3]|r\n\nAдpия - вeличaйшaя вeдьмa дpeвнocти. Oнa былa нacтoлькo xитpa, чтo cмoглa зaключить coюз c нeким мoгyщecтвeнным дeмoнoм Диaблo, для cвoиx цeлeй, кoнeчнo... He дyмaй, чтo мы пpишли cюдa cтpoить кoзни - этo вcё в пpoшлoм. Hac интepecyeт мaгия Aдpии. Тaк кaк oнa yмepлa мнoгиe тыcячитeлeтия нaзaд, нaм пoтpeбyeтcя cилa дpeвниx cyщecтв, чтoбы yлoвить ocтaтки eё мaгии кpoви. Убeй 20 гoлeмoв и 10 дpeв, a пoтoм вoзвpaщaйcя к нaм.")
call DisplayTextToForce(bj_FORCE_PLAYER[id],"\n|cFFFFDC00Награда: предмет \"Посох Ночи\" и 2500 золота\nЕсли успеете первым закончить цепочку заданий, то вы получите доступ к последнему заданию Ковена.|r")
endif
if IsPlayerInForce(Player(id),udg_Quests2[3])then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFF00C850Задание \"Ведьма прошлого\" [3/3]|r\n\nМы ничего не смогли узнать про Адрию, но духи сказали, что можно вызвать призраков прошлого, которые могут нам помочь. Итак, вызывай призраков в следущем порядке - дождись ночи, встань на гиблую землю и произнеси на латыни заклинание \"Venite ad me qui antiquorum spirituum!\". Произноси чётко и без ошибок. Возвращайся, как только что-нибудь узнаешь.")
call DisplayTextToForce(bj_FORCE_PLAYER[id],"\n|cFFFFDC00Награда: предмет \"Ожерелье кошмаров\" и 3500 золота\nЕсли успеете первым закончить цепочку заданий, то вы получите доступ к последнему заданию Ковена.|r")
endif
if IsPlayerInForce(Player(id),udg_Quests2[4])then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"|cFF00C850Задание \"Возвращение ведьмы\"|r\n")
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Мы поняли, как работает магия крови. Смерть жрецов крови происходит в особом порядке - они не разлагаются как обычные трупы, магия скрывает их останки и проявляет только тем, кто очень хочет их вернуть в реальный мир. Чтобы вернуть останки Адрии, надо пролить очень много крови.")
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Если ты сможешь собрать 500 зарядов смерти, то мы получим её телесную оболочку и сможем разгадать многие тайны магии крови. При убийстве существ, вы получаете 1 заряд, а существа 10 уровня дают 2. Если же герой находился не менее чем в 2000 ед. от смерти существа, то он получает в два раза больше зарядов")
call DisplayTextToForce(bj_FORCE_PLAYER[id],"\n|cFFFFDC00Награда: предмет \"Рука Адрии\" и 6000 золота|r")
endif
if IsPlayerInForce(Player(id),udg_Quests2[5])then
call DisplayTextToForce(bj_FORCE_PLAYER[id],"Наш шабаш окончен, отдыхай до следущего сезона.")
endif
endfunction
