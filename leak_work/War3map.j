function Trig_RecrutingOgr_Actions takes nothing returns nothing
if GetUnitTypeId(GetTrainedUnit())=='nogr' then
call UnitAddAbility(GetTrainedUnit(),'A1DC')
elseif GetUnitTypeId(GetTrainedUnit())=='nomg' then
call UnitAddAbility(GetTrainedUnit(),'A1DC')
elseif GetUnitTypeId(GetTrainedUnit())=='nogl' then
call UnitAddAbility(GetTrainedUnit(),'A1DC')
elseif GetUnitTypeId(GetTrainedUnit())=='njga' then
call UnitAddAbility(GetTrainedUnit(),'A1DC')
elseif GetUnitTypeId(GetTrainedUnit())=='njgb' then
call UnitAddAbility(GetTrainedUnit(),'A1DC')
elseif GetUnitTypeId(GetTrainedUnit())=='nogm' then
call UnitAddAbility(GetTrainedUnit(),'A1DC')
elseif GetUnitTypeId(GetTrainedUnit())=='n03W' or GetUnitTypeId(GetTrainedUnit())=='n03U' or GetUnitTypeId(GetTrainedUnit())=='n03V' then
if udg_BilderQuestOgr[24]==5 then
call GroupAddUnit(udg_UnordinaryUnit,GetTrainedUnit())
call SeekFreeUnit(GetHandleId(GetTrainedUnit()))
endif
endif
if GetUnitTypeId(GetTrainedUnit())=='n03V' and(udg_BilderQuestOgr[23]==3 or udg_BilderQuestOgr[24]==4)then
call SetUnitAbilityLevelSwapped('A0MP',GetTrainedUnit(),2)
call SetUnitAbilityLevelSwapped('A06D',GetTrainedUnit(),2)
endif
if GetUnitTypeId(GetTrainedUnit())=='njgb' then
call SetUnitAbilityLevelSwapped('Aroa',GetTrainedUnit(),2)
endif
endfunction
