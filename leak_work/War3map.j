loop
exitwhen a==0
call DestroyLightning(LoadLightningHandle(udg_hash,ht,a))
set a=a-1
endloop
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set t=null
endfunction
function MechGolem_W takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local real sec=LoadReal(udg_hash,ht,0)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer id=GetPlayerId(GetOwningPlayer(caster))
local group g=CreateGroup()
local unit u
local real dmg
local real r
local integer a=0
if sec>0 then
call SaveReal(udg_hash,ht,0,sec-1.)
set dmg=20+GetHeroStr(caster,true)*2+GetPlayerTechCount(Player(id),'R026',true)*30
if GetPlayerTechCount(Player(id),'R01G',true)==2 then
set r=375.
else
set r=250.
endif
set udg_Drop2=id
call GroupEnumUnitsInRange(g,GetUnitX(caster),GetUnitY(caster),r,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\LightningShield\\LightningShieldBuff.mdl",u,"origin"))
set a=a+1
call GroupRemoveUnit(g,u)
endloop
if GetPlayerTechCount(Player(id),'R01G',true)==2 then
if a>25 then
set a=25
endif
set dmg=.2*I2R(a)*dmg
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+dmg)
endif
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
call UnitRemoveAbility(caster,'A0DU')
endif
call DestroyGroup(g)
set g=null
set t=null
set caster=null
set u=null
endfunction
function MechGolem_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local real sec=LoadReal(udg_hash,ht,0)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer id=GetPlayerId(GetOwningPlayer(caster))
local group g=LoadGroupHandle(udg_hash,ht,1)
local group g2
local unit u
local real dmg
local real r
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real x1
local real y1
local real angle
if sec>0 then
call SaveReal(udg_hash,ht,0,sec-.1)
if not LoadBoolean(udg_hash,ht,2)then
call SaveBoolean(udg_hash,ht,2,true)
set g2=CreateGroup()
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitType(u,UNIT_TYPE_STRUCTURE)==false then
set x1=GetUnitX(u)
set y1=GetUnitY(u)
set angle=bj_RADTODEG*Atan2(y-y1,x-x1)
set x1=x1+36.*Cos(angle*bj_DEGTORAD)
set y1=y1+36.*Sin(angle*bj_DEGTORAD)
call SetUnitX(u,x1)
call SetUnitY(u,y1)
endif
call GroupAddUnit(g2,u)
call GroupRemoveUnit(g,u)
endloop
call SaveGroupHandle(udg_hash,ht,1,g2)
call DestroyGroup(g)
endif
else
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitRemoveAbility(u,'A0JH')
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
call UnitRemoveAbility(caster,'A0DU')
endif
set g2=null
set g=null
set t=null
set caster=null
set u=null
endfunction
