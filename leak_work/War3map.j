if b<70 then
set a=GetRandomInt(1,12)
if a>=1 and a<=3 then
set name='envl'
elseif a>=5 and a<=8 then
set name='sbch'
elseif a>=7 and a<=9 then
set name='mgtk'
else
set name='pmna'
endif
else
