function Trig_UseSkillJas_Actions takes nothing returns nothing
local item SpellItem=GetSpellTargetItem()
local item Item1=UnitItemInSlotBJ(GetSpellAbilityUnit(),1)
local item Item2=UnitItemInSlotBJ(GetSpellAbilityUnit(),2)
local integer Lvl
local integer drop=0
local integer a
local integer id=GetPlayerId(GetOwningPlayer(GetSpellAbilityUnit()))+1
local real x=GetUnitX(udg_Circle[id])
local real y=GetUnitY(udg_Circle[id])
local integer owner=LoadInteger(udg_hash,GetHandleId(SpellItem),StringHash("Owner"))
local group g
if GetSpellAbilityId()=='A1EP' then
set g=CreateGroup()
if GetUnitTypeId(GetTriggerUnit())=='U02A' then
if GetLocalPlayer()==Player(id-1)then
call ClearSelection()
call SelectUnit(udg_ThingBody,true)
endif
else
set bj_groupEnumTypeId='u01C'
call GroupEnumUnitsOfPlayer(g,GetOwningPlayer(GetTriggerUnit()),filterGetUnitsOfPlayerAndTypeId)
if GetLocalPlayer()==Player(id-1)then
call ClearSelection()
endif
set udg_Drop=id-1
call ForGroup(g,function UseSkillJas_Enum)
endif
call DestroyGroup(g)
endif
if GetUnitTypeId(GetTriggerUnit())!='h05K' then
if GetSpellAbilityId()=='A1DV' and pick_item[id]then
if GetLocalPlayer()==Player(id-1)then
call ClearSelection()
call SelectUnit(pick_unit[id],true)
endif
endif
if GetSpellAbilityId()=='A0KH' or GetSpellAbilityId()=='A0KI' then
if owner !=id and owner>0 then
call SetItemPosition(SpellItem,GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()))
call DisplayTextToForce(bj_FORCE_PLAYER[id-1],"|cffffcc00Это не ваш предмет!|r")
elseif LoadBoolean(udg_hash,GetHandleId(SpellItem),StringHash("Original"))then
call UnitAddItem(udg_Hero[id],SpellItem)
else
set drop=GetItemCharges(SpellItem)
if IsUnitInGroup(udg_Hero[id],udg_HeroBuild)then
set a=TakeLooting(udg_Hero[id],GetItemTypeId(SpellItem))
else
set a=0
endif
if a==0 then
if drop>1 then
if UnitHasItemOfTypeBJ(udg_Hero[id],GetItemTypeId(SpellItem))then
call SetItemCharges(GetItemOfTypeFromUnitBJ(udg_Hero[id],GetItemTypeId(SpellItem)),GetItemCharges(GetItemOfTypeFromUnitBJ(udg_Hero[id],GetItemTypeId(SpellItem)))+drop)
else
call UnitAddItemByIdSwapped(GetItemTypeId(SpellItem),udg_Hero[id])
call SetItemCharges(bj_lastCreatedItem,drop)
endif
else
call UnitAddItemByIdSwapped(GetItemTypeId(SpellItem),udg_Hero[id])
endif
endif
call RemoveItem(SpellItem)
endif
endif
if GetSpellAbilityId()=='A0KJ' then
if owner !=id and owner>0 then
call SetItemPosition(SpellItem,GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()))
call DisplayTextToForce(bj_FORCE_PLAYER[id-1],"|cffffcc00Это не ваш предмет!|r")
elseif LoadBoolean(udg_hash,GetHandleId(SpellItem),StringHash("Original"))then
call UnitAddItem(udg_Circle[id],SpellItem)
else
set drop=GetItemCharges(SpellItem)
if drop>1 then
if UnitHasItemOfTypeBJ(udg_Circle[id],GetItemTypeId(SpellItem))then
call SetItemCharges(GetItemOfTypeFromUnitBJ(udg_Circle[id],GetItemTypeId(SpellItem)),GetItemCharges(GetItemOfTypeFromUnitBJ(udg_Circle[id],GetItemTypeId(SpellItem)))+drop)
else
call UnitAddItemByIdSwapped(GetItemTypeId(SpellItem),udg_Circle[id])
call SetItemCharges(bj_lastCreatedItem,drop)
endif
else
call UnitAddItemByIdSwapped(GetItemTypeId(SpellItem),udg_Circle[id])
endif
call RemoveItem(SpellItem)
endif
endif
if GetSpellAbilityId()=='A0D3' then
if IsItemOwned(Item1)and IsItemOwned(Item2)then
set udg_Sintez[1]=GetItemTypeId(Item1)
set udg_Sintez[2]=GetItemTypeId(Item2)
if udg_Sintez[2]=='I04F' or udg_Sintez[2]=='I0DO' or udg_Sintez[1]=='I04F' or udg_Sintez[1]=='I0DO' then
if udg_Sintez[1]=='I0CL' or udg_Sintez[2]=='I0CL' then
if udg_Sintez[1]=='I0DO' or udg_Sintez[2]=='I0DO' then
set a=2500
call SetPlayerStateBJ(Player(id-1),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id-1),PLAYER_STATE_RESOURCE_GOLD)+a)
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id-1],15.,"|cFF00C850Вам вернули"+I2S(a)+" ед золота|r")
endif
call RemoveItem(Item1)
call RemoveItem(Item2)
call UnitAddItemByIdSwapped('I0E0',GetSpellAbilityUnit())
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
set SpellItem=null
set Item1=null
set Item2=null
return
elseif udg_Sintez[1]=='I0AU' or udg_Sintez[2]=='I0AU' then
call RemoveItem(Item1)
call RemoveItem(Item2)
