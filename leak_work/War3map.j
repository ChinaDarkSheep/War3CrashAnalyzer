call SaveUnitHandle(udg_hash,ht,0,u)
call SaveGroupHandle(udg_hash,ht,1,g)
call TimerStart(bj_lastStartedTimer,r,false,function Func_CD_UG_Wait)
endfunction
function Func_SpawnUnit_CD takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local integer name=LoadInteger(udg_hash,h,0)
local real x=LoadReal(udg_hash,h,1)
local real y=LoadReal(udg_hash,h,2)
local player pl=LoadPlayerHandle(udg_hash,h,3)
set bj_lastCreatedUnit=CreateUnit(pl,name,x,y,0.)
call FlushChildHashtable(udg_hash,h)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
set pl=null
endfunction
function Func_SpawnUnit takes real x,real y,integer name,real r,player pl returns nothing
local integer h
set bj_lastStartedTimer=CreateTimer()
set h=GetHandleId(bj_lastStartedTimer)
call SaveInteger(udg_hash,h,0,name)
call SaveReal(udg_hash,h,1,x)
call SaveReal(udg_hash,h,2,y)
call SavePlayerHandle(udg_hash,h,3,pl)
call TimerStart(bj_lastStartedTimer,r,false,function Func_SpawnUnit_CD)
endfunction
function Func_Trigger_CD takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local trigger name=LoadTriggerHandle(udg_hash,h,0)
local string s=LoadStr(udg_hash,h,1)
if s=="On" then
call EnableTrigger(gg_trg_WinEnd)
endif
if s=="ConditExecute" then
call ConditionalTriggerExecute(name)
endif
if s=="Excute" then
call TriggerExecute(name)
endif
if s=="OnCondit" then
call EnableTrigger(name)
call ConditionalTriggerExecute(name)
endif
if s=="Destroy" then
call DestroyTrigger(name)
endif
call FlushChildHashtable(udg_hash,h)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
set name=null
endfunction
function Func_Trigger takes trigger name,real r,string s returns nothing
local integer h
set bj_lastStartedTimer=CreateTimer()
set h=GetHandleId(bj_lastStartedTimer)
call SaveTriggerHandle(udg_hash,h,0,name)
call SaveStr(udg_hash,h,1,s)
call TimerStart(bj_lastStartedTimer,r,false,function Func_SpawnUnit_CD)
endfunction
function FHelpText takes integer id,string str,real sec returns nothing
if id==111 then
set bj_forLoopAIndex=0
loop
exitwhen bj_forLoopAIndex>7
if s__HelpText[bj_forLoopAIndex]then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[bj_forLoopAIndex],sec,str)
endif
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
elseif s__HelpText[id]then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],sec,str)
endif
endfunction
function Trig_Filter_ID takes nothing returns boolean
return(UnitAlive(GetFilterUnit())and IsUnitEnemy(GetFilterUnit(),Player(udg_Drop2)))
endfunction
function Trig_Filter_ID_innoG takes nothing returns boolean
return(UnitAlive(GetFilterUnit())and IsUnitEnemy(GetFilterUnit(),Player(udg_Drop2))and not IsUnitInGroup(GetFilterUnit(),udg_ug))
endfunction
function FG_Filter_ID_innoG takes nothing returns nothing
call GroupAddUnit(udg_ug,GetEnumUnit())
endfunction
function Trig_Filter_ID_FG takes nothing returns boolean
return(UnitAlive(GetFilterUnit())and IsUnitEnemy(GetFilterUnit(),Player(udg_Drop2))and not IsUnitInGroup(GetFilterUnit(),FilterGroup))
endfunction
function Trig_Filter_ID_Ally takes nothing returns boolean
return(UnitAlive(GetFilterUnit())and IsUnitAlly(GetFilterUnit(),Player(udg_Drop2)))
endfunction
function FilterAlive takes nothing returns boolean
return(UnitAlive(GetFilterUnit())and GetUnitAbilityLevel(GetFilterUnit(),'Aloc')==0)
endfunction
function Trig_SpaceMarine takes nothing returns boolean
return(GetUnitTypeId(GetFilterUnit())=='z002')
endfunction
function FUniversal_1 takes nothing returns boolean
return(GetOwningPlayer(GetFilterUnit())==Player(PLAYER_NEUTRAL_AGGRESSIVE)and UnitAlive(GetFilterUnit())and(GetUnitTypeId(GetFilterUnit())==Filtername[0]or GetUnitTypeId(GetFilterUnit())==Filtername[1]or GetUnitTypeId(GetFilterUnit())==Filtername[2]or GetUnitTypeId(GetFilterUnit())==Filtername[3]or GetUnitTypeId(GetFilterUnit())==Filtername[4]or GetUnitTypeId(GetFilterUnit())==Filtername[5]))
endfunction
function FUniversal_Player takes nothing returns boolean
return(GetOwningPlayer(GetFilterUnit())==Player(udg_Drop2)and UnitAlive(GetFilterUnit())and(GetUnitTypeId(GetFilterUnit())==Filtername[0]or GetUnitTypeId(GetFilterUnit())==Filtername[1]or GetUnitTypeId(GetFilterUnit())==Filtername[2]or GetUnitTypeId(GetFilterUnit())==Filtername[3]or GetUnitTypeId(GetFilterUnit())==Filtername[4]or GetUnitTypeId(GetFilterUnit())==Filtername[5]))
endfunction
function GroupDamage takes real x,real y,real range,unit attack,boolean b_att,real dmg,attacktype a_type,damagetype d_type returns nothing
local integer id=GetPlayerId(GetOwningPlayer(attack))
local group g=CreateGroup()
local unit u
set udg_noSplash=true
set udg_Drop2=id
call GroupEnumUnitsInRange(g,x,y,range,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(attack,u,dmg,b_att,b_att,a_type,d_type,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
set udg_noSplash=false
call DestroyGroup(g)
set u=null
set g=null
endfunction
function GroupDamage_e takes real x,real y,real range,unit attack,boolean b_att,real dmg,attacktype a_type,damagetype d_type,string e returns nothing
local integer id=GetPlayerId(GetOwningPlayer(attack))
local group g=CreateGroup()
local unit u
set udg_noSplash=true
set udg_Drop2=id
call GroupEnumUnitsInRange(g,x,y,range,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(attack,u,dmg,b_att,b_att,a_type,d_type,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget(e,u,"origin")
call DestroyEffect(bj_lastCreatedEffect)
call GroupRemoveUnit(g,u)
endloop
set udg_noSplash=false
call DestroyGroup(g)
set u=null
set g=null
endfunction
function FUniversal_Rec takes group g,rect rec,integer n,integer n1,integer n2,integer n3,integer n4,integer n5 returns group
if n !=0 then
set Filtername[0]=n
else
set Filtername[0]='h009'
endif
if n1 !=0 then
set Filtername[1]=n1
else
set Filtername[1]='h009'
endif
if n2 !=0 then
set Filtername[2]=n2
else
set Filtername[2]='h009'
endif
if n3 !=0 then
set Filtername[3]=n3
else
set Filtername[3]='h009'
endif
if n4 !=0 then
set Filtername[4]=n4
else
set Filtername[4]='h009'
endif
if n5 !=0 then
set Filtername[5]=n5
else
set Filtername[5]='h009'
endif
call GroupEnumUnitsInRect(g,rec,Bool_FUniversal_1)
return g
endfunction
function Trig_HumanMageDamage takes nothing returns nothing
if GetUnitTypeId(udg_DamageEventSource)=='nhym' and udg_IsDamageSpell then
set udg_Damage[4]=GetHeroInt(udg_HumanBuilder,true)/3.+100.
call UnitDamageTarget(udg_DamageEventSource,udg_DamageEventTarget,udg_Damage[4],true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
else
endif
endfunction
function YesCD takes integer ID returns boolean
if ID=='Amec' then
return false
endif
if ID=='A0VG' then
return false
endif
if ID=='A0V3' then
return false
endif
if ID=='A1D1' then
return false
endif
return true
endfunction
function F_Reflect takes unit u returns real
local integer ID=GetPlayerId(GetOwningPlayer(u))+1
local real r=udg_ReflectDmg[ID]+1.
local integer h=GetHandleId(u)
local integer a
local integer b
local integer i
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='prvt' then
set r=r+0.02*GetUnitState(u,UNIT_STATE_MAX_LIFE)
endif
if ID<=8 then
if GetInventoryIndexOfItemTypeBJ(u,'I091')>0 then
set r=r+0.04*GetUnitState(u,UNIT_STATE_MAX_LIFE)
endif
set a=0
set i=0
loop
exitwhen a>5 or i>0
set b=GetItemTypeId(UnitItemInSlot(u,a))
if b=='I0F1' then
set i=1
set r=r+0.08*GetUnitState(u,UNIT_STATE_MAX_LIFE)
elseif b=='I07E' or b=='I0DM' or b=='I0DR' or b=='I0E6' or b=='I0EE' then
set i=1
set r=r+0.06*GetUnitState(u,UNIT_STATE_MAX_LIFE)
elseif b=='I06R' then
set i=1
set r=r+0.04*GetUnitState(u,UNIT_STATE_MAX_LIFE)
elseif b=='I0E5' or b=='I03N' then
set i=1
set r=r+0.02*GetUnitState(u,UNIT_STATE_MAX_LIFE)
endif
set a=a+1
endloop
endif
if GetUnitTypeId(u)=='N05H' and udg_CaptainD then
set r=1.2*r
endif
set r=r*(1.+LoadReal(udg_hash,h,StringHash("ObrDMG")))
return r
endfunction
function F_MPregen takes unit u returns real
local real mpreg=0.
local integer h=GetHandleId(u)
local real MP
local real mpregbonus=1.+LoadReal(udg_hash,h,StringHash("MPRegenBonus"))
if IsUnitType(u,UNIT_TYPE_HERO)then
set mpreg=0.05*GetHeroInt(u,true)
endif
set MP=(LoadReal(udg_hash,h,StringHash("MPRegen"))+mpreg)*mpregbonus
return MP
endfunction
function F_HPregen takes unit u returns real
local real hpreg=0
local integer h=GetHandleId(u)
local real HP=0
local integer agi=GetHeroAgi(u,true)
local integer str=GetHeroStr(u,true)
local integer int=GetHeroInt(u,true)
local integer ID=GetPlayerId(GetOwningPlayer(u))+1
local real hpregbonus=LoadReal(udg_hash,h,StringHash("HPRegenBonus"))+LoadReal(udg_hash,h,StringHash("HPRegenBonusMult"))
local real regen=LoadReal(udg_hash,h,StringHash("HPRegen"))
local integer ihh=LoadInteger(Hash,h,0)
if IsUnitType(u,UNIT_TYPE_HERO)then
if s__Heroes_buyI071[sHero[ihh]]>0 then
if str>=agi and str>=int then
set hpreg=str
elseif agi>=int then
set hpreg=agi
else
set hpreg=int
endif
else
set hpreg=str
endif
else
set hpreg=0.01
endif
set HP=1.
if GetInventoryIndexOfItemTypeBJ(u,'I0E4')>0 then
set HP=HP+1.5
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='oflg' then
set HP=HP+0.3
endif
set HP=0.06*HP
if GetUnitAbilityLevel(u,'B03C')>0 then
set regen=regen+6*GetUnitAbilityLevel(u,'A14H')
endif
set HP=(regen+hpreg*HP)*hpregbonus
return HP
endfunction
function F_Barrier takes unit hero,real hp returns real
local integer ID=GetPlayerId(GetOwningPlayer(hero))
local real per=1.
if UnitHasItemOfTypeBJ(hero,'I0EY')then
set per=per+0.25
endif
if GetUnitAbilityLevel(hero,'A18J')==1 and udg_Talante[ID]==3 then
set per=per+0.25
endif
return hp*per
endfunction
