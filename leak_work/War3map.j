call DisableTrigger(gg_trg_MurkyRSummon)
call TriggerRegisterTimerExpireEventBJ(gg_trg_MurkyRSummon,udg_MurkyRTimer)
call TriggerAddAction(gg_trg_MurkyRSummon,function Trig_MurkyRSummon_Actions)
