function Trig_SmallEvent2_Actions takes nothing returns nothing
local real x
local real y
local integer a
local integer b
local integer rand=GetRandomInt(1,6)
if rand==1 then
set x=GetRectCenterX(gg_rct_Spawn70)
set y=GetRectCenterY(gg_rct_Spawn70)
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,30.00,"|cFFFF5800Атака троллей!|r")
call PingMinimapForForceEx(bj_FORCE_ALL_PLAYERS,x,y,5,bj_MINIMAPPINGSTYLE_SIMPLE,100,87.00,0.00)
if udg_Mode==2 then
if HardcoreUP10==3 then
set a=200
set b=3000
else
set a=85
set b=1280
endif
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>10
set bj_lastCreatedUnit=CreateUnit(ForcePickRandomPlayer(udg_CreepsPlayers),'n00W',x,y,bj_UNIT_FACING)
call GroupAddUnit(udg_A3,bj_lastCreatedUnit)
call UnitAddAbility(bj_lastCreatedUnit,'A007')
call SummonStats(false,b,a,bj_lastCreatedUnit,bj_lastCreatedUnit)
call UnitRemoveAbility(bj_lastCreatedUnit,'A007')
call IssuePointOrder(bj_lastCreatedUnit,"attack",-6400,12850)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
if HardcoreUP10==3 then
set a=150
set b=2500
else
set a=65
set b=500
endif
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>18
set bj_lastCreatedUnit=CreateUnit(ForcePickRandomPlayer(udg_CreepsPlayers),'nftt',x,y,bj_UNIT_FACING)
call GroupAddUnit(udg_A3,bj_lastCreatedUnit)
call UnitAddAbility(bj_lastCreatedUnit,'A007')
call SummonStats(false,b,a,bj_lastCreatedUnit,bj_lastCreatedUnit)
call UnitRemoveAbility(bj_lastCreatedUnit,'A007')
call IssuePointOrder(bj_lastCreatedUnit,"attack",-6400,12850)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
elseif rand==2 then
set x=GetRectCenterX(gg_rct_Spawn68)
