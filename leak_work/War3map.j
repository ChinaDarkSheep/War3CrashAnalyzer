function HeroE53_conditions takes nothing returns boolean
return GetSpellAbilityId()=='A1CY'
endfunction
function Trig_HeroE53_Actions takes nothing returns nothing
local unit hero=GetSpellAbilityUnit()
local integer h=GetHandleId(hero)
local unit dummy
local unit u
local player pl=GetOwningPlayer(hero)
local real x=GetUnitX(hero)
local real y=GetUnitY(hero)
local group g=CreateGroup()
local real dmg=100*GetUnitAbilityLevel(hero,'A1CY')+3.*GetHeroInt(hero,true)
local real dmg2=10*GetUnitAbilityLevel(hero,'A1CY')+.2*GetHeroInt(hero,true)
local real life=GetUnitState(hero,UNIT_STATE_LIFE)
local real heal=0
local attacktype a_type
local damagetype d_type
local integer i=LoadInteger(Hash,h,0)
if GetUnitAbilityLevel(hero,'A1D0')==1 then
set d_type=DAMAGE_TYPE_UNIVERSAL
set a_type=ATTACK_TYPE_NORMAL
set dmg=dmg*(0.01*I2R(s__Units_MageDamage[sUnit[i]]/100))
else
set d_type=DAMAGE_TYPE_MAGIC
set a_type=ATTACK_TYPE_NORMAL
endif
set udg_Drop2=GetPlayerId(GetOwningPlayer(hero))
call GroupEnumUnitsInRange(g,x,y,500,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,false,a_type,d_type,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl",u,"origin"))
set heal=heal+1
if UnitAlive(u)then
set x=GetUnitX(u)
set y=GetUnitY(u)
set dummy=CreateUnit(pl,'h009',x,y,0)
call UnitAddAbility(dummy,'Apg2')
call UnitApplyTimedLife(dummy,'BTLF',2)
call IssueTargetOrder(dummy,"purge",u)
endif
call GroupRemoveUnit(g,u)
endloop
if heal>10 then
set heal=10
endif
set heal=heal*dmg2
call SetUnitState(hero,UNIT_STATE_LIFE,life+heal)
call DestroyGroup(g)
set hero=null
set dummy=null
set u=null
set pl=null
set g=null
set a_type=null
set d_type=null
endfunction
