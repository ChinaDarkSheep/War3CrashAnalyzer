if not IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)then
return true
endif
return false
endfunction
function ArtRE takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
call DestroyEffect(LoadEffectHandle(udg_hash,ht,0))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set t=null
endfunction
function Trig_CreepDeathJass_Actions takes nothing returns nothing
local unit death=GetTriggerUnit()
local integer DUType=GetUnitTypeId(death)
local integer ID=GetPlayerId(GetOwningPlayer(death))+1
local integer IDK=GetPlayerId(GetOwningPlayer(GetKillingUnit()))+1
local integer h=GetHandleId(death)
local integer h2
local integer i=0
local integer a
local integer b
local unit u2
local unit u
local real r
local real z
local real xd=GetUnitX(death)
local real yd=GetUnitY(death)
local real x1
local real y1
local real dmg
local group g=CreateGroup()
local boolean kill_red=false
local timer t
local integer ht
local real power=1.+0.02*s__SetTechUP[ID-1]
if GetUnitAbilityLevel(death,'Aloc')==1 or LoadInteger(Hash,h,IDDammy)==1 then
call GroupAddUnit(Gdel1s5,death)
else
call GroupAddUnit(Gdel40s,death)
endif
if GetUnitAbilityLevel(death,'A0YT')==1 then
call UnitRemoveAbility(death,'A0YT')
endif
if DUType=='u01W' then
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>2
set bj_lastCreatedUnit=CreateUnit(ForcePickRandomPlayer(udg_CreepsPlayers),'u01Y',xd,yd,bj_UNIT_FACING)
call SetUnitVertexColor(bj_lastCreatedUnit,50,125,50,110)
call GroupAddUnit(udg_A1,bj_lastCreatedUnit)
set bj_lastCreatedUnit=CreateUnit(ForcePickRandomPlayer(udg_CreepsPlayers),'h04N',xd,yd,bj_UNIT_FACING)
call SetUnitVertexColor(bj_lastCreatedUnit,50,125,50,110)
call GroupAddUnit(udg_A1,bj_lastCreatedUnit)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
if DUType=='u020' then
set bj_lastCreatedUnit=CreateUnit(ForcePickRandomPlayer(udg_CreepsPlayers),'u01Z',xd,yd,bj_UNIT_FACING)
call SetUnitVertexColor(bj_lastCreatedUnit,50,125,50,110)
call GroupAddUnit(udg_A1,bj_lastCreatedUnit)
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>3
set bj_lastCreatedUnit=CreateUnit(ForcePickRandomPlayer(udg_CreepsPlayers),'u01Y',xd,yd,bj_UNIT_FACING)
call SetUnitVertexColor(bj_lastCreatedUnit,50,125,50,110)
call GroupAddUnit(udg_A1,bj_lastCreatedUnit)
set bj_lastCreatedUnit=CreateUnit(ForcePickRandomPlayer(udg_CreepsPlayers),'h04N',xd,yd,bj_UNIT_FACING)
call SetUnitVertexColor(bj_lastCreatedUnit,50,125,50,110)
call GroupAddUnit(udg_A1,bj_lastCreatedUnit)
set bj_lastCreatedUnit=CreateUnit(ForcePickRandomPlayer(udg_CreepsPlayers),'u021',xd,yd,bj_UNIT_FACING)
call SetUnitVertexColor(bj_lastCreatedUnit,50,125,50,110)
call GroupAddUnit(udg_A1,bj_lastCreatedUnit)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
if ID>8 then
if DUType=='n03O' and GetOwningPlayer(death)==Player(PLAYER_NEUTRAL_AGGRESSIVE)then
