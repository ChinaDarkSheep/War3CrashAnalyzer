call ForGroup(bj_lastCreatedGroup,function Trig_StrajDied_Func001Func003Func003A)
call DestroyGroup(bj_lastCreatedGroup)
call DestroyTrigger(GetTriggeringTrigger())
else
call DisplayTimedTextToForce(GetPlayersAll(),17.00,("|cFFFF5800Умер Страж Азшары. Осталось убить - "+I2S((9-udg_NagaBoss))))
endif
else
endif
