set b=0
endif
if c==1 then
set c='I095'
elseif c==2 then
set c='I09A'
elseif c==3 then
set c='I09X'
elseif c==4 then
set c='I092'
else
set c=0
endif
if d==1 then
set d='I093'
elseif d==2 then
set d='I09D'
elseif d==3 then
set d='I09Z'
elseif d==4 then
set d='I0EK'
elseif d==5 then
set d='I08W'
else
set d=0
endif
call Pick_Item(ID,a,b,c,d,0,0,false)
call RemoveItem(Item)
endif
call DestroyGroup(g)
set caster=null
set Item=null
set u=null
set t=null
set p=null
set p2=null
set g=null
set gt=null
endfunction
function InitTrig_UseItemJass takes nothing returns nothing
set gg_trg_UseItemJass=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_UseItemJass,EVENT_PLAYER_UNIT_USE_ITEM)
call TriggerAddAction(gg_trg_UseItemJass,function Trig_UseItemJass_Actions)
endfunction
function Trig_UseItemJass2_Conditions takes nothing returns boolean
if not IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)then
return false
endif
return true
endfunction
function Driade_D takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(hero)
call SaveBoolean(udg_hash,h,'d',false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set hero=null
set t=null
endfunction
function NightStaff takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer ID=LoadInteger(udg_hash,ht,0)
local real r=LoadReal(udg_hash,ht,1)
set udg_ReflectDmg[ID]=udg_ReflectDmg[ID]-r
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set t=null
endfunction
function LeafPlants takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer tic=LoadInteger(udg_hash,ht,0)
local real x=LoadReal(udg_hash,ht,1)
local real y=LoadReal(udg_hash,ht,2)
local real x1
local real y1
if tic>0 then
call SaveInteger(udg_hash,ht,0,tic-1)
set x1=x+GetRandomInt(-90,90)*Cos(bj_DEGTORAD)
set y1=y+GetRandomInt(-90,90)*Sin(bj_DEGTORAD)
set bj_lastCreatedItem=CreateItem('I00E',x1,y1)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
endfunction
function FGodsRune takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer id=LoadInteger(udg_hash,ht,4)
local real sec=LoadReal(udg_hash,ht,0)-.5
local real x=LoadReal(udg_hash,ht,1)
local real y=LoadReal(udg_hash,ht,2)
local group g=CreateGroup()
local group g2=LoadGroupHandle(udg_hash,ht,3)
local unit u
local integer h
local integer a
local integer b
if sec>0 then
call SaveReal(udg_hash,ht,0,sec)
set udg_Drop2=id
call GroupEnumUnitsInRange(g,x,y,400.,Bool_Filter_ID_Ally)
call SeekMinUnit()
loop
set u=FirstOfGroup(g)
exitwhen u==null
if not IsUnitInGroup(u,g2)then
set h=GetHandleId(u)
set a=LoadInteger(Hash,h,0)
if a==0 then
set a=SeekFreeUnitMin(h)
endif
set b=LoadInteger(udg_hash,h,HashGodsRune)
call SaveInteger(udg_hash,h,HashGodsRune,b+1)
if b==0 then
set s__Units_AllBlock[sUnit[a]]=s__Units_AllBlock[sUnit[a]]+3500
endif
call GroupAddUnit(g2,u)
endif
call GroupRemoveUnit(g,u)
endloop
else
loop
set u=FirstOfGroup(g2)
exitwhen u==null
set h=GetHandleId(u)
set a=LoadInteger(Hash,h,0)
set b=LoadInteger(udg_hash,h,HashGodsRune)-1
call SaveInteger(udg_hash,h,HashGodsRune,b)
if b==0 then
set s__Units_AllBlock[sUnit[a]]=s__Units_AllBlock[sUnit[a]]-3500
endif
call GroupRemoveUnit(g2,u)
endloop
call DestroyGroup(g2)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
call DestroyGroup(g)
set t=null
set g=null
set g2=null
set u=null
endfunction
function Trig_UseItemJass2_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local unit target=GetSpellTargetUnit()
local unit u
local integer h=GetHandleId(caster)
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local integer drop
local integer a
local real x
local real y
local real x1
local real y1
local real dmg
local real heal
local real r
local group g=CreateGroup()
local timer t
local integer ht
local integer highstat
local integer iuh=LoadInteger(Hash,h,0)
if GetHeroStr(caster,true)>=GetHeroAgi(caster,true)then
if GetHeroStr(caster,true)>=GetHeroInt(caster,true)then
set highstat=GetHeroStr(caster,true)
else
set highstat=GetHeroInt(caster,true)
endif
else
if GetHeroAgi(caster,true)>=GetHeroInt(caster,true)then
set highstat=GetHeroAgi(caster,true)
else
set highstat=GetHeroInt(caster,true)
endif
endif
if GetSpellAbilityId()=='A03S' then
call SetUnitState(target,UNIT_STATE_LIFE,GetUnitState(target,UNIT_STATE_LIFE)+100+40*GetHeroLevel(target))
elseif GetSpellAbilityId()=='A0KX' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set bj_lastCreatedItem=CreateItem('I00E',x,y)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveInteger(udg_hash,ht,0,10)
call SaveReal(udg_hash,ht,1,x)
call SaveReal(udg_hash,ht,2,y)
call TimerStart(t,15,true,function LeafPlants)
elseif GetSpellAbilityId()=='A0JZ' then
set r=GetHeroInt(caster,true)/2
set udg_ReflectDmg[ID]=udg_ReflectDmg[ID]+r
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveInteger(udg_hash,ht,0,ID)
call SaveReal(udg_hash,ht,1,r)
call TimerStart(t,12,false,function NightStaff)
elseif GetSpellAbilityId()=='A0U9' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set dmg=GetHeroAgi(caster,true)*8+800
call GroupDamage(x,y,400,caster,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
elseif GetSpellAbilityId()=='A035' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set dmg=GetHeroInt(caster,true)*12
call GroupEnumUnitsInRange(g,x,y,225,null)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)then
if IsUnitEnemy(u,Player(ID-1))then
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",u,"origin")
call DestroyEffect(bj_lastCreatedEffect)
elseif GetUnitTypeId(u)=='z002' then
set bj_lastCreatedItem=CreateItem('I054',x,y)
call ExplodeUnitBJ(u)
endif
endif
call GroupRemoveUnit(g,u)
endloop
set u=CreateUnit(Player(ID-1),'h01P',x,y,0)
call UnitApplyTimedLife(u,'BTLF',3)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",x,y))
elseif GetSpellAbilityId()=='A0SC' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,300,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
set bj_lastCreatedUnit=CreateUnit(Player(ID-1),'h009',GetUnitX(u),GetUnitY(u),0)
call UnitAddAbility(bj_lastCreatedUnit,'A0CL')
call IssueTargetOrder(bj_lastCreatedUnit,"banish",u)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',2)
call GroupRemoveUnit(g,u)
endloop
elseif GetSpellAbilityId()=='A0TB' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set u=CreateUnit(Player(ID-1),'h03U',x,y,0)
call UnitApplyTimedLife(u,'BTLF',14)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveReal(udg_hash,ht,0,14.)
call SaveReal(udg_hash,ht,1,x)
call SaveReal(udg_hash,ht,2,y)
call SaveGroupHandle(udg_hash,ht,3,CreateGroup())
call SaveInteger(udg_hash,ht,4,GetPlayerId(GetOwningPlayer(caster)))
call TimerStart(t,.5,true,function FGodsRune)
elseif GetSpellAbilityId()=='A08H' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set u=CreateUnit(Player(ID-1),'n05W',x,y,0)
call UnitApplyTimedLife(u,'BTLF',20)
call UnitAddAbility(u,'A007')
call SummonStats(true,12*(GetHeroAgi(caster,true)+GetHeroInt(caster,true)),2*GetHeroInt(caster,true),u,caster)
call UnitRemoveAbility(u,'A007')
elseif GetSpellAbilityId()=='A0YV' then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set dmg=400+1.333*highstat
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call SeekMinDummys()
call GroupEnumUnitsInRange(g,GetSpellTargetX(),GetSpellTargetY(),350.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'h05G',x,y,GetUnitFacing(caster))
set a=SeekFreeDummysMin(bj_lastCreatedUnit,GetHandleId(bj_lastCreatedUnit))
if GetUnitAbilityLevel(u,'Arsk')==1 or IsUnitType(u,UNIT_TYPE_HERO)then
set s__Dummys_dmg[sDummy[a]]=3.*dmg
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',2.1)
else
set s__Dummys_dmg[sDummy[a]]=dmg
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',6.1)
endif
call UnitAddAbility(bj_lastCreatedUnit,'A0XP')
call IssueTargetOrder(bj_lastCreatedUnit,"magicleash",u)
call GroupRemoveUnit(g,u)
endloop
endif
if GetUnitAbilityLevel(target,'A0HG')==1 and GetSpellAbilityId()!='A0VG' and LoadBoolean(udg_hash,GetHandleId(target),'d')==false then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIvi\\AIviTarget.mdl",target,"chest"))
call SetUnitState(target,UNIT_STATE_LIFE,GetUnitState(target,UNIT_STATE_LIFE)+2.*GetHeroInt(target,true))
call SaveBoolean(udg_hash,GetHandleId(target),'d',true)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,target)
call TimerStart(t,1,false,function Driade_D)
endif
if GetSpellAbilityId()=='A1E8' and IsUnitEnemy(target,Player(ID-1))then
if IsUnitInGroup(target,udg_behelit)==false then
call GroupAddUnit(udg_behelit,target)
set r=udg_Time[2]+60*udg_Time[3]
if r>30 then
set r=30
endif
set r=1+0.05*r
set dmg=r+6*GetUnitLevel(target)
set x=r+200*GetUnitLevel(target)
call UnitAddAbility(target,'A007')
call SummonStats(false,R2I(x),R2I(dmg),target,target)
call UnitRemoveAbility(target,'A007')
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",target,"origin")
call DestroyEffect(bj_lastCreatedEffect)
endif
endif
if GetSpellAbilityId()=='A0A9' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
call GroupEnumUnitsInRange(g,x,y,425,null)
set dmg=2000+6*GetHeroInt(caster,true)
set heal=2000+5*GetHeroInt(caster,true)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)then
if IsUnitEnemy(u,Player(ID-1))then
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("war3mapImported\\Holy Light.mdx",u,"origin")
call DestroyEffect(bj_lastCreatedEffect)
elseif IsUnitAlly(u,Player(ID-1))then
call Heal(true,heal,u,caster)
set bj_lastCreatedEffect=AddSpecialEffectTarget("war3mapImported\\Holy Light.mdx",u,"origin")
call DestroyEffect(bj_lastCreatedEffect)
endif
endif
call GroupRemoveUnit(g,u)
endloop
endif
if GetSpellAbilityId()=='A1CQ' then
if GetUnitLevel(target)>=15 and ModuloInteger(GetUnitLevel(target),5)==0 then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],3.00,"Нельзя скопировать босса!")
set a=1
elseif GetUnitAbilityLevel(target,'Arsk')==1 or IsUnitType(target,UNIT_TYPE_HERO)or GetUnitTypeId(target)=='n02P' then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],3.00,"Нельзя скопировать данное существо!")
set a=1
else
set x=GetUnitX(caster)+125*Cos(GetUnitFacing(caster)*bj_DEGTORAD)
set y=GetUnitY(caster)+125*Sin(GetUnitFacing(caster)*bj_DEGTORAD)
set dmg=0.75*GetHeroInt(caster,true)
set heal=15.*(GetHeroStr(caster,true)+GetHeroInt(caster,true))
set r=1.+0.04*GetUnitLevel(target)
if r>=1.5 then
set r=1.5
endif
set u=CreateUnit(GetOwningPlayer(caster),GetUnitTypeId(target),x,y,GetUnitFacing(caster))
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(heal*r),R2I(dmg*r),u,caster)
call F_Armore(u,R2I(40))
call UnitRemoveAbility(u,'A007')
call UnitApplyTimedLife(u,'BTLF',35.)
endif
endif
if GetSpellAbilityId()=='A154' then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set u=CreateUnit(GetOwningPlayer(caster),'h05G',x,y,GetUnitFacing(caster))
call UnitAddAbility(u,'A0XG')
call UnitApplyTimedLife(u,'BTLF',4.)
set dmg=2000+5*highstat
set a=SeekFreeDummys(u,GetHandleId(u))
set s__Dummys_dmg[sDummy[a]]=dmg
call IssuePointOrder(u,"carrionswarm",GetSpellTargetX(),GetSpellTargetY())
endif
if GetSpellAbilityId()=='A1B9' then
set a=LoadInteger(udg_hash,h,StringHash("StaffGold1"))
if a>0 then
call SaveInteger(udg_hash,a,StringHash("StaffGold"),0)
endif
set drop=LoadInteger(udg_hash,GetHandleId(target),StringHash("StaffGold"))
call SaveInteger(udg_hash,GetHandleId(udg_Hero[drop]),StringHash("StaffGold1"),0)
call SaveInteger(udg_hash,GetHandleId(udg_Hero[drop]),StringHash("StaffGoldID"),0)
call SaveInteger(udg_hash,h,StringHash("StaffGold1"),GetHandleId(target))
call SaveInteger(udg_hash,h,StringHash("StaffGoldID"),GetPlayerId(GetOwningPlayer(target)))
call SaveInteger(udg_hash,GetHandleId(target),StringHash("StaffGold"),ID)
endif
if GetSpellAbilityId()=='A0WZ' then
call TempStats(target,0,0,200,0,0,0,15.)
endif
if GetSpellAbilityId()=='A1CD' then
call Heal(true,1000.+3.*GetHeroInt(caster,true),target,caster)
set bj_lastCreatedEffect=AddSpecialEffectTarget("war3mapImported\\Heal.mdx",target,"origin")
call DestroyEffect(bj_lastCreatedEffect)
endif
if GetSpellAbilityId()=='A10B' then
set heal=0.06*GetUnitState(target,UNIT_STATE_MAX_LIFE)+2000.00+3.*GetHeroInt(caster,true)
if GetUnitState(target,UNIT_STATE_MAX_LIFE)>=16000.00 then
set heal=heal*1.40
endif
call Heal(true,heal,target,caster)
set bj_lastCreatedEffect=AddSpecialEffectTarget("war3mapImported\\Heal.mdx",target,"origin")
call DestroyEffect(bj_lastCreatedEffect)
endif
if IsUnitType(caster,UNIT_TYPE_HERO)then
if GetSpellAbilityId()=='A0TF' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,500,Bool_Filter_ID)
set dmg=1500+5*GetHeroInt(caster,true)
set heal=1.6*dmg
loop
set u=FirstOfGroup(g)
exitwhen u==null
if(GetUnitLevel(u)>=15 and ModuloInteger(GetUnitLevel(u),5)==0)or IsUnitType(u,UNIT_TYPE_HERO)then
call UnitDamageTarget(caster,u,heal,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
else
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
if UnitAlive(u)then
set bj_lastCreatedUnit=CreateUnit(Player(ID-1),'h009',GetUnitX(u),GetUnitY(u),0)
call UnitAddAbility(bj_lastCreatedUnit,'A0TG')
call IssueTargetOrder(bj_lastCreatedUnit,"frostnova",u)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',2)
endif
call GroupRemoveUnit(g,u)
endloop
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='ofro' and LoadBoolean(udg_hash,h,StringHash("Demon skull"))==false then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,800.,Bool_Filter_ID)
call RandomUnitFromGroup(1,g)
set u=FirstOfGroup(g)
call GroupClear(g)
if u !=null then
set dmg=750.+2.5*highstat
set x=GetUnitX(u)
set y=GetUnitY(u)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Demon\\DarkConversion\\ZombifyTarget.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
call GroupDamage(x,y,325.,caster,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
if UnitAlive(u)==false then
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+highstat)
endif
call Func_CD(caster,"Demon skull",15.)
endif
endif
endif
if GetSpellAbilityId()=='A06T' or GetSpellAbilityId()=='A15O' or GetSpellAbilityId()=='A15P' then
set x=GetUnitX(target)
set y=GetUnitY(target)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,215.,Bool_Filter_ID)
set dmg=14*GetHeroInt(caster,true)
call UnitDamageTarget(caster,target,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,target)
set dmg=3*GetHeroInt(caster,true)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)and IsUnitEnemy(u,GetOwningPlayer(caster))then
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
call GroupRemoveUnit(g,u)
endloop
endif
if GetSpellAbilityId()=='A1CO' then
set u=CreateUnit(GetOwningPlayer(caster),'h05G',GetUnitX(caster),GetUnitY(caster),GetUnitFacing(caster))
set dmg=300.+3.*highstat
set dmg=1.5*dmg
set dmg=dmg*(1+LoadReal(udg_hash,h,StringHash("Modificator")))
set a=SeekFreeDummys(u,GetHandleId(u))
set s__Dummys_dmg[sDummy[a]]=dmg
call UnitAddAbility(u,'A1CN')
call IssuePointOrder(u,"carrionswarm",GetSpellTargetX(),GetSpellTargetY())
call UnitApplyTimedLife(u,'BTLF',3.5)
endif
if GetSpellAbilityId()=='A0TM' then
set dmg=udg_RitualBlade+1.*GetHeroInt(caster,true)
call UnitDamageTarget(caster,target,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Orc\\Disenchant\\DisenchantSpecialArt.mdl",target,"origin")
call DestroyEffect(bj_lastCreatedEffect)
if UnitAlive(target)==false then
set udg_RitualBlade=udg_RitualBlade+50.00
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],("Урон ритуального клинка повышен! Текущее значение - "+R2S(udg_RitualBlade)))
call SetHeroInt(caster,GetHeroInt(caster,false)+2,true)
else
endif
else
endif
if GetSpellAbilityId()=='A1CP' then
set x=GetUnitX(target)
set y=GetUnitY(target)
set dmg=2000+20*GetHeroInt(caster,true)
call UnitDamageTarget(caster,target,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,300.,Bool_Filter_ID)
call GroupRemoveUnit(g,target)
set dmg=2.*GetHeroInt(caster,true)
if UnitAlive(target)==false then
set dmg=2.*dmg
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+0.2*GetUnitState(caster,UNIT_STATE_MAX_LIFE))
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Orc\\Disenchant\\DisenchantSpecialArt.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
else
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Orc\\Disenchant\\DisenchantSpecialArt.mdl",target,"origin")
call DestroyEffect(bj_lastCreatedEffect)
endif
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodFootman.mdl",u,"origin")
call DestroyEffect(bj_lastCreatedEffect)
call GroupRemoveUnit(g,u)
endloop
endif
if GetSpellAbilityId()=='A0XK' then
set dmg=2000+15*highstat
if GetUnitState(target,UNIT_STATE_LIFE)/GetUnitState(target,UNIT_STATE_MAX_LIFE)>0.5 then
set dmg=1.5*dmg
endif
call UnitDamageTarget(caster,target,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set x=GetUnitX(target)
set y=GetUnitY(target)
set dmg=1000+3*highstat
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,425.,Bool_Filter_ID)
call GroupRemoveUnit(g,target)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if GetUnitState(u,UNIT_STATE_LIFE)/GetUnitState(u,UNIT_STATE_MAX_LIFE)>0.5 then
call UnitDamageTarget(caster,u,1.5*dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
else
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
call GroupRemoveUnit(g,u)
endloop
else
endif
if YesCD(GetSpellAbilityId())then
if UnitHasItemOfTypeBJ(caster,'I05O')and not LoadBoolean(udg_hash,h,StringHash("I05O"))then
call SetUnitLifePercentBJ(caster,(GetUnitLifePercent(caster)+10.00))
set a=LoadInteger(Hash,h,0)
set drop=udg_Time[2]+10
if drop>40 then
set drop=40
endif
set s__Units_HP[sUnit[a]]=s__Units_HP[sUnit[a]]+drop
call Func_CD(caster,"I05O",6.)
endif
if UnitHasItemOfTypeBJ(caster,'I0BE')and GetUnitManaPercent(GetSpellAbilityUnit())>20.00 and not LoadBoolean(udg_hash,h,StringHash("Vodo"))then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,1000.,Bool_Filter_ID)
set a=CountUnitsInGroup(g)
if a>0 then
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosTarget.mdl",caster,"origin")
call DestroyEffect(bj_lastCreatedEffect)
set a=3+R2I(0.44*a)
set dmg=GetUnitState(caster,UNIT_STATE_MANA)*0.55
call SetUnitManaPercentBJ(caster,(GetUnitManaPercent(caster)-10.00))
call RandomUnitFromGroup(a,g)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
call Func_CD(caster,"Vodo",6.)
endif
endif
if UnitHasItemOfTypeBJ(caster,'I0A4')then
call SetUnitManaPercentBJ(caster,GetUnitManaPercent(caster)+5.00)
endif
endif
call F_hp(caster,s__Units_HP[sUnit[iuh]])
call F_Armore(caster,s__Units_Arm[sUnit[iuh]])
call F_Attack(caster,s__Units_GAttack[sUnit[iuh]])
call F_Stats(caster)
call DestroyGroup(g)
set caster=null
set target=null
set g=null
set u=null
set t=null
endfunction
