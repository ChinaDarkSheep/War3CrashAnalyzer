function Trig_BOSS30_Die_Conditions takes nothing returns boolean
if(not(GetDyingUnit()==udg_BOSS30))then
return false
endif
return true
endfunction
function Trig_BOSS30_Die_Actions takes nothing returns nothing
call DisplayTextToForce(GetPlayersAll(),"|cFF52EDF1Призванный босс 30 уровня погибает и на землю падает предмет \\\"Солнечные доспехи\\\"!")
set udg_point=GetUnitLoc(udg_BOSS30)
call CreateItemLoc('I08K',udg_point)
call RemoveLocation(udg_point)
call DestroyTrigger(gg_trg_BOSS30_Attacks)
call DestroyTrigger(GetTriggeringTrigger())
endfunction
