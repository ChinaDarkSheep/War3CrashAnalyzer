function SSkills_Golem takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer ID=LoadInteger(udg_hash,ht,0)
local real x=LoadReal(udg_hash,ht,1)
local real y=LoadReal(udg_hash,ht,2)
local integer a
local real r
local real dmg
local real hp
local unit u=CreateUnit(Player(ID-1),'n05V',x,y,0)
local integer h=GetHandleId(u)
local integer iuu=SeekFreeUnit(h)
call UnitApplyTimedLife(u,'BTLF',25.)
call UnitAddAbility(u,'A05D')
call UnitAddAbility(u,'A0LN')
set a=GetPlayerTechCount(Player(ID-1),'R02Y',true)
set r=(GetHeroAgi(udg_Hero[ID],true)/5+s__Units_Arm[sUnit[LoadInteger(Hash,GetHandleId(udg_Hero[ID]),0)]])
set r=r*(0.1+0.01*a)
set a=GetPlayerTechCount(Player(ID-1),'R02V',true)
set dmg=Summ_Attack(udg_Hero[ID])*(0.3+0.02*a)
set a=GetPlayerTechCount(Player(ID-1),'R01Z',true)
set hp=GetUnitState(udg_Hero[ID],UNIT_STATE_MAX_LIFE)*(0.9+0.03*a)+500*a
if udg_SMission[1]>=udg_SMission[2]then
set dmg=1.4*dmg
endif
set s__Units_HP[sUnit[iuu]]=s__Units_HP[sUnit[iuu]]+R2I(hp)
set s__Units_GAttack[sUnit[iuu]]=s__Units_GAttack[sUnit[iuu]]+R2I(dmg)
set s__Units_Arm[sUnit[iuu]]=s__Units_Arm[sUnit[iuu]]+R2I(r)
call F_hp(u,s__Units_HP[sUnit[iuu]])
call F_Armore(u,s__Units_Arm[sUnit[iuu]])
call F_Attack(u,s__Units_GAttack[sUnit[iuu]])
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set t=null
set u=null
endfunction
function Trig_SSkills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer h
local integer iuu
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local unit u
local timer t
local integer ht
local integer a
local real dmg
local real hp
local real r
local real x
local real y
local real x1
local real y1
if GetSpellAbilityId()=='A0L9' then
set dmg=GetUnitState(caster,UNIT_STATE_MANA)/2.+0.25*(GetHeroStr(udg_Hero[ID],true)+GetHeroInt(udg_Hero[ID],true))
if GetUnitTypeId(GetSpellTargetUnit())=='u01C' then
set dmg=3*dmg
endif
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",GetSpellTargetUnit(),"origin")
call DestroyEffect(bj_lastCreatedEffect)
call SetUnitState(GetSpellTargetUnit(),UNIT_STATE_LIFE,GetUnitState(GetSpellTargetUnit(),UNIT_STATE_LIFE)+dmg)
call SetUnitState(caster,UNIT_STATE_MANA,GetUnitState(caster,UNIT_STATE_MANA)-0.1*GetUnitState(caster,UNIT_STATE_MAX_MANA))
endif
if GetSpellAbilityId()=='A0LC' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set dmg=200+0.25*(GetHeroStr(udg_Hero[ID],true)+GetHeroInt(udg_Hero[ID],true))
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
call GroupDamage(x,y,300,caster,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
endif
if GetSpellAbilityId()=='A0CM' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set u=CreateUnit(Player(ID-1),'nfgt',x,y,0)
set h=GetHandleId(u)
set iuu=SeekFreeUnit(h)
call UnitApplyTimedLife(u,'BTLF',50.)
call UnitAddAbility(u,'A05D')
call UnitAddAbility(u,'A0LN')
set a=GetPlayerTechCount(Player(ID-1),'R02Y',true)
set r=(GetHeroAgi(udg_Hero[ID],true)/5+s__Units_Arm[sUnit[LoadInteger(Hash,GetHandleId(udg_Hero[ID]),0)]])
set r=r*(0.1+0.01*a)
set a=GetPlayerTechCount(Player(ID-1),'R02V',true)
set dmg=Summ_Attack(udg_Hero[ID])*(0.15+0.01*a)
set a=GetPlayerTechCount(Player(ID-1),'R01Z',true)
set hp=GetUnitState(udg_Hero[ID],UNIT_STATE_MAX_LIFE)*(0.4+0.01*a)+200*a
if udg_SMission[1]>=udg_SMission[2]then
set dmg=1.4*dmg
endif
set s__Units_HP[sUnit[iuu]]=s__Units_HP[sUnit[iuu]]+R2I(hp)
set s__Units_GAttack[sUnit[iuu]]=s__Units_GAttack[sUnit[iuu]]+R2I(dmg)
set s__Units_Arm[sUnit[iuu]]=s__Units_Arm[sUnit[iuu]]+R2I(r)
call F_hp(u,s__Units_HP[sUnit[iuu]])
call F_Armore(u,s__Units_Arm[sUnit[iuu]])
call F_Attack(u,s__Units_GAttack[sUnit[iuu]])
endif
if GetSpellAbilityId()=='A0LE' then
set u=GetSpellTargetUnit()
if GetUnitAbilityLevel(u,'A0LH')==0 then
call UnitAddAbility(u,'A0LH')
call SetUnitAbilityLevel(u,'A0LH',1)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call TimerStart(t,16,false,function SSkills_Curse)
else
call SetUnitAbilityLevel(u,'A0LH',GetUnitAbilityLevel(u,'A0LH')+1)
endif
endif
if GetSpellAbilityId()=='A0LG' then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveInteger(udg_hash,ht,0,ID)
call SaveReal(udg_hash,ht,1,GetSpellTargetX())
call SaveReal(udg_hash,ht,2,GetSpellTargetY())
call TimerStart(t,1,false,function SSkills_Golem)
endif
if GetSpellAbilityId()=='A197' then
set x=GetUnitX(caster)+150*Cos(GetUnitFacing(caster)*bj_DEGTORAD)
set y=GetUnitY(caster)+150*Sin(GetUnitFacing(caster)*bj_DEGTORAD)
set bj_lastCreatedEffect=AddSpecialEffect("Objects\\Spawnmodels\\Orc\\OrcSmallDeathExplode\\OrcSmallDeathExplode.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
set a=GetPlayerTechCount(Player(ID-1),'R02Y',true)
set r=(GetHeroAgi(udg_Hero[ID],true)/5+s__Units_Arm[sUnit[LoadInteger(Hash,GetHandleId(udg_Hero[ID]),0)]])
set r=r*(0.1+0.01*a)
set a=GetPlayerTechCount(Player(ID-1),'R02V',true)
set dmg=Summ_Attack(udg_Hero[ID])*(0.15+0.01*a)
set a=GetPlayerTechCount(Player(ID-1),'R01Z',true)
set hp=GetUnitState(udg_Hero[ID],UNIT_STATE_MAX_LIFE)*(0.4+0.01*a)+200*a
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
set u=CreateUnit(Player(ID-1),'u01D',x,y,0.)
set h=GetHandleId(u)
set iuu=SeekFreeUnit(h)
call UnitAddAbility(u,'A0LN')
set s__Units_HP[sUnit[iuu]]=s__Units_HP[sUnit[iuu]]+R2I(hp)
set s__Units_GAttack[sUnit[iuu]]=s__Units_GAttack[sUnit[iuu]]+R2I(dmg)
set s__Units_Arm[sUnit[iuu]]=s__Units_Arm[sUnit[iuu]]+R2I(r)
call F_hp(u,s__Units_HP[sUnit[iuu]])
call F_Armore(u,s__Units_Arm[sUnit[iuu]])
call F_Attack(u,s__Units_GAttack[sUnit[iuu]])
call UnitApplyTimedLife(u,'BTLF',36)
set u=CreateUnit(Player(ID-1),'u01D',x,y,0.)
set h=GetHandleId(u)
set iuu=SeekFreeUnit(h)
call UnitAddAbility(u,'A0LN')
set s__Units_HP[sUnit[iuu]]=s__Units_HP[sUnit[iuu]]+R2I(hp)
set s__Units_GAttack[sUnit[iuu]]=s__Units_GAttack[sUnit[iuu]]+R2I(dmg)
set s__Units_Arm[sUnit[iuu]]=s__Units_Arm[sUnit[iuu]]+R2I(r)
call F_hp(u,s__Units_HP[sUnit[iuu]])
call F_Armore(u,s__Units_Arm[sUnit[iuu]])
call F_Attack(u,s__Units_GAttack[sUnit[iuu]])
call UnitApplyTimedLife(u,'BTLF',36)
endif
if GetSpellAbilityId()=='A0LA' then
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\Orc\\OrcSmallDeathExplode\\OrcSmallDeathExplode.mdl",GetSpellTargetUnit(),"origin")
call DestroyEffect(bj_lastCreatedEffect)
set dmg=GetUnitState(caster,UNIT_STATE_MAX_MANA)*0.75+0.5*GetHeroInt(udg_Hero[ID],true)
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+dmg)
call UnitDamageTarget(caster,GetSpellTargetUnit(),dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
if GetSpellAbilityId()=='A0LJ' then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl",GetSpellTargetUnit(),"origin")
call DestroyEffect(bj_lastCreatedEffect)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
set dmg=GetUnitState(caster,UNIT_STATE_MAX_MANA)+0.25*GetUnitState(caster,UNIT_STATE_LIFE)
call UnitDamageTarget(caster,GetSpellTargetUnit(),dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
