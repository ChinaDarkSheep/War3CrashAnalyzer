function Trig_Create2_Actions takes nothing returns nothing
local integer r=GetRandomInt(1,4)
local real x=GetRectCenterX(gg_rct_BossPlace)
local real y=GetRectCenterY(gg_rct_BossPlace)
local real angle
local real mx
local real my
local integer i
set bj_lastCreatedUnit=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),udg_Boss2UnitId[r],x,y,90.)
set udg_BOSS30=bj_lastCreatedUnit
call UnitAddAbility(udg_BOSS30,'A0KR')
call UnitAddAbility(udg_BOSS30,'A0FB')
set i=1
loop
exitwhen i>4
set angle=(180.-i*45.)*bj_DEGTORAD
set mx=x+300.*Cos(angle)
set my=y+300.*Sin(angle)
call CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),udg_Boss2MinionId[r],mx,my,90.)
set i=i+1
endloop
set i=1
loop
exitwhen i>8
set angle=i*45.*bj_DEGTORAD
set mx=x+256.*Cos(angle)
set my=y+256.*Sin(angle)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl",mx,my))
set i=i+1
endloop
call EnableTrigger(gg_trg_BOSS30_Attacks)
call EnableTrigger(gg_trg_BOSS30_Die)
endfunction
function InitTrig_Create2 takes nothing returns nothing
set gg_trg_Create2=CreateTrigger()
call DisableTrigger(gg_trg_Create2)
call TriggerAddAction(gg_trg_Create2,function Trig_Create2_Actions)
call InitBoss2Ids()
endfunction
