function Trig_Recruting_Orc_Actions takes nothing returns nothing
if GetUnitTypeId(GetTrainedUnit())=='o00O' or GetUnitTypeId(GetTrainedUnit())=='o00P' then
set udg_Warboss=GetTrainedUnit()
call SeekFreeUnit(GetHandleId(udg_Warboss))
call GroupAddUnitSimple(udg_Warboss,udg_UnordinaryUnit)
call UnitAddAbilityBJ('A007',udg_Warboss)
call SetUnitScalePercent(udg_Warboss,((I2R(udg_BilderQuestOrc[1])*5.00)+100.00),((I2R(udg_BilderQuestOrc[1])*5.00)+100.00),((I2R(udg_BilderQuestOrc[1])*5.00)+100.00))
if GetPlayerTechCountSimple('R03X',GetOwningPlayer(udg_Warboss))==1 then
call SetUnitAbilityLevelSwapped('A133',udg_Warboss,2)
call SetUnitAbilityLevelSwapped('A134',udg_Warboss,2)
call UnitAddItemByIdSwapped('I0CI',udg_Warboss)
call UnitAddItemByIdSwapped('I0CI',udg_Warboss)
else
endif
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=udg_BilderQuestOrc[1]
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call UnitAddItemByIdSwapped('I04V',udg_Warboss)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set udg_Drop=GetPlayerTechCountSimple('R042',GetOwningPlayer(udg_Orc))
if udg_Drop>0 then
call UnitAddAbilityBJ('A007',udg_Warboss)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=udg_Drop
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call UnitAddItemByIdSwapped('I04V',udg_Warboss)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
else
endif
if GetPlayerTechCountSimple('R043',GetOwningPlayer(udg_Warboss))==1 then
call SetUnitAbilityLevelSwapped('A12Q',udg_Warboss,2)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=udg_BilderQuestOrc[1]
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call UnitAddItemByIdSwapped('I04V',udg_Warboss)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
else
endif
call UnitRemoveAbilityBJ('A007',udg_Warboss)
else
endif
endfunction
