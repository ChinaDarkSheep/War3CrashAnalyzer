function Trig_MurkySkills_Q takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,h,0)
local integer time=LoadInteger(udg_hash,h,1)
local group g=LoadGroupHandle(udg_hash,h,2)
local real heal=LoadReal(udg_hash,h,3)
local player pl=GetOwningPlayer(hero)
local real dmg=1.5*heal
local unit u
local group g2=CreateGroup()
if time<=0 then
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,h)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitRemoveAbility(u,'A0RY')
call GroupRemoveUnit(g,u)
endloop
else
set time=time-1
call SaveInteger(udg_hash,h,1,time)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)then
if IsUnitAlly(u,pl)then
call Heal(true,heal,u,hero)
else
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
call GroupAddUnit(g2,u)
else
call UnitRemoveAbility(u,'A0RY')
endif
call GroupRemoveUnit(g,u)
endloop
call SaveGroupHandle(udg_hash,h,2,g2)
endif
call DestroyGroup(g)
set g=null
set g2=null
set hero=null
set u=null
set pl=null
set t=null
endfunction
function Trig_MurkySkills_W takes nothing returns nothing
