function InitTrig_KillPeon takes nothing returns nothing
set gg_trg_KillPeon=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_KillPeon,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddAction(gg_trg_KillPeon,function Trig_KillPeon_Actions)
endfunction
function Trig_Swap_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer id=GetPlayerId(GetOwningPlayer(caster))
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local integer gold=0
local integer a=0
local integer b
local integer lvl=GetItemLevel(UnitItemInSlotBJ(caster,1))
if GetUnitAbilityLevel(caster,'A0YG')==1 then
if GetSpellAbilityId()=='A12A' then
set gold=50000
if GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)>=gold then
if GetRandomInt(1,2)==1 then
set a=GetRandomInt(5,75)*100
call SetPlayerStateBJ(Player(id),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)+a)
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],15.,"|cFF07EDE6Вам вернули "+I2S(a)+" золота!")
endif
call SetPlayerStateBJ(Player(id),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)-gold)
call UnitAddItemByIdSwapped('I08Z',GetSpellAbilityUnit())
call UnitRemoveAbilityBJ('A0YG',GetSpellAbilityUnit())
else
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],15.00,"|cFFBB0000Не хватает золота на покупку.")
endif
elseif GetSpellAbilityId()=='A123' then
set gold=50000
if GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)>=gold then
if GetRandomInt(1,2)==1 then
set a=GetRandomInt(5,75)*100
call SetPlayerStateBJ(Player(id),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)+a)
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],15.,"|cFF07EDE6Вам вернули "+I2S(a)+" золота!")
endif
call SetPlayerStateBJ(Player(id),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)-gold)
call UnitAddItemByIdSwapped('I09A',GetSpellAbilityUnit())
call UnitRemoveAbilityBJ('A0YG',GetSpellAbilityUnit())
else
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],15.00,"|cFFBB0000Не хватает золота на покупку.")
endif
elseif GetSpellAbilityId()=='A10F' then
set gold=50000
if GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)>=gold then
if GetRandomInt(1,2)==1 then
set a=GetRandomInt(5,50)*100
call SetPlayerStateBJ(Player(id),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)+a)
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],15.,"|cFF07EDE6Вам вернули "+I2S(a)+" золота!")
endif
call SetPlayerStateBJ(Player(id),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)-gold)
call UnitAddItemByIdSwapped('I093',GetSpellAbilityUnit())
call UnitRemoveAbilityBJ('A0YG',GetSpellAbilityUnit())
else
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],15.00,"|cFFBB0000Не хватает золота на покупку.")
endif
