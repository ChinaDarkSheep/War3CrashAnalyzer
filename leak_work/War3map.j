local real y=GetUnitY(GetTriggerUnit())
local real y1
local real x1
local integer a=0
local real r
loop
exitwhen a==10
set r=GetRandomReal(0,360)*bj_DEGTORAD
set x1=x+100*Cos(r)
set y1=y+100*Sin(r)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",x1,y1))
set bj_lastCreatedUnit=CreateUnit(Player(10),'u00T',x1,y1,GetRandomReal(0,360))
