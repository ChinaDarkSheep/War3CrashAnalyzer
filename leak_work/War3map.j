set bj_lastCreatedUnit=CreateUnit(ForcePickRandomPlayer(udg_CreepsPlayers),udg_EnemyType[GetRandomInt(1,2)],RandomSpawnX[udg_Drop],RandomSpawnY[udg_Drop],bj_UNIT_FACING)
call GroupAddUnit(udg_A3,bj_lastCreatedUnit)
