function Trig_SkillsBuilder1_A098Exp takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit u=LoadUnitHandle(udg_hash,ht,0)
local integer pid=LoadInteger(udg_hash,ht,1)
call ModifyHeroStat(bj_HEROSTAT_INT,u,bj_MODIFYMETHOD_SUB,5)
set udg_MagichkaInt[pid]=(udg_MagichkaInt[pid]-5)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
set u=null
endfunction
function Trig_SkillsBuilder1_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local unit u
local integer h
local real damage
local real x
local real y
local trigger endCast
local timer t
local integer ht
local integer a
if GetSpellAbilityId()=='A098' then
set u=GetSpellTargetUnit()
call ModifyHeroStat(bj_HEROSTAT_INT,u,bj_MODIFYMETHOD_ADD,5)
set a=GetConvertedPlayerId(GetOwningPlayer(GetSpellTargetUnit()))
set udg_MagichkaInt[a]=(udg_MagichkaInt[a]+5)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call SaveInteger(udg_hash,ht,1,a)
call TimerStart(t,20.00,false,function Trig_SkillsBuilder1_A098Exp)
endif
if GetSpellAbilityId()=='A02Q' and GetOwningPlayer(GetTriggerUnit())==GetOwningPlayer(udg_HumanBuilder)and udg_BilderQuestAl[22]==2 then
call SetUnitLifeBJ(GetSpellTargetUnit(),(GetUnitStateSwap(UNIT_STATE_LIFE,GetSpellTargetUnit())+(1.00*I2R(GetHeroStatBJ(bj_HEROSTAT_INT,udg_HumanBuilder,true)))))
else
endif
if GetSpellAbilityId()=='A16H' then
call UnitDamageTargetBJ(GetSpellAbilityUnit(),GetSpellTargetUnit(),(I2R(GetHeroStatBJ(bj_HEROSTAT_INT,udg_HumanBuilder,true))*4.00),ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
endif
if GetSpellAbilityId()=='Ahea' then
set u=GetSpellTargetUnit()
set damage=0
if GetPlayerTechCount(GetOwningPlayer(caster),'Rhpt',true)>=3 then
set damage=damage+75
endif
if udg_BilderQuestAl[24]==5 then
set y=GetUnitState(u,UNIT_STATE_MAX_LIFE)/100
if IsUnitType(caster,UNIT_TYPE_HERO)then
set x=0.25
else
set x=0.5
endif
set damage=damage+x*y
endif
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+damage)
endif
set u=null
set caster=null
set t=null
endfunction
