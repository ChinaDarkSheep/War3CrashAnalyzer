function Trig_PickItems_Actions takes nothing returns nothing
local integer ID=GetPlayerId(GetOwningPlayer(GetTriggerUnit()))+1
local integer hi
local item SpellItem=GetSpellTargetItem()
local integer Lvl
local integer drop=0
local integer a
local integer id=GetPlayerId(GetOwningPlayer(GetSpellAbilityUnit()))+1
local real x=GetUnitX(udg_Circle[id])
local real y=GetUnitY(udg_Circle[id])
local boolean pick=false
local integer idi=LoadInteger(Hash,GetItemTypeId(SpellItem),Hash_ItId)
if GetItemTypeId(SpellItem)!='I09I' then
if GetSpellAbilityId()=='A0KH' or GetSpellAbilityId()=='A0KI' then
if s__SItem_SpecStatID[sItem[idi]]>=100 and s__SItem_SpecStatID[sItem[idi]]<200 then
set pick=true
set drop=GetItemCharges(SpellItem)
if drop>1 then
if UnitHasItemOfTypeBJ(udg_Trophy_build[ID],GetItemTypeId(SpellItem))then
call SetItemCharges(GetItemOfTypeFromUnitBJ(udg_Trophy_build[ID],GetItemTypeId(SpellItem)),GetItemCharges(GetItemOfTypeFromUnitBJ(udg_Trophy_build[ID],GetItemTypeId(SpellItem)))+drop)
set hi=GetHandleId(GetItemOfTypeFromUnitBJ(udg_Trophy_build[ID],GetItemTypeId(SpellItem)))
else
set bj_lastCreatedItem=CreateItem(GetItemTypeId(SpellItem),GetUnitX(udg_Trophy_build[ID]),GetUnitY(udg_Trophy_build[ID]))
call UnitAddItem(udg_Trophy_build[ID],bj_lastCreatedItem)
set hi=GetHandleId(bj_lastCreatedItem)
call SetItemCharges(bj_lastCreatedItem,drop)
endif
else
set bj_lastCreatedItem=CreateItem(GetItemTypeId(SpellItem),GetUnitX(udg_Trophy_build[ID]),GetUnitY(udg_Trophy_build[ID]))
call UnitAddItem(udg_Trophy_build[ID],bj_lastCreatedItem)
set hi=GetHandleId(bj_lastCreatedItem)
call SetItemCharges(bj_lastCreatedItem,drop)
endif
call RemoveItem(SpellItem)
else
set pick=true
set drop=GetItemCharges(SpellItem)
if drop>1 then
if UnitHasItemOfTypeBJ(udg_Hero[id],GetItemTypeId(SpellItem))then
call SetItemCharges(GetItemOfTypeFromUnitBJ(udg_Hero[id],GetItemTypeId(SpellItem)),GetItemCharges(GetItemOfTypeFromUnitBJ(udg_Hero[id],GetItemTypeId(SpellItem)))+drop)
set hi=GetHandleId(GetItemOfTypeFromUnitBJ(udg_Hero[id],GetItemTypeId(SpellItem)))
else
set bj_lastCreatedItem=CreateItem(GetItemTypeId(SpellItem),GetUnitX(udg_Hero[id]),GetUnitY(udg_Hero[id]))
call UnitAddItem(udg_Hero[id],bj_lastCreatedItem)
set hi=GetHandleId(bj_lastCreatedItem)
call SetItemCharges(bj_lastCreatedItem,drop)
endif
else
set bj_lastCreatedItem=CreateItem(GetItemTypeId(SpellItem),GetUnitX(udg_Hero[id]),GetUnitY(udg_Hero[id]))
call UnitAddItem(udg_Hero[id],bj_lastCreatedItem)
set hi=GetHandleId(bj_lastCreatedItem)
call SetItemCharges(bj_lastCreatedItem,drop)
endif
call RemoveItem(SpellItem)
endif
elseif GetSpellAbilityId()=='A0KJ' then
set pick=true
set drop=GetItemCharges(SpellItem)
if drop>1 then
if UnitHasItemOfTypeBJ(udg_Circle[id],GetItemTypeId(SpellItem))then
call SetItemCharges(GetItemOfTypeFromUnitBJ(udg_Circle[id],GetItemTypeId(SpellItem)),GetItemCharges(GetItemOfTypeFromUnitBJ(udg_Circle[id],GetItemTypeId(SpellItem)))+drop)
set hi=GetHandleId(GetItemOfTypeFromUnitBJ(udg_Circle[id],GetItemTypeId(SpellItem)))
else
set bj_lastCreatedItem=CreateItem(GetItemTypeId(SpellItem),GetUnitX(udg_Circle[id]),GetUnitY(udg_Circle[id]))
call UnitAddItem(udg_Circle[id],bj_lastCreatedItem)
set hi=GetHandleId(bj_lastCreatedItem)
call SetItemCharges(bj_lastCreatedItem,drop)
endif
else
set bj_lastCreatedItem=CreateItem(GetItemTypeId(SpellItem),GetUnitX(udg_Circle[id]),GetUnitY(udg_Circle[id]))
call UnitAddItem(udg_Circle[id],bj_lastCreatedItem)
set hi=GetHandleId(bj_lastCreatedItem)
call SetItemCharges(bj_lastCreatedItem,drop)
endif
call RemoveItem(SpellItem)
endif
if pick==true then
set pick_item[ID]=false
if GetLocalPlayer()==Player(ID-1)then
call ClearSelection()
call SelectUnit(udg_Hero[ID],true)
endif
if LoadBoolean(udg_hash,GetHandleId(pick_unit[ID]),StringHash("save"))==true then
call SaveInteger(udg_hash,hi,StringHash("Owner"),ID)
endif
call ShowUnit(pick_unit[ID],false)
call SaveBoolean(udg_hash,GetHandleId(pick_unit[ID]),StringHash("save"),false)
set a=0
loop
exitwhen a==6
if UnitItemInSlot(pick_unit[ID],a)!=SpellItem and UnitItemInSlot(pick_unit[ID],a)!=null then
call RemoveItem(UnitItemInSlot(pick_unit[ID],a))
endif
set a=a+1
endloop
endif
endif
set SpellItem=null
endfunction
function InitTrig_PickItems takes nothing returns nothing
set gg_trg_PickItems=CreateTrigger()
call TriggerAddAction(gg_trg_PickItems,function Trig_PickItems_Actions)
endfunction
function UseSkillJas_Enum takes nothing returns nothing
