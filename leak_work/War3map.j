function CreepsAtk_StarBoss takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit boss=LoadUnitHandle(udg_hash,ht,0)
local integer IDA=GetPlayerId(GetOwningPlayer(boss))+1
local integer sec=LoadInteger(udg_hash,ht,0)
local group g=CreateGroup()
local unit u
local real dmg=1+0.03*s__SetTechUP[IDA-1]
local real x=GetUnitX(boss)
local real y=GetUnitY(boss)
local real x1
local real y1
local real r
local integer a
local integer b
if sec>0 then
set dmg=(starkills*starkills/200+starkills)*4+dmg*80
if sec==3 then
set b=5
set r=200
elseif sec==2 then
set b=7
set r=400
else
set b=10
set r=600
endif
set a=1
loop
exitwhen a>b
set x1=x+r*Cos((GetUnitFacing(boss)+360*a/b)*bj_DEGTORAD)
set y1=y+r*Sin((GetUnitFacing(boss)+360*a/b)*bj_DEGTORAD)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl",x1,y1)
call DestroyEffect(bj_lastCreatedEffect)
set udg_Drop2=IDA-1
call GroupEnumUnitsInRange(g,x1,y1,185,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(boss,u,dmg,true,true,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(boss,u,dmg,true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
set a=a+1
endloop
set sec=sec-1
call SaveInteger(udg_hash,ht,0,sec)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
call DestroyGroup(g)
set t=null
set boss=null
set g=null
endfunction
function Trig_CreepsAtk_Actions takes nothing returns nothing
local unit target=GetTriggerUnit()
local unit attack=GetAttacker()
local integer UTattack=GetUnitTypeId(attack)
local integer IDT=GetPlayerId(GetOwningPlayer(target))+1
local integer IDA=GetPlayerId(GetOwningPlayer(attack))+1
local real power=1.+0.02*s__SetTechUP[IDA-1]
local real fullpower=1+0.04*s__SetTechUP[IDA-1]
local unit dummy
local unit u
local unit hero
local timer t
local timer t2
local integer ht
local integer i
local integer a
local integer b
local real x
local real y
local real xa=GetUnitX(attack)
local real ya=GetUnitY(attack)
local real xt=GetUnitX(target)
local real yt=GetUnitY(target)
local real dmg
local real r
local group g=CreateGroup()
if Player(IDA-1)!=GetOwningPlayer(target)then
if IsUnitAlly(target,Player(IDA-1))then
if IsUnitType(target,UNIT_TYPE_HERO)or GetUnitTypeId(target)=='h04A' or target==gg_unit_htow_0002 or target==gg_unit_harm_0390 or target==gg_unit_h005_0249 then
call IssueImmediateOrder(attack,"stop")
else
set udg_FriendFire[IDA]=udg_FriendFire[IDA]+50
call DisplayTextToForce(bj_FORCE_PLAYER[IDA-1],"Получен урон за попытку атаковать союзника - "+I2S(udg_FriendFire[IDA]))
call UnitDamageTarget(target,attack,udg_FriendFire[IDA],false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
elseif target==gg_unit_htow_0002 and not IsUnitAlly(target,Player(IDA-1))then
call PingMinimapForForceEx(bj_FORCE_ALL_PLAYERS,GetUnitX(gg_unit_htow_0002),GetUnitY(gg_unit_htow_0002),3.,bj_MINIMAPPINGSTYLE_ATTACK,100,0.,0.)
endif
endif
if IDA<=8 and udg_AbuseAttack[IDA]<=0 then
if UTattack=='u01M' then
set dmg=GetUnitAbilityLevel(udg_Hero[IDA],'A0NI')*40+0.1*Summ_Attack(udg_Hero[IDA])
call UnitDamageTarget(udg_Hero[IDA],target,dmg,false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
set b=GetHandleId(udg_Hero[IDA])
if GetUnitAbilityLevel(attack,'A09G')==1 and not LoadBoolean(udg_hash,b,StringHash("Vzik"))then
call CreateTextTagUnitBJ("Вжик-вжик",attack,0,10.,100.,50.,50.,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.,GetRandomReal(80.,120.))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.)
call SetTextTagFadepointBJ(udg_TEXT,2.)
set dmg=GetUnitState(attack,UNIT_STATE_MAX_LIFE)/20+GetHeroInt(udg_Hero[IDA],true)/4
set udg_Drop2=IDA-1
call GroupEnumUnitsInRange(g,xa,ya,250,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(attack,u,dmg,false,true,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Critters\\Albatross\\CritterBloodAlbatross.mdl",u,"origin"))
call GroupRemoveUnit(g,u)
endloop
call Func_CD(udg_Hero[IDA],"Vzik",0.25)
endif
else
if IDA>8 and IDT !=10 then
if UTattack=='e00J' then
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>12
set dmg=GetRandomReal(70.,350.)
set r=GetRandomReal(0.,360.)
set x=xt+dmg*Cos(r*bj_DEGTORAD)
set y=yt+dmg*Sin(r*bj_DEGTORAD)
set bj_lastCreatedUnit=CreateUnit(Player(IDA-1),'h02Z',xa,ya,GetUnitFacing(attack))
call IssuePointOrder(bj_lastCreatedUnit,"attackground",x,y)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',.75)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
if UTattack=='h047' then
if IsUnitInGroup(attack,udg_ZavodCheck)==false then
set udg_Drop2=IDA-1
call GroupEnumUnitsInRange(g,xa,ya,375,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitType(u,UNIT_TYPE_STRUCTURE)then
set r=0.25
else
set r=1.
endif
call UnitDamageTarget(attack,u,35+r*.006*GetUnitState(u,UNIT_STATE_MAX_LIFE),false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(attack,u,150+r*.02*GetUnitState(u,UNIT_STATE_MAX_LIFE),false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(attack,u,1000+r*.1*GetUnitState(u,UNIT_STATE_MAX_LIFE),true,true,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
call Func_CD_UG(attack,udg_ZavodCheck,4)
else
if IsUnitType(target,UNIT_TYPE_STRUCTURE)then
set r=0.25
else
set r=1.
endif
call UnitDamageTarget(attack,target,(35+r*.006*GetUnitState(target,UNIT_STATE_MAX_LIFE))/3,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(attack,target,(150+r*.02*GetUnitState(target,UNIT_STATE_MAX_LIFE))/3,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(attack,target,(1000+r*.1*GetUnitState(target,UNIT_STATE_MAX_LIFE))/3,true,true,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
endif
if helldmg>0 then
set udg_noSplash=true
set r=GetUnitState(target,UNIT_STATE_MAX_LIFE)
if r>22000 then
set dmg=24.764+(r-22000)/525
else
if r>12000 then
set dmg=13.+(r-12000)/850
else
set dmg=1.+r/1000
endif
endif
set i=GetUnitAbilityLevel(attack,'A0Z3')
set dmg=dmg*(1+i*i)
if i==0 and GetUnitLevel(target)>=15 and ModuloInteger(GetUnitLevel(target),5)==0 then
if GetUnitLevel(target)>=30 then
set dmg=dmg*4
else
set dmg=dmg*2
endif
endif
set dmg=dmg*helldmg*(1-udg_HelldamageNEW[IDT])
call UnitDamageTarget(attack,target,dmg,true,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
set udg_noSplash=false
endif
endif
endif
if IDA<=8 then
if UTattack=='e000' and target !=udg_TargetTree then
set udg_TargetTree=target
endif
if UTattack=='h026' then
set dmg=GetUnitAbilityLevel(udg_Hero[IDA],'A0AN')*10+GetHeroStr(udg_Hero[IDA],true)/5
if udg_Talante[IDA]==1 then
set dmg=dmg+0.1*Summ_Attack(udg_Hero[IDA])
endif
call UnitDamageTarget(udg_Hero[IDA],target,dmg,true,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
endif
if UTattack=='u01C' and IsUnitEnemy(target,Player(IDA-1))then
if udg_SReligion[IDA]==2 then
set dmg=(0.1+0.02*GetPlayerTechCount(Player(IDA-1),'R02V',true))*Summ_Attack(udg_Hero[IDA])
set udg_Drop2=IDA-1
call GroupEnumUnitsInRange(g,xt,yt,275.,Bool_Filter_ID)
call GroupRemoveUnit(g,target)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(attack,u,dmg,true,true,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
endif
endif
elseif IDA>8 then
if UTattack=='echm' and IsUnitInGroup(attack,udg_ZavodCheck)==false then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,attack)
call SaveInteger(udg_hash,ht,0,3)
call TimerStart(t,0.4,true,function CreepsAtk_StarBoss)
call Func_CD_UG(attack,udg_ZavodCheck,10)
endif
if UTattack=='even' and IsUnitInGroup(attack,udg_ZavodCheck)==false then
set dmg=(starkills*starkills/150+starkills)*6+fullpower*80
call Func_CD_UG(attack,udg_ZavodCheck,6)
call GroupDamage_e(xa,ya,675.,attack,true,dmg,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,"Abilities\\Spells\\NightElf\\Starfall\\StarfallTarget.mdl")
endif
if UTattack=='n04G' then
set dmg=10*power
call UnitDamageTarget(attack,target,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
if udg_HellLaw then
if UTattack=='h04N' then
if GetRandomInt(1,10)==1 then
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIlb\\AIlbSpecialArt.mdl",target,"origin")
call DestroyEffect(bj_lastCreatedEffect)
call UnitDamageTarget(attack,target,500,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
endif
if UTattack=='u027' and GetUnitAbilityLevel(attack,'A10Q')==0 then
call UnitAddAbility(attack,'A10Q')
call UnitDamageTarget(attack,target,250+0.05*GetUnitState(target,UNIT_STATE_MAX_LIFE),false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(attack,target,1000,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set udg_Drop2=IDA-1
call GroupEnumUnitsInRange(g,xt,yt,325.,Bool_Filter_ID)
call GroupRemoveUnit(g,target)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(attack,u,250+0.05*GetUnitState(target,UNIT_STATE_MAX_LIFE),false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(attack,u,1000,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(attack,u,5000,true,true,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl",target,"origin")
call DestroyEffect(bj_lastCreatedEffect)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,attack)
call TimerStart(t,4.,false,function Trig_CreepsAtk_Ktan)
endif
endif
endif
if UTattack=='U01A' then
if udg_HardestLogic then
call UnitDamageTarget(attack,target,30,true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
else
call UnitDamageTarget(attack,target,10,true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
set a=GetHandleId(attack)
if LoadInteger(udg_hash,a,'r')==1 then
call SaveInteger(udg_hash,a,'r',0)
call SetUnitMoveSpeed(attack,GetUnitDefaultMoveSpeed(attack))
endif
call SaveInteger(udg_hash,a,'a',LoadInteger(udg_hash,a,'a')+1)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveInteger(udg_hash,ht,0,a)
call TimerStart(t,.5,false,function MefistoSpeedAtk)
endif
if(GetUnitTypeId(target)=='u00N' and not IsUnitInGroup(target,udg_ZavodCheck))or(UTattack=='u00N' and not IsUnitInGroup(attack,udg_ZavodCheck))then
if GetUnitTypeId(target)=='u00N' then
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(target),'u001',GetUnitX(target),GetUnitY(target),bj_UNIT_FACING)
call AddSpecialEffectTargetUnitBJ("origin",target,"Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl")
call DestroyEffectBJ(bj_lastCreatedEffect)
call Func_CD_UG(target,udg_ZavodCheck,3.)
else
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(attack),'u001',GetUnitX(attack),GetUnitY(attack),bj_UNIT_FACING)
call AddSpecialEffectTargetUnitBJ("origin",attack,"Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl")
call DestroyEffectBJ(bj_lastCreatedEffect)
call Func_CD_UG(attack,udg_ZavodCheck,2.)
endif
endif
if GetUnitTypeId(target)=='n02A' and IsUnitInGroup(target,udg_ZavodCheck)==false then
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(target),'n00R',GetUnitX(target),GetUnitY(target),bj_UNIT_FACING)
call Func_CD_UG(target,udg_ZavodCheck,5.)
endif
if UTattack=='nfrg' and IsUnitInGroup(attack,udg_ZavodCheck)==false and GetPlayerController(GetOwningPlayer(attack))!=MAP_CONTROL_USER then
call IssueImmediateOrderBJ(attack,"berserk")
call Func_CD_UG(attack,udg_ZavodCheck,16.)
endif
if UTattack=='ntks' and IsUnitInGroup(attack,udg_ZavodCheck)==false and IsUnitEnemy(attack,Player(9))==true then
call IssueTargetOrderBJ(attack,"shadowstrike",target)
call Func_CD_UG(attack,udg_ZavodCheck,12.5)
endif
if UTattack=='Ecen' and IsUnitInGroup(attack,udg_ZavodCheck)==false then
call Func_CD_UG(attack,udg_ZavodCheck,32)
set r=bj_RADTODEG*Atan2(yt-ya,xt-xa)
call PauseUnit(attack,true)
call KnockBackUnit2(attack,1050,1.5,r,0.05)
set t2=CreateTimer()
set ht=GetHandleId(t2)
call SaveUnitHandle(udg_hash,ht,0,attack)
call SaveInteger(udg_hash,ht,0,6)
call SaveGroupHandle(udg_hash,ht,1,CreateGroup())
call TimerStart(t2,0.25,true,function CreepsAtk_Kenarius_Damage)
endif
if UTattack=='Nman' then
if not LoadBoolean(udg_hash,GetHandleId(attack),'q')then
call SaveBoolean(udg_hash,GetHandleId(attack),'q',true)
set dmg=5000*power
set x=GetUnitX(target)
set y=GetUnitY(target)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(attack),'h057',x,y,bj_UNIT_FACING)
call SetUnitVertexColor(bj_lastCreatedUnit,255,0,0,255)
call SetUnitScale(bj_lastCreatedUnit,1.8,1.8,1.8)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',3.)
set a=GetHandleId(bj_lastCreatedUnit)
call SaveReal(udg_hash,a,'a',200.)
call SaveReal(udg_hash,a,'d',dmg)
call SaveUnitHandle(udg_hash,a,'u',attack)
call SaveStr(udg_hash,a,'e',"Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl")
set t=CreateTimer()
call SaveUnitHandle(udg_hash,GetHandleId(t),1,attack)
call TimerStart(t,6.,false,function CreepsAtk_Mannorot_Q)
endif
endif
if UTattack=='nefm' or UTattack=='nef0' or UTattack=='nef1' or UTattack=='nef4' then
set x=GetUnitX(target)
set y=GetUnitY(target)
call IssuePointOrder(attack,"clusterrockets",x,y)
set i=LoadInteger(udg_hash,GetHandleId(attack),StringHash("bonusF"))
set hero=udg_Hero[IDA]
if UTattack=='nef0' and LoadBoolean(udg_hash,GetHandleId(attack),StringHash("CDLight"))==false then
set dummy=CreateUnit(GetOwningPlayer(attack),'h05G',GetUnitX(attack),GetUnitY(attack),GetUnitFacing(attack))
if GetHeroLevel(hero)>=50 then
set dmg=20.*GetUnitAbilityLevel(hero,'A1AZ')+2.*GetHeroInt(hero,true)
else
set dmg=20.*GetUnitAbilityLevel(hero,'A1AZ')+GetHeroInt(hero,true)
endif
set a=SeekFreeDummys(dummy,GetHandleId(dummy))
set s__Dummys_dmg[sDummy[a]]=dmg
call UnitAddAbility(dummy,'A1B1')
call SetUnitAbilityLevel(dummy,'A1B1',5)
call IssueTargetOrder(dummy,"chainlightning",target)
call UnitApplyTimedLife(dummy,'BTLF',2.75)
call SaveBoolean(udg_hash,GetHandleId(attack),StringHash("CDLight"),true)
set t=CreateTimer()
call SaveUnitHandle(udg_hash,GetHandleId(t),0,attack)
call TimerStart(t,4.,false,function CreepsAtk_Tower_Lightning)
endif
if i==2 and LoadBoolean(udg_hash,GetHandleId(attack),StringHash("CDF"))==false then
set b=2*GetHeroInt(hero,true)
set a=LoadInteger(Hash,GetHandleId(attack),0)
set s__Units_GAttack[sUnit[a]]=s__Units_GAttack[sUnit[a]]+b
call F_Attack(attack,s__Units_GAttack[sUnit[a]])
call SaveBoolean(udg_hash,GetHandleId(attack),StringHash("CDF"),true)
set t=CreateTimer()
call SaveUnitHandle(udg_hash,GetHandleId(t),0,attack)
call SaveInteger(udg_hash,GetHandleId(t),1,b)
call TimerStart(t,22.,false,function CreepsAtk_Tower_Bonus2)
else
if i==3 and GetRandomInt(1,5)==1 then
set dmg=50.+GetHeroInt(hero,true)
call UnitDamageTarget(attack,target,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
endif
else
if GetUnitTypeId(target)=='nefm' or GetUnitTypeId(target)=='nef0' or GetUnitTypeId(target)=='nef1' or GetUnitTypeId(target)=='nef4' then
set i=LoadInteger(udg_hash,GetHandleId(target),StringHash("bonusF"))
if i==5 then
call UnitDamageTarget(target,attack,0.02*GetUnitState(target,UNIT_STATE_MAX_LIFE),false,true,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
endif
endif
if IsUnitType(attack,UNIT_TYPE_HERO)==false then
if GetUnitAbilityLevel(attack,'A1CU')>0 then
if IsUnitInGroup(attack,udg_UGaoeAttack)==false then
call SetUnitState(attack,UNIT_STATE_LIFE,GetUnitState(attack,UNIT_STATE_LIFE)+0.03*GetUnitState(attack,UNIT_STATE_MAX_LIFE))
set dmg=0.05*GetUnitState(attack,UNIT_STATE_MAX_LIFE)
call GroupDamage_e(xa,ya,225.,attack,false,dmg,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,"Objects\\Spawnmodels\\Orc\\Orcblood\\BattrollBlood.mdl")
call Func_CD_UG(attack,udg_UGaoeAttack,3.)
endif
endif
if UTattack=='ncaw' and IsUnitInGroup(attack,udg_SkillsCheck)==false then
if udg_HardestLogic then
if udg_Mode==2 then
set dmg=1000
else
set dmg=400
endif
else
set dmg=200
endif
call UnitDamageTarget(attack,target,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>8
set x=xa+500*Cos((45*bj_forLoopAIndex)*bj_DEGTORAD)
set y=ya+500*Sin((45*bj_forLoopAIndex)*bj_DEGTORAD)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(attack),'n055',x,y,GetUnitFacing(attack))
set bj_lastCreatedEffect=AddSpecialEffect("Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call Func_CD_UG(attack,udg_SkillsCheck,9.)
endif
endif
if UTattack=='ngzc' then
set dmg=(5*GetHeroLevel(udg_Hero[IDA])+Summ_Attack(udg_Hero[IDA]))/2
if GetUnitAbilityLevel(udg_Hero[IDA],'A1DO')==1 then
set dmg=1.5*dmg
endif
call UnitDamageTarget(udg_Hero[IDA],target,dmg,false,false,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupDamage(xt,yt,225,udg_Hero[IDA],true,dmg,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL)
endif
call DestroyGroup(g)
set target=null
set attack=null
set dummy=null
set u=null
set hero=null
set t=null
set t2=null
set g=null
endfunction
