function Trig_MefistoSummons_Actions takes nothing returns nothing
local integer random=GetRandomInt(1,3)
local real x=GetUnitX(udg_Mefisto)
local real y=GetUnitY(udg_Mefisto)
local real x1
local real y1
local unit u
local integer Loop
if random==1 then
set Loop=1
loop
exitwhen Loop>16
set x1=x+400.*Cos(Loop*22.5*bj_DEGTORAD)
set y1=y+400.*Sin(Loop*22.5*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",x1,y1))
set u=CreateUnit(GetOwningPlayer(udg_Mefisto),'n05S',x1,y1,Loop*22.5)
call GroupAddUnit(udg_A3,u)
set Loop=Loop+1
endloop
elseif random==2 then
if udg_HardestLogic then
set Loop=1
loop
exitwhen Loop>5
set x1=x+250.*Cos(Loop*90.*bj_DEGTORAD)
set y1=y+250.*Sin(Loop*90.*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",x1,y1))
set u=CreateUnit(GetOwningPlayer(udg_Mefisto),'n05T',x1,y1,Loop*90.)
call GroupAddUnit(udg_A3,u)
call SetUnitAbilityLevel(u,'A0KZ',2)
set Loop=Loop+1
endloop
else
set Loop=1
loop
exitwhen Loop>5
set x1=x+250.*Cos(Loop*90.*bj_DEGTORAD)
set y1=y+250.*Sin(Loop*90.*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",x1,y1))
set u=CreateUnit(GetOwningPlayer(udg_Mefisto),'n05T',x1,y1,Loop*90.)
call GroupAddUnit(udg_A3,u)
set Loop=Loop+1
endloop
endif
else
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl",x,y))
set u=CreateUnit(GetOwningPlayer(udg_Mefisto),'n05U',x,y,bj_UNIT_FACING)
call GroupAddUnit(udg_A3,u)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",x,y))
set u=CreateUnit(GetOwningPlayer(udg_Mefisto),'n05T',x,y,bj_UNIT_FACING)
call GroupAddUnit(udg_A3,u)
endif
call ForGroup(udg_A3,function Trig_MoveAttackers_Func003A)
set u=null
endfunction
