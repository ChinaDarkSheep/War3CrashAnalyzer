set butint[i]=11
endif
set i=1
loop
exitwhen i>11
if GetLocalPlayer()==GetTriggerPlayer()then
call MultiboardDisplay(TableNT[i],false)
endif
set i=i+1
endloop
set i=GetPlayerId(GetTriggerPlayer())+1
if butint[i]!=9 then
if GetLocalPlayer()==GetTriggerPlayer()then
call MultiboardDisplay(TableNT[butint[i]],true)
endif
endif
endfunction
