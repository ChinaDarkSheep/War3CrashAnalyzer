local integer Religion=udg_SReligion[ID]
local unit u
local integer h
local real dmg
local real hp
local real r
local integer a
local integer b
local integer iuu
if ID>4 then
set u=CreateUnit(Player(ID-1),'u01C',GetUnitX(udg_Hero[ID]),GetUnitY(udg_Hero[ID])-100,0.)
else
set u=CreateUnit(Player(ID-1),'u01C',GetUnitX(udg_Hero[ID])+100,GetUnitY(udg_Hero[ID]),0.)
endif
set h=GetHandleId(u)
set iuu=SeekFreeUnit(h)
if Religion==1 then
call UnitAddAbility(u,'A0L2')
call UnitAddAbility(u,'A08I')
call UnitAddAbility(u,'A0L9')
call UnitAddAbility(u,'A0LA')
call UnitAddAbility(u,'A0LB')
call UnitAddAbility(u,'A0LC')
call SetUnitVertexColorBJ(u,100,60.00,0.00,0)
elseif Religion==2 then
call UnitAddAbility(u,'A0L3')
call UnitAddAbility(u,'A0L6')
call UnitAddAbility(u,'A0CM')
call UnitAddAbility(u,'A0LE')
call UnitAddAbility(u,'A0LF')
call UnitAddAbility(u,'A0LG')
call SetUnitVertexColorBJ(u,90.00,40.00,90.00,0)
elseif Religion==3 then
call UnitAddAbility(u,'A0L4')
call UnitAddAbility(u,'A0L7')
call UnitAddAbility(u,'A197')
call UnitAddAbility(u,'A0LJ')
call UnitAddAbility(u,'A0LK')
call UnitAddAbility(u,'A0LL')
call SetUnitVertexColorBJ(u,40.00,40.00,40.00,0)
endif
call GroupAddUnit(udg_UnordinaryUnit,u)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
