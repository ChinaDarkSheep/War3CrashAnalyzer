function InitTrig_ItemInc takes nothing returns nothing
call TimerStart(CreateTimer(),0.01,false,function Trig_ItemInc_Actions)
endfunction
function Trig_ItemsTakeJass_Conditions takes nothing returns boolean
if(not(IsUnitType(GetManipulatingUnit(),UNIT_TYPE_HERO)))then
return false
endif
return true
endfunction
function Trig_ItemsTakeJass_Actions takes nothing returns nothing
local item Item=GetManipulatedItem()
local integer i_lvl=GetItemLevel(Item)
local unit u=GetManipulatingUnit()
local integer h=GetHandleId(u)
local integer ID=GetPlayerId(GetOwningPlayer(u))+1
local timer t
local real x
local real y
local real r
local integer a
local string s=LoadStr(udg_hash,GetHandleId(u),2)
local integer ids=ReturnTypeHeroId(GetHandleId(u))
local integer ihh=LoadInteger(udg_hash,h,5)
local integer iuh=LoadInteger(Hash,h,0)
local integer idi=LoadInteger(Hash,GetItemTypeId(Item),Hash_ItId)
if s__SItem_SpecStatID[sItem[idi]]<100 then
call TakeItem(u,idi,1)
endif
if GetUnitTypeId(u)=='U02A' or GetUnitTypeId(u)=='Nbrn' then
if GetItemTypeId(Item)=='I0B5' then
call Func_MageFruit(u,true)
call RemoveItem(Item)
endif
if GetItemTypeId(Item)=='I0AY' then
if GetHeroLevel(u)==70 then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],15.00,"|cFFFFDC00У вас уже 70 уровень")
elseif GetHeroLevel(u)<30 then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],15.00,"|cFFFFDC00Необходим 30 уровень|r")
else
call Reactor(u)
set udg_ReactorAganim[ID]=true
call RemoveItem(Item)
endif
endif
endif
if GetItemTypeId(Item)=='I069' then
call SaveInteger(udg_hash,h,StringHash("GoldSword"),LoadInteger(udg_hash,h,StringHash("GoldSword"))+1)
endif
if GetItemTypeId(Item)=='I0F3' then
call SaveInteger(udg_hash,h,StringHash("RenDuk"),LoadInteger(udg_hash,h,StringHash("RenDuk"))+1)
endif
if GetUnitTypeId(u)=='H01F' or GetUnitTypeId(u)=='O00W' or GetUnitTypeId(u)=='H000' then
if GetItemTypeId(Item)=='I08O' then
call UnitRemoveItem(u,Item)
call RemoveItem(Item)
call UnitAddItemByIdSwapped('I0C9',u)
elseif GetItemTypeId(Item)=='I08G' then
call UnitRemoveItem(u,Item)
call RemoveItem(Item)
call UnitAddItemByIdSwapped('I0D9',u)
elseif GetItemTypeId(Item)=='I09G' then
call UnitRemoveItem(u,Item)
call RemoveItem(Item)
call UnitAddItemByIdSwapped('I0EH',u)
endif
endif
if i_lvl==0 then
if GetItemTypeId(Item)=='I0BE' then
call SaveInteger(udg_hash,h,StringHash("Greed"),LoadInteger(udg_hash,h,StringHash("Greed"))+1)
if LoadInteger(udg_hash,h,StringHash("Greed"))>1 then
call UnitRemoveItem(u,Item)
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],20.00,"Данные предметы нельзя носить вместе!")
endif
endif
if GetItemTypeId(Item)=='I0B1' then
call SaveReal(udg_hash,h,StringHash("SummonAT"),LoadReal(udg_hash,h,StringHash("SummonAT"))+0.15)
endif
if GetItemTypeId(Item)=='I0B8' then
call SaveReal(udg_hash,h,StringHash("SummonHP"),LoadReal(udg_hash,h,StringHash("SummonHP"))+0.2)
endif
if GetItemTypeId(Item)=='I0BJ' then
set s__Units_MageDamage[sUnit[iuh]]=s__Units_MageDamage[sUnit[iuh]]+500
endif
if GetItemTypeId(Item)=='I0BR' then
set AllGold[ID]=AllGold[ID]+0.025
endif
if GetItemTypeId(GetManipulatedItem())=='I0BZ' and not udg_DEItemLogic[2]then
set udg_Drop=2
set udg_DEItemLogic[2]=true
call TriggerExecute(gg_trg_Set_Damage_Item)
endif
elseif i_lvl==3 then
if GetItemTypeId(GetManipulatedItem())=='I09J' then
if s__Heroes_Type[sHero[ids]]==1 or s__Heroes_Type[sHero[ids]]==4 then
else
set a=0
set udg_Drop=0
loop
exitwhen a>5
if IsItemOwned(UnitItemInSlot(u,a))then
set udg_Drop=(udg_Drop+1)
else
endif
set a=a+1
endloop
if udg_Drop<6 then
call UnitAddItemByIdSwapped('I09I',u)
else
call UnitRemoveItemSwapped(Item,u)
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"|cFFED2B27Невозможно подобрать, нужно 2 свободных слота!|r")
endif
endif
endif
elseif i_lvl==4 then
if GetItemTypeId(GetManipulatedItem())=='I06P' then
if s__Heroes_Type[sHero[ids]]==4 and u !=udg_Scorpion then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],5.00,"Ваш герой получает 2 ед. ловкости от эффекта данного предмета")
endif
endif
if GetItemTypeId(Item)=='I07H' then
call SaveReal(udg_hash,h,StringHash("SummonAT"),LoadReal(udg_hash,h,StringHash("SummonAT"))+0.1)
endif
if GetItemTypeId(Item)=='I0DV' then
set s__Heroes_Mech_2Slot[sHero[ids]]=s__Heroes_Mech_2Slot[sHero[ids]]+1
endif
if GetItemTypeId(Item)=='I0EB' then
call SaveReal(udg_hash,h,StringHash("HealUP"),LoadReal(udg_hash,h,StringHash("HealUP"))+0.25)
endif
if GetItemTypeId(GetManipulatedItem())=='I09V' then
set udg_CheckItem=GetManipulatedItem()
if s__Heroes_Type[sHero[ids]]==1 or s__Heroes_Type[sHero[ids]]==4 then
if udg_Mode !=4 then
call GroupAddUnit(udg_AnciestSealGroup,u)
endif
else
set a=0
set udg_Drop=0
loop
exitwhen a>5
if IsItemOwned(UnitItemInSlot(u,a))then
set udg_Drop=(udg_Drop+1)
else
endif
set a=a+1
endloop
if udg_Drop<6 then
if udg_Mode !=4 then
call GroupAddUnit(udg_AnciestSealGroup,u)
endif
call UnitAddItemByIdSwapped('I09I',u)
else
call UnitRemoveItemSwapped(Item,u)
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"|cFFED2B27Невозможно подобрать, нужно 2 свободных слота!|r")
endif
endif
set udg_CheckItem=null
else
endif
elseif i_lvl==6 then
if GetItemTypeId(Item)=='I071' then
set s__Heroes_buyI071[sHero[ids]]=s__Heroes_buyI071[sHero[ids]]+1
endif
