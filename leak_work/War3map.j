call TimerDialogDisplay(bj_lastCreatedTimerDialog,false)
call TimerDialogDisplayForPlayerBJ(true,bj_lastCreatedTimerDialog,Player(id))
call TimerStart(bj_lastStartedTimer,75.,false,function QuestNew_ResetTimerQuest)
set end=true
endif
if end then
call DestroyTimerDialog(td)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set s__Quests_Guild_unlock[sQuest[3]]=s__Quests_Guild_unlock[sQuest[3]]+1
endif
set td=null
set tt=null
set t=null
endfunction
