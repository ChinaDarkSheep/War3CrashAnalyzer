endfunction
function Trig_AtkSpawn1_Actions takes nothing returns nothing
local real x=GetUnitX(GetTriggerUnit())
local real y=GetUnitY(GetTriggerUnit())
local real angle=GetRandomReal(0,360)
local real x1=x+200*Cos(angle*bj_DEGTORAD)
local real y1=y+200*Sin(angle*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",x1,y1))
set bj_lastCreatedUnit=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),'u00L',x1,y1,GetRandomReal(0,360))
call DisableTrigger(GetTriggeringTrigger())
call TimerStart(CreateTimer(),.5,false,function Trig_AtkSpawn1_Wait)
endfunction
