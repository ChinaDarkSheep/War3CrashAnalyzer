function Trig_WitchSkills_Actions takes nothing returns nothing
local unit hero=GetTriggerUnit()
local integer h=GetHandleId(hero)
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local real dmg
local real x
local real y
local real r
local group g=CreateGroup()
local group g2
local unit u
local timer t
local integer ht
if GetSpellAbilityId()=='A0GV' then
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl",hero,"origin")
call DestroyEffect(bj_lastCreatedEffect)
if GetUnitAbilityLevel(hero,'A0GX')==1 then
call PauseTimerBJ(true,udg_WitchDTimer)
call UnitRemoveAbility(hero,'A0GX')
set udg_WitchD=1.00
else
call StartTimerBJ(udg_WitchDTimer,true,1.00)
call UnitAddAbility(hero,'A0GX')
set udg_WitchD=(udg_WitchD+udg_WitchDBonus)
endif
endif
if GetSpellAbilityId()=='A0GY' then
set x=GetUnitX(hero)
set y=GetUnitY(hero)
set bj_lastCreatedEffect=AddSpecialEffectTarget("war3mapImported\\Call of Dread Green.mdx",hero,"origin")
call DestroyEffect(bj_lastCreatedEffect)
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,450.,Condition(function Trig_Filter_ID))
set dmg=(GetUnitAbilityLevel(hero,'A0GY')*40+3*GetHeroInt(hero,true))*udg_WitchD
set r=0
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set r=r+1
call GroupRemoveUnit(g,u)
endloop
set r=r*(GetUnitAbilityLevel(hero,'A0GY')*8+GetHeroInt(hero,true)/3)+GetUnitAbilityLevel(hero,'A0GY')*20+2*GetHeroInt(hero,true)
call Heal(true,r,hero,hero)
endif
if GetSpellAbilityId()=='A0H3' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\Soul Beam.mdx",x,y)
call DestroyEffect(bj_lastCreatedEffect)
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,210.,Condition(function Trig_Filter_ID))
set dmg=(GetUnitAbilityLevel(hero,'A0H3')*40+2*GetHeroInt(hero,true))
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitInGroup(u,udg_WitchSkillQ[3])then
call UnitDamageTarget(hero,u,dmg*(udg_WitchD+4),false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
else
if IsUnitInGroup(u,udg_WitchSkillQ[2])then
call UnitDamageTarget(hero,u,dmg*(udg_WitchD+3),false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupAddUnit(udg_WitchSkillQ[3],u)
else
if IsUnitInGroup(u,udg_WitchSkillQ[1])then
if GetUnitAbilityLevel(hero,'A0H9')==1 then
call UnitDamageTarget(hero,u,dmg*(udg_WitchD+2),false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupAddUnit(udg_WitchSkillQ[2],u)
else
call UnitDamageTarget(hero,u,dmg*(udg_WitchD+1),false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
else
call UnitDamageTarget(hero,u,dmg*udg_WitchD,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupAddUnit(udg_WitchSkillQ[1],u)
endif
endif
endif
call GroupRemoveUnit(g,u)
endloop
elseif GetSpellAbilityId()=='A0H7' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,150+50*GetUnitAbilityLevel(hero,'A0H7'),Condition(function Trig_Filter_ID))
set dmg=(GetUnitAbilityLevel(hero,'A0H7')*60+2*GetHeroInt(hero,true))
if GetUnitAbilityLevel(hero,'A0H9')==1 then
set dmg=dmg*2
endif
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
elseif GetSpellAbilityId()=='A0H0' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,500.,Condition(function Trig_Filter_ID))
set g2=CreateGroup()
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitType(u,UNIT_TYPE_STRUCTURE)==false then
call GroupAddUnit(g2,u)
call PauseUnit(u,true)
call ShowUnit(u,false)
set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\Void Teleport Green To.mdx",GetUnitX(u),GetUnitY(u))
call DestroyEffect(bj_lastCreatedEffect)
endif
call GroupRemoveUnit(g,u)
endloop
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveGroupHandle(udg_hash,ht,1,g2)
call TimerStart(t,6.,false,function Witch_R)
else
endif
call DestroyGroup(g)
set g2=null
set g=null
set hero=null
set u=null
set t=null
endfunction
