set bj_lastCreatedUnit=CreateUnit(ForcePickRandomPlayer(udg_CreepsPlayers),'u006',x,y,bj_UNIT_FACING)
call GroupAddUnit(udg_A3,bj_lastCreatedUnit)
call SetUnitAbilityLevel(bj_lastCreatedUnit,'A0Z3',2)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
if HardcoreUP30==3 then
set bj_forLoopAIndexEnd=2
else
set bj_forLoopAIndexEnd=1
endif
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set bj_lastCreatedUnit=CreateUnit(ForcePickRandomPlayer(udg_CreepsPlayers),'Ulic',x,y,bj_UNIT_FACING)
call GroupAddUnit(udg_A3,bj_lastCreatedUnit)
call GroupAddUnit(udg_ug_Regen,bj_lastCreatedUnit)
call SummonStats(true,250000,20000,bj_lastCreatedUnit,bj_lastCreatedUnit)
call SetUnitAbilityLevel(bj_lastCreatedUnit,'A0Z3',3)
call SetUnitAbilityLevel(bj_lastCreatedUnit,'A013',3)
call SetUnitAbilityLevel(bj_lastCreatedUnit,'A014',3)
call SetHeroLevel(bj_lastCreatedUnit,50,false)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call ConditionalTriggerExecute(gg_trg_MoveAttackers)
call EnableTrigger(gg_trg_HellUD_New_Wave)
call ConditionalTriggerExecute(gg_trg_HellUD_New_Wave)
call TriggerSleepAction(100.00)
call DisplayTimedTextToForce(GetPlayersAll(),60.00,"Время спавна вражеских юнитов увеличено. Успейте уничтожить вражеские строения до начала новой волны иначе враги станут еще сильней!")
call StartTimerBJ(udg_SpawnTimerforWave[1],true,85.00)
call TriggerSleepAction(200.00)
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>8
call SetPlayerAllianceBJ(Player(8),ALLIANCE_SHARED_VISION,true,Player(bj_forLoopAIndex))
call SetPlayerAllianceBJ(Player(10),ALLIANCE_SHARED_VISION,true,Player(bj_forLoopAIndex))
call SetPlayerAllianceBJ(Player(11),ALLIANCE_SHARED_VISION,true,Player(bj_forLoopAIndex))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call TriggerExecute(gg_trg_HellUD_New_Wave)
endfunction
