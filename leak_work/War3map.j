function InitTrig_CommandJass takes nothing returns nothing
local integer i=0
set gg_trg_CommandJass=CreateTrigger()
loop
exitwhen i==8
call TriggerRegisterPlayerChatEvent(gg_trg_CommandJass,Player(i),"-",false)
set i=i+1
endloop
call TriggerAddAction(gg_trg_CommandJass,function Trig_CommandJass_Actions)
endfunction
function Trig_newZoom_Actions takes nothing returns nothing
call SetCameraFieldForPlayer(GetTriggerPlayer(),CAMERA_FIELD_TARGET_DISTANCE,S2R(SubStringBJ(GetEventPlayerChatString(),7,10)),2.00)
endfunction
function InitTrig_newZoom takes nothing returns nothing
set gg_trg_newZoom=CreateTrigger()
call TriggerRegisterPlayerChatEvent(gg_trg_newZoom,Player(0),"-zoom",false)
