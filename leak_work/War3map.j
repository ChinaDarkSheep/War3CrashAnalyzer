call SetPlayerAbilityAvailable(Player(i),'A0UV',false)
call SetPlayerAbilityAvailable(Player(i),'A13V',false)
call SetPlayerAbilityAvailable(Player(i),'A0PV',false)
call SetPlayerAbilityAvailable(Player(i),'A13Z',false)
call SetPlayerAbilityAvailable(Player(i),'A0Q1',false)
call SetPlayerAbilityAvailable(Player(i),'A0S4',false)
call SetPlayerAbilityAvailable(Player(i),'A0Z6',false)
