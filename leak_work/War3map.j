function Set5_Wave_2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer sec=LoadInteger(udg_hash,ht,0)+1
local real x
local real y
local integer a
if sec<410 then
call SaveInteger(udg_hash,ht,0,sec)
if sec==60 then
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=8
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call SetPlayerAllianceBJ(Player(8),ALLIANCE_SHARED_VISION,false,ConvertedPlayer(GetForLoopIndexA()))
