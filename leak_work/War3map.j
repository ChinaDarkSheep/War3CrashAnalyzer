call DestroyTimer(t)
set boss=null
set t=null
endfunction
function Trig_BossDamaged_Actions takes nothing returns nothing
local unit boss=GetTriggerUnit()
local timer t
local integer h=GetHandleId(boss)
local integer ht
local real takedamage=LoadReal(udg_hash,h,StringHash("TakeDamage"))+GetEventDamage()
local real x
local real y
local real x1
local real y1
local real dmg
if GetUnitTypeId(boss)=='n046' then
if GetUnitState(boss,UNIT_STATE_MAX_LIFE)*0.50<=takedamage and not LoadBoolean(udg_hash,h,'h')then
call SaveBoolean(udg_hash,h,'h',true)
set bj_forLoopAIndex=0
set bj_forLoopAIndexEnd=6
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set x=GetUnitX(boss)+500*Cos((GetUnitFacing(boss)+60*bj_forLoopAIndex)*bj_DEGTORAD)
set y=GetUnitY(boss)+500*Sin((GetUnitFacing(boss)+60*bj_forLoopAIndex)*bj_DEGTORAD)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(boss),'n075',x,y,GetUnitFacing(boss))
call GroupAddUnit(udg_A1,bj_lastCreatedUnit)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
endif
if LoadBoolean(udg_hash,h,'b')then
call UnitRemoveAbility(boss,'BSTN')
call UnitRemoveAbility(boss,'BPSE')
if GetUnitState(boss,UNIT_STATE_MAX_LIFE)*0.05<=takedamage then
call SaveReal(udg_hash,h,StringHash("TakeDamage"),0)
call UnitRemoveAbility(boss,'Bfro')
call UnitRemoveAbility(boss,'B02M')
call UnitRemoveAbility(boss,'B018')
call UnitRemoveAbility(boss,'B01I')
call UnitRemoveAbility(boss,'B00T')
call UnitRemoveAbility(boss,'Bslo')
call UnitRemoveAbility(boss,'BHbn')
call UnitRemoveAbility(boss,'Bply')
call UnitRemoveAbility(boss,'Bena')
call UnitRemoveAbility(boss,'Beng')
call UnitRemoveAbility(boss,'Bens')
call UnitRemoveAbility(boss,'Bprg')
call UnitRemoveAbility(boss,'Bmlt')
else
call SaveReal(udg_hash,h,StringHash("TakeDamage"),takedamage)
endif
endif
if GetUnitTypeId(boss)=='U01A' then
if LoadBoolean(udg_hash,h,StringHash("LifeBurn"))then
call SaveBoolean(udg_hash,h,StringHash("LifeBurn"),false)
call TransmissionFromUnitWithNameBJ(GetPlayersAll(),boss,"Воплощение Дьявола",null,"Отдайте свою кровь!",bj_TIMETYPE_ADD,0,true)
call PauseUnit(boss,true)
call SetUnitAnimation(boss,"channel")
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,boss)
call SaveInteger(udg_hash,ht,1,16)
call TimerStart(t,0.5,true,function BossDamaged_Mefisto_StealLife)
endif
endif
if GetUnitTypeId(boss)=='nrvd' then
if LoadBoolean(udg_hash,h,'q')==false then
call SaveBoolean(udg_hash,h,'q',true)
if udg_HardestLogic then
if udg_Mode==2 then
set dmg=4000
else
set dmg=2400
endif
else
set dmg=800
endif
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=2
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set x1=GetRandomReal(50.,350.)
set y1=GetRandomReal(0.,160.)+GetUnitFacing(boss)
set x=GetUnitX(boss)+x1*Cos(y1*bj_DEGTORAD)
set y=GetUnitY(boss)+x1*Sin(y1*bj_DEGTORAD)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(boss),'h057',x,y,bj_UNIT_FACING)
call SetUnitScale(bj_lastCreatedUnit,0.9,0.9,0.9)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',1.)
call SaveReal(udg_hash,GetHandleId(bj_lastCreatedUnit),'a',125.)
call SaveReal(udg_hash,GetHandleId(bj_lastCreatedUnit),'d',dmg)
call SaveUnitHandle(udg_hash,GetHandleId(bj_lastCreatedUnit),'u',boss)
call SaveStr(udg_hash,GetHandleId(bj_lastCreatedUnit),'e',"Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl")
set x1=GetRandomReal(50.,350.)
set y1=GetRandomReal(180.,340.)+GetUnitFacing(boss)
set x=GetUnitX(boss)+x1*Cos(y1*bj_DEGTORAD)
set y=GetUnitY(boss)+x1*Sin(y1*bj_DEGTORAD)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(boss),'h057',x,y,bj_UNIT_FACING)
call SetUnitScale(bj_lastCreatedUnit,0.9,0.9,0.9)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',1.)
call SaveReal(udg_hash,GetHandleId(bj_lastCreatedUnit),'a',125.)
call SaveReal(udg_hash,GetHandleId(bj_lastCreatedUnit),'d',dmg)
call SaveUnitHandle(udg_hash,GetHandleId(bj_lastCreatedUnit),'u',boss)
call SaveStr(udg_hash,GetHandleId(bj_lastCreatedUnit),'e',"Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl")
set x1=GetRandomReal(380.,1000.)
set y1=GetRandomReal(0.,100.)+GetUnitFacing(boss)
set x=GetUnitX(boss)+x1*Cos(y1*bj_DEGTORAD)
set y=GetUnitY(boss)+x1*Sin(y1*bj_DEGTORAD)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(boss),'h057',x,y,bj_UNIT_FACING)
