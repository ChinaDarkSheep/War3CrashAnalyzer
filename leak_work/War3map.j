function Trig_NewLvl_Actions takes nothing returns nothing
local unit u=GetLevelingUnit()
local integer h=GetHandleId(u)
local integer lvl=GetHeroLevel(u)
local integer ID=GetPlayerId(GetOwningPlayer(u))+1
local integer talante=udg_Talante[ID]
local integer a
local integer b
local integer c
local real r
local string s=LoadStr(udg_hash,h,2)
local integer ihh=ReturnTypeHeroId(GetHandleId(u))
local integer iuh=LoadInteger(Hash,h,0)
if GetUnitAbilityLevel(u,'A0A4')==0 then
elseif ModuloInteger(GetHeroLevel(udg_Scorpion),3)==0 then
set a=LoadInteger(udg_hash,h,'d')
if a==1 then
call SetHeroStr(u,GetHeroStr(u,true)+1,true)
elseif a==2 then
call SetHeroAgi(u,GetHeroAgi(u,true)+1,true)
else
call SetHeroInt(u,GetHeroInt(u,true)+1,true)
endif
endif
if UnitHasItemOfTypeBJ(u,'I06Y')then
set a=1
set b=1
set c=1
if s=="Str" then
set a=2
else
if s=="Agi" then
set b=2
else
set c=2
endif
endif
call SetHeroStr(u,GetHeroStr(u,false)+a,true)
call SetHeroAgi(u,GetHeroAgi(u,false)+b,true)
call SetHeroInt(u,GetHeroInt(u,false)+c,true)
endif
if GetUnitTypeId(u)=='N04I' then
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]+40
set r=I2R(lvl)*1.8+100.
call SetUnitScalePercent(u,r,r,r)
set a=1
set b=1
if talante==1 then
set a=3
elseif talante==2 then
set b=3
endif
call SaveReal(udg_hash,h,StringHash("HPRegen"),LoadReal(udg_hash,h,StringHash("HPRegen"))+a)
call TakeHeroAttack(b,u)
endif
if GetPlayerTechCount(GetOwningPlayer(u),'R02B',true)>=10 then
if s=="Str" then
call SaveReal(udg_hash,h,StringHash("PartStr"),LoadReal(udg_hash,h,StringHash("PartStr"))+0.25)
else
if s=="Agi" then
call SaveReal(udg_hash,h,StringHash("PartAgi"),LoadReal(udg_hash,h,StringHash("PartAgi"))+0.25)
else
call SaveReal(udg_hash,h,StringHash("PartInt"),LoadReal(udg_hash,h,StringHash("PartInt"))+0.25)
endif
endif
if GetPlayerTechCount(GetOwningPlayer(u),'R02B',true)>=19 then
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]+10
endif
endif
if GetUnitAbilityLevel(u,'A0ZE')==1 then
if GetHeroLevel(GetLevelingUnit())==20 then
call SetPlayerTechResearched(Player(ID-1),'R01G',1)
endif
if GetHeroLevel(GetLevelingUnit())==50 then
call SetPlayerTechResearched(Player(ID-1),'R01G',2)
endif
endif
if GetUnitAbilityLevel(u,'A0DZ')>0 then
if GetHeroLevel(u)==20 then
call SetPlayerTechResearched(GetOwningPlayer(u),'R01G',1)
elseif GetHeroLevel(u)==50 then
call SetPlayerTechResearched(GetOwningPlayer(u),'R01G',2)
call SetUnitAbilityLevel(u,'A0DZ',2)
endif
endif
if GetUnitAbilityLevel(u,'A00D')==1 then
if UnitHasItemOfTypeBJ(u,'I06Y')then
set b=80
set a=6
else
set b=40
set a=3
endif
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]+b
if talante==1 then
call TakeHeroAttack(a,u)
endif
endif
if GetUnitTypeId(u)=='U02A' then
set a=lvl/10
if a>5 then
set a=5
endif
if lvl>0 then
call SetPlayerTechResearched(Player(ID-1),'R04X',a)
endif
endif
if talante==1 then
if GetUnitTypeId(u)=='E008' then
call SetHeroAgi(u,GetHeroAgi(u,false)+1,true)
endif
if GetUnitTypeId(u)=='E00X' then
call SetPlayerTechResearchedSwap('R05Q',GetHeroLevel(u),GetOwningPlayer(u))
endif
if GetUnitTypeId(u)=='E002' then
call SetHeroAgi(u,GetHeroAgi(u,false)+1,true)
endif
if GetUnitTypeId(u)=='Nalc' then
set s__Heroes_MS[sHero[ihh]]=s__Heroes_MS[sHero[ihh]]+1
endif
if GetUnitTypeId(u)=='Utic' then
call SetPlayerTechResearched(GetOwningPlayer(u),'R05G',GetHeroLevel(u))
endif
if GetUnitAbilityLevel(u,'A0AV')==1 then
call SetPlayerTechResearchedSwap('R04U',GetHeroLevel(u),GetOwningPlayer(u))
endif
if u==udg_AstralDrak then
call SetPlayerTechResearchedSwap('R04U',GetHeroLevel(udg_AstralDrak),GetOwningPlayer(udg_AstralDrak))
endif
elseif talante==2 then
if GetUnitAbilityLevel(u,'A16K')>0 then
call SetHeroAgi(u,GetHeroAgi(u,false)+1,true)
elseif GetUnitTypeId(u)=='E00X' then
call SetHeroInt(u,GetHeroInt(u,false)+1,true)
elseif GetUnitTypeId(u)=='E002' then
call SetHeroStr(u,GetHeroStr(u,false)+1,true)
call SetHeroInt(u,GetHeroInt(u,false)+1,true)
elseif u==udg_AstralDrak then
call ModifyHeroStat(bj_HEROSTAT_INT,GetLevelingUnit(),bj_MODIFYMETHOD_ADD,1)
endif
if GetUnitTypeId(u)=='Hpb2' then
call SetPlayerTechResearched(GetOwningPlayer(u),'R02Y',GetHeroLevel(u)/3)
endif
elseif talante==3 then
if GetUnitTypeId(u)=='E008' then
call SetHeroStr(u,GetHeroStr(u,false)+2,true)
call SetHeroInt(u,GetHeroInt(u,false)+2,true)
endif
if lvl==50 then
if GetUnitTypeId(u)=='E008' then
set s__Heroes_Str[sHero[ihh]]=s__Heroes_Str[sHero[ihh]]+25
set s__Heroes_Int[sHero[ihh]]=s__Heroes_Int[sHero[ihh]]+25
call SaveReal(udg_hash,h,StringHash("StrUP"),LoadReal(udg_hash,h,StringHash("StrUP"))+0.05)
call SaveReal(udg_hash,h,StringHash("IntUP"),LoadReal(udg_hash,h,StringHash("IntUP"))+0.05)
endif
endif
endif
if GetUnitTypeId(u)=='Nbrn' then
if lvl==5 or lvl==10 or lvl==15 or lvl==20 or lvl==25 or lvl==30 or lvl==40 or lvl==45 then
set bj_lastCreatedUnit=CreateUnit(Player(ID-1),'u01C',GetUnitX(u),GetUnitY(u),0)
call GroupAddUnit(udg_UnordinaryUnit,bj_lastCreatedUnit)
call SeekFreeUnit(GetHandleId(bj_lastCreatedUnit))
if udg_SReligion[ID]==1 then
call UnitAddAbility(bj_lastCreatedUnit,'A0L2')
call UnitAddAbility(bj_lastCreatedUnit,'A08I')
call UnitAddAbility(bj_lastCreatedUnit,'A0L9')
call UnitAddAbility(bj_lastCreatedUnit,'A0LA')
call UnitAddAbility(bj_lastCreatedUnit,'A0LB')
call UnitAddAbility(bj_lastCreatedUnit,'A0LC')
call SetUnitVertexColorBJ(bj_lastCreatedUnit,100,60.00,0.00,0)
elseif udg_SReligion[ID]==2 then
call UnitAddAbility(bj_lastCreatedUnit,'A0L3')
call UnitAddAbility(bj_lastCreatedUnit,'A0L6')
call UnitAddAbility(bj_lastCreatedUnit,'A0CM')
call UnitAddAbility(bj_lastCreatedUnit,'A0LE')
call UnitAddAbility(bj_lastCreatedUnit,'A0LF')
call UnitAddAbility(bj_lastCreatedUnit,'A0LG')
call SetUnitVertexColorBJ(bj_lastCreatedUnit,90.00,40.00,90.00,0)
elseif udg_SReligion[ID]==3 then
call UnitAddAbility(bj_lastCreatedUnit,'A0L4')
call UnitAddAbility(bj_lastCreatedUnit,'A0L7')
call UnitAddAbility(bj_lastCreatedUnit,'A197')
call UnitAddAbility(bj_lastCreatedUnit,'A0LJ')
call UnitAddAbility(bj_lastCreatedUnit,'A0LK')
call UnitAddAbility(bj_lastCreatedUnit,'A0LL')
call SetUnitVertexColorBJ(bj_lastCreatedUnit,40.00,40.00,40.00,0)
endif
endif
endif
if GetUnitTypeId(u)=='H01F' then
call TakeHeroAttack(15,u)
call CreateTextTagUnitBJ("|cFF00FF00Профессионалы: +15 атаки|r",GetLevelingUnit(),0,9.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
endif
if GetUnitTypeId(u)=='E00N' then
if GetHeroLevel(u)>=50 then
call SetPlayerTechResearched(Player(ID-1),'R00H',4)
elseif GetHeroLevel(u)>=40 then
call SetPlayerTechResearched(Player(ID-1),'R00H',3)
elseif GetHeroLevel(u)>=20 then
call SetPlayerTechResearched(Player(ID-1),'R00H',2)
elseif GetHeroLevel(u)>=10 then
call SetPlayerTechResearched(Player(ID-1),'R00H',1)
endif
endif
if GetUnitTypeId(u)=='Nbst' then
if talante==1 then
if lvl>=5 and GetUnitAbilityLevel(u,'A00A')==0 then
call UnitAddAbility(u,'A00A')
endif
if lvl>=15 and GetUnitAbilityLevel(u,'A00B')==0 then
call UnitAddAbility(u,'A00B')
endif
if lvl>=20 and GetUnitAbilityLevel(u,'A00C')==0 then
call UnitAddAbility(u,'A00C')
endif
if lvl>=50 and GetUnitAbilityLevel(u,'A15Q')==0 then
call UnitAddAbility(u,'A15Q')
call UnitAddAbility(u,'A15X')
endif
elseif talante==2 then
call SetHeroStr(u,GetHeroStr(u,false)+1,true)
call SetHeroAgi(u,GetHeroAgi(u,false)+1,true)
call SetHeroInt(u,GetHeroInt(u,false)+1,true)
set s__Heroes_Pass_1sec_1[sHero[ihh]]="ZooBoyE1"
if lvl>=5 and GetUnitAbilityLevel(u,'A1DL')==0 then
call UnitAddAbility(u,'A1DL')
endif
if lvl>=15 and GetUnitAbilityLevel(u,'A1DM')==0 then
call UnitAddAbility(u,'A1DM')
endif
if lvl>=20 and GetUnitAbilityLevel(u,'A1DN')==0 then
call UnitAddAbility(u,'A1DN')
endif
if lvl>=50 and GetUnitAbilityLevel(u,'A1DO')==0 then
call UnitAddAbility(u,'A1DO')
endif
endif
endif
if GetHeroLevel(u)==50 then
if talante==1 then
if GetUnitAbilityLevel(u,'A0O4')==1 then
call SetUnitAbilityLevel(udg_Hero[ID],'A14O',2)
call UnitRemoveAbility(udg_Hero[ID],'B02I')
endif
if GetUnitTypeId(u)=='N04A' then
call SetUnitAbilityLevel(u,'A0FS',3)
call UnitAddAbility(u,'A1BG')
endif
if GetUnitTypeId(u)=='N03M' then
call SetUnitAbilityLevel(u,'A14O',2)
call UnitRemoveAbility(u,'B02I')
endif
endif
if talante==2 then
if GetUnitTypeId(u)=='N03M' then
call SetPlayerTechResearched(GetOwningPlayer(u),'R04Z',3)
endif
endif
if GetTriggerUnit()==udg_Scorpion and udg_ScorpionMutation[1]==1 then
call UnitAddItemByIdSwapped('I0C5',udg_Scorpion)
endif
if GetPlayerTechCount(GetOwningPlayer(u),'R02B',true)<8 then
if GetTriggerUnit()==udg_Rifle and udg_RifleLogic[8]then
else
call SuspendHeroXPBJ(false,u)
endif
endif
if GetLevelingUnit()==udg_Scorpion then
call ModifyHeroSkillPoints(u,bj_MODIFYMETHOD_SUB,1)
if udg_ScorpionMutation[2]==2 then
call UnitAddAbilityBJ('A15V',udg_Scorpion)
endif
endif
if GetLevelingUnit()==udg_Barbarion then
call SetUnitAbilityLevelSwapped('A16B',udg_Barbarion,2)
endif
if GetLevelingUnit()==udg_Tikondrus then
call SetPlayerTechResearchedSwap('R04F',5,GetOwningPlayer(udg_Tikondrus))
endif
if GetUnitAbilityLevel(u,'A08Y')==1 then
call SetUnitAbilityLevel(u,'A08Y',2)
endif
endif
if GetHeroLevel(u)==55 then
if GetPlayerTechCount(GetOwningPlayer(u),'R02B',true)<10 then
if u==udg_Rifle and udg_RifleLogic[8]then
else
call SuspendHeroXPBJ(false,u)
endif
endif
if udg_LvlItemLogic[1]==false then
set udg_LvlItemLogic[1]=true
call DisplayTextToForce(GetPlayersAll(),("|cFF52EDF1Игрок|r |cFFFFDC00"+(GetPlayerName(GetOwningPlayer(u))+"|r |cFF52EDF1первым получил 55 уровень и получает \"Мистический амулет\"!")))
call UnitAddItemByIdSwapped('I09K',u)
set QuestsNT[GetPlayerId(GetOwningPlayer(u))+1]=QuestsNT[GetPlayerId(GetOwningPlayer(u))+1]+1
endif
endif
if udg_Mode !=4 and s__HelpText[ID]then
if GetUnitLevel(GetTriggerUnit())==15 then
call FHelpText(ID-1,"|cFFFFDC00Поздравляем с 15 уровнем!|r\n\n|cFFFFDC00Теперь ваших сил достаточно чтобы убивать большиство лесных мобов.|r",40.)
elseif GetUnitLevel(GetTriggerUnit())==30 then
call FHelpText(ID-1,"|cFFFFDC00Поздравляем с 30 уровнем!|r\n\n|cFFFFDC00Самое время начать исследовать самые далёкие уголки карты!|r",40.)
elseif GetUnitLevel(GetTriggerUnit())==50 then
call FHelpText(ID-1,"|cFFFFDC00Поздравляем с 50 уровнем!|r\n\n|cFFFFDC00Вы достаточно сильны, чтобы бросить вызов сильнейшим врагам. У помощника на спавне есть сферы для призыва таковых.",40.)
endif
else
endif
if GetHeroLevel(u)>=60 then
if u==udg_Rifle and udg_RifleLogic[8]then
else
call SuspendHeroXPBJ(false,u)
endif
if udg_LvlItemLogic[2]==false then
set udg_LvlItemLogic[2]=true
call DisplayTextToForce(GetPlayersAll(),("|cFF52EDF1Игрок|r |cFFFFDC00"+(GetPlayerName(GetOwningPlayer(u))+"|r |cFF52EDF1первым получил 60 уровень и получает \"Копье чемпиона\"!")))
call UnitAddItemByIdSwapped('I09L',u)
set QuestsNT[GetPlayerId(GetOwningPlayer(u))+1]=QuestsNT[GetPlayerId(GetOwningPlayer(u))+1]+1
endif
endif
if u==udg_Scorpion and udg_ScorpionMutation[3]==2 then
call ModifyHeroStat(bj_HEROSTAT_STR,GetLevelingUnit(),bj_MODIFYMETHOD_ADD,1)
call ModifyHeroStat(bj_HEROSTAT_AGI,GetLevelingUnit(),bj_MODIFYMETHOD_ADD,1)
call ModifyHeroStat(bj_HEROSTAT_INT,GetLevelingUnit(),bj_MODIFYMETHOD_ADD,1)
endif
set u=null
endfunction
