if a==1 then
set name='envl'
elseif a>=2 and a<=4 then
set name='sbch'
elseif a>=5 and a<=8 then
set name='mgtk'
else
set name='pmna'
endif
else
set a=GetRandomInt(1,5)
if a==1 then
set name='iwbr'
else
set name='dkfw'
endif
endif
elseif phase==5 then
set b=GetRandomInt(1,100)
if b<40 then
set a=GetRandomInt(1,10)
if a==1 then
set name='gobm'
elseif a>=2 and a<=4 then
set name='dsum'
elseif a>=5 and a<=8 then
set name='wolg'
else
set name='penr'
endif
elseif b<80 then
