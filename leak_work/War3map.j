function Trig_Timer01s_Heroes takes nothing returns nothing
local unit hero=GetEnumUnit()
local integer h=GetHandleId(hero)
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local integer id=GetPlayerId(GetOwningPlayer(hero))
local unit u
local real dmg
local real xh=GetUnitX(hero)
local real yh=GetUnitY(hero)
local real x
local real y
local real x1
local real y1
local real r
local integer a=0
local integer b=0
local integer c=0
local integer d
local integer i=LoadInteger(udg_hash,h,StringHash("HighStatNum"))
local integer array inar
local timer t
local integer ht
local string s=LoadStr(udg_hash,h,2)
local group g=CreateGroup()
local integer talante=udg_Talante[ID]
local boolean day
local integer highstat
local integer PGStr=0
local integer PGAgi=0
local integer PGInt=0
local integer BStr=0
local integer BAgi=0
local integer BInt=0
local integer BHP=0
local integer BAttack=0
local integer BArm=0
local integer ihh=LoadInteger(udg_hash,h,5)
local integer iuh=LoadInteger(Hash,h,0)
local integer mainStat=3
if s=="Str" then
set mainStat=1
elseif s=="Agi" then
set mainStat=2
endif
if GetFloatGameState(GAME_STATE_TIME_OF_DAY)<18.00 and GetFloatGameState(GAME_STATE_TIME_OF_DAY)>6.00 then
set day=true
else
set day=false
endif
if i==1 then
set highstat=GetHeroStr(hero,true)
elseif i==2 then
set highstat=GetHeroAgi(hero,true)
else
set highstat=GetHeroInt(hero,true)
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='ches' then
set a=GetHeroLevel(hero)
call SaveInteger(udg_hash,h,H_HighStat,LoadInteger(udg_hash,h,H_HighStat)+a-LoadInteger(udg_hash,h,StringHash("Diadem")))
call SaveInteger(udg_hash,h,StringHash("Diadem"),a)
endif
if not(GetUnitAbilityLevel(hero,'A03L')==1 and udg_Talante[ID]==1)then
set BHP=BHP+4*GetHeroStr(hero,true)
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='gmfr' then
set a=highstat-1
set b=a-LoadInteger(udg_hash,h,StringHash("Gilean"))
call SaveReal(udg_hash,h,StringHash("HPRegen"),LoadReal(udg_hash,h,StringHash("HPRegen"))+0.04*(b))
call SaveReal(udg_hash,h,StringHash("MPRegen"),LoadReal(udg_hash,h,StringHash("MPRegen"))+0.02*(b))
set BHP=BHP+2*highstat
set s__Units_MP[sUnit[iuh]]=s__Units_MP[sUnit[iuh]]+b
set s__Units_Arm[sUnit[iuh]]=s__Units_Arm[sUnit[iuh]]+(25*b)/1000
call SaveInteger(udg_hash,h,StringHash("Gilean"),a)
elseif GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='ledg' then
set a=LoadInteger(udg_hash,h,StringHash("BKeyS"))
set b=LoadInteger(udg_hash,h,StringHash("BKeyA"))
set c=LoadInteger(udg_hash,h,StringHash("BKeyI"))
if i==1 then
set d=100+15*(highstat-a-LoadInteger(udg_hash,h,StringHash("NGreenStr")))/100
elseif i==2 then
set d=100+15*(highstat-b-LoadInteger(udg_hash,h,StringHash("NGreenAgi")))/100
else
set d=100+15*(highstat-c-LoadInteger(udg_hash,h,StringHash("NGreenInt")))/100
endif
if i !=1 then
set s__Heroes_Str[sHero[ihh]]=s__Heroes_Str[sHero[ihh]]+d
call SaveInteger(udg_hash,h,StringHash("NGreenStr"),LoadInteger(udg_hash,h,StringHash("NGreenStr"))+d)
call SaveInteger(udg_hash,h,StringHash("BKeyS"),d)
else
call SaveInteger(udg_hash,h,StringHash("BKeyS"),0)
endif
if i !=2 then
set s__Heroes_Agi[sHero[ihh]]=s__Heroes_Agi[sHero[ihh]]+d
call SaveInteger(udg_hash,h,StringHash("NGreenAgi"),LoadInteger(udg_hash,h,StringHash("NGreenAgi"))+d)
call SaveInteger(udg_hash,h,StringHash("BKeyA"),d)
else
call SaveInteger(udg_hash,h,StringHash("BKeyA"),0)
endif
if i !=3 then
set s__Heroes_Int[sHero[ihh]]=s__Heroes_Int[sHero[ihh]]+d
call SaveInteger(udg_hash,h,StringHash("NGreenInt"),LoadInteger(udg_hash,h,StringHash("NGreenInt"))+d)
call SaveInteger(udg_hash,h,StringHash("BKeyI"),d)
else
call SaveInteger(udg_hash,h,StringHash("BKeyI"),0)
endif
set s__Heroes_Str[sHero[ihh]]=s__Heroes_Str[sHero[ihh]]-a
set s__Heroes_Agi[sHero[ihh]]=s__Heroes_Agi[sHero[ihh]]-b
set s__Heroes_Int[sHero[ihh]]=s__Heroes_Int[sHero[ihh]]-c
call SaveInteger(udg_hash,h,StringHash("NGreenStr"),LoadInteger(udg_hash,h,StringHash("NGreenStr"))-a)
call SaveInteger(udg_hash,h,StringHash("NGreenAgi"),LoadInteger(udg_hash,h,StringHash("NGreenAgi"))-b)
call SaveInteger(udg_hash,h,StringHash("NGreenInt"),LoadInteger(udg_hash,h,StringHash("NGreenInt"))-c)
endif
if s__Heroes_upBStr[sHero[ihh]]>0 then
set a=LoadInteger(udg_hash,h,StringHash("upBStr"))
set s__Heroes_Str[sHero[ihh]]=s__Heroes_Str[sHero[ihh]]-a
set a=R2I(s__Heroes_upBStr[sHero[ihh]]*GetHeroStr(hero,false))
set s__Heroes_Str[sHero[ihh]]=s__Heroes_Str[sHero[ihh]]+a
call SaveInteger(udg_hash,h,StringHash("upBStr"),a)
endif
if s__Heroes_upBAgi[sHero[ihh]]>0 then
set a=LoadInteger(udg_hash,h,StringHash("upBAgi"))
set s__Heroes_Agi[sHero[ihh]]=s__Heroes_Agi[sHero[ihh]]-a
set a=R2I(s__Heroes_upBAgi[sHero[ihh]]*GetHeroStr(hero,false))
set s__Heroes_Agi[sHero[ihh]]=s__Heroes_Agi[sHero[ihh]]+a
call SaveInteger(udg_hash,h,StringHash("upBAgi"),a)
endif
if s__Heroes_upBInt[sHero[ihh]]>0 then
set a=LoadInteger(udg_hash,h,StringHash("upBInt"))
set s__Heroes_Int[sHero[ihh]]=s__Heroes_Int[sHero[ihh]]-a
set a=R2I(s__Heroes_upBInt[sHero[ihh]]*GetHeroStr(hero,false))
set s__Heroes_Int[sHero[ihh]]=s__Heroes_Int[sHero[ihh]]+a
call SaveInteger(udg_hash,h,StringHash("upBInt"),a)
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='evtl' then
if mainStat==1 then
set BStr=BStr+R2I(0.14*(GetHeroStr(hero,true)-s__Heroes_TempStr[sHero[ihh]]))
else
if mainStat==2 then
set BAgi=BAgi+R2I(0.14*(GetHeroAgi(hero,true)-s__Heroes_TempAgi[sHero[ihh]]))
else
set BInt=BInt+R2I(0.14*(GetHeroInt(hero,true)-s__Heroes_TempInt[sHero[ihh]]))
endif
endif
endif
if UnitHasItemOfTypeBJ(hero,'I0E7')then
set BHP=BHP+2*highstat
endif
if s__Heroes_buyI071[sHero[ihh]]>0 then
set a=(highstat-GetHeroStr(hero,true))*4
if a<0 then
set a=0
endif
set BHP=BHP+a
endif
set a=R2I(LoadReal(udg_hash,h,StringHash("PartStr")))
if a>0 then
call SetHeroStr(hero,GetHeroStr(hero,false)+a,true)
call SaveReal(udg_hash,h,StringHash("PartStr"),LoadReal(udg_hash,h,StringHash("PartStr"))-a)
endif
set a=R2I(LoadReal(udg_hash,h,StringHash("PartAgi")))
if a>0 then
call SetHeroAgi(hero,GetHeroAgi(hero,false)+a,true)
call SaveReal(udg_hash,h,StringHash("PartAgi"),LoadReal(udg_hash,h,StringHash("PartAgi"))-a)
endif
set a=R2I(LoadReal(udg_hash,h,StringHash("PartInt")))
if a>0 then
call SetHeroInt(hero,GetHeroInt(hero,false)+a,true)
call SaveReal(udg_hash,h,StringHash("PartInt"),LoadReal(udg_hash,h,StringHash("PartInt"))-a)
endif
if GetUnitAbilityLevel(hero,'A042')==1 then
set y=LoadInteger(udg_hash,h,'d')
set x=GetHeroLevel(hero)*.5+.04*GetHeroStr(hero,true)
if talante==2 then
set a=R2I(1.5*(0.2*GetHeroAgi(hero,true)+s__Units_Arm[sUnit[iuh]]+s__Heroes_BaseDmg[sHero[ihh]]+x-y)*LoadReal(udg_hash,h,4))
if GetHeroLevel(hero)>49 then
set a=2*a
endif
set s__Units_GAttack[sUnit[iuh]]=s__Units_GAttack[sUnit[iuh]]+a-LoadInteger(udg_hash,h,StringHash("D1"))
call SaveInteger(udg_hash,h,StringHash("D1"),a)
elseif talante==1 and GetHeroLevel(hero)>49 then
set b=R2I(x+.02*GetHeroStr(hero,true))
else
set b=R2I(x)
endif
set s__Units_Arm[sUnit[iuh]]=s__Units_Arm[sUnit[iuh]]+b-R2I(y)
call SaveInteger(udg_hash,h,'d',b)
if GetUnitAbilityLevel(hero,'A1EJ')>0 then
if talante==1 or talante==2 then
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,xh,yh,1000,Bool_Filter_ID_Ally)
call GroupRemoveUnit(g,hero)
set c=0
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitType(u,UNIT_TYPE_HERO)then
set c=c+1
endif
call GroupRemoveUnit(g,u)
endloop
if c>4 then
set c=4
endif
if talante==1 then
set a=200*GetUnitAbilityLevel(hero,'A1EJ')
set b=2*GetUnitAbilityLevel(hero,'A1EJ')
set x=1.+.25*c
set dmg=x*(a+8*(GetHeroAgi(hero,true)+s__Units_Arm[sUnit[iuh]]+LoadInteger(udg_hash,h,StringHash("BaseArmore"))))
set a=R2I(x*b)
set b=R2I(dmg)
set s__Units_Arm[sUnit[iuh]]=s__Units_Arm[sUnit[iuh]]+a-LoadInteger(udg_hash,h,StringHash("Earm"))
call SaveInteger(udg_hash,h,StringHash("Earm"),a)
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]+b-LoadInteger(udg_hash,h,StringHash("Ehp"))
call SaveInteger(udg_hash,h,StringHash("Ehp"),b)
else
set a=4*GetUnitAbilityLevel(hero,'A1EJ')
set x=1.+.2*c
set dmg=x*(a+0.25*(GetHeroStr(hero,true)+s__Heroes_BaseDmg[sHero[ihh]]))*LoadReal(udg_hash,h,4)
if GetHeroLevel(hero)>49 then
set dmg=2*dmg
endif
set BAttack=BAttack+R2I(dmg)
endif
elseif talante==3 then
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,xh,yh,1000,Bool_Filter_ID_Ally)
call GroupRemoveUnit(g,hero)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call GroupAddUnit(mammothE,u)
call GroupRemoveUnit(g,u)
endloop
endif
endif
endif
if talante==2 then
if GetUnitAbilityLevel(hero,'A191')==1 then
set b=LoadInteger(udg_hash,h,'f')
set a=GetHeroStr(hero,true)/20
set s__Units_Arm[sUnit[iuh]]=s__Units_Arm[sUnit[iuh]]+a-b
call SaveInteger(udg_hash,h,'f',a)
endif
if GetUnitAbilityLevel(hero,'A0MY')>0 and LoadInteger(udg_hash,h,'e')==0 then
set x=GetUnitX(hero)
set y=GetUnitY(hero)
if GetUnitAbilityLevel(hero,'A0N1')==1 then
set r=325.
else
set r=225.
endif
set dmg=GetHeroInt(hero,true)+GetHeroStr(hero,true)+60.*GetUnitAbilityLevel(hero,'A0MY')
if GetHeroLevel(hero)>=50 then
set dmg=1.5*dmg
endif
set udg_Drop2=GetPlayerId(GetOwningPlayer(hero))
call GroupEnumUnitsInRange(g,x,y,600.,Bool_Filter_ID)
set u=LoadUnitHandle(udg_hash,h,'d')
if UnitAlive(u)and IsUnitInGroup(u,g)then
else
call RandomUnitFromGroup(1,g)
set u=FirstOfGroup(g)
endif
if u !=null then
call GroupClear(g)
call SaveInteger(udg_hash,h,'e',1)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call TimerStart(t,5.,false,function Trig_Timer01s_Grifon_E)
set x1=GetUnitX(u)
set y1=GetUnitY(u)
set bj_lastCreatedUnit=CreateUnit(Player(ID-1),'h03V',x1,y1,bj_UNIT_FACING)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',0.19)
set udg_Drop2=GetPlayerId(GetOwningPlayer(hero))
call GroupEnumUnitsInRange(g,x1,y1,r,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
endif
endif
endif
if GetUnitAbilityLevel(hero,'A1E7')>0 then
set x=LoadReal(udg_hash,h,'e')
call SaveReal(udg_hash,h,StringHash("HPRegen"),LoadReal(udg_hash,h,StringHash("HPRegen"))-x)
set x=8.*GetUnitAbilityLevel(hero,'A1E7')+0.06*GetHeroAgi(hero,true)
if GetHeroLevel(hero)>49 then
set x=x+0.04*GetHeroAgi(hero,true)
endif
if GetUnitAbilityLevel(hero,'A0CS')==1 and LoadBoolean(udg_hash,h,'d')then
set x=1.25*x
endif
call SaveReal(udg_hash,h,StringHash("HPRegen"),LoadReal(udg_hash,h,StringHash("HPRegen"))+x)
call SaveReal(udg_hash,h,'e',x)
set BHP=BHP+2*GetHeroAgi(hero,true)
endif
if GetUnitAbilityLevel(hero,'A14Z')>0 then
if LoadInteger(udg_hash,h,'d')==1 then
set a=GetHeroStr(hero,true)
elseif LoadInteger(udg_hash,h,'d')==2 then
set a=GetHeroAgi(hero,true)
else
set a=GetHeroInt(hero,true)
endif
set BArm=BArm+a/50
if GetHeroLevel(hero)>49 then
set a=4*a
else
set a=2*a
endif
set BHP=BHP+a
endif
if IsUnitInGroup(hero,udg_ItemComplectGroup[1])then
call SetUnitState(hero,UNIT_STATE_LIFE,0.99*GetUnitState(hero,UNIT_STATE_LIFE))
endif
if udg_Setstart then
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='dphe' and not LoadBoolean(udg_hash,h,StringHash("TreauseMap"))then
call SaveBoolean(udg_hash,h,StringHash("TreauseMap"),true)
set x=GetRandomInt(-11000,10000)
set y=GetRandomInt(-5500,22000)
if IsTerrainPathable(x,y,PATHING_TYPE_WALKABILITY)then
set x=GetRandomInt(-11000,10000)
set y=GetRandomInt(-5500,22000)
if IsTerrainPathable(x,y,PATHING_TYPE_WALKABILITY)then
set x=GetRandomInt(-11000,10000)
set y=GetRandomInt(-5500,22000)
endif
endif
set bj_lastCreatedTextTag=CreateTextTag()
if GetLocalPlayer()==Player(id)then
call SetTextTagVisibility(bj_lastCreatedTextTag,true)
else
call SetTextTagVisibility(bj_lastCreatedTextTag,false)
endif
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveReal(udg_hash,ht,1,120)
call SaveReal(udg_hash,ht,2,x)
call SaveReal(udg_hash,ht,3,y)
call SaveTextTagHandle(udg_hash,ht,4,bj_lastCreatedTextTag)
call TimerStart(t,0.08,true,function Trig_Timer01s_TreauseMap)
endif
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='sehr' and not LoadBoolean(udg_hash,h,StringHash("Veicoin"))then
set a=LoadInteger(udg_hash,h,StringHash("VeicoinG"))
if GetRandomInt(1,10)!=1 then
if udg_Time[2]<30 and udg_Time[3]==0 then
if a>4000 then
set b=300+10
else
set b=R2I(a*.075)+10
endif
else
if a>2500 then
set b=125+5
else
set b=R2I(a*.038)+5
endif
endif
set a=a+R2I(b*.7+b*.3*GoldAvg[ID])
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"|cffffcc00Накоплено "+I2S(a)+"ед золота|r")
else
set b=R2I(a*0.01*GetRandomInt(1,5))
set a=a-b
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"|cffffcc00Накоплено "+I2S(a)+"ед золота. Потеряно "+I2S(b)+"ед золота|r")
endif
call SaveInteger(udg_hash,h,StringHash("VeicoinG"),a)
call Func_CD(hero,"Veicoin",8)
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='sclp' then
set a=WinterFruit[ID]*4+35*MageFruit[ID]
set b=LoadInteger(udg_hash,h,StringHash("Bracs"))
set s__Heroes_Str[sHero[ihh]]=s__Heroes_Str[sHero[ihh]]+a-b
set s__Heroes_Agi[sHero[ihh]]=s__Heroes_Agi[sHero[ihh]]+a-b
set s__Heroes_Int[sHero[ihh]]=s__Heroes_Int[sHero[ihh]]+a-b
call SaveInteger(udg_hash,h,StringHash("Bracs"),a)
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='bzbf' then
set x=0.004*GetUnitState(hero,UNIT_STATE_LIFE)
call Heal(true,x,hero,hero)
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='wtlg' then
if LoadInteger(udg_hash,h,StringHash("Hourglass"))==1 and udg_Time[1]>29 then
call SaveInteger(udg_hash,h,StringHash("Hourglass"),2)
call SaveReal(udg_hash,h,StringHash("HPRegen"),LoadReal(udg_hash,h,StringHash("HPRegen"))+20)
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]+1500
set s__Units_AllBlock[sUnit[iuh]]=s__Units_AllBlock[sUnit[iuh]]+1500
set s__Units_GAttack[sUnit[iuh]]=s__Units_GAttack[sUnit[iuh]]-80
set s__Heroes_Str[sHero[ihh]]=s__Heroes_Str[sHero[ihh]]-20
set s__Heroes_Agi[sHero[ihh]]=s__Heroes_Agi[sHero[ihh]]-20
set s__Heroes_Int[sHero[ihh]]=s__Heroes_Int[sHero[ihh]]-20
set s__Units_AllDmg[sUnit[iuh]]=s__Units_AllDmg[sUnit[iuh]]-1500
elseif LoadInteger(udg_hash,h,StringHash("Hourglass"))==2 and udg_Time[1]<30 then
call SaveInteger(udg_hash,h,StringHash("Hourglass"),1)
set s__Units_GAttack[sUnit[iuh]]=s__Units_GAttack[sUnit[iuh]]+80
set s__Heroes_Str[sHero[ihh]]=s__Heroes_Str[sHero[ihh]]+20
set s__Heroes_Agi[sHero[ihh]]=s__Heroes_Agi[sHero[ihh]]+20
set s__Heroes_Int[sHero[ihh]]=s__Heroes_Int[sHero[ihh]]+20
set s__Units_AllDmg[sUnit[iuh]]=s__Units_AllDmg[sUnit[iuh]]+1500
call SaveReal(udg_hash,h,StringHash("HPRegen"),LoadReal(udg_hash,h,StringHash("HPRegen"))-20)
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]-1500
set s__Units_AllBlock[sUnit[iuh]]=s__Units_AllBlock[sUnit[iuh]]-1500
endif
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='ckng' then
if GetUnitState(hero,UNIT_STATE_MAX_LIFE)>=5000 then
set x=1.+5.
else
set x=1.+0.1*(0.01*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
endif
set y=10*(1-GetUnitState(hero,UNIT_STATE_LIFE)/GetUnitState(hero,UNIT_STATE_MAX_LIFE))
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+x*y)
elseif GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='rwiz' then
set dmg=30.+0.03*GetUnitState(hero,UNIT_STATE_MAX_LIFE)
set udg_Drop2=GetPlayerId(GetOwningPlayer(hero))
call GroupEnumUnitsInRange(g,xh,yh,500.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
set x1=xh-GetUnitX(u)
set y1=yh-GetUnitY(u)
set x1=0.1*(SquareRoot(x1*x1+y1*y1))
call UnitDamageTarget(hero,u,dmg*(1-0.01*x1),false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Immolation\\ImmolationDamage.mdl",u,"shest")
call Effect_Del(bj_lastCreatedEffect,1.)
call GroupRemoveUnit(g,u)
endloop
elseif GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='rat3' then
call UnitRemoveBuffs(hero,false,true)
elseif GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='k3m2' then
if GetUnitState(hero,UNIT_STATE_LIFE)/GetUnitState(hero,UNIT_STATE_MAX_LIFE)<0.3 and LoadBoolean(udg_hash,h,StringHash("HelpPot"))==false then
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+200+0.2*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Heal\\HealTarget.mdl",hero,"origin"))
call Func_CD(hero,"HelpPot",20)
endif
elseif GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='clfm' and LoadBoolean(udg_hash,h,StringHash("Dice"))==false then
set a=GetRandomInt(1,6)
if a==1 then
set i=250+50*GetRandomInt(1,5)
call SetPlayerStateBJ(Player(id),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)+i)
elseif a==2 then
set i=GetRandomInt(1,3)
set c=GetRandomInt(6,10)
if i==1 then
call SetHeroStr(hero,GetHeroStr(hero,false)+c,true)
elseif i==2 then
call SetHeroAgi(hero,GetHeroAgi(hero,false)+c,true)
else
call SetHeroInt(hero,GetHeroInt(hero,false)+c,true)
endif
elseif a==3 then
set i=100+R2I(0.01*GetUnitState(hero,UNIT_STATE_MAX_LIFE)*GetRandomInt(10,20))
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+i)
elseif a==4 then
set i=R2I(100*GetRandomInt(10,20)*udg_HeroExp[ID])
call AddHeroXP(hero,i,true)
elseif a==5 then
set i=GetRandomInt(1,4)
if i==1 then
set c='nkob'
elseif i==2 then
set c='uban'
elseif i==3 then
set c='nska'
else
set c='n005'
endif
set x=xh+200*Cos((GetUnitFacing(hero)+120)*bj_DEGTORAD)
set y=yh+200*Sin((GetUnitFacing(hero)+120)*bj_DEGTORAD)
set u=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),c,x,y,0.)
call UnitAddAbility(u,'A007')
call SummonStats(false,150,10,u,u)
call UnitRemoveAbility(u,'A007')
set x=xh+200*Cos((GetUnitFacing(hero)+240)*bj_DEGTORAD)
set y=yh+200*Sin((GetUnitFacing(hero)+240)*bj_DEGTORAD)
set u=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),c,x,y,0.)
call UnitAddAbility(u,'A007')
call SummonStats(false,150,10,u,u)
call UnitRemoveAbility(u,'A007')
set x=xh+200*Cos((GetUnitFacing(hero)+360)*bj_DEGTORAD)
set y=yh+200*Sin((GetUnitFacing(hero)+360)*bj_DEGTORAD)
set u=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),c,x,y,0.)
call UnitAddAbility(u,'A007')
call SummonStats(false,150,10,u,u)
call UnitRemoveAbility(u,'A007')
endif
call SaveBoolean(udg_hash,h,StringHash("Dice"),true)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call TimerStart(t,8.,false,function Trig_Timer01s_Dice)
elseif GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='bgst' then
set BHP=BHP+3*GetHeroStr(hero,true)
elseif GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='tlum' then
set BAttack=BAttack+highstat/5
endif
set r=LoadReal(udg_hash,h,StringHash("HPMAX_bonus"))
if s__Heroes_item_I0EP[sHero[ihh]]>0 then
set r=r+.2
endif
set a=R2I(r*(GetUnitState(hero,UNIT_STATE_MAX_LIFE)))
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]+a-LoadInteger(udg_hash,h,StringHash("HPmax"))
call SaveInteger(udg_hash,h,StringHash("HPmax"),a)
if UnitHasItemOfTypeBJ(hero,'k3m3')then
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.01*GetUnitState(hero,UNIT_STATE_MANA))
call SetUnitState(hero,UNIT_STATE_MANA,GetUnitState(hero,UNIT_STATE_MANA)+0.01*GetUnitState(hero,UNIT_STATE_MAX_MANA))
endif
if UnitHasItemOfTypeBJ(hero,'I08U')then
set a=KStr[ID]/2
set b=KAgi[ID]/2
set c=KInt[ID]/2
call SetHeroStr(hero,GetHeroStr(hero,false)+a-LoadInteger(udg_hash,h,StringHash("FrostStr")),true)
call SetHeroAgi(hero,GetHeroAgi(hero,false)+b-LoadInteger(udg_hash,h,StringHash("FrostAgi")),true)
call SetHeroInt(hero,GetHeroInt(hero,false)+c-LoadInteger(udg_hash,h,StringHash("FrostInt")),true)
call SaveInteger(udg_hash,h,StringHash("FrostStr"),a)
call SaveInteger(udg_hash,h,StringHash("FrostAgi"),b)
call SaveInteger(udg_hash,h,StringHash("FrostInt"),c)
set a=Kdmg[ID]/2-LoadInteger(udg_hash,h,StringHash("FrostDMG"))
set b=Khp[ID]/2
set c=Kmp[ID]/2
if a>0 then
call TakeHeroAttack(a,hero)
elseif a<0 then
call RemoveAttack(-a,hero)
endif
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]+b-LoadInteger(udg_hash,h,StringHash("FrostHP"))
set s__Units_MP[sUnit[iuh]]=s__Units_MP[sUnit[iuh]]+c-LoadInteger(udg_hash,h,StringHash("FrostMP"))
call SaveInteger(udg_hash,h,StringHash("FrostDMG"),Kdmg[ID]/2)
call SaveInteger(udg_hash,h,StringHash("FrostHP"),b)
call SaveInteger(udg_hash,h,StringHash("FrostMP"),c)
endif
if UnitHasItemOfTypeBJ(hero,'I06Z')then
set BHP=BHP+4*GetHeroStr(hero,true)
endif
if UnitHasItemOfTypeBJ(hero,'I0BI')then
set BHP=BHP+3*highstat
endif
if UnitHasItemOfTypeBJ(hero,'I09D')then
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.005*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
endif
if UnitHasItemOfTypeBJ(hero,'I0EJ')then
set BHP=BHP+4*highstat
set dmg=GetUnitState(hero,UNIT_STATE_LIFE)/GetUnitState(hero,UNIT_STATE_MAX_LIFE)
if UnitAlive(hero)and LoadBoolean(udg_hash,h,StringHash("VinushkaHeal"))==false and dmg<0.3 then
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.25*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
set bj_lastCreatedEffect=AddSpecialEffectTarget("war3mapImported\\Heal Green.mdx",hero,"origin")
call DestroyEffect(bj_lastCreatedEffect)
call Func_CD(hero,"VinushkaHeal",30.)
endif
endif
if UnitHasItemOfTypeBJ(hero,'I0B9')then
set b=LoadInteger(udg_hash,h,StringHash("MageRobe"))
set a=(R2I(GetUnitState(hero,UNIT_STATE_MAX_MANA))-b)/4
set s__Units_MP[sUnit[iuh]]=s__Units_MP[sUnit[iuh]]+a-b
call SaveInteger(udg_hash,h,StringHash("MageRobe"),a)
endif
if UnitHasItemOfTypeBJ(hero,'I09A')then
set b=LoadInteger(udg_hash,h,StringHash("EniSphere"))
set a=18*GetHeroInt(hero,false)/100
set s__Heroes_Int[sHero[ihh]]=s__Heroes_Int[sHero[ihh]]+a-b
call SaveInteger(udg_hash,h,StringHash("EniSphere"),a)
endif
set i=0
set a=0
loop
exitwhen a>=6 or i>0
if GetItemTypeId(UnitItemInSlot(hero,a))=='I04F' then
set i=1
elseif GetItemTypeId(UnitItemInSlot(hero,a))=='I0DO' then
set i=1
endif
set a=a+1
endloop
if i==1 then
set BAttack=BAttack+R2I(1.5*highstat)
endif
if UnitHasItemOfTypeBJ(hero,'I00J')then
set BAttack=BAttack+R2I(.66*highstat)
set b=LoadInteger(udg_hash,h,StringHash("Evolvente"))
set a=(Summ_Attack(hero)-LoadInteger(udg_hash,h,StringHash("AllAttack")))/3
set s__Units_GAttack[sUnit[iuh]]=s__Units_GAttack[sUnit[iuh]]+a-b
call SaveInteger(udg_hash,h,StringHash("AllAttack"),LoadInteger(udg_hash,h,StringHash("AllAttack"))+a-b)
call SaveInteger(udg_hash,h,StringHash("Evolvente"),a)
endif
if UnitHasItemOfTypeBJ(hero,'I04D')or UnitHasItemOfTypeBJ(hero,'I0EN')then
set s=LoadStr(udg_hash,h,2)
if s=="Str" then
set a=LoadInteger(udg_hash,h,StringHash("UltCore"))
call SaveInteger(udg_hash,h,StringHash("BTStr"),LoadInteger(udg_hash,h,StringHash("BTStr"))-a)
call SetHeroStr(hero,GetHeroStr(hero,false)-a,true)
set b=GetHeroStr(hero,false)/5
set a=FixStr(b)
set b=GetHeroStr(hero,false)
if b<30 then
set a=6
endif
call SetHeroStr(hero,GetHeroStr(hero,false)+a,true)
call SaveInteger(udg_hash,h,StringHash("UltCore"),a)
call SaveInteger(udg_hash,h,StringHash("BTStr"),LoadInteger(udg_hash,h,StringHash("BTStr"))+a)
else
if s=="Agi" then
set a=LoadInteger(udg_hash,h,StringHash("UltCore"))
call SaveInteger(udg_hash,h,StringHash("BTAgi"),LoadInteger(udg_hash,h,StringHash("BTAgi"))-a)
call SetHeroAgi(hero,GetHeroAgi(hero,false)-a,true)
set a=R2I(0.2*GetHeroAgi(hero,false))
call SetHeroAgi(hero,GetHeroAgi(hero,false)+a,true)
call SaveInteger(udg_hash,h,StringHash("UltCore"),a)
call SaveInteger(udg_hash,h,StringHash("BTAgi"),LoadInteger(udg_hash,h,StringHash("BTAgi"))+a)
else
set a=LoadInteger(udg_hash,h,StringHash("UltCore"))
call SaveInteger(udg_hash,h,StringHash("BTInt"),LoadInteger(udg_hash,h,StringHash("BTInt"))-a)
call SetHeroInt(hero,GetHeroInt(hero,false)-a,true)
set a=R2I(0.2*GetHeroInt(hero,false))
call SetHeroInt(hero,GetHeroInt(hero,false)+a,true)
call SaveInteger(udg_hash,h,StringHash("UltCore"),a)
call SaveInteger(udg_hash,h,StringHash("BTInt"),LoadInteger(udg_hash,h,StringHash("BTInt"))+a)
endif
endif
endif
if IsUnitInGroup(hero,udg_ItemComplectGroup[4])then
set a=highstat-GetHeroAgi(hero,true)
if a>0 then
set BArm=BArm+a/20
endif
endif
set b=0
if UnitHasItemOfTypeBJ(hero,'I0BY')then
set b=b+22
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='kybl' then
set b=b+12
endif
if b>0 then
set a=(b*(GetHeroAgi(hero,true)/5+s__Units_Arm[sUnit[iuh]]+LoadInteger(udg_hash,h,StringHash("BaseArmore"))))/100
set s__Units_Arm[sUnit[iuh]]=s__Units_Arm[sUnit[iuh]]+a-LoadInteger(udg_hash,h,StringHash("AllArmore"))
call SaveInteger(udg_hash,h,StringHash("AllArmore"),a)
else
set s__Units_Arm[sUnit[iuh]]=s__Units_Arm[sUnit[iuh]]-LoadInteger(udg_hash,h,StringHash("AllArmore"))
call SaveInteger(udg_hash,h,StringHash("AllArmore"),0)
endif
if UnitHasItemOfTypeBJ(hero,'I070')then
set s__Units_Arm[sUnit[iuh]]=s__Units_Arm[sUnit[iuh]]-LoadInteger(udg_hash,h,StringHash("HeavyAmulet"))
set a=8*GetHeroInt(hero,true)
set b=0
set c=0
loop
exitwhen c>=6
if GetItemTypeId(UnitItemInSlot(hero,c))=='I070' then
set b=b+1
endif
set c=c+1
endloop
set b=b-1
if b>0 then
set a=(a+4*b*GetHeroInt(hero,true))/100
else
set a=a/100
endif
set s__Units_Arm[sUnit[iuh]]=s__Units_Arm[sUnit[iuh]]+a
call SaveInteger(udg_hash,h,StringHash("HeavyAmulet"),a)
endif
if UnitHasItemOfTypeBJ(hero,'I0B4')then
set PGStr=PGStr+15
set PGAgi=PGAgi+15
set PGInt=PGInt+15
endif
if UnitHasItemOfTypeBJ(hero,'I0BG')then
set PGStr=PGStr+15
set PGAgi=PGAgi+15
set PGInt=PGInt+15
endif
set a=0
set b=0
set i=0
loop
exitwhen i>5
if GetItemTypeId(UnitItemInSlot(hero,i))=='I0BP' then
set a=a+1
elseif GetItemTypeId(UnitItemInSlot(hero,i))=='I09W' then
set b=b+1
endif
set i=i+1
endloop
if a>0 then
set PGStr=PGStr+30+(a-1)*15
endif
if b>0 then
set PGStr=PGStr+25+(b-1)*15
endif
if UnitAlive(hero)then
set x=0
if GetUnitAbilityLevel(hero,'A163')==0 then
set a=0
loop
exitwhen a>5
if GetItemTypeId(UnitItemInSlot(hero,a))=='I0D9' and x<.18 then
set x=.18
elseif GetItemTypeId(UnitItemInSlot(hero,a))=='I0C9' and x<.15 then
set x=.15
elseif GetItemTypeId(UnitItemInSlot(hero,a))=='I0BV' and x<.08 then
set x=.08
endif
set a=a+1
endloop
endif
set s__Heroes_AllVamp[sHero[ihh]]=x
if LoadBoolean(udg_hash,h,StringHash("SetMage"))then
set r=30+.15*highstat
set x=s__Heroes_BarSetMage[sHero[ihh]]+r
set y=600+3*highstat
if x>y then
set s__Units_Bar[sUnit[iuh]]=s__Units_Bar[sUnit[iuh]]-s__Heroes_BarSetMage[sHero[ihh]]+y
set s__Heroes_BarSetMage[sHero[ihh]]=y
else
set s__Units_Bar[sUnit[iuh]]=s__Units_Bar[sUnit[iuh]]+r
set s__Heroes_BarSetMage[sHero[ihh]]=s__Heroes_BarSetMage[sHero[ihh]]+r
endif
if s__Units_BarE[sUnit[iuh]]==null then
set s__Units_BarE[sUnit[iuh]]=AddSpecialEffectTarget("war3mapImported\\Ubershield Blueberry.mdx",hero,"origin")
endif
endif
set r=s__Units_Bar[sUnit[iuh]]-s__Heroes_BarSetMage[sHero[ihh]]
if r>0. then
call SaveBoolean(udg_hash,h,StringHash("HaveBar"),true)
else
call SaveBoolean(udg_hash,h,StringHash("HaveBar"),false)
endif
if s__Heroes_Type[sHero[ihh]]==1 then
set i=0
set a=0
loop
exitwhen a>5 or i>0
set b=GetItemTypeId(UnitItemInSlot(hero,a))
if b=='I0DL' then
set i=1
elseif b=='I0CG' then
set i=1
endif
set a=a+1
endloop
if i==1 then
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.01*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
endif
endif
if IsUnitInGroup(hero,udg_ItemComplectGroup[5])then
set BArm=BArm+highstat/25
