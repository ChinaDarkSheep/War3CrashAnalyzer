function Trig_JassAttack_Actions takes nothing returns nothing
local unit attack=GetAttacker()
local integer ID=GetPlayerId(GetOwningPlayer(attack))+1
local unit target=GetTriggerUnit()
local unit u
local integer ha=GetHandleId(attack)
local integer a=0
local integer i2=0
local real damage
local real dmg
local real all_dmg
local real x
local real y
local real x1
local real y1
local real crit
local integer random=GetRandomInt(1,100)
local group g=CreateGroup()
if IsUnitType(attack,UNIT_TYPE_HERO)then
set all_dmg=Summ_Attack(attack)
set crit=Psych_crit(attack,1.,1.)
if IsUnitInGroup(attack,udg_ItemComplectGroup[4])then
set damage=0.05*all_dmg*crit
call SetUnitState(attack,UNIT_STATE_LIFE,GetUnitState(attack,UNIT_STATE_LIFE)+0.18*damage)
call UnitDamageTarget(attack,target,damage,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
endif
set a=0
set i2=0
loop
exitwhen a==6
if GetItemTypeId(UnitItemInSlot(attack,a))=='I0EZ' then
set i2=1
endif
set a=a+1
endloop
if i2>0 then
set damage=0.04*all_dmg*crit
set x=1.-GetUnitState(attack,UNIT_STATE_LIFE)/GetUnitState(attack,UNIT_STATE_MAX_LIFE)
set y=1.-GetUnitState(target,UNIT_STATE_LIFE)/GetUnitState(target,UNIT_STATE_MAX_LIFE)
if y>x then
set x=y
endif
set x=1.+x/1.5
set damage=GetUnitState(attack,UNIT_STATE_LIFE)+damage*x
call SetUnitState(attack,UNIT_STATE_LIFE,damage)
endif
set a=0
set i2=0
loop
exitwhen a==6
if GetItemTypeId(UnitItemInSlot(attack,a))=='I0EH' then
set i2=1
endif
set a=a+1
endloop
if i2>0 then
set damage=0.16*all_dmg*crit
set x=GetUnitX(target)
set y=GetUnitY(target)
set x1=x+175*Cos((GetUnitFacing(attack))*bj_DEGTORAD)
set y1=y+175*Sin((GetUnitFacing(attack))*bj_DEGTORAD)
set udg_Drop2=GetPlayerId(GetOwningPlayer(attack))
call GroupEnumUnitsInRange(g,x1,y1,425,Bool_Filter_ID)
call GroupRemoveUnit(g,target)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(attack,u,damage,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
call GroupRemoveUnit(g,u)
endloop
endif
if LoadStr(udg_hash,ha,3)=="Range" then
set a=0
set i2=0
loop
exitwhen a==6
if GetItemTypeId(UnitItemInSlot(attack,a))=='I09G' then
set i2=1
endif
set a=a+1
endloop
if i2>0 then
set damage=0.18*all_dmg*crit
set x=GetUnitX(target)
set y=GetUnitY(target)
set x1=x+175*Cos((GetUnitFacing(attack))*bj_DEGTORAD)
set y1=y+175*Sin((GetUnitFacing(attack))*bj_DEGTORAD)
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x1,y1,400*(1+LoadReal(udg_hash,ha,StringHash("RangeSplash"))),Bool_Filter_ID)
call GroupRemoveUnit(g,target)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitType(u,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(u,'A0XB')==0 then
call UnitDamageTarget(attack,u,damage,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
endif
call GroupRemoveUnit(g,u)
endloop
endif
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='tbsm' then
if GetOwningPlayer(target)==Player(PLAYER_NEUTRAL_AGGRESSIVE)then
set x1=0.25
else
set x1=0.15
endif
if GetUnitState(target,UNIT_STATE_LIFE)/GetUnitState(target,UNIT_STATE_MAX_LIFE)<=x1 and LoadBoolean(udg_hash,ha,StringHash("HeavyHammer"))==false and not(GetUnitAbilityLevel(target,'Arsk')==1 or IsUnitType(target,UNIT_TYPE_HERO)or(GetUnitLevel(target)>=15 and ModuloInteger(GetUnitLevel(target),5)==0))then
call SetUnitState(target,UNIT_STATE_LIFE,1)
call UnitDamageTarget(attack,target,100,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set damage=0.125*GetUnitState(target,UNIT_STATE_MAX_LIFE)
set x=GetUnitX(target)
set y=GetUnitY(target)
set udg_Drop2=GetPlayerId(GetOwningPlayer(attack))
call GroupEnumUnitsInRange(g,x,y,300,Bool_Filter_ID)
call GroupRemoveUnit(g,target)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(attack,u,damage,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
call UnitDamageTarget(attack,u,damage,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
call GroupRemoveUnit(g,u)
endloop
call Func_CD(attack,"HeavyHammer",6)
endif
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='kysn' then
set damage=4.+0.04*all_dmg
call SetUnitState(attack,UNIT_STATE_LIFE,GetUnitState(attack,UNIT_STATE_LIFE)+damage)
endif
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='brag' then
set damage=0.04*all_dmg*crit
if not(LoadStr(udg_hash,ha,3)=="Range")then
set damage=1.5*damage
endif
set x=GetUnitX(target)
set y=GetUnitY(target)
set x1=x+125*Cos((GetUnitFacing(attack))*bj_DEGTORAD)
set y1=y+125*Sin((GetUnitFacing(attack))*bj_DEGTORAD)
set udg_Drop2=GetPlayerId(GetOwningPlayer(attack))
call GroupEnumUnitsInRange(g,x1,y1,300*(1+LoadReal(udg_hash,ha,StringHash("RangeSplash"))),Bool_Filter_ID)
call GroupRemoveUnit(g,target)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitType(u,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(u,'A0XB')==0 then
call UnitDamageTarget(attack,u,damage,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
endif
call GroupRemoveUnit(g,u)
endloop
endif
if GetUnitAbilityLevel(attack,'A07R')==1 and GetUnitAbilityLevel(attack,'A0XS')==1 then
call UnitRemoveAbility(attack,'A0XS')
call TempStats(attack,0,GetHeroAgi(attack,false),0,0,0,0,PositiveDuration(attack,12))
if GetRandomInt(1,3)==1 then
set damage=12*(GetHeroStr(attack,true)+GetHeroAgi(attack,true)+GetHeroInt(attack,true))
if GetUnitAbilityLevel(attack,'A0BW')==1 then
set damage=damage*2
endif
call CreateTextTagUnitBJ("|cFFFF0000+"+I2S(R2I(damage))+" TRIPLE DMG",target,0,10.00,100,100,100,0)
else
set damage=6*(GetHeroStr(attack,true)+GetHeroAgi(attack,true)+GetHeroInt(attack,true))
if GetUnitAbilityLevel(attack,'A0BW')==1 then
set damage=damage*2
endif
call CreateTextTagUnitBJ("|cFFFF0000+"+I2S(R2I(damage))+" DMG",target,0,10.00,100,100,100,0)
endif
if GetLocalPlayer()==Player(ID-1)then
call SetTextTagVisibility(bj_lastCreatedTextTag,true)
else
call SetTextTagVisibility(bj_lastCreatedTextTag,false)
endif
call SetTextTagVelocityBJ(bj_lastCreatedTextTag,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(bj_lastCreatedTextTag,false)
call SetTextTagPermanentBJ(bj_lastCreatedTextTag,false)
call SetTextTagLifespanBJ(bj_lastCreatedTextTag,3.00)
call SetTextTagFadepointBJ(bj_lastCreatedTextTag,2.00)
call UnitDamageTarget(attack,target,damage,false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Orc\\OrcLargeDeathExplode\\OrcLargeDeathExplode.mdl",target,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodKnight.mdl",target,"head"))
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodPriest.mdl",target,"origin"))
if GetUnitAbilityLevel(attack,'A0BW')==1 then
set x=GetUnitX(target)
set y=GetUnitY(target)
set udg_Drop2=GetPlayerId(GetOwningPlayer(attack))
call GroupEnumUnitsInRange(g,x,y,350,Bool_Filter_ID)
call GroupRemoveUnit(g,target)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(attack,u,damage,false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Orc\\OrcLargeDeathExplode\\OrcLargeDeathExplode.mdl",u,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodKnight.mdl",u,"head"))
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodPriest.mdl",u,"origin"))
call GroupRemoveUnit(g,u)
endloop
endif
endif
if GetUnitAbilityLevel(attack,'A0RF')>0 then
if GetTriggerUnit()==udg_SharkTarget then
if GetUnitAbilityLevelSwapped('A0RG',udg_SharkTarget)<20 then
call IncUnitAbilityLevelSwapped('A0RG',udg_SharkTarget)
else
endif
else
call UnitRemoveAbilityBJ('A0RG',udg_SharkTarget)
set udg_SharkTarget=GetTriggerUnit()
call UnitAddAbilityBJ('A0RG',udg_SharkTarget)
endif
endif
if GetUnitAbilityLevel(attack,'A01Q')==1 then
set x=GetUnitX(GetTriggerUnit())-GetUnitX(attack)
set y=GetUnitY(GetTriggerUnit())-GetUnitY(attack)
set dmg=SquareRoot(x*x+y*y)
set a=LoadInteger(udg_hash,ha,5)
set i2=R2I(.04*GetHeroAgi(attack,false)*(0.01*dmg))
set s__Heroes_Agi[sHero[a]]=s__Heroes_Agi[sHero[a]]+i2-LoadInteger(udg_hash,ha,'d')
call SaveInteger(udg_hash,ha,'d',i2)
if UnitHasBuffBJ(GetTriggerUnit(),'B007')then
set dmg=20*GetUnitAbilityLevel(attack,'A021')+0.75*GetHeroAgi(attack,true)
if GetHeroLevel(attack)>49 then
set dmg=dmg+0.2*Summ_Attack(attack)
endif
call UnitDamageTarget(attack,target,dmg,false,true,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
call F_Stats(attack)
endif
set a=0
set i2=0
loop
exitwhen a==6
if GetItemTypeId(UnitItemInSlot(attack,a))=='I08Q' then
set i2=1
endif
set a=a+1
endloop
if i2==1 and LoadBoolean(udg_hash,ha,StringHash("KingKill"))==false then
call Func_CD(attack,"KingKill",1.6)
call HeroAttack(attack,attack,target)
call Modificator(attack,attack,target)
call HeroAttack(attack,attack,target)
call Modificator(attack,attack,target)
endif
set a=GetUnitAbilityLevel(attack,'A1F4')
if a>0 then
set dmg=5*a+.2*all_dmg
set x=4*a+.04*all_dmg
call UnitDamageTarget(attack,target,dmg,false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call SetUnitState(attack,UNIT_STATE_LIFE,GetUnitState(attack,UNIT_STATE_LIFE)+x)
if GetUnitAbilityLevel(attack,'A0BW')==1 and random<15 then
set x=GetUnitX(target)
set y=GetUnitY(target)
set udg_Drop2=GetPlayerId(GetOwningPlayer(attack))
call GroupEnumUnitsInRange(g,x,y,275,Bool_Filter_ID)
call GroupRemoveUnit(g,target)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(attack,u,dmg,false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
call GroupRemoveUnit(g,u)
endloop
endif
endif
if GetUnitAbilityLevel(attack,'A02B')>0 and random<15 then
set dmg=3+3*GetUnitAbilityLevel(attack,'A02B')
if GetHeroLevel(attack)>=50 then
set dmg=dmg+0.04*GetHeroAgi(attack,false)
endif
call TempStats(attack,0,R2I(dmg),0,0,0,0,10.)
endif
if GetUnitAbilityLevel(attack,'A00D')==1 then
if udg_Talante[ID]==1 and LoadBoolean(udg_hash,ha,StringHash("ReptF"))then
if GetRandomInt(1,10)<=2 then
call HeroAttack(attack,attack,target)
endif
endif
endif
if GetUnitAbilityLevel(attack,'A0KU')==1 and LoadBoolean(udg_hash,ha,StringHash("BersR1"))then
set dmg=.3*all_dmg
call UnitDamageTarget(attack,target,dmg,false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
set dmg=.75*dmg
set udg_Drop2=ID-1
set x=GetUnitX(target)
set y=GetUnitY(target)
call GroupEnumUnitsInRange(g,x,y,350,Bool_Filter_ID)
call GroupRemoveUnit(g,target)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(attack,u,dmg,false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
call GroupRemoveUnit(g,u)
endloop
endif
call Modificator(attack,attack,target)
call HeroAttack(attack,attack,target)
if GetUnitAbilityLevel(attack,'A1ET')==1 then
set a=LoadInteger(udg_hash,ha,StringHash("SinobyR1"))
if a==11 then
set dmg=.05*all_dmg
set crit=Psych_crit(attack,1.,1.)
if crit>1. then
set dmg=dmg*crit
endif
call UnitDamageTarget(attack,target,dmg,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
elseif a==12 and random<=40 then
call Modificator(attack,attack,target)
call HeroAttack(attack,attack,target)
endif
elseif GetUnitAbilityLevel(attack,'A1EW')==1 and random<=30 and LoadBoolean(udg_hash,ha,StringHash("BatR1"))then
call Modificator(attack,attack,target)
call HeroAttack(attack,attack,target)
endif
else
if GetUnitAbilityLevel(attack,'A0FV')==1 then
if GetRandomInt(1,3)==1 then
call HeroAttack(udg_Hero[ID],attack,target)
call Modificator(udg_Hero[ID],attack,target)
endif
call UnitDamageTarget(attack,target,Summ_Attack(udg_Hero[ID]),false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
elseif GetUnitAbilityLevel(attack,'A0RZ')==1 and GetRandomInt(1,2)==1 then
call HeroAttack(udg_Hero[ID],attack,target)
call Modificator(udg_Hero[ID],attack,target)
elseif GetUnitTypeId(attack)=='nskf' then
if udg_Talante[ID]==1 then
set x1=Summ_Attack(attack)*Psych_crit(udg_Hero[ID],1.,1.)
set damage=0.4*x1
set dmg=0.05*x1
call SetUnitState(attack,UNIT_STATE_LIFE,GetUnitState(attack,UNIT_STATE_LIFE)+0.1*x1)
call UnitDamageTarget(attack,target,dmg,false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
set x=GetUnitX(target)
set y=GetUnitY(target)
set udg_Drop2=GetPlayerId(GetOwningPlayer(attack))
call GroupEnumUnitsInRange(g,x,y,350,Bool_Filter_ID)
call GroupRemoveUnit(g,target)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(attack,u,damage,false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
call UnitDamageTarget(attack,u,dmg,false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_METAL_LIGHT_CHOP)
call GroupRemoveUnit(g,u)
endloop
elseif udg_Talante[ID]==2 and GetRandomInt(1,2)==1 then
call HeroAttack(udg_Hero[ID],attack,target)
call Modificator(udg_Hero[ID],attack,target)
endif
endif
endif
call DestroyGroup(g)
set target=null
set attack=null
set u=null
set g=null
endfunction
function InitTrig_JassAttack takes nothing returns nothing
set gg_trg_JassAttack=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_JassAttack,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(gg_trg_JassAttack,Condition(function Trig_JassAttack_Conditions))
call TriggerAddAction(gg_trg_JassAttack,function Trig_JassAttack_Actions)
endfunction
function F_LeoricSoul_Timer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer a=LoadInteger(udg_hash,ht,0)
call SetHeroStr(hero,GetHeroStr(hero,false)-a,true)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set t=null
set hero=null
endfunction
function F_LeoricSoul takes nothing returns nothing
local unit hero=UNIT
local integer h=GetHandleId(hero)
local integer a=LoadInteger(udg_hash,h,StringHash("LeoricSoul"))
local timer t
local integer ht
if a>0 then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveInteger(udg_hash,ht,0,a)
call TimerStart(t,80.,false,function F_LeoricSoul_Timer)
endif
call SaveInteger(udg_hash,h,StringHash("LeoricSoul"),0)
set t=null
set hero=null
endfunction
function ArtaR takes nothing returns nothing
local unit hero=UNIT
local integer h=GetHandleId(hero)
local integer iuh=LoadInteger(udg_hash,h,5)
local integer a
local integer b
set b=LoadInteger(udg_hash,h,StringHash("ArtRDmgAll"))
set a=(Summ_Attack(hero)-LoadInteger(udg_hash,h,StringHash("AllAttack")))/3
set s__Units_GAttack[sUnit[iuh]]=s__Units_GAttack[sUnit[iuh]]+a-b
call SaveInteger(udg_hash,h,StringHash("AllAttack"),LoadInteger(udg_hash,h,StringHash("AllAttack"))+a-b)
call SaveInteger(udg_hash,h,StringHash("ArtRDmgAll"),a)
set hero=null
endfunction
function AstralDrakQ2 takes nothing returns nothing
local unit hero=UNIT
local integer h=GetHandleId(hero)
local group g=CreateGroup()
local real x=GetUnitX(hero)
local real y=GetUnitY(hero)
local unit u
local real dmg=GetUnitAbilityLevel(hero,'A1EZ')*40+2*GetHeroInt(hero,true)
if GetHeroLevel(hero)>49 then
set dmg=dmg+GetHeroInt(hero,true)
endif
set udg_Drop2=GetPlayerId(GetOwningPlayer(hero))
call GroupEnumUnitsInRange(g,x,y,900.,Bool_Filter_ID)
set u=FirstOfGroup(g)
if u !=null and not LoadBoolean(udg_hash,h,StringHash("PassiveE"))then
call GroupClear(g)
set x=GetUnitX(u)
set y=GetUnitY(u)
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\FrostArrows\\NagaColdArrowMissile.mdl",x,y))
set udg_Drop2=GetPlayerId(GetOwningPlayer(hero))
call GroupEnumUnitsInRange(g,x,y,1200.,Bool_Filter_ID)
call GroupRemoveUnit(g,u)
set dmg=dmg*2
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
call Func_CD(hero,"PassiveE",8.)
endif
call DestroyGroup(g)
set g=null
set u=null
set hero=null
endfunction
function SfinksW takes nothing returns nothing
local unit hero=UNIT
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.005*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
call SetUnitState(hero,UNIT_STATE_MANA,GetUnitState(hero,UNIT_STATE_MANA)+0.005*GetUnitState(hero,UNIT_STATE_MAX_MANA))
set hero=null
endfunction
function Grob_D_W takes nothing returns nothing
local unit hero=UNIT
local real r
local real dmg
local group g=CreateGroup()
local unit u
if UnitAlive(hero)then
if udg_GrobRegen then
set r=(GetUnitState(hero,UNIT_STATE_MAX_LIFE)-GetUnitState(hero,UNIT_STATE_LIFE))/12.5
else
set r=(GetUnitState(hero,UNIT_STATE_MAX_LIFE)-GetUnitState(hero,UNIT_STATE_LIFE))/50.
endif
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+r)
if udg_Talante[GetPlayerId(GetOwningPlayer(hero))+1]==2 and GetHeroLevel(hero)>=50 then
set r=0.01*GetUnitState(hero,UNIT_STATE_MAX_LIFE)
set r=0.5*r
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+r)
endif
if GetUnitAbilityLevel(hero,'A0NK')==1 then
set dmg=60*GetUnitAbilityLevel(hero,'A1A2')+40
if GetHeroLevel(hero)>=50 then
set dmg=dmg+0.8*GetHeroStr(hero,true)
else
set dmg=dmg+0.4*GetHeroStr(hero,true)
endif
set r=0.3*dmg
if GetUnitState(hero,UNIT_STATE_LIFE)>r then
call UnitDamageTarget(hero,hero,r,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
else
call SetUnitState(hero,UNIT_STATE_LIFE,1.0)
endif
set udg_Drop2=GetPlayerId(GetOwningPlayer(hero))
call GroupEnumUnitsInRange(g,GetUnitX(hero),GetUnitY(hero),425.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
endif
endif
call DestroyGroup(g)
set hero=null
set u=null
set g=null
endfunction
function LichE_TImer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(hero)
local integer ihh=LoadInteger(udg_hash,h,5)
local integer a=LoadInteger(udg_hash,ht,0)
set s__Heroes_Int[sHero[ihh]]=s__Heroes_Int[sHero[ihh]]-a
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set t=null
set hero=null
endfunction
function LichPasE takes nothing returns nothing
local unit hero=UNIT
local integer h=GetHandleId(hero)
local integer iuh=LoadInteger(Hash,h,0)
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local timer t
local integer ht
local integer a=LoadInteger(udg_hash,h,StringHash("LichE"))
local real x
local real y
local unit u
local group g=CreateGroup()
if a>0 and GetUnitAbilityLevel(hero,'A19B')>0 then
call SaveInteger(udg_hash,h,StringHash("LichE"),0)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveInteger(udg_hash,ht,0,a)
call TimerStart(t,6.+6.*GetUnitAbilityLevel(hero,'A19B'),false,function LichE_TImer)
endif
if udg_Talante[ID]==3 then
set a=250+25*GetHeroLevel(hero)+udg_Miasm/2
