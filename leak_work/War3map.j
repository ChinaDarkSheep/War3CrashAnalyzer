function BatSkills_Q takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local real sec=LoadReal(udg_hash,ht,0)
local integer tic=LoadInteger(udg_hash,ht,1)+1
local integer h=GetHandleId(caster)
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local real x
local real y
local group g=CreateGroup()
local real range
local real dist=GetRandomReal(110.,430.)
local real angle=GetRandomReal(GetUnitFacing(caster)-30.,GetUnitFacing(caster)+30.)
local real dmg=(GetUnitAbilityLevel(caster,'A0TU')*30)*udg_BatDmgW
local unit u
local boolean end=false
if not UnitAlive(caster)and not(udg_Talante[ID]==2)then
set end=true
endif
if sec>0 and not end then
if udg_Talante[ID]==1 then
set dmg=(dmg+GetHeroAgi(caster,true))*1+LoadReal(udg_hash,h,StringHash("Modificator"))
elseif udg_Talante[ID]==2 then
set dmg=dmg+0.1*GetUnitState(caster,UNIT_STATE_MAX_LIFE)
endif
set sec=sec-0.4
call SaveReal(udg_hash,ht,0,sec)
if GetUnitAbilityLevel(caster,'A0UE')==1 then
set range=225.
else
set range=125.
endif
if tic==2 then
set tic=0
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,GetUnitX(caster),GetUnitY(caster),600,Bool_Filter_ID)
call RandomUnitFromGroup(1,g)
set u=FirstOfGroup(g)
set x=GetUnitX(u)
set y=GetUnitY(u)
call GroupClear(g)
else
set x=GetUnitX(caster)+dist*Cos(angle*bj_DEGTORAD)
set y=GetUnitY(caster)+dist*Sin(angle*bj_DEGTORAD)
endif
call SaveInteger(udg_hash,ht,1,tic)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl",x,y))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl",x,y))
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,range,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
call DestroyGroup(g)
set g=null
set caster=null
set u=null
set t=null
endfunction
