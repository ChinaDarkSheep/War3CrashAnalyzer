local real mana_need
local real x=GetUnitX(hero)
local real y=GetUnitY(hero)
local real dmg
local integer a
local group g=CreateGroup()
local unit u
local unit u2
if udg_Talante[ID]==2 then
set mana_need=2*(200+0.1*GetHeroInt(hero,true))
else
set mana_need=(200+0.1*GetHeroInt(hero,true))
endif
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.2*GetHeroInt(hero,true))
if UnitAlive(hero)and(GetUnitState(hero,UNIT_STATE_MANA)-mana_need)>0. and LoadBoolean(udg_hash,GetHandleId(hero),StringHash("ReptF"))then
set dmg=500.+0.75*GetHeroInt(hero,true)
call SetUnitState(hero,UNIT_STATE_MANA,GetUnitState(hero,UNIT_STATE_MANA)-0.15*GetHeroInt(hero,true))
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,400.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
if udg_Talante[ID]==2 then
set dmg=100+1.*GetHeroInt(hero,true)
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,800.,Bool_Filter_ID)
call RandomUnitFromGroup(1,g)
call SeekMinDummys()
loop
set u=FirstOfGroup(g)
exitwhen u==null
set u2=CreateUnit(GetOwningPlayer(hero),'h05G',x,y,GetUnitFacing(hero))
set a=SeekFreeDummysMin(u2,GetHandleId(u2))
set s__Dummys_dmg[sDummy[a]]=dmg
call UnitAddAbility(u2,'A1B1')
call SetUnitAbilityLevel(u2,'A1B1',5)
call IssueTargetOrder(u2,"chainlightning",u)
call UnitApplyTimedLife(u2,'BTLF',3.25)
call GroupRemoveUnit(g,u)
endloop
endif
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
call DestroyGroup(g)
set t=null
set hero=null
set u=null
set u2=null
set g=null
endfunction
function Trig_OrderJass_Actions takes nothing returns nothing
