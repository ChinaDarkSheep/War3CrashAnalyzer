function MinotaurE2 takes nothing returns nothing
local unit hero=UNIT
local integer h=GetHandleId(hero)
local integer iuh=LoadInteger(Hash,h,0)
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local real x=GetUnitX(hero)
local real y=GetUnitY(hero)
local real dmg=60*GetUnitAbilityLevel(hero,'A04L')+1.*GetHeroStr(hero,true)
local real dmg2
local group g=CreateGroup()
local group g2=CreateGroup()
local unit u
local real r=5.
if UnitAlive(hero)and not LoadBoolean(udg_hash,h,StringHash("Passive_1"))then
if GetHeroLevel(hero)>=50 then
set r=3.
set dmg=dmg+.15*GetUnitState(hero,UNIT_STATE_MAX_LIFE)
endif
set dmg2=dmg*2
set udg_Drop2=ID-1
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl",x,y))
call GroupEnumUnitsInRange(g,x,y,250.,Bool_Filter_ID)
call GroupEnumUnitsInRange(g2,x,y,350.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg2,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
call GroupRemoveUnit(g2,u)
call GroupRemoveUnit(g,u)
endloop
loop
set u=FirstOfGroup(g2)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_METAL_LIGHT_CHOP)
call GroupRemoveUnit(g2,u)
endloop
call Func_CD(hero,"Passive_1",r)
endif
call DestroyGroup(g2)
call DestroyGroup(g)
set g2=null
set g=null
set u=null
set hero=null
endfunction
