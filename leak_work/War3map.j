set s__Units_Immortal[sUnit[i]]=s__Units_Immortal[sUnit[i]]-1
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
endfunction
function Immortal takes unit u,real sec returns nothing
local timer t=CreateTimer()
local integer ht=GetHandleId(t)
local integer h=GetHandleId(u)
local integer i=LoadInteger(Hash,h,0)
