call UnitRemoveAbility(roar,'A0HY')
call UnitAddAbility(roar,'A0HY')
call SetUnitAbilityLevel(roar,'A0HY',GetUnitAbilityLevel(caster,'A0HO'))
call IssueImmediateOrder(roar,"roar")
call UnitApplyTimedLife(roar,'BTLF',2)
if sec==1 then
set roar=LoadUnitHandle(udg_hash,ht,1)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl",GetUnitX(roar),GetUnitY(roar)))
call RemoveUnit(roar)
set roar=LoadUnitHandle(udg_hash,ht,2)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl",GetUnitX(roar),GetUnitY(roar)))
call RemoveUnit(roar)
set roar=LoadUnitHandle(udg_hash,ht,3)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl",GetUnitX(roar),GetUnitY(roar)))
call RemoveUnit(roar)
set roar=LoadUnitHandle(udg_hash,ht,4)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl",GetUnitX(roar),GetUnitY(roar)))
call RemoveUnit(roar)
set roar=LoadUnitHandle(udg_hash,ht,5)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl",GetUnitX(roar),GetUnitY(roar)))
call RemoveUnit(roar)
call DestroyLightning(LoadLightningHandle(udg_hash,ht,11))
call DestroyLightning(LoadLightningHandle(udg_hash,ht,12))
call DestroyLightning(LoadLightningHandle(udg_hash,ht,13))
call DestroyLightning(LoadLightningHandle(udg_hash,ht,14))
call DestroyLightning(LoadLightningHandle(udg_hash,ht,15))
call DestroyLightning(LoadLightningHandle(udg_hash,ht,16))
call DestroyLightning(LoadLightningHandle(udg_hash,ht,17))
call DestroyLightning(LoadLightningHandle(udg_hash,ht,18))
call DestroyLightning(LoadLightningHandle(udg_hash,ht,19))
call DestroyLightning(LoadLightningHandle(udg_hash,ht,20))
endif
else
call RemoveUnit(LoadUnitHandle(udg_hash,ht,6))
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
set caster=null
set roar=null
set t=null
endfunction
function Trig_Sdren004_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit eye=LoadUnitHandle(udg_hash,ht,0)
local unit caster=LoadUnitHandle(udg_hash,ht,1)
local real sec=LoadReal(udg_hash,ht,2)
local player pl=GetOwningPlayer(caster)
local real x=GetUnitX(eye)
local real y=GetUnitY(eye)
local real heal=(80+0.25*GetHeroInt(caster,true))
local unit u
local group g=CreateGroup()
if sec>0. then
set sec=sec-0.25
call SaveReal(udg_hash,ht,2,sec)
call GroupEnumUnitsInRange(g,x,y,700.,Condition(function FilterAlive))
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitAlly(u,pl)and GetUnitAbilityLevel(u,'Avul')==0 then
call Heal(true,heal,u,caster)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Heal\\HealTarget.mdl",u,"origin"))
endif
call GroupRemoveUnit(g,u)
endloop
else
call RemoveUnit(eye)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
call DestroyGroup(g)
set caster=null
set eye=null
set u=null
set pl=null
set g=null
set t=null
endfunction
function Trig_Sdren004_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local unit u
local real x
local real y
local real x1
local real y1
local real dmg=0
local real heal=0
local group g=CreateGroup()
local location p
local location p2
local integer a=0
local integer i
local timer t
local integer ht
local unit array ur
local lightning array lr
if GetSpellAbilityId()=='A0CA' then
set dmg=200.*GetUnitAbilityLevel(caster,'A0CA')+2.*GetHeroInt(caster,true)
set heal=200.*GetUnitAbilityLevel(caster,'A0CA')+2.*GetHeroInt(caster,true)
if GetHeroLevel(caster)>=50 then
set dmg=dmg+1.*GetHeroInt(caster,true)
set heal=heal+2.*GetHeroInt(caster,true)
endif
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set p=GetUnitLoc(caster)
set a=0
set t=CreateTimer()
set ht=GetHandleId(t)
call GroupEnumUnitsInRange(g,x,y,300.,null)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)then
if IsUnitEnemy(u,GetOwningPlayer(caster))then
set p2=GetUnitLoc(u)
set bj_lastCreatedLightning=AddLightningEx("AFOD",true,GetLocationX(p),GetLocationY(p),GetLocationZ(p),GetLocationX(p2),GetLocationY(p2),GetLocationZ(p2))
call SaveLightningHandle(udg_hash,ht,a,bj_lastCreatedLightning)
call RemoveLocation(p2)
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl",u,"origin")
call SaveEffectHandle(udg_hash,ht,a+500,bj_lastCreatedEffect)
set a=a+1
else
set p2=GetUnitLoc(u)
set bj_lastCreatedLightning=AddLightningEx("HWPB",true,GetLocationX(p),GetLocationY(p),GetLocationZ(p),GetLocationX(p2),GetLocationY(p2),GetLocationZ(p2))
call SaveLightningHandle(udg_hash,ht,a,bj_lastCreatedLightning)
call RemoveLocation(p2)
call Heal(true,heal,u,caster)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Orc\\HealingWave\\HealingWaveTarget.mdl",u,"origin")
call SaveEffectHandle(udg_hash,ht,a+500,bj_lastCreatedEffect)
set a=a+1
endif
endif
call GroupRemoveUnit(g,u)
endloop
call RemoveLocation(p)
call SaveInteger(udg_hash,ht,0,a-1)
call TimerStart(t,0.35,false,function Trig_Sdren004_Q_Effects)
endif
if GetSpellAbilityId()=='A0HO' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set x1=x+400*Cos(10*bj_DEGTORAD)
set y1=y+400*Sin(10*bj_DEGTORAD)
set ur[1]=CreateUnit(GetOwningPlayer(caster),'h009',x1,y1,bj_UNIT_FACING)
set x1=x+400*Cos(90*bj_DEGTORAD)
set y1=y+400*Sin(90*bj_DEGTORAD)
set ur[2]=CreateUnit(GetOwningPlayer(caster),'h009',x1,y1,bj_UNIT_FACING)
set x1=x+400*Cos(170*bj_DEGTORAD)
set y1=y+400*Sin(170*bj_DEGTORAD)
set ur[3]=CreateUnit(GetOwningPlayer(caster),'h009',x1,y1,bj_UNIT_FACING)
set x1=x+400*Cos(240*bj_DEGTORAD)
set y1=y+400*Sin(240*bj_DEGTORAD)
set ur[4]=CreateUnit(GetOwningPlayer(caster),'h009',x1,y1,bj_UNIT_FACING)
set x1=x+400*Cos(300*bj_DEGTORAD)
set y1=y+400*Sin(300*bj_DEGTORAD)
set ur[5]=CreateUnit(GetOwningPlayer(caster),'h009',x1,y1,bj_UNIT_FACING)
set u=CreateUnit(GetOwningPlayer(caster),'h009',x,y,bj_UNIT_FACING)
set lr[1]=AddLightning("AFOD",true,GetUnitX(ur[1]),GetUnitY(ur[1]),GetUnitX(ur[2]),GetUnitY(ur[2]))
set lr[2]=AddLightning("AFOD",true,GetUnitX(ur[1]),GetUnitY(ur[1]),GetUnitX(ur[3]),GetUnitY(ur[3]))
set lr[3]=AddLightning("AFOD",true,GetUnitX(ur[1]),GetUnitY(ur[1]),GetUnitX(ur[4]),GetUnitY(ur[4]))
set lr[4]=AddLightning("AFOD",true,GetUnitX(ur[1]),GetUnitY(ur[1]),GetUnitX(ur[5]),GetUnitY(ur[5]))
set lr[5]=AddLightning("AFOD",true,GetUnitX(ur[2]),GetUnitY(ur[2]),GetUnitX(ur[3]),GetUnitY(ur[3]))
set lr[6]=AddLightning("AFOD",true,GetUnitX(ur[2]),GetUnitY(ur[2]),GetUnitX(ur[4]),GetUnitY(ur[4]))
set lr[7]=AddLightning("AFOD",true,GetUnitX(ur[2]),GetUnitY(ur[2]),GetUnitX(ur[5]),GetUnitY(ur[5]))
set lr[8]=AddLightning("AFOD",true,GetUnitX(ur[3]),GetUnitY(ur[3]),GetUnitX(ur[4]),GetUnitY(ur[4]))
set lr[9]=AddLightning("AFOD",true,GetUnitX(ur[3]),GetUnitY(ur[3]),GetUnitX(ur[5]),GetUnitY(ur[5]))
set lr[10]=AddLightning("AFOD",true,GetUnitX(ur[4]),GetUnitY(ur[4]),GetUnitX(ur[5]),GetUnitY(ur[5]))
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveInteger(udg_hash,ht,0,4)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveUnitHandle(udg_hash,ht,6,u)
call SaveUnitHandle(udg_hash,ht,1,ur[1])
call SaveUnitHandle(udg_hash,ht,2,ur[2])
call SaveUnitHandle(udg_hash,ht,3,ur[3])
call SaveUnitHandle(udg_hash,ht,4,ur[4])
call SaveUnitHandle(udg_hash,ht,5,ur[5])
call SaveLightningHandle(udg_hash,ht,11,lr[1])
