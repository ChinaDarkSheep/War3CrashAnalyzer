function Trig_SkillOFF_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local unit u
local group g=CreateGroup()
local real x
local real y
local real dmg
if GetSpellAbilityId()=='A0ER' then
set udg_KrabUlt=false
endif
if GetSpellAbilityId()=='A0CB' then
call PauseTimerBJ(true,udg_MagnR)
endif
if GetSpellAbilityId()=='A183' then
call DestroyTextTagBJ(udg_TaurenPristText)
call PauseTimerBJ(true,udg_TaurenPristT)
if LoadBoolean(udg_hash,GetHandleId(caster),'f')==false then
set dmg=((200.00+(1.60*I2R(GetHeroStatBJ(bj_HEROSTAT_INT,udg_TaurenPrist,true))))*udg_TaurenPristHeal)
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,900.,Bool_Filter_ID_Ally)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitType(u,UNIT_TYPE_HERO)and GetUnitTypeId(caster)!='O00Z' then
call Heal(true,2.5*dmg,u,udg_TaurenPrist)
else
call Heal(true,dmg,u,udg_TaurenPrist)
endif
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl",u,"original")
call DestroyEffect(bj_lastCreatedEffect)
call GroupRemoveUnit(g,u)
endloop
call CreateTextTagUnitBJ((I2S((R2I(udg_TaurenPristHeal)*100))+"%"),udg_TaurenPrist,0,14.00,100.00,35.00,0.00,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,90.00)
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
endif
call SaveBoolean(udg_hash,GetHandleId(caster),'f',true)
endif
call DestroyGroup(g)
set caster=null
set u=null
set g=null
endfunction
function InitTrig_SkillOFF takes nothing returns nothing
set gg_trg_SkillOFF=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_SkillOFF,EVENT_PLAYER_UNIT_SPELL_ENDCAST)
call TriggerAddAction(gg_trg_SkillOFF,function Trig_SkillOFF_Actions)
endfunction
function Dryad_Q takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local real sec=LoadReal(udg_hash,ht,0)
local unit dummy=LoadUnitHandle(udg_hash,ht,1)
local real x=GetUnitX(dummy)
local real y=GetUnitY(dummy)
local group g=CreateGroup()
local group g2=LoadGroupHandle(udg_hash,ht,2)
local unit u
local real dmg=LoadReal(udg_hash,ht,1)
if sec>0 then
call SaveReal(udg_hash,ht,0,sec-.2)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,200.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if not IsUnitInGroup(u,g2)then
call GroupAddUnit(g2,u)
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'h009',x,y,0.)
call UnitAddAbility(bj_lastCreatedUnit,'A0HF')
call SetUnitAbilityLevel(bj_lastCreatedUnit,'A0HF',GetUnitAbilityLevel(caster,'A0HE'))
call IssueTargetOrder(bj_lastCreatedUnit,"faeriefire",u)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',0.5)
endif
call GroupRemoveUnit(g,u)
endloop
else
call DestroyGroup(g2)
call RemoveUnit(dummy)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
call DestroyGroup(g)
set g=null
set g2=null
set caster=null
set dummy=null
set u=null
set t=null
endfunction
function Trig_JassAttack_Conditions takes nothing returns boolean
if(not(IsUnitEnemy(GetTriggerUnit(),GetOwningPlayer(GetAttacker()))))then
return false
endif
if(not(udg_AbuseAttack[GetPlayerId(GetOwningPlayer(GetAttacker()))+1]<=0))then
return false
endif
return true
endfunction
function Bat_E1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit attack=LoadUnitHandle(udg_hash,ht,0)
local integer sec=LoadInteger(udg_hash,ht,0)
local real x=LoadReal(udg_hash,ht,1)
local real y=LoadReal(udg_hash,ht,2)
local real dmg=LoadReal(udg_hash,ht,3)
local group g=CreateGroup()
local unit u
if sec>0 then
set sec=sec-1
call SaveInteger(udg_hash,ht,0,sec)
set udg_Drop2=GetPlayerId(GetOwningPlayer(attack))
call GroupEnumUnitsInRange(g,x,y,600,Bool_Filter_ID)
call RandomUnitFromGroup(1,g)
set u=FirstOfGroup(g)
call GroupClear(g)
set udg_Drop2=GetPlayerId(GetOwningPlayer(attack))
set x=GetUnitX(u)
set y=GetUnitY(u)
call GroupEnumUnitsInRange(g,x,y,225.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(attack,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl",x,y))
else
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
set t=null
call DestroyGroup(g)
set g=null
set attack=null
set u=null
endfunction
function BersE takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit attack=LoadUnitHandle(udg_hash,ht,0)
local unit target=LoadUnitHandle(udg_hash,ht,1)
local real sec=LoadReal(udg_hash,ht,2)
local real dmg=LoadReal(udg_hash,ht,3)
if sec>0 and UnitAlive(target)then
set sec=sec-0.5
call SaveReal(udg_hash,ht,2,sec)
call GroupDamage_e(GetUnitX(target),GetUnitY(target),300,attack,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,"Abilities\\Spells\\Items\\OrbVenom\\OrbVenomSpecialArt.mdl")
else
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
set t=null
set attack=null
set target=null
endfunction
