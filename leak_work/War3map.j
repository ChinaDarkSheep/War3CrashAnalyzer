function PlayerGetEXP takes integer exp returns nothing
local integer a=(exp*100)/(250+40*udg_PN)
local integer l=1
if HardcoreLvl==2 then
set a=4*a/3
elseif HardcoreLvl==3 then
set a=2*a
endif
loop
exitwhen l>8
set udg_PlayerExp[l]=udg_PlayerExp[l]+a
call DisplayTimedTextToForce(bj_FORCE_PLAYER[l-1],60.00,"|cFF20C6CDВам начислено "+I2S(a)+" очков! Вы можете ввести \"-save\" чтобы сохранить их. Подробнее об этом в \"Справке\" (F9)|r")
set l=l+1
endloop
endfunction
function GetRandomItemInList takes integer max,integer need returns nothing
local integer i=0
local integer a=0
loop
exitwhen i>max
set random_list_helper[i]=i
set i=i+1
endloop
loop
exitwhen a>=need
if a !=max then
set i=GetRandomInt(0,max-1)
else
set i=max-1
endif
set random_list[a]=random_list_helper[i]
set random_list_helper[i]=random_list_helper[max-1]
set max=max-1
set a=a+1
endloop
endfunction
function FixStr takes integer num returns integer
local integer a=0
if num>18 then
set a=num
elseif num>17 then
set a=18
elseif num>16 then
set a=17
elseif num>15 then
set a=16
elseif num>14 then
set a=15
elseif num>13 then
set a=14
elseif num>12 then
set a=13
elseif num>11 then
set a=12
elseif num>10 then
set a=11
elseif num>9 then
set a=10
elseif num>8 then
set a=9
elseif num>7 then
set a=8
elseif num>6 then
set a=7
elseif num>5 then
set a=6
elseif num>4 then
set a=5
elseif num>3 then
set a=4
elseif num>2 then
set a=3
elseif num>1 then
set a=2
elseif num>0 then
set a=1
else
set a=0
endif
return a
endfunction
function Trig_killer_Euphoria_Timer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(hero)
local real sec=LoadReal(udg_hash,ht,1)
local integer i=LoadInteger(Hash,h,0)
if sec>0 then
set sec=sec-0.05
call SaveReal(udg_hash,ht,1,sec)
else
call SaveInteger(udg_hash,h,StringHash("Euphoria"),LoadInteger(udg_hash,h,StringHash("Euphoria"))-1)
call DestroyEffect(LoadEffectHandle(udg_hash,ht,2))
if LoadInteger(udg_hash,h,StringHash("Euphoria"))==0 then
set s__Units_AllDmg[sUnit[i]]=s__Units_AllDmg[sUnit[i]]-1000
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
call SaveTimerHandle(udg_hash,h,'f',null)
endif
set hero=null
set t=null
endfunction
function Trig_killer_Euphoria takes unit hero,real sec returns nothing
local integer h=GetHandleId(hero)
local integer ht
local timer Euphoria=LoadTimerHandle(udg_hash,h,'f')
local integer i=LoadInteger(Hash,h,0)
if Euphoria==null then
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIsp\\SpeedTarget.mdl",hero,"overhead")
set Euphoria=CreateTimer()
if LoadInteger(udg_hash,h,StringHash("Euphoria"))==0 then
set s__Units_AllDmg[sUnit[i]]=s__Units_AllDmg[sUnit[i]]+1000
endif
call SaveTimerHandle(udg_hash,h,'f',Euphoria)
call SaveInteger(udg_hash,h,StringHash("Euphoria"),LoadInteger(udg_hash,h,StringHash("Euphoria"))+1)
set ht=GetHandleId(Euphoria)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveReal(udg_hash,ht,1,sec)
call SaveEffectHandle(udg_hash,ht,2,bj_lastCreatedEffect)
call TimerStart(Euphoria,0.05,true,function Trig_killer_Euphoria_Timer)
else
set ht=GetHandleId(LoadTimerHandle(udg_hash,h,'f'))
call SaveReal(udg_hash,ht,1,sec)
endif
set Euphoria=null
endfunction
function Pick_Item takes integer ID,integer it1,integer it2,integer it3,integer it4,integer it5,integer it6,boolean safe returns nothing
local integer a=0
if it1==0 and it2==0 and it3==0 and it4==0 and it5==0 and it6==0 then
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"|c00FF0000Вы не можете получить предмет. Произошла какая-то ошибка|r")
elseif pick_item[ID]==false then
set pick_item[ID]=true
call ShowUnit(pick_unit[ID],true)
if safe then
call SaveBoolean(udg_hash,GetHandleId(pick_unit[ID]),StringHash("save"),true)
else
call SaveBoolean(udg_hash,GetHandleId(pick_unit[ID]),StringHash("save"),false)
endif
if it1 !=0 then
set bj_lastCreatedItem=CreateItem(it1,GetUnitX(pick_unit[ID]),GetUnitY(pick_unit[ID]))
call UnitAddItem(pick_unit[ID],bj_lastCreatedItem)
else
set bj_lastCreatedItem=CreateItem('I09I',GetUnitX(pick_unit[ID]),GetUnitY(pick_unit[ID]))
call UnitAddItem(pick_unit[ID],bj_lastCreatedItem)
endif
if it2 !=0 then
set bj_lastCreatedItem=CreateItem(it2,GetUnitX(pick_unit[ID]),GetUnitY(pick_unit[ID]))
call UnitAddItem(pick_unit[ID],bj_lastCreatedItem)
else
set bj_lastCreatedItem=CreateItem('I09I',GetUnitX(pick_unit[ID]),GetUnitY(pick_unit[ID]))
call UnitAddItem(pick_unit[ID],bj_lastCreatedItem)
endif
if it3 !=0 then
set bj_lastCreatedItem=CreateItem(it3,GetUnitX(pick_unit[ID]),GetUnitY(pick_unit[ID]))
call UnitAddItem(pick_unit[ID],bj_lastCreatedItem)
else
set bj_lastCreatedItem=CreateItem('I09I',GetUnitX(pick_unit[ID]),GetUnitY(pick_unit[ID]))
call UnitAddItem(pick_unit[ID],bj_lastCreatedItem)
endif
if it4 !=0 then
set bj_lastCreatedItem=CreateItem(it4,GetUnitX(pick_unit[ID]),GetUnitY(pick_unit[ID]))
call UnitAddItem(pick_unit[ID],bj_lastCreatedItem)
else
set bj_lastCreatedItem=CreateItem('I09I',GetUnitX(pick_unit[ID]),GetUnitY(pick_unit[ID]))
call UnitAddItem(pick_unit[ID],bj_lastCreatedItem)
endif
if it5 !=0 then
set bj_lastCreatedItem=CreateItem(it5,GetUnitX(pick_unit[ID]),GetUnitY(pick_unit[ID]))
call UnitAddItem(pick_unit[ID],bj_lastCreatedItem)
else
set bj_lastCreatedItem=CreateItem('I09I',GetUnitX(pick_unit[ID]),GetUnitY(pick_unit[ID]))
call UnitAddItem(pick_unit[ID],bj_lastCreatedItem)
endif
if it6 !=0 then
set bj_lastCreatedItem=CreateItem(it6,GetUnitX(pick_unit[ID]),GetUnitY(pick_unit[ID]))
call UnitAddItem(pick_unit[ID],bj_lastCreatedItem)
else
set bj_lastCreatedItem=CreateItem('I09I',GetUnitX(pick_unit[ID]),GetUnitY(pick_unit[ID]))
call UnitAddItem(pick_unit[ID],bj_lastCreatedItem)
endif
set bj_forLoopAIndex=0
loop
exitwhen bj_forLoopAIndex==6
if UnitItemInSlot(pick_unit[ID],bj_forLoopAIndex)==null then
set bj_lastCreatedItem=CreateItem('I09I',GetUnitX(pick_unit[ID]),GetUnitY(pick_unit[ID]))
call UnitAddItem(pick_unit[ID],bj_lastCreatedItem)
endif
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
if GetLocalPlayer()==Player(ID-1)then
call ClearSelection()
call SelectUnit(pick_unit[ID],true)
endif
endif
endfunction
function Floor takes real r returns integer
local integer i=R2I(r)
if r>0. then
return i
endif
return i-1
endfunction
function Ceil takes real r returns integer
local integer i=R2I(r)
if r<0. then
return i
endif
return i+1
endfunction
function R2Idown takes real r returns integer
local integer i=Floor(r)
if r-i==1. then
return i+1
endif
return i
endfunction
function R2Iup takes real r returns integer
local integer i=Floor(r)
if r==i then
return i
endif
return i+1
endfunction
function DebugMsg takes string s returns nothing
call DisplayTimedTextToPlayer(GetLocalPlayer(),0.,0.,5.,s)
endfunction
function Psych_crit takes unit u,real power,real change returns real
local integer ID=GetPlayerId(GetOwningPlayer(u))+1
local real crit=0.
local real r=0
local integer i
local integer a
local integer finchange=R2I(100./change)
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='afac' then
if GetRandomInt(1,10)<=2 then
set crit=20.
endif
endif
set a=GetUnitAbilityLevel(u,'A071')
if a>0 then
set i=GetRandomInt(1,finchange)
if i<=(6+6*a)then
set crit=20.
endif
endif
set a=GetUnitAbilityLevel(u,'A0AJ')
if a>0 then
set i=GetRandomInt(1,finchange)
if i<=15 then
set crit=20.+20.*I2R(a)
endif
endif
set a=GetUnitAbilityLevel(u,'Acdb')
if a>0 then
set i=GetRandomInt(1,finchange)
if i<=15 then
set crit=200.
endif
endif
set a=GetUnitAbilityLevel(u,'A0FC')
if a>0 then
set i=GetRandomInt(1,finchange)
if i<=15 then
set crit=200.
endif
endif
set a=GetUnitAbilityLevel(u,'A05H')
if a>0 then
set i=GetRandomInt(1,finchange)
if i<=(5+5*a)then
set crit=200.*I2R(a)
endif
endif
set a=GetUnitAbilityLevel(u,'A0PU')-1
if a>0 then
set i=GetRandomInt(1,finchange)
if i<=20 then
set crit=160.+40.*I2R(a)
endif
endif
set a=GetUnitAbilityLevel(u,'A0H6')-1
if a>0 then
set i=GetRandomInt(1,finchange)
if i<=23 then
set crit=200.
endif
endif
set a=0
loop
exitwhen a>5
if crit<200. then
if GetItemTypeId(UnitItemInSlot(u,a))=='I093' then
if GetRandomInt(1,finchange)<=35 then
set crit=200.
endif
endif
if GetItemTypeId(UnitItemInSlot(u,a))=='I0AD' then
if GetRandomInt(1,finchange)<=35 then
set crit=200.
endif
endif
if GetItemTypeId(UnitItemInSlot(u,a))=='I0BK' then
if GetRandomInt(1,finchange)<=40 then
set crit=200.
endif
endif
else
if crit<500. then
if GetItemTypeId(UnitItemInSlot(u,a))=='I07X' then
if GetRandomInt(1,finchange)<=16 then
set crit=500.
endif
endif
endif
endif
set a=a+1
endloop
set crit=crit/100
set crit=crit*power+1.
return crit
endfunction
function SPawnStackItem_Func takes nothing returns nothing
if GetItemTypeId(GetEnumItem())==udg_Drop and udg_Drop3==1 then
set udg_Drop3=0
call SetItemCharges(GetEnumItem(),GetItemCharges(GetEnumItem())+udg_Drop2)
endif
endfunction
function SPawnStackItem takes integer name,integer num,real x,real y returns nothing
local rect RRect=Rect(x-800,y-800,x+800,y+800)
set udg_Drop=name
set udg_Drop2=num
set udg_Drop3=1
call EnumItemsInRect(RRect,null,function SPawnStackItem_Func)
if udg_Drop3==1 then
set bj_lastCreatedItem=CreateItem(name,x,y)
call SetItemCharges(bj_lastCreatedItem,num)
endif
call RemoveRect(RRect)
set RRect=null
endfunction
function PositiveDuration takes unit u,real sec returns real
local integer i=0
local integer a=0
loop
exitwhen a>5
if GetItemTypeId(UnitItemInSlot(u,a))=='I08I' then
set i=1
set a=6
endif
set a=a+1
endloop
if i>0 then
set sec=1.4*sec
endif
return sec
endfunction
function Summ_Attack takes unit u returns integer
local integer ha=GetHandleId(u)
local integer ihu=LoadInteger(udg_hash,ha,5)
local integer iuu=LoadInteger(Hash,ha,0)
local real dmg=0
if LoadStr(udg_hash,ha,2)=="Str" then
set dmg=GetHeroStr(u,true)
else
if LoadStr(udg_hash,ha,2)=="Agi" then
set dmg=GetHeroAgi(u,true)
else
set dmg=GetHeroInt(u,true)
endif
endif
if GetPlayerTechCount(GetOwningPlayer(u),'R032',true)>0 then
set dmg=dmg+50*GetPlayerTechCount(GetOwningPlayer(u),'R032',true)
elseif GetPlayerTechCount(GetOwningPlayer(u),'R027',true)>0 then
set dmg=dmg+85*GetPlayerTechCount(GetOwningPlayer(u),'R027',true)
elseif GetPlayerTechCount(GetOwningPlayer(u),'R01B',true)>0 then
set dmg=dmg+90*GetPlayerTechCount(GetOwningPlayer(u),'R01B',true)
endif
set dmg=s__Units_GAttack[sUnit[iuu]]+(dmg+s__Heroes_BaseDmg[sHero[ihu]])*LoadReal(udg_hash,ha,4)
return R2I(dmg)
endfunction
function IsBoss takes unit u returns boolean
if IsUnitType(u,UNIT_TYPE_HERO)==true then
return true
endif
if GetUnitLevel(u)>=15 and ModuloInteger(GetUnitLevel(u),5)==0 then
return true
endif
return false
endfunction
function B2S takes boolean b returns string
if b==true then
return "True"
endif
if b==false then
return "False"
endif
return "Nothing"
endfunction
