function Trig_HELLUD_Actions takes nothing returns nothing
local group g=CreateGroup()
if udg_CreepsAmount<500 then
call GroupEnumUnitsInRect(g,GetWorldBounds(),Condition(function Trig_HELLUD_FCrypt))
call ForGroup(g,function Trig_HELLUD_GCrypt)
call GroupClear(g)
call GroupEnumUnitsInRect(g,GetWorldBounds(),Condition(function Trig_HELLUD_FButcher))
call ForGroup(g,function Trig_HELLUD_GButcher)
else
endif
call ForGroup(udg_A1,function Trig_MoveAttackers_Func001A)
call DestroyGroup(g)
set g=null
endfunction
