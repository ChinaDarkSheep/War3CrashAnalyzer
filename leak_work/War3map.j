function Trig_SpiritSkills_Actions takes nothing returns nothing
local integer i=1
local unit u
local group g=CreateGroup()
local real x
local real y
local real x1
local real y1
local real dmg
local timer t
local integer talante=udg_Talante[GetPlayerId(GetOwningPlayer(udg_SpiritWalker))+1]
if GetSpellAbilityId()=='A0R8' then
if GetUnitAbilityLevel(udg_SpiritWalker,'A0WP')==1 then
set x=0.2
else
set x=0.17
endif
set i=1
loop
exitwhen i>8
if UnitAlive(udg_Hero[i])then
call SetUnitState(udg_Hero[i],UNIT_STATE_LIFE,GetUnitState(udg_Hero[i],UNIT_STATE_LIFE)+x*GetUnitState(udg_Hero[i],UNIT_STATE_MAX_LIFE))
call SetUnitState(udg_Hero[i],UNIT_STATE_MANA,GetUnitState(udg_Hero[i],UNIT_STATE_MANA)+x*GetUnitState(udg_Hero[i],UNIT_STATE_MAX_MANA))
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIre\\AIreTarget.mdl",udg_Hero[i],"origin")
call DestroyEffect(bj_lastCreatedEffect)
endif
set i=i+1
endloop
if talante==1 then
set i=GetHeroLevel(udg_SpiritWalker)
if GetHeroLevel(udg_SpiritWalker)>49 then
set i=i+GetHeroInt(udg_SpiritWalker,false)/4
endif
call TempStats(udg_SpiritWalker,i,i,0,0,0,0,PositiveDuration(GetTriggerUnit(),10))
endif
else
endif
if GetSpellAbilityId()=='A0R9' then
set u=GetSpellTargetUnit()
set dmg=GetHeroInt(udg_SpiritWalker,true)
set x=GetUnitX(u)
set y=GetUnitY(u)
call GroupEnumUnitsInRange(g,x,y,250.,Condition(function Trig_SpiritSkills_Filter))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(udg_SpiritWalker,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
call GroupAddUnit(udg_SpiritE,u)
endloop
call GroupClear(g)
if talante==2 then
set dmg=4.*GetHeroInt(udg_SpiritWalker,true)
if GetHeroLevel(udg_SpiritWalker)>49 then
set dmg=1.5*dmg
endif
set u=GetSpellTargetUnit()
call UnitDamageTarget(udg_SpiritWalker,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set dmg=0.75*dmg
call GroupEnumUnitsInRange(g,x,y,250.,Condition(function Trig_SpiritSkills_Filter))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(udg_SpiritWalker,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
endif
set t=CreateTimer()
call TimerStart(t,5.9,false,function Trig_SpiritSkills_TimerE)
endif
if GetSpellAbilityId()=='A0RB' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
call GroupEnumUnitsInRange(g,x,y,300.,Condition(function Trig_SpiritSkills_Filter))
if talante==2 then
if GetHeroLevel(udg_SpiritWalker)>=50 then
set dmg=8.*GetHeroInt(udg_SpiritWalker,true)
else
set dmg=4.*GetHeroInt(udg_SpiritWalker,true)
endif
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(udg_SpiritWalker,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitAddAbility(u,'A0RC')
call SetUnitAbilityLevel(u,'A0RC',GetUnitAbilityLevel(udg_SpiritWalker,'A0RB'))
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualTarget.mdl",u,"origin")
call DestroyEffect(bj_lastCreatedEffect)
call GroupAddUnit(udg_SpiritQ,u)
call GroupRemoveUnit(g,u)
endloop
else
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitAddAbility(u,'A0RC')
call SetUnitAbilityLevel(u,'A0RC',GetUnitAbilityLevel(udg_SpiritWalker,'A0RB'))
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualTarget.mdl",u,"origin")
call DestroyEffect(bj_lastCreatedEffect)
call GroupAddUnit(udg_SpiritQ,u)
call GroupRemoveUnit(g,u)
endloop
endif
set t=CreateTimer()
call TimerStart(t,12.,false,function Trig_SpiritSkills_TimerQ)
endif
if GetSpellAbilityId()=='A0RD' then
set i=1
set dmg=0
loop
exitwhen i>8
if udg_Hero[i]!=null then
set dmg=dmg+.30*GetHeroInt(udg_Hero[i],true)
endif
set i=i+1
endloop
set i=R2I(dmg+0.7*GetHeroInt(udg_SpiritWalker,false))
call TempStats(udg_SpiritWalker,0,0,i,0,0,0,PositiveDuration(GetTriggerUnit(),16))
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIil\\AIilTarget.mdl",udg_SpiritWalker,"origin")
call DestroyEffect(bj_lastCreatedEffect)
call SetUnitVertexColorBJ(udg_SpiritWalker,50.00,30.00,85.00,30.00)
set t=CreateTimer()
call TimerStart(t,16.,false,function Trig_SpiritSkills_TimerR)
endif
if GetSpellAbilityId()=='A0RA' then
set dmg=100*GetUnitAbilityLevel(udg_SpiritWalker,'A0RA')+GetHeroInt(udg_SpiritWalker,true)
if talante==2 then
set dmg=1.5*dmg
endif
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
call GroupEnumUnitsInRange(g,x,y,275.,Condition(function Trig_SpiritSkills_Filter))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(udg_SpiritWalker,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
call TriggerSleepAction(0.1)
set i=1
loop
exitwhen i>6
set x1=x+250*Cos((60*i)*bj_DEGTORAD)
set y1=y+250*Sin((60*i)*bj_DEGTORAD)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl",x1,y1)
call DestroyEffect(bj_lastCreatedEffect)
call GroupEnumUnitsInRange(g,x1,y1,275.,Condition(function Trig_SpiritSkills_Filter))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(udg_SpiritWalker,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
set i=i+1
endloop
call TriggerSleepAction(0.1)
set i=1
loop
exitwhen i>6
set x1=x+375*Cos((60*i)*bj_DEGTORAD)
set y1=y+375*Sin((60*i)*bj_DEGTORAD)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl",x1,y1)
call DestroyEffect(bj_lastCreatedEffect)
call GroupEnumUnitsInRange(g,x1,y1,275.,Condition(function Trig_SpiritSkills_Filter))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(udg_SpiritWalker,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
set i=i+1
endloop
call TriggerSleepAction(0.1)
set i=1
loop
exitwhen i>6
set x1=x+500*Cos((60*i)*bj_DEGTORAD)
set y1=y+500*Sin((60*i)*bj_DEGTORAD)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl",x1,y1)
call DestroyEffect(bj_lastCreatedEffect)
call GroupEnumUnitsInRange(g,x1,y1,275.,Condition(function Trig_SpiritSkills_Filter))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(udg_SpiritWalker,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
set i=i+1
endloop
call TriggerSleepAction(0.1)
set i=1
loop
exitwhen i>6
set x1=x+625*Cos((60*i)*bj_DEGTORAD)
set y1=y+625*Sin((60*i)*bj_DEGTORAD)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl",x1,y1)
call DestroyEffect(bj_lastCreatedEffect)
call GroupEnumUnitsInRange(g,x1,y1,275.,Condition(function Trig_SpiritSkills_Filter))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(udg_SpiritWalker,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
set i=i+1
endloop
endif
call DestroyGroup(g)
set u=null
set g=null
set t=null
endfunction
function InitTrig_SpiritSkills takes nothing returns nothing
set gg_trg_SpiritSkills=CreateTrigger()
call TriggerAddAction(gg_trg_SpiritSkills,function Trig_SpiritSkills_Actions)
endfunction
function Trig_SharkSkills_Filter takes nothing returns boolean
return(UnitAlive(GetFilterUnit())and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(GetTriggerUnit()))and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false)
endfunction
function Trig_SharkSkills_Pause_ON takes nothing returns nothing
call PauseUnit(GetEnumUnit(),true)
endfunction
function Trig_SharkSkills_Pause_OFF takes nothing returns nothing
call PauseUnit(GetEnumUnit(),false)
endfunction
function Trig_SharkSkills_W takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer i=LoadInteger(udg_hash,ht,1)
local group g=LoadGroupHandle(udg_hash,ht,2)
local group g2=CreateGroup()
local unit u
local integer a=0
local integer limmod=4
local integer modificator=3
local real dmg=GetUnitAbilityLevel(caster,'A0RI')*40+GetHeroStr(caster,true)
if i<=0 then
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
call DestroyGroup(g2)
call SetUnitTimeScale(caster,1.)
call PauseUnit(caster,false)
call UnitRemoveAbility(caster,'A0JN')
call ForGroup(g,function Trig_SharkSkills_Pause_OFF)
else
set i=i-1
call SaveInteger(udg_hash,ht,1,i)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)then
set a=a+1
call UnitDamageTarget(caster,u,0.8*dmg,false,true,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(caster,u,0.2*dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
if ModuloInteger(i,modificator)==0 and limmod>0 then
call Modificator(caster,caster,u)
call HeroAttack(caster,caster,u)
set limmod=limmod-1
endif
call GroupAddUnit(g2,u)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodFootman.mdl",u,"head")
call DestroyEffect(bj_lastCreatedEffect)
set udg_Drop=GetRandomInt(1,3)
if udg_Drop==1 then
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",u,"chest")
call DestroyEffect(bj_lastCreatedEffect)
endif
if udg_Drop==2 then
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\Orc\\OrcSmallDeathExplode\\OrcSmallDeathExplode.mdl",u,"chest")
call DestroyEffect(bj_lastCreatedEffect)
endif
if udg_Drop==3 then
set bj_lastCreatedEffect=AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodPriest.mdl",u,"chest")
call DestroyEffect(bj_lastCreatedEffect)
endif
endif
call GroupRemoveUnit(g,u)
endloop
endif
if a==0 or UnitAlive(caster)==false then
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
call DestroyGroup(g2)
call SetUnitTimeScale(caster,1.)
call PauseUnit(caster,false)
call UnitRemoveAbility(caster,'A0JN')
call ForGroup(g,function Trig_SharkSkills_Pause_OFF)
else
call SaveGroupHandle(udg_hash,ht,2,g2)
call SetUnitAnimation(caster,"attack")
call SetUnitLifeBJ(caster,(GetUnitStateSwap(UNIT_STATE_LIFE,caster)+(dmg/3.00)))
endif
call DestroyGroup(g)
set t=null
set caster=null
set u=null
set g=null
set g2=null
endfunction
function Trig_SharkSkills_R2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(caster)
local integer i=LoadInteger(Hash,h,0)
set s__Units_AllDmg[sUnit[i]]=s__Units_AllDmg[sUnit[i]]-2500
set s__Units_MageBlock[sUnit[i]]=s__Units_MageBlock[sUnit[i]]-2500
call CreateTextTagUnitBJ("Эффект рома спал",caster,0,11.00,60.00,0.00,100.00,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
set caster=null
endfunction
function Trig_SharkSkills_R3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer i=GetPlayerId(GetOwningPlayer(caster))+1
set udg_HeroGoldMax[i]=(udg_HeroGoldMax[i]-0.5)
set udg_HeroGold[i]=(udg_HeroGold[i]-0.25)
call CreateTextTagUnitBJ("Эффект рома спал",caster,0,11.00,60.00,0.00,100.00,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
set caster=null
endfunction
function Trig_SharkSkills_R_ALL takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(caster)
call CreateTextTagUnitBJ("Эффект рома спал",caster,0,11.00,60.00,0.00,100.00,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
set caster=null
endfunction
function Trig_SharkSkills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer h=GetHandleId(caster)
local integer iuh=LoadInteger(Hash,h,0)
local unit u
local integer ht
local real x
local real y
local real dmg
local timer t
local group g
local integer drop
local integer i
local integer a
if GetSpellAbilityId()=='A0RH' then
set u=GetSpellTargetUnit()
call CreateTextTagUnitBJ("КУСЬ!",u,0,11.00,60.00,0.00,100.00,0)
set dmg=150.*GetUnitAbilityLevel(caster,'A0RH')+6.*GetHeroStr(caster,true)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Undead\\UndeadLargeDeathExplode\\UndeadLargeDeathExplode.mdl",caster,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Undead\\UndeadLargeDeathExplode\\UndeadLargeDeathExplode.mdl",u,"origin"))
set x=GetUnitX(u)
set y=GetUnitY(u)
set g=CreateGroup()
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,300.,Bool_Filter_ID)
if not LoadBoolean(udg_hash,h,'q')then
call UnitDamageTarget(caster,u,0.5*dmg,false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(caster,u,0.5*dmg,false,false,ATTACK_TYPE_HERO,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call SetUnitLifePercentBJ(udg_Shark,(GetUnitLifePercent(udg_Shark)+(14.00+(2.00*GetUnitAbilityLevel(caster,'A0RH')))))
call GroupRemoveUnit(g,u)
set dmg=.5*dmg
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,0.5*dmg,false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(caster,u,0.5*dmg,false,false,ATTACK_TYPE_HERO,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
else
set dmg=dmg+GetHeroStr(caster,true)+300.
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_HERO,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call SetUnitLifePercentBJ(udg_Shark,(GetUnitLifePercent(udg_Shark)+(17.50+(2.50*GetUnitAbilityLevel(caster,'A0RH')))))
call GroupRemoveUnit(g,u)
set dmg=.5*dmg
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_HERO,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
endif
call SaveBoolean(udg_hash,h,'q',false)
call DestroyGroup(g)
else
endif
if GetSpellAbilityId()=='A0RI' then
set u=GetSpellTargetUnit()
set x=GetUnitX(u)
set y=GetUnitY(u)
set g=CreateGroup()
if GetUnitAbilityLevel(udg_Shark,'A0RJ')==1 then
call GroupEnumUnitsInRange(g,x,y,250.,Condition(function Trig_SharkSkills_Filter))
else
call GroupAddUnit(g,u)
endif
call ForGroup(g,function Trig_SharkSkills_Pause_ON)
call SetUnitTimeScale(caster,4.)
call PauseUnit(udg_Shark,true)
call UnitAddAbility(caster,'A0JN')
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveInteger(udg_hash,ht,1,20)
call SaveGroupHandle(udg_hash,ht,2,g)
call TimerStart(t,0.2,true,function Trig_SharkSkills_W)
else
endif
if GetSpellAbilityId()=='A0RL' then
set drop=GetRandomInt(1,8)
if drop==1 then
set x=GetRandomInt(3,5)
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+((x*0.1)*GetUnitState(caster,UNIT_STATE_MAX_LIFE)))
call CreateTextTagUnitBJ("Вы исцелились на"+I2S(R2I(10*x))+"% здоровья",caster,0,11.00,60.00,0.00,100.00,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
endif
if drop==2 then
call CreateTextTagUnitBJ("+25% урона и -25% к получаемому урону",caster,0,11.00,60.00,0.00,100.00,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
set i=LoadInteger(Hash,h,0)
set s__Units_AllDmg[sUnit[i]]=s__Units_AllDmg[sUnit[i]]+2500
set s__Units_MageBlock[sUnit[i]]=s__Units_MageBlock[sUnit[i]]+2500
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,GetRandomInt(10,14),false,function Trig_SharkSkills_R2)
endif
if drop==3 then
set i=100*GetRandomInt(5,20)
call SetPlayerStateBJ(GetOwningPlayer(caster),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetOwningPlayer(caster),PLAYER_STATE_RESOURCE_GOLD)+i)
call CreateTextTagUnitBJ("+"+I2S(i)+"золота и +25% бoльшe зoлoтa и +25% к мaкc бoльшe зoлoтa (+) в течении 25 сек.",caster,0,11.00,60.00,0.00,100.00,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
set i=GetPlayerId(GetOwningPlayer(caster))+1
set udg_HeroGoldMax[i]=(udg_HeroGoldMax[i]+0.5)
set udg_HeroGold[i]=(udg_HeroGold[i]+0.25)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,25,false,function Trig_SharkSkills_R3)
endif
if drop==4 then
set i=GetRandomInt(5,25)
set a=GetRandomInt(20,30)
set a=(a*GetHeroStr(caster,true))/100
call SetHeroStr(caster,GetHeroStr(caster,false)+i,true)
set x=PositiveDuration(caster,18)
call TempStats(caster,a,0,0,0,0,0,x)
call F_Stats(caster)
call CreateTextTagUnitBJ("+"+I2S(i)+"базовой силы +"+I2S(a)+"силы в течении 18 сек",caster,0,11.00,60.00,0.00,100.00,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,x,false,function Trig_SharkSkills_R_ALL)
endif
if drop==5 then
set i=GetRandomInt(5,25)
set a=GetRandomInt(20,30)
set a=(a*GetHeroAgi(caster,true))/100
call SetHeroAgi(caster,GetHeroAgi(caster,false)+i,true)
set x=PositiveDuration(caster,14)
call TempStats(caster,0,a,0,0,0,0,x)
call F_Stats(caster)
call CreateTextTagUnitBJ("+"+I2S(i)+"базовой ловкости +"+I2S(a)+"ловкости в течении 14 сек",caster,0,11.00,60.00,0.00,100.00,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,14,false,function Trig_SharkSkills_R_ALL)
endif
if drop==6 then
set i=GetRandomInt(8,30)
call SummonStats(false,0,i,caster,caster)
set a=2*GetHeroStr(caster,true)
set x=PositiveDuration(caster,15)
call TempStats(caster,0,0,0,a,0,0,x)
call CreateTextTagUnitBJ("+"+I2S(i)+"базовой атаке +"+I2S(a)+" атаки в течении 15 сек",caster,0,11.00,60.00,0.00,100.00,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,x,false,function Trig_SharkSkills_R_ALL)
endif
if drop==7 then
set a=GetHeroAgi(caster,true)/2
set s__Units_Arm[sUnit[iuh]]=s__Units_Arm[sUnit[iuh]]+4
set x=PositiveDuration(caster,14)
call TempStats(caster,0,0,0,0,a,0,x)
call CreateTextTagUnitBJ("+4 защиты и дает +"+I2S(a)+" защиты в течении 14 сек",caster,0,11.00,60.00,0.00,100.00,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
