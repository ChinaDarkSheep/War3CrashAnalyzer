if sec>20 then
call UnitDamageTarget(caster,caster,GetUnitState(caster,UNIT_STATE_MAX_LIFE)*0.2,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call SaveReal(udg_hash,h,'d',LoadReal(udg_hash,h,'d')+40.)
else
call UnitDamageTarget(caster,caster,GetUnitState(caster,UNIT_STATE_MAX_LIFE)*0.01,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call SetUnitAbilityLevel(caster,'A0U2',sec)
