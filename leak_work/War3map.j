function FC_Create takes integer id returns nothing
local real x=GetRectCenterX(gg_rct_BossPlace)
local real y=GetRectCenterY(gg_rct_BossPlace)
local real x1
local real y1
local integer i=1
set bj_lastCreatedUnit=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),id,x,y,90.)
loop
exitwhen i>8
set x1=x+256.*Cos(45.*i*bj_DEGTORAD)
set y1=y+256.*Sin(45.*i*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UDeathMedium\\UDeath.mdl",x1,y1))
set i=i+1
endloop
endfunction
