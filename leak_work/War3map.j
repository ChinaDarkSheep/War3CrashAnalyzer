call SaveReal(udg_hash,ht,0,dist)
call SaveReal(udg_hash,ht,1,angle)
call SaveReal(udg_hash,ht,2,x)
call SaveReal(udg_hash,ht,3,y)
call TimerStart(t,0.03,true,function Trig_HuntressSkills_E)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call SaveUnitHandle(udg_hash,ht,1,hero)
call SaveReal(udg_hash,ht,0,dmg)
call TimerStart(t,0.2,true,function Trig_HuntressSkills_E_DMG)
if GetUnitAbilityLevel(hero,'A0O2')==1 and talante==2 then
set angle=90.
set x1=x+dist*Cos(angle*bj_DEGTORAD)
set y1=y+dist*Sin(angle*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(hero),'e005',x1,y1,0.)
call UnitApplyTimedLife(u,'BTLF',r)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call SaveUnitHandle(udg_hash,ht,1,hero)
call SaveReal(udg_hash,ht,0,dist)
call SaveReal(udg_hash,ht,1,angle)
call SaveReal(udg_hash,ht,2,x)
call SaveReal(udg_hash,ht,3,y)
call TimerStart(t,0.03,true,function Trig_HuntressSkills_E)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call SaveUnitHandle(udg_hash,ht,1,hero)
call SaveReal(udg_hash,ht,0,dmg)
call TimerStart(t,0.2,true,function Trig_HuntressSkills_E_DMG)
set angle=270.
set x1=x+dist*Cos(angle*bj_DEGTORAD)
set y1=y+dist*Sin(angle*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(hero),'e005',x1,y1,0.)
call UnitApplyTimedLife(u,'BTLF',r)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call SaveUnitHandle(udg_hash,ht,1,hero)
call SaveReal(udg_hash,ht,0,dist)
call SaveReal(udg_hash,ht,1,angle)
call SaveReal(udg_hash,ht,2,x)
call SaveReal(udg_hash,ht,3,y)
call TimerStart(t,0.03,true,function Trig_HuntressSkills_E)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call SaveUnitHandle(udg_hash,ht,1,hero)
call SaveReal(udg_hash,ht,0,dmg)
call TimerStart(t,0.2,true,function Trig_HuntressSkills_E_DMG)
endif
endif
if GetSpellAbilityId()=='A1E1' then
set r=10
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set dmg=0.2*(250.+2.*GetHeroAgi(hero,true))
set u=CreateUnit(GetOwningPlayer(hero),'e005',x,y,GetUnitFacing(hero))
