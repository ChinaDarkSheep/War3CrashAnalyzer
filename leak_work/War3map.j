function Trig_Rage_Conditions takes nothing returns boolean
if(not(IsUnitInGroup(GetTriggerUnit(),udg_RageUnits)!=true))then
return false
endif
if(not(GetUnitLevel(GetTriggerUnit())<15))then
return false
endif
if(not(IsUnitType(GetTriggerUnit(),UNIT_TYPE_STRUCTURE)!=true))then
return false
endif
if(not(GetUnitTypeId(GetTriggerUnit())!='n02A'))then
return false
endif
if not(GetUnitAbilityLevel(GetDyingUnit(),'A1DX')==0)then
return false
endif
return true
endfunction
function Trig_Rage_Actions takes nothing returns nothing
if GetRandomInt(1,100)==1 then
call GroupAddUnitSimple(GetTriggerUnit(),udg_RageUnits)
set udg_p=GetUnitLoc(GetTriggerUnit())
call AddSpecialEffectLocBJ(udg_p,"Abilities\\Spells\\NightElf\\BattleRoar\\RoarCaster.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call RemoveLocation(udg_p)
call UnitAddAbilityBJ('A007',GetTriggerUnit())
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=GetUnitLevel(GetTriggerUnit())
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call UnitAddItemByIdSwapped('I04U',GetTriggerUnit())
call UnitAddItemByIdSwapped('I085',GetTriggerUnit())
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call UnitRemoveAbilityBJ('A007',GetTriggerUnit())
call SetUnitVertexColor(GetTriggerUnit(),255,100,100,255)
call SetUnitScale(GetTriggerUnit(),2.00,2.00,2.00)
call Effect_Del(AddSpecialEffectTarget("Abilities\\Spells\\Human\\ManaFlare\\ManaFlareBase.mdl",GetTriggerUnit(),"overhead"),20.)
call CreateTextTagUnitBJ("|cFFC60000ЯРОСТЬ!!!|r",GetTriggerUnit(),0,11.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
endif
endfunction
function InitTrig_Rage takes nothing returns nothing
set gg_trg_Rage=CreateTrigger()
call DisableTrigger(gg_trg_Rage)
call TriggerRegisterPlayerUnitEventSimple(gg_trg_Rage,Player(PLAYER_NEUTRAL_AGGRESSIVE),EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(gg_trg_Rage,Condition(function Trig_Rage_Conditions))
call TriggerAddAction(gg_trg_Rage,function Trig_Rage_Actions)
endfunction
function Trig_ExitRage_Conditions takes nothing returns boolean
if(not(IsUnitInGroup(GetDyingUnit(),udg_RageUnits)==true))then
return false
endif
return true
endfunction
function Trig_ExitRage_Actions takes nothing returns nothing
call GroupRemoveUnitSimple(GetDyingUnit(),udg_RageUnits)
call AdjustPlayerStateBJ((GetUnitLevel(GetDyingUnit())*20),GetOwningPlayer(GetKillingUnitBJ()),PLAYER_STATE_RESOURCE_GOLD)
set GoldNT[GetPlayerId(GetOwningPlayer(GetDyingUnit()))+1]=GoldNT[GetPlayerId(GetOwningPlayer(GetDyingUnit()))+1]+GetUnitLevel(GetDyingUnit())*20
call CreateTextTagUnitBJ(("|cFFFFDC00+ "+(I2S((GetUnitLevel(GetDyingUnit())*20))+" золота!")),GetDyingUnit(),0,11.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
endfunction
function InitTrig_ExitRage takes nothing returns nothing
set gg_trg_ExitRage=CreateTrigger()
call DisableTrigger(gg_trg_ExitRage)
call TriggerRegisterPlayerUnitEventSimple(gg_trg_ExitRage,Player(PLAYER_NEUTRAL_AGGRESSIVE),EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(gg_trg_ExitRage,Condition(function Trig_ExitRage_Conditions))
call TriggerAddAction(gg_trg_ExitRage,function Trig_ExitRage_Actions)
endfunction
function Trig_Revenge_Conditions takes nothing returns boolean
if(not(GetUnitTypeId(GetDyingUnit())!='n01I'))then
return false
endif
if(not(GetUnitTypeId(GetDyingUnit())!='n01J'))then
return false
endif
if(not(GetUnitTypeId(GetDyingUnit())!='n01K'))then
return false
endif
if(not(GetUnitTypeId(GetDyingUnit())!='u00J'))then
return false
endif
if(not(GetUnitTypeId(GetDyingUnit())!='nfgt'))then
return false
endif
if(not(GetUnitTypeId(GetDyingUnit())!='n01T'))then
return false
endif
if(not(GetUnitTypeId(GetDyingUnit())!='n00R'))then
return false
endif
if(not(GetUnitTypeId(GetDyingUnit())!='h015'))then
return false
endif
if(not(GetUnitTypeId(GetDyingUnit())!='n00I'))then
return false
endif
if(not(GetUnitTypeId(GetDyingUnit())!='n029'))then
return false
endif
if(not(GetUnitTypeId(GetDyingUnit())!='u00Y'))then
return false
endif
if(not(GetUnitAbilityLevelSwapped('Arsk',GetDyingUnit())!=1))then
return false
endif
if(not(GetUnitAbilityLevelSwapped('Avul',GetDyingUnit())!=1))then
return false
endif
if IsUnitType(GetDyingUnit(),UNIT_TYPE_STRUCTURE)then
return false
endif
return true
endfunction
function Trig_Revenge_Actions takes nothing returns nothing
local integer a=GetRandomInt(1,200)
local real x=GetUnitX(GetDyingUnit())
local real y=GetUnitY(GetDyingUnit())
local unit u
if HardcoreUP10==5 then
if GetRandomInt(1,4)<4 and GetOwningPlayer(GetDyingUnit())==Player(PLAYER_NEUTRAL_AGGRESSIVE)and not(IsUnitType(GetDyingUnit(),UNIT_TYPE_HERO)or(GetUnitLevel(GetDyingUnit())>=15 and ModuloInteger(GetUnitLevel(GetDyingUnit()),5)==0))then
set u=CreateUnit(GetOwningPlayer(GetDyingUnit()),GetUnitTypeId(GetDyingUnit()),x,y,bj_UNIT_FACING)
call UnitAddAbility(u,'Avul')
call UnitAddAbility(u,'Aloc')
call SetUnitPathing(u,false)
call UnitApplyTimedLife(u,'BTLF',10)
call UnitAddSleep(u,false)
endif
endif
if a<=2 and a>=1 then
call CreateTextTagUnitBJ("|cFFC60000МЕСТЬ!!!",GetDyingUnit(),0,11.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
call DestroyEffect(AddSpecialEffect("Units\\Undead\\Abomination\\AbominationExplosion.mdl",x,y))
set u=CreateUnit(GetOwningPlayer(GetDyingUnit()),'u00J',x,y,bj_UNIT_FACING)
call UnitApplyTimedLife(u,'BTLF',15)
elseif a<=4 and a>=3 then
call CreateTextTagUnitBJ("|cFFC60000МЕСТЬ!!!",GetDyingUnit(),0,11.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
set udg_p=GetUnitLoc(GetDyingUnit())
call AddSpecialEffectLocBJ(udg_p,"Objects\\Spawnmodels\\Undead\\UndeadLargeDeathExplode\\UndeadLargeDeathExplode.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call CreateNUnitsAtLoc(1,'nfgt',GetOwningPlayer(GetDyingUnit()),udg_p,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(20.00,'BTLF',GetLastCreatedUnit())
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>5
set udg_p2=PolarProjectionBJ(udg_p,300.00,(72.00*I2R(GetForLoopIndexA())))
call CreateNUnitsAtLoc(1,'nfgt',GetOwningPlayer(GetDyingUnit()),udg_p2,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(20.00,'BTLF',GetLastCreatedUnit())
call AddSpecialEffectLocBJ(udg_p2,"Objects\\Spawnmodels\\Undead\\UndeadLargeDeathExplode\\UndeadLargeDeathExplode.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call RemoveLocation(udg_p2)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call RemoveLocation(udg_p)
elseif a<=7 and a>=5 then
call CreateTextTagUnitBJ("|cFFC60000МЕСТЬ!!!",GetDyingUnit(),0,11.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl",x,y))
set u=CreateUnit(GetOwningPlayer(GetDyingUnit()),GetUnitTypeId(GetDyingUnit()),x,y,bj_UNIT_FACING)
call UnitAddAbility(u,'A1DX')
elseif a==4 then
call CreateTextTagUnitBJ("|cFFC60000МЕСТЬ!!!",GetDyingUnit(),0,11.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl",x,y))
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(GetDyingUnit()),'n01T',x,y,bj_UNIT_FACING)
else
endif
set u=null
endfunction
function InitTrig_Revenge takes nothing returns nothing
set gg_trg_Revenge=CreateTrigger()
call DisableTrigger(gg_trg_Revenge)
call TriggerRegisterPlayerUnitEventSimple(gg_trg_Revenge,Player(PLAYER_NEUTRAL_AGGRESSIVE),EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(gg_trg_Revenge,Condition(function Trig_Revenge_Conditions))
call TriggerAddAction(gg_trg_Revenge,function Trig_Revenge_Actions)
endfunction
function Trig_Every30sec_gg_rct_Spawn7 takes nothing returns boolean
return(GetUnitTypeId(GetFilterUnit())=='nwlt' and GetOwningPlayer(GetFilterUnit())==Player(PLAYER_NEUTRAL_AGGRESSIVE)and UnitAlive(GetFilterUnit()))
endfunction
function Trig_Every30sec_fTree takes nothing returns boolean
return((GetUnitTypeId(GetFilterUnit())=='etrp' or GetUnitTypeId(GetFilterUnit())=='e010')and UnitAlive(GetFilterUnit()))
endfunction
