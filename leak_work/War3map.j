function Trig_GonecSkills_Q takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer i=LoadInteger(udg_hash,ht,1)
local real regen=LoadReal(udg_hash,ht,2)
if i !=0 and UnitAlive(hero)then
set i=i-1
call SaveInteger(udg_hash,ht,1,i)
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+regen)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
set hero=null
endfunction
function Gonec_Route takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local real r=LoadReal(udg_hash,ht,1)
local integer h=GetHandleId(caster)
call SaveReal(udg_hash,h,StringHash("RouteR"),LoadReal(udg_hash,h,StringHash("RouteR"))-r)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
set caster=null
endfunction
function GonecSkills_W takes nothing returns nothing
