function Trig_Gydra_Actions takes nothing returns nothing
local unit hero=GetTriggerUnit()
local integer h=GetHandleId(hero)
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local timer t
local integer ht
local real r
local real x
local real y
local real x1
local real y1
local real x2
local real y2
local real dmg
local real angle
local unit u
local integer a
local integer i
local integer iuh=LoadInteger(udg_hash,h,5)
if GetSpellAbilityId()=='A0GS' then
set x=GetUnitX(hero)
set y=GetUnitY(hero)
set x1=GetSpellTargetX()
set y1=GetSpellTargetY()
set dmg=40*GetUnitAbilityLevel(hero,'A0GS')
if udg_Talante[ID]==1 then
set dmg=dmg+1.75*F_HPregen(hero)
if GetUnitAbilityLevel(hero,'A03O')==1 then
set dmg=dmg+1.75*F_HPregen(hero)
endif
elseif udg_Talante[ID]==2 then
set dmg=dmg+0.5*Summ_Attack(hero)
endif
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=GetUnitAbilityLevel(hero,'A0GS')+5
if udg_ReactorAganim[ID]then
set bj_forLoopAIndexEnd=(bj_forLoopAIndexEnd*3)/2
endif
call SeekMinDummys()
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set r=GetRandomReal(0,275)
set angle=GetRandomReal(0,360)
set x2=x1+r*Cos(angle*bj_DEGTORAD)
set y2=y1+r*Sin(angle*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(hero),'h02O',x,y,bj_UNIT_FACING)
set i=SeekFreeDummysMin(u,GetHandleId(u))
set s__Dummys_dmg[sDummy[i]]=dmg
set s__Dummys_AttType[sDummy[i]]=5
set s__Dummys_DmgType[sDummy[i]]=4
call IssuePointOrder(u,"attackground",x2,y2)
call UnitApplyTimedLife(u,'BTLF',0.75)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
if GetSpellAbilityId()=='A0H5' then
set x=GetUnitX(hero)
set y=GetUnitY(hero)
set dmg=GetUnitAbilityLevel(hero,'A0H5')*200+2*GetHeroStr(hero,true)
if udg_Talante[ID]==2 then
set dmg=dmg+Summ_Attack(hero)
if GetUnitAbilityLevel(hero,'A03O')==1 then
set a=R2I((GetHeroStr(hero,true)+s__Heroes_BaseDmg[sHero[iuh]])*LoadReal(udg_hash,h,4))
call TempStats(hero,0,0,0,a,0,0,PositiveDuration(hero,6))
endif
endif
call GroupDamage(x,y,350.,hero,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
if udg_Talante[ID]==1 then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveInteger(udg_hash,ht,0,8)
if GetUnitAbilityLevel(hero,'A03O')==1 then
set i=LoadInteger(Hash,h,0)
set s__Units_AllBlock[sUnit[i]]=s__Units_AllBlock[sUnit[i]]+3000
call SaveBoolean(udg_hash,ht,1,true)
else
call SaveBoolean(udg_hash,ht,1,false)
endif
call GroupDamage(x,y,350.,hero,false,1.75*F_HPregen(hero),ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
call TimerStart(t,1.,true,function Trig_Gydra_Reactor)
endif
endif
if GetSpellAbilityId()=='ANab' then
if GetUnitAbilityLevel(hero,'A03O')==1 then
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+0.2*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
endif
endif
if GetSpellAbilityId()=='A0JU' then
set dmg=20*GetUnitAbilityLevel(hero,'A155')+.25*GetHeroStr(hero,true)
if GetUnitAbilityLevel(hero,'A03O')==1 then
set dmg=dmg+0.01*GetUnitState(hero,UNIT_STATE_MAX_LIFE)
endif
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+dmg)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,hero)
call SaveInteger(udg_hash,ht,0,8)
call TimerStart(t,1.,true,function Gydra_E1)
endif
set u=null
set hero=null
set t=null
endfunction
function InitTrig_Gydra takes nothing returns nothing
set gg_trg_Gydra=CreateTrigger()
call TriggerAddAction(gg_trg_Gydra,function Trig_Gydra_Actions)
endfunction
function Dryad_R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local real sec=LoadReal(udg_hash,ht,0)
local unit target=LoadUnitHandle(udg_hash,ht,1)
local real x=GetUnitX(target)
local real y=GetUnitY(target)
local real x1
local real y1
local real dmg=2*(GetHeroInt(caster,true)+GetHeroAgi(caster,true))
local integer a=1
local real angle
local real dist
local unit u
call UnitDamageTarget(caster,target,16*GetHeroInt(caster,true),false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
loop
exitwhen a>10
set dist=GetRandomReal(100,500)
set angle=GetRandomReal(0,360)
set x1=x+dist*Cos(angle*bj_DEGTORAD)
set y1=y+dist*Sin(angle*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(caster),'o00M',x,y,angle)
call UnitApplyTimedLife(u,'BTLF',2.)
call UnitAddAbility(u,'A007')
call SummonStats(false,0,R2I(dmg),u,caster)
call UnitRemoveAbility(u,'A007')
call IssuePointOrder(u,"attackground",x1,y1)
set a=a+1
endloop
set a=1
loop
exitwhen a>12
call HeroAttack(caster,caster,target)
call Modificator(caster,caster,target)
set a=a+1
endloop
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set caster=null
set target=null
set u=null
set t=null
endfunction
function Dryad_R1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(hero)
local integer iuh=LoadInteger(Hash,h,0)
set s__Units_Arm[sUnit[iuh]]=s__Units_Arm[sUnit[iuh]]-40
call SaveReal(udg_hash,h,StringHash("HPRegen"),LoadReal(udg_hash,h,StringHash("HPRegen"))-40)
call SaveReal(udg_hash,h,StringHash("HPRegenBonusMult"),LoadReal(udg_hash,h,StringHash("HPRegenBonusMult"))/1.3)
call DestroyEffect(LoadEffectHandle(udg_hash,ht,1))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set hero=null
set t=null
endfunction
function Dryad_W11 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer tic=LoadInteger(udg_hash,ht,0)-1
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local group g2=LoadGroupHandle(udg_hash,ht,1)
local group g=CreateGroup()
local unit u
local real dmg=3.*F_HPregen(hero)
if tic>0 then
call SaveInteger(udg_hash,ht,0,tic)
loop
set u=FirstOfGroup(g2)
exitwhen u==null
call UnitDamageTarget(hero,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupAddUnit(g,u)
call GroupRemoveUnit(g2,u)
endloop
if tic==6 then
call SetUnitVertexColor(hero,255,255,255,255)
call UnitRemoveAbility(hero,'A0S4')
endif
call SaveGroupHandle(udg_hash,ht,1,g)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
call DestroyGroup(g)
endif
call DestroyGroup(g2)
set g2=null
set g=null
set u=null
set hero=null
set t=null
endfunction
function Trig_Dryad_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer h=GetHandleId(caster)
local integer iuh=LoadInteger(Hash,h,0)
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local unit u
local real dmg
local real x
local real y
local real x1
local real y1
local real angle
local integer a
local group g=CreateGroup()
local group g2
local timer t
local integer ht
if GetSpellAbilityId()=='A0HE' then
set dmg=GetUnitAbilityLevel(caster,'A0HE')*60+4*GetHeroInt(caster,true)
if udg_Talante[ID]==1 then
set dmg=dmg-2*GetHeroInt(caster,true)+10*F_HPregen(caster)
if GetUnitAbilityLevel(caster,'A1A1')==1 then
set dmg=dmg+10*F_HPregen(caster)
endif
elseif udg_Talante[ID]==2 then
set dmg=dmg*(1+LoadReal(udg_hash,h,StringHash("Modificator")))
endif
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set x1=GetSpellTargetX()
set y1=GetSpellTargetY()
set angle=bj_RADTODEG*Atan2(y1-y,x1-x)
set u=CreateUnit(GetOwningPlayer(caster),'h02R',x,y,angle)
call KnockBackUnit2(u,1250,1.2,angle,0.04)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveReal(udg_hash,ht,0,1.2)
call SaveUnitHandle(udg_hash,ht,1,u)
call SaveReal(udg_hash,ht,1,dmg)
call SaveGroupHandle(udg_hash,ht,2,CreateGroup())
call TimerStart(t,.2,true,function Dryad_Q)
endif
if GetSpellAbilityId()=='A1ER' then
set s__Units_Arm[sUnit[iuh]]=s__Units_Arm[sUnit[iuh]]+40
call SaveReal(udg_hash,h,StringHash("HPRegen"),LoadReal(udg_hash,h,StringHash("HPRegen"))+40)
call SaveReal(udg_hash,h,StringHash("HPRegenBonusMult"),LoadReal(udg_hash,h,StringHash("HPRegenBonusMult"))*1.3)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveEffectHandle(udg_hash,ht,1,AddSpecialEffectTarget("war3mapImported\\Providence Aura Green.mdx",caster,"origin"))
call TimerStart(t,15.,false,function Dryad_R1)
elseif GetSpellAbilityId()=='A0HH' then
if udg_Talante[ID]==1 then
set dmg=3.*F_HPregen(caster)
elseif udg_Talante[ID]==2 then
set a=GetUnitAbilityLevel(caster,'A0HH')*20+GetHeroInt(caster,false)/4
call TempStats(caster,a,a,a,0,0,0,PositiveDuration(caster,12))
endif
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,150+50*GetUnitAbilityLevel(caster,'A0HH'),Condition(function Trig_Filter_ID))
set g2=CreateGroup()
loop
set u=FirstOfGroup(g)
exitwhen u==null
call GroupAddUnit(g2,u)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'h009',GetUnitX(u),GetUnitY(u),0)
if udg_Talante[ID]==1 then
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
call UnitAddAbility(bj_lastCreatedUnit,'A0HI')
call IssueTargetOrder(bj_lastCreatedUnit,"slow",u)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',0.75)
call GroupRemoveUnit(g,u)
endloop
if udg_Talante[ID]==1 then
if GetUnitAbilityLevel(caster,'A1A1')==1 then
call SetUnitVertexColor(caster,130,130,130,130)
call UnitAddAbility(caster,'A0S4')
endif
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveInteger(udg_hash,ht,0,12)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveGroupHandle(udg_hash,ht,1,g2)
call TimerStart(t,1.,true,function Dryad_W11)
else
call DestroyGroup(g2)
endif
endif
if GetSpellAbilityId()=='A0HJ' then
set u=GetSpellTargetUnit()
set x=GetUnitX(u)-GetUnitX(caster)
set y=GetUnitY(u)-GetUnitY(caster)
set angle=SquareRoot(x*x+y*y)/1000.
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveUnitHandle(udg_hash,ht,1,u)
call TimerStart(t,angle,false,function Dryad_R)
endif
call DestroyGroup(g)
set caster=null
set u=null
set g=null
set g2=null
set t=null
endfunction
function InitTrig_Dryad takes nothing returns nothing
set gg_trg_Dryad=CreateTrigger()
call TriggerAddAction(gg_trg_Dryad,function Trig_Dryad_Actions)
endfunction
function Trig_TechnoSkills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local integer i
local real r
local real x
local real y
local real x1
local real y1
local real angle
local real dmg
local real dist
local group g=CreateGroup()
local timer t
local integer ht
local unit u
local integer a
local real hp
if GetSpellAbilityId()=='A0J6' then
set dmg=GetUnitAbilityLevel(caster,'A0J6')*125+2*GetHeroInt(caster,true)
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,250,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
if IsUnitType(u,UNIT_TYPE_STRUCTURE)==false then
set x1=GetUnitX(u)
set y1=GetUnitY(u)
set angle=bj_RADTODEG*Atan2(y1-y,x1-x)
call KnockBackUnit(u,700,.7,angle,0.05)
endif
call GroupRemoveUnit(g,u)
endloop
set bj_lastCreatedTerrainDeformation=TerrainDeformRipple(x,y,300.,60.,800,1,1.5,4,0.4133,false)
set u=CreateUnit(Player(ID-1),'h04H',x,y,bj_UNIT_FACING)
call KillUnit(u)
elseif GetSpellAbilityId()=='A0J4' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set hp=R2I(GetHeroInt(caster,true)*2.)+R2I(GetHeroStr(caster,true)*2.)
set dmg=R2I(GetHeroInt(caster,true)/3.)
if GetHeroLevel(caster)>=50 then
set hp=2*hp
set dmg=2*dmg
endif
set u=CreateUnit(Player(ID-1),'o00U',x,y,GetRandomInt(1,270))
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'A007')
call UnitApplyTimedLife(u,'BTLF',60.)
elseif GetSpellAbilityId()=='A0J5' then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set x1=x+200*Cos(GetUnitFacing(caster)*bj_DEGTORAD)
set y1=y+200*Sin(GetUnitFacing(caster)*bj_DEGTORAD)
set hp=R2I(GetHeroInt(caster,true)*3.)+R2I(GetHeroStr(caster,true)*4.)
set dmg=0.4*GetHeroInt(caster,true)
if GetHeroLevel(caster)>=50 then
set hp=2*hp
endif
set u=CreateUnit(Player(ID-1),udg_TechnoRandomSummons[GetRandomInt(1,2)],x1,y1,GetRandomInt(1,270))
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'A007')
call UnitApplyTimedLife(u,'BTLF',40.)
set a=1+GetHeroInt(caster,true)/60
if a>=10 then
set a=10
endif
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>a
set u=CreateUnit(Player(ID-1),udg_TechnoRandomSummons[GetRandomInt(1,2)],x1,y1,GetRandomInt(1,270))
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'A007')
if GetHeroLevel(caster)>=50 then
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+10)
endif
call UnitApplyTimedLife(u,'BTLF',40.)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
elseif GetSpellAbilityId()=='A0JI' then
set u=GetSpellTargetUnit()
call UnitAddAbility(u,'A0JJ')
call SetUnitAbilityLevel(u,'A0JJ',1+GetHeroInt(caster,true)/100)
call DelAbility(u,'A0JJ',20)
elseif GetSpellAbilityId()=='A0JG' then
set u=GetSpellTargetUnit()
call UnitAddAbility(u,'A0JF')
call DelAbility(u,'A0JF',13)
elseif GetSpellAbilityId()=='A0JL' then
set u=GetSpellTargetUnit()
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+.4*GetUnitState(u,UNIT_STATE_MAX_LIFE))
elseif GetSpellAbilityId()=='A0JK' then
set u=GetSpellTargetUnit()
if GetUnitTypeId(u)!='htow' and GetUnitTypeId(u)!='harm' and GetUnitTypeId(u)!='h005' and GetUnitTypeId(u)!='o00X' and GetUnitTypeId(u)!='h052' and GetUnitTypeId(u)!='etoe' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set u=CreateUnit(GetOwningPlayer(u),GetUnitTypeId(u),x,y,bj_UNIT_FACING)
call UnitApplyTimedLife(u,'BTLF',600)
endif
elseif GetSpellAbilityId()=='A0JB' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set u=CreateUnit(Player(ID-1),'h03F',x,y,bj_UNIT_FACING)
call UnitApplyTimedLife(u,'BTLF',5)
endif
call DestroyGroup(g)
set g=null
set caster=null
set u=null
endfunction
function InitTrig_TechnoSkills takes nothing returns nothing
set gg_trg_TechnoSkills=CreateTrigger()
call TriggerAddAction(gg_trg_TechnoSkills,function Trig_TechnoSkills_Actions)
endfunction
