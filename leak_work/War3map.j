set u=CreateUnit(GetOwningPlayer(udg_FireLord),'nlv1',x,y,GetUnitFacing(udg_FireLord))
call UnitAddAbility(u,'A17N')
call SetUnitAbilityLevel(u,'A17N',GetUnitAbilityLevel(u,'A17N')+15)
call UnitAddAbility(u,'A007')
call SummonStats(true,lvl,R2I(damage),u,udg_FireLord)
call UnitRemoveAbility(u,'A007')
call UnitApplyTimedLife(u,'BTLF',20.)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
call DestroyGroup(g)
set t=null
set u=null
set target=null
