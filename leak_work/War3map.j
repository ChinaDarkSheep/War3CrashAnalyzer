function InitTrig_Iss9 takes nothing returns nothing
set gg_trg_Iss9=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Iss9,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(gg_trg_Iss9,Condition(function Trig_Iss9_Conditions))
call TriggerAddAction(gg_trg_Iss9,function Trig_Iss9_Actions)
endfunction
function Trig_Phr1_Conditions takes nothing returns boolean
if(not(IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)==true))then
return false
endif
return true
endfunction
function Trig_Phr1_Actions takes nothing returns nothing
call DisplayTimedTextToForce(bj_FORCE_PLAYER[GetPlayerId(GetOwningPlayer(GetEnteringUnit()))],10.00,"|cFF00C850Мэр города \"Город\". Сейчас настолько испуган что не может говорить.")
call DestroyTrigger(GetTriggeringTrigger())
endfunction
function InitTrig_Phr1 takes nothing returns nothing
set gg_trg_Phr1=CreateTrigger()
call TriggerRegisterEnterRectSimple(gg_trg_Phr1,gg_rct_Secret6)
call TriggerAddCondition(gg_trg_Phr1,Condition(function Trig_Phr1_Conditions))
call TriggerAddAction(gg_trg_Phr1,function Trig_Phr1_Actions)
endfunction
function Trig_Phr6_Conditions takes nothing returns boolean
if(not(IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)==true))then
return false
endif
return true
endfunction
function Trig_Phr6_Actions takes nothing returns nothing
call DisplayTimedTextToForce(bj_FORCE_PLAYER[GetPlayerId(GetOwningPlayer(GetEnteringUnit()))],16.40,"|cFFFFDC00Капитан:|r Стоять! А ну иди сюда, пропуск есть? А вы герой? Тогда разыщите нашего дезертира Лорета, 2 дня уже нет!")
call CreateNUnitsAtLoc(1,'h02A',Player(9),GetRectCenter(gg_rct_Vasa),bj_UNIT_FACING)
set udg_vasa=GetLastCreatedUnit()
call EnableTrigger(gg_trg_Phr7)
call DestroyTrigger(GetTriggeringTrigger())
endfunction
function InitTrig_Phr6 takes nothing returns nothing
set gg_trg_Phr6=CreateTrigger()
call TriggerRegisterEnterRectSimple(gg_trg_Phr6,gg_rct_FordPost_2)
call TriggerAddCondition(gg_trg_Phr6,Condition(function Trig_Phr6_Conditions))
call TriggerAddAction(gg_trg_Phr6,function Trig_Phr6_Actions)
endfunction
function Trig_Phr7_Conditions takes nothing returns boolean
if(not(IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)==true))then
return false
endif
return true
endfunction
function Trig_Phr7_Actions takes nothing returns nothing
call DisplayTimedTextToForce(bj_FORCE_PLAYER[GetPlayerId(GetOwningPlayer(GetEnteringUnit()))],7.00,"|cFFFFDC00Лорет:|r Сделаем вид, что мы не встречались...")
call SetUnitOwner(udg_vasa,GetOwningPlayer(GetEnteringUnit()),true)
call DestroyTrigger(GetTriggeringTrigger())
endfunction
function InitTrig_Phr7 takes nothing returns nothing
set gg_trg_Phr7=CreateTrigger()
call DisableTrigger(gg_trg_Phr7)
call TriggerRegisterEnterRectSimple(gg_trg_Phr7,gg_rct_Vasa_golos)
call TriggerAddCondition(gg_trg_Phr7,Condition(function Trig_Phr7_Conditions))
call TriggerAddAction(gg_trg_Phr7,function Trig_Phr7_Actions)
endfunction
