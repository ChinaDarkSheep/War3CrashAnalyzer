if udg_Drop<=5 then
set udg_Drop=((GetPlayerTechCountSimple('R04W',GetOwningPlayer(udg_Thing))*25)+500)
set udg_Drop=GetRandomInt(1,((udg_Drop*4)/10))
call AdjustPlayerStateBJ(udg_Drop,GetOwningPlayer(udg_Thing),PLAYER_STATE_RESOURCE_GOLD)
call DisplayTimedTextToForce(GetForceOfPlayer(GetOwningPlayer(udg_Thing)),3.00,("|cFFC9AD00Вам вернули +"+(I2S(udg_Drop)+" золота!")))
