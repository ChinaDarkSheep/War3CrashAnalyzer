function Trig_ActivateMassacre_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local unit u
local integer h=GetHandleId(caster)
local timer t
local integer ht
local integer i
local real dmg
local real hp
local real r
local real x
local real y
local real xh=GetUnitX(caster)
local real yh=GetUnitY(caster)
if GetSpellAbilityId()=='A048' then
if udg_Talante[ID]==1 then
set r=12
set x=GetUnitAbilityLevel(caster,'A048')*3+.15*GetHeroAgi(caster,true)
if(GetFloatGameState(GAME_STATE_TIME_OF_DAY)<6.00 or GetFloatGameState(GAME_STATE_TIME_OF_DAY)>18.00)then
set x=x*2
endif
set i=LoadInteger(Hash,h,0)
set s__Units_AllBlock[sUnit[i]]=s__Units_AllBlock[sUnit[i]]+2000
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveReal(udg_hash,ht,0,r)
call TimerStart(t,.5,true,function DH_Q1)
call TempStats(caster,0,0,0,0,R2I(x),0,PositiveDuration(caster,r))
elseif udg_Talante[ID]==2 then
call SaveInteger(udg_hash,h,'Q',1)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,12,false,function DH_Q2)
endif
endif
if GetSpellAbilityId()=='A0FP' then
set dmg=200.*GetUnitAbilityLevel(caster,'A0FP')+2.*GetHeroAgi(caster,true)
if GetHeroLevel(caster)>=50 then
set dmg=dmg+5.*GetHeroAgi(caster,true)
endif
set u=GetSpellTargetUnit()
call PauseUnitBJ(true,caster)
call SelectUnitRemoveForPlayer(caster,GetOwningPlayer(caster))
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl",xh,yh)
call DestroyEffect(bj_lastCreatedEffect)
set x=GetUnitX(u)+40*Cos((GetUnitFacing(u)+180)*bj_DEGTORAD)
set y=GetUnitY(u)+40*Sin((GetUnitFacing(u)+180)*bj_DEGTORAD)
call SetUnitAnimation(caster,"attack")
call SetUnitX(caster,x)
call SetUnitY(caster,y)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
call PauseUnitBJ(false,caster)
call SelectUnitForPlayerSingle(caster,GetOwningPlayer(caster))
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
if udg_Talante[ID]==1 then
set dmg=GetUnitAbilityLevel(caster,'A0FP')*100+.25*GetUnitState(caster,UNIT_STATE_MAX_LIFE)
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+dmg)
endif
if udg_Mode !=4 and(GetFloatGameState(GAME_STATE_TIME_OF_DAY)<6.00 or GetFloatGameState(GAME_STATE_TIME_OF_DAY)>18.00)then
call SetHeroAgi(caster,GetHeroAgi(caster,false)+2,true)
endif
endif
if GetSpellAbilityId()=='A1DB' then
set r=PositiveDuration(caster,20)
if udg_Talante[ID]==1 then
set i=ReturnTypeHeroId(h)
set s__Heroes_WeakBlock[sHero[i]]=s__Heroes_WeakBlock[sHero[i]]+2500
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveReal(udg_hash,ht,1,r)
call TimerStart(t,0.25,true,function Trig_ActivateMassacre_F1)
set hp=2000+3*GetHeroAgi(caster,true)
call TempStats(caster,0,0,0,0,0,R2I(hp),r)
endif
if udg_Talante[ID]==2 then
call SaveReal(udg_hash,h,StringHash("Modificator"),LoadReal(udg_hash,h,StringHash("Modificator"))+0.15)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveReal(udg_hash,ht,1,r)
call TimerStart(t,0.25,true,function Trig_ActivateMassacre_F2)
set dmg=0.3*GetHeroAgi(caster,false)
call TempStats(caster,0,R2I(dmg),0,0,0,0,r)
endif
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Other\\SoulBurn\\SoulBurnbuff.mdl",caster,"overhead")
call Effect_Del(bj_lastCreatedEffect,r)
endif
set u=null
set t=null
set caster=null
endfunction
