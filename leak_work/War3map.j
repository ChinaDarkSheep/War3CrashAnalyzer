function Trig_CaptainSkills_Q takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local group g=LoadGroupHandle(udg_hash,ht,0)
local unit u
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitRemoveAbility(u,'A0T4')
call GroupRemoveUnit(g,u)
endloop
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
set g=null
set u=null
set t=null
endfunction
