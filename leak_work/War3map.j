call UnitAddAbility(hero,'A0AP')
elseif udg_Talante[ID]==2 then
call UnitAddAbility(hero,'A17D')
endif
endif
if GetUnitTypeId(hero)=='U02B' or GetUnitTypeId(hero)=='U02J' then
if udg_Talante[ID]==1 then
call UnitAddAbility(hero,'A19C')
elseif udg_Talante[ID]==2 then
call UnitAddAbility(hero,'A19E')
elseif udg_Talante[ID]==3 then
call UnitAddAbility(hero,'A19L')
endif
endif
elseif GetLearnedSkill()=='A05H' then
if udg_Talante[ID]==1 then
call UnitAddItemByIdSwapped('I04V',hero)
call SetHeroAgi(hero,GetHeroAgi(hero,false)+15,true)
elseif udg_Talante[ID]==2 then
call SetHeroStr(hero,GetHeroStr(hero,false)+25,true)
call SetHeroInt(hero,GetHeroInt(hero,false)+25,true)
call SaveReal(udg_hash,h,StringHash("StrUP"),LoadReal(udg_hash,h,StringHash("StrUP"))+0.05)
call SaveReal(udg_hash,h,StringHash("IntUP"),LoadReal(udg_hash,h,StringHash("IntUP"))+0.05)
endif
elseif GetLearnedSkill()=='A19G' then
if udg_Talante[ID]==1 then
set udg_Miasm=udg_Miasm+2000
call SetPlayerTechResearched(GetOwningPlayer(hero),'Rhar',1)
call SetPlayerTechResearched(GetOwningPlayer(hero),'R003',15)
elseif udg_Talante[ID]==2 then
call UnitAddAbility(hero,'A19N')
endif
elseif GetLearnedSkill()=='A0M8' then
call SetUnitAbilityLevel(hero,'A0M5',GetUnitAbilityLevel(hero,'A0M5')+1)
endif
set hero=null
endfunction
