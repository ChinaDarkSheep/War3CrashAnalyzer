function Trig_BatSkills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer h=GetHandleId(caster)
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local integer ihh=LoadInteger(udg_hash,h,5)
local integer iuh=LoadInteger(Hash,h,0)
local group g=CreateGroup()
local unit u
local real dmg
local real x
local real y
local timer t
local integer ht
local integer a
if GetSpellAbilityId()=='A0UO' then
set udg_BatLogic=true
set x=LoadReal(udg_hash,GetHandleId(caster),'d')
set y=1+(100.00-GetUnitLifePercent(caster))/100.00
if UnitHasItemOfTypeBJ(caster,'I0BD')then
set dmg=(x*y)*1.80
set dmg=dmg+1.4*GetUnitState(caster,UNIT_STATE_MAX_LIFE)
else
if UnitHasItemOfTypeBJ(caster,'I013')then
set dmg=(x*y)*1.4
set dmg=dmg+0.8*GetUnitState(caster,UNIT_STATE_MAX_LIFE)
else
set dmg=(x*y)
set dmg=dmg+0.4*GetUnitState(caster,UNIT_STATE_MAX_LIFE)
endif
endif
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set udg_TEXT=CreateTextTag()
call SetTextTagTextBJ(udg_TEXT,(I2S(R2I(dmg))+"!"),17.)
call SetTextTagPos(udg_TEXT,x,y,0)
call SetTextTagColorBJ(udg_TEXT,70.00,10.00,10.00,0)
call SetTextTagVelocityBJ(udg_TEXT,75.00,90.00)
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
set u=CreateUnit(GetOwningPlayer(caster),'h03W',x,y,GetRandomReal(0,360))
call UnitApplyTimedLife(u,'BTLF',11.)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,600.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(caster,u,dmg*0.50,false,true,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(caster,u,dmg*0.40,false,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(caster,u,dmg*0.10,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
call KillUnit(caster)
elseif GetSpellAbilityId()=='A0TV' then
if udg_Talante[ID]==1 then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveInteger(udg_hash,ht,0,13)
call TimerStart(t,1.,true,function BatSkills_W1)
elseif udg_Talante[ID]==2 then
set udg_BatLogicW=true
set udg_BatDmgW=1.10+.10*GetUnitAbilityLevel(caster,'A0TV')
set a=GetUnitAbilityLevel(caster,'A0UE')
if a==1 then
set s__Units_AllDmg[sUnit[iuh]]=s__Units_AllDmg[sUnit[iuh]]+2500
endif
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveInteger(udg_hash,ht,1,a)
call TimerStart(t,13.,false,function BatSkills_W2)
endif
elseif GetSpellAbilityId()=='A0TY' then
if GetUnitAbilityLevel(caster,'A0UE')==1 then
call FoTDeath(caster,GetUnitX(caster),GetUnitY(caster),false)
endif
call EnableTrigger(gg_trg_BatE)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,5.,false,function BatSkills_E)
elseif GetSpellAbilityId()=='A0TU' then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveReal(udg_hash,ht,0,6.)
call TimerStart(t,.4,true,function BatSkills_Q)
elseif GetSpellAbilityId()=='A0TZ' then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveInteger(udg_hash,ht,0,0)
call TimerStart(t,1.,true,function BatSkills_R2)
call SaveReal(udg_hash,h,'d',LoadReal(udg_hash,h,'d')+2.)
call UnitAddAbility(caster,'A0U2')
call SetUnitAbilityLevel(caster,'A0U2',1)
call UnitDamageTarget(caster,caster,GetUnitState(caster,UNIT_STATE_MAX_LIFE)*0.01,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
elseif GetSpellAbilityId()=='A1EW' then
set a=R2I(PositiveDuration(caster,18))
call TempStats(caster,100+GetHeroStr(caster,false)/5,100+GetHeroAgi(caster,false)/5,100+GetHeroInt(caster,false)/5,0,0,0,a)
call SaveBoolean(udg_hash,h,StringHash("BatR1"),true)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveInteger(udg_hash,ht,0,a)
call SaveEffectHandle(udg_hash,ht,1,AddSpecialEffectTarget("Abilities\\Spells\\Orc\\LiquidFire\\Liquidfire.mdl",caster,"origin"))
call TimerStart(t,1.,true,function BatSkills_R1)
endif
set t=null
call DestroyGroup(g)
set g=null
set caster=null
set u=null
endfunction
