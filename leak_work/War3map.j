function InitTrig_GemsCraftJass takes nothing returns nothing
local integer index
set gg_trg_GemsCraftJass=CreateTrigger()
set index=0
loop
call TriggerRegisterPlayerUnitEvent(gg_trg_GemsCraftJass,Player(index),EVENT_PLAYER_UNIT_PICKUP_ITEM,null)
set index=index+1
exitwhen index==bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(gg_trg_GemsCraftJass,function Trig_GemsCraft_Actions)
endfunction
