return false
endif
return true
endfunction
function Trig_SkillFase3_3_Actions takes nothing returns nothing
if(Trig_SkillFase3_3_Func001C())then
call DestroyTrigger(gg_trg_SkillFase3)
call DestroyTrigger(gg_trg_SpawnFase3)
call DestroyTrigger(gg_trg_SkillFase3_3)
else
endif
endfunction
