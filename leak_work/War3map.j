function Trig_Info_Actions takes nothing returns nothing
call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"Стандартный режим","Главная цель - защитить \"Апотроп\" в большом поселении. Если апотроп будет уничтожен - вы проиграли.\nГлавные здания остальных поселений увеличивают здоровье \"Апотропа\" каждые 60 сек., если они будут уничтожены - прирост остановится. После 30 минут начинается массивная атака, заранее выбранная красным игроком.","ReplaceableTextures\\CommandButtons\\BTNArcaneSanctum.blp")
call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"Хардкорный режим","Это режим повышенной сложности, где враги становятся намного агрессивнее. После 30 минут начинается единственная атака, которой нет в стандартном режиме. В хардкорном режиме можно получить намного больше очков.","ReplaceableTextures\\CommandButtons\\BTNMaskOfDeath.blp")
call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"Против злодея","В этом режиме один из игроков становится злодеем и начинает руководить атаками на Альянс. Если за 30 минут злодей не успевает уничтожить Апотроп, то Альянс побеждает.","ReplaceableTextures\\CommandButtons\\BTNAltarOfDarkness.blp")
call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"Classic Defence","В этом режиме вы должны отбиться от 20 волн противника и сохранить Апотроп. Вы не сможете проходить испытания или просто свободно бродить по карте, ваша основная цель - защита Апотропа. В этом режиме % получаемого золота и опыта уменьшается на 30%. За прохождение каждой волны вы будете получать очки.","ReplaceableTextures\\CommandButtons\\BTNGuardTower.blp")
call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"Механики - 1","TRIGSTR_073","ReplaceableTextures\\CommandButtons\\BTNCOP.blp")
call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"Механики - 2","Лутинг - это шанс выпадение книг с врагов. Эффекты повышающие лутинг стакаются с друг другом.\nМагическая тонкость - предметы и эффекты с данным классом нельзя носить вместе","ReplaceableTextures\\CommandButtons\\BTNCOP.blp")
call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"Команды","TRIGSTR_074","ReplaceableTextures\\CommandButtons\\BTNCOP.blp")
call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"-set","TRIGSTR_075","ReplaceableTextures\\CommandButtons\\BTNCOP.blp")
call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"Save/load","TRIGSTR_076","ReplaceableTextures\\CommandButtons\\BTNCOP.blp")
call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED,"|cFF07B4C2Зельеварение|r","TRIGSTR_077","ReplaceableTextures\\CommandButtons\\BTNBronzeBowlFull.blp")
call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED,"Испытания","Испытания позволяют заработать дополнительные характеристики для героя. Чтобы попасть на испытания вы должны выбрать их в выборочном зале. В зал можно попасть через команду \"-isp\".","ReplaceableTextures\\CommandButtons\\BTNHumanBarracks.blp")
call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED,"Благодарности","TRIGSTR_079","ReplaceableTextures\\CommandButtons\\BTNSnazzyScrollGreen.blp")
call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED,"|cFF00C850Контакты","Наша группа в вк: vk.com/30mnts\nНаш сервер дискорд: https://discord.gg/bwnTUDG","ReplaceableTextures\\CommandButtons\\BTNBansheeMaster.blp")
call DestroyTrigger(GetTriggeringTrigger())
endfunction
