function Trig_Every140sec_Murloc takes nothing returns boolean
return(GetUnitTypeId(GetFilterUnit())=='n02G' and GetOwningPlayer(GetFilterUnit())==Player(PLAYER_NEUTRAL_AGGRESSIVE)and UnitAlive(GetFilterUnit()))
endfunction
function Trig_Every140sec_Actions takes nothing returns nothing
local real x
local real y
local integer a
local integer random
local group g=CreateGroup()
set random=GetRandomInt(1,2)
if random==1 then
call GroupEnumUnitsInRect(g,gg_rct_Spawn47,Condition(function Trig_Every140sec_Murloc))
else
call GroupEnumUnitsInRect(g,gg_rct_Spawn9,Condition(function Trig_Every140sec_Murloc))
endif
if CountUnitsInGroup(g)<6 then
set a=2
else
set a=1
endif
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>a
if random==1 then
set x=GetRandomReal(GetRectMinX(gg_rct_Spawn47),GetRectMaxX(gg_rct_Spawn47))
set y=GetRandomReal(GetRectMinY(gg_rct_Spawn47),GetRectMaxY(gg_rct_Spawn47))
else
set x=GetRandomReal(GetRectMinX(gg_rct_Spawn9),GetRectMaxX(gg_rct_Spawn9))
set y=GetRandomReal(GetRectMinY(gg_rct_Spawn9),GetRectMaxY(gg_rct_Spawn9))
endif
set bj_lastCreatedUnit=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),'n02G',x,y,GetRandomReal(0,360))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call DestroyGroup(g)
set g=null
endfunction
