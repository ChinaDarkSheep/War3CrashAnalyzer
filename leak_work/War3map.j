if(Trig_kick_Func001C())then
set udg_KickPlayer=ConvertedPlayer(S2I(SubStringBJ(GetEventPlayerChatString(),7,7)))
set udg_KickNumber=0
if(Trig_kick_Func001Func003C())then
call DisableTrigger(GetTriggeringTrigger())
call DisplayTextToForce(GetPlayersAll(),("|cFFE68948Запущено голосование на кик игрока|r |cFFFFDC00"+(GetPlayerName(udg_KickPlayer)+("|r|cFFE68948. Чтобы проголосовать за кик, введите в чат \"-yes\". Голосование длится 40 секунд."))))
call EnableTrigger(gg_trg_KickAction)
call TriggerSleepAction(40.00)
call DisplayTextToForce(GetPlayersAll(),"|cFFE68948Голосование за кик завершено.")
call ForceClear(udg_KickGroup)
call DisableTrigger(gg_trg_KickAction)
call EnableTrigger(GetTriggeringTrigger())
else
call DisplayTextToForce(GetForceOfPlayer(GetTriggerPlayer()),"|cFFE68948Нельзя кикать себя или предателя.")
endif
else
endif
endfunction
