function Trig_PristTauren_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer h=GetHandleId(caster)
local integer ihh=LoadInteger(udg_hash,h,5)
local unit u
local location p
local integer a
local timer t
local integer ht
local real x
local real y
local group g=CreateGroup()
local real dmg
if GetSpellAbilityId()=='A187' then
set ht=GetHandleId(udg_AvatarGod)
set a=LoadInteger(Hash,ht,0)
set s__Units_AllDmg[sUnit[a]]=s__Units_AllDmg[sUnit[a]]-2500
call UnitRemoveAbility(udg_AvatarGod,'A18A')
set udg_AvatarGod=GetSpellTargetUnit()
set ht=GetHandleId(udg_AvatarGod)
set a=LoadInteger(Hash,ht,0)
if a==0 then
set a=SeekFreeUnit(ht)
endif
set s__Units_AllDmg[sUnit[a]]=s__Units_AllDmg[sUnit[a]]+2500
call UnitAddAbility(udg_AvatarGod,'A18A')
call SetUnitState(udg_AvatarGod,UNIT_STATE_LIFE,GetUnitState(udg_AvatarGod,UNIT_STATE_LIFE)+0.2*GetUnitState(udg_AvatarGod,UNIT_STATE_MAX_LIFE))
elseif GetSpellAbilityId()=='A188' then
call StartTimerBJ(udg_TaurenPristR,true,0.25)
set udg_TaurenPristU=GetSpellTargetUnit()
call TriggerSleepAction(7.00)
call PauseTimerBJ(true,udg_TaurenPristR)
elseif GetSpellAbilityId()=='A182' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
if GetHeroLevel(udg_TaurenPrist)>=50 then
set dmg=4.*GetHeroInt(udg_TaurenPrist,true)+190.00*GetUnitAbilityLevel(udg_TaurenPrist,'A182')
else
set dmg=2.*GetHeroInt(udg_TaurenPrist,true)+190.00*GetUnitAbilityLevel(udg_TaurenPrist,'A182')
endif
set u=CreateUnit(GetOwningPlayer(caster),'h05B',x,y,bj_UNIT_FACING)
call UnitAddAbility(u,'A189')
call UnitApplyTimedLife(u,'BTLF',.65)
call IssueImmediateOrder(u,"stomp")
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveReal(udg_hash,ht,1,x)
call SaveReal(udg_hash,ht,2,y)
call SaveReal(udg_hash,ht,3,dmg)
call TimerStart(t,.5,false,function PristTauren_Q)
elseif GetSpellAbilityId()=='A183' then
call SaveBoolean(udg_hash,GetHandleId(caster),'f',false)
set udg_TaurenPristHeal=1.00
call StartTimerBJ(udg_TaurenPristT,true,0.20)
call TriggerSleepAction(3.50)
call DestroyTextTagBJ(udg_TaurenPristText)
call PauseTimerBJ(true,udg_TaurenPristT)
if LoadBoolean(udg_hash,GetHandleId(caster),'f')==false then
set dmg=((200.00+(1.60*I2R(GetHeroStatBJ(bj_HEROSTAT_INT,udg_TaurenPrist,true))))*udg_TaurenPristHeal)
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,900.,Bool_Filter_ID_Ally)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitType(u,UNIT_TYPE_HERO)and GetUnitTypeId(u)!='O00Z' then
call Heal(true,2.5*dmg,u,caster)
else
call Heal(true,dmg,u,caster)
endif
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl",u,"original")
call DestroyEffect(bj_lastCreatedEffect)
call GroupRemoveUnit(g,u)
endloop
call CreateTextTagUnitBJ((I2S((R2I(udg_TaurenPristHeal)*100))+"%"),udg_TaurenPrist,0,14.00,100.00,35.00,0.00,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,90.00)
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
endif
call SaveBoolean(udg_hash,GetHandleId(caster),'f',true)
set udg_TaurenPristHeal=0.00
elseif GetSpellAbilityId()=='A185' then
set u=GetSpellTargetUnit()
set a=30*GetUnitAbilityLevel(caster,'A185')+(3*(GetHeroInt(caster,true)-s__Heroes_TempInt[sHero[ihh]]/4))/20
if GetHeroLevel(caster)>=50 then
set a=a+R2I(0.15*GetHeroInt(caster,false))
endif
if GetUnitTypeId(u)=='O00Z' then
set a=R2I(0.5*I2R(a))
endif
call TempStats(u,a,a,a,0,0,0,PositiveDuration(caster,18))
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIlm\\AIlmTarget.mdl",u,"original")
call DestroyEffect(bj_lastCreatedEffect)
if GetHeroLevel(udg_TaurenPrist)>=50 then
set a=3
else
set a=2
endif
set udg_Drop2=GetRandomInt(1,3)
if udg_Drop2==1 then
call ModifyHeroStat(bj_HEROSTAT_STR,u,bj_MODIFYMETHOD_ADD,a)
call CreateTextTagUnitBJ("+Сила",u,0,11.00,70.00,70.00,100.00,0)
elseif udg_Drop2==2 then
call ModifyHeroStat(bj_HEROSTAT_AGI,u,bj_MODIFYMETHOD_ADD,a)
call CreateTextTagUnitBJ("+Ловкость",u,0,11.00,70.00,70.00,100.00,0)
else
call ModifyHeroStat(bj_HEROSTAT_INT,u,bj_MODIFYMETHOD_ADD,a)
call CreateTextTagUnitBJ("+Разум",u,0,11.00,70.00,70.00,100.00,0)
endif
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
endif
call DestroyGroup(g)
set caster=null
set u=null
set t=null
set g=null
endfunction
