function Trig_BossSummon_Conditions takes nothing returns boolean
if(not(RectContainsUnit(gg_rct_Priziv,GetManipulatingUnit())==true))then
return false
endif
return true
endfunction
function Trig_BossSummon_Func001C takes nothing returns boolean
if(not(GetItemTypeId(GetManipulatedItem())=='I04G'))then
return false
endif
return true
endfunction
function Trig_BossSummon_Func002C takes nothing returns boolean
if(not(GetItemTypeId(GetManipulatedItem())=='I04H'))then
return false
endif
return true
endfunction
function Trig_BossSummon_Actions takes nothing returns nothing
if(Trig_BossSummon_Func001C())then
call RemoveItem(GetItemOfTypeFromUnitBJ(GetManipulatingUnit(),'I04G'))
call ConditionalTriggerExecute(gg_trg_Create)
else
endif
if(Trig_BossSummon_Func002C())then
call RemoveItem(GetItemOfTypeFromUnitBJ(GetManipulatingUnit(),'I04H'))
