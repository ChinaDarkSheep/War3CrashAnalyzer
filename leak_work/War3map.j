function F_Plants_Storage takes nothing returns nothing
local unit u=GetEnumUnit()
local integer a
local integer b
local integer i
local integer id
local integer ID
local integer itemID
local integer exp
if IsUnitType(u,UNIT_TYPE_HERO)then
set i=0
loop
exitwhen i>5
set itemID=GetItemTypeId(UnitItemInSlot(u,i))
if itemID=='I00F' then
call RemoveItem(UnitItemInSlot(u,i))
set bj_lastCreatedEffect=AddSpecialEffectTarget("UI\\Feedback\\GoldCredit\\GoldCredit.mdl",u,"overhead")
call DestroyEffect(bj_lastCreatedEffect)
set id=GetPlayerId(GetOwningPlayer(u))
set ID=id+1
set b=R2I(75*GoldAvg[ID])
call SetPlayerStateBJ(Player(id),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)+b)
set exp=75
set b=R2I(exp*udg_HeroExp[ID])
call AddHeroXP(udg_Hero[ID],b,true)
set a=1
loop
exitwhen a>8
if udg_Hero[a]!=null then
set b=R2I(exp*udg_HeroExp[a])
call AddHeroXP(udg_Hero[a],b,true)
endif
set a=a+1
endloop
set udg_Plants[ID]=udg_Plants[ID]+1
if udg_Plants[ID]==150 then
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,"|cFF52EDF1Игрок|r |cFFFFDC00"+GetPlayerName(Player(id))+"|r |cFF52EDF1сдал в склад 150 растений и получает \"Пояс Земли\"!")
call UnitAddItemByIdSwapped('I03W',u)
set QuestsNT[ID]=QuestsNT[ID]+1
endif
endif
if itemID=='I00E' then
call RemoveItem(UnitItemInSlot(u,i))
call RemoveItem(UnitItemInSlot(u,i))
set bj_lastCreatedEffect=AddSpecialEffectTarget("UI\\Feedback\\GoldCredit\\GoldCredit.mdl",u,"overhead")
call DestroyEffect(bj_lastCreatedEffect)
set id=GetPlayerId(GetOwningPlayer(u))
set ID=id+1
set b=R2I(18*GoldAvg[ID])
call SetPlayerStateBJ(Player(id),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)+b)
set exp=15
set b=R2I(exp*udg_HeroExp[ID])
call AddHeroXP(udg_Hero[ID],b,true)
set a=1
loop
exitwhen a>8
if udg_Hero[a]!=null then
set b=R2I(exp*udg_HeroExp[a])
call AddHeroXP(udg_Hero[a],b,true)
endif
set a=a+1
endloop
set udg_Plants[ID]=udg_Plants[ID]+1
if udg_Plants[ID]==150 then
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,"|cFF52EDF1Игрок|r |cFFFFDC00"+GetPlayerName(Player(id))+"|r |cFF52EDF1сдал в склад 150 растений и получает \"Пояс Земли\"!")
call UnitAddItemByIdSwapped('I03W',u)
set QuestsNT[ID]=QuestsNT[ID]+1
endif
else
endif
if itemID=='I06A' then
call RemoveItem(UnitItemInSlot(u,i))
set bj_lastCreatedEffect=AddSpecialEffectTarget("UI\\Feedback\\GoldCredit\\GoldCredit.mdl",u,"overhead")
call DestroyEffect(bj_lastCreatedEffect)
set id=GetPlayerId(GetOwningPlayer(u))
set ID=id+1
set b=R2I(200.*GoldAvg[ID])
call SetPlayerStateBJ(Player(id),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)+b)
set exp=200
set b=R2I(exp*udg_HeroExp[ID])
call AddHeroXP(udg_Hero[ID],b,true)
set a=1
loop
exitwhen a>8
if udg_Hero[a]!=null then
set b=R2I(exp*udg_HeroExp[a])
call AddHeroXP(udg_Hero[a],b,true)
endif
set a=a+1
endloop
set udg_Plants[ID]=udg_Plants[ID]+1
if udg_Plants[ID]==150 then
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,"|cFF52EDF1Игрок|r |cFFFFDC00"+GetPlayerName(Player(id))+"|r |cFF52EDF1сдал в склад 150 растений и получает \"Пояс Земли\"!")
call UnitAddItemByIdSwapped('I03W',u)
set QuestsNT[ID]=QuestsNT[ID]+1
endif
else
endif
set i=i+1
endloop
endif
set u=null
endfunction
function Trig_SellPlants_Actions takes nothing returns nothing
local group g=CreateGroup()
local unit u=null
local integer a
local integer b
local integer i
local integer id
local integer ID
local integer itemID
call GroupEnumUnitsInRect(g,gg_rct_Sklad1,Bool_FilterAlive)
call ForGroup(g,function F_Plants_Storage)
call GroupClear(g)
call GroupEnumUnitsInRect(g,gg_rct_Sklad2,Bool_FilterAlive)
call ForGroup(g,function F_Plants_Storage)
call GroupClear(g)
call GroupEnumUnitsInRect(g,gg_rct_BlackMarket,Bool_FilterAlive)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitType(u,UNIT_TYPE_HERO)then
set i=0
loop
exitwhen i>5
set itemID=GetItemTypeId(UnitItemInSlot(u,i))
if itemID=='I044' then
if GetItemCharges(UnitItemInSlot(u,i))==1 then
call RemoveItem(UnitItemInSlot(u,i))
else
call SetItemCharges(UnitItemInSlot(u,i),(GetItemCharges(UnitItemInSlot(u,i))-1))
endif
set bj_lastCreatedEffect=AddSpecialEffectTarget("UI\\Feedback\\GoldCredit\\GoldCredit.mdl",u,"overhead")
call DestroyEffect(bj_lastCreatedEffect)
set id=GetPlayerId(GetOwningPlayer(u))
set ID=id+1
set b=R2I(200.*udg_HeroExp[ID])
if u==udg_Orc and udg_BilderQuestOrc[2]<5000 then
set udg_BilderQuestOrc[2]=udg_BilderQuestOrc[2]+200
if udg_BilderQuestOrc[2]>=5000 then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],20.00,"|cFF00C850Вы набрали необходимое количество очков браконьерства|r")
endif
endif
call AddHeroXP(udg_Hero[ID],b,true)
elseif itemID=='I045' then
if GetItemCharges(UnitItemInSlot(u,i))==1 then
call RemoveItem(UnitItemInSlot(u,i))
else
call SetItemCharges(UnitItemInSlot(u,i),(GetItemCharges(UnitItemInSlot(u,i))-1))
endif
set bj_lastCreatedEffect=AddSpecialEffectTarget("UI\\Feedback\\GoldCredit\\GoldCredit.mdl",u,"overhead")
call DestroyEffect(bj_lastCreatedEffect)
set id=GetPlayerId(GetOwningPlayer(u))
set ID=id+1
set b=R2I(600.*udg_HeroExp[ID])
if u==udg_Orc and udg_BilderQuestOrc[2]<5000 then
set udg_BilderQuestOrc[2]=(udg_BilderQuestOrc[2]+600)
if udg_BilderQuestOrc[2]>=5000 then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],20.00,"|cFF00C850Вы набрали необходимое количество очков браконьерства|r")
endif
endif
call AddHeroXP(udg_Hero[ID],b,true)
elseif itemID=='I043' then
if GetItemCharges(UnitItemInSlot(u,i))==1 then
call RemoveItem(UnitItemInSlot(u,i))
else
call SetItemCharges(UnitItemInSlot(u,i),(GetItemCharges(UnitItemInSlot(u,i))-1))
endif
set bj_lastCreatedEffect=AddSpecialEffectTarget("UI\\Feedback\\GoldCredit\\GoldCredit.mdl",u,"overhead")
call DestroyEffect(bj_lastCreatedEffect)
set id=GetPlayerId(GetOwningPlayer(u))
set ID=id+1
set b=R2I(600.*udg_HeroExp[ID])
if u==udg_Orc and udg_BilderQuestOrc[2]<5000 then
set udg_BilderQuestOrc[2]=(udg_BilderQuestOrc[2]+600)
if udg_BilderQuestOrc[2]>=5000 then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[id],20.00,"|cFF00C850Вы набрали необходимое количество очков браконьерства|r")
endif
endif
call AddHeroXP(udg_Hero[ID],b,true)
endif
set i=i+1
endloop
endif
call GroupRemoveUnit(g,u)
endloop
call GroupEnumUnitsInRect(g,gg_rct_Alchemist,Bool_FilterAlive)
loop
set u=FirstOfGroup(g)
exitwhen u==null
set id=GetPlayerId(GetOwningPlayer(u))
set ID=id+1
if udg_AlchemyPoints[ID]<3300 then
set i=0
loop
exitwhen i>5
set itemID=GetItemTypeId(UnitItemInSlot(u,i))
if itemID=='I00L' then
set b=15
set a=GetItemCharges(UnitItemInSlot(u,i))
if udg_AlchemyPoints[ID]+a*b<3300 then
call RemoveItem(UnitItemInSlot(u,i))
set udg_AlchemyPoints[ID]=udg_AlchemyPoints[ID]+a*b
else
call SetItemCharges(UnitItemInSlot(u,i),a-(3300-udg_AlchemyPoints[ID])/b)
set udg_AlchemyPoints[ID]=3300
endif
call DestroyEffect(AddSpecialEffectTarget("UI\\Feedback\\GoldCredit\\GoldCredit.mdl",u,"overhead"))
