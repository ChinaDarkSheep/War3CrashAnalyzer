function InitTrig_CreepDeathJass takes nothing returns nothing
set gg_trg_CreepDeathJass=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_CreepDeathJass,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(gg_trg_CreepDeathJass,Condition(function Trig_CreepDeathJass_Conditions))
call TriggerAddAction(gg_trg_CreepDeathJass,function Trig_CreepDeathJass_Actions)
endfunction
function OtherDeath_Timer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
if not udg_Setstart then
set bj_lastCreatedUnit=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),LoadInteger(udg_hash,ht,0),LoadReal(udg_hash,ht,1),LoadReal(udg_hash,ht,2),GetRandomInt(1,360))
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set t=null
endfunction
