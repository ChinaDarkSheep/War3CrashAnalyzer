function Trig_CreepsAmount_Actions takes nothing returns nothing
local group g
local timer t
local integer ht
set g=Gdel40s
set bj_groupCountUnits=0
call ForGroup(g,function Trig_CreepsAmount_Alive)
if bj_groupCountUnits>0 then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveGroupHandle(udg_hash,ht,0,g)
call TimerStart(t,40.,false,function Trig_Optimization2_T)
else
call DestroyGroup(g)
endif
set Gdel40s=CreateGroup()
set g=Gdel1s5
set bj_groupCountUnits=0
call ForGroup(g,function Trig_CreepsAmount_Alive)
if bj_groupCountUnits>0 then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveGroupHandle(udg_hash,ht,0,g)
call TimerStart(t,1.5,false,function Trig_Optimization2_T)
else
call DestroyGroup(g)
endif
set Gdel1s5=CreateGroup()
set g=CreateGroup()
set udg_CreepsAmount=0
call GroupEnumUnitsOfPlayer(g,Player(8),Bool_FilterAlive)
set udg_CreepsAmount=(CountUnitsInGroup(g)+udg_CreepsAmount)
call GroupClear(g)
call GroupEnumUnitsOfPlayer(g,Player(10),Bool_FilterAlive)
set udg_CreepsAmount=(CountUnitsInGroup(g)+udg_CreepsAmount)
call GroupClear(g)
call GroupEnumUnitsOfPlayer(g,Player(11),Bool_FilterAlive)
set udg_CreepsAmount=(CountUnitsInGroup(g)+udg_CreepsAmount)
call DestroyGroup(g)
set g=null
set t=null
endfunction
function InitTrig_CreepsAmount takes nothing returns nothing
call TimerStart(Timer2s,2.,true,function Trig_CreepsAmount_Actions)
endfunction
