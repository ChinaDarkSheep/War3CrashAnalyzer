loop
exitwhen Loop>2
set u=CreateUnit(GetOwningPlayer(caster),TfsID,x,y,GetUnitFacing(caster))
set i=SeekFreeUnitMin(GetHandleId(u))
call UnitAddAbility(u,'A007')
call UnitApplyTimedLife(u,'BTLF',30.)
set hp=6*I2R(str)+5*I2R(intel)
set dmg=0.45*I2R(intel)
set drop=GetUnitLevel(u)
if drop>15 then
set drop=15
endif
set hp=hp*(1+0.04*drop)
set dmg=dmg*(1+0.04*drop)
if GetHeroLevel(caster)>=50 then
set hp=1.4*hp
endif
if GetUnitTypeId(u)=='nbdr' then
set dmg=0.5*dmg
endif
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'A007')
if GetHeroLevel(caster)>=50 then
set s__Units_Arm[sUnit[i]]=s__Units_Arm[sUnit[i]]+40
call F_Armore(u,s__Units_Arm[sUnit[i]])
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+6)
endif
if GetHeroLevel(caster)>=50 then
call UnitAddAbility(u,'A17N')
call SetUnitAbilityLevel(u,'A17N',GetUnitAbilityLevel(u,'A17N')+15)
if GetUnitAbilityLevel(u,'A0S7')==0 and GetUnitAbilityLevel(u,'A15Z')==0 and GetUnitAbilityLevel(u,'A18R')==0 and GetUnitAbilityLevel(u,'A0M3')==0 and GetUnitAbilityLevel(u,'A18Q')==0 then
call UnitAddAbility(u,'A0S7')
if GetUnitAbilityLevel(u,'A0S8')==1 then
call UnitRemoveAbility(u,'A0S8')
endif
endif
endif
set Loop=Loop+1
endloop
if GetHeroLevel(caster)>=50 and G_int<5 then
set u=CreateUnit(GetOwningPlayer(caster),TfsID,x,y,GetUnitFacing(caster))
set i=SeekFreeUnitMin(GetHandleId(u))
set hp=6*I2R(str)+5*I2R(intel)
set dmg=0.45*I2R(intel)
set drop=GetUnitLevel(u)
if drop>15 then
set drop=15
endif
set hp=hp*(1+0.04*drop)
set dmg=dmg*(1+0.04*drop)
if GetHeroLevel(caster)>=50 then
set hp=1.4*hp
endif
if GetUnitTypeId(u)=='nbdr' then
set dmg=0.5*dmg
endif
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call GroupAddUnit(G_max,u)
call UnitRemoveAbility(u,'A007')
if GetHeroLevel(caster)>=50 then
set s__Units_Arm[sUnit[i]]=s__Units_Arm[sUnit[i]]+40
call F_Armore(u,s__Units_Arm[sUnit[i]])
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+6)
endif
if GetHeroLevel(caster)>=50 then
call UnitAddAbility(u,'A17N')
call SetUnitAbilityLevel(u,'A17N',GetUnitAbilityLevel(u,'A17N')+15)
if GetUnitAbilityLevel(u,'A0S7')==0 and GetUnitAbilityLevel(u,'A15Z')==0 and GetUnitAbilityLevel(u,'A18R')==0 and GetUnitAbilityLevel(u,'A0M3')==0 and GetUnitAbilityLevel(u,'A18Q')==0 then
call UnitAddAbility(u,'A0S7')
if GetUnitAbilityLevel(u,'A0S8')==1 then
call UnitRemoveAbility(u,'A0S8')
endif
endif
endif
endif
elseif udg_Talante[ID]==3 then
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,1200,Bool_Filter_ID_Ally)
set dmg=highstat*0.5+25*GetUnitAbilityLevel(caster,'A0US')
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitType(u,UNIT_TYPE_HERO)then
call TempStats(u,0,0,0,R2I(dmg*(.75+.25*LoadReal(udg_hash,GetHandleId(u),4))),0,0,PositiveDuration(caster,16))
endif
call GroupRemoveUnit(g,u)
endloop
endif
set dmg=GetUnitAbilityLevel(caster,'A0US')*40
if udg_Talante[ID]==1 then
set dmg=dmg+1.*GetHeroAgi(caster,true)
if GetHeroLevel(caster)<50 then
call UnitRemoveAbility(caster,'A1A9')
endif
set r=18
else
set r=12
endif
set r=PositiveDuration(caster,r)
call TempStats(caster,0,0,0,R2I(dmg),0,0,r)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,r,false,function Thief_Q)
endif
if GetSpellAbilityId()=='A0E9' then
set u=GetSpellTargetUnit()
set drop=GetUnitLevel(u)
if(drop>=15 and ModuloInteger(drop,5)==0)or GetUnitAbilityLevel(u,'Arsk')==1 or IsUnitType(u,UNIT_TYPE_HERO)or GetUnitTypeId(u)=='n02P' or IsUnitAlly(u,Player(ID-1))or IsUnitType(u,UNIT_TYPE_STRUCTURE)then
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"Вы не можете подкупить это существо")
elseif not(G_int<5)then
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"Превышен лимит!")
elseif GetUnitAbilityLevel(caster,'A155')*5<drop and GetUnitAbilityLevel(caster,'A155')<5 then
call DisplayTextToForce(bj_FORCE_PLAYER[ID-1],"Нехватает уровня способности")
else
set TfsID=GetUnitTypeId(u)
set u=CreateUnit(GetOwningPlayer(caster),TfsID,GetUnitX(caster),GetUnitY(caster),GetUnitFacing(caster))
set i=SeekFreeUnit(GetHandleId(u))
