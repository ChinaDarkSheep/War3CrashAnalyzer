function HighStat_Delete takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(hero)
local integer highstat=LoadInteger(udg_hash,ht,1)
call SaveInteger(udg_hash,h,H_HighStat,LoadInteger(udg_hash,h,H_HighStat)-highstat)
call F_Stats(hero)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set hero=null
set t=null
endfunction
function HighStat takes unit hero,integer highstat,real second returns nothing
