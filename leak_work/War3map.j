function Trig_Thief_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local integer h=GetHandleId(caster)
local integer ihh=LoadInteger(udg_hash,h,5)
local real dmg
local real hp
local real y
local real x
local real r
local integer drop
local integer intel
local integer str
local timer t
local integer ht
local group g=CreateGroup()
local group g2
local unit u
local integer highstat=LoadInteger(udg_hash,h,StringHash("HighStatNum"))
local integer i
local group G_max=LoadGroupHandle(udg_hash,h,StringHash("GforSummon"))
local integer G_int
local integer Loop
local integer TfsID=LoadInteger(udg_hash,h,StringHash("IdforSummon"))
call SaveInteger(udg_hash,h,StringHash("IdforSummon"),TfsID)
set udg_Drop=0
call ForGroup(G_max,function SumAliveMar)
set G_int=0+udg_Drop
if GetSpellAbilityId()=='A0E7' then
if udg_Talante[ID]==1 then
set hp=3.*GetHeroAgi(caster,true)
if GetHeroLevel(caster)>=50 then
set hp=2.*hp
endif
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+hp)
endif
set i=GetPlayerId(GetOwningPlayer(GetSpellTargetUnit()))
if i>=8 then
set drop=GetUnitLevel(GetSpellTargetUnit())*30
call SetPlayerStateBJ(Player(ID-1),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(ID-1),PLAYER_STATE_RESOURCE_GOLD)+drop)
set GoldNT[ID]=GoldNT[ID]+drop
set x=GetUnitX(GetSpellAbilityUnit())
set y=GetUnitY(GetSpellAbilityUnit())
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl",x,y))
set udg_TEXT=CreateTextTag()
call SetTextTagTextBJ(udg_TEXT,"|cFFFFDC00+"+I2S(drop),1.)
call SetTextTagPos(udg_TEXT,x,y,0)
call SetTextTagColorBJ(udg_TEXT,100,100,100,0)
call SetTextTagVisibility(udg_TEXT,false)
if GetLocalPlayer()==Player(ID-1)then
call SetTextTagVisibility(udg_TEXT,true)
endif
call SetTextTagVelocityBJ(udg_TEXT,75,GetRandomReal(80,120))
call SetTextTagSuspended(udg_TEXT,false)
call SetTextTagPermanent(udg_TEXT,false)
call SetTextTagLifespan(udg_TEXT,3)
call SetTextTagFadepoint(udg_TEXT,2)
if udg_Talante[ID]==3 then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set udg_Drop2=ID-1
call GroupEnumUnitsInRange(g,x,y,1000,Bool_Filter_ID_Ally)
call GroupRemoveUnit(g,caster)
set g2=CreateGroup()
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitType(u,UNIT_TYPE_HERO)then
call GroupAddUnit(g2,u)
endif
call GroupRemoveUnit(g,u)
endloop
call RandomUnitFromGroup(1,g2)
set u=FirstOfGroup(g2)
call DestroyGroup(g2)
set str=GetPlayerId(GetOwningPlayer(u))+1
set drop=GetUnitLevel(GetSpellTargetUnit())*6
call SetPlayerStateBJ(Player(str-1),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(str-1),PLAYER_STATE_RESOURCE_GOLD)+drop)
set GoldNT[str]=GoldNT[str]+drop
set x=GetUnitX(GetSpellAbilityUnit())
set y=GetUnitY(GetSpellAbilityUnit())
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl",x,y))
set udg_TEXT=CreateTextTag()
call SetTextTagTextBJ(udg_TEXT,"|cFFFFDC00+"+I2S(drop),1.)
call SetTextTagPos(udg_TEXT,x,y,0)
call SetTextTagColorBJ(udg_TEXT,100,100,100,0)
call SetTextTagVisibility(udg_TEXT,false)
if GetLocalPlayer()==Player(str-1)then
call SetTextTagVisibility(udg_TEXT,true)
endif
call SetTextTagVelocityBJ(udg_TEXT,75,GetRandomReal(80,120))
call SetTextTagSuspended(udg_TEXT,false)
call SetTextTagPermanent(udg_TEXT,false)
call SetTextTagLifespan(udg_TEXT,3)
call SetTextTagFadepoint(udg_TEXT,2)
endif
endif
else
endif
if GetSpellAbilityId()=='A0OY' then
if udg_Talante[ID]==1 then
set i=LoadInteger(Hash,h,0)
set s__Units_AllBlock[sUnit[i]]=s__Units_AllBlock[sUnit[i]]+2500
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,PositiveDuration(caster,10),false,function Thief_R1)
elseif udg_Talante[ID]==2 then
set Loop=1
call SeekMinUnit()
loop
exitwhen Loop>2
set u=CreateUnit(GetOwningPlayer(caster),TfsID,GetUnitX(caster),GetUnitY(caster),GetUnitFacing(caster))
set i=SeekFreeUnitMin(GetHandleId(u))
set str=GetHeroStr(caster,true)-s__Heroes_TempStr[sHero[ihh]]/2
set intel=GetHeroInt(caster,true)-s__Heroes_TempInt[sHero[ihh]]/2
set hp=6*str+5*intel
set dmg=0.45*intel
set drop=GetUnitLevel(u)
if drop>15 then
set drop=15
endif
set hp=hp*(1+0.04*drop)
set dmg=dmg*(1+0.04*drop)
if GetHeroLevel(caster)>=50 then
set hp=1.5*hp
endif
if GetUnitTypeId(u)=='nbdr' then
set dmg=0.5*dmg
endif
call UnitApplyTimedLife(u,'BTLF',30.)
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'A007')
if GetHeroLevel(caster)>=50 then
set s__Units_Arm[sUnit[i]]=s__Units_Arm[sUnit[i]]+40
call F_Armore(u,s__Units_Arm[sUnit[i]])
call UnitAddAbility(u,'A17N')
call SetUnitAbilityLevel(u,'A17N',GetUnitAbilityLevel(u,'A17N')+15)
call UnitAddAbility(u,'A1BF')
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+6)
if GetUnitAbilityLevel(u,'A0S7')==0 and GetUnitAbilityLevel(u,'A15Z')==0 and GetUnitAbilityLevel(u,'A18R')==0 and GetUnitAbilityLevel(u,'A0M3')==0 and GetUnitAbilityLevel(u,'A18Q')==0 then
call UnitAddAbility(u,'A0S7')
if GetUnitAbilityLevel(u,'A0S8')==1 then
call UnitRemoveAbility(u,'A0S8')
endif
endif
endif
set Loop=Loop+1
endloop
elseif udg_Talante[ID]==3 then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
call GroupEnumUnitsInRange(g,x,y,800,null)
set hp=highstat*3+500
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)and IsUnitAlly(u,Player(ID-1))then
if IsUnitType(u,UNIT_TYPE_HERO)then
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+2*hp)
else
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+hp)
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Heal\\HealTarget.mdl",u,"origin"))
endif
call GroupRemoveUnit(g,u)
endloop
endif
if not udg_ThiefLogic then
call UnitAddItemByIdSwapped(ChooseRandomItemBJ(5),caster)
call AddSpecialEffectTargetUnitBJ("origin",caster,"Abilities\\Spells\\Other\\Awaken\\Awaken.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
set udg_ThiefLogic=true
endif
endif
if GetSpellAbilityId()=='A0US' then
