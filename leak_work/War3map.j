function Trig_CDWaveClear_Actions takes nothing returns nothing
call DisableTrigger(GetTriggeringTrigger())
call DisableTrigger(gg_trg_CDLose)
call DisplayTextToForce(GetPlayersAll(),"|cFF00C850Волна пройдена!|r")
set udg_ug=GetUnitsOfTypeIdAll('etoe')
call ForGroupBJ(udg_ug,function Trig_CDWaveClear_Func005A)
call DestroyGroup(udg_ug)
set udg_Drop=(2+udg_WavesCount)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=8
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set udg_PlayerExp[GetForLoopIndexA()]=(udg_PlayerExp[GetForLoopIndexA()]+udg_Drop)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call DisplayTextToForce(GetPlayersAll(),("|cFF20C6CDНачислено очков за прохождение волны - "+I2S(udg_Drop)))
call ForGroupBJ(udg_AllHeroes,function Trig_CDWaveClear_Func010A)
call TriggerSleepAction(4.00)
if udg_WavesCount>10 then
set udg_Drop=4000
call ForGroupBJ(udg_AllHeroes,function Trig_CDWaveClear_Func012Func005A)
call ForGroupBJ(udg_AllHeroes,function Trig_CDWaveClear_Func012Func006A)
else
set udg_Drop=2000
call ForGroupBJ(udg_AllHeroes,function Trig_CDWaveClear_Func012Func002A)
call ForGroupBJ(udg_AllHeroes,function Trig_CDWaveClear_Func012Func003A)
endif
call DisplayTextToForce(GetPlayersAll(),("|cFFFFDC00Вы получили "+(I2S(udg_Drop)+" ед. золота за прохождение волны.|r")))
set udg_HeroResPoint=GetRectCenter(gg_rct_StartPlace)
call ForGroupBJ(udg_AllHeroes,function Trig_CDWaveClear_Func015A)
call StartTimerBJ(udg_AttackTimer,false,60.00)
call CreateTimerDialogBJ(udg_AttackTimer,"Подготовка")
set udg_TimerWindow=GetLastCreatedTimerDialogBJ()
set udg_ug=GetUnitsOfPlayerMatching(Player(9),Condition(function Trig_CDWaveClear_Func019002002))
call ForGroupBJ(udg_ug,function Trig_CDWaveClear_Func020A)
call DestroyGroup(udg_ug)
if udg_WavesCount==20 then
call DisplayTimedTextToForce(GetPlayersAll(),30,"|cFF00C850ВСЕ ВОЛНЫ ПРОЙДЕНЫ\n\nВы смогли пройти режим \\\"Classic Defence\\\"!")
call PauseTimerBJ(true,udg_AttackTimer)
call DisableTrigger(gg_trg_FastStart)
call TriggerSleepAction(28.00)
call ForForce(GetPlayersAll(),function Trig_CDWaveClear_Func022Func005A)
else
endif
call EnableTrigger(gg_trg_FastStart)
endfunction
