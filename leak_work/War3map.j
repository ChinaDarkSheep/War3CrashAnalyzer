endfunction
function Trig_EndFase3_Conditions takes nothing returns boolean
if(not(udg_CreepsAmount==0))then
return false
endif
return true
endfunction
function Trig_EndFase3_Actions takes nothing returns nothing
call DisableTrigger(GetTriggeringTrigger())
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=8
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call SetPlayerAllianceBJ(Player(8),ALLIANCE_SHARED_VISION,true,ConvertedPlayer(GetForLoopIndexA()))
call SetPlayerAllianceBJ(Player(10),ALLIANCE_SHARED_VISION,true,ConvertedPlayer(GetForLoopIndexA()))
call SetPlayerAllianceBJ(Player(11),ALLIANCE_SHARED_VISION,true,ConvertedPlayer(GetForLoopIndexA()))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
if udg_Mode==2 then
call PlayerGetEXP(4500)
else
if udg_HARDSET==10 then
call PlayerGetEXP(3000)
else
call PlayerGetEXP(1200)
endif
endif
if udg_HARDSET==10 then
call DisplayTimedTextToForce(GetPlayersAll(),120.00,"|cFF00C850ТРЕТЬЯ ФАЗА ПРОЙДЕНА!\n\nВы прошли самый сложный hardset в стандартном режиме!")
else
call DisplayTimedTextToForce(GetPlayersAll(),120.00,"|cFF00C850ТРЕТЬЯ ФАЗА ПРОЙДЕНА!\n\nВы прошли самый сложный set в стандартном режиме!")
endif
call Winend_Text()
endfunction
