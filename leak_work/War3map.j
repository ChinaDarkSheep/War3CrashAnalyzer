function Trig_MoargSkills_W takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,h,0)
local integer i=LoadInteger(udg_hash,h,1)
local group g=LoadGroupHandle(udg_hash,h,2)
local group g2=CreateGroup()
local unit u
local real dmg=(GetUnitAbilityLevel(udg_Moarg,'A0SL')*20+1.5*GetHeroStr(udg_Moarg,true))*(1+0.3*LoadReal(udg_hash,h,3))
if i !=0 then
set i=i-1
call SaveInteger(udg_hash,h,1,i)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)then
call UnitDamageTarget(udg_Moarg,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupAddUnit(g2,u)
else
call UnitRemoveAbility(u,'A0SM')
endif
call GroupRemoveUnit(g,u)
endloop
call SaveGroupHandle(udg_hash,h,2,g2)
else
call UnitRemoveAbility(caster,'A0YW')
call UnitRemoveAbility(caster,'A0SN')
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitRemoveAbility(u,'A0SM')
call GroupRemoveUnit(g,u)
endloop
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,h)
call DestroyGroup(g2)
endif
call DestroyGroup(g)
set t=null
set g2=null
set g=null
set u=null
endfunction
