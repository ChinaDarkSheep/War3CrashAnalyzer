call UnitAddItemByIdSwapped('arsh',GetSpellAbilityUnit())
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
set SpellItem=null
set Item1=null
set Item2=null
return
endif
