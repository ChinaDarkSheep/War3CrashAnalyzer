exitwhen u==null
if UnitAlive(u)then
set TreeLimit=TreeLimit+1000
endif
call GroupRemoveUnit(g,u)
endloop
set bj_groupEnumTypeId='h031'
call GroupEnumUnitsOfPlayer(g,Player(id),filterGetUnitsOfPlayerAndTypeId)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)then
set TreeLimit=TreeLimit+2000
endif
call GroupRemoveUnit(g,u)
endloop
if udg_BilderQuestAl[21]==2 then
set TreeLimit=(TreeLimit*140)/100
endif
if GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_LUMBER)>TreeLimit then
call SetPlayerStateBJ(Player(id),PLAYER_STATE_RESOURCE_LUMBER,TreeLimit)
call CreateTextTagUnitBJ("|cFFC60000Склад переполнен!|r",udg_Hero[id+1],0,9.,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.,GetRandomReal(80.,120.))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.)
call SetTextTagFadepointBJ(udg_TEXT,2.)
endif
call DestroyGroup(g)
set g=null
set u=null
set t=null
endfunction
function BuyHeroJass_Fil_DelOtherHeroes takes nothing returns boolean
return(IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO)and GetFilterUnit()!=GetEnteringUnit())
endfunction
function BuyHeroJass_G_DelOtherHeroes takes nothing returns nothing
call RemoveUnit(GetEnumUnit())
endfunction
function Trig_FireMageW_Filter takes nothing returns boolean
return(GetUnitAbilityLevel(GetFilterUnit(),'B00E')>0)
endfunction
function Trig_FireMageW_Heal takes nothing returns nothing
call SetUnitState(GetEnumUnit(),UNIT_STATE_LIFE,GetUnitState(GetEnumUnit(),UNIT_STATE_LIFE)+udg_EnergyWR/70.)
endfunction
function Trig_FireMageW takes nothing returns nothing
call GroupEnumUnitsInRect(udg_GroupHealWR,bj_mapInitialPlayableArea,Condition(function Trig_FireMageW_Filter))
call ForGroup(udg_GroupHealWR,function Trig_FireMageW_Heal)
call GroupClear(udg_GroupHealWR)
endfunction
function Trig_PotmSkillE takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(Hash,ht,0)
local real heal
if hero !=null then
if GetUnitAbilityLevel(hero,'A0SV')>0 then
if GetUnitAbilityLevel(hero,'A0SW')==0 then
if GetUnitLifePercent(hero)>=40.00 then
if GetHeroLevel(hero)>=50 then
call UnitAddAbility(hero,'A12E')
endif
call UnitAddAbility(hero,'A0SW')
call SetUnitAbilityLevel(hero,'A0SW',GetUnitAbilityLevel(hero,'A0SV'))
else
endif
else
if not(GetUnitLifePercent(hero)>=40.00)then
call UnitRemoveAbility(hero,'A0SW')
call UnitRemoveAbility(hero,'A12E')
call UnitRemoveAbility(hero,'B02A')
set heal=3.*GetUnitAbilityLevel(hero,'A0SW')
if GetHeroLevel(hero)>=50 then
set heal=heal+0.01*GetUnitState(hero,UNIT_STATE_MAX_LIFE)
endif
set heal=heal/2
call SetUnitState(hero,UNIT_STATE_LIFE,GetUnitState(hero,UNIT_STATE_LIFE)+heal)
else
call SetUnitAbilityLevel(hero,'A0SW',GetUnitAbilityLevel(hero,'A0SV'))
if GetHeroLevel(hero)>=50 then
call UnitAddAbility(hero,'A12E')
endif
endif
endif
endif
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(Hash,ht)
endif
set t=null
set hero=null
endfunction
function Trig_ThingBaseWait takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer ID=LoadInteger(Hash,ht,0)
local group g=CreateGroup()
set bj_groupEnumTypeId='ncop'
call GroupEnumUnitsOfPlayer(g,Player(ID-1),filterGetUnitsOfPlayerAndTypeId)
set bj_lastCreatedUnit=FirstOfGroup(g)
call SetUnitPosition(udg_Hero[ID],GetUnitX(bj_lastCreatedUnit)+80,GetUnitY(bj_lastCreatedUnit)-80)
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(Hash,ht)
set g=null
set t=null
endfunction
function Trig_BuyHeroJass_Actions takes nothing returns nothing
