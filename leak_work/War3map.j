call SetPlayerAbilityAvailable(Player(i),'A15X',false)
call SetPlayerAbilityAvailable(Player(i),'A0O0',false)
call SetPlayerAbilityAvailable(Player(i),'A12E',false)
call SetPlayerAbilityAvailable(Player(i),'A16T',false)
