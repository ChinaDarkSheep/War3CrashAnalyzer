function SummonStats takes boolean up,integer hp,integer dmg,unit u,unit hero returns nothing
local integer ID=GetPlayerId(GetOwningPlayer(u))+1
local integer h=GetHandleId(hero)
local integer a=0
local integer b=0
local integer array drop
local real r
local real x=GetUnitY(u)
local real y=GetUnitY(u)
local item it
set DelPowerUP=false
if not IsUnitInGroup(u,udg_HeroBuild)then
if up==true then
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='ktrm' then
if GetUnitAbilityLevel(u,'A17N')==0 then
call UnitAddAbility(u,'A17N')
endif
call SetUnitAbilityLevel(u,'A17N',GetUnitAbilityLevel(u,'A17N')+3)
elseif GetItemTypeId(UnitItemInSlot(udg_Trophy_build[ID],0))=='ratf' then
set dmg=20+dmg
set hp=300+hp
endif
if udg_Talante[ID]==2 then
if GetUnitAbilityLevel(hero,'A0C8')==1 then
set hp=hp+R2I(.25*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
endif
endif
set b=0
set a=0
loop
exitwhen a>=6
if GetItemTypeId(UnitItemInSlot(hero,a))=='shwd' then
set b=1
set a=6
endif
set a=a+1
endloop
if b==1 then
set hp=hp+R2I(0.3*GetUnitState(hero,UNIT_STATE_MAX_LIFE))
endif
set r=1.+LoadReal(udg_hash,h,StringHash("SummonHP"))
set hp=R2I(I2R(hp)*r)
set r=1.+LoadReal(udg_hash,h,StringHash("SummonAT"))
set dmg=R2I(I2R(dmg)*r)
set a=0
set b=0
loop
exitwhen a>=6
if GetItemTypeId(UnitItemInSlot(hero,a))=='I0DU' then
set b=1
set a=6
endif
set a=a+1
endloop
if b==1 then
if IsUnitInGroup(hero,udg_ItemComplectGroup[6])then
set r=1.55
else
set r=1.35
endif
set hp=R2I(I2R(hp)*r)
set dmg=R2I(I2R(dmg)*r)
endif
if IsUnitInGroup(hero,udg_ItemComplectGroup[6])then
set hp=R2I(I2R(hp)*1.25)
endif
endif
