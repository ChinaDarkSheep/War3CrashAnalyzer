function Trig_AtkSpawn4_Actions takes nothing returns nothing
local timer t
local real r=0.
local integer a=1
local real x
local real y
local real x1
local real y1
local real z
if GetUnitTypeId(GetAttacker())=='u00Y' then
set a=1
set x=GetUnitX(GetAttacker())
set y=GetUnitY(GetAttacker())
loop
exitwhen a>4
set z=GetRandomReal(0,360)
set x1=x+200.*Cos(z*bj_DEGTORAD)
set y1=y+200.*Sin(z*bj_DEGTORAD)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
set bj_lastCreatedUnit=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),'u00M',x1,y1,GetRandomReal(0,360))
set a=a+1
endloop
call DisableTrigger(GetTriggeringTrigger())
if udg_CheckLimitSpells[1]>=100 then
set r=2.5
set udg_CheckLimitSpells[1]=udg_CheckLimitSpells[1]+1
else
set r=4.
endif
set t=CreateTimer()
call TimerStart(t,r,false,function Trig_AtkSpawn4_CD)
endif
set t=null
endfunction
