function MefistoSkills_2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer sec=LoadInteger(udg_hash,ht,0)
local integer a
if sec>0 then
set sec=sec-1
call SaveInteger(udg_hash,ht,0,sec)
set a=0
loop
exitwhen a>7
if udg_Hero[a+1]!=null then
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(udg_Mefisto),'h03K',GetUnitX(udg_Hero[a+1]),GetUnitY(udg_Hero[a+1]),0.)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',2.5)
endif
set a=a+1
endloop
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
set t=null
endfunction
function Trig_MefistoSkills_Actions takes nothing returns nothing
local timer t
local integer ht
local integer a
local integer b
call UnitUseItem(udg_Mefisto,GetItemOfTypeFromUnitBJ(udg_Mefisto,'I059'))
set b=GetRandomInt(1,2)
if b==1 then
call TransmissionFromUnitWithNameBJ(bj_FORCE_ALL_PLAYERS,udg_Mefisto,"Мефисто",null,"Сладких снов.",bj_TIMETYPE_ADD,0,true)
set a=0
loop
exitwhen a>7
if udg_Hero[a+1]!=null and UnitAlive(udg_Hero[a+1])then
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(udg_Mefisto),'h009',GetUnitX(udg_Hero[a+1]),GetUnitY(udg_Hero[a+1]),0.)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',2.75)
call UnitAddAbility(bj_lastCreatedUnit,'A0L0')
call IssueTargetOrder(bj_lastCreatedUnit,"sleep",udg_Hero[a+1])
endif
set a=a+1
endloop
elseif b==2 then
call TransmissionFromUnitWithNameBJ(bj_FORCE_ALL_PLAYERS,udg_Mefisto,"Мефисто",null,"Сгори в адском пламени!",bj_TIMETYPE_ADD,0,true)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveInteger(udg_hash,ht,0,8)
call TimerStart(t,0.5,true,function MefistoSkills_2)
endif
set t=null
endfunction
