function TakeHeroAttack takes integer dmg,unit hero returns nothing
local integer h=GetHandleId(hero)
local integer ihh=LoadInteger(udg_hash,h,5)
if IsUnitType(hero,UNIT_TYPE_HERO)then
if UnitAlive(hero)then
call SummonStats(false,0,dmg,hero,hero)
set s__Heroes_BaseDmg[sHero[ihh]]=s__Heroes_BaseDmg[sHero[ihh]]+dmg
else
call SaveInteger(udg_hash,h,StringHash("ResBaseDamage"),LoadInteger(udg_hash,h,StringHash("ResBaseDamage"))+dmg)
endif
endif
endfunction
function TakeLooting takes unit u,integer itemID returns integer
local integer id=GetPlayerId(GetOwningPlayer(u))
local integer a=3
if GetItemTypeId(UnitItemInSlot(udg_Trophy_build[id+1],0))=='tkno' then
set a=a+2
endif
if HardcoreBuff10==5 then
set a=a+1
endif
if itemID=='I098' then
call SetHeroStr(u,(GetHeroStr(u,false)+a),true)
return 1
elseif itemID=='I096' then
call SetHeroAgi(u,(GetHeroAgi(u,false)+a),true)
return 1
elseif itemID=='I097' then
call SetHeroInt(u,(GetHeroInt(u,false)+a),true)
return 1
endif
set a=a+17
if itemID=='I0CB' then
call SetHeroStr(u,(GetHeroStr(u,false)+a),true)
return 1
elseif itemID=='I0CA' then
call SetHeroAgi(u,(GetHeroAgi(u,false)+a),true)
return 1
elseif itemID=='I0CC' then
call SetHeroInt(u,(GetHeroInt(u,false)+a),true)
return 1
elseif itemID=='I099' then
call SummonStats(false,80,0,u,u)
return 1
elseif itemID=='I04W' then
set a=150
call SetPlayerStateBJ(Player(id),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)+a)
set GoldNT[id]=GoldNT[id]+a
return 1
elseif itemID=='I0AA' then
set a=800
call SetPlayerStateBJ(Player(id),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)+a)
set GoldNT[id]=GoldNT[id]+a
return 1
elseif itemID=='I0AB' then
set a=1000
call SetPlayerStateBJ(Player(id),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)+a)
set GoldNT[id]=GoldNT[id]+a
return 1
elseif itemID=='I01U' then
call TakeHeroAttack(4,u)
return 1
endif
return 0
endfunction
function RemoveAttack takes integer dmg,unit u returns nothing
local integer h=GetHandleId(u)
local integer a
local integer Loop
local real x=GetUnitX(u)
local real y=GetUnitY(u)
if UnitAlive(u)then
if IsUnitType(u,UNIT_TYPE_HERO)then
set a=LoadInteger(udg_hash,h,5)
set s__Heroes_BaseDmg[sHero[a]]=s__Heroes_BaseDmg[sHero[a]]-dmg
endif
if not IsUnitInGroup(u,udg_HeroBuild)then
set a=dmg-(dmg/5)*5
if a>0 then
set Loop=1
loop
exitwhen Loop>a
set bj_lastCreatedItem=CreateItem('I0EA',x,y)
call UnitAddItem(u,bj_lastCreatedItem)
call SetWidgetLife(bj_lastCreatedItem,1)
call RemoveItem(bj_lastCreatedItem)
set Loop=Loop+1
endloop
endif
set a=(dmg/5)-(dmg/50)*10
if a>0 then
set Loop=1
loop
exitwhen Loop>a
set bj_lastCreatedItem=CreateItem('I0DI',x,y)
call UnitAddItem(u,bj_lastCreatedItem)
call SetWidgetLife(bj_lastCreatedItem,1)
call RemoveItem(bj_lastCreatedItem)
set Loop=Loop+1
endloop
endif
set a=(dmg/50)-(dmg/100)*2
if a>0 then
set Loop=1
loop
exitwhen Loop>a
set bj_lastCreatedItem=CreateItem('I0DH',x,y)
call UnitAddItem(u,bj_lastCreatedItem)
call SetWidgetLife(bj_lastCreatedItem,1)
call RemoveItem(bj_lastCreatedItem)
set Loop=Loop+1
endloop
endif
set a=dmg/100
if a>0 then
set Loop=1
loop
exitwhen Loop>a
set bj_lastCreatedItem=CreateItem('I0DD',x,y)
call UnitAddItem(u,bj_lastCreatedItem)
call SetWidgetLife(bj_lastCreatedItem,1)
call RemoveItem(bj_lastCreatedItem)
set Loop=Loop+1
endloop
endif
endif
else
if IsUnitType(u,UNIT_TYPE_HERO)then
set a=GetPlayerId(GetOwningPlayer(u))+1
set udg_MinusDamage[a]=udg_MinusDamage[a]+dmg
endif
endif
endfunction
function Heal takes boolean up,real heal,unit target,unit healer returns nothing
local integer h=GetHandleId(target)
local integer h2=GetHandleId(healer)
local real boost=LoadReal(udg_hash,h2,StringHash("HealUP"))
local real r=LoadReal(udg_hash,h,StringHash("SelfHealUP"))
local real i=0
if target==healer and r<boost then
set boost=1+r
else
set boost=1+boost
endif
call SetUnitState(target,UNIT_STATE_LIFE,GetUnitState(target,UNIT_STATE_LIFE)+heal*boost)
endfunction
function InfStats takes unit hero,integer str,integer agi,integer int,integer dmg,integer hp,integer mp returns nothing
local integer ID=GetPlayerId(GetOwningPlayer(hero))+1
local integer h=GetHandleId(hero)
local integer iuh=LoadInteger(Hash,h,0)
set KStr[ID]=KStr[ID]+str
set KAgi[ID]=KAgi[ID]+agi
set KInt[ID]=KInt[ID]+int
set Kdmg[ID]=Kdmg[ID]+dmg
set Khp[ID]=Khp[ID]+hp
set Kmp[ID]=Kmp[ID]+mp
call TakeHeroAttack(dmg,hero)
call SetHeroStr(hero,GetHeroStr(hero,false)+str,true)
call SetHeroAgi(hero,GetHeroAgi(hero,false)+agi,true)
call SetHeroInt(hero,GetHeroInt(hero,false)+int,true)
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]+hp
set s__Units_MP[sUnit[iuh]]=s__Units_MP[sUnit[iuh]]+mp
call F_Stats(hero)
endfunction
function TempStats_Delete takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit hero=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(hero)
local integer str=LoadInteger(udg_hash,ht,1)
local integer agi=LoadInteger(udg_hash,ht,2)
local integer int=LoadInteger(udg_hash,ht,3)
local integer dmg=LoadInteger(udg_hash,ht,4)
local integer armore=LoadInteger(udg_hash,ht,5)
local integer hp=LoadInteger(udg_hash,ht,6)
local integer ihh=LoadInteger(udg_hash,h,5)
local integer iuh=LoadInteger(Hash,h,0)
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]-hp
set s__Units_GAttack[sUnit[iuh]]=s__Units_GAttack[sUnit[iuh]]-dmg
set s__Units_Arm[sUnit[iuh]]=s__Units_Arm[sUnit[iuh]]-armore
set s__Heroes_TempStr[sHero[ihh]]=s__Heroes_TempStr[sHero[ihh]]-str
set s__Heroes_TempAgi[sHero[ihh]]=s__Heroes_TempAgi[sHero[ihh]]-agi
set s__Heroes_TempInt[sHero[ihh]]=s__Heroes_TempInt[sHero[ihh]]-int
call F_Stats(hero)
call F_Attack(hero,s__Units_GAttack[sUnit[iuh]])
call F_Armore(hero,s__Units_Arm[sUnit[iuh]])
call F_hp(hero,s__Units_HP[sUnit[iuh]])
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set hero=null
set t=null
endfunction
function TempStats takes unit hero,integer str,integer agi,integer int,integer dmg,integer armore,integer hp,real second returns nothing
local timer t=CreateTimer()
local integer ht=GetHandleId(t)
local integer h=GetHandleId(hero)
local integer ihh=LoadInteger(udg_hash,h,5)
local integer iuh=LoadInteger(Hash,h,0)
set s__Units_HP[sUnit[iuh]]=s__Units_HP[sUnit[iuh]]+hp
set s__Units_GAttack[sUnit[iuh]]=s__Units_GAttack[sUnit[iuh]]+dmg
set s__Units_Arm[sUnit[iuh]]=s__Units_Arm[sUnit[iuh]]+armore
set s__Heroes_TempStr[sHero[ihh]]=s__Heroes_TempStr[sHero[ihh]]+str
set s__Heroes_TempAgi[sHero[ihh]]=s__Heroes_TempAgi[sHero[ihh]]+agi
set s__Heroes_TempInt[sHero[ihh]]=s__Heroes_TempInt[sHero[ihh]]+int
call F_Stats(hero)
call F_Attack(hero,s__Units_GAttack[sUnit[iuh]])
call F_Armore(hero,s__Units_Arm[sUnit[iuh]])
call F_hp(hero,s__Units_HP[sUnit[iuh]])
call SaveUnitHandle(udg_hash,ht,0,hero)
