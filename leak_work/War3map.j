call DestroyEffect(LoadEffectHandle(udg_hash,ht,1))
call SaveInteger(udg_hash,h,StringHash("Passive_B"),LoadInteger(udg_hash,h,StringHash("Passive_B"))-1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set t=null
set hero=null
endfunction
