elseif name=='I0B1' or name=='I0B8' or name=='I0DU' or name=='I0BO' or name=='I059' or name=='I08R' or name=='I095' or name=='I0B4' or name=='I04D' or name=='I0EN' or name=='I09Z' or name=='I0E8' then
set bool=true
