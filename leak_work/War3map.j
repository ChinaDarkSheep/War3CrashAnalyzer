function Trig_BossAttacks_Conditions takes nothing returns boolean
if((GetUnitLevel(GetAttacker())>=15 and ModuloInteger(GetUnitLevel(GetAttacker()),5)==0)or GetUnitTypeId(GetAttacker())=='n05M')then
return true
else
return false
endif
endfunction
function BossAttacks_CD_GT takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit boss=LoadUnitHandle(udg_hash,ht,0)
local group g=LoadGroupHandle(udg_hash,ht,1)
call GroupRemoveUnit(g,boss)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set t=null
set boss=null
set g=null
endfunction
function BossAttacks_CD_GS takes unit boss,group g,real sec returns nothing
local timer t=CreateTimer()
local integer ht=GetHandleId(t)
call GroupAddUnit(g,boss)
call SaveUnitHandle(udg_hash,ht,0,boss)
call SaveGroupHandle(udg_hash,ht,1,g)
call TimerStart(t,sec,false,function BossAttacks_CD_GT)
set t=null
endfunction
function BossTree2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit boss=LoadUnitHandle(Hash,ht,0)
local real sec=LoadReal(Hash,ht,0)
local real xt=LoadReal(Hash,ht,1)
local real yt=LoadReal(Hash,ht,2)
local real dmg=LoadReal(Hash,ht,3)
local group g=CreateGroup()
local group g2=CreateGroup()
local real x
local real y
local unit u
local real range=1100.-3000.*sec
if sec>0 then
call SaveReal(Hash,ht,0,sec-0.1)
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>6
set x=xt+range*Cos(bj_forLoopAIndex*60.*bj_DEGTORAD)
set y=yt+range*Sin(bj_forLoopAIndex*60.*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UDeathMedium\\UDeath.mdl",x,y))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",x,y))
set udg_Drop2=GetPlayerId(GetOwningPlayer(boss))
set FilterGroup=g2
call GroupEnumUnitsInRange(g,x,y,250.,Condition(function Trig_Filter_ID_FG))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(boss,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupAddUnit(g2,u)
call GroupRemoveUnit(g,u)
endloop
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(Hash,ht)
endif
call DestroyGroup(g)
call DestroyGroup(g2)
set g=null
set g2=null
set t=null
set boss=null
set u=null
endfunction
function BossAttacks_Del_Timer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit boss=LoadUnitHandle(udg_hash,ht,0)
local integer ab=LoadInteger(udg_hash,ht,0)
call UnitRemoveAbility(boss,ab)
call Func_CD_UG(boss,LoadGroupHandle(udg_hash,ht,2),LoadReal(udg_hash,ht,1))
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
endfunction
function F_BossAttacks_Del takes unit boss,integer ab,group g,real sec,real seccd returns nothing
local timer t=CreateTimer()
local integer ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,boss)
call SaveInteger(udg_hash,ht,0,ab)
call SaveReal(udg_hash,ht,1,seccd)
call SaveGroupHandle(udg_hash,ht,2,g)
call TimerStart(t,sec,false,function BossAttacks_Del_Timer)
set t=null
endfunction
function BossAttacksG_Del_Timer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit boss=LoadUnitHandle(udg_hash,ht,0)
call PauseUnit(boss,false)
call GroupRemoveUnit(LoadGroupHandle(udg_hash,ht,1),boss)
call Func_CD_UG(boss,LoadGroupHandle(udg_hash,ht,2),LoadReal(udg_hash,ht,0))
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
endfunction
function Trig_BossAttacks_Actions takes nothing returns nothing
local unit boss=GetAttacker()
local integer IDB=GetPlayerId(GetOwningPlayer(boss))+1
local real xb=GetUnitX(boss)
local real yb=GetUnitY(boss)
local real power=1.+0.02*s__SetTechUP[IDB-1]
local unit target=GetTriggerUnit()
local real xt=GetUnitX(target)
local real yt=GetUnitY(target)
local real x
local real y
local real dmg
local unit u
local group g=CreateGroup()
local group g2
local timer t
local integer ht
if GetUnitTypeId(GetAttacker())=='ncte' and IsUnitInGroup(GetAttacker(),udg_SkillsCheck)==false then
call Func_CD_UG(boss,udg_SkillsCheck,10.3)
set dmg=2000.*power
set g2=CreateGroup()
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>6
set x=xt+200.*Cos(bj_forLoopAIndex*60.*bj_DEGTORAD)
set y=yt+200.*Sin(bj_forLoopAIndex*60.*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UDeathMedium\\UDeath.mdl",x,y))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",x,y))
set udg_Drop2=GetPlayerId(GetOwningPlayer(boss))
set FilterGroup=g2
call GroupEnumUnitsInRange(g,x,y,250.,Condition(function Trig_Filter_ID_FG))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(boss,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupAddUnit(g2,u)
call GroupRemoveUnit(g,u)
endloop
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call DestroyGroup(g2)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(Hash,ht,0,boss)
call SaveReal(Hash,ht,0,.3)
call SaveReal(Hash,ht,1,xt)
call SaveReal(Hash,ht,2,yt)
call SaveReal(Hash,ht,3,dmg)
