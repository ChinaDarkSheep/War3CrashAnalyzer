return false
endif
if(not(GetUnitTypeId(GetDyingUnit())!='n00R'))then
return false
endif
return true
endfunction
function Trig_Str_Actions takes nothing returns nothing
local real limit=20
local real take=1
local integer lvl=GetUnitLevel(GetDyingUnit())
if GetOwningPlayer(GetDyingUnit())==Player(PLAYER_NEUTRAL_AGGRESSIVE)then
if IsUnitType(GetDyingUnit(),UNIT_TYPE_HERO)or(lvl>=15 and ModuloInteger(lvl,5)==0)then
if lvl>=30 then
set take=take+15
else
if lvl>=20 then
set take=take+10
else
if lvl>=15 then
set take=take+5
endif
endif
endif
endif
endif
if udg_Setstart==false then
set take=take/1
else
set take=take/2
endif
set udg_ZveroboyStr=udg_ZveroboyStr+take
if udg_ZveroboyStr>=limit then
set udg_ZveroboyStr=udg_ZveroboyStr-limit
call InfStats(udg_Zveroboy,3,0,0,0,0,0)
call CreateTextTagUnitBJ("|cFFFF5800Охотник: +3 силы|r",udg_Zveroboy,0,10.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
endif
endfunction
