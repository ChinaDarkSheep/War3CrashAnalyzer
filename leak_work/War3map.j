function Trig_MurkyRSummon_Actions takes nothing returns nothing
local real dmg=0.
local real hp=0.
local real timelife=30.
local real x=GetUnitX(udg_Murky)
local real y=GetUnitY(udg_Murky)
local real x1=x+GetRandomReal(100.,300.)*Cos((GetRandomReal(0,360))*bj_DEGTORAD)
local real y1=y+GetRandomReal(100.,300.)*Sin((GetRandomReal(0,360))*bj_DEGTORAD)
local unit u
local integer hu
local integer iuu
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\NightElf\\Taunt\\TauntCaster.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
set u=CreateUnit(GetOwningPlayer(udg_Murky),udg_MurkyRUnitType[GetRandomInt(1,3)],x1,y1,GetRandomInt(1,360))
set hu=GetHandleId(u)
set iuu=SeekFreeUnit(hu)
set s__Units_Arm[sUnit[iuu]]=s__Units_Arm[sUnit[iuu]]+30
set dmg=30.+0.55*GetHeroInt(udg_Murky,true)
set hp=400.+4.5*(GetHeroStr(udg_Murky,true)+GetHeroInt(udg_Murky,true))
if GetHeroLevel(udg_Murky)>=50 then
set hp=2.*hp
set timelife=40.
endif
call F_Armore(u,s__Units_Arm[sUnit[iuu]])
if GetUnitAbilityLevel(u,'A0S7')==0 and GetUnitAbilityLevel(u,'A15Z')==0 and GetUnitAbilityLevel(u,'A18R')==0 and GetUnitAbilityLevel(u,'A0M3')==0 and GetUnitAbilityLevel(u,'A18Q')==0 then
call UnitAddAbility(u,'A0S7')
if GetUnitAbilityLevel(u,'A0S8')==1 then
call UnitRemoveAbility(u,'A0S8')
endif
endif
call UnitAddAbility(u,'A17N')
call SetUnitAbilityLevel(u,'A17N',GetUnitAbilityLevel(u,'A17N')+5)
if GetHeroLevel(udg_Murky)>=50 then
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+12)
endif
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),u,udg_Murky)
call UnitRemoveAbility(u,'A007')
call UnitApplyTimedLife(u,'BTLF',timelife)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Taunt\\TauntCaster.mdl",u,"chest")
call DestroyEffect(bj_lastCreatedEffect)
set u=null
endfunction
