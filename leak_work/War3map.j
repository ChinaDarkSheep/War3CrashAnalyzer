function Trig_InicJass_Actions takes nothing returns nothing
local integer i=GetPlayerId(Player(PLAYER_NEUTRAL_AGGRESSIVE))+1
local real x
local real y
local string name=""
local group g=CreateGroup()
set bj_lastStartedTimer=CreateTimer()
call TimerStart(bj_lastStartedTimer,45,false,function OrderToStart)
set bj_lastCreatedUnit=CreateUnit(Player(11),'h009',0,0,0)
set udg_Hero[11]=bj_lastCreatedUnit
set udg_Trophy_build[i]=gg_unit_h059_0261
set udg_Trophy_build[i]=gg_unit_h059_0261
set udg_Trophy_build[9]=gg_unit_h059_0261
set udg_Trophy_build[10]=gg_unit_h059_0261
set udg_Trophy_build[11]=gg_unit_h059_0261
set udg_Trophy_build[12]=gg_unit_h059_0261
call GroupEnumUnitsInRect(g,gg_rct_Secret3,Condition(function InicJass_FilterSecret3))
call ForGroup(g,function InicJass_GroupSecret3)
call GroupClear(g)
call GroupEnumUnitsInRect(g,gg_rct_HeroPick,null)
call ForGroup(g,function InicJass_HeroPick_Pause)
call GroupClear(g)
set s__QuestGoblinText[0]="|cFF00C850Начальное задание [1/4]|r\n"
set s__QuestGoblinText[1]="Герой, привет! Слушай, когда я добирался сюда, мой вертолет был атакован бандитами на юге и из грузового отсека вывалился ящик с запчастями. Не мог бы ты вернуть мне запчасти?"
set s__QuestGoblinText[2]="\n\n|cFFFFDC00Награда успевшему игроку: предмет \"Батарейка\" (1 уровень) и допуск к заданиям \"Поиск оружия\"|r"
set i=0
loop
exitwhen i>8
if GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i))==MAP_CONTROL_USER then
set bj_groupEnumTypeId='ncop'
call GroupEnumUnitsOfPlayer(g,Player(i),filterGetUnitsOfTypeIdAll)
set udg_Circle[i+1]=FirstOfGroup(g)
call TriggerRegisterUnitEvent(gg_trg_Talatne,udg_Circle[i+1],EVENT_UNIT_SPELL_EFFECT)
call GroupClear(g)
call TriggerRegisterPlayerChatEvent(gg_trg_ILOD,Player(i),"-load",false)
set udg_Looting[i+1]=1.00
set udg_Mask[i+11]=9.00
set udg_Mask[i+21]=1.00
call SetPlayerMaxHeroesAllowed(1,Player(i+1))
call SetPlayerTechMaxAllowed(Player(i),'E00Z',0)
call SetPlayerTechMaxAllowed(Player(i),'O012',0)
call SetPlayerTechMaxAllowed(Player(i),'E011',0)
call SetPlayerTechMaxAllowed(Player(i),'U02J',0)
call SetPlayerTechMaxAllowed(Player(i),'O013',0)
call SetPlayerTechMaxAllowed(Player(i),'N07J',0)
call SetPlayerAbilityAvailable(Player(i),'A1AV',false)
call SetPlayerAbilityAvailable(Player(i),'A0NN',false)
call SetPlayerAbilityAvailable(Player(i),'A1CL',false)
call SetPlayerAbilityAvailable(Player(i),'A175',false)
call SetPlayerAbilityAvailable(Player(i),'A13L',false)
call SetPlayerAbilityAvailable(Player(i),'A16Y',false)
