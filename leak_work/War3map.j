function Trig_Pamela_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer h=GetHandleId(caster)
local integer ihh=LoadInteger(udg_hash,h,5)
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local boolean bool
local unit u
local real hp
local real dmg
local integer a
local integer b
local integer c
local integer bmax
local integer i=0
local integer drop
local integer int
local integer str
local integer uuh
local real xh=GetUnitX(caster)
local real yh=GetUnitY(caster)
local real x
local real y
local real x1
local real y1
local real r
local group g=CreateGroup()
local group g_mar=LoadGroupHandle(udg_hash,h,StringHash("GforSummon"))
local integer talante=udg_Talante[ID]
local timer t
local integer ht
local integer SucsID=LoadInteger(udg_hash,h,StringHash("IdforSummon"))
if GetSpellAbilityId()=='A1BG' then
set u=GetSpellTargetUnit()
set b=GetUnitAbilityLevel(caster,'A155')
if b==1 then
set a=3
elseif b==2 then
set a=6
elseif b==3 then
set a=10
elseif b==4 then
set a=14
else
set a=50
endif
if(GetUnitLevel(u)>=15 and ModuloInteger(GetUnitLevel(u),5)==0)or GetUnitAbilityLevel(u,'Arsk')==1 or IsUnitType(u,UNIT_TYPE_HERO)or GetUnitTypeId(u)=='n02P' then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],4.00,"Вы не можете приручить это существо")
elseif a<GetUnitLevel(u)then
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],4.00,"Вам нехватает уровня")
else
set SucsID=GetUnitTypeId(u)
endif
endif
if GetSpellAbilityId()=='A0FS' then
set drop=4
set udg_Drop=0
call ForGroup(g_mar,function SumAliveMar)
set c=0+udg_Drop
set x=GetUnitX(caster)+175*Cos(GetUnitFacing(caster)*bj_DEGTORAD)
set y=GetUnitY(caster)+175*Sin(GetUnitFacing(caster)*bj_DEGTORAD)
set bmax=3
call SeekMinUnit()
set b=1
loop
exitwhen b>bmax
set u=CreateUnit(GetOwningPlayer(caster),SucsID,x,y,GetUnitFacing(caster))
call UnitAddAbility(u,'A140')
call GroupRemoveUnit(udg_A1,u)
call GroupRemoveUnit(udg_A2,u)
call GroupRemoveUnit(udg_A3,u)
set uuh=SeekFreeUnitMin(GetHandleId(u))
if GetHeroLevel(caster)>=50 then
set s__Units_Arm[sUnit[uuh]]=s__Units_Arm[sUnit[uuh]]+25
call F_Armore(u,s__Units_Arm[sUnit[uuh]])
if GetUnitAbilityLevel(u,'A0S7')==0 and GetUnitAbilityLevel(u,'A15Z')==0 and GetUnitAbilityLevel(u,'A18R')==0 and GetUnitAbilityLevel(u,'A0M3')==0 and GetUnitAbilityLevel(u,'A18Q')==0 then
call UnitAddAbility(u,'A0S7')
if GetUnitAbilityLevel(u,'A0S8')==1 then
call UnitRemoveAbility(u,'A0S8')
endif
endif
call UnitAddAbility(u,'A17N')
call SetUnitAbilityLevel(u,'A17N',GetUnitAbilityLevel(u,'A17N')+10)
call UnitAddAbility(u,'A05N')
endif
set str=GetHeroStr(caster,true)-s__Heroes_TempStr[sHero[ihh]]/2
set int=GetHeroInt(caster,true)-s__Heroes_TempInt[sHero[ihh]]/2
set hp=7.*I2R(str)+7.*I2R(int)
set dmg=0.5*I2R(int)
if GetUnitLevel(u)>9 then
set hp=1.4*hp
set dmg=1.4*dmg
endif
if GetHeroLevel(caster)>=50 then
set hp=hp*1.50
if GetUnitAbilityLevel(u,'A1BF')==0 then
call UnitAddAbility(u,'A1BF')
endif
call SetUnitAbilityLevel(u,'A1BF',GetUnitAbilityLevel(u,'A1BF')+6)
endif
set s__Units_Arm[sUnit[uuh]]=s__Units_Arm[sUnit[uuh]]+10
call F_Armore(u,s__Units_Arm[sUnit[uuh]])
set hp=hp+300*(GetHeroLevel(caster)/10)
set dmg=dmg+10*(GetHeroLevel(caster)/10)
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitAddItemByIdSwapped('I085',u)
call UnitAddItemByIdSwapped('I009',u)
call UnitRemoveAbility(u,'A007')
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)*0.75)
if c<drop and b==1 then
call GroupAddUnit(g_mar,u)
else
call UnitApplyTimedLife(u,'BTLF',30.)
endif
set b=b+1
endloop
endif
if GetSpellAbilityId()=='A0FW' then
set dmg=GetHeroAgi(caster,true)*2+45*GetUnitAbilityLevel(caster,'A0FW')
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set x1=x-xh
set y1=y-yh
set hp=bj_RADTODEG*Atan2(y-yh,x-xh)
set r=SquareRoot(x1*x1+y1*y1)
set a=0
loop
exitwhen a>5
set x1=xh+r/6*a*Cos(hp*bj_DEGTORAD)
set y1=yh+r/6*a*Sin(hp*bj_DEGTORAD)
call GroupDamage(x1,y1,250,caster,false,dmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl",x1,y1))
set a=a+1
endloop
if GetHeroLevel(caster)>=50 then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveReal(udg_hash,ht,0,x)
call SaveReal(udg_hash,ht,1,y)
call SaveReal(udg_hash,ht,3,r)
call SaveReal(udg_hash,ht,2,hp)
call SaveInteger(udg_hash,ht,4,1)
call TimerStart(t,0.1,true,function SuccubusW)
endif
endif
if GetSpellAbilityId()=='A0FT' then
call GroupEnumUnitsInRange(g,xh,yh,700,Condition(function FilterAlive))
set a=1
set r=0.
if talante==1 then
set r=4.*GetHeroInt(caster,true)
elseif talante==2 then
set a=GetUnitAbilityLevel(caster,'A0FT')
endif
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitEnemy(u,Player(ID-1))then
set bj_lastCreatedUnit=CreateUnit(Player(ID-1),'h009',xh,yh,0)
call UnitAddAbility(bj_lastCreatedUnit,'A0FU')
call SetUnitAbilityLevel(bj_lastCreatedUnit,'A0FU',a)
call IssueTargetOrder(bj_lastCreatedUnit,"curse",u)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',0.5)
elseif IsUnitAlly(u,Player(ID-1))and talante==1 and IsUnitInGroup(u,g_mar)then
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.3+r)
endif
call GroupRemoveUnit(g,u)
endloop
endif
if GetSpellAbilityId()=='A0YA' then
set u=CreateUnit(Player(ID-1),'n04C',GetUnitX(caster),GetUnitY(caster),GetUnitFacing(caster))
if talante==1 then
set str=GetHeroStr(caster,true)-s__Heroes_TempStr[sHero[ihh]]/2
set int=GetHeroInt(caster,true)-s__Heroes_TempInt[sHero[ihh]]/2
set hp=16.*(str+int)
set dmg=1.*int
call UnitAddAbility(u,'A007')
call SummonStats(true,R2I(hp),R2I(dmg),u,caster)
call UnitRemoveAbility(u,'A007')
call UnitAddAbility(u,'A13N')
call SetUnitAbilityLevel(u,'A13N',3)
set r=40.
elseif talante==2 then
call UnitAddAbility(u,'A0FV')
call UnitAddAbility(u,'A0LN')
call UnitRemoveAbility(u,'ACct')
call UnitRemoveAbility(u,'Afbb')
set a=SeekFreeUnit(GetHandleId(u))
call UnitAddAbility(u,'Aloc')
call SetUnitPathing(u,false)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveUnitHandle(udg_hash,ht,1,u)
call TimerStart(t,0.25,true,function Trig_Zveroboy_Jojo)
set r=40.
endif
call UnitApplyTimedLife(u,'BTLF',40.)
endif
if GetSpellAbilityId()=='A0EC' then
set u=GetSpellTargetUnit()
call UnitAddAbility(u,'A0FX')
call UnitAddAbility(u,'A0FZ')
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call TimerStart(t,40.,false,function SuccubusR1)
elseif GetSpellAbilityId()=='A1F1' then
set r=PositiveDuration(caster,20.)
set i=GetHeroAgi(caster,false)
call TempStats(caster,0,i,0,0,0,0,r)
call SaveBoolean(udg_hash,h,StringHash("SuccubR"),true)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call TimerStart(t,r,false,function SuccubusR2)
endif
call SaveInteger(udg_hash,h,StringHash("IdforSummon"),SucsID)
call DestroyGroup(g)
set g_mar=null
set caster=null
set u=null
set g=null
endfunction
function InitTrig_Pamela takes nothing returns nothing
set gg_trg_Pamela=CreateTrigger()
call TriggerAddAction(gg_trg_Pamela,function Trig_Pamela_Actions)
endfunction
