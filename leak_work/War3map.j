function Trig_SRevil_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer ID=GetPlayerId(GetOwningPlayer(u))+1
local timer t=CreateTimer()
local integer ht=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local integer a
local real dmg
local real hp
local real r
local integer h
local integer iuu
call SaveInteger(udg_hash,ht,0,ID)
call TimerStart(t,40.,false,function SRevil_R)
if udg_SReligion[ID]==3 then
set a=GetPlayerTechCount(Player(ID-1),'R02Y',true)
set r=(GetHeroAgi(udg_Hero[ID],true)/5+s__Units_Arm[sUnit[LoadInteger(Hash,GetHandleId(udg_Hero[ID]),0)]])*(0.1+0.01*a)
set a=GetPlayerTechCount(Player(ID-1),'R02V',true)
set dmg=Summ_Attack(udg_Hero[ID])*(0.3+0.01*a)
set a=GetPlayerTechCount(Player(ID-1),'R01Z',true)
set hp=GetUnitState(udg_Hero[ID],UNIT_STATE_MAX_LIFE)*(0.6+0.02*a)+500*a
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
set u=CreateUnit(Player(ID-1),'u01D',x,y,0.)
set h=GetHandleId(u)
set iuu=SeekFreeUnit(h)
call UnitAddAbility(u,'A0LN')
set s__Units_HP[sUnit[iuu]]=s__Units_HP[sUnit[iuu]]+R2I(hp)
set s__Units_GAttack[sUnit[iuu]]=s__Units_GAttack[sUnit[iuu]]+R2I(dmg)
set s__Units_Arm[sUnit[iuu]]=s__Units_Arm[sUnit[iuu]]+R2I(r)
call F_hp(u,s__Units_HP[sUnit[iuu]])
call F_Armore(u,s__Units_Arm[sUnit[iuu]])
call F_Attack(u,s__Units_GAttack[sUnit[iuu]])
call UnitApplyTimedLife(u,'BTLF',40)
if udg_SMission[1]==udg_SMission[2]then
set bj_lastCreatedUnit=CreateUnit(Player(ID-1),'u01D',x,y,0.)
set h=GetHandleId(bj_lastCreatedUnit)
set iuu=SeekFreeUnit(h)
call UnitAddAbility(bj_lastCreatedUnit,'A0LN')
set s__Units_HP[sUnit[iuu]]=s__Units_HP[sUnit[iuu]]+R2I(hp)
set s__Units_GAttack[sUnit[iuu]]=s__Units_GAttack[sUnit[iuu]]+R2I(dmg)
set s__Units_Arm[sUnit[iuu]]=s__Units_Arm[sUnit[iuu]]+R2I(r)
call F_hp(u,s__Units_HP[sUnit[iuu]])
call F_Armore(u,s__Units_Arm[sUnit[iuu]])
call F_Attack(u,s__Units_GAttack[sUnit[iuu]])
call UnitApplyTimedLife(u,'BTLF',40)
endif
if GetPlayerTechCount(udg_SPlayer,'R01J',true)==4 then
set u=CreateUnit(Player(ID-1),'u01E',x,y,0.)
set t=CreateTimer()
call SaveUnitHandle(udg_hash,GetHandleId(t),0,u)
call TimerStart(t,10.,false,function SRevil_SkeletQ)
set h=GetHandleId(u)
set iuu=SeekFreeUnit(h)
call UnitAddAbility(u,'A0LN')
set s__Units_HP[sUnit[iuu]]=s__Units_HP[sUnit[iuu]]+R2I(hp)
set s__Units_GAttack[sUnit[iuu]]=s__Units_GAttack[sUnit[iuu]]+R2I(dmg)
set s__Units_Arm[sUnit[iuu]]=s__Units_Arm[sUnit[iuu]]+R2I(r)
call F_hp(u,s__Units_HP[sUnit[iuu]])
call F_Armore(u,s__Units_Arm[sUnit[iuu]])
call F_Attack(u,s__Units_GAttack[sUnit[iuu]])
call UnitApplyTimedLife(u,'BTLF',40)
endif
endif
set t=null
set u=null
endfunction
