function CreepsAtk_Kenarius_Damage takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit boss=LoadUnitHandle(udg_hash,ht,0)
local integer sec=LoadInteger(udg_hash,ht,0)
local group g=CreateGroup()
local group g2=LoadGroupHandle(udg_hash,ht,1)
local unit u
local real dmg
local real dmg1
local real x=GetUnitX(boss)
local real y=GetUnitY(boss)
if sec>0 then
set sec=sec-1
call SaveInteger(udg_hash,ht,0,sec)
if udg_HardestLogic then
if udg_Mode==2 then
set dmg=30000
set dmg1=500
else
set dmg=22500
set dmg1=375
endif
else
set dmg=7500
set dmg1=125
endif
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
set udg_Drop2=GetPlayerId(GetOwningPlayer(boss))
call GroupEnumUnitsInRange(g,x,y,250,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitInGroup(u,g2)==false and IsUnitType(u,UNIT_TYPE_STRUCTURE)!=true then
call GroupAddUnit(g2,u)
call UnitDamageTarget(boss,u,dmg,true,true,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call UnitDamageTarget(boss,u,dmg1,true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
call GroupRemoveUnit(g,u)
endloop
else
call DestroyGroup(g2)
call PauseUnit(boss,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
call DestroyGroup(g)
set t=null
set boss=null
set g=null
set g2=null
endfunction
