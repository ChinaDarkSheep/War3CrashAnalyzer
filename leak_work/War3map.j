function Raven_Rage takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit u=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(u)
local integer iuh=LoadInteger(Hash,h,0)
set s__Units_AllDmg[sUnit[iuh]]=s__Units_AllDmg[sUnit[iuh]]-1000
if LoadInteger(udg_hash,ht,1)==1 then
set s__Units_AllBlock[sUnit[iuh]]=s__Units_AllBlock[sUnit[iuh]]-1000
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set t=null
set u=null
endfunction
function Raven_S takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit u=LoadUnitHandle(udg_hash,ht,0)
local integer h=GetHandleId(u)
if UnitAlive(u)then
call UnitRemoveAbility(u,'A0VN')
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set t=null
set u=null
endfunction
function Raven_A takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer ID=LoadInteger(udg_hash,ht,0)
local integer i=LoadInteger(udg_hash,ht,1)
set udg_HeroExp[ID]=udg_HeroExp[ID]-1
if i==1 then
set udg_HeroGold[ID]=udg_HeroGold[ID]-.1
set udg_HeroGoldMax[ID]=udg_HeroGoldMax[ID]-.1
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
set t=null
endfunction
function Trig_CrowSkills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer ID=GetPlayerId(GetOwningPlayer(caster))+1
local unit u
local integer h
local item it
local integer a
local integer b
local timer t
local integer ht
local integer i
if GetSpellAbilityId()=='A0H8' then
set u=GetSpellTargetUnit()
set h=GetHandleId(u)
set i=LoadInteger(Hash,h,0)
set s__Units_AllDmg[sUnit[i]]=s__Units_AllDmg[sUnit[i]]+1000
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
if GetPlayerTechCount(GetOwningPlayer(caster),'R02U',true)==1 then
set s__Units_AllBlock[sUnit[i]]=s__Units_AllBlock[sUnit[i]]+1000
call SaveInteger(udg_hash,ht,1,1)
else
call SaveInteger(udg_hash,ht,1,0)
endif
call TimerStart(t,20,false,function Raven_Rage)
endif
if GetSpellAbilityId()=='A0U0' then
set udg_u=GetSpellTargetUnit()
call SetUnitLifePercentBJ(udg_u,GetUnitLifePercent(udg_u)+15)
call SetUnitManaPercentBJ(udg_u,GetUnitManaPercent(udg_u)+15)
call AddSpecialEffectTargetUnitBJ("origin",udg_u,"Abilities\\Spells\\Items\\AIre\\AIreTarget.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
else
endif
if GetSpellAbilityId()=='A0U1' then
set udg_u=GetSpellTargetUnit()
call GroupAddUnitSimple(udg_u,udg_CrowW)
call AddSpecialEffectTargetUnitBJ("origin",udg_u,"Abilities\\Spells\\Human\\Polymorph\\PolyMorphTarget.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
else
endif
if GetSpellAbilityId()=='A0WK' then
if GetSpellTargetUnit()==udg_CrowRTarget then
set udg_CrowRLogic=false
set udg_CrowRTarget=null
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],10.00,"|cFFFF5800Вы больше не привязаны к герою!|r")
else
set udg_CrowRTarget=GetSpellTargetUnit()
set udg_CrowRLogic=true
call DisplayTimedTextToForce(bj_FORCE_PLAYER[ID-1],10.00,"|cFFFF5800Вы привязались к указанному герою!|r")
endif
else
endif
if GetSpellAbilityId()=='A0VJ' then
set u=GetSpellTargetUnit()
set h=GetHandleId(u)
call SetHeroStr(u,GetHeroStr(u,false)+1,true)
call SetHeroAgi(u,GetHeroAgi(u,false)+1,true)
call SetHeroInt(u,GetHeroInt(u,false)+1,true)
call AddSpecialEffectTargetUnitBJ("origin",u,"Abilities\\Spells\\Items\\AIlm\\AIlmTarget.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
if GetPlayerTechCount(GetOwningPlayer(caster),'R02Q',true)>=1 then
if GetPlayerTechCount(GetOwningPlayer(caster),'R02Q',true)>=2 then
set a=LoadInteger(Hash,h,0)
set s__Units_HP[sUnit[a]]=s__Units_HP[sUnit[a]]+20
if GetPlayerTechCount(GetOwningPlayer(caster),'R02Q',true)>=3 then
if LoadStr(udg_hash,h,2)=="Str" then
call SetHeroStr(u,GetHeroStr(u,false)+1,true)
elseif LoadStr(udg_hash,h,2)=="Agi" then
call SetHeroAgi(u,GetHeroAgi(u,false)+1,true)
else
call SetHeroInt(u,GetHeroInt(u,false)+1,true)
endif
endif
endif
call TakeHeroAttack(1,u)
endif
endif
if GetSpellAbilityId()=='A0VM' then
set u=GetSpellTargetUnit()
call UnitAddAbility(u,'A0VN')
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualTarget.mdl",u,"origin"))
set h=GetHandleId(u)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,u)
call TimerStart(t,7,false,function Raven_S)
endif
if GetSpellAbilityId()=='A0VK' then
set u=GetSpellTargetUnit()
set b=GetPlayerId(GetOwningPlayer(u))+1
set udg_HeroExp[b]=udg_HeroExp[b]+1
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveInteger(udg_hash,ht,0,b)
if GetPlayerTechCount(GetOwningPlayer(caster),'R02T',true)==1 then
set udg_HeroGold[b]=udg_HeroGold[b]+.1
set udg_HeroGoldMax[b]=udg_HeroGoldMax[b]+.1
call SaveInteger(udg_hash,ht,1,1)
else
call SaveInteger(udg_hash,ht,1,0)
endif
call TimerStart(t,20,false,function Raven_A)
endif
if GetSpellAbilityId()=='A0WG' then
set udg_p=GetUnitLoc(caster)
call CreateNUnitsAtLoc(1,'h009',GetOwningPlayer(caster),udg_p,bj_UNIT_FACING)
call SetUnitScalePercent(GetLastCreatedUnit(),200.00,200.00,200.00)
call UnitAddAbilityBJ('A0WH',GetLastCreatedUnit())
call UnitApplyTimedLifeBJ(1.00,'BTLF',GetLastCreatedUnit())
call IssueImmediateOrderBJ(GetLastCreatedUnit(),"stomp")
call RemoveLocation(udg_p)
else
endif
if GetSpellAbilityId()=='A0WI' then
if udg_VoronsTower<15 then
