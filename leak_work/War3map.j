endfunction
function Trig_Lose_Func004Func010Func001C takes nothing returns boolean
if(not(ConvertedPlayer(GetForLoopIndexA())==udg_EvilPlayer))then
return false
endif
return true
endfunction
function Trig_Lose_Func004C takes nothing returns boolean
if(not(udg_Mode==3))then
return false
endif
return true
endfunction
function Trig_Lose_Func008C takes nothing returns boolean
if(not(udg_ZLogic==true))then
return false
endif
return true
endfunction
function Trig_Lose_Func010A takes nothing returns nothing
call CustomDefeatBJ(GetEnumPlayer(),"Вы проиграли!")
endfunction
function Trig_Lose_Actions takes nothing returns nothing
call DisableTrigger(GetTriggeringTrigger())
call DisableTrigger(gg_trg_Win)
call PauseTimerBJ(true,udg_AttackTimer)
if(Trig_Lose_Func004C())then
set udg_ug=GetUnitsInRectAll(GetEntireMapRect())
call ForGroupBJ(udg_ug,function Trig_Lose_Func004Func002A)
call DestroyGroup(udg_ug)
call DisplayTimedTextToForce(GetPlayersAll(),300.00,"|cFFE60000ПОБЕДА ЗЛОДЕЯ!\n\nАльянс не смог устоять перед мощью Злодея и проиграл!")
call TriggerSleepAction(20.00)
call CustomDefeatBJ(Player(9),"Вы проиграли!")
call CustomVictoryBJ(Player(8),true,true)
call CustomVictoryBJ(Player(10),true,true)
call CustomVictoryBJ(Player(11),true,true)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=8
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
if(Trig_Lose_Func004Func010Func001C())then
call CustomVictoryBJ(udg_EvilPlayer,true,true)
else
call CustomDefeatBJ(ConvertedPlayer(GetForLoopIndexA()),"Вы проиграли!")
endif
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
return
else
endif
call FogEnableOff()
call FogMaskEnableOff()
call DisplayTimedTextToForce(GetPlayersAll(),30,"|cFFC60000АПОТРОП УНИЧТОЖЕН!\n\nВы не смогли защитить Альянс от вторжения!")
if(Trig_Lose_Func008C())then
call DestroyTrigger(gg_trg_Z)
call DestroyTrigger(gg_trg_Z2)
call DestroyTrigger(gg_trg_Z3)
call DestroyTrigger(gg_trg_Z4)
call DestroyTrigger(gg_trg_Z5)
call DisplayTimedTextToForce(GetForceOfPlayer(ConvertedPlayer(GetForLoopIndexA())),60.00,("|cFF20C6CDВы набрали "+(I2S(udg_ZCount)+"очков!")))
call DisplayTimedTextToForce(GetForceOfPlayer(ConvertedPlayer(GetForLoopIndexA())),60.00,"|cFF20C6CDВы можете ввести \\\"-save\\\" чтобы сохранить их. Подробнее об этом в \\\"Справке\\\" (F9)|r")
else
endif
call TriggerSleepAction(28.00)
call ForForce(GetPlayersAll(),function Trig_Lose_Func010A)
endfunction
