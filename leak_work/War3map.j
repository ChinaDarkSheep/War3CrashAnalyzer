set gg_trg_FacelessSkills=CreateTrigger()
call TriggerAddAction(gg_trg_FacelessSkills,function Trig_FacelessSkills_Actions)
endfunction
function Trig_ManaShield_Conditions takes nothing returns boolean
if(not(GetAttackedUnitBJ()==udg_Faceless))then
return false
endif
if(not(UnitHasBuffBJ(GetAttackedUnitBJ(),'BNms')==true))then
return false
endif
return true
endfunction
function Trig_ManaShield_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local real hp
local real dmg
local real x
local real y
if udg_ManaShield==10 then
set udg_ManaShield=0
set udg_UpgradeTentakle=udg_UpgradeTentakle+1
set x=GetUnitX(GetAttacker())
set y=GetUnitY(GetAttacker())
if GetUnitAbilityLevel(caster,'A0O9')==1 then
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'n02C',x,y,0.)
else
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'nfgt',x,y,0.)
endif
call SetUnitAnimation(bj_lastCreatedUnit,"stand")
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',20.)
set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",x,y)
call DestroyEffect(bj_lastCreatedEffect)
call UnitAddAbility(bj_lastCreatedUnit,'A007')
if GetHeroLevel(caster)>=50 then
set hp=100+2*GetHeroStr(caster,true)+8*GetHeroInt(caster,true)
set dmg=10+0.5*GetHeroInt(caster,true)
else
set hp=100+GetHeroStr(caster,true)+4*GetHeroInt(caster,true)
set dmg=10+0.25*GetHeroInt(caster,true)
endif
call SummonStats(true,R2I(hp),R2I(dmg),bj_lastCreatedUnit,caster)
call UnitRemoveAbility(bj_lastCreatedUnit,'A007')
else
set udg_ManaShield=udg_ManaShield+1
endif
endfunction
function InitTrig_ManaShield takes nothing returns nothing
set gg_trg_ManaShield=CreateTrigger()
call DisableTrigger(gg_trg_ManaShield)
call TriggerRegisterAnyUnitEventBJ(gg_trg_ManaShield,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(gg_trg_ManaShield,Condition(function Trig_ManaShield_Conditions))
call TriggerAddAction(gg_trg_ManaShield,function Trig_ManaShield_Actions)
endfunction
function Trig_UpTen_Actions takes nothing returns nothing
set udg_UpgradeTentakle=0.00
call SetPlayerTechResearchedSwap('R00N',(GetPlayerTechCountSimple('R00N',GetOwningPlayer(udg_Faceless))+1),GetOwningPlayer(udg_Faceless))
call CreateTextTagUnitBJ("ДРЕВНИЕ СИЛЫ: Щупальца усилены!",udg_Faceless,0,10.00,100.00,50.00,100,10.00)
set udg_TEXT=GetLastCreatedTextTag()
call SetTextTagVelocityBJ(udg_TEXT,75.00,GetRandomReal(80.00,120.00))
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
endfunction
