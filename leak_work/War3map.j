endfunction
function Set1_Wave_2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer sec=LoadInteger(udg_hash,ht,0)+1
if sec<171 then
call SaveInteger(udg_hash,ht,0,sec)
if sec==1 then
set udg_INVASION=101
elseif sec==61 then
set bj_forLoopAIndex=1
loop
exitwhen bj_forLoopAIndex>8
call SetPlayerAllianceBJ(Player(8),ALLIANCE_SHARED_VISION,false,ConvertedPlayer(GetForLoopIndexA()))
call SetPlayerAllianceBJ(Player(10),ALLIANCE_SHARED_VISION,false,ConvertedPlayer(GetForLoopIndexA()))
call SetPlayerAllianceBJ(Player(11),ALLIANCE_SHARED_VISION,false,ConvertedPlayer(GetForLoopIndexA()))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
if udg_HARDSET==1 then
if udg_Mode==2 then
call DisplayTimedTextToForce(GetPlayersAll(),45.00,"TRIG|cFFC60000Надвигается опасность!|r\n\n|cFFFF5800Нападать будет -  гибельная нежить (1500% мощности).")
else
call DisplayTimedTextToForce(GetPlayersAll(),45.00,"|cFFC60000Надвигается опасность!|r\n\n|cFFFF5800Нападать будет -  гибельная нежить (500% мощности).")
