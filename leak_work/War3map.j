function Trig_CrowExp_Actions takes nothing returns nothing
set udg_u=GetDyingUnit()
set udg_Drop=GetUnitLevel(udg_u)
set udg_p=GetUnitLoc(udg_Crow)
set udg_p2=GetUnitLoc(udg_u)
if(Trig_CrowExp_Func008C())then
set udg_Drop2=(10+(udg_Drop*5))
call AdjustPlayerStateBJ(udg_Drop2,GetOwningPlayer(udg_Crow),PLAYER_STATE_RESOURCE_GOLD)
set GoldNT[GetPlayerId(GetOwningPlayer(udg_Crow))+1]=GoldNT[GetPlayerId(GetOwningPlayer(udg_Crow))+1]+udg_Drop2
call CreateTextTagUnitBJ(("|cFFFFDC00+"+I2S(udg_Drop2)),udg_u,0,10.00,100,100,100,0)
set udg_TEXT=GetLastCreatedTextTag()
call ShowTextTagForceBJ(false,udg_TEXT,GetPlayersAll())
call ShowTextTagForceBJ(true,udg_TEXT,GetForceOfPlayer(GetOwningPlayer(udg_Crow)))
call SetTextTagVelocityBJ(udg_TEXT,75.00,90.00)
call SetTextTagSuspendedBJ(udg_TEXT,false)
call SetTextTagPermanentBJ(udg_TEXT,false)
call SetTextTagLifespanBJ(udg_TEXT,3.00)
call SetTextTagFadepointBJ(udg_TEXT,2.00)
if(Trig_CrowExp_Func008Func013C())then
call DoNothing()
else
set udg_CrowLeveling[1]=(udg_CrowLeveling[1]+udg_Drop2)
if(Trig_CrowExp_Func008Func013Func002C())then
set udg_CrowLeveling[2]=(udg_CrowLeveling[2]+1)
set udg_CrowLeveling[3]=udg_CrowExp[udg_CrowLeveling[2]]
call DisplayTimedTextToForce(GetForceOfPlayer(GetOwningPlayer(udg_Crow)),3.00,"|cFFB44BFFLevel up!")
call SetPlayerTechResearchedSwap('R022',udg_CrowLeveling[2],GetOwningPlayer(udg_Crow))
else
endif
call DisplayTimedTextToForce(GetForceOfPlayer(GetOwningPlayer(udg_Crow)),3.00,(("|cFFB44BFFExp: "+(I2S(udg_CrowLeveling[1])+"/"))+(I2S(udg_CrowLeveling[3])+(" (Lvl "+(I2S(udg_CrowLeveling[2])+")")))))
endif
if(Trig_CrowExp_Func008Func014C())then
set udg_Drop=GetRandomInt(1,3)
if(Trig_CrowExp_Func008Func014Func003C())then
call UnitAddItemByIdSwapped('I0AH',udg_Crow)
else
endif
else
if(Trig_CrowExp_Func008Func014Func001C())then
set udg_Drop=GetRandomInt(1,5)
if(Trig_CrowExp_Func008Func014Func001Func004C())then
call UnitAddItemByIdSwapped('I0AH',udg_Crow)
else
endif
else
set udg_Drop=GetRandomInt(1,10)
if(Trig_CrowExp_Func008Func014Func001Func002C())then
call UnitAddItemByIdSwapped('I0AH',udg_Crow)
else
endif
endif
endif
else
endif
call RemoveLocation(udg_p)
call RemoveLocation(udg_p2)
endfunction
