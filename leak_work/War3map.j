endfunction
function ThingT_Segment_CD takes nothing returns nothing
local timer t=GetExpiredTimer()
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(udg_Thing),'h05A',0,0,bj_UNIT_FACING)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
endfunction
function ThingT_Segment_Stats takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local integer h
local integer id=LoadInteger(Hash,ht,0)
local integer ID=id+1
local integer hh=GetHandleId(udg_Hero[ID])
local integer iuu
local real dmg
local real hp
local real r
local integer a
local integer b
local integer c
local integer Loop=0
local boolean alive=false
local unit u
loop
exitwhen Loop>1
set u=LoadUnitHandle(Hash,ht,Loop)
if UnitAlive(u)then
set alive=true
set h=GetHandleId(u)
set iuu=LoadInteger(Hash,h,0)
set b=ReturnTypeUnitsId(GetUnitTypeId(u))
set r=1.*F_HPregen(udg_Hero[ID])
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+r)
if b !=0 then
set dmg=0.3+R2I(s__Unit_types_dmg[Unit_type[b]])/200.
set hp=0.2+R2I(s__Unit_types_hp[Unit_type[b]])/4000.
else
set dmg=0.3+0.01*GetUnitLevel(GetEnumUnit())
set hp=0.3+0.02*GetUnitLevel(GetEnumUnit())
endif
set a=GetPlayerTechCount(Player(id),'R04Z',true)
set r=(GetHeroAgi(udg_Hero[ID],true)/5+s__Units_Arm[sUnit[LoadInteger(Hash,hh,0)]])
set r=r*(0.1+0.01*a)
set a=GetPlayerTechCount(Player(id),'R04V',true)
set dmg=Summ_Attack(udg_Hero[ID])*(0.6+0.04*a)*dmg
set a=GetPlayerTechCount(Player(id),'R04Y',true)
set hp=GetUnitState(udg_Hero[ID],UNIT_STATE_MAX_LIFE)*(0.8+0.04*a)*hp
set a=R2I(dmg)
set b=R2I(hp)
set c=R2I(r)
set s__Units_HP[sUnit[iuu]]=s__Units_HP[sUnit[iuu]]+b-LoadInteger(udg_hash,h,StringHash("UnUnHP"))
set s__Units_GAttack[sUnit[iuu]]=s__Units_GAttack[sUnit[iuu]]+a-LoadInteger(udg_hash,h,StringHash("UnUnAt"))
set s__Units_Arm[sUnit[iuu]]=s__Units_Arm[sUnit[iuu]]+c-LoadInteger(udg_hash,h,StringHash("UnUnAr"))
call F_hp(u,s__Units_HP[sUnit[iuu]])
call F_Armore(u,s__Units_Arm[sUnit[iuu]])
call F_Attack(u,s__Units_GAttack[sUnit[iuu]])
call SaveInteger(udg_hash,h,StringHash("UnUnAr"),c)
call SaveInteger(udg_hash,h,StringHash("UnUnAt"),a)
call SaveInteger(udg_hash,h,StringHash("UnUnHP"),b)
endif
set Loop=Loop+1
endloop
if not alive then
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(Hash,ht)
endif
set u=null
set t=null
endfunction
function ThingBody_Scream takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit thing=LoadUnitHandle(udg_hash,ht,0)
local unit target=LoadUnitHandle(udg_hash,ht,1)
local real dmg=LoadReal(udg_hash,ht,1)
local group g=CreateGroup()
local unit u
call UnitDamageTarget(thing,target,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set dmg=.3*dmg
set udg_Drop2=GetPlayerId(GetOwningPlayer(thing))
call GroupEnumUnitsInRange(g,GetUnitX(target),GetUnitY(target),275.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call UnitDamageTarget(thing,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupRemoveUnit(g,u)
endloop
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
set g=null
set u=null
set thing=null
set t=null
endfunction
function ThingBody_Roar takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit thing=LoadUnitHandle(Hash,ht,0)
local group g2=LoadGroupHandle(Hash,ht,10)
local real sec=LoadReal(Hash,ht,0)
local real x=LoadReal(Hash,ht,1)
local real y=LoadReal(Hash,ht,2)
local real dmg=LoadReal(Hash,ht,3)
local real angle=LoadReal(Hash,ht,4)
local real range=LoadReal(Hash,ht,5)+40
local group g=CreateGroup()
local unit u
if sec>0 then
set x=x+90*Cos(angle*bj_DEGTORAD)
set y=y+90*Sin(angle*bj_DEGTORAD)
call SaveReal(Hash,ht,1,x)
call SaveReal(Hash,ht,2,y)
call SaveReal(Hash,ht,0,sec-0.1)
call SaveReal(Hash,ht,5,range)
set udg_Drop2=GetPlayerId(GetOwningPlayer(thing))
call GroupEnumUnitsInRange(g,x,y,range,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if not IsUnitInGroup(u,g2)then
call UnitDamageTarget(thing,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
call GroupAddUnit(g2,u)
endif
call GroupRemoveUnit(g,u)
endloop
else
call FlushChildHashtable(Hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
call DestroyGroup(g)
set g=null
set g2=null
set thing=null
set u=null
set t=null
endfunction
function Trig_ThingBody_Actions takes nothing returns nothing
local integer ID=GetPlayerId(GetOwningPlayer(GetTriggerUnit()))+1
local unit u
local real x
local real y
local group g=CreateGroup()
local timer t
local integer ht
local integer a
if GetSpellAbilityId()=='A17R' then
set x=GetSpellTargetX()-GetUnitX(GetTriggerUnit())
set y=GetSpellTargetY()-GetUnitY(GetTriggerUnit())
set y=SquareRoot(x*x+y*y)/3000.
set a=GetPlayerTechCount(Player(ID-1),'R052',true)
set x=200.+a*(2*GetHeroInt(udg_Hero[ID],true)+800.)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,GetTriggerUnit())
call SaveUnitHandle(udg_hash,ht,1,GetSpellTargetUnit())
call SaveReal(udg_hash,ht,1,x)
call TimerStart(t,y,false,function ThingBody_Scream)
elseif GetSpellAbilityId()=='A17U' then
set x=GetSpellTargetX()
set y=GetSpellTargetY()
set y=bj_RADTODEG*Atan2(y-GetUnitY(GetTriggerUnit()),x-GetUnitX(GetTriggerUnit()))
set a=GetPlayerTechCount(Player(ID-1),'R052',true)
set x=400.+a*(0.8*GetHeroInt(udg_Hero[ID],true)+400.)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(Hash,ht,0,GetTriggerUnit())
call SaveGroupHandle(Hash,ht,10,CreateGroup())
call SaveReal(Hash,ht,0,.5)
call SaveReal(Hash,ht,1,GetUnitX(GetTriggerUnit()))
call SaveReal(Hash,ht,2,GetUnitY(GetTriggerUnit()))
call SaveReal(Hash,ht,3,x)
call SaveReal(Hash,ht,4,y)
call SaveReal(Hash,ht,5,125.)
call TimerStart(t,0.1,true,function ThingBody_Roar)
endif
if GetSpellAbilityId()=='A17Y' then
if GetPlayerTechCount(GetOwningPlayer(udg_Thing),'R053',true)==1 then
set x=(GetUnitLifePercent(udg_ThingBody)+40.00)
else
set x=(GetUnitLifePercent(udg_ThingBody)+20.00)
endif
call SetUnitLifePercentBJ(udg_ThingBody,x)
endif
if GetSpellAbilityId()=='A17S' then
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveInteger(Hash,ht,0,GetPlayerId(GetOwningPlayer(GetTriggerUnit())))
set u=CreateUnit(GetOwningPlayer(udg_ThingBody),udg_ThingSummon[4],GetUnitX(udg_ThingBody),GetUnitY(udg_ThingBody),bj_UNIT_FACING)
call SeekFreeUnit(GetHandleId(u))
call SaveUnitHandle(Hash,ht,0,u)
call UnitApplyTimedLife(u,'BTLF',25.)
call UnitAddAbility(u,'A0LN')
call UnitAddAbility(u,'A17N')
call UnitAddAbility(u,'A17O')
set a=GetPlayerTechCount(GetOwningPlayer(GetTriggerUnit()),'R04W',true)
call SetUnitAbilityLevel(u,'A17N',a*2+1)
set a=GetPlayerTechCount(GetOwningPlayer(GetTriggerUnit()),'R04Z',true)
call SetUnitAbilityLevel(u,'A17O',a+1)
set x=GetPlayerTechCount(GetOwningPlayer(udg_Thing),'R04Y',true)*(600.00+GetUnitStateSwap(UNIT_STATE_MAX_LIFE,u)*0.10)
call UnitAddAbility(u,'A007')
call SummonStats(false,R2I(x),0,u,u)
call UnitRemoveAbility(u,'A007')
if GetPlayerTechCount(GetOwningPlayer(udg_Thing),'R053',true)>=1 then
set u=CreateUnit(GetOwningPlayer(udg_ThingBody),udg_ThingSummon[4],GetUnitX(udg_ThingBody),GetUnitY(udg_ThingBody),bj_UNIT_FACING)
call SeekFreeUnit(GetHandleId(u))
call SaveUnitHandle(Hash,ht,1,u)
call UnitApplyTimedLife(u,'BTLF',25.)
call UnitAddAbility(u,'A0LN')
call UnitAddAbility(u,'A17N')
call UnitAddAbility(u,'A17O')
set a=GetPlayerTechCount(GetOwningPlayer(GetTriggerUnit()),'R04W',true)
call SetUnitAbilityLevel(u,'A17N',a*2+1)
set a=GetPlayerTechCount(GetOwningPlayer(GetTriggerUnit()),'R04Z',true)
call SetUnitAbilityLevel(u,'A17O',a+1)
call UnitAddAbility(u,'A007')
call SummonStats(false,R2I(x),0,u,u)
call UnitRemoveAbility(u,'A007')
endif
call TimerStart(t,1.,true,function ThingT_Segment_Stats)
set bj_groupEnumTypeId='h05A'
call GroupEnumUnitsOfPlayer(g,GetOwningPlayer(udg_Thing),filterGetUnitsOfPlayerAndTypeId)
call ForGroup(g,function Trig_ThingBody_Func002Func018A)
call TimerStart(CreateTimer(),75.,false,function ThingT_Segment_CD)
endif
call DestroyGroup(g)
set g=null
set u=null
set t=null
endfunction
