function Trig_Potions_Actions takes nothing returns nothing
local unit u
if(Trig_Potions_Func002C())then
call SetUnitLifePercentBJ(GetManipulatingUnit(),(GetUnitLifePercent(GetManipulatingUnit())+50.00))
else
endif
if(Trig_Potions_Func003C())then
call SetUnitManaPercentBJ(GetManipulatingUnit(),(GetUnitManaPercent(GetManipulatingUnit())+50.00))
else
endif
if(Trig_Potions_Func004C())then
call SetUnitLifePercentBJ(GetManipulatingUnit(),(GetUnitLifePercent(GetManipulatingUnit())+50.00))
call SetUnitManaPercentBJ(GetManipulatingUnit(),(GetUnitManaPercent(GetManipulatingUnit())+50.00))
else
endif
if(Trig_Potions_Func005C())then
call SetUnitLifePercentBJ(GetManipulatingUnit(),100.00)
call SetUnitManaPercentBJ(GetManipulatingUnit(),100.00)
else
endif
if(Trig_Potions_Func006C())then
set u=GetManipulatingUnit()
call UnitAddAbilityBJ('Apiv',u)
call TriggerSleepAction(120.00)
call UnitRemoveAbilityBJ('Apiv',u)
else
endif
if(Trig_Potions_Func007C())then
set u=GetManipulatingUnit()
call ModifyHeroStat(bj_HEROSTAT_STR,u,bj_MODIFYMETHOD_ADD,30)
else
endif
if(Trig_Potions_Func008C())then
set u=GetManipulatingUnit()
call ModifyHeroStat(bj_HEROSTAT_INT,u,bj_MODIFYMETHOD_ADD,30)
else
endif
if(Trig_Potions_Func009C())then
set u=GetManipulatingUnit()
call ModifyHeroStat(bj_HEROSTAT_AGI,u,bj_MODIFYMETHOD_ADD,30)
else
endif
if(Trig_Potions_Func010C())then
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=10
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call UnitAddItemByIdSwapped('I04U',GetManipulatingUnit())
call UnitAddItemByIdSwapped('I085',GetManipulatingUnit())
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
else
endif
set u=null
endfunction
