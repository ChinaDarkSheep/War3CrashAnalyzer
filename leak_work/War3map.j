function Trig_PotmSkillQ takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local real sec=LoadReal(udg_hash,ht,0)
local unit dummy=LoadUnitHandle(udg_hash,ht,1)
local real x=GetUnitX(dummy)
local real y=GetUnitY(dummy)
local group g=CreateGroup()
local group g2=LoadGroupHandle(udg_hash,ht,2)
local unit u
local real dmg=LoadReal(udg_hash,ht,1)
if sec>0 then
set sec=sec-.25
call SaveReal(udg_hash,ht,0,sec)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,225.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitInGroup(u,g2)==false then
call GroupAddUnit(g2,u)
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
endif
call GroupRemoveUnit(g,u)
endloop
else
call DestroyGroup(g2)
call RemoveUnit(dummy)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(udg_hash,ht)
endif
call DestroyGroup(g)
set g=null
set g2=null
set caster=null
set dummy=null
set u=null
set t=null
endfunction
function Trig_PotmSkillW takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ht=GetHandleId(t)
local unit caster=LoadUnitHandle(udg_hash,ht,0)
local integer i=LoadInteger(udg_hash,ht,1)
local real x=LoadReal(udg_hash,ht,2)
local real y=LoadReal(udg_hash,ht,3)
local unit e=LoadUnitHandle(udg_hash,ht,4)
local group g=CreateGroup()
local unit u
local real dmg=GetUnitAbilityLevel(caster,'A0SU')*35+GetHeroAgi(caster,true)*0.6
if i !=0 then
set i=i-1
call SaveInteger(udg_hash,ht,1,i)
set udg_Drop2=GetPlayerId(GetOwningPlayer(caster))
call GroupEnumUnitsInRange(g,x,y,275.,Bool_Filter_ID)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if UnitAlive(u)and IsUnitEnemy(u,GetOwningPlayer(caster))then
call UnitDamageTarget(caster,u,dmg,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_AXE_MEDIUM_CHOP)
set bj_lastCreatedEffect=AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Starfall\\StarfallTarget.mdl",u,"origin")
call DestroyEffect(bj_lastCreatedEffect)
endif
call GroupRemoveUnit(g,u)
endloop
else
call RemoveUnit(e)
call FlushChildHashtable(udg_hash,ht)
call PauseTimer(t)
call DestroyTimer(t)
endif
call DestroyGroup(g)
set caster=null
set e=null
set u=null
set t=null
endfunction
function Trig_PotmSkills_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local unit u
local integer a
local integer b
local integer c
local timer t
local integer ht
local real r
local real x
local real y
local real x1
local real y1
local real angle
local real dmg
if GetSpellAbilityId()=='A0SR' then
set u=GetSpellTargetUnit()
if caster==u then
set r=24
else
set r=16
endif
set a=R2I(1.*GetHeroStr(u,false))
set b=R2I(1.*GetHeroAgi(u,false))
set c=R2I(1.*GetHeroInt(u,false))
call TempStats(u,a,b,c,0,0,0,PositiveDuration(caster,r))
elseif GetSpellAbilityId()=='A0ST' then
set dmg=GetUnitAbilityLevel(caster,'A0ST')*75+2*Summ_Attack(caster)
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set r=Psych_crit(caster,1.,1.)
if GetUnitAbilityLevel(caster,'A0SX')==1 and r>1. then
set dmg=dmg*r
set bj_lastCreatedTextTag=CreateTextTag()
call SetTextTagTextBJ(bj_lastCreatedTextTag,"|c000000FF+"+I2S(R2I(dmg))+"!|r",9.)
call SetTextTagPos(bj_lastCreatedTextTag,x,y,0)
call SetTextTagColorBJ(bj_lastCreatedTextTag,100.,100.,100.,0.)
call SetTextTagVelocityBJ(bj_lastCreatedTextTag,75.,90.)
call SetTextTagSuspended(bj_lastCreatedTextTag,false)
call SetTextTagPermanent(bj_lastCreatedTextTag,false)
call SetTextTagLifespan(bj_lastCreatedTextTag,3.00)
call SetTextTagFadepoint(bj_lastCreatedTextTag,2.00)
endif
set x1=GetSpellTargetX()
set y1=GetSpellTargetY()
set angle=bj_RADTODEG*Atan2(y1-y,x1-x)
set u=CreateUnit(GetOwningPlayer(caster),'h030',x,y,angle)
call KnockBackUnit2(u,1500,1.28,angle,0.04)
set t=CreateTimer()
set ht=GetHandleId(t)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveReal(udg_hash,ht,0,1.25)
call SaveUnitHandle(udg_hash,ht,1,u)
call SaveReal(udg_hash,ht,1,dmg)
call SaveGroupHandle(udg_hash,ht,2,CreateGroup())
call TimerStart(t,.25,true,function Trig_PotmSkillQ)
elseif GetSpellAbilityId()=='A0SU' then
set t=CreateTimer()
set ht=GetHandleId(t)
if GetUnitAbilityLevel(caster,'A0SX')==1 then
set r=0.4
set a=20
else
set r=0.8
set a=10
endif
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster),'h03B',GetSpellTargetX(),GetSpellTargetY(),0.)
call SaveUnitHandle(udg_hash,ht,0,caster)
call SaveInteger(udg_hash,ht,1,a)
call SaveReal(udg_hash,ht,2,GetSpellTargetX())
call SaveReal(udg_hash,ht,3,GetSpellTargetY())
call SaveUnitHandle(udg_hash,ht,4,bj_lastCreatedUnit)
call TimerStart(t,r,true,function Trig_PotmSkillW)
else
endif
set caster=null
set u=null
set t=null
endfunction
function InitTrig_PotmSkills takes nothing returns nothing
set gg_trg_PotmSkills=CreateTrigger()
call TriggerAddAction(gg_trg_PotmSkills,function Trig_PotmSkills_Actions)
endfunction
function Trig_CaptainTakesDmg_Actions takes nothing returns nothing
call DisableTrigger(GetTriggeringTrigger())
set udg_r=GetEventDamage()
if UnitHasBuffBJ(udg_Captain,'B01Q')==true then
set udg_r2=(udg_r*(0.80+(I2R(GetUnitAbilityLevelSwapped('A01U',udg_Captain))*0.30)))
call UnitDamageTargetBJ(udg_Captain,GetEventDamageSource(),udg_r2,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
endif
call EnableTrigger(GetTriggeringTrigger())
endfunction
