{
  "version": 1,
  "description": "P5.0 泄露分析语料。expected_findings 表示按目标语义真正需要报告的问题；forbidden_fix_patterns 表示当前/未来修复器绝不能产生的编辑。",
  "options": {
    "fix_point": true,
    "fix_group": true,
    "fix_rect": true,
    "optimize_jass": true
  },
  "cases": [
    {
      "id": "01_single_return_location",
      "file": "cases/01_single_return_location.j",
      "intent": "单出口、未逃逸的局部点应被完整修复",
      "level": "A",
      "expected_findings": [
        {"function": "SingleReturn", "variable": "loc", "type": "location"}
      ],
      "must_fix_patterns": ["call RemoveLocation\\(loc\\)"],
      "forbidden_fix_patterns": [],
      "destroy_checks": [
        {"destroyer": "RemoveLocation", "variable": "loc", "min": 1, "max": 1}
      ],
      "expected_guarded_returns": null,
      "notes": "最基础的正例，用于确认基线能力没有退化。"
    },
    {
      "id": "02_multi_return_location",
      "file": "cases/02_multi_return_location.j",
      "intent": "多出口函数的清理位置无法静态确定时只报告，不自动修改",
      "level": "B",
      "expected_findings": [
        {"function": "MultiReturn", "variable": "loc", "type": "location"}
      ],
      "must_fix_patterns": [],
      "forbidden_fix_patterns": [],
      "destroy_checks": [
        {"destroyer": "RemoveLocation", "variable": "loc", "min": 0, "max": 0}
      ],
      "expected_guarded_returns": null,
      "notes": "止血阶段对多出口函数不再自动插入清理，等 P5.2 CFG 完成后再逐个出口处理。"
    },
    {
      "id": "03_branch_destroy_group",
      "file": "cases/03_branch_destroy_group.j",
      "intent": "仅在某个分支内销毁不等于所有路径都已清理",
      "level": "B",
      "expected_findings": [
        {"function": "BranchDestroy", "variable": "g", "type": "group"}
      ],
      "must_fix_patterns": [],
      "forbidden_fix_patterns": [],
      "destroy_checks": [],
      "expected_guarded_returns": null,
      "notes": "当前实现只要函数内出现 DestroyGroup(g) 就认为已处理，产生漏报。"
    },
    {
      "id": "04_loop_inline_location",
      "file": "cases/04_loop_inline_location.j",
      "intent": "循环体内的内联点创建应被提升并在每次迭代后销毁",
      "level": "A",
      "expected_findings": [
        {"function": "LoopInline", "variable": null, "type": "location"}
      ],
      "must_fix_patterns": ["call RemoveLocation\\(leakfix_loc_\\d+\\)"],
      "forbidden_fix_patterns": [],
      "destroy_checks": [],
      "expected_guarded_returns": null,
      "notes": "当前实现能提升内联调用；用于守住已有能力。"
    },
    {
      "id": "05_sleep_group",
      "file": "cases/05_sleep_group.j",
      "intent": "TriggerSleepAction 之后仍使用的句柄应在函数末尾清理",
      "level": "A",
      "expected_findings": [
        {"function": "Sleepy", "variable": "g", "type": "group"}
      ],
      "must_fix_patterns": ["call DestroyGroup\\(g\\)"],
      "forbidden_fix_patterns": [],
      "destroy_checks": [
        {"destroyer": "DestroyGroup", "variable": "g", "min": 1, "max": 1}
      ],
      "expected_guarded_returns": null,
      "notes": "用于确认清理点不会因为等待而提前。"
    },
    {
      "id": "06_gui_group",
      "file": "cases/06_gui_group.j",
      "intent": "GUI 的 bj_wantDestroyGroup + ForGroupBJ 已经负责销毁，不能再插一次",
      "level": "B",
      "expected_findings": [],
      "must_fix_patterns": [],
      "forbidden_fix_patterns": ["DestroyGroup\\(leakfix_gro_\\d+\\)"],
      "destroy_checks": [],
      "expected_guarded_returns": null,
      "notes": "当前实现会把 GUI 枚举的单位组提升后再次 DestroyGroup，存在双重销毁风险。"
    },
    {
      "id": "07_escape_global_location",
      "file": "cases/07_escape_global_location.j",
      "intent": "局部句柄存入全局后所有权已转移，不能自动销毁",
      "level": "B",
      "expected_findings": [
        {"function": "EscapeGlobal", "variable": "loc", "type": "location"}
      ],
      "must_fix_patterns": [],
      "forbidden_fix_patterns": ["call RemoveLocation\\(loc\\)"],
      "destroy_checks": [
        {"destroyer": "RemoveLocation", "variable": "loc", "min": 0, "max": 0}
      ],
      "expected_guarded_returns": null,
      "notes": "当前实现无条件在函数末尾销毁，属于危险修复。"
    },
    {
      "id": "08_shared_force",
      "file": "cases/08_shared_force.j",
      "intent": "GetPlayersAll() 返回共享全局 force，任何自动销毁都是致命的",
      "level": "C",
      "expected_findings": [],
      "must_fix_patterns": [],
      "forbidden_fix_patterns": [
        "call DestroyForce\\(bj_sharedForce\\)",
        "call DestroyForce\\(f\\)"
      ],
      "destroy_checks": [
        {"destroyer": "DestroyForce", "variable": "bj_sharedForce", "min": 0, "max": 0},
        {"destroyer": "DestroyForce", "variable": "f", "min": 0, "max": 0}
      ],
      "expected_guarded_returns": null,
      "notes": "当前实现会对 set bj_sharedForce = GetPlayersAll() 插入 DestroyForce；定位侧还会把局部 f 误报为泄露。"
    },
    {
      "id": "09_new_force_local",
      "file": "cases/09_new_force_local.j",
      "intent": "函数内新建的局部 force 应被自动销毁",
      "level": "A",
      "expected_findings": [
        {"function": "NewForceLocal", "variable": "f", "type": "force"}
      ],
      "must_fix_patterns": ["call DestroyForce\\(f\\)"],
      "forbidden_fix_patterns": [],
      "destroy_checks": [
        {"destroyer": "DestroyForce", "variable": "f", "min": 1, "max": 1}
      ],
      "expected_guarded_returns": null,
      "notes": "当前实现只处理点/组/矩形，新建玩家组能定位但不能修复。"
    },
    {
      "id": "10_comment_and_string",
      "file": "cases/10_comment_and_string.j",
      "intent": "注释和字符串里的创建函数名不得被当成代码",
      "level": "C",
      "expected_findings": [],
      "must_fix_patterns": [],
      "forbidden_fix_patterns": [
        "local group leakfix_gro_",
        "DestroyGroup\\(leakfix_gro_"
      ],
      "destroy_checks": [],
      "expected_guarded_returns": null,
      "notes": "当前实现会对字符串和行尾注释中的 CreateGroup() 做提升，可能改变提示文本。"
    },
    {
      "id": "11_spaced_destroy",
      "file": "cases/11_spaced_destroy.j",
      "intent": "已存在带空格的销毁调用时不得重复插入",
      "level": "A",
      "expected_findings": [],
      "must_fix_patterns": [],
      "forbidden_fix_patterns": ["call RemoveLocation\\(loc\\)"],
      "destroy_checks": [
        {"destroyer": "RemoveLocation", "variable": "loc", "min": 0, "max": 1}
      ],
      "expected_guarded_returns": null,
      "notes": "当前实现用无空格字符串匹配，会产生重复销毁；定位侧还会把 RemoveLocation 里的 Location 子串误报为创建调用。"
    },
    {
      "id": "12_return_handle",
      "file": "cases/12_return_handle.j",
      "intent": "返回给调用方的句柄所有权已转移，不能在函数内销毁",
      "level": "B",
      "expected_findings": [],
