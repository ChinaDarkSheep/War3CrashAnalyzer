      "destroy_checks": [
        {"destroyer": "RemoveLocation", "variable": "loc", "min": 0, "max": 0}
      ],
      "expected_guarded_returns": null,
      "notes": "当前实现会在 return loc 之前插入销毁，直接破坏返回值。"
    },
    {
      "id": "13_long_lived_timer",
      "file": "cases/13_long_lived_timer.j",
      "intent": "周期计时器是长期对象，不应被当作泄露或自动销毁",
      "level": "C",
      "expected_findings": [],
      "must_fix_patterns": [],
      "forbidden_fix_patterns": ["DestroyTimer\\(t\\)"],
      "destroy_checks": [
        {"destroyer": "DestroyTimer", "variable": "t", "min": 0, "max": 0}
      ],
      "expected_guarded_returns": null,
      "notes": "当前定位会把长期计时器报成泄露；修复器暂未处理 timer。"
    },
    {
      "id": "14_idempotent_location",
      "file": "cases/14_idempotent_location.j",
