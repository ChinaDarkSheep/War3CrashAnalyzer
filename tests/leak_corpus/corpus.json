      "destroy_checks": [],
      "expected_guarded_returns": null,
      "notes": "当前实现会生成 return 之后的不可达销毁代码，属于无效编辑。"
    },
    {
      "id": "16_local_rect_scope",
      "file": "cases/16_local_rect_scope.j",
      "intent": "本版自动修复范围不含矩形，矩形只应给出建议",
      "level": "B",
      "expected_findings": [
        {"function": "LocalRect", "variable": "r", "type": "rect"}
      ],
      "must_fix_patterns": [],
      "forbidden_fix_patterns": ["call RemoveRect\\(r\\)"],
